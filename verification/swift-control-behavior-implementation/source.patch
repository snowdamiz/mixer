+//! Isolated draft: literal shared control helpers on the original phase.
+//! The future caller owns fetch, cursor, fuel, outer work, pc advance and finish.
+#![allow(dead_code, clippy::result_large_err)]
+use super::*;
+use crate::experimental::cache::ControlKind;
+
+macro_rules! swift_control_leaf {
+    (pop $s:ident) => {
+        $s.control_pop_value()
+    };
+    (push $s:ident, $v:expr) => {
+        $s.phase.push_value($v)
+    };
+    (invariant $s:ident) => {
+        $s.invariant("swift_control_invariant")
+    };
+    (values $s:ident) => {
+        $s.phase.parts.values
+    };
+    (controls $s:ident) => {
+        $s.phase.parts.controls
+    };
+    (frame $s:ident, $f:ident) => {
+        let $f = $s.control_frame_scalars()?;
+    };
+    (floor $f:ident) => {
+        $f.controls
+    };
+    (result $c:ident) => {
+        $c.result()
+    };
+    (height $c:ident) => {
+        $c.height()
+    };
+    (loop $c:ident) => {
+        $c.is_loop()
+    };
+    (function $c:ident) => {
+        $c.is_function()
+    };
+    (clear $c:ident) => {
+        $c.clear_result()
+    };
+    (start $c:ident) => {
+        $c.start()
+    };
+    (after_end $s:ident, $c:ident) => {
+        $c.end()
+            .checked_add(1)
+            .ok_or_else(|| $s.invariant("swift_control_after_end"))?
+    };
+    (depth_offset $s:ident, $d:ident) => {
+        usize::try_from($d)
+            .ok()
+            .and_then(|n| n.checked_add(1))
+            .ok_or_else(|| $s.invariant("swift_control_depth_offset"))?
+    };
+    (truncate_values $s:ident, $h:expr) => {
+        $s.control_truncate_values($h)?
+    };
+    (truncate_controls $s:ident, $h:expr) => {
+        $s.control_truncate_controls($h)?
+    };
+    (observe $s:ident) => {
+        $s.agreement()?
+    };
+    (set_pc $s:ident, $pc:expr) => {
+        $s.control_set_pc($pc)?;
+    };
+    (copy_control $s:ident, $index:ident) => {
+        $s.control_branch_copy($index)?
+    };
+    (selected $s:ident, $target:ident) => {
+        $target.expect("prevalidated selected target")
+    };
+    (room $s:ident) => {
+        $s.control_room()
+    };
+    (depth_limit $s:ident) => {
+        $s.phase.parts.cache.proof().decode_policy().control_depth()
+    };
+    (depth_error $s:ident, $f:ident) => {
+        $s.limit(
+            SwiftRunFailureKind::ControlLimit,
+            SwiftRunResource::Controls,
+            "swift_control_depth_exceeded",
+            $s.phase.parts.controls.len() - $f.controls + 1,
+            $s.phase.parts.cache.proof().decode_policy().control_depth(),
+        )
+    };
+    (publish $s:ident, $kind:ident, $f:ident, $end:ident, $result:ident) => {
+        $s.control_publish(
+            $kind,
+            $f.pc,
+            $end,
+            $s.phase.parts.values.len(),
+            $result.is_some(),
+        )?;
+    };
+    (false_pc $s:ident, $alternative:ident, $end:ident) => {
+        let pc = match $alternative {
+            Some(alternative) => alternative
+                .checked_add(1)
+                .ok_or_else(|| $s.invariant("swift_control_alternative_pc"))?,
