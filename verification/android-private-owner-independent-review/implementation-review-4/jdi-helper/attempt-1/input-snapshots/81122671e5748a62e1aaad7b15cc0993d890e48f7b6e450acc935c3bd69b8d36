    private static ObjectReference object(Value value){check(value instanceof ObjectReference,"expected actual object reference");return (ObjectReference)value;}
    private static Value get(ObjectReference target,String field){return target.getValue(target.referenceType().fieldByName(field));}
    private static boolean bool(ObjectReference target,String field){return ((BooleanValue)get(target,field)).value();}
    private static long id(Value value){return value==null?0:((ObjectReference)value).uniqueID();}
    private static ClassType debug(){return (ClassType)vm.classesByName(DEBUG).get(0);}
    private static ObjectReference owner(){return object(debug().getValue(debug().fieldByName("owner")));}
    private static void logLocation(String point,Location where)throws Exception{System.out.println("{\"point\":\""+point+"\",\"class\":\""+where.declaringType().name()+"\",\"method\":\""+where.method().name()+"\",\"descriptor\":\""+where.method().signature()+"\",\"bci\":"+where.codeIndex()+",\"line\":"+where.lineNumber()+",\"method_code_sha256\":\""+HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(where.method().bytecodes()))+"\"}");}
    private static boolean exactCaller(StackFrame frame){Location l=frame.location();return l.declaringType().name().equals(callerClass)&&l.method().name().equals(callerMethod)&&l.method().signature().equals(callerDesc)&&l.codeIndex()==callBci;}
