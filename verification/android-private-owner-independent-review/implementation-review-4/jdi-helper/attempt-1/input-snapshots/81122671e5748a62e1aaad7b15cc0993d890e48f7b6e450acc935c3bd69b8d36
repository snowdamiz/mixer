        callerClass=site==3?"dev.mixer.android.NativeRenderer":site==1?SCROLL:GROUP;callerMethod=site==3?"prepareV2":site==1?"onScrollChanged":"onLayout";callerDesc=site==3?"([BLdev/mixer/android/NativeEnvironmentV2;)Ldev/mixer/android/NativeRenderer$CandidateV2;":site==0?GROUP_DESC:site==1?"(IIII)V":"(ZIIII)V";callBci=site==3?933:site==0?210:site==1?415:40;
