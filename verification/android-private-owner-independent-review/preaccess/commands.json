  "limits": {
    "concurrent_children": 1,
    "wall_seconds": 120,
    "stdout_bytes": 2097152,
    "stderr_bytes": 2097152,
    "java_heap_MiB": 256,
    "cleanup": "terminate and reap owned child group only; remove exclusive transient scratch; retain all source/evidence/failures"
