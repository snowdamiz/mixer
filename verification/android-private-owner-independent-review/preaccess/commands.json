  "candidate_gate": "no future command runnable until root admission and literal argv/source-list/tool digest candidate addendum",
  "future_templates": [
    {
      "id": "compile",
      "argv": [
        "<admitted-official-javac>",
        "--release",
        "17",
        "-g",
        "-Xlint:all",
        "-Werror",
        "-proc:none",
        "-classpath",
        "<owned-empty-directory>",
        "-sourcepath",
        "<owned-empty-directory>",
        "-d",
