+        hooks(Hooks{cancel:Some(ordinal),..Hooks::default()});let f=pin(&mut cache,&mut c,34,None).unwrap_err();hooks(Hooks::default());assert_eq!(f.kind,SwiftRunFailureKind::Cancelled);
