defmodule MixerHosted.Identity.FetchFlight do
  @moduledoc false
  use GenServer
  alias MixerHosted.Identity.{JWKSTransport, TrustSnapshot}
  def start_link(opts), do: GenServer.start_link(__MODULE__, opts)

  def child_spec(opts),
    do: %{
      id: make_ref(),
      start: {__MODULE__, :start_link, [opts]},
      restart: :temporary,
      shutdown: :infinity
    }

  def init(opts) do
    Process.flag(:trap_exit, true)
    %{owner: owner, entry: entry, deadline: deadline, configuration: configuration} = opts
    watcher = self()

    {worker, monitor} =
      :erlang.spawn_opt(
        fn ->
          Process.flag(:max_heap_size, %{size: 1_000_000, kill: true, error_logger: false})
          result = fetch(entry, deadline, configuration, watcher)

          result =
            with {:ok, candidate} <- result,
                 true <- System.monotonic_time(:millisecond) < deadline,
                 {:ok, snapshot} <-
                   TrustSnapshot.new(
                     entry.profile,
                     candidate.body,
                     candidate.fetched_at,
                     candidate.fresh_until
                   ),
                 now = System.monotonic_time(:millisecond),
                 true <- now < deadline and now < candidate.expires_mono do
              {:ok, snapshot, Map.delete(candidate, :body)}
            else
              _ -> {:error, :fetch_rejected}
            end

          send(watcher, {:candidate, self(), result})
        end,
        [:link, :monitor]
      )

    timer =
      Process.send_after(
        self(),
        :deadline,
        max(0, deadline - System.monotonic_time(:millisecond))
      )

    {:ok,
     %{
       owner: owner,
       worker: worker,
       monitor: monitor,
       timer: timer,
       socket: nil,
       raw_socket: nil,
       raw_monitor: nil,
       raw_closed: false,
       connection: nil,
       connection_monitor: nil,
       connection_down: false,
       worker_down: false,
       result: {:error, :fetch_rejected}
     }}
  end

  defp fetch(entry, d, c, w) do
    if Map.has_key?(c, :fixture) do
      fixture_fetch(entry, d, c, w)
    else
      JWKSTransport.fetch(entry, d, c, w)
    end
  end

  if Mix.env() == :test do
    defp fixture_fetch(entry, d, c, w) do
      %{ip: ip, port: port} = c.fixture
      JWKSTransport.fetch_fixture(entry, ip, port, d, c.ca_roots, w)
    end
  else
    defp fixture_fetch(_, _, _, _), do: {:error, :invalid_configuration}
  end

  def handle_info(
        {:register_raw_socket, worker, socket, ref},
        %{worker: worker, raw_socket: nil} = s
      )
      when is_port(socket) do
    if Port.info(socket, :connected) == {:connected, worker} do
      monitor = :erlang.monitor(:port, socket)
      send(worker, {ref, :ok})
      {:noreply, %{s | raw_socket: socket, raw_monitor: monitor}}
    else
      send(worker, {ref, :error})
      {:noreply, s}
    end
  end

  def handle_info(
        {:register_connection, worker, raw, connection, ref},
        %{worker: worker, raw_socket: raw, connection: nil} = s
      )
      when is_pid(connection) do
    if Port.info(raw, :connected) == {:connected, connection} do
      monitor = Process.monitor(connection)
      send(worker, {ref, :ok})
      {:noreply, %{s | connection: connection, connection_monitor: monitor}}
    else
      send(worker, {ref, :error})
      {:noreply, s}
    end
  end

  def handle_info({:register_socket, worker, socket, ref}, %{worker: worker} = s) do
    send(worker, {ref, :ok})
    {:noreply, %{s | socket: socket}}
  end

  def handle_info({:candidate, worker, result}, %{worker: worker} = s),
    do: {:noreply, %{s | result: result}}

  def handle_info(:cancel, s), do: handle_info(:deadline, s)

  def handle_info(:deadline, s) do
    Process.exit(s.worker, :kill)
    close_raw(s.raw_socket)
    close(s.socket)
    {:noreply, %{s | result: {:error, :deadline}}}
  end

  def handle_info({:DOWN, ref, :process, worker, _}, %{monitor: ref, worker: worker} = s) do
    Process.cancel_timer(s.timer)
    close_raw(s.raw_socket)
    close(s.socket)
    await_raw_closed(s)
    await_connection_down(s)
    send(s.owner, {:flight_result, self(), s.result})
    {:stop, :normal, %{s | raw_closed: true, connection_down: true, worker_down: true}}
  end

  def handle_info({:EXIT, _, _}, s), do: {:noreply, s}

  def handle_info({:DOWN, ref, :port, socket, _}, %{raw_monitor: ref, raw_socket: socket} = s),
    do: {:noreply, %{s | raw_closed: true}}

  def handle_info(
        {:DOWN, ref, :process, pid, _},
        %{connection_monitor: ref, connection: pid} = s
      ),
      do: {:noreply, %{s | connection_down: true}}

  def terminate(reason, s) do
    Process.cancel_timer(s.timer)
    Process.exit(s.worker, :kill)
    close_raw(s.raw_socket)

    # Forceful supervisor death cannot rely on the registered TLS controller
    # processing transport closure. Graceful shutdown retains its existing wait.
    if reason == :killed and is_pid(s.connection), do: Process.exit(s.connection, :kill)

    close(s.socket)
    await_raw_closed(s)
    await_connection_down(s)

    unless s.worker_down do
      receive do
        {:DOWN, ref, :process, _, _} when ref == s.monitor -> :ok
      end
    end
  end

  defp close_raw(nil), do: :ok
  defp close_raw(socket), do: :gen_tcp.close(socket)
  defp await_raw_closed(%{raw_socket: nil}), do: :ok
  defp await_raw_closed(%{raw_closed: true}), do: :ok

  defp await_raw_closed(s) do
    # Slots cannot retire until the owned OS socket's port DOWN is observed.
    receive do
      {:DOWN, ref, :port, port, _} when ref == s.raw_monitor and port == s.raw_socket -> :ok
    end
  end

  defp await_connection_down(%{connection: nil}), do: :ok
  defp await_connection_down(%{connection_down: true}), do: :ok

  defp await_connection_down(s) do
    receive do
      {:DOWN, ref, :process, pid, _} when ref == s.connection_monitor and pid == s.connection ->
        :ok
    end
  end

  defp close(nil), do: :ok

  defp close(socket) do
    :ssl.close(socket, 100)
  catch
    _, _ -> :ok
  end
end

bec181714b668768c95a48b5a522f19bfa389e94 blob 3183
defmodule MixerHosted.Identity.KeyOwnerLinuxNetworkTest do
  use ExUnit.Case, async: false

  @moduletag skip:
               not (:os.type() == {:unix, :linux} and
                      System.get_env("MIXER_ISOLATED_NETNS") == "1")
  alias MixerHosted.Identity.{DNSFixture, JWKSTransport, TLSFixture, TrustSnapshot}

  @profile %{
    profile_id: "isolated-linux-origin",
    profile_version: 1,
    issuer: "https://issuer.fixture.invalid/oauth",
    audience: "mixer-api",
    client_id: "reviewed-client",
    identity_class: :human,
    enabled: true
  }
  @entry %{
    profile: @profile,
    jwks_endpoint: %{host: "jwks.fixture.invalid", port: 443, path: "/keys"},
    transport: :hosted_https
  }
  defp write_evidence(name, bytes) do
    case System.get_env("MIXER_TEST_IDENTITY_EVIDENCE") do
      nil -> :ok
      directory -> File.write!(Path.join(directory, name), bytes)
    end
  end

  # This file is run only by the network-none disposable Linux collector whose
  # private namespace owns8.8.8.8 on lo:1. It grants no product test exception.
  test "K03 production resolver/classifier pins public peer despite rebinding; private sink remains untouched" do
    assert :os.type() == {:unix, :linux}
    assert System.get_env("MIXER_ISOLATED_NETNS") == "1"
    public = start_supervised!({TLSFixture, [ip: {8, 8, 8, 8}, port: 443]}, id: :public)
    sink = start_supervised!({TLSFixture, [ip: {127, 0, 0, 1}, port: 443]}, id: :sink)
    dns = start_supervised!(DNSFixture)
    DNSFixture.configure(dns, {:rebind, [{8, 8, 8, 8}]})
    a = GenServer.call(public, :authority)

    key =
      JOSE.JWK.generate_key({:rsa, 2048})
      |> JOSE.JWK.to_public()
      |> JOSE.JWK.to_map()
      |> elem(1)
      |> Map.merge(%{"kid" => "network-key", "alg" => "RS256", "use" => "sig"})

    body = Jason.encode!(%{"keys" => [key]})
    TLSFixture.configure(public, {:body, body})
    config = %{ca_roots: [a.ca], resolvers: [{{127, 0, 0, 1}, DNSFixture.info(dns).port}]}

    assert {:ok, c} =
             JWKSTransport.fetch(@entry, System.monotonic_time(:millisecond) + 2_000, config, nil)

    assert c.peer == {8, 8, 8, 8}
    assert c.body == body
    assert {:ok, _} = TrustSnapshot.new(@profile, c.body, c.fetched_at, c.fresh_until)
    assert length(DNSFixture.info(dns).queries) == 2
    assert TLSFixture.info(public).accepted == 1
    assert TLSFixture.info(sink).accepted == 0
    # The same configured endpoint now resolves to loopback, so a new flight
    # rejects before a TCP/TLS connection. There is no destination fallback.
    assert {:error, :dns_rejected} =
             JWKSTransport.fetch(@entry, System.monotonic_time(:millisecond) + 2_000, config, nil)

    assert TLSFixture.info(sink).accepted == 0

    write_evidence(
      "production-DNS-rebinding.json",
      Jason.encode!(
        %{
          initialQueries: 2,
          authenticatedPeer: "8.8.8.8:443",
          publicConnections: 1,
          forbiddenSinkConnections: 0,
          newPrivateAnswerRejectedBeforeConnect: true,
          namespace: "disposable network-none Linux lo:1; no product resolver or loopback bypass"
        },
        pretty: true
      )
    )
  end
end

f2a157969b90757dc64f6bf3d9b2e62c43f81117 blob 4995
defmodule MixerHosted.Identity.StartupLinuxNetworkTest do
  use ExUnit.Case, async: false

  @moduletag skip:
               not (:os.type() == {:unix, :linux} and
                      System.get_env("MIXER_ISOLATED_NETNS") == "1")
  alias MixerHosted.Identity.{
    Admission,
    ConfiguredVerifier,
    KeyOwner,
    StartupDNSFixture,
    StartupFixture,
    TLSFixture
  }

  defp eventually(fun, tries \\ 250)
  defp eventually(fun, 0), do: assert(fun.())

  defp eventually(fun, tries) do
    if fun.(),
      do: :ok,
      else:
        (
          Process.sleep(10)
          eventually(fun, tries - 1)
        )
  end

  test "IS04 IS05 actual configured startup cold production DNS TLS admission and lifecycle" do
    prior = Application.get_all_env(:mixer_hosted)

    on_exit(fn ->
      Application.stop(:mixer_hosted)

      for {key, _} <- Application.get_all_env(:mixer_hosted),
          do: Application.delete_env(:mixer_hosted, key)

      for {key, value} <- prior, do: Application.put_env(:mixer_hosted, key, value)
    end)

    StartupFixture.prepare_database()
    server = start_supervised!({TLSFixture, ip: {8, 8, 8, 8}, port: 443})
    dns = start_supervised!(StartupDNSFixture)
    authority = GenServer.call(server, :authority)
    key = JOSE.JWK.generate_key({:rsa, 2048})

    public =
      key
      |> JOSE.JWK.to_public()
      |> JOSE.JWK.to_map()
      |> elem(1)
      |> Map.merge(%{"kid" => "startup-key", "alg" => "RS256", "use" => "sig"})

    TLSFixture.configure(server, {:body, Jason.encode!(%{"keys" => [public]})})
    settings = StartupFixture.configuration(StartupFixture.envelope(), [authority.ca])
    assert settings.owner_options[:resolvers] == [{{127, 0, 0, 1}, 53}]
    StartupFixture.app_settings(settings)
    assert {:ok, _} = Application.ensure_all_started(:mixer_hosted)
    assert :sys.get_state(KeyOwner).snapshots == %{}
    assert GenServer.call(dns, :queries) == []
    assert TLSFixture.info(server).accepted == 0
    {:ok, {_, port}} = MixerHostedWeb.Endpoint.server_info(:http)
    url = ~c"http://127.0.0.1:" ++ Integer.to_charlist(port) ++ ~c"/health/live"
    assert {:ok, {{_, 200, _}, _, _}} = :httpc.request(:get, {url, []}, [timeout: 2_000], [])
    token = StartupFixture.token(key)
    now = System.system_time(:second)
    assert {:ok, identity} = ConfiguredVerifier.authenticate(token, now)
    assert identity.subject == "synthetic-startup-subject"
    assert identity.identity_class == :human
    assert length(GenServer.call(dns, :queries)) == 2
    assert TLSFixture.info(server).accepted == 1
    assert map_size(:sys.get_state(KeyOwner).snapshots) == 1
    eventually(fn -> TLSFixture.info(server).closed == 1 end)
    {:ok, permit} = Admission.acquire(KeyOwner, :configured)
    {:ok, lease} = KeyOwner.checkout(KeyOwner, permit, System.system_time(:second))
    old_epoch = :sys.get_state(KeyOwner).epoch
    assert :ok = Application.stop(:mixer_hosted)
    assert Process.whereis(KeyOwner) == nil
    assert {:error, :identity_unavailable} = ConfiguredVerifier.authenticate(token, now)
    assert {:ok, _} = Application.ensure_all_started(:mixer_hosted)
    assert :sys.get_state(KeyOwner).snapshots == %{}
    refute :sys.get_state(KeyOwner).epoch == old_epoch
    assert {:error, :identity_unavailable} = KeyOwner.finish(KeyOwner, lease)
    Admission.release(permit)
    assert {:ok, _} = ConfiguredVerifier.authenticate(token, System.system_time(:second))
    eventually(fn -> TLSFixture.info(server).closed == 2 end)
    assert :ok = Application.stop(:mixer_hosted)
    assert {:ok, _} = Application.ensure_all_started(:mixer_hosted)
    TLSFixture.configure(server, :stall)

    task =
      Task.async(fn -> ConfiguredVerifier.authenticate(token, System.system_time(:second)) end)

    eventually(fn -> TLSFixture.info(server).accepted == 3 end)
    assert :ok = Application.stop(:mixer_hosted)
    assert {:error, :identity_unavailable} = Task.await(task, 3_000)
    eventually(fn -> TLSFixture.info(server).closed == 3 end)
    assert TLSFixture.info(server).sockets == %{}
    assert Process.whereis(KeyOwner) == nil
    assert Process.whereis(Module.concat(KeyOwner, FetchSupervisor)) == nil
    assert Process.whereis(MixerHostedWeb.Endpoint) == nil

    StartupFixture.evidence("startup-production-network.json", %{
      actualApplication: true,
      endpointLiveness: 200,
      namespace: "owned Linux network-none NET_ADMIN; 8.8.8.8 on lo:1",
      resolver: "127.0.0.1:53",
      destination: "8.8.8.8:443",
      startupDNSQueries: 0,
      startupConnections: 0,
      coldTokenAdmitted: true,
      coldDNSQueries: 2,
      coldConnections: 1,
      oldLeaseRejectedAfterRestart: true,
      restartColdAdmission: true,
      shutdownInflightCancelled: true,
      allThreeConnectionsClosed: true,
      fixtureKeyDirectoryRemoved: TLSFixture.info(server).key_dir_removed,
      publicAdapter: "ConfiguredVerifier.authenticate/2",
      productionPolicyBypasses: 0
    })
  end
end

093dab9d072a4c456e3d487a98444c7fb43f69f5 blob 8003
defmodule MixerHosted.Identity.TLSFixture do
  @moduledoc false
  use GenServer
  def start_link(opts \\ []), do: GenServer.start_link(__MODULE__, opts)
  def configure(pid, response), do: GenServer.call(pid, {:configure, response})
  def info(pid), do: GenServer.call(pid, :info)

  def init(opts) do
    Process.flag(:trap_exit, true)
    {:ok, _} = Application.ensure_all_started(:ssl)

    dir =
      Path.join(
        System.tmp_dir!(),
        "mixer-key-owner-tls-#{Base.url_encode64(:crypto.strong_rand_bytes(16), padding: false)}"
      )

    File.mkdir!(dir)
    File.chmod!(dir, 0o700)

    {cert, key, ca} =
      try do
        run([
          "req",
          "-x509",
          "-newkey",
          "rsa:2048",
          "-nodes",
          "-keyout",
          dir <> "/ca.key",
          "-out",
          dir <> "/ca.pem",
          "-days",
          "1",
          "-subj",
          "/CN=Mixer Fixture CA"
        ])

        run([
          "req",
          "-new",
          "-newkey",
          "rsa:2048",
          "-nodes",
          "-keyout",
          dir <> "/leaf.key",
          "-out",
          dir <> "/leaf.csr",
          "-subj",
          "/CN=jwks.fixture.invalid"
        ])

        File.write!(
          dir <> "/leaf.ext",
          "subjectAltName=DNS:jwks.fixture.invalid\nextendedKeyUsage=serverAuth\nbasicConstraints=critical,CA:FALSE\n"
        )

        if Keyword.get(opts, :validity) in [:future, :expired] do
          File.write!(dir <> "/index.txt", "")
          File.write!(dir <> "/serial", "01\n")

          File.write!(
            dir <> "/ca.conf",
            "[ca]\ndefault_ca=fixture\n[fixture]\ndatabase=#{dir}/index.txt\nserial=#{dir}/serial\nnew_certs_dir=#{dir}\ncertificate=#{dir}/ca.pem\nprivate_key=#{dir}/ca.key\ndefault_md=sha256\npolicy=policy\n[policy]\ncommonName=supplied\n"
          )

          delta = if Keyword.get(opts, :validity) == :future, do: 86_400, else: -172_800
          starts = Calendar.strftime(DateTime.add(DateTime.utc_now(), delta), "%y%m%d%H%M%SZ")

          ends =
            Calendar.strftime(DateTime.add(DateTime.utc_now(), delta + 86_400), "%y%m%d%H%M%SZ")

          run([
            "ca",
            "-batch",
            "-notext",
            "-config",
            dir <> "/ca.conf",
            "-in",
            dir <> "/leaf.csr",
            "-out",
            dir <> "/leaf.pem",
            "-startdate",
            starts,
            "-enddate",
            ends,
            "-extfile",
            dir <> "/leaf.ext"
          ])
        else
          run([
            "x509",
            "-req",
            "-in",
            dir <> "/leaf.csr",
            "-CA",
            dir <> "/ca.pem",
            "-CAkey",
            dir <> "/ca.key",
            "-CAcreateserial",
            "-out",
            dir <> "/leaf.pem",
            "-days",
            "1",
            "-extfile",
            dir <> "/leaf.ext"
          ])
        end

        [{_, cert, _}] = :public_key.pem_decode(File.read!(dir <> "/leaf.pem"))

        cert =
          if Keyword.get(opts, :tampered_signature, false) do
            n = byte_size(cert) - 1
            <<prefix::binary-size(^n), last>> = cert
            prefix <> <<:erlang.bxor(last, 1)>>
          else
            cert
          end

        [{kind, key, _}] = :public_key.pem_decode(File.read!(dir <> "/leaf.key"))
        [{_, ca, _}] = :public_key.pem_decode(File.read!(dir <> "/ca.pem"))
        {cert, {kind, key}, ca}
      after
        File.rm_rf!(dir)
      end

    ip = Keyword.get(opts, :ip, {127, 0, 0, 1})
    family = if tuple_size(ip) == 8, do: :inet6, else: :inet

    {:ok, listener} =
      :ssl.listen(Keyword.get(opts, :port, 0), [
        family,
        :binary,
        ip: ip,
        active: false,
        reuseaddr: true,
        cert: cert,
        key: key,
        versions: Keyword.get(opts, :versions, [:"tlsv1.2", :"tlsv1.3"])
      ])

    {:ok, {_, port}} = :ssl.sockname(listener)
    owner = self()
    acceptor = spawn_link(fn -> accept(listener, owner) end)

    {:ok,
     %{
       listener: listener,
       acceptor: acceptor,
       port: port,
       ip: ip,
       ca: ca,
       sockets: %{},
       requests: [],
       accepted: 0,
       closed: 0,
       max_active: 0,
       response: {:body, "{}"},
       key_dir_removed: not File.exists?(dir)
     }}
  end

  defp run(args) do
    case System.cmd("openssl", args, stderr_to_stdout: true) do
      {_, 0} -> :ok
      {out, n} -> raise "openssl fixture failed #{n}: #{String.slice(out, 0, 200)}"
    end
  end

  defp accept(listener, owner) do
    case :ssl.transport_accept(listener, 100) do
      {:ok, socket} ->
        pid =
          spawn_link(fn ->
            receive do
              :go -> serve(socket, owner)
            end
          end)

        :ok = :ssl.controlling_process(socket, pid)
        send(owner, {:accepted, pid, socket})
        send(pid, :go)
        accept(listener, owner)

      {:error, :timeout} ->
        accept(listener, owner)

      _ ->
        :ok
    end
  end

  defp serve(socket, owner) do
    try do
      with {:ok, socket} <- :ssl.handshake(socket, 3_000),
           {:ok, request} <- request(socket, "") do
        {:ok, info} = :ssl.connection_information(socket, [:sni_hostname, :protocol])
        response = GenServer.call(owner, {:request, request, info})
        respond(socket, response)
        # Observe client close even for keepalive/stall responses.
        :ssl.recv(socket, 0, 3_000)
      end
    after
      :ssl.close(socket)
      send(owner, {:closed, self()})
    end
  end

  defp request(socket, acc) do
    if String.contains?(acc, "\r\n\r\n") do
      {:ok, acc}
    else
      case :ssl.recv(socket, 0, 2_000) do
        {:ok, data} when byte_size(acc) + byte_size(data) < 4096 -> request(socket, acc <> data)
        error -> error
      end
    end
  end

  defp respond(socket, {:body, body}), do: :ssl.send(socket, response(body))
  defp respond(socket, {:raw, raw}), do: :ssl.send(socket, raw)

  defp respond(socket, {:drip, parts, delay}) do
    Enum.each(parts, fn part ->
      :ssl.send(socket, part)
      Process.sleep(delay)
    end)
  end

  defp respond(socket, {:barrier, recipient, raw}) do
    send(recipient, {:tls_response_ready, self()})

    receive do
      :release_response -> :ssl.send(socket, raw)
    after
      2_500 -> :ok
    end
  end

  defp respond(_, :stall), do: Process.sleep(3_000)

  def response(body, extra \\ []) do
    date = :httpd_util.rfc1123_date() |> List.to_string()

    headers =
      [
        {"Date", date},
        {"Cache-Control", "max-age=120"},
        {"Content-Type", "application/jwk-set+json"},
        {"Content-Length", Integer.to_string(byte_size(body))}
      ] ++ extra

    "HTTP/1.1 200 OK\r\n" <>
      Enum.map_join(headers, "", fn {k, v} -> k <> ": " <> v <> "\r\n" end) <> "\r\n" <> body
  end

  def handle_call({:configure, r}, _, s), do: {:reply, :ok, %{s | response: r}}
  def handle_call(:info, _, s), do: {:reply, Map.drop(s, [:response, :listener, :ca]), s}
  def handle_call(:authority, _, s), do: {:reply, Map.take(s, [:ip, :port, :ca]), s}

  def handle_call({:request, request, tls}, _, s),
    do: {:reply, s.response, %{s | requests: [%{request: request, tls: tls} | s.requests]}}

  def handle_info({:accepted, pid, socket}, s),
    do:
      {:noreply,
       %{
         s
         | sockets: Map.put(s.sockets, pid, socket),
           accepted: s.accepted + 1,
           max_active: max(s.max_active, map_size(s.sockets) + 1)
       }}

  def handle_info({:closed, pid}, s),
    do: {:noreply, %{s | sockets: Map.delete(s.sockets, pid), closed: s.closed + 1}}

  def handle_info({:EXIT, _, _}, s), do: {:noreply, s}

  def terminate(_, s) do
    :ssl.close(s.listener)
    Process.exit(s.acceptor, :kill)

    Enum.each(s.sockets, fn {pid, socket} ->
      :ssl.close(socket)
      Process.exit(pid, :kill)
    end)
  end
end

