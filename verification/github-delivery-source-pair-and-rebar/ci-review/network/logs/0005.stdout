      "test/mixer_hosted/identity/startup_linux_network_test.exs"
    ],
    "alias": "Keep current Mix alias test -> test --no-start unchanged. No no-compile/no-deps-check, partitions, dry-run, filters, name pattern, line selection, retries, alternate exit code or repeat-until-failure.",
    "observer": "Fixed collector-owned literal, not an ExUnit.Case or product override. Defines only a public ExUnit formatter; keep CLI formatter. Records suite/test started+finished, exact module/name/state and suite termination to bounded JSONL; at suite finish captures actual loaded application versions/module file paths+SHA, OTP patch file, VM/system/crypto identities. It never mocks a function, changes ExUnit tags/timeout, calls a product constructor, loads replacement product code or changes supervision. Missing/partial/failed observer is unqualified.",
    "requirement": "Exactly2 test_finished records for exact frozen methods, both state=nil; suite_finished once, exit0, zero skipped/excluded/invalid/failed/duplicate/missing/extra methods and both semantic JSON records. Preserve full trace. Existing --trace disables per-test ExUnit timeout, so the independent hard outer command bound remains mandatory.",
    "fresh_evidence": "Prepare archive excludes evidence, _build and temporary key paths. Create new empty /workspace/evidence/identity and observer output with exclusive creation before tests; never admit an existing observation."
  },
  "case_assertions": {
    "K03": [
      "Production DNSResolver + JWKSTransport.fetch/4; not fetch_fixture",
      "Initial A/AAAA query count2, authenticated peer8.8.8.8:443, exact valid JWKS body/snapshot",
      "Exactly1public TLS connection; sink127.0.0.1:443 accepted0",
      "Subsequent private answer rejects before any forbidden sink connection",
      "Retained production-DNS-rebinding.json agrees with actual assertion completion; ephemeral DNS port is intentional here"
    ],
    "IS04_IS05": [
      "Production StartupConfig configuration and actual Application with current Repo/Oban/KeyOwnerSupervisor/Endpoint; no fixture owner constructor",
      "DNS127.0.0.1:53, synthetic CA and configured hostname validation with public-classified8.8.8.8:443",
      "Initially0DNS/flight/connection/snapshot; health200; ConfiguredVerifier.authenticate/2 cold-admits synthetic signed token",
      "Cold query2 and connection1; snapshot1; first connection closed",
      "Stop denies old adapter; restart empty/new epoch; old lease rejected; fresh cold admission closes second connection",
      "Third connection stalls; Application.stop cancels active fetch, public result denies, third socket closes; sockets empty and owner/fetch supervisor/Endpoint absent",
      "startup-production-network.json final fields agree with passed test and synthetic key directory removed"
    ]
  },
  "production_constructor_boundary": {
    "unchanged_policy": "Manifest exact endpoint/443/hosted_https; fixed configured binding; production GlobalAddress/DNSResolver rejects private addresses; CA/hostname checks stay enabled. StartupFixture supplies explicit synthetic roots through pure StartupConfig constructor for this synthetic test only. No production runtime environment CA override, fixture module selector, loopback bypass or constructor change.",
    "production_companion": "Need separately accepted ordinary remote Phoenix prod release/exclusion evidence for final delivery source, or explicit unchanged-product source reuse approved by root. Current9e860ea receipt already passes this scope but cannot be relabelled as a new run. Do not invoke broad local harness.",
