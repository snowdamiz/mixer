+            )
+            .unwrap();
+        phase.complete().unwrap();
+        Some(value)
+    } else {
+        None
+    };
+    let mut cache = None;
+    let mut rows = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create_new(true)
