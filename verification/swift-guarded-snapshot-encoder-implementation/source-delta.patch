+pub(in crate::experimental_swift_reactor::cache::initial_profile_v1) fn observe_v2(
+    initial: &InitialProfileBorrowV1<'_>,
+) {
+    let action = action();
+    if action != "selected" && action != "ordinary" {
+        return;
+    }
+    let view = measured(|| borrow_snapshot_v2(initial));
+    if action == "ordinary" {
+        assert!(matches!(
+            view,
+            Err(SnapshotEncodeErrorV2::MissingSelectedProvenance)
+        ));
+        println!("ENCODER_MISSING_SELECTED_REFUSED");
+        return;
+    }
+    let view = view.expect("actual selected guard");
+    let mut cursor = measured(|| view.into_cursor()).expect("complete fixed header");
+    let mut transfer = [0xa5u8; 4096];
+    let mut all = Vec::new();
+    let mut blocks = 0;
+    loop {
+        let block = measured(|| cursor.next_block(&mut transfer)).expect("actual bounded block");
+        let Some(block) = block else {
+            break;
+        };
+        assert_eq!(block.offset(), all.len() as u64);
+        assert!(!block.bytes().is_empty() && block.bytes().len() <= 4096);
+        if !block.is_final() {
+            assert_eq!(block.bytes().len(), 4096);
+        }
+        all.extend_from_slice(block.bytes());
+        blocks += 1;
+        assert_eq!(cursor.emitted_extent(), all.len() as u64);
+    }
+    assert_eq!(cursor.encoded_extent(), all.len() as u64);
+    assert_eq!(blocks, (all.len() + 4095) / 4096);
+    assert!(measured(|| cursor.next_block(&mut transfer))
+        .unwrap()
+        .is_none());
+    let p = initial.cache.proof();
+    let s = &initial.scalars;
+    let facts = format!(
+        "USAGE\t{:?}\nOBS\t{:?}\nRUN\t{:?}\nOWNER\t{}\nSCALARS\t{:?}\nWASI\t{:?}\n{}",
+        p.usage(),
+        p.observations(),
+        initial.control.budget(),
+        initial.cache.owner,
+        [
+            s.source_extent,
+            s.type_count,
+            s.slot_limit,
+            s.pin_limit,
+            s.initial_nonce,
+            s.cache_base,
+            s.cache_capacity,
+            s.entry_limit
+        ],
+        initial.wasi.map(AccountedWasi::snapshot_configuration_v2),
+        oracle_inventory_v2(initial)
+    );
+    std::fs::write(directory().join("actual.mixsnb02"), all).unwrap();
+    std::fs::write(directory().join("actual.facts"), facts).unwrap();
+    println!("ENCODER_GENUINE_GUARD blocks={blocks} allocation_calls=0");
+}
+fn selected_entry() {
