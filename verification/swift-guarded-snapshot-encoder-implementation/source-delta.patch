+            Instant::now(),
+            Cancellation::default(),
+        )
+        .unwrap();
+    let wasi = if std::env::var("MIXER_ENCODER_WASI").unwrap_or_default() == "some" {
+        let mut phase = AccountedWasi::prepare(&mut control, CONSTRUCTION_CURSOR_V1).unwrap();
+        let value = phase
+            .construct(
+                WasiGrants {
+                    secure_random: true,
+                    realtime: false,
+                    monotonic: true,
+                    stdout: true,
+                    stderr: false,
