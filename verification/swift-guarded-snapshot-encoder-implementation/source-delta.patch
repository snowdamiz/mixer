+fn emit() {
+    let mut bytes = fixture(0, &[0, 0x0b], 64);
+    assert_eq!(bytes.len(), 1947);
+    if std::env::var("MIXER_ENCODER_FIXTURE").unwrap_or_default() == "segments" {
+        // Find the code section by reading the existing standard section lengths.
+        let mut at = 8;
+        while at < bytes.len() {
+            let begin = at;
+            let id = bytes[at];
+            at += 1;
+            let mut size = 0usize;
+            let mut shift = 0;
+            loop {
+                let b = bytes[at];
+                at += 1;
+                size |= ((b & 127) as usize) << shift;
+                shift += 7;
+                if b & 128 == 0 {
+                    break;
+                }
+            }
+            if id == 10 {
+                let mut element = Vec::new();
+                section(9, &[1, 0, 0x41, 0, 0x0b, 1, 34], &mut element);
+                bytes.splice(begin..begin, element);
+                break;
+            }
+            at += size;
+        }
+        section(11, &[1, 0, 0x41, 0, 0x0b, 3, b'a', b'b', b'c'], &mut bytes);
+    }
+    validate_swift_reactor(
+        &bytes,
+        SwiftValidationBudget::default(),
+        &Cancellation::default(),
+    )
+    .expect("genuine new derivative validation");
+    std::fs::write(directory().join("fixture.wasm"), &bytes).unwrap();
+    println!("GENUINE_FIXTURE {}", bytes.len());
+}
