{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "const": {
    "beam": {
      "crashDump": "/dev/null",
      "crashDumpSeconds": 0,
      "distributed": false,
      "flags": [
        "+S",
        "2:2",
        "+SDcpu",
        "1",
        "+SDio",
        "1",
        "+A",
        "2",
        "+P",
        "32768",
        "+Q",
        "1024",
        "-start_epmd",
        "false"
