 """Pure classification and exact oracle replay; no runtime/module orchestration."""
 import copy
+import math
 SCHEMA = 'mixer.apple-focus-reference-precondition.1'
 REFERENCE = 'plain-uibutton-reference'
 CASE = 'keyboard-enabled-off'
+
+
+def strict_json_equal(left, right):
+    """Exact JSON value types, complete object membership, and finite float values."""
+    if type(left) is not type(right): return False
+    if type(left) is dict:
+        return (all(type(key) is str for key in left) and all(type(key) is str for key in right)
+                and left.keys() == right.keys() and all(strict_json_equal(value, right[key]) for key, value in left.items()))
+    if type(left) is list:
+        return len(left) == len(right) and all(strict_json_equal(a, b) for a, b in zip(left, right))
+    if type(left) is float: return math.isfinite(left) and math.isfinite(right) and left == right
+    if left is None or type(left) in (str, bool, int): return left == right
+    return False
 
 
