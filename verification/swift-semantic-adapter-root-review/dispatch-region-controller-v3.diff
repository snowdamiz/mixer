+def control(path, expected=None):
+    with path.open("rb") as handle:
+        data = handle.read(1048577)
+    assert len(data) <= 1048576
+    if expected is not None:
+        assert hashlib.sha256(data).hexdigest() == expected, str(path)
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            assert key not in result, "duplicate control key"
+            result[key] = value
+        return result
+    return json.loads(data, object_pairs_hook=pairs,
+                      parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))
+
+def generated_inventory(build, offset):
+    rows, pending, count, size = [], [build], 0, 0
+    assert stat.S_ISDIR(build.lstat().st_mode)
+    while pending:
+        deadline(offset)
+        with os.scandir(pending.pop()) as entries:
+            for entry in entries:
+                deadline(offset)
+                count += 1
+                assert count <= 64, "generated member cap"
+                info = entry.stat(follow_symlinks=False)
+                path = Path(entry.path)
+                if stat.S_ISDIR(info.st_mode):
+                    pending.append(path)
+                else:
+                    assert stat.S_ISREG(info.st_mode), "generated non-regular file or symlink"
+                    size += info.st_size
+                    assert size <= 33554432, "generated byte cap"
+                    rows.append({"path": str(path.relative_to(build)), "bytes": info.st_size})
+    # The bounded membership/type/size pass finishes before hashing any file.
+    for row in rows:
+        row["sha256"] = digest(build / row["path"], offset)
+    return sorted(rows, key=lambda row: row["path"])
 
