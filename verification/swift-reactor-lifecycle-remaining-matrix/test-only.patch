+            0 => o.wasi.as_mut().unwrap().host_test_dispatch(true, false),
+            1 => o.wasi.as_mut().unwrap().host_test_dispatch(false, true),
+            2 => o.wasi.as_mut().unwrap().host_test_cancel_at(0),
