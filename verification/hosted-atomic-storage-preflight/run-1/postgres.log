2026-10-24 03:39:21.777 EDT [4063] LOG:  statement: CREATE FUNCTION mixer_hosted_release.upload_v1(c mixer_hosted_release.call_context,i mixer_hosted_release.upload_input,r mixer_hosted_release.upload_request) RETURNS mixer_hosted_release.upload_result LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog SET row_security=on AS $$
