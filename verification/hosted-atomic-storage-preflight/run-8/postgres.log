2026-10-24 03:55:53.986 EDT [13525] LOG:  statement: CREATE FUNCTION mixer_hosted_release.upload_v1(c mixer_hosted_release.call_context,i mixer_hosted_release.upload_input,r mixer_hosted_release.upload_request) RETURNS mixer_hosted_release.upload_result LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog SET row_security=on AS $$
	DECLARE h mixer_hosted_release.tenant_heads%ROWTYPE;d mixer_hosted_release.idempotency%ROWTYPE;old mixer_hosted_release.artifacts%ROWTYPE;prior mixer_hosted_release.audit_events%ROWTYPE;ev record;target_bytes bytea;event_bytes bytea;state_bytes bytea;state_next bytea;event_hash bytea;event_id numeric;result_body bytea;status int;display jsonb;actual_change boolean;fault text;actor_bytes bytea;decision_bytes bytea;target_display jsonb;zero bytea:=decode(repeat('00',32),'hex');
	BEGIN
	 -- current_user intentionally changed by SECURITY DEFINER; never compare it with captured runtime.
	 IF current_user<>'mxas_writer' OR session_user<>'mxas_runtime' OR current_setting('role')<>'none' OR c.runtime_role IS DISTINCT FROM 'mxas_runtime'::name OR c.backend IS DISTINCT FROM pg_backend_pid() OR c.full_xid IS DISTINCT FROM pg_current_xact_id()::text OR c.database_name IS DISTINCT FROM current_database() OR c.nonce IS NULL OR octet_length(c.nonce)<>64 OR c.nonce IS DISTINCT FROM current_setting('mixer_atomic.invocation_nonce',true) OR c.deadline IS NULL OR c.deadline<=clock_timestamp() OR c.deadline>clock_timestamp()+interval '5 seconds' OR c.actor::text IS DISTINCT FROM current_setting('mixer_atomic.actor',true) OR current_setting('mixer_atomic.action',true) IS DISTINCT FROM 'artifact.upload' THEN RAISE EXCEPTION 'context rejected' USING ERRCODE='42501';END IF;
	 IF i.organization IS DISTINCT FROM 'o' OR i.project IS DISTINCT FROM 'p' OR i.app IS DISTINCT FROM 'a' OR i.environment IS DISTINCT FROM 'e' OR i.platform IS DISTINCT FROM 'ios' OR i.app IS DISTINCT FROM current_setting('mixer_atomic.app',true) OR i.environment IS DISTINCT FROM current_setting('mixer_atomic.environment',true) OR i.platform IS DISTINCT FROM current_setting('mixer_atomic.platform',true) OR encode(i.runtime,'hex') IS DISTINCT FROM current_setting('mixer_atomic.runtime',true) OR encode(i.manifest,'hex') IS DISTINCT FROM current_setting('mixer_atomic.manifest',true) THEN RAISE EXCEPTION 'target rejected' USING ERRCODE='42501';END IF;
	 IF octet_length(i.runtime) IS DISTINCT FROM 32 OR octet_length(i.manifest) IS DISTINCT FROM 32 OR i.canonical_manifest IS NULL OR octet_length(i.canonical_manifest) NOT BETWEEN 1 AND 65536 OR sha256(i.canonical_manifest) IS DISTINCT FROM i.manifest OR i.signed_document IS NULL OR octet_length(i.signed_document) NOT BETWEEN 1 AND 65536 OR octet_length(i.signature) IS DISTINCT FROM 64 OR octet_length(i.payload_hash) IS DISTINCT FROM 32 OR i.payload_size IS NULL OR i.payload_size<1 OR i.payload_size>4194304 OR trunc(i.payload_size)<>i.payload_size OR i.blob_ref IS DISTINCT FROM 'sha256:'||encode(i.payload_hash,'hex') THEN RAISE EXCEPTION 'artifact rejected';END IF;
	 IF r.key IS NULL OR octet_length(r.key) NOT BETWEEN 1 AND 128 OR r.key!~'^[A-Za-z0-9_.-]+$' OR r.path IS DISTINCT FROM '/v3/private/artifacts' OR r.body IS NULL OR octet_length(r.body) NOT BETWEEN 1 AND 6291456 OR octet_length(r.request_hash) IS DISTINCT FROM 32 OR r.request_hash IS DISTINCT FROM sha256(convert_to('POST '||r.path,'UTF8')||decode('00','hex')||r.body) OR r.reason IS NULL OR octet_length(r.reason)>512 OR r.request_id IS NULL OR (r.source_ip IS NOT NULL AND (octet_length(r.source_ip)>45 OR host(r.source_ip::inet) IS DISTINCT FROM r.source_ip)) THEN RAISE EXCEPTION 'request rejected';END IF;
	 target_bytes:=mixer_hosted_release.target(i);
	 -- Synthetic canonical auth lock; full five-class lock chain belongs to next product lane.
	 PERFORM 1 FROM mixer_authz.fixture_policy f WHERE f.actor=c.actor FOR SHARE;
	 IF NOT FOUND THEN RAISE EXCEPTION 'missing policy lock';END IF;
	 SELECT * INTO h FROM mixer_hosted_release.tenant_heads x WHERE x.organization=i.organization AND x.project=i.project FOR UPDATE;
	 IF NOT FOUND THEN RAISE EXCEPTION 'missing tenant head';END IF;
	 -- Separate volatile SQL statement after all locks, before ANY idempotency lookup.
	 SELECT * INTO ev FROM mixer_authz.evidence(c.actor);
	 IF c.authentication_completed_at IS NULL OR c.authentication_completed_at<0 OR c.authentication_completed_at>9007199254740991 OR trunc(c.authentication_completed_at)<>c.authentication_completed_at OR c.authentication_completed_at::text IS DISTINCT FROM current_setting('mixer_atomic.authentication_completed_at',true) OR c.authentication_completed_at>=c.expires_at OR c.authentication_completed_at>ev.now_s+30 OR c.authentication_completed_at<ev.now_s-45 OR ev.now_s>=c.expires_at OR c.expires_at IS NULL OR c.expires_at::text IS DISTINCT FROM current_setting('mixer_atomic.expires',true) OR c.deadline<=clock_timestamp() THEN RAISE EXCEPTION 'expired' USING ERRCODE='42501';END IF;
	 IF h.last_event=0 THEN
	  IF h.audit_hash<>''::bytea OR h.state_hash<>mixer_hosted_release.hash_domain('mixer.hosted.state.v1',mixer_hosted_release.a(ARRAY[mixer_hosted_release.u(1),mixer_hosted_release.t(i.organization),mixer_hosted_release.t(i.project)])) THEN RAISE EXCEPTION 'initial head corrupt';END IF;
	 ELSE
	  SELECT * INTO prior FROM mixer_hosted_release.audit_events x WHERE x.organization=i.organization AND x.project=i.project AND x.event_id=h.last_event;
	  IF NOT FOUND OR prior.display_json->>'id' IS DISTINCT FROM h.last_event::text OR prior.display_json->'tenant' IS DISTINCT FROM jsonb_build_array(i.organization,i.project) OR prior.display_json->'target'->>0 IS DISTINCT FROM i.organization OR prior.display_json->'target'->>1 IS DISTINCT FROM i.project OR prior.display_json->>'audit_schema' IS DISTINCT FROM '1' OR prior.display_json->>'action' IS DISTINCT FROM 'artifact.upload' OR prior.event_hash IS DISTINCT FROM h.audit_hash OR prior.event_hash IS DISTINCT FROM mixer_hosted_release.hash_domain('mixer.hosted.audit.v1',prior.event_cbor) OR mixer_hosted_release.event_from_display(prior.display_json) IS DISTINCT FROM prior.event_cbor OR prior.previous_hash IS DISTINCT FROM mixer_hosted_release.hx(prior.display_json->>'previous_hash') OR prior.previous_state IS DISTINCT FROM mixer_hosted_release.hx(prior.display_json->>'previous_state') OR prior.current_state IS DISTINCT FROM mixer_hosted_release.hx(prior.display_json->>'current_state') OR prior.current_state IS DISTINCT FROM h.state_hash OR convert_to(prior.display_json::text,'UTF8') IS DISTINCT FROM prior.display_bytes OR prior.display_json->>'hash' IS DISTINCT FROM encode(prior.event_hash,'hex') THEN RAISE EXCEPTION 'head corrupt';END IF;
	 END IF;
	 SELECT * INTO d FROM mixer_hosted_release.idempotency x WHERE x.organization=i.organization AND x.project=i.project AND x.key=r.key;
	 IF FOUND THEN
	  IF d.actor IS DISTINCT FROM c.actor OR d.action IS DISTINCT FROM 'artifact.upload' OR d.target IS DISTINCT FROM target_bytes OR d.request_hash IS DISTINCT FROM r.request_hash THEN RAISE EXCEPTION 'idempotency conflict' USING ERRCODE='23505';END IF;
	  RETURN (d.status,d.response,d.event_id,true)::mixer_hosted_release.upload_result;
	 END IF;
