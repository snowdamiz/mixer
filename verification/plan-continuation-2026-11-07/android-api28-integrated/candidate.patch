+    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />
+    <application android:theme="@android:style/Theme.Material.Light.NoActionBar"
+        android:label="Mixer private API28 linkage" android:hasCode="true"
+        android:debuggable="true" android:extractNativeLibs="true">
+        <activity android:name="dev.mixer.android.MixerActivity" android:exported="false" />
+        <activity android:name="dev.mixer.android.NativeLowerApiCompatibilityActivity"
+            android:exported="false" />
