+def wait_for_shutdown(backend, owned, baseline, row):
+    """Only a positively observed asynchronous shutdown may be waited on.
+
+    Ten seconds and twenty observations are experimental bounds, not readiness
+    evidence. Each observation rechecks outside devices and retained windows.
+    """
+    if row is None or row['state'] != 'Shutting Down':
+        return row
+    deadline = time.monotonic() + 10
+    previous_deadline = getattr(backend, '_observation_deadline', None)
+    backend._observation_deadline = min(deadline, previous_deadline) if previous_deadline else deadline
+    try:
+        for _ in range(20):
+            guard_custody(backend)
+            require(time.monotonic() < deadline, 'Owned device not positively Shutdown within bound')
+            row = check_snapshot(backend, owned, baseline)
+            require(time.monotonic() < deadline, 'Owned device not positively Shutdown within bound')
+            require(row is not None, 'Owned device disappeared during shutdown transition')
+            if row['state'] == 'Shutdown':
+                require(backend.windows_for_device(owned.uuid) == [], 'Owned window reappeared during shutdown')
+                return row
+            require(row['state'] == 'Shutting Down', 'Owned device not positively Shutdown; invalid transition')
+            require(backend.windows_for_device(owned.uuid) == [], 'Owned window reappeared during shutdown')
+            time.sleep(min(.25, max(0, deadline-time.monotonic())))
+        raise Refused('Owned device not positively Shutdown within observation bound')
+    except BaseException as error:
+        backend.unknown = True
+        if getattr(backend, 'c', None) is not None:
+            backend.c.unresolved = True
+        backend.preservation_failure = dict(type=type(error).__name__, message=str(error),
+            ownedUUID=owned.uuid, rootRecoveryRequired=True)
+        raise
+    finally:
+        backend._observation_deadline = previous_deadline
+
+
 def cleanup(backend, owned, baseline):
     """Any unknown identity/drift stops further mutation. Never quits Simulator."""
     guard_custody(backend)
