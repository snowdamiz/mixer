+        run: |
+          set -euo pipefail
+          MIXER_ADOPTION_DIR="$GITHUB_WORKSPACE/verification/shared-fixture-default-ci-adoption"
+          MIXER_SHARED_INPUT_DIR="$GITHUB_WORKSPACE/verification/cache-fixture-shared-input-candidate-v2"
+          python3 -B "$MIXER_ADOPTION_DIR/test_adoption.py" -v \
+            > "$MIXER_ADOPTION_DIR/logs/adoption-controls.stdout" \
+            2> "$MIXER_ADOPTION_DIR/logs/adoption-controls.stderr"
+          python3 -B "$MIXER_SHARED_INPUT_DIR/test_materializer.py" -v \
+            > "$MIXER_SHARED_INPUT_DIR/logs/materializer-controls.stdout" \
+            2> "$MIXER_SHARED_INPUT_DIR/logs/materializer-controls.stderr"
+          python3 -B "$MIXER_SHARED_INPUT_DIR/test_runner.py" -v \
+            > "$MIXER_SHARED_INPUT_DIR/logs/runner-controls.stdout" \
+            2> "$MIXER_SHARED_INPUT_DIR/logs/runner-controls.stderr"
+      - name: One complete shared fixture on the existing admitted compiler
+        timeout-minutes: 12
+        shell: bash
+        run: |
+          set -euo pipefail
+          MIXER_ADOPTION_DIR="$GITHUB_WORKSPACE/verification/shared-fixture-default-ci-adoption"
+          MIXER_SHARED_INPUT_DIR="$GITHUB_WORKSPACE/verification/cache-fixture-shared-input-candidate-v2"
+          {
+            MIXER_CACHE_RUSTC_LAUNCHER="$(command -v rustc)"
+            python3 -B "$MIXER_ADOPTION_DIR/adopt_fixture.py" run \
