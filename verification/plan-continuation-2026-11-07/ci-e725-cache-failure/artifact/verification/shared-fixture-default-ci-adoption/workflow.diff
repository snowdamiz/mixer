+            /verification/swift-cache-state-ci/check_cache_state.py
+            /verification/cache-fixture-shared-input-candidate-v2/
+            /verification/cache-fixture-shared-input-review/
+            /verification/shared-fixture-default-ci-adoption/
+            /.github/workflows/verify.yml
+      - name: Bind shared fixture adoption and materialize the thin overlay
+        timeout-minutes: 2
+        shell: bash
+        run: |
+          set -euo pipefail
+          MIXER_ADOPTION_DIR="$GITHUB_WORKSPACE/verification/shared-fixture-default-ci-adoption"
+          MIXER_SHARED_INPUT_DIR="$GITHUB_WORKSPACE/verification/cache-fixture-shared-input-candidate-v2"
+          mkdir -p "$MIXER_ADOPTION_DIR/logs" "$MIXER_SHARED_INPUT_DIR/logs" "$MIXER_SHARED_INPUT_DIR/runs"
+          {
+            git rev-parse HEAD HEAD^{tree}
+            python3 --version
+            uname -srm
+            python3 -B "$MIXER_ADOPTION_DIR/adopt_fixture.py" verify --workflow-installed
+            python3 -B "$MIXER_SHARED_INPUT_DIR/materialize_pack.py"
+          } > "$MIXER_ADOPTION_DIR/logs/preflight.stdout" \
+            2> "$MIXER_ADOPTION_DIR/logs/preflight.stderr"
+      - name: Shared fixture runner, materializer and adoption focused controls
+        timeout-minutes: 3
