{application,mixer_hosted,
    [{modules,
         ['Elixir.Inspect.MixerHosted.Identity.StartupConfig',
          'Elixir.Inspect.MixerHosted.RuntimeConfig',
          'Elixir.MixerHosted.Application',
          'Elixir.MixerHosted.Audit.UploadEvent',
          'Elixir.MixerHosted.Billing.RawWebhookCapture',
          'Elixir.MixerHosted.Billing.WebhookSignature',
          'Elixir.MixerHosted.Billing.WebhookTransport',
          'Elixir.MixerHosted.Billing.WebhookTransport.Guard',
          'Elixir.MixerHosted.Billing.WebhookTransport.Owner',
          'Elixir.MixerHosted.Billing.WebhookTransport.Sinks',
          'Elixir.MixerHosted.Identity.AccessTokenVerifier',
          'Elixir.MixerHosted.Identity.Admission',
          'Elixir.MixerHosted.Identity.BoundedJSON',
          'Elixir.MixerHosted.Identity.BoundedTCP',
          'Elixir.MixerHosted.Identity.ConfiguredVerifier',
          'Elixir.MixerHosted.Identity.DNSResolver',
          'Elixir.MixerHosted.Identity.Encoding',
          'Elixir.MixerHosted.Identity.FetchFlight',
          'Elixir.MixerHosted.Identity.GlobalAddress',
          'Elixir.MixerHosted.Identity.HTTPFreshness',
          'Elixir.MixerHosted.Identity.HTTPWireGuard',
          'Elixir.MixerHosted.Identity.JWKSTransport',
          'Elixir.MixerHosted.Identity.KeyOwner',
          'Elixir.MixerHosted.Identity.KeyOwner.Lease',
          'Elixir.MixerHosted.Identity.KeyOwnerSupervisor',
          'Elixir.MixerHosted.Identity.Manifest',
          'Elixir.MixerHosted.Identity.StartupConfig',
          'Elixir.MixerHosted.Identity.TrustSnapshot',
          'Elixir.MixerHosted.Identity.VerifiedIdentity',
          'Elixir.MixerHosted.Identity.Verifier',
          'Elixir.MixerHosted.Protocol.ArtifactAdmission',
          'Elixir.MixerHosted.Protocol.ArtifactAdmission.Checked',
          'Elixir.MixerHosted.Protocol.ArtifactCBOR',
          'Elixir.MixerHosted.Protocol.ArtifactJSON',
          'Elixir.MixerHosted.Protocol.ArtifactV3Policy',
          'Elixir.MixerHosted.Repo','Elixir.MixerHosted.RuntimeConfig',
          'Elixir.MixerHostedWeb.Endpoint','Elixir.MixerHostedWeb.ErrorJSON',
          'Elixir.MixerHostedWeb.HealthController',
          'Elixir.MixerHostedWeb.Router',
          'Elixir.MixerHostedWeb.Router.Helpers']},
     {compile_env,
         [{mixer_hosted,
              ['Elixir.MixerHostedWeb.Endpoint',code_reloader],
              error},
          {mixer_hosted,
              ['Elixir.MixerHostedWeb.Endpoint',debug_errors],
              {ok,false}},
          {mixer_hosted,['Elixir.MixerHostedWeb.Endpoint',force_ssl],error},
          {mixer_raw_capture_candidate,[test_build],error}]},
     {optional_applications,[]},
     {applications,
         [kernel,stdlib,elixir,logger,ssl,inets,phoenix,plug,bandit,ecto_sql,
          postgrex,oban,jason,jose,mint]},
     {description,"mixer_hosted"},
     {registered,[]},
     {vsn,"0.1.0"},
     {mod,{'Elixir.MixerHosted.Application',[]}}]}.
