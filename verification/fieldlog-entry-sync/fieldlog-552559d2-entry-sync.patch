+  func prepareEntryUpload(workspaceID: UUID, projectID: UUID, eventID: UUID) throws -> EntryUpload {
+    guard !unavailable else { throw FieldLogError.storage("Reopen the workspace before sending changes.") }
+    guard workspace.id == workspaceID else { throw EntrySyncClient.Failure.wrongScope }
+    guard let event = workspace.outbox.first(where: { $0.id == eventID && $0.kind == .entrySaved }),
+      let entry = workspace.entries.first(where: { $0.id == event.recordID })
+    else { throw FieldLogError.missingRecord }
+    guard entry.projectID == projectID else { throw EntrySyncClient.Failure.wrongScope }
+    guard entry.attachmentIDs.count == 1, let photoID = entry.attachmentIDs.first else {
+      throw EntrySyncClient.Failure.requiresOnePhoto
+    }
+    guard let attachment = workspace.attachments.first(where: { $0.id == photoID }) else {
+      throw FieldLogError.missingRecord
+    }
+    let jpeg = try Data(contentsOf: photoURL(photoID))
+    guard jpeg.count == attachment.byteCount, jpeg.starts(with: [0xff, 0xd8, 0xff]) else {
+      throw FieldLogError.storage("This photo is damaged. Its record has been preserved.")
+    }
+    return EntryUpload(event: event, entry: entry, photo: .init(id: photoID, jpeg: jpeg))
+  }
+  func acknowledgeEntryUpload(_ upload: EntryUpload, workspaceID: UUID) throws {
+    try Task.checkCancellation()
+    guard workspace.id == workspaceID else { throw EntrySyncClient.Failure.wrongScope }
+    // A concurrent retry can already have retired this exact event.
+    guard let pending = workspace.outbox.first(where: { $0.id == upload.event.id }) else { return }
+    guard pending == upload.event, workspace.entries.contains(upload.entry) else {
+      throw FieldLogError.staleRevision
+    }
+    try transact { next in
+      next.outbox.removeAll { $0.id == upload.event.id }
+    }
+  }
