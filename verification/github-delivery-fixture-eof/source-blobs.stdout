defmodule MixerHosted.Authorization.PostgresRepository do
  @moduledoc """
  Durable, read-only policy evidence on a fresh protected PostgreSQL transaction.

  This implements the existing callback-envelope seam. Its result remains a pure
  evaluation; no domain repository may accept it as transaction-bound authority.
  Deployment must separately provision a non-owner read-only runtime and grant
  only the migration's fixed lock helpers. No positive evidence is cached.
  """
  @behaviour MixerHosted.Authorization.Repository

  alias MixerHosted.Authorization.Postgres.{Evidence, Session}
  alias MixerHosted.Authorization.Scope

  @impl true
  def with_evidence(lookup, callback), do: with_evidence(lookup, callback, MixerHosted.Repo)

  @doc false
  def with_evidence(lookup, callback, repo) do
    with true <- is_function(callback, 1),
         {:ok, lookup} <- valid_lookup(lookup),
         false <- repo.in_transaction?() do
      case repo.transaction(
             fn ->
               linkage = Session.prepare!(repo, lookup)
               evidence = Evidence.load!(repo, lookup, linkage)
               result = callback.(evidence)
               Session.finish!(repo)
               result
             end,
             timeout: 5_000,
             queue: false
           ) do
        {:ok, result} -> result
        {:error, reason} when reason in [:unauthenticated, :not_found] -> {:error, reason}
        _ -> {:error, :authorization_unavailable}
      end
    else
      _ -> {:error, :authorization_unavailable}
    end
  rescue
    _ -> {:error, :authorization_unavailable}
  catch
    _, _ -> {:error, :authorization_unavailable}
  end

  defp valid_lookup(%{identity: identity, action: action, target: target} = lookup)
       when map_size(lookup) == 3 and is_map(identity) and not is_struct(identity) and
              map_size(identity) == 7,
       do: validate(lookup, action, target)

  defp valid_lookup(_), do: :error

  defp validate(lookup, action, target) do
    alias MixerHosted.Identity.Encoding
    i = lookup.identity

    with true <-
           Enum.sort(Map.keys(i)) ==
             Enum.sort([
               :profile_id,
               :profile_version,
               :issuer,
               :subject,
               :client_id,
               :identity_class,
               :credential_ref
             ]),
         true <- Encoding.bounded_string?(i.profile_id, 128),
         true <- is_integer(i.profile_version) and i.profile_version in 1..2_147_483_647,
         true <- Encoding.bounded_string?(i.issuer, 2_048),
         true <- Encoding.bounded_string?(i.subject, 256),
         true <- Encoding.bounded_string?(i.client_id, 256),
         true <- Encoding.bounded_string?(i.credential_ref, 256),
         true <- i.identity_class == :human,
         {:ok, scope} <- Scope.new(target),
         true <-
           (action in ["artifact.read", "artifact.upload"] and Scope.environment?(scope)) or
             (action == "audit.read" and Scope.project_only?(scope)) do
      {:ok, %{lookup | target: scope}}
    else
      _ -> :error
    end
  end
end

a905704602a0e0cd763d660abc2aa63288ceed41 blob 3591
defmodule MixerHosted.Authorization.Repository do
  @moduledoc """
  Trusted repository seam for the pure first-slice policy; no durable adapter exists.

  A configured server module must start or join the actual protected Repo
  transaction, take current principal/credential/authorization-head locks, resolve
  current memberships and actual stored target ancestry, and invoke the callback
  there, returning the callback envelope unchanged. Apply same-connection storage
  policy and recheck before persistence.
  Revocation writers must take conflicting locks in the same canonical order.
  No cached positive evidence, caller roles, self-reported revisions, request
  ancestry or detached callback may substitute for that protocol.

  This facade returns only a policy evaluation. It does not create the separate
  transaction-bound context required by domain stores, execute domain callbacks,
  or implement RLS, database locks, provisioning, HTTP, service or CI authority.
  Repository selection is trusted server configuration, never HTTP input.
  The request-local reference envelope detects missing callbacks and accidental
  cross-request results. Projection checks reject malformed callback results.
  Neither mechanism is a sandbox for malicious code in the trusted BEAM process,
  a transferable authority token, or proof of a current database transaction.
  """

  alias MixerHosted.Authorization.{Policy, Scope}

  @type lookup :: %{identity: map(), action: binary(), target: Scope.t()}
  @type evaluation :: {:policy_evaluation, reference(), Policy.result()}
  @callback with_evidence(lookup(), (Policy.evidence() -> evaluation())) ::
              evaluation() | {:error, Policy.error()}

  defmodule Unavailable do
    @moduledoc false
    @behaviour MixerHosted.Authorization.Repository
    @impl true
    def with_evidence(_lookup, _callback), do: {:error, :authorization_unavailable}
  end

  @spec evaluate(term(), term(), term(), term(), module()) :: Policy.result()
  def evaluate(identity, action, target, now, repository \\ Unavailable) do
    with {:ok, scope} <- Policy.request(identity, action, target, now),
         true <-
           is_atom(repository) and Code.ensure_loaded?(repository) and
             function_exported?(repository, :with_evidence, 2) do
      lookup = %{identity: Policy.identity_key(identity), action: action, target: scope}
      reference = make_ref()

      case repository.with_evidence(lookup, fn evidence ->
             {:policy_evaluation, reference,
              Policy.evaluate(identity, action, scope, evidence, now)}
           end) do
        {:policy_evaluation, ^reference, {:ok, decision} = result} ->
          if Policy.valid_decision?(decision, identity, action, scope, now),
            do: result,
            else: {:error, :authorization_unavailable}

        {:policy_evaluation, ^reference, {:error, _} = result} ->
          failure(result)

        {:error, _} = result ->
          failure(result)

        _ ->
          {:error, :authorization_unavailable}
      end
    else
      false -> {:error, :authorization_unavailable}
      error -> error
    end
  rescue
    _ -> {:error, :authorization_unavailable}
  catch
    _, _ -> {:error, :authorization_unavailable}
  end

  defp failure({:error, error} = result)
       when error in [
              :invalid_request,
              :unauthenticated,
              :not_found,
              :permission_denied,
              :authorization_unavailable
            ],
       do: result

  defp failure(_), do: {:error, :authorization_unavailable}
end

cce5e717a5d8762c43a7b2e2bb1ad8780cfc218f blob 2264
defmodule MixerHosted.Authorization.Scope do
  @moduledoc "Bounded tenant ancestry for policy evaluation; a scope grants no authority."

  @fields [:organization_id, :project_id, :application_id, :environment_id]
  @enforce_keys [:organization_id]
  defstruct @fields

  @type t :: %__MODULE__{
          organization_id: binary(),
          project_id: binary() | nil,
          application_id: binary() | nil,
          environment_id: binary() | nil
        }

  @spec new(term()) :: {:ok, t()} | {:error, :invalid_scope}
  def new(%__MODULE__{} = scope) when map_size(scope) == 5,
    do: normalize(Map.from_struct(scope))

  def new(%{} = scope) when not is_struct(scope), do: normalize(scope)
  def new(_), do: {:error, :invalid_scope}

  defp normalize(scope) when map_size(scope) in 1..4 do
    values = Enum.map(@fields, &Map.get(scope, &1))

    if Enum.all?(Map.keys(scope), &(&1 in @fields)) and identifier?(hd(values)) and
         ancestor_path?(values) do
      {:ok, struct!(__MODULE__, scope)}
    else
      {:error, :invalid_scope}
    end
  end

  defp normalize(_), do: {:error, :invalid_scope}

  defp ancestor_path?(values) do
    {present, absent} = Enum.split_while(values, &(not is_nil(&1)))
    Enum.all?(present, &identifier?/1) and Enum.all?(absent, &is_nil/1)
  end

  @doc false
  def identifier?(value),
    do:
      is_binary(value) and byte_size(value) in 1..128 and String.valid?(value) and
        String.printable?(value) and value != "*" and
        Enum.all?(String.to_charlist(value), &(&1 >= 32 and &1 not in 127..159))

  @doc false
  def project?(%__MODULE__{project_id: project}), do: not is_nil(project)

  @doc false
  def project_only?(%__MODULE__{project_id: project, application_id: nil}),
    do: not is_nil(project)

  def project_only?(_), do: false

  @doc false
  def environment?(%__MODULE__{environment_id: environment}), do: not is_nil(environment)

  @doc false
  def membership_covers?(membership, target) do
    source = membership.scope

    source.organization_id == target.organization_id and
      ((source.project_id == nil and membership.project_binding == :all_projects) or
         (source.project_id == target.project_id and
            membership.project_binding == :exact_project))
  end
end

5d556da67db1a14ecd784d8add8876c5483c7c63 blob 6912
defmodule MixerHosted.Authorization.Transaction.Context do
  @moduledoc """
  Request-local trusted API discipline for a live owned SQL transaction.

  Contexts are checked by complete equality against one bounded owner-process
  binding and by the actual connection, transaction and transaction-local marker.
  Structs and the process dictionary are not a sandbox against malicious BEAM
  code. A returned or copied context is not a reusable authorization ticket.
  """

  alias MixerHosted.Authorization.Policy
  alias MixerHosted.Authorization.Postgres.Session
  alias MixerHosted.Authorization.Transaction.Snapshot

  @key {__MODULE__, :active}
  @required_scopes %{
    "artifact.read" => "mixer.artifact.read",
    "artifact.upload" => "mixer.artifact.upload",
    "audit.read" => "mixer.audit.read"
  }
  @effect_errors [
    :invalid_request,
    :unauthenticated,
    :not_found,
    :permission_denied,
    :authorization_unavailable,
    :conflict,
    :immutable_conflict,
    :idempotency_conflict,
    :storage_unavailable
  ]
  @settings ~w(profile_id profile_version issuer subject client_id identity_class credential_ref organization_id project_id application_id environment_id principal_id family_id action transaction_marker token_issued_at token_expires_at required_scope phase directory_mode)
  @enforce_keys [
    :owner,
    :repo,
    :dynamic_repo,
    :connection,
    :marker,
    :identity,
    :action,
    :target,
    :snapshot,
    :admitted_at,
    :deadline
  ]
  defstruct @enforce_keys

  defmodule Invalid do
    defexception message: "authorization context is unavailable"
  end

  @doc false
  def active?, do: not is_nil(Process.get(@key))

  @doc false
  def clear!, do: Process.delete(@key)

  @doc false
  def bind!(repo, identity, action, target, evidence, snapshot, admitted_at, deadline) do
    if active?(), do: fail!()
    marker = Base.encode16(:crypto.strong_rand_bytes(32), case: :lower)

    Session.context!(repo,
      action: action,
      transaction_marker: marker,
      token_issued_at: Integer.to_string(identity.issued_at),
      token_expires_at: Integer.to_string(identity.expires_at),
      required_scope: Map.fetch!(@required_scopes, action),
      phase: "effect"
    )

    context = %__MODULE__{
      owner: self(),
      repo: repo,
      dynamic_repo: repo.get_dynamic_repo(),
      connection: connection!(repo),
      marker: marker,
      identity: identity,
      action: action,
      target: target,
      snapshot: snapshot,
      admitted_at: admitted_at,
      deadline: deadline
    }

    Process.put(@key, %{
      context: context,
      evidence: evidence,
      last_time: snapshot.checked_at,
      failed: false
    })

    context
  end

  @doc "Freshly checks the exact live transaction after any later domain lock wait."
  def checkpoint!(context, repo, action, target) do
    case Process.get(@key) do
      %{context: bound, evidence: evidence, last_time: previous, failed: false} = state
      when context === bound and bound.owner == self() and bound.repo == repo and
             bound.action == action and bound.target === target ->
        if repo.get_dynamic_repo() != bound.dynamic_repo or not repo.in_transaction?() or
             System.monotonic_time(:millisecond) >= bound.deadline or
             connection!(repo) !== bound.connection do
          fail!()
        end

        snapshot = fresh_snapshot!(bound, evidence, action, target, previous, 2)
        Process.put(@key, %{state | last_time: snapshot.checked_at})
        snapshot

      _ ->
        fail!()
    end
  rescue
    error in Invalid -> reraise error, __STACKTRACE__
    _ -> fail!()
  catch
    # Preserve Ecto's rollback throw; mark failures before issuing it below.
    kind, reason -> :erlang.raise(kind, reason, __STACKTRACE__)
  end

  @doc """
  Checks immediately before synchronous local SQL; never call remote services.

  An escaped exception/throw/exit or an explicit `{:error, reason}` return
  latches failure and rolls back, even if the outer callback catches it.
  Other local SQL/snapshot return values are passed through unchanged.
  """
  def effect!(context, repo, action, target, callback) when is_function(callback, 1) do
    snapshot = checkpoint!(context, repo, action, target)

    result =
      try do
        callback.(snapshot)
      rescue
        _ -> fail!()
      catch
        _, _ -> fail!()
      end

    case result do
      {:error, reason} when reason in @effect_errors -> fail!(reason)
      {:error, _} -> fail!()
      value -> value
    end
  end

  def effect!(_, _, _, _, _), do: fail!()

  defp fresh_snapshot!(bound, evidence, action, target, previous, remaining) do
    now = System.system_time(:second)

    if now < bound.admitted_at or now < previous or
         System.monotonic_time(:millisecond) >= bound.deadline,
       do: fail!()

    case Policy.evaluate(bound.identity, action, target, evidence, now) do
      {:ok, decision} ->
        # An expired grant may disappear while another locked grant still permits
        # the action. The initial snapshot in the Context remains immutable.
        memberships =
          evidence.memberships
          |> Enum.filter(&(&1.id in decision.membership_ids))
          |> Enum.sort_by(& &1.id)

        snapshot = %{bound.snapshot | checked_at: now, memberships: memberships}
        if not Snapshot.valid?(snapshot, bound.identity, decision), do: fail!()

        # Validation may be descheduled. Do not return a check whose deadline or
        # temporal evidence expired during evaluation. A second boundary change
        # fails closed rather than introducing an unbounded retry loop.
        final_time = System.system_time(:second)

        if final_time < now or System.monotonic_time(:millisecond) >= bound.deadline,
          do: fail!()

        cond do
          final_time == now -> snapshot
          remaining > 1 -> fresh_snapshot!(bound, evidence, action, target, now, remaining - 1)
          true -> fail!()
        end

      {:error, reason} ->
        fail!(reason)
    end
  end

  defp connection!(repo) do
    fields =
      Enum.map_join(@settings, ",", &"pg_catalog.current_setting('mixer.authz.#{&1}', true)")

    case Session.query!(
           repo,
           "SELECT pg_catalog.pg_backend_pid(), pg_catalog.pg_current_xact_id()::text, current_user::text, session_user::text, " <>
             fields
         ).rows do
      [row] -> row
      _ -> fail!()
    end
  end

  defp fail!(reason \\ :authorization_unavailable) do
    case Process.get(@key) do
      %{context: bound} = state ->
        Process.put(@key, %{state | failed: true})

        if bound.owner == self() and bound.repo.get_dynamic_repo() == bound.dynamic_repo and
             bound.repo.in_transaction?(),
           do: bound.repo.rollback(reason)

        raise Invalid

      _ ->
        raise Invalid
    end
  end
end

