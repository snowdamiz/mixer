defmodule MixerBrowserMigrationFixture.Repo do
  use Ecto.Repo, otp_app: :mixer_browser_migration_fixture, adapter: Ecto.Adapters.Postgres
end

defmodule MixerBrowserMigrationFixture.Test do
  use ExUnit.Case, async: false
  alias MixerBrowserMigrationFixture.Repo
  alias MixerHosted.BrowserAuth.{ActivationPreparationSchema, StorageSchema}

  @versions [
    20_261_024_000_000,
    20_261_025_000_000,
    20_261_025_000_001,
    20_261_025_000_002,
    20_261_025_000_003,
    20_261_025_000_004,
    20_261_025_000_005,
    20_261_025_000_006,
    20_261_025_000_007,
    20_261_025_000_008
  ]

  setup_all do
    start_supervised!(
      {Repo,
       hostname: "127.0.0.1",
       port: String.to_integer(System.fetch_env!("MIXER_BROWSER_MIGRATION_PORT")),
       database: "browser_migrations",
       username: "migration_owner",
       ssl: false,
       pool_size: 2,
       log: false}
    )

    :ok
  end

  test "ten ordinary migrations remain inert and reversible under an unprivileged schema owner" do
    path = Path.expand("../../../priv/repo/migrations", __DIR__)
    roles_before = Repo.query!("SELECT oid,rolname FROM pg_roles ORDER BY oid").rows
    assert @versions == Ecto.Migrator.run(Repo, path, :up, all: true, log: false)
    assert [] == Ecto.Migrator.run(Repo, path, :up, all: true, log: false)
    assert_inert()

    # Existing build data predates the latest seven migrations and must survive
    # their rollback/reapply. This exercises real foreign-key/policy teardown.
    Repo.query!("""
    INSERT INTO mixer_builds
      (id,organization_id,project_id,application_id,build_id,platform,request_key,
       revision,journal,inserted_at,updated_at)
    VALUES ('00000000-0000-4000-8000-000000000001','org','project','app','build',
            'ios','request',0,'{}',now(),now())
    """)

    before = Repo.query!("SELECT * FROM mixer_builds ORDER BY id").rows
    baseline = baseline_surface()
    unload()
    assert [List.last(@versions)] == Ecto.Migrator.run(Repo, path, :down, step: 1, log: false)

    assert %{rows: [[nil, nil]]} =
             Repo.query!("""
             SELECT (SELECT oid::text FROM pg_proc WHERE proname='mixer_browser_prepare_activation'),
                    to_regtype('public.mixer_browser_access_evidence')::text
             """)

    assert baseline_surface() == baseline
    unload()
    assert [List.last(@versions)] == Ecto.Migrator.run(Repo, path, :up, all: true, log: false)
    assert baseline_surface() == baseline
    assert before == Repo.query!("SELECT * FROM mixer_builds ORDER BY id").rows
    assert_inert()
    unload()
    latest = Enum.drop(@versions, 3)
    assert Enum.reverse(latest) == Ecto.Migrator.run(Repo, path, :down, step: 7, log: false)

    assert %{rows: [[nil, nil, nil]]} =
             Repo.query!("""
             SELECT to_regclass('public.mixer_browser_sessions')::text,
                    to_regclass('public.mixer_authz_profiles')::text,
                    to_regclass('public.mixer_build_fleet_capacity')::text
             """)

    assert before == Repo.query!("SELECT * FROM mixer_builds ORDER BY id").rows
    unload()
    assert latest == Ecto.Migrator.run(Repo, path, :up, all: true, log: false)
    assert before == Repo.query!("SELECT * FROM mixer_builds ORDER BY id").rows
    assert_inert()
    unload()
    assert Enum.reverse(@versions) == Ecto.Migrator.run(Repo, path, :down, all: true, log: false)
    unload()
    assert @versions == Ecto.Migrator.run(Repo, path, :up, all: true, log: false)
    assert [] == Ecto.Migrator.run(Repo, path, :up, all: true, log: false)
    assert_inert()
    assert roles_before == Repo.query!("SELECT oid,rolname FROM pg_roles ORDER BY oid").rows
  end

  defp assert_inert do
    tables = ~w(sessions session_vault oidc_attempts session_events)

    for suffix <- tables do
      table = "mixer_browser_" <> suffix

      assert %{rows: [[true, true, false, false, false, false]]} =
               Repo.query!(
                 """
                 SELECT c.relrowsecurity,c.relforcerowsecurity,
                        has_table_privilege('migration_runtime',c.oid,'SELECT'),
                        has_table_privilege('migration_runtime',c.oid,'INSERT'),
                        has_table_privilege('migration_runtime',c.oid,'UPDATE'),
                        has_table_privilege('migration_runtime',c.oid,'DELETE')
                 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
                 WHERE n.nspname='public' AND c.relname=$1
                 """,
                 [table]
               )

      assert %{rows: [[0]]} =
               Repo.query!(
                 """
                 SELECT count(*) FROM pg_policies
                 WHERE schemaname='public' AND tablename=$1
                 """,
                 [table]
               )
    end

    for {name, signature} <-
          Map.merge(StorageSchema.signatures(), ActivationPreparationSchema.signatures()) do
      qualified = "public.#{name}(#{signature})"

      assert %{rows: [[false]]} =
               Repo.query!("SELECT has_function_privilege('migration_runtime',$1,'EXECUTE')", [
                 qualified
               ])
    end

    assert %{rows: [[false, false]]} =
             Repo.query!("""
             SELECT has_type_privilege('migration_runtime','public.mixer_browser_access_evidence','USAGE'),
                    EXISTS(SELECT 1 FROM pg_type t CROSS JOIN LATERAL aclexplode(t.typacl) a
                      WHERE t.oid='public.mixer_browser_access_evidence'::regtype AND a.grantee=0)
             """)

    # Discovery remains empty before separate operator provisioning and any
    # browser lifecycle owner are installed.
    assert %{rows: [[nil]]} =
             Repo.query!("SELECT public.mixer_browser_load($1,$2)", [<<0::256>>, <<1::256>>])
  end

  defp baseline_surface do
    # Rows include object OIDs, exact source/ACLs, relation owners/RLS, policies,
    # constraints and persisted data; only the new helper/type are excluded.
    queries = [
      "SELECT oid,proname,proowner,prosrc,proacl::text FROM pg_proc WHERE left(proname::text,14)='mixer_browser_' AND proname<>'mixer_browser_prepare_activation' ORDER BY oid",
      "SELECT oid,typname,typowner,typacl::text FROM pg_type WHERE typname IN ('mixer_browser_cipher','mixer_browser_attempt','mixer_browser_verified') ORDER BY oid",
      "SELECT oid,relname,relowner,relacl::text,relrowsecurity,relforcerowsecurity FROM pg_class WHERE left(relname::text,14)='mixer_browser_' AND relname<>'mixer_browser_access_evidence' ORDER BY oid",
      "SELECT to_jsonb(p) FROM pg_policy p WHERE polrelid IN (SELECT oid FROM pg_class WHERE left(relname::text,14)='mixer_browser_' AND relname<>'mixer_browser_access_evidence') ORDER BY oid",
      "SELECT to_jsonb(c) FROM pg_constraint c WHERE conrelid IN (SELECT oid FROM pg_class WHERE left(relname::text,14)='mixer_browser_' AND relname<>'mixer_browser_access_evidence') ORDER BY oid",
      "SELECT to_jsonb(b) FROM public.mixer_builds b ORDER BY id"
    ]

    queries =
      queries ++
        Enum.map(~w(sessions session_vault oidc_attempts session_events), fn suffix ->
          "SELECT to_jsonb(r) FROM public.mixer_browser_" <>
            suffix <> " r ORDER BY to_jsonb(r)::text"
        end)

    Enum.map(queries, &Repo.query!(&1).rows)
  end

  defp unload do
    for module <- [
          MixerHosted.Repo.Migrations.AddOban,
          MixerHosted.Repo.Migrations.AddBuildJournals,
          MixerHosted.Repo.Migrations.AddBuildAdmission,
          MixerHosted.Repo.Migrations.AddBuildAggregateLimits,
          MixerHosted.Repo.Migrations.AddCustomerAuthorization,
          MixerHosted.Repo.Migrations.AddAuthorizationStateRevisions,
          MixerHosted.Repo.Migrations.AddCustomerArtifactStorage,
          MixerHosted.Repo.Migrations.AddCustomerWorkspaceDiscovery,
          MixerHosted.Repo.Migrations.AddBrowserSessions,
          MixerHosted.Repo.Migrations.AddBrowserActivationPreparation
        ] do
      :code.purge(module)
      :code.delete(module)
    end
  end
end

149fddd9b5039eeabf46c9ecf18aec296900fb9f blob 17357
defmodule MixerHosted.BrowserAuth.ProtocolTest do
  use ExUnit.Case, async: true
  alias MixerHosted.BrowserAuth.{Config, ConfigTest, Protocol}

  @token Base.url_encode64(:binary.copy(<<1>>, 32), padding: false)
  @other Base.url_encode64(:binary.copy(<<2>>, 32), padding: false)
  @cookie "__Host-mixer-session"
  @issuer "https://identity.example.invalid/tenant"

  defp query(extra \\ [{"code", "synthetic-code"}]) do
    URI.encode_query([{"state", @token}, {"iss", @issuer}] ++ extra)
  end

  defp headers do
    [
      {"cookie", @cookie <> "=" <> @token},
      {"origin", "https://console.example.invalid"},
      {"x-mixer-csrf", @token}
    ]
  end

  test "platform CSPRNG yields fresh independent canonical 256-bit values" do
    values = for _ <- 1..256, do: Protocol.random_token()
    assert length(Enum.uniq(values)) == 256
    assert Enum.all?(values, &Protocol.token?/1)
    assert Enum.all?(values, &(byte_size(&1) == 43))

    assert Enum.all?(values, fn value ->
             {:ok, raw} = Base.url_decode64(value, padding: false)
             byte_size(raw) == 32
           end)
  end

  test "PKCE S256 implements the published RFC 7636 appendix B vector" do
    verifier = "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"

    assert {:ok, "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"} =
             Protocol.pkce_challenge(verifier)

    assert Protocol.digest(verifier) == "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"
  end

  test "token and digest reject padding alphabets length types and noncanonical unused bits" do
    alias_value = binary_part(@token, 0, 42) <> "F"
    assert {:ok, decoded} = Base.url_decode64(@token, padding: false)
    assert {:ok, ^decoded} = Base.url_decode64(alias_value, padding: false)

    for invalid <- [
          alias_value,
          @token <> "=",
          String.duplicate("A", 42),
          String.duplicate("A", 44),
          String.duplicate("/", 43),
          String.duplicate("+", 43),
          "%41" <> binary_part(@token, 1, 42),
          nil,
          7,
          <<255>>
        ] do
      refute Protocol.token?(invalid)
      assert {:error, :invalid_token} = Protocol.digest(invalid)
      assert {:error, :invalid_token} = Protocol.pkce_challenge(invalid)
    end
  end

  test "lookup digest is SHA256 of canonical ASCII and itself canonical" do
    expected = :crypto.hash(:sha256, @token) |> Base.url_encode64(padding: false)
    assert expected == Protocol.digest(@token)
    assert Protocol.token?(expected)
    refute expected == @token
    refute Protocol.digest(@token) == Protocol.digest(@other)
  end

  test "authorization URL includes only fixed configured code query scope and S256 request" do
    values = %{state: @token, nonce: @other, verifier: @token}
    assert {:ok, url} = Protocol.authorization_url(ConfigTest.config(), values)
    uri = URI.parse(url)
    assert uri.scheme == "https"
    assert uri.host == "identity.example.invalid"
    assert uri.path == "/authorize"

    assert URI.decode_query(uri.query) == %{
             "response_type" => "code",
             "response_mode" => "query",
             "client_id" => "mixer-console",
             "redirect_uri" => "https://console.example.invalid/auth/callback",
             "scope" => "openid mixer.workspace.read",
             "state" => @token,
             "nonce" => @other,
             "code_challenge" => Protocol.digest(@token),
             "code_challenge_method" => "S256"
           }

    refute url =~ "client_secret"
    refute url =~ "secret://"
    refute url =~ "vault://"
    refute url =~ "code_verifier"
    refute url =~ "api_audience"
  end

  test "authorization rejects disabled mode malformed tokens and arbitrary provider choices" do
    valid = %{state: @token, nonce: @other, verifier: @token}
    assert {:error, :invalid_request} = Protocol.authorization_url(%Config{}, valid)

    assert {:error, :invalid_request} =
             Protocol.authorization_url(%Config{mode: :configured}, valid)

    for values <- [
          Map.delete(valid, :state),
          %{valid | nonce: "invalid"},
          %{valid | verifier: "invalid"},
          %{"state" => @token, "nonce" => @other, "verifier" => @token}
        ] do
      assert {:error, :invalid_request} = Protocol.authorization_url(ConfigTest.config(), values)
    end

    for choice <- [
          :scope,
          :issuer,
          :client_id,
          :return_to,
          :redirect_uri,
          :audience,
          :prompt,
          :response_type
        ] do
      assert {:error, :invalid_request} =
               Protocol.authorization_url(ConfigTest.config(), Map.put(valid, choice, "attacker"))
    end
  end

  test "session cookie has exact host custody attributes and bounded expiry" do
    for age <- [1, 300, 900] do
      assert {:ok,
              @cookie <>
                "=" <>
                @token <>
                "; Path=/; Secure; HttpOnly; SameSite=Lax; Max-Age=" <> Integer.to_string(age)} ==
               Protocol.session_cookie(@token, age)
    end

    assert Protocol.clear_cookie() ==
             @cookie <> "=; Path=/; Secure; HttpOnly; SameSite=Lax; Max-Age=0"

    refute Protocol.clear_cookie() =~ "Domain"
  end

  test "cookie builder rejects unsafe values and overlong or noninteger lifetimes" do
    for age <- [0, -1, 901, 300.0, "300", nil] do
      assert {:error, :invalid_request} = Protocol.session_cookie(@token, age)
    end

    for token <- [@token <> "=", "x; Domain=evil.invalid", @token <> "\r\n", nil] do
      assert {:error, :invalid_token} = Protocol.session_cookie(token, 300)
    end
  end

  test "raw cookie parser accepts exactly one canonical credential with unrelated cookies" do
    assert {:ok, @token} = Protocol.parse_session_cookie(headers())

    assert {:ok, @token} =
             Protocol.parse_session_cookie([
               {"Cookie", "theme=dark; " <> @cookie <> "=" <> @token <> "; optional="}
             ])

    assert {:ok, nil} = Protocol.parse_session_cookie([])
    assert {:ok, nil} = Protocol.parse_session_cookie([{"cookie", "theme=dark"}])
  end

  test "duplicate split case-varied cookies and all Authorization headers reject" do
    for raw <- [
          [{"cookie", @cookie <> "=" <> @token <> "; " <> @cookie <> "=" <> @token}],
          [{"cookie", @cookie <> "=" <> @token}, {"Cookie", "theme=dark"}],
          [{"cookie", "theme=dark; theme=light"}]
        ] do
      assert {:error, :invalid_request} = Protocol.parse_session_cookie(raw)
    end

    for name <- ["authorization", "Authorization", "AUTHORIZATION"],
        value <- ["", "Bearer synthetic"] do
      assert {:error, :invalid_request} =
               Protocol.parse_session_cookie([{name, value} | headers()])
    end
  end

  test "cookie parser rejects encoded aliases whitespace tricks quoted values and invalid opaque tokens" do
    for cookie <- [
          @cookie <> " =" <> @token,
          @cookie <> "= " <> @token,
          @cookie <> "=\"" <> @token <> "\"",
          "__Host%2Dmixer-session=" <> @token,
          @cookie <> "=" <> @token <> "=",
          @cookie <> "=%41" <> binary_part(@token, 1, 42),
          @cookie <> "=",
          "",
          ";",
          "theme=dark;",
          "theme=dark, " <> @cookie <> "=" <> @token,
          @cookie <> "=" <> @token <> "\t"
        ] do
      assert {:error, :invalid_request} = Protocol.parse_session_cookie([{"cookie", cookie}])
    end
  end

  test "cookie and header count byte structure bounds stop malformed requests" do
    for raw <- [
          nil,
          %{"cookie" => @token},
          [{"Cookie", String.duplicate("a", 8193)}],
          [{String.duplicate("a", 129), "x"}],
          [{"Origin ", "x"}],
          [{"x", "a\r\nb"}],
          [{"x", <<255>>}],
          [{"x", nil}],
          ["bad"],
          Enum.map(1..65, &{"x-#{&1}", ""}),
          Enum.map(1..3, &{"x-#{&1}", String.duplicate("x", 8192)})
        ] do
      assert {:error, :invalid_request} = Protocol.parse_session_cookie(raw)
    end

    thirty_two = Enum.map_join(1..32, ";", &"c#{&1}=v")
    assert {:ok, nil} = Protocol.parse_session_cookie([{"cookie", thirty_two}])

    assert {:error, :invalid_request} =
             Protocol.parse_session_cookie([{"cookie", thirty_two <> ";extra=v"}])
  end

  test "same-origin synchronizer CSRF comparison admits only the canonical session token" do
    assert :ok = Protocol.verify_csrf(ConfigTest.config(), headers(), @token)
    upper = Enum.map(headers(), fn {key, value} -> {String.upcase(key), value} end)
    assert :ok = Protocol.verify_csrf(ConfigTest.config(), upper, @token)
    assert {:error, :invalid_csrf} = Protocol.verify_csrf(ConfigTest.config(), headers(), @other)
    assert {:error, :invalid_csrf} = Protocol.verify_csrf(%Config{}, headers(), @token)

    assert {:error, :invalid_csrf} =
             Protocol.verify_csrf(%Config{mode: :configured}, headers(), @token)
  end

  test "missing null foreign sibling alternate-port and aliased Origins fail CSRF" do
    for bad <- [
          "null",
          "",
          "https://sibling.example.invalid",
          "http://console.example.invalid",
          "https://console.example.invalid:443",
          "https://console.example.invalid/",
          "https://CONSOLE.example.invalid",
          "https://console.example.invalid https://evil.invalid"
        ] do
      changed = List.keyreplace(headers(), "origin", 0, {"origin", bad})
      assert {:error, :invalid_csrf} = Protocol.verify_csrf(ConfigTest.config(), changed, @token)
    end

    for name <- ["origin", "x-mixer-csrf", "cookie"] do
      assert {:error, :invalid_csrf} =
               Protocol.verify_csrf(
                 ConfigTest.config(),
                 List.keydelete(headers(), name, 0),
                 @token
               )
    end
  end

  test "duplicate origin CSRF and cookies are rejected even when their values agree" do
    for name <- ["origin", "x-mixer-csrf", "cookie"] do
      {^name, value} = List.keyfind(headers(), name, 0)

      assert {:error, :invalid_csrf} =
               Protocol.verify_csrf(
                 ConfigTest.config(),
                 [{String.upcase(name), value} | headers()],
                 @token
               )
    end

    assert {:error, :invalid_csrf} =
             Protocol.verify_csrf(
               ConfigTest.config(),
               [{"Authorization", ""} | headers()],
               @token
             )
  end

  test "CSRF rejects malformed expected and supplied tokens without coercion" do
    for bad <- [@token <> "=", nil, 43, String.duplicate("A", 42), String.duplicate("/", 43)] do
      assert {:error, :invalid_csrf} = Protocol.verify_csrf(ConfigTest.config(), headers(), bad)
      changed = List.keyreplace(headers(), "x-mixer-csrf", 0, {"x-mixer-csrf", bad})
      assert {:error, :invalid_csrf} = Protocol.verify_csrf(ConfigTest.config(), changed, @token)
    end
  end

  test "valid callback preserves state issuer and opaque code as unclaimed input" do
    assert {:ok, %{state: @token, issuer: @issuer, outcome: {:code, "synthetic-code"}}} =
             Protocol.parse_callback(ConfigTest.config(), query())

    encoded = query([{"code", "plus+slash/equals=percent%2F"}])

    assert {:ok, %{outcome: {:code, "plus+slash/equals=percent%2F"}}} =
             Protocol.parse_callback(ConfigTest.config(), encoded)
  end

  test "provider rejection retains claimable state and issuer but discards all provider text" do
    raw =
      query([
        {"error", "access_denied"},
        {"error_description", "private-provider-detail"},
        {"error_uri", "https://provider.invalid/sensitive"}
      ])

    assert {:ok, result} = Protocol.parse_callback(ConfigTest.config(), raw)
    assert result == %{state: @token, issuer: @issuer, outcome: {:error, :provider_rejected}}
    refute inspect(result) =~ "private-provider-detail"
    refute inspect(result) =~ "provider.invalid"

    assert {:ok, %{outcome: {:error, :provider_rejected}}} =
             Protocol.parse_callback(
               ConfigTest.config(),
               query([{"error", "unrecognized_provider_error"}])
             )
  end

  test "issuer mix-up fails before success or provider rejection can be trusted" do
    for outcome <- [[{"code", "code"}], [{"error", "access_denied"}]],
        issuer <- [
          "https://evil.invalid",
          @issuer <> "/",
          "https://IDENTITY.example.invalid/tenant",
          "https://identity.example.invalid:443/tenant",
          "https://identity.example.invalid/other"
        ] do
      raw = URI.encode_query([{"state", @token}, {"iss", issuer}] ++ outcome)
      assert {:error, :invalid_callback} = Protocol.parse_callback(ConfigTest.config(), raw)
    end
  end

  test "missing duplicate unknown and escaped-equivalent query keys reject" do
    for raw <- [
          "code=x",
          "state=" <> @token <> "&code=x",
          "iss=" <> URI.encode_www_form(@issuer) <> "&code=x",
          query() <> "&state=" <> @token,
          query() <> "&iss=" <> URI.encode_www_form(@issuer),
          query() <> "&code=second",
          query() <> "&%73tate=" <> @token,
          query() <> "&sta%74e=" <> @token,
          String.replace(query(), "state=", "%73tate="),
          query() <> "&return_to=/workspace",
          query() <> "&issuer=" <> @issuer,
          query() <> "&",
          "&" <> query()
        ] do
      assert {:error, :invalid_callback} = Protocol.parse_callback(ConfigTest.config(), raw)
    end
  end

  test "code and error or error-only metadata combinations reject" do
    for extra <- [
          [{"code", "c"}, {"error", "access_denied"}],
          [{"code", "c"}, {"error_description", "detail"}],
          [{"code", "c"}, {"error_uri", "https://provider.invalid"}],
          [{"error_description", "detail"}],
          [{"error_uri", "https://provider.invalid"}],
          [{"error", "denied"}, {"error", "denied"}],
          [{"code", ""}],
          [{"error", ""}],
          []
        ] do
      assert {:error, :invalid_callback} =
               Protocol.parse_callback(ConfigTest.config(), query(extra))
    end
  end

  test "state is canonical raw Base64URL and rejects alternate percent representations" do
    for state <- [
          @token <> "=",
          "",
          binary_part(@token, 0, 42) <> "F",
          "%41" <> binary_part(@token, 1, 42),
          "+" <> binary_part(@token, 1, 42),
          String.duplicate("A", 44)
        ] do
      raw = "state=" <> state <> "&iss=" <> URI.encode_www_form(@issuer) <> "&code=x"
      assert {:error, :invalid_callback} = Protocol.parse_callback(ConfigTest.config(), raw)
    end
  end

  test "malformed single-decode escapes controls fragments and separator aliases reject" do
    for code <- [
          "%",
          "%1",
          "%GG",
          "%00",
          "%0D%0A",
          "%7F",
          "%FF",
          <<255>>,
          "x#fragment",
          "x;error=denied",
          "x\"onload",
          "x<svg>"
        ] do
      raw = "state=" <> @token <> "&iss=" <> URI.encode_www_form(@issuer) <> "&code=" <> code
      assert {:error, :invalid_callback} = Protocol.parse_callback(ConfigTest.config(), raw)
    end

    assert {:ok, %{outcome: {:code, "%00"}}} =
             Protocol.parse_callback(ConfigTest.config(), query([{"code", "%00"}]))
  end

  test "callback bounds distinguish accepted exact limits from excess before decode" do
    assert {:ok, %{outcome: {:code, code}}} =
             Protocol.parse_callback(
               ConfigTest.config(),
               query([{"code", String.duplicate("c", 4096)}])
             )

    assert byte_size(code) == 4096

    for extra <- [
          [{"code", String.duplicate("c", 4097)}],
          [{"error", String.duplicate("e", 129)}],
          [{"error", "denied"}, {"error_description", String.duplicate("d", 1025)}],
          [{"error", "denied"}, {"error_uri", String.duplicate("u", 2049)}]
        ] do
      assert {:error, :invalid_callback} =
               Protocol.parse_callback(ConfigTest.config(), query(extra))
    end

    encoded_limit =
      "state=" <>
        @token <>
        "&iss=" <> URI.encode_www_form(@issuer) <> "&code=" <> String.duplicate("%41", 4096)

    assert byte_size(encoded_limit) > 8192

    assert {:error, :invalid_callback} =
             Protocol.parse_callback(ConfigTest.config(), encoded_limit)

    for raw <- [String.duplicate("a", 8193), String.duplicate("&", 8192), nil, 8192, ""] do
      assert {:error, :invalid_callback} = Protocol.parse_callback(ConfigTest.config(), raw)
    end
  end

  test "callback admits no body disabled capability or caller-selected destination" do
    for body <- [" ", "{}", "state=x", <<0>>, [], nil] do
      assert {:error, :invalid_callback} =
               Protocol.parse_callback(ConfigTest.config(), query(), body)
    end

    assert {:error, :invalid_callback} = Protocol.parse_callback(%Config{}, query())

    assert {:error, :invalid_callback} =
             Protocol.parse_callback(%Config{mode: :configured}, query())

    assert {:error, :invalid_callback} =
             Protocol.parse_callback(
               ConfigTest.config(),
               query() <> "&return_to=https://evil.invalid"
             )
  end
end

de8132d69c039ee93fe71eaea591d11610b4383a blob 9714
#!/usr/bin/env python3
"""Selected ten-migration integration; no application or frozen-lane loading."""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import shutil
import signal
import socket
import subprocess
import tempfile
import uuid

ROOT = Path(__file__).resolve().parents[4]
BROWSER = "hosted/lib/mixer_hosted/browser_auth/"
MODULES = ["hosted/lib/mixer_hosted/customer_artifacts/schema.ex",
           BROWSER + "storage_schema.ex", BROWSER + "activation_preparation_schema.ex"]
MIGRATIONS = ["20261024000000_add_oban.exs", "20261025000000_add_build_journals.exs",
              "20261025000001_add_build_admission.exs", "20261025000002_add_build_aggregate_limits.exs",
              "20261025000003_add_customer_authorization.exs", "20261025000004_add_authorization_state_revisions.exs",
              "20261025000005_add_customer_artifact_storage.exs", "20261025000006_add_customer_workspace_discovery.exs",
              "20261025000007_add_browser_sessions.exs", "20261025000008_add_browser_activation_preparation.exs"]
DEPS = ["telemetry", "decimal", "db_connection", "ecto", "ecto_sql", "postgrex", "jason", "oban"]
SPEC = "hosted/test/mixer_hosted/browser_auth/migration_spec.exs"
ASSERTIONS = ["hosted/test/foundation_integration_test.exs"] + [
    f"hosted/test/mixer_hosted/builds/{n}_test.exs" for n in ("storage", "admission", "aggregate_admission", "coordinator")]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--pg-bin", type=Path, default=Path("/opt/homebrew/opt/postgresql@17/bin"))
parser.add_argument("--output", type=Path, default=ROOT / "verification/hosted-browser-migration-integration/attempts")
args = parser.parse_args()
stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ") + "-" + uuid.uuid4().hex[:8]
out = args.output.resolve() / stamp
inputs = out / "inputs"
inputs.mkdir(parents=True, exist_ok=False)
pg = args.pg_bin.resolve()
sources = MODULES + [BROWSER + "activation_preparation.ex", SPEC, str(Path(__file__).resolve().relative_to(ROOT)),
                     "hosted/mix.lock", "hosted/mix.exs"] + ASSERTIONS
sources += ["hosted/priv/repo/migrations/" + n for n in MIGRATIONS]
deps = [ROOT / "hosted/_build/test/lib" / name / "ebin" for name in DEPS]


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def source_manifest():
    return {rel: digest(ROOT / rel) for rel in sources}


receipt = {"schema": 2, "commands": [], "cleanup": {}, "dependencies": DEPS,
           "migration_filenames": MIGRATIONS,
           "scope": "Selected ten ordinary migrations under synthetic non-superuser schema owner; inert runtime privileges, additive-only down/up preserving baseline object OIDs/source/ACLs/tables/policies/constraints/data, seven-migration rollback/reapply preserving build data, complete rollback/reapply. Eight named locked dependency ebin directories only. No broad hosted harness/application/provider/native/frozen lane execution.",
           "pending": ["Independent migration review", "Neon/operator qualification", "Runtime lifecycle admission",
                       "Provider/OIDC/session join", "Browser/native tests paused", "Customer and GA acceptance"]}
env = dict(os.environ, ERL_FLAGS="+S 2:2", MIX_ENV="test")
scratch = None
compiled = out / "compiled"
success = False
before = {}
beams = {}


def run(name, argv, timeout=60, check=True, cwd=inputs):
    argv = [str(x) for x in argv]
    entry = {"name": name, "argv": argv, "cwd": str(cwd), "timeout_seconds": timeout}
    receipt["commands"].append(entry)
    try:
        process = subprocess.Popen(argv, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
        try:
            stdout, stderr = process.communicate(timeout=timeout)
            entry["timed_out"] = False
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            stdout, stderr = process.communicate(timeout=5)
            entry["timed_out"] = True
        entry["exit_code"] = process.returncode
    except OSError as error:
        stdout, stderr = b"", str(error).encode()
        entry.update(exit_code=None, timed_out=False, spawn_error=type(error).__name__)
    (out / f"{name}.stdout").write_bytes(stdout)
    (out / f"{name}.stderr").write_bytes(stderr)
    entry.update(stdout_sha256=hashlib.sha256(stdout).hexdigest(), stderr_sha256=hashlib.sha256(stderr).hexdigest())
    if check and (entry["exit_code"] != 0 or entry["timed_out"]):
        raise RuntimeError(f"{name} failed: {entry['exit_code']}; see retained output")
    return entry["exit_code"], stdout


try:
    assert all(directory.is_dir() for directory in deps), "Compile the eight named locked dependencies first"
    assert set(MIGRATIONS) == {p.name for p in (ROOT / "hosted/priv/repo/migrations").iterdir() if p.is_file()}, "Unexpected migration directory entry"
    before = source_manifest()
    for rel in sources:
        dest = inputs / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(ROOT / rel, dest)
    beams = {str(p.relative_to(ROOT)): digest(p) for d in deps for p in sorted(d.iterdir()) if p.is_file()}
    (out / "dependencies.json").write_text(json.dumps(beams, indent=2) + "\n")
    receipt.update(sources=before,
                   source_tree_sha256=hashlib.sha256(json.dumps(before, sort_keys=True, separators=(",", ":")).encode()).hexdigest(),
                   dependency_manifest_sha256=digest(out / "dependencies.json"))
    receipt["source_revision"] = run("git-head", ["git", "-C", ROOT, "rev-parse", "HEAD"])[1].decode().strip()
    run("python-version", ["python3", "--version"])
    run("elixir-version", ["elixir", "--version"])
    run("mix-version", ["mix", "--version"])
    run("postgres-version", [pg / "postgres", "--version"])
    pa = [v for p in deps for v in ["-pa", p]]
    compiled.mkdir()
    run("selected-compile", ["elixirc", *pa, "--warnings-as-errors", "-o", compiled, *[inputs / rel for rel in MODULES]])
    format_sources = MODULES + [BROWSER + "activation_preparation.ex", SPEC] + ASSERTIONS + ["hosted/priv/repo/migrations/" + n for n in MIGRATIONS]
    run("actual-mix-format", ["mix", "format", "--check-formatted", *[inputs / rel for rel in format_sources]])
    scratch = Path(tempfile.mkdtemp(prefix="mixer-browser-migrations-"))
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        port = sock.getsockname()[1]
    receipt["owned_postgres"] = {"scratch": str(scratch), "port": port, "host": "127.0.0.1", "pg_bin": str(pg)}
    env["MIXER_BROWSER_MIGRATION_PORT"] = str(port)
    run("initdb", [pg / "initdb", "-D", scratch / "data", "-U", "migration_admin", "-A", "trust", "--no-locale", "-E", "UTF8"])
    run("postgres-start", [pg / "pg_ctl", "-D", scratch / "data", "-l", out / "postgres.log", "-o", f"-h 127.0.0.1 -p {port} -k '' -c timezone=UTC", "-w", "start"])
    run("roles", [pg / "psql", "-X", "-h", "127.0.0.1", "-p", port, "-U", "migration_admin", "-d", "postgres", "-v", "ON_ERROR_STOP=1", "-c", "CREATE ROLE migration_owner LOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT NOCREATEROLE NOCREATEDB NOREPLICATION; CREATE ROLE migration_runtime LOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT NOCREATEROLE NOCREATEDB NOREPLICATION;"])
    run("database", [pg / "createdb", "-h", "127.0.0.1", "-p", port, "-U", "migration_admin", "-O", "migration_owner", "browser_migrations"])
    result = out / "result.json"
    entrypoint = out / "selected_runner.exs"
    entrypoint.write_text('ExUnit.start(autorun: false, seed: 0, trace: true)\nCode.require_file(' + json.dumps(str(inputs / SPEC)) + ')\nr=ExUnit.run()\nFile.write!(' + json.dumps(str(result)) + ',Jason.encode!(r))\nSystem.halt(if r.total==1 and r.failures==0 and r.skipped==0 and r.excluded==0 and Map.get(r,:invalid,0)==0, do: 0, else: 1)\n')
    run("migration-integration", ["elixir", *pa, "-pa", compiled, entrypoint], timeout=90)
    receipt["tests"] = json.loads(result.read_text())
    success = True
except Exception as error:
    receipt["failure"] = str(error)
finally:
    stopped = scratch is None or not (scratch / "data/postmaster.pid").exists()
    if not stopped:
        code, _ = run("postgres-stop", [pg / "pg_ctl", "-D", scratch / "data", "-m", "immediate", "-w", "stop"], timeout=20, check=False)
        stopped = code == 0 and not (scratch / "data/postmaster.pid").exists()
    if scratch is not None and stopped:
        shutil.rmtree(scratch)
    if compiled.exists():
        (out / "compiled-products.json").write_text(json.dumps({p.name: digest(p) for p in sorted(compiled.iterdir()) if p.is_file()}, indent=2) + "\n")
        shutil.rmtree(compiled)
    receipt["cleanup"] = {"owned_postgres_stopped": stopped, "owned_scratch_removed": scratch is None or not scratch.exists(), "owned_compile_products_removed": not compiled.exists()}
    receipt["source_unchanged"] = bool(before) and before == source_manifest()
    receipt["dependency_changes"] = [rel for rel, value in beams.items() if digest(ROOT / rel) != value]
    receipt["success"] = success and receipt["source_unchanged"] and not receipt["dependency_changes"] and all(receipt["cleanup"].values())
    receipt["finished_at"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
    receipt["outputs_sha256"] = {p.name: digest(p) for p in sorted(out.iterdir()) if p.is_file()}
    (out / "receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")
    print(json.dumps({"receipt": str(out / "receipt.json"), "success": receipt["success"], "failure": receipt.get("failure"), "cleanup": receipt["cleanup"]}))
raise SystemExit(0 if receipt["success"] else 1)

c93f824eadf524399a7ebe8d59b8ca0adc27af55 blob 8627
#!/usr/bin/env python3
"""One disposable PG process; explicit ordinary sources, no Mix or frozen lanes."""
import argparse
import datetime
import hashlib
import json
import os
import pathlib
import shutil
import signal
import socket
import subprocess
import tempfile
import uuid

ROOT = pathlib.Path(__file__).resolve().parents[3]
REPO = ROOT.parent
BASE = REPO / "verification/hosted-browser-session-storage"
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--pg-bin", type=pathlib.Path, default=pathlib.Path("/opt/homebrew/opt/postgresql@17/bin"))
args = parser.parse_args()
PG = args.pg_bin.resolve()
BASE.mkdir(parents=True, exist_ok=True)
stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ") + "-" + uuid.uuid4().hex[:8]
# Earlier development used overwritten latest logs. Preserve that last snapshot,
# explicitly without claiming it reconstructs the earlier overwritten attempts.
legacy = [p for p in BASE.iterdir() if p.is_file() and (p.suffix == ".log" or p.name == "receipt.json")]
if legacy:
    development = BASE / ("development-snapshot-" + stamp)
    development.mkdir()
    for path in legacy:
        shutil.move(str(path), development / path.name)
    (development / "README.txt").write_text("Last overwritten development output, preserved when immutable attempt recording began. Earlier per-run outputs were not retained and are not reconstructed here.\n")
OUT = BASE / "attempts" / stamp
OUT.mkdir(parents=True)
source_paths = [
    ROOT / "lib/mixer_hosted/browser_auth/storage_schema.ex",
    ROOT / "lib/mixer_hosted/browser_auth/vault.ex",
    ROOT / "lib/mixer_hosted/browser_auth/stored_snapshot.ex",
    ROOT / "test/mixer_hosted/browser_auth/storage_fixture.exs",
    ROOT / "test/mixer_hosted/browser_auth/storage_spec.exs",
    pathlib.Path(__file__).resolve(), REPO / "docs/hosted-browser-session-storage.md",
    ROOT / "mix.exs", ROOT / "mix.lock",
] + [ROOT / "priv/repo/migrations" / name for name in [
    "20261025000003_add_customer_authorization.exs",
    "20261025000004_add_authorization_state_revisions.exs",
    "20261025000006_add_customer_workspace_discovery.exs",
    "20261025000007_add_browser_sessions.exs",
]]
# Explicit dependency paths exclude the complete hosted application's existing
# beams. No frozen application source or beam is read, compiled or imported.
dependency_dirs = sorted(p / "ebin" for p in (ROOT / "_build/test/lib").iterdir()
                         if p.name != "mixer_hosted" and (p / "ebin").is_dir())
beam_paths = sorted(path for directory in dependency_dirs for path in directory.glob("*.beam"))
if not beam_paths:
    raise RuntimeError("Existing locked dependency beams required; this runner never builds the full app")

def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def manifest():
    return {"sources": {str(p.relative_to(REPO)): digest(p) for p in source_paths},
            "dependency_beams": {str(p.relative_to(REPO)): digest(p) for p in beam_paths}}

before = manifest()
(OUT / "source-manifest.json").write_text(json.dumps(before, indent=2) + "\n")
records = []
scratch = None
success = False
unchanged = False
stopped = True
revision = None

def run(name, command, env=None, check=True, timeout=30):
    command = [str(value) for value in command]
    process = subprocess.Popen(command, cwd=REPO, env=env, text=True,
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                               start_new_session=True)
    timed_out = False
    try:
        output, _ = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        os.killpg(process.pid, signal.SIGKILL)
        output, _ = process.communicate(timeout=5)
    (OUT / (name + ".log")).write_text(output)
    records.append({"name": name, "command": command, "timeout_seconds": timeout,
                    "timed_out": timed_out, "exit_code": process.returncode,
                    "output": name + ".log"})
    if (process.returncode or timed_out) and check:
        print(output[-20000:])
        raise RuntimeError(name + " failed")
    return process.returncode, output

try:
    _, revision_output = run("git-head", ["git", "rev-parse", "HEAD"])
    revision = revision_output.strip()
    run("postgres-version", [PG / "postgres", "--version"])
    run("elixir-version", ["elixir", "--version"])
    scratch = pathlib.Path(tempfile.mkdtemp(prefix="mixer-browser-storage-"))
    sock = socket.socket()
    sock.bind(("127.0.0.1", 0))
    port = sock.getsockname()[1]
    sock.close()
    run("initdb", [PG / "initdb", "-D", scratch / "data", "-U", "browser_admin",
                   "-A", "trust", "--no-locale", "-E", "UTF8"])
    run("postgres-start", [PG / "pg_ctl", "-D", scratch / "data", "-l", OUT / "postgres.log",
                           "-o", f"-h 127.0.0.1 -p {port} -k '' -c timezone=UTC", "-w", "start"], timeout=15)
    psql = [PG / "psql", "-X", "-h", "127.0.0.1", "-p", str(port), "-U", "browser_admin",
            "-d", "postgres", "-v", "ON_ERROR_STOP=1"]
    run("fixture-roles", psql + ["-c", "CREATE ROLE browser_schema_owner NOLOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT; CREATE ROLE browser_writer NOLOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT; CREATE ROLE browser_lifecycle LOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT; CREATE ROLE browser_ordinary LOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT; CREATE ROLE browser_operator LOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT;"])
    for database, owner in [("browser_storage", "browser_schema_owner"), ("browser_operator_storage", "browser_operator")]:
        run(database + "-database", [PG / "createdb", "-h", "127.0.0.1", "-p", str(port),
                                     "-U", "browser_admin", "-O", owner, database])
    environment = os.environ.copy()
    environment["MIXER_BROWSER_STORAGE_PORT"] = str(port)
    command = ["elixir"]
    for directory in dependency_dirs:
        command += ["-pa", str(directory)]
    for source in ["storage_schema.ex", "vault.ex", "stored_snapshot.ex"]:
        command += ["-r", str(ROOT / "lib/mixer_hosted/browser_auth" / source)]
    command += ["-e", 'ExUnit.start(seed: 0); Code.require_file("hosted/test/mixer_hosted/browser_auth/storage_spec.exs")']
    run("focused-exunit", command, env=environment, timeout=60)
    success = True
finally:
    # Inspect the owned PID file even if pg_ctl timed out or failed after starting.
    # No unrelated process/container/simulator is enumerated, killed or modified.
    if scratch is not None and (scratch / "data/postmaster.pid").exists():
        code, _ = run("postgres-stop", [PG / "pg_ctl", "-D", scratch / "data", "-m", "immediate", "-w", "stop"], check=False, timeout=15)
        stopped = code == 0 and not (scratch / "data/postmaster.pid").exists()
    elif scratch is not None:
        stopped = not (scratch / "data/postmaster.pid").exists()
    if scratch is not None and stopped:
        shutil.rmtree(scratch)
    after = manifest()
    unchanged = before == after
    (OUT / "source-manifest-after.json").write_text(json.dumps(after, indent=2) + "\n")
    receipt = {
        "schema": 2, "time_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "head": revision, "source_manifest": "source-manifest.json",
        "source_manifest_sha256": digest(OUT / "source-manifest.json"),
        "source_unchanged": unchanged, "commands": records,
        "focused_tests_passed": success and unchanged,
        "cleanup": {"owned_postgres_stopped": stopped, "owned_scratch_removed": scratch is None or not scratch.exists()},
        "scope": "Synthetic loopback PostgreSQL; selected StorageSchema/Vault/StoredSnapshot and ordinary 3/4/6/7 migrations against existing dependency beams only. No whole-app compile, frozen lane, browser/native/provider/production action.",
        "pending": ["Current-verifier/OIDC/provider owner join", "Production lifecycle pool and catalog admission",
                    "Neon ownership transfer/roles/TLS/key custody", "Nine-migration controls integrated by root",
                    "Commit/response uncertainty", "Retention scheduling", "Browser/native/physical checks paused", "Customer and GA review"]}
    (OUT / "receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")
    (BASE / "latest.json").write_text(json.dumps({"mutable_pointer_only": True, "attempt": str(OUT.relative_to(BASE)), "receipt": str((OUT / "receipt.json").relative_to(BASE))}, indent=2) + "\n")
    print(str(OUT.relative_to(REPO)))
if not success or not unchanged or not stopped:
    raise SystemExit(1)

