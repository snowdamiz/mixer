defmodule MixerHosted.RuntimeConfigTest do
  use ExUnit.Case, async: true
  alias MixerHosted.RuntimeConfig

  defp env do
    %{
      "MIXER_HOSTED_ROLE" => "api",
      "MIXER_DATABASE_HOST" => "ep-fixture.us-east-2.aws.neon.tech",
      "MIXER_DATABASE_NAME" => "mixer_fixture",
      "MIXER_DATABASE_USER" => "mixer_fixture",
      "MIXER_DATABASE_PASSWORD" => "synthetic-database-secret",
      "MIXER_SECRET_KEY_BASE" => String.duplicate("synthetic-secret-", 8)
    }
  end

  test "API cannot process jobs and uses bounded verified TLS connections" do
    config = RuntimeConfig.load!(env())
    assert config.role == :api
    assert config.oban[:queues] == []
    assert config.oban[:peer] == false
    assert config.oban[:stager] == [interval: :infinity]
    assert config.oban[:notifier] == Oban.Notifiers.Postgres
    assert config.repo[:pool_size] == 8
    assert config.repo[:pool_count] == 1
    assert config.database_connection_bound == 9
    assert config.repo[:ssl][:verify] == :verify_peer
    assert config.repo[:ssl][:cacerts] != []

    assert config.repo[:ssl][:server_name_indication] ==
             ~c"ep-fixture.us-east-2.aws.neon.tech"

    assert is_function(config.repo[:ssl][:customize_hostname_check][:match_fun], 2)
    assert config.endpoint[:http][:ip] == {127, 0, 0, 1}
    refute inspect(config) =~ "synthetic"

    assert Enum.member?(
             MixerHosted.Application.children(:api, config.oban),
             MixerHostedWeb.Endpoint
           )
  end

  test "processor has separate bounded queues and no HTTP endpoint" do
    config = RuntimeConfig.load!(Map.put(env(), "MIXER_HOSTED_ROLE", "processor"))

    assert Keyword.keys(config.oban[:queues]) ==
             [:builds, :signing, :submissions, :releases, :telemetry, :billing]

    assert Enum.all?(config.oban[:queues], fn {_, limit} -> limit == 1 end)
    assert config.endpoint == [server: false]
    assert config.oban[:plugins] == []
    assert config.oban[:peer] == Oban.Peers.Database
    assert config.oban[:stager] == [interval: 1_000]

    refute Enum.member?(
             MixerHosted.Application.children(:processor, config.oban),
             MixerHostedWeb.Endpoint
           )
  end

  test "required configuration fails closed without leaking values" do
    for key <- Map.keys(env()) do
      assert_raise ArgumentError, "invalid or missing hosted setting: " <> key, fn ->
        RuntimeConfig.load!(Map.delete(env(), key))
      end
    end

    for {key, value} <- [
          {"MIXER_HOSTED_ROLE", "api,processor"},
          {"MIXER_DATABASE_HOST", "ep-fixture-pooler.us-east-2.aws.neon.tech"},
          {"MIXER_DATABASE_HOST", "user:secret@db.example"},
          {"MIXER_DATABASE_HOST", "db.example?sslmode=disable"},
          {"MIXER_DATABASE_HOST", "db.example\n"},
          {"MIXER_DATABASE_HOST", "db..example"},
          {"MIXER_DATABASE_POOL_SIZE", "21"},
          {"MIXER_DATABASE_POOL_SIZE", "0"},
          {"MIXER_DATABASE_POOL_SIZE", "8junk"},
          {"MIXER_HTTP_BIND", "db.example"},
          {"MIXER_HTTP_PORT", "65536"},
          {"MIXER_SECRET_KEY_BASE", "short-secret"}
        ] do
      assert_raise ArgumentError, "invalid or missing hosted setting: " <> key, fn ->
        RuntimeConfig.load!(Map.put(env(), key, value))
      end
    end
  end

  test "queue bounds cannot be widened or interpreted as arbitrary atoms" do
    for value <- ["0", "9", "infinity", "1.0"] do
      bad =
        env()
        |> Map.put("MIXER_HOSTED_ROLE", "processor")
        |> Map.put("MIXER_QUEUE_BUILDS_CONCURRENCY", value)

      assert_raise ArgumentError, fn -> RuntimeConfig.load!(bad) end
    end
  end
end

cbf319d0a152e554cb36c2dacf1a8bebba367d6f blob 4675
defmodule MixerHosted.Test.BuildDispatchFixture do
  @moduledoc false
  @behaviour MixerHosted.Builds.Dispatch
  use GenServer
  alias MixerHosted.Builds.Dispatch.Observation

  def start_link(_), do: GenServer.start_link(__MODULE__, nil, name: __MODULE__)
  def reset, do: GenServer.call(__MODULE__, :reset)
  def mode(callback, mode), do: GenServer.call(__MODULE__, {:mode, callback, mode})
  def snapshot, do: GenServer.call(__MODULE__, :snapshot)
  def complete(id, result), do: GenServer.call(__MODULE__, {:complete, id, result})
  @impl true
  def query(request), do: call(:query, request)
  @impl true
  def ensure_started(request), do: call(:ensure_started, request)
  @impl true
  def stop(request), do: call(:stop, request)

  defp call(callback, request) do
    # Records DB visibility in the transport process, outside the coordinator transaction.
    {:ok, current} =
      MixerHosted.Builds.Storage.read(
        Map.take(request.ref, [
          :organization_id,
          :project_id,
          :application_id,
          :build_id,
          :platform
        ])
      )

    visibility = %{
      state: current.build.state,
      revision: current.record.revision,
      transaction?: MixerHosted.Repo.in_transaction?()
    }

    {reply, mode} = GenServer.call(__MODULE__, {:call, callback, request, visibility})

    case mode do
      :raise_after ->
        raise "synthetic callback crash after durable modeled effect"

      :timeout_after ->
        receive do
          :never -> reply
        end

      {:block_after, observer} ->
        send(observer, {:dispatch_blocked, self()})

        receive do
          :resume -> reply
        end

      :wrong_operation ->
        {:ok, %{elem(reply, 1) | operation_id: String.duplicate("0", 64)}}

      :wrong_ref ->
        {:ok, %{elem(reply, 1) | ref: %{request.ref | fence: request.ref.fence + 1}}}

      :invalid_result ->
        {:ok, %{elem(reply, 1) | status: {:completed, %{outcome: :succeeded}}}}

      _ ->
        reply
    end
  end

  @impl true
  def init(_), do: {:ok, fresh()}
  @impl true
  def handle_call(:reset, _, _), do: {:reply, :ok, fresh()}
  def handle_call(:snapshot, _, state), do: {:reply, state, state}

  def handle_call({:mode, callback, mode}, _, state),
    do: {:reply, :ok, %{state | modes: Map.put(state.modes, callback, mode)}}

  def handle_call({:complete, id, result}, _, state) do
    operations = Map.update!(state.operations, id, &%{&1 | status: {:completed, result}})
    {:reply, :ok, %{state | operations: operations}}
  end

  def handle_call({:call, callback, request, visibility}, _, state) do
    {mode, modes} = Map.pop(state.modes, callback, :normal)
    call = %{callback: callback, request: request, visibility: visibility}
    state = %{state | calls: state.calls ++ [call], modes: modes}

    if mode == :unavailable do
      {:reply, {{:error, :unavailable}, :normal}, state}
    else
      {reply, state} = operate(callback, request, state)
      {:reply, {reply, mode}, state}
    end
  end

  defp operate(callback, request, state) do
    previous = Map.get(state.operations, request.operation_id)
    version = {request.guard.epoch, request.guard.revision}

    cond do
      DateTime.compare(request.guard.expires_at, DateTime.utc_now()) != :gt ->
        {{:error, :stale}, state}

      previous != nil and
          (version < previous.version or previous.ref != request.ref or
             previous.spec != request.spec or previous.deadline_ms != request.deadline_ms) ->
        {{:error, :stale}, state}

      true ->
        {status, creations} =
          case {callback, previous} do
            {:query, nil} -> {:absent, 0}
            {:ensure_started, nil} -> {:running, 1}
            {:stop, nil} -> {{:stopped, String.duplicate("d", 64)}, 0}
            {:stop, %{status: :running}} -> {{:stopped, String.duplicate("d", 64)}, 0}
            {_, existing} -> {existing.status, 0}
          end

        operations =
          if status == :absent do
            state.operations
          else
            Map.put(state.operations, request.operation_id, %{
              ref: request.ref,
              spec: request.spec,
              deadline_ms: request.deadline_ms,
              version: version,
              status: status
            })
          end

        observation = %Observation{
          operation_id: request.operation_id,
          ref: request.ref,
          status: status
        }

        {{:ok, observation},
         %{state | operations: operations, creations: state.creations + creations}}
    end
  end

  defp fresh, do: %{operations: %{}, calls: [], creations: 0, modes: %{}}
end

