defmodule MixerHosted.BrowserAuth.Vault do
  @moduledoc """
  Pure bounded AES-256-GCM custody for ordinary browser-session secrets.

  The trusted lifecycle owner supplies a reviewed runtime key and current durable
  context. This module does not authenticate a user, load a key, perform I/O, or
  establish that context came from a database transaction. No BEAM memory
  zeroization is claimed. Never log inputs, keys or decrypted values.
  """

  defmodule Key do
    @moduledoc "Externally supplied key material. Inspect intentionally reveals no fields."
    @derive {Inspect, only: []}
    @enforce_keys [:id, :bytes]
    defstruct [:id, :bytes]
  end

  defmodule Sealed do
    @moduledoc "Database-safe encryption fields; plaintext is never included."
    @derive {Inspect, only: [:version]}
    @enforce_keys [:version, :key_id, :iv, :tag, :ciphertext]
    defstruct [:version, :key_id, :iv, :tag, :ciphertext]
  end

  defmodule Preauth do
    @moduledoc "Closed pre-authentication CSRF envelope."
    @derive {Inspect, only: []}
    @enforce_keys [:csrf]
    defstruct [:csrf]
  end

  defmodule Active do
    @moduledoc "Closed CSRF and access-token envelope; no refresh or ID token."
    @derive {Inspect, only: []}
    @enforce_keys [:csrf, :access_token]
    defstruct [:csrf, :access_token]
  end

  defmodule Verifier do
    @moduledoc "Closed short-lived PKCE verifier envelope."
    @derive {Inspect, only: []}
    @enforce_keys [:verifier]
    defstruct [:verifier]
  end

  @max_integer 9_007_199_254_740_991
  @max_profile_version 2_147_483_647
  @max_ciphertext 8192
  @session_keys ~w(purpose browser_id cookie_digest csrf_digest epoch revision generation
    vault_generation config_digest profile_id profile_version principal_id family_id
    credential_ref credential_revision)a
  @attempt_keys ~w(purpose state_digest browser_id cookie_digest epoch revision generation
    config_digest profile_id profile_version issuer client_id redirect_uri expires_at)a
  @link_keys ~w(principal_id family_id credential_ref credential_revision)a
  @error {:error, :vault_unavailable}

  @doc "Wraps exactly 32 externally supplied key bytes and a bounded, nonsecret key ID."
  def key(id, bytes) when is_binary(bytes) and byte_size(bytes) == 32 do
    if key_id?(id), do: {:ok, %Key{id: id, bytes: bytes}}, else: @error
  end

  def key(_, _), do: @error

  @doc "Encrypts one typed envelope using a fresh independent 96-bit platform CSPRNG IV."
  def seal(key, context, plaintext) do
    with true <- key?(key),
         {:ok, aad} <- associated_data(key.id, context),
         {:ok, encoded} <- encode_plaintext(context, plaintext) do
      encrypt(key, aad, encoded)
    else
      _ -> @error
    end
  rescue
    _ -> @error
  catch
    _, _ -> @error
  end

  @doc "Authenticates exact context and key version before parsing the closed plaintext."
  def open(key, context, sealed) do
    with true <- key?(key) and sealed?(sealed),
         true <- sealed.key_id == key.id,
         {:ok, aad} <- associated_data(key.id, context),
         {:ok, plaintext} <- decrypt(key, sealed, aad),
         {:ok, result} <- decode_plaintext(context, plaintext) do
      {:ok, result}
    else
      _ -> @error
    end
  rescue
    _ -> @error
  catch
    _, _ -> @error
  end

  @doc "Deterministic version-1 AAD bytes; all inputs are bounded public durable metadata."
  def associated_data(key_id, context) do
    with true <- key_id?(key_id),
         {:ok, domain, fields} <- context_fields(context) do
      {:ok, IO.iodata_to_binary([domain, Enum.map([<<1>>, key_id | fields], &field/1)])}
    else
      _ -> @error
    end
  end

  defp encrypt(key, aad, plaintext) do
    iv = :crypto.strong_rand_bytes(12)

    {ciphertext, tag} =
      :crypto.crypto_one_time_aead(:aes_256_gcm, key.bytes, iv, plaintext, aad, 16, true)

    {:ok, %Sealed{version: 1, key_id: key.id, iv: iv, tag: tag, ciphertext: ciphertext}}
  rescue
    _ -> @error
  catch
    _, _ -> @error
  end

  defp decrypt(key, sealed, aad) do
    case :crypto.crypto_one_time_aead(
           :aes_256_gcm,
           key.bytes,
           sealed.iv,
           sealed.ciphertext,
           aad,
           sealed.tag,
           false
         ) do
      plaintext when is_binary(plaintext) -> {:ok, plaintext}
      _ -> @error
    end
  rescue
    _ -> @error
  catch
    _, _ -> @error
  end

  defp key?(%Key{id: id, bytes: bytes} = key),
    do: map_size(key) == 3 and key_id?(id) and is_binary(bytes) and byte_size(bytes) == 32

  defp key?(_), do: false

  defp sealed?(%Sealed{version: 1, key_id: id, iv: iv, tag: tag, ciphertext: ciphertext} = sealed) do
    map_size(sealed) == 6 and key_id?(id) and raw?(iv, 12) and raw?(tag, 16) and
      is_binary(ciphertext) and byte_size(ciphertext) in 1..@max_ciphertext
  end

  defp sealed?(_), do: false

  defp context_fields(%{purpose: purpose} = c) when purpose in [:preauth, :active] do
    with true <- exact_keys?(c, @session_keys),
         true <- raw?(c.browser_id, 16) and raw?(c.cookie_digest, 32) and raw?(c.csrf_digest, 32),
         true <- positive?(c.epoch) and positive?(c.revision) and positive?(c.vault_generation),
         true <- token?(c.generation) and raw?(c.config_digest, 32),
         true <- text?(c.profile_id, 128) and profile_version?(c.profile_version),
         {:ok, linkage} <- linkage(c, purpose) do
      {:ok, "mixer.browser.vault.v1\0",
       [
         kind(purpose),
         c.browser_id,
         c.cookie_digest,
         c.csrf_digest,
         number(c.epoch),
         number(c.revision),
         c.generation,
         number(c.vault_generation),
         c.config_digest,
         c.profile_id,
         number(c.profile_version) | linkage
       ]}
    else
      _ -> @error
    end
  end

  defp context_fields(%{purpose: :attempt} = c) do
    with true <- exact_keys?(c, @attempt_keys),
         true <- raw?(c.state_digest, 32) and raw?(c.browser_id, 16) and raw?(c.cookie_digest, 32),
         true <- positive?(c.epoch) and positive?(c.revision) and token?(c.generation),
         true <- raw?(c.config_digest, 32) and text?(c.profile_id, 128),
         true <- profile_version?(c.profile_version) and text?(c.issuer, 2048),
         true <-
           text?(c.client_id, 256) and text?(c.redirect_uri, 2048) and positive?(c.expires_at) do
      {:ok, "mixer.browser.attempt.v1\0",
       [
         kind(:attempt),
         c.state_digest,
         c.browser_id,
         c.cookie_digest,
         number(c.epoch),
         number(c.revision),
         c.generation,
         c.config_digest,
         c.profile_id,
         number(c.profile_version),
         c.issuer,
         c.client_id,
         c.redirect_uri,
         number(c.expires_at)
       ]}
    else
      _ -> @error
    end
  end

  defp context_fields(_), do: @error

  defp linkage(c, :preauth) do
    if Enum.all?(@link_keys, &(Map.fetch!(c, &1) == nil)), do: {:ok, [<<0>>]}, else: @error
  end

  defp linkage(c, :active) do
    if text?(c.principal_id, 128) and text?(c.family_id, 128) and
         text?(c.credential_ref, 256) and positive?(c.credential_revision),
       do:
         {:ok,
          [<<1>>, c.principal_id, c.family_id, c.credential_ref, number(c.credential_revision)]},
       else: @error
  end

  defp encode_plaintext(%{purpose: :preauth} = c, %Preauth{csrf: csrf} = p) do
    if map_size(p) == 2 and valid_csrf?(c, csrf),
      do: {:ok, IO.iodata_to_binary([<<1>>, field(csrf)])},
      else: @error
  end

  defp encode_plaintext(%{purpose: :active} = c, %Active{csrf: csrf, access_token: token} = p) do
    if map_size(p) == 3 and valid_csrf?(c, csrf) and bearer?(token),
      do: {:ok, IO.iodata_to_binary([<<2>>, field(csrf), field(token)])},
      else: @error
  end

  defp encode_plaintext(%{purpose: :attempt}, %Verifier{verifier: verifier} = p) do
    if map_size(p) == 2 and token?(verifier),
      do: {:ok, IO.iodata_to_binary([<<3>>, field(verifier)])},
      else: @error
  end

  defp encode_plaintext(_, _), do: @error

  defp decode_plaintext(
         %{purpose: :preauth} = c,
         <<1, 43::unsigned-big-32, csrf::binary-size(43)>>
       ) do
    if valid_csrf?(c, csrf), do: {:ok, %Preauth{csrf: csrf}}, else: @error
  end

  defp decode_plaintext(
         %{purpose: :active} = c,
         <<2, 43::unsigned-big-32, csrf::binary-size(43), size::unsigned-big-32,
           token::binary-size(size)>>
       ) do
    if valid_csrf?(c, csrf) and bearer?(token),
      do: {:ok, %Active{csrf: csrf, access_token: token}},
      else: @error
  end

  defp decode_plaintext(
         %{purpose: :attempt},
         <<3, 43::unsigned-big-32, verifier::binary-size(43)>>
       ) do
    if token?(verifier), do: {:ok, %Verifier{verifier: verifier}}, else: @error
  end

  defp decode_plaintext(_, _), do: @error

  defp valid_csrf?(context, csrf),
    do: token?(csrf) and :crypto.hash_equals(:crypto.hash(:sha256, csrf), context.csrf_digest)

  defp bearer?(value) when is_binary(value) and byte_size(value) in 1..4089 do
    case :binary.split(value, "=") do
      [token] -> bearer_body?(token)
      [token, padding] -> bearer_body?(token) and ascii?(padding, &(&1 == ?=))
    end
  end

  defp bearer?(_), do: false

  defp bearer_body?(value),
    do:
      byte_size(value) > 0 and
        ascii?(value, &(&1 in ?a..?z or &1 in ?A..?Z or &1 in ?0..?9 or &1 in ~c"._~+/-"))

  defp token?(value) when is_binary(value) and byte_size(value) == 43 do
    case Base.url_decode64(value, padding: false) do
      {:ok, bytes} when byte_size(bytes) == 32 ->
        Base.url_encode64(bytes, padding: false) == value

      _ ->
        false
    end
  end

  defp token?(_), do: false

  defp key_id?(value),
    do:
      is_binary(value) and byte_size(value) in 1..128 and
        ascii?(value, &(&1 in ?a..?z or &1 in ?A..?Z or &1 in ?0..?9 or &1 in ~c"._-"))

  defp exact_keys?(map, keys),
    do: map_size(map) == length(keys) and Enum.all?(keys, &Map.has_key?(map, &1))

  defp raw?(value, size), do: is_binary(value) and byte_size(value) == size

  defp text?(value, limit),
    do:
      is_binary(value) and byte_size(value) in 1..limit and String.valid?(value) and
        :binary.match(value, <<0>>) == :nomatch

  defp positive?(value), do: is_integer(value) and value in 1..@max_integer
  defp profile_version?(value), do: is_integer(value) and value in 1..@max_profile_version
  defp field(value), do: [<<byte_size(value)::unsigned-big-32>>, value]
  defp number(value), do: <<value::unsigned-big-64>>
  defp kind(:preauth), do: <<1>>
  defp kind(:active), do: <<2>>
  defp kind(:attempt), do: <<3>>
  defp ascii?(<<>>, _), do: true
  defp ascii?(<<byte, rest::binary>>, check), do: check.(byte) and ascii?(rest, check)
end

ca6178280b8ff0fba449ee360b6b51a84266e1c0 blob 26456
defmodule MixerHosted.Builds.Admission do
  @moduledoc """
  Internal, PostgreSQL-serialized fleet and organization build occupancy and
  coordinator ownership. These APIs provide no tenant or worker authorization.

  Claiming reserves capacity only; external dispatch requires a committed
  lifecycle start first. The reservation survives lease expiry and uncertainty.
  Lease epochs and worker lifecycle fences are independent. All mutations are
  Multi fragments. Every fragment first takes the same transaction advisory
  mutex, then fleet -> platform -> organization -> organization/platform ->
  build -> reservation -> lease locks. Do not acquire raw locks on these tables
  before the first Admission fragment in a composed transaction.
  """
  import Ecto.Query
  alias Ecto.Multi
  alias MixerHosted.Builds.{Journal, Record, Storage}

  alias __MODULE__.{
    Capacity,
    FleetCapacity,
    FleetPlatformCapacity,
    OrganizationCapacity,
    Lease,
    Reservation,
    Token
  }

  @scope [:organization_id, :project_id, :application_id, :build_id, :platform]
  @max_int 9_223_372_036_854_775_807
  @terminal [:succeeded, :failed, :cancelled, :timed_out]

  defmodule FleetCapacity do
    @moduledoc false
    use Ecto.Schema
    @primary_key {:id, :string, autogenerate: false}
    schema "mixer_build_fleet_capacity" do
      field(:limit, :integer, default: 0)
      field(:revision, :integer, default: 0)
      field(:configured, :boolean, default: false)
    end
  end

  defmodule FleetPlatformCapacity do
    @moduledoc false
    use Ecto.Schema
    @primary_key {:platform, :string, autogenerate: false}
    schema "mixer_build_fleet_platform_capacities" do
      field(:limit, :integer, default: 0)
      field(:revision, :integer, default: 0)
      field(:configured, :boolean, default: false)
    end
  end

  defmodule OrganizationCapacity do
    @moduledoc false
    use Ecto.Schema
    @primary_key {:organization_id, :string, autogenerate: false}
    schema "mixer_build_organization_capacities" do
      field(:limit, :integer, default: 0)
      field(:revision, :integer, default: 0)
      field(:configured, :boolean, default: false)
    end
  end

  defmodule Capacity do
    @moduledoc false
    use Ecto.Schema
    @primary_key false
    schema "mixer_build_capacities" do
      field(:organization_id, :string, primary_key: true)
      field(:platform, :string, primary_key: true)
      field(:limit, :integer)
      field(:revision, :integer)
    end
  end

  defmodule Reservation do
    @moduledoc false
    use Ecto.Schema
    @primary_key {:build_record_id, :binary_id, autogenerate: false}
    schema "mixer_build_reservations" do
      field(:organization_id, :string)
      field(:platform, :string)
      field(:attempt, :integer)
      field(:worker_fence, :integer)
      field(:held, :boolean)
      field(:terminal_event_id, :string)
    end
  end

  defmodule Lease do
    @moduledoc false
    use Ecto.Schema
    @primary_key {:build_record_id, :binary_id, autogenerate: false}
    schema "mixer_build_coordinator_leases" do
      field(:owner_id, :string)
      field(:epoch, :integer)
      field(:expires_at, :utc_datetime_usec)
    end
  end

  defmodule Token do
    @moduledoc "Internal coordinator reference data, never authentication or worker authority."
    @enforce_keys [:scope, :record_id, :attempt, :owner_id, :epoch]
    defstruct @enforce_keys
  end

  @doc "Explicit internal configuration; :new creates revision 0, integer revisions use CAS."
  def configure_multi(%Multi{} = multi, name, scope, revision, limit) do
    Multi.run(multi, name, fn repo, _ -> configure(repo, scope, revision, limit) end)
  end

  @doc "Explicit fleet-total configuration; new closed placeholders require :new activation."
  def configure_fleet_multi(%Multi{} = multi, name, revision, limit) do
    Multi.run(multi, name, fn repo, _ ->
      configure_aggregate(repo, :fleet, %{}, revision, limit)
    end)
  end

  @doc "Explicit fleet platform-pool configuration, independently bounded for iOS and Android."
  def configure_fleet_platform_multi(%Multi{} = multi, name, scope, revision, limit) do
    Multi.run(multi, name, fn repo, _ ->
      configure_aggregate(repo, :platform, scope, revision, limit)
    end)
  end

  @doc "Explicit organization-total configuration, shared by both platform pools."
  def configure_organization_multi(%Multi{} = multi, name, scope, revision, limit) do
    Multi.run(multi, name, fn repo, _ ->
      configure_aggregate(repo, :organization, scope, revision, limit)
    end)
  end

  @doc "Claims a queued attempt, or reclaims the same held attempt for reconciliation."
  def claim_multi(%Multi{} = multi, name, scope, owner_id, ttl_ms) do
    Multi.run(multi, name, fn repo, _ -> claim(repo, scope, owner_id, ttl_ms) end)
  end

  @doc "Renews a live, exactly fenced coordinator lease using database time after locks."
  def renew_multi(%Multi{} = multi, name, token, ttl_ms) do
    Multi.run(multi, name, fn repo, _ ->
      with true <- ttl?(ttl_ms),
           {:ok, context} <- guard(repo, token) do
        lease = %{context.lease | expires_at: DateTime.add(context.now, ttl_ms, :millisecond)}
        persist_lease(repo, lease)
        {:ok, result(%{context | lease: lease}, :renewed)}
      else
        false -> {:error, :invalid_lease_policy}
        error -> error
      end
    end)
  end

  @doc "Guards a lifecycle mutation, composing its CAS and Oban insert in the same Multi."
  def transition_multi(%Multi{} = multi, name, token, revision, event_id, event, factory)
      when is_function(factory, 1) do
    multi
    |> Multi.run({name, :admission}, fn repo, _ ->
      if is_map(event) and
           Map.get(event, :type) in [:start, :cancel, :expire, :completed, :stopped],
         do: guard(repo, token),
         else: {:error, :invalid_guarded_event}
    end)
    |> Multi.merge(fn changes ->
      context = Map.fetch!(changes, {name, :admission})

      Storage.transition_multi(
        Multi.new(),
        name,
        token.scope,
        revision,
        event_id,
        event,
        context.now_ms,
        factory
      )
    end)
  end

  @doc "Releases matching definitive termination, or a conclusively never-started queued cancellation."
  def release_multi(%Multi{} = multi, name, token, terminal_event_id) do
    Multi.run(multi, name, fn repo, _ ->
      with true <- text?(terminal_event_id, 128),
           {:ok, context} <- guard(repo, token),
           :ok <- terminal_evidence(context, terminal_event_id) do
        reservation = %{context.reservation | held: false, terminal_event_id: terminal_event_id}
        lease = %{context.lease | owner_id: nil, expires_at: nil}
        persist_reservation(repo, reservation)
        persist_lease(repo, lease)
        {:ok, result(%{context | reservation: reservation, lease: lease}, :released)}
      else
        false -> {:error, :invalid_terminal_event_id}
        error -> error
      end
    end)
  end

  @doc "Yields coordination immediately without releasing capacity or changing the worker fence."
  def yield_multi(%Multi{} = multi, name, token) do
    Multi.run(multi, name, fn repo, _ ->
      with {:ok, context} <- guard(repo, token) do
        lease = %{context.lease | expires_at: context.now}
        persist_lease(repo, lease)
        {:ok, result(%{context | lease: lease}, :yielded)}
      end
    end)
  end

  @doc "Retries only the current definitively released attempt, using locked database time."
  def retry_multi(%Multi{} = multi, name, scope, revision, event_id, factory)
      when is_function(factory, 1) do
    multi
    |> Multi.run({name, :admission}, fn repo, _ ->
      with true <- is_integer(revision) and revision in 0..32,
           {:ok, context} <- locked(repo, scope),
           :ok <- valid_reservation(context),
           true <- context.record.revision == revision,
           %Reservation{held: false} = reservation <- context.reservation,
           true <- reservation.attempt == context.build.attempt,
           true <- context.build.state in @terminal,
           true <- is_nil(context.lease.owner_id) and is_nil(context.lease.expires_at),
           true <- released_evidence?(context, reservation.terminal_event_id) do
        {:ok, context}
      else
        false -> {:error, :released_current_attempt_required}
        nil -> {:error, :released_current_attempt_required}
        %Reservation{} -> {:error, :released_current_attempt_required}
        error -> error
      end
    end)
    |> Multi.merge(fn changes ->
      context = Map.fetch!(changes, {name, :admission})

      Storage.transition_multi(
        Multi.new(),
        name,
        scope,
        revision,
        event_id,
        %{type: :retry},
        context.now_ms,
        factory
      )
    end)
  end

  defp configure(repo, scope, revision, limit) do
    with {:ok, scope} <- capacity_scope(scope),
         true <- capacity_policy?(revision, limit),
         {:ok, _} <- lock_capacities(repo, scope) do
      if revision == :new do
        attrs = Map.merge(scope, %{limit: limit, revision: 0})

        case repo.insert_all(Capacity, [attrs], on_conflict: :nothing) do
          {1, _} -> {:ok, struct!(Capacity, attrs)}
          {0, _} -> {:error, :capacity_exists}
        end
      else
        case repo.one(from(c in capacity_query(scope), lock: "FOR UPDATE")) do
          nil ->
            {:error, :capacity_unconfigured}

          %Capacity{revision: ^revision} = capacity ->
            repo.update_all(capacity_query(scope), set: [limit: limit, revision: revision + 1])
            {:ok, %{capacity | limit: limit, revision: revision + 1}}

          _ ->
            {:error, :stale_capacity_revision}
        end
      end
    else
      false -> {:error, :invalid_capacity_policy}
      error -> error
    end
  end

  defp configure_aggregate(repo, kind, scope, revision, limit) do
    with {:ok, scope} <- aggregate_scope(kind, scope),
         true <- capacity_policy?(revision, limit),
         {:ok, capacities} <- lock_capacities(repo, scope) do
      capacity = Map.fetch!(capacities, kind)
      {schema, identity} = aggregate_identity(kind, scope)
      query = aggregate_query(schema, identity)

      cond do
        revision == :new and (capacity == nil or not capacity.configured) ->
          attrs = Map.merge(identity, %{limit: limit, revision: 0, configured: true})

          if capacity == nil,
            do: repo.insert!(struct!(schema, attrs)),
            else: repo.update_all(query, set: [limit: limit, revision: 0, configured: true])

          {:ok, struct!(schema, attrs)}

        revision == :new ->
          {:error, :capacity_exists}

        capacity == nil or not capacity.configured ->
          {:error, :capacity_unconfigured}

        capacity.revision != revision ->
          {:error, :stale_capacity_revision}

        true ->
          repo.update_all(query, set: [limit: limit, revision: revision + 1])
          {:ok, %{capacity | limit: limit, revision: revision + 1}}
      end
    else
      false -> {:error, :invalid_capacity_policy}
      error -> error
    end
  end

  defp capacity_policy?(revision, limit),
    do:
      is_integer(limit) and limit in 0..10_000 and
        (revision == :new or (is_integer(revision) and revision in 0..(@max_int - 1)))

  defp claim(repo, scope, owner_id, ttl_ms) do
    with true <- text?(owner_id, 128) and ttl?(ttl_ms),
         {:ok, context} <- locked(repo, scope),
         :ok <- valid_reservation(context),
         {:ok, context} <- reserve(repo, context),
         {:ok, context, outcome} <- take_lease(repo, context, owner_id, ttl_ms) do
      {:ok, result(context, outcome)}
    else
      false -> {:error, :invalid_lease_policy}
      error -> error
    end
  end

  defp reserve(_repo, %{reservation: %Reservation{held: true}} = context), do: {:ok, context}

  defp reserve(repo, context) do
    cond do
      context.build.state != :queued ->
        {:error, :not_queued}

      context.reservation != nil and context.reservation.attempt >= context.build.attempt ->
        {:error, :attempt_already_released}

      true ->
        with :ok <- available_capacity(repo, context) do
          reservation = %Reservation{
            build_record_id: context.record.id,
            organization_id: context.scope.organization_id,
            platform: context.scope.platform,
            attempt: context.build.attempt,
            worker_fence: context.build.fence,
            held: true,
            terminal_event_id: nil
          }

          if context.reservation == nil,
            do: repo.insert!(reservation),
            else: persist_reservation(repo, reservation)

          {:ok, %{context | reservation: reservation}}
        end
    end
  end

  defp available_capacity(repo, context) do
    held = from(r in Reservation, where: r.held)
    platform = from(r in held, where: r.platform == ^context.scope.platform)
    organization = from(r in held, where: r.organization_id == ^context.scope.organization_id)

    pair =
      from(r in organization,
        where: r.platform == ^context.scope.platform
      )

    policies = [
      {context.capacities.fleet, held, :fleet_capacity_unconfigured, :fleet_capacity_exhausted},
      {context.capacities.platform, platform, :fleet_platform_capacity_unconfigured,
       :fleet_platform_capacity_exhausted},
      {context.capacities.organization, organization, :organization_capacity_unconfigured,
       :organization_capacity_exhausted},
      {context.capacity, pair, :scope_not_found_or_unconfigured, :capacity_exhausted}
    ]

    Enum.reduce_while(policies, :ok, fn {capacity, query, missing, full}, _ ->
      cond do
        capacity == nil or Map.get(capacity, :configured, true) != true ->
          {:halt, {:error, missing}}

        repo.aggregate(query, :count) >= capacity.limit ->
          {:halt, {:error, full}}

        true ->
          {:cont, :ok}
      end
    end)
  end

  defp take_lease(repo, context, owner_id, ttl_ms) do
    lease = context.lease

    cond do
      lease != nil and live?(lease, context.now) and lease.owner_id == owner_id ->
        {:ok, context, :duplicate}

      lease != nil and live?(lease, context.now) ->
        {:error, :lease_held}

      lease != nil and lease.epoch == @max_int ->
        {:error, :lease_epoch_exhausted}

      true ->
        updated = %Lease{
          build_record_id: context.record.id,
          owner_id: owner_id,
          epoch: if(lease == nil, do: 1, else: lease.epoch + 1),
          expires_at: DateTime.add(context.now, ttl_ms, :millisecond)
        }

        if lease == nil, do: repo.insert!(updated), else: persist_lease(repo, updated)
        {:ok, %{context | lease: updated}, if(lease == nil, do: :acquired, else: :reclaimed)}
    end
  end

  defp guard(repo, token) do
    with :ok <- valid_token(token),
         {:ok, context} <- locked(repo, token.scope),
         :ok <- valid_reservation(context),
         true <-
           context.record.id == token.record_id and context.reservation != nil and
             context.reservation.held and context.reservation.attempt == token.attempt and
             context.lease != nil and context.lease.owner_id == token.owner_id and
             context.lease.epoch == token.epoch,
         true <- live?(context.lease, context.now) do
      {:ok, context}
    else
      false -> {:error, :stale_lease}
      error -> error
    end
  end

  defp locked(repo, scope) do
    with {:ok, scope} <- normalize_scope(scope),
         {:ok, capacities} <- lock_capacities(repo, scope),
         %Capacity{} = capacity <- capacities.capacity,
         %Record{} = record <- repo.one(from(b in build_query(scope), lock: "FOR UPDATE")),
         {:ok, build} <- replay(record) do
      reservation =
        repo.one(
          from(r in Reservation, where: r.build_record_id == ^record.id, lock: "FOR UPDATE")
        )

      lease =
        repo.one(from(l in Lease, where: l.build_record_id == ^record.id, lock: "FOR UPDATE"))

      # clock_timestamp, unlike transaction_timestamp/now(), advances during lock waits.
      %{rows: [[micros]]} =
        repo.query!("SELECT floor(extract(epoch FROM clock_timestamp()) * 1000000)::bigint")

      now = DateTime.from_unix!(micros, :microsecond)

      {:ok,
       %{
         scope: scope,
         capacity: capacity,
         capacities: capacities,
         record: record,
         build: build,
         reservation: reservation,
         lease: lease,
         now: now,
         now_ms: div(micros, 1000)
       }}
    else
      nil -> {:error, :scope_not_found_or_unconfigured}
      error -> error
    end
  end

  # The database mutex exists independently of all configuration rows, so missing
  # parents and first configuration serialize with claims too. It is retained
  # across every Multi fragment and rollback, and is reentrant in a transaction.
  # No transaction may take a raw admission/build row lock before this mutex.
  defp lock_capacities(repo, scope) do
    # Repeatable-read snapshots can predate a mutex wait and miss a reservation
    # committed by its former holder. Fail closed rather than weaken the caller's
    # isolation or silently count against an old snapshot.
    case repo.query!("SELECT current_setting('transaction_isolation')") do
      %{rows: [["read committed"]]} ->
        repo.query!("SELECT pg_advisory_xact_lock(1296648258, 1)")
        {:ok, lock_capacity_rows(repo, scope)}

      _ ->
        {:error, :unsupported_admission_isolation}
    end
  end

  defp lock_capacity_rows(repo, scope) do
    fleet = locked_capacity(repo, FleetCapacity, %{id: "fleet"})

    platform =
      if Map.has_key?(scope, :platform),
        do: locked_capacity(repo, FleetPlatformCapacity, Map.take(scope, [:platform]))

    organization =
      if Map.has_key?(scope, :organization_id),
        do: locked_capacity(repo, OrganizationCapacity, Map.take(scope, [:organization_id]))

    capacity =
      if Map.has_key?(scope, :organization_id) and Map.has_key?(scope, :platform),
        do: repo.one(from(c in capacity_query(scope), lock: "FOR UPDATE"))

    %{fleet: fleet, platform: platform, organization: organization, capacity: capacity}
  end

  defp locked_capacity(repo, schema, identity),
    do: repo.one(from(c in aggregate_query(schema, identity), lock: "FOR UPDATE"))

  defp aggregate_query(schema, identity), do: from(c in schema, where: ^Map.to_list(identity))

  defp aggregate_identity(:fleet, _), do: {FleetCapacity, %{id: "fleet"}}
  defp aggregate_identity(:platform, scope), do: {FleetPlatformCapacity, scope}
  defp aggregate_identity(:organization, scope), do: {OrganizationCapacity, scope}

  defp aggregate_scope(:fleet, %{} = scope) when map_size(scope) == 0, do: {:ok, scope}

  defp aggregate_scope(:platform, %{platform: platform} = scope)
       when map_size(scope) == 1 and platform in [:ios, :android],
       do: {:ok, %{platform: Atom.to_string(platform)}}

  defp aggregate_scope(:organization, %{organization_id: id} = scope) when map_size(scope) == 1,
    do: if(text?(id, 128), do: {:ok, scope}, else: {:error, :invalid_scope})

  defp aggregate_scope(_, _), do: {:error, :invalid_scope}

  defp valid_reservation(%{reservation: nil, lease: nil}), do: :ok
  defp valid_reservation(%{reservation: nil}), do: {:error, :invalid_admission}

  defp valid_reservation(context) do
    r = context.reservation
    l = context.lease
    history = Enum.find(context.build.history, &(&1.attempt == r.attempt))
    current = r.attempt == context.build.attempt

    expected_fence =
      cond do
        current and context.build.state == :queued ->
          context.build.fence

        current and context.build.active_ref != nil ->
          context.build.active_ref.fence

        history != nil and history.worker_ref != nil ->
          history.worker_ref.fence

        history != nil and history.started_at == nil ->
          # Queued cancellation never started a worker and advances the fence once.
          event =
            Enum.find(context.build.events, fn {_id, e} ->
              e.first_observed_at == history.finished_at and e.payload.type == :cancel
            end)

          if current and event != nil, do: context.build.fence - 1, else: nil

        true ->
          nil
      end

    if r.organization_id == context.scope.organization_id and r.platform == context.scope.platform and
         is_integer(r.attempt) and r.attempt in 1..context.build.attempt and
         r.worker_fence == expected_fence and is_boolean(r.held) and
         (not r.held or current) and l != nil and l.build_record_id == r.build_record_id and
         is_integer(l.epoch) and l.epoch in 1..@max_int and
         ((r.held and text?(l.owner_id, 128) and match?(%DateTime{}, l.expires_at) and
             is_nil(r.terminal_event_id)) or
            (not r.held and is_nil(l.owner_id) and is_nil(l.expires_at) and
               text?(r.terminal_event_id, 128) and
               released_evidence?(context, r.terminal_event_id))) do
      :ok
    else
      {:error, :invalid_admission}
    end
  end

  defp terminal_evidence(context, event_id) do
    r = context.reservation

    if context.build.state in @terminal and context.build.attempt == r.attempt and
         released_evidence?(context, event_id) do
      :ok
    else
      {:error, :definitive_terminal_evidence_required}
    end
  end

  defp released_evidence?(context, event_id) do
    event = Map.get(context.build.events, event_id)
    r = context.reservation
    terminal = Enum.find(context.build.history, &(&1.attempt == r.attempt))

    if terminal != nil and event != nil and event.first_observed_at == terminal.finished_at do
      cond do
        event.payload.type in [:completed, :stopped] ->
          terminal.worker_ref != nil and event.payload.ref == terminal.worker_ref and
            terminal.worker_ref.attempt == r.attempt and
            terminal.worker_ref.fence == r.worker_fence

        event.payload.type == :cancel ->
          # The replayed history proves no start was persisted. A capacity claim
          # itself cannot dispatch work; only a committed start permits dispatch.
          terminal.state == :cancelled and terminal.worker_ref == nil and
            terminal.started_at == nil and terminal.deadline == nil and
            context.build.attempt == r.attempt and context.build.fence == r.worker_fence + 1

        true ->
          false
      end
    else
      false
    end
  end

  defp replay(record) do
    with {:ok, build} <- Journal.restore(record.journal),
         true <- wire_scope(build.spec) == Map.take(record, @scope),
         true <- build.request_key == record.request_key,
         true <- record.revision == length(record.journal["events"]) do
      {:ok, build}
    else
      _ -> {:error, :invalid_journal}
    end
  end

  defp valid_token(%Token{} = token) do
    with true <-
           Map.keys(Map.from_struct(token)) |> Enum.sort() ==
             Enum.sort([:scope, :record_id, :attempt, :owner_id, :epoch]),
         {:ok, _} <- normalize_scope(token.scope),
         {:ok, _} <- Ecto.UUID.cast(token.record_id),
         true <-
           text?(token.owner_id, 128) and is_integer(token.attempt) and token.attempt in 1..5 and
             is_integer(token.epoch) and token.epoch in 1..@max_int do
      :ok
    else
      _ -> {:error, :invalid_lease_token}
    end
  end

  defp valid_token(_), do: {:error, :invalid_lease_token}
  defp ttl?(ttl), do: is_integer(ttl) and ttl in 1..300_000

  defp live?(lease, now),
    do:
      lease.owner_id != nil and lease.expires_at != nil and
        DateTime.compare(now, lease.expires_at) == :lt

  defp result(context, outcome) do
    token =
      if outcome not in [:released, :yielded] do
        %Token{
          scope: Map.put(context.scope, :platform, context.build.spec.platform),
          record_id: context.record.id,
          attempt: context.reservation.attempt,
          owner_id: context.lease.owner_id,
          epoch: context.lease.epoch
        }
      end

    Map.merge(Map.take(context, [:record, :build, :reservation, :lease, :now_ms]), %{
      token: token,
      outcome: outcome
    })
  end

  defp persist_reservation(repo, reservation) do
    attrs =
      Map.take(reservation, [
        :organization_id,
        :platform,
        :attempt,
        :worker_fence,
        :held,
        :terminal_event_id
      ])
      |> Map.to_list()

    {1, _} =
      repo.update_all(
        from(r in Reservation, where: r.build_record_id == ^reservation.build_record_id),
        set: attrs
      )

    :ok
  end

  defp persist_lease(repo, lease) do
    {1, _} =
      repo.update_all(from(l in Lease, where: l.build_record_id == ^lease.build_record_id),
        set: [owner_id: lease.owner_id, epoch: lease.epoch, expires_at: lease.expires_at]
      )

    :ok
  end

  defp capacity_query(scope),
    do:
      from(c in Capacity,
        where: c.organization_id == ^scope.organization_id and c.platform == ^scope.platform
      )

  defp build_query(scope),
    do:
      from(b in Record,
        where:
          b.organization_id == ^scope.organization_id and b.project_id == ^scope.project_id and
            b.application_id == ^scope.application_id and b.build_id == ^scope.build_id and
            b.platform == ^scope.platform
      )

  defp wire_scope(spec),
    do: spec |> Map.take(@scope) |> Map.put(:platform, Atom.to_string(spec.platform))

  defp capacity_scope(value) do
    if is_map(value) and map_size(value) == 2 and text?(Map.get(value, :organization_id), 128) and
         Map.get(value, :platform) in [:ios, :android],
       do:
         {:ok,
          %{organization_id: value.organization_id, platform: Atom.to_string(value.platform)}},
       else: {:error, :invalid_scope}
  end

  defp normalize_scope(value) do
    if is_map(value) and map_size(value) == 5 and Enum.all?(@scope, &Map.has_key?(value, &1)) and
         Map.get(value, :platform) in [:ios, :android] and
         Enum.all?(@scope -- [:platform], &text?(Map.get(value, &1), 128)),
       do: {:ok, %{value | platform: Atom.to_string(value.platform)}},
       else: {:error, :invalid_scope}
  end

  defp text?(value, max),
    do:
      is_binary(value) and byte_size(value) in 1..max and String.valid?(value) and
        String.printable?(value)
end

052ac495f845af1c45e56d3d3fbca0fca23ed6e5 blob 12726
defmodule MixerHosted.Builds.Coordinator do
  @moduledoc """
  Internal Oban build coordinator, unavailable without a trusted dispatch adapter.

  Jobs wake reconciliation; their arguments never authorize execution. Every
  invocation replays the exact scoped journal and rejects superseded intents.
  Admission/start and all resulting intents are committed before external I/O.
  A lease transfer preserves the original worker operation and its fence.
  Uncertain effects retain capacity, including after callback death or timeout.
  """
  use Oban.Worker, queue: :builds, max_attempts: 20
  alias Ecto.Multi
  alias MixerHosted.Builds.{Admission, Dispatch, Lifecycle, Storage}
  alias MixerHosted.Repo

  @scope [:organization_id, :project_id, :application_id, :build_id, :platform]
  @keys Enum.map(@scope, &Atom.to_string/1) ++
          ["build_record_id", "revision", "attempt", "fence", "kind"]
  @kinds ["created", "start", "cancel", "expire", "completed", "stopped", "retry"]
  @terminal [:succeeded, :failed, :cancelled, :timed_out]

  @impl true
  def perform(%Oban.Job{args: args} = job) do
    with {:ok, scope} <- arguments(args),
         {:ok, current} <- Storage.read(scope),
         :ok <- current_intent(current, args),
         {:ok, config} <- configuration() do
      owner = "oban:#{job.id || "manual"}:#{Ecto.UUID.generate()}"
      reconcile(current, scope, args, owner, config)
    else
      {:error, :superseded_intent} -> :ok
      {:error, :invalid_intent} -> {:cancel, :invalid_build_intent}
      {:error, :not_found} -> {:cancel, :build_not_found}
      {:error, error} -> {:error, error}
    end
  end

  defp reconcile(%{build: %{state: state}} = current, scope, args, owner, config)
       when state in @terminal do
    case transaction(
           Admission.claim_multi(Multi.new(), :claim, scope, owner, config.lease_ttl_ms)
           |> Multi.merge(fn %{claim: claimed} ->
             with_current(claimed, args, fn ->
               Admission.release_multi(
                 Multi.new(),
                 :release,
                 claimed.token,
                 terminal_event(claimed)
               )
             end)
           end)
         ) do
      {:ok, _} -> retry(current, scope, config)
      {:error, :attempt_already_released} -> retry(current, scope, config)
      {:error, :not_queued} -> retry(current, scope, config)
      {:error, :superseded_intent} -> :ok
      {:error, _} -> snooze(config)
    end
  end

  defp reconcile(_current, scope, args, owner, config) do
    multi =
      Admission.claim_multi(Multi.new(), :claim, scope, owner, config.lease_ttl_ms)
      |> Multi.merge(fn %{claim: claimed} ->
        with_current(claimed, args, fn -> prepare(claimed) end)
      end)

    case transaction(multi) do
      {:ok, %{prepared: :transitioned}} -> :ok
      {:ok, %{prepared: context}} -> external(context, args, config)
      {:error, :superseded_intent} -> :ok
      {:error, _} -> snooze(config)
    end
  end

  defp prepare(%{build: %{state: :queued}} = context) do
    {:ok, ref} = Lifecycle.worker_ref(context.build)

    transition(context, :start, %{type: :start, ref: ref})
    |> Admission.yield_multi(:yield, context.token)
    |> Multi.put(:prepared, :transitioned)
  end

  defp prepare(%{build: %{state: :running}} = context)
       when context.now_ms >= context.build.deadline do
    transition(context, :expire, %{type: :expire, ref: context.build.active_ref})
    |> Admission.yield_multi(:yield, context.token)
    |> Multi.put(:prepared, :transitioned)
  end

  defp prepare(context), do: Multi.new() |> Multi.put(:prepared, context)

  defp external(context, args, config) do
    with {:ok, context} <- refresh(context.token, args, config),
         request = Dispatch.request(context),
         {:ok, status} <- invoke(:query, request, config) do
      case status do
        terminal when is_tuple(terminal) -> finish(context, args, terminal, config)
        :running when context.build.state == :running -> wait(context, config)
        _ -> act(context, args, config)
      end
    else
      {:error, :superseded_intent} -> :ok
      {:error, _} -> wait(context, config)
    end
  end

  defp act(context, args, config) do
    # Recheck SQL ownership, current intent and deadline between callbacks.
    with {:ok, context} <- refresh(context.token, args, config),
         request = Dispatch.request(context),
         callback = if(context.build.state == :running, do: :ensure_started, else: :stop),
         {:ok, status} <- invoke(callback, request, config) do
      case status do
        terminal when is_tuple(terminal) -> finish(context, args, terminal, config)
        _ -> wait(context, config)
      end
    else
      {:error, :superseded_intent} -> :ok
      {:error, _} -> wait(context, config)
    end
  end

  defp refresh(token, args, config) do
    multi =
      Admission.renew_multi(Multi.new(), :renew, token, config.lease_ttl_ms)
      |> Multi.merge(fn %{renew: renewed} ->
        with_current(renewed, args, fn ->
          if renewed.build.state == :running and renewed.now_ms >= renewed.build.deadline do
            transition(renewed, :expire, %{type: :expire, ref: renewed.build.active_ref})
            |> Admission.yield_multi(:yield, renewed.token)
            |> Multi.put(:current, :transitioned)
          else
            Multi.new() |> Multi.put(:current, renewed)
          end
        end)
      end)

    case transaction(multi) do
      {:ok, %{current: :transitioned}} -> {:error, :superseded_intent}
      {:ok, %{current: current}} -> {:ok, current}
      error -> error
    end
  end

  defp finish(context, args, status, config) do
    {kind, event} =
      case status do
        {:completed, result} ->
          {:completed, %{type: :completed, ref: context.build.active_ref, result: result}}

        {:stopped, digest} ->
          {:stopped, %{type: :stopped, ref: context.build.active_ref, diagnostic_sha256: digest}}
      end

    id = event_id(context, kind)

    multi =
      Admission.renew_multi(Multi.new(), :renew, context.token, config.lease_ttl_ms)
      |> Multi.merge(fn %{renew: latest} ->
        with_current(latest, args, fn ->
          transition(latest, kind, event, id)
          |> Admission.release_multi(:release, latest.token, id)
        end)
      end)

    case transaction(multi) do
      {:ok, _} -> :ok
      {:error, :superseded_intent} -> :ok
      {:error, _} -> wait(context, config)
    end
  end

  defp retry(current, scope, config) do
    {:ok, status} = Lifecycle.customer_status(current.build)

    if status.retryable do
      multi =
        Admission.retry_multi(
          Multi.new(),
          :retry,
          scope,
          current.record.revision,
          event_id(current, :retry),
          &__MODULE__.new/1
        )

      case transaction(multi) do
        {:ok, _} -> :ok
        {:error, :released_current_attempt_required} -> :ok
        {:error, _} -> snooze(config)
      end
    else
      :ok
    end
  end

  defp transition(context, kind, event, id \\ nil) do
    Admission.transition_multi(
      Multi.new(),
      :transition,
      context.token,
      context.record.revision,
      id || event_id(context, kind),
      event,
      &__MODULE__.new/1
    )
  end

  defp with_current(context, args, fun) do
    case current_intent(context, args) do
      :ok -> fun.()
      error -> Multi.new() |> Multi.run(:intent, fn _, _ -> error end)
    end
  end

  defp event_id(context, kind),
    do: "coordinator:#{context.build.attempt}:#{context.record.revision}:#{kind}"

  defp terminal_event(context) do
    # Terminal state follows the last replayed event. Do not choose an earlier
    # cancellation merely because both events happened in the same millisecond.
    List.last(context.record.journal["events"])["id"]
  end

  defp current_intent(current, args) do
    kind =
      case List.last(current.record.journal["events"]) do
        nil -> "created"
        event -> event["event"]["type"]
      end

    if current.record.id == args["build_record_id"] and
         current.record.revision == args["revision"] and
         current.build.attempt == args["attempt"] and current.build.fence == args["fence"] and
         kind == args["kind"],
       do: :ok,
       else: {:error, :superseded_intent}
  end

  defp arguments(args) when is_map(args) and map_size(args) == length(@keys) do
    with true <- Enum.all?(@keys, &Map.has_key?(args, &1)),
         {:ok, _} <- Ecto.UUID.cast(args["build_record_id"]),
         true <- is_integer(args["revision"]) and args["revision"] in 0..32,
         true <- is_integer(args["attempt"]) and args["attempt"] in 1..5,
         true <- is_integer(args["fence"]) and args["fence"] in 1..9_223_372_036_854_775_807,
         true <- args["kind"] in @kinds,
         true <- args["platform"] in ["ios", "android"],
         true <- Enum.all?(@scope -- [:platform], &text?(args[Atom.to_string(&1)])) do
      scope = Map.new(@scope, &{&1, args[Atom.to_string(&1)]})
      {:ok, %{scope | platform: if(scope.platform == "ios", do: :ios, else: :android)}}
    else
      _ -> {:error, :invalid_intent}
    end
  end

  defp arguments(_), do: {:error, :invalid_intent}

  defp text?(value),
    do:
      is_binary(value) and byte_size(value) in 1..128 and String.valid?(value) and
        String.printable?(value)

  defp configuration do
    case Application.get_env(:mixer_hosted, :build_dispatch) do
      config when is_list(config) ->
        if Keyword.keyword?(config) and length(config) == 4 and
             Enum.sort(Keyword.keys(config)) ==
               Enum.sort([:adapter, :lease_ttl_ms, :call_timeout_ms, :poll_ms]) do
          c = Map.new(config)

          if is_atom(c.adapter) and c.adapter != nil and Code.ensure_loaded?(c.adapter) and
               Enum.all?([:query, :ensure_started, :stop], &function_exported?(c.adapter, &1, 1)) and
               is_integer(c.call_timeout_ms) and c.call_timeout_ms in 1..10_000 and
               is_integer(c.lease_ttl_ms) and c.lease_ttl_ms in 1..300_000 and
               c.lease_ttl_ms >= 3 * c.call_timeout_ms and
               is_integer(c.poll_ms) and c.poll_ms in 1..60_000,
             do: {:ok, c},
             else: {:error, :invalid_dispatch_configuration}
        else
          {:error, :invalid_dispatch_configuration}
        end

      nil ->
        {:error, :dispatch_unavailable}

      _ ->
        {:error, :invalid_dispatch_configuration}
    end
  end

  defp invoke(callback, request, config) do
    parent = self()
    reference = make_ref()

    {pid, monitor} =
      spawn_monitor(fn ->
        transport = self()

        # The external operation survives locally, but its BEAM transport must
        # not leak when its coordinator is abruptly terminated.
        spawn(fn ->
          parent_monitor = Process.monitor(parent)
          transport_monitor = Process.monitor(transport)

          receive do
            {:DOWN, ^parent_monitor, :process, ^parent, _} -> Process.exit(transport, :kill)
            {:DOWN, ^transport_monitor, :process, ^transport, _} -> :ok
          end
        end)

        result =
          try do
            apply(config.adapter, callback, [request])
          rescue
            _ -> {:error, :uncertain}
          catch
            _, _ -> {:error, :uncertain}
          end

        send(parent, {reference, result})
      end)

    result =
      receive do
        {^reference, value} ->
          Process.demonitor(monitor, [:flush])
          value

        {:DOWN, ^monitor, :process, ^pid, _reason} ->
          {:error, :uncertain}
      after
        config.call_timeout_ms ->
          Process.exit(pid, :kill)

          receive do
            {:DOWN, ^monitor, :process, ^pid, _} -> :ok
          after
            1_000 -> Process.demonitor(monitor, [:flush])
          end

          receive do
            {^reference, _} -> :ok
          after
            0 -> :ok
          end

          {:error, :uncertain}
      end

    Dispatch.observation(request, result)
  end

  defp transaction(multi) do
    case Repo.transaction(multi) do
      {:ok, results} -> {:ok, results}
      {:error, _step, reason, _changes} -> {:error, reason}
    end
  end

  defp wait(context, config) do
    # A finished local invocation needs no lease while waiting for its next wake.
    # Uncertainty still retains the reservation; an actual coordinator crash
    # before this point leaves the ordinary lease expiry protection intact.
    Admission.yield_multi(Multi.new(), :yield, context.token) |> transaction()
    snooze(config)
  end

  defp snooze(config), do: {:snooze, max(1, div(config.poll_ms + 999, 1000))}
end

655829d8ab3c6ffc6c07e3ea262e06fe9e196587 blob 3130
defmodule MixerHosted.Builds.Dispatch do
  @moduledoc """
  Trusted external build adapter contract; no adapter is installed by default.

  An implementation must durably bind operation_id to the exact original ref,
  spec and deadline, authorize its worker separately, and enforce lexicographic
  {lease epoch, journal revision} ordering. An expired or older request must not
  act. ensure_started is idempotent for the operation's entire retention period;
  stop installs a permanent terminal tombstone even for an absent operation.
  A delayed ensure must never reopen that identity. query's :absent observation
  is not proof that a request in flight cannot create a worker. Only definitive
  completion or stop observations authorize capacity release.

  These are provider implementation obligations, not claims of authentication,
  isolation, deployment qualification or exactly-once Oban execution. Adapters
  run trusted transport code only; customer build scripts run outside BEAM.
  """

  defmodule Request do
    @moduledoc "Immutable operation identity plus a separate coordinator lease guard."
    @enforce_keys [:operation_id, :ref, :spec, :deadline_ms, :guard]
    defstruct @enforce_keys
    @type t :: %__MODULE__{}
  end

  defmodule Observation do
    @moduledoc "A trusted adapter observation bound to one immutable worker operation."
    @enforce_keys [:operation_id, :ref, :status]
    defstruct @enforce_keys
    @type t :: %__MODULE__{}
  end

  @type result :: {:ok, Observation.t()} | {:error, :unavailable | :uncertain | :stale}
  @callback query(Request.t()) :: result()
  @callback ensure_started(Request.t()) :: result()
  @callback stop(Request.t()) :: result()

  @doc false
  def request(context) do
    ref = context.build.active_ref

    identity = [
      "mixer-build-operation-v1",
      context.record.id,
      ref.organization_id,
      ref.project_id,
      ref.application_id,
      ref.build_id,
      Atom.to_string(ref.platform),
      ref.attempt,
      ref.fence
    ]

    operation_id = :crypto.hash(:sha256, Jason.encode!(identity)) |> Base.encode16(case: :lower)

    %Request{
      operation_id: operation_id,
      ref: ref,
      spec: context.build.spec,
      deadline_ms: context.build.deadline,
      guard: %{
        record_id: context.record.id,
        revision: context.record.revision,
        owner_id: context.token.owner_id,
        epoch: context.token.epoch,
        expires_at: context.lease.expires_at
      }
    }
  end

  @doc false
  def observation(%Request{} = request, {:ok, %Observation{} = observation}) do
    if observation.operation_id == request.operation_id and observation.ref == request.ref and
         (observation.status in [:absent, :running] or
            match?({:completed, %{}}, observation.status) or
            match?({:stopped, _}, observation.status)) do
      {:ok, observation.status}
    else
      {:error, :invalid_observation}
    end
  end

  def observation(_, {:error, error}) when error in [:unavailable, :uncertain, :stale],
    do: {:error, error}

  def observation(_, _), do: {:error, :invalid_observation}
end

3c85d947d5504dc457c065d89a153b666403f9b5 blob 18098
defmodule MixerHosted.Builds.Journal do
  @moduledoc """
  Closed, bounded JSON-compatible lifecycle journals for internal persistence.

  Only creation inputs and ordered events are persisted. Restore replays the
  accepted lifecycle API; no caller-provided Build snapshot is hydrated. This
  codec provides neither authorization nor source, worker or artifact proof.
  """

  alias MixerHosted.Builds.Lifecycle
  alias MixerHosted.Builds.Lifecycle.{ArtifactRef, WorkerRef}

  @max_time 9_223_372_036_854_775_807
  @max_events 32
  @max_bytes 128 * 1024
  @scope ~w(organization_id project_id application_id build_id platform)
  @spec_fields @scope ++ ~w(source toolchain_lock_sha256 build_definition_sha256)
  @policy ~w(max_attempts timeout_ms retry_backoff_ms)
  @ref @scope ++ ~w(attempt fence)
  @ref_keys [
    :organization_id,
    :project_id,
    :application_id,
    :build_id,
    :platform,
    :attempt,
    :fence
  ]
  @kinds [
    unsigned_native_binary: "unsigned_native_binary",
    guest_artifact: "guest_artifact",
    resource_inventory: "resource_inventory",
    debug_symbols: "debug_symbols",
    compatibility_report: "compatibility_report",
    sbom: "sbom",
    provenance: "provenance"
  ]
  @classes [
    infrastructure: "infrastructure",
    compiler: "compiler",
    test: "test",
    policy: "policy",
    unknown: "unknown"
  ]
  @codes [
    worker_unavailable: "worker_unavailable",
    worker_lost: "worker_lost",
    dependency_transport: "dependency_transport",
    artifact_transport: "artifact_transport",
    worker_timeout: "worker_timeout",
    compiler_error: "compiler_error",
    test_failure: "test_failure",
    policy_rejection: "policy_rejection",
    invalid_input: "invalid_input",
    unknown_failure: "unknown_failure"
  ]

  @doc "Creates a canonical schema-1 journal and its validated queued build."
  def new(spec, policy, request_key, now_ms) do
    with {:ok, build} <- Lifecycle.new(spec, policy, request_key, now_ms) do
      document = %{
        "schema" => 1,
        "creation" => %{
          "spec" => encode_spec(build.spec),
          "policy" => %{
            "max_attempts" => build.policy.max_attempts,
            "timeout_ms" => build.policy.timeout_ms,
            "retry_backoff_ms" => build.policy.retry_backoff_ms
          },
          "request_key" => build.request_key,
          "now_ms" => build.queued_at
        },
        "events" => []
      }

      if bounded_json?(document), do: {:ok, document, build}, else: {:error, :journal_limit}
    end
  end

  @doc "Replays an exact schema-1 document; every stored row must newly apply."
  def restore(document) do
    with true <- exact?(document, ~w(schema creation events)),
         1 <- document["schema"],
         {:ok, spec, policy, request_key, now_ms} <- decode_creation(document["creation"]),
         {:ok, rows} <- decode_rows(document["events"]),
         true <- bounded_json?(document),
         {:ok, build} <- Lifecycle.new(spec, policy, request_key, now_ms),
         {:ok, build} <- replay(rows, build) do
      {:ok, build}
    else
      _ -> {:error, :invalid_journal}
    end
  end

  @doc """
  Appends a lifecycle event. Exact duplicate delivery retains the original
  document and current replayed build, ignoring the duplicate delivery time.
  """
  def append(document, event_id, event, now_ms) do
    with {:ok, build} <- restore(document),
         true <- text?(event_id, 128) do
      case encode_event(event) do
        {:ok, encoded} ->
          append_event(document, build, event_id, event, encoded, now_ms)

        :error ->
          reason =
            if Map.has_key?(build.events, event_id), do: :event_conflict, else: :invalid_event

          {:error, reason}
      end
    else
      false -> {:error, :invalid_event_id}
      error -> error
    end
  end

  defp append_event(document, build, event_id, event, encoded, now_ms) do
    with {:ok, updated, outcome} <- Lifecycle.transition(build, event_id, event, now_ms) do
      if outcome == :duplicate do
        {:ok, document, updated, :duplicate}
      else
        row = %{"id" => event_id, "event" => encoded, "now_ms" => now_ms}
        appended = Map.update!(document, "events", &(&1 ++ [row]))

        if bounded_json?(appended),
          do: {:ok, appended, updated, :applied},
          else: {:error, :journal_limit}
      end
    end
  end

  defp replay(rows, build) do
    Enum.reduce_while(rows, {:ok, build}, fn {id, event, now_ms}, {:ok, current} ->
      case Lifecycle.transition(current, id, event, now_ms) do
        {:ok, updated, :applied} -> {:cont, {:ok, updated}}
        _ -> {:halt, :error}
      end
    end)
  end

  defp encode_spec(spec) do
    %{
      "organization_id" => spec.organization_id,
      "project_id" => spec.project_id,
      "application_id" => spec.application_id,
      "build_id" => spec.build_id,
      "platform" => encode_enum!(spec.platform, ios: "ios", android: "android"),
      "source" => %{
        "kind" => encode_enum!(spec.source.kind, revision: "revision", upload: "upload"),
        "sha256" => spec.source.sha256,
        "reference" => spec.source.reference
      },
      "toolchain_lock_sha256" => spec.toolchain_lock_sha256,
      "build_definition_sha256" => spec.build_definition_sha256
    }
  end

  defp decode_creation(value) do
    with true <- exact?(value, ~w(spec policy request_key now_ms)),
         {:ok, spec} <- decode_spec(value["spec"]),
         {:ok, policy} <- decode_policy(value["policy"]),
         true <- text?(value["request_key"], 128),
         true <- time?(value["now_ms"]) do
      {:ok, spec, policy, value["request_key"], value["now_ms"]}
    else
      _ -> :error
    end
  end

  defp decode_spec(value) do
    with true <- exact?(value, @spec_fields),
         {:ok, scope} <- decode_scope(value),
         source = value["source"],
         true <- exact?(source, ~w(kind sha256 reference)),
         {:ok, kind} <- decode_enum(source["kind"], revision: "revision", upload: "upload"),
         true <- sha?(source["sha256"]) and text?(source["reference"], 1024),
         true <- sha?(value["toolchain_lock_sha256"]) and sha?(value["build_definition_sha256"]) do
      {:ok,
       Map.merge(scope, %{
         source: %{kind: kind, sha256: source["sha256"], reference: source["reference"]},
         toolchain_lock_sha256: value["toolchain_lock_sha256"],
         build_definition_sha256: value["build_definition_sha256"]
       })}
    else
      _ -> :error
    end
  end

  defp decode_scope(value) do
    with true <- Enum.all?(@scope -- ["platform"], &text?(value[&1], 128)),
         {:ok, platform} <- decode_enum(value["platform"], ios: "ios", android: "android") do
      {:ok,
       %{
         organization_id: value["organization_id"],
         project_id: value["project_id"],
         application_id: value["application_id"],
         build_id: value["build_id"],
         platform: platform
       }}
    else
      _ -> :error
    end
  end

  defp decode_policy(value) do
    if exact?(value, @policy) and integer?(value["max_attempts"], 1, 5) and
         integer?(value["timeout_ms"], 1, 86_400_000) and
         integer?(value["retry_backoff_ms"], 0, 3_600_000) do
      {:ok,
       %{
         max_attempts: value["max_attempts"],
         timeout_ms: value["timeout_ms"],
         retry_backoff_ms: value["retry_backoff_ms"]
       }}
    else
      :error
    end
  end

  defp decode_rows(rows) do
    if bounded_list?(rows, 0, @max_events) do
      Enum.reduce_while(rows, {:ok, []}, fn row, {:ok, acc} ->
        with true <- exact?(row, ~w(id event now_ms)),
             true <- text?(row["id"], 128) and time?(row["now_ms"]),
             {:ok, event} <- decode_event(row["event"]) do
          {:cont, {:ok, [{row["id"], event, row["now_ms"]} | acc]}}
        else
          _ -> {:halt, :error}
        end
      end)
      |> case do
        {:ok, decoded} -> {:ok, Enum.reverse(decoded)}
