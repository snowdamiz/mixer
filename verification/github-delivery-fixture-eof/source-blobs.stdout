defmodule MixerHosted.Authorization.Transaction.Snapshot do
  @moduledoc """
  Closed, bounded audit data from the locked authorization rows.

  This data is not authority. `issued_at` and `expires_at` describe the verified
  access token, never an authentication event. Subject linkage is represented by
  SHA-256 of the exact subject within its profile/version namespace. The request
  ID is generated here and has no relationship to a caller's HTTP request ID.
  """

  alias MixerHosted.Authorization.{Policy, Scope}
  alias MixerHosted.Authorization.Postgres.Session
  alias MixerHosted.Identity.Encoding

  @maximum 9_007_199_254_740_991
  @roles ~w(owner administrator developer release_manager billing_manager viewer)
  @fields [
    :request_id,
    :profile,
    :binding,
    :principal,
    :credential,
    :family,
    :memberships,
    :organization_head,
    :project_head,
    :identity,
    :action,
    :target,
    :checked_at
  ]

  @doc false
  def load!(repo, identity, evidence, linkage, decision, now) do
    [id, version, issuer, client, identity_class, active, state_revision] =
      Session.one!(
        repo,
        "SELECT id, version, issuer, client_id, identity_class, active, state_revision FROM public.mixer_authz_profiles",
        [],
        :unauthenticated
      )

    [
      profile,
      profile_version,
      subject,
      binding_class,
      principal,
      binding_active,
      binding_revision
    ] =
      Session.one!(
        repo,
        "SELECT profile_id, profile_version, subject, identity_class, principal_id, active, revision FROM public.mixer_authz_bindings",
        [],
        :unauthenticated
      )

    [cp, cv, reference, credential_principal, family_id, ca, cs, ce, cr] =
      Session.one!(
        repo,
        "SELECT profile_id, profile_version, reference, principal_id, family_id, active, not_before, expires_at, revision FROM public.mixer_authz_credentials",
        [],
        :unauthenticated
      )

    [fid, fp, fv, family_principal, fa, fs, fe, fr] =
      Session.one!(
        repo,
        "SELECT id, profile_id, profile_version, principal_id, active, not_before, expires_at, revision FROM public.mixer_authz_families",
        [],
        :unauthenticated
      )

    snapshot = %{
      request_id: Base.encode16(:crypto.strong_rand_bytes(16), case: :lower),
      profile: %{
        id: id,
        version: version,
        issuer: issuer,
        client_id: client,
        identity_class: identity_class,
        active: active,
        state_revision: state_revision
      },
      binding: %{
        profile_id: profile,
        profile_version: profile_version,
        subject_digest: digest(subject),
        identity_class: binding_class,
        principal_id: principal,
        active: binding_active,
        revision: binding_revision
      },
      principal: evidence.principal,
      credential: %{
        profile_id: cp,
        profile_version: cv,
        reference: reference,
        principal_id: credential_principal,
        family_id: family_id,
        active: ca,
        not_before: cs,
        expires_at: ce,
        revision: cr
      },
      family: %{
        id: fid,
        profile_id: fp,
        profile_version: fv,
        principal_id: family_principal,
        active: fa,
        not_before: fs,
        expires_at: fe,
        revision: fr
      },
      memberships:
        evidence.memberships
        |> Enum.filter(&(&1.id in decision.membership_ids))
        |> Enum.sort_by(& &1.id),
      organization_head: %{
        organization_id: decision.target.organization_id,
        revision: evidence.organization_revision
      },
      project_head: %{
        organization_id: decision.target.organization_id,
        project_id: decision.target.project_id,
        revision: evidence.project_revision
      },
      identity: identity_snapshot(identity),
      action: decision.action,
      target: decision.target,
      checked_at: now
    }

    # Verify all raw-state projections against the accepted, locked policy
    # evidence before retaining a snapshot. The policy contract stays unchanged.
    if linkage.principal_id != principal or linkage.family_id != fid or
         subject != identity.subject or evidence.profile_active != active or
         evidence.binding_active != binding_active or
         evidence.binding.principal_id != principal or
         evidence.credential.active != (ca and fa) or
         evidence.credential.not_before != max(cs, fs) or
         evidence.credential.expires_at != earliest(ce, fe) or
         not valid?(snapshot, identity, decision) do
      repo.rollback(:authorization_unavailable)
    end

    snapshot
  end

  @doc false
  def valid?(snapshot, identity, decision) do
    with true <- strict?(snapshot, @fields),
         true <- hex?(snapshot.request_id, 32),
         true <- Encoding.numeric_date?(snapshot.checked_at),
         true <-
           Policy.valid_decision?(
             decision,
             identity,
             snapshot.action,
             snapshot.target,
             snapshot.checked_at
           ),
         true <- profile?(snapshot.profile),
         true <- binding?(snapshot.binding),
         true <- principal?(snapshot.principal),
         true <- credential?(snapshot.credential),
         true <- family?(snapshot.family),
         true <- strict?(snapshot.organization_head, [:organization_id, :revision]),
         true <- strict?(snapshot.project_head, [:organization_id, :project_id, :revision]),
         true <-
           strict?(snapshot.identity, [
             :profile_id,
             :profile_version,
             :issuer,
             :subject_digest,
             :client_id,
             :credential_ref,
             :identity_class,
             :issued_at,
             :expires_at,
             :scopes
           ]),
         true <- snapshot.identity === identity_snapshot(identity),
         true <- bounded_list?(snapshot.memberships, 64),
         true <- Enum.all?(snapshot.memberships, &membership?/1),
         true <- Enum.map(snapshot.memberships, & &1.id) === decision.membership_ids,
         true <-
           Enum.all?(
             snapshot.memberships,
             &(&1.principal_id == snapshot.principal.id and
                 Scope.membership_covers?(&1, snapshot.target))
           ),
         true <-
           Enum.sort(Enum.uniq(Enum.map(snapshot.memberships, & &1.role))) === decision.roles,
         true <- projections?(snapshot, identity, decision) do
      true
    else
      _ -> false
    end
  rescue
    _ -> false
  catch
    _, _ -> false
  end

  defp projections?(s, i, d) do
    p = s.profile
    b = s.binding
    c = s.credential
    f = s.family

    p.id == i.profile_id and p.version == i.profile_version and p.issuer == i.issuer and
      p.client_id == i.client_id and p.identity_class == "human" and p.active and
      b.profile_id == p.id and b.profile_version == p.version and
      b.subject_digest == digest(i.subject) and
      b.identity_class == p.identity_class and b.principal_id == s.principal.id and b.active and
      s.principal.id == d.principal_id and s.principal.identity_class == :human and
      s.principal.active and
      s.principal.revision == d.principal_revision and s.principal.not_before <= i.issued_at and
      c.profile_id == p.id and c.profile_version == p.version and c.reference == i.credential_ref and
      c.principal_id == s.principal.id and c.family_id == f.id and c.active and
      c.revision == d.credential_revision and f.profile_id == p.id and
      f.profile_version == p.version and
      f.principal_id == s.principal.id and f.active and live?(c, i, s.checked_at) and
      live?(f, i, s.checked_at) and
      Enum.all?(s.memberships, &(&1.active and live?(&1, nil, s.checked_at))) and
      s.organization_head.organization_id == s.target.organization_id and
      s.organization_head.revision == d.organization_revision and
      revision?(s.organization_head.revision) and
      s.project_head.organization_id == s.target.organization_id and
      s.project_head.project_id == s.target.project_id and
      s.project_head.revision == d.project_revision and revision?(s.project_head.revision)
  end

  defp profile?(p) do
    strict?(p, [:id, :version, :issuer, :client_id, :identity_class, :active, :state_revision]) and
      Encoding.bounded_string?(p.id, 128) and version?(p.version) and
      Encoding.bounded_string?(p.issuer, 2048) and Encoding.bounded_string?(p.client_id, 256) and
      p.identity_class in ["human", "service"] and is_boolean(p.active) and
      revision?(p.state_revision)
  end

  defp binding?(b) do
    strict?(b, [
      :profile_id,
      :profile_version,
      :subject_digest,
      :identity_class,
      :principal_id,
      :active,
      :revision
    ]) and
      Encoding.bounded_string?(b.profile_id, 128) and version?(b.profile_version) and
      hex?(b.subject_digest, 64) and b.identity_class in ["human", "service"] and
      Scope.identifier?(b.principal_id) and is_boolean(b.active) and revision?(b.revision)
  end

  defp principal?(p) do
    strict?(p, [:id, :identity_class, :active, :not_before, :revision]) and
      Scope.identifier?(p.id) and
      p.identity_class in [:human, :service] and is_boolean(p.active) and
      Encoding.numeric_date?(p.not_before) and revision?(p.revision)
  end

  defp credential?(c) do
    strict?(c, [
      :profile_id,
      :profile_version,
      :reference,
      :principal_id,
      :family_id,
      :active,
      :not_before,
      :expires_at,
      :revision
    ]) and
      Encoding.bounded_string?(c.profile_id, 128) and version?(c.profile_version) and
      Encoding.bounded_string?(c.reference, 256) and Scope.identifier?(c.principal_id) and
      Scope.identifier?(c.family_id) and state?(c)
  end

  defp family?(f) do
    strict?(f, [
      :id,
      :profile_id,
      :profile_version,
      :principal_id,
      :active,
      :not_before,
      :expires_at,
      :revision
    ]) and
      Scope.identifier?(f.id) and Encoding.bounded_string?(f.profile_id, 128) and
      version?(f.profile_version) and Scope.identifier?(f.principal_id) and state?(f)
  end

  defp membership?(m) do
    with true <-
           strict?(m, [
             :id,
             :principal_id,
             :role,
             :scope,
             :project_binding,
             :active,
             :not_before,
             :expires_at,
             :revision
           ]),
         true <- Scope.identifier?(m.id) and Scope.identifier?(m.principal_id),
         true <- m.role in @roles and state?(m),
         {:ok, scope} <- Scope.new(m.scope) do
      (is_nil(scope.project_id) and m.project_binding == :all_projects) or
        (Scope.project_only?(scope) and m.project_binding == :exact_project)
    else
      _ -> false
    end
  end

  defp identity_snapshot(i) do
    i |> Map.from_struct() |> Map.delete(:subject) |> Map.put(:subject_digest, digest(i.subject))
  end

  defp state?(v),
    do: is_boolean(v.active) and window?(v.not_before, v.expires_at) and revision?(v.revision)

  defp window?(s, nil), do: Encoding.numeric_date?(s)
  defp window?(s, e), do: Encoding.numeric_date?(s) and Encoding.numeric_date?(e) and s < e

  defp live?(v, i, now),
    do:
      v.not_before <= now and (is_nil(v.expires_at) or now < v.expires_at) and
        (is_nil(i) or v.not_before <= i.issued_at)

  defp revision?(v), do: is_integer(v) and v in 1..@maximum
  defp version?(v), do: is_integer(v) and v in 1..2_147_483_647

  defp strict?(v, fields) when is_map(v) and not is_struct(v),
    do: map_size(v) == length(fields) and Enum.all?(fields, &Map.has_key?(v, &1))

  defp strict?(_, _), do: false
  defp bounded_list?([], _), do: true

  defp bounded_list?([_ | rest], remaining) when remaining > 0,
    do: bounded_list?(rest, remaining - 1)

  defp bounded_list?(_, _), do: false

  defp hex?(v, n) when is_binary(v) and byte_size(v) == n,
    do: Enum.all?(:binary.bin_to_list(v), &(&1 in ?0..?9 or &1 in ?a..?f))

  defp hex?(_, _), do: false
  defp digest(subject), do: :crypto.hash(:sha256, subject) |> Base.encode16(case: :lower)
  defp earliest(nil, b), do: b
  defp earliest(a, nil), do: a
  defp earliest(a, b), do: min(a, b)
end

5095ac6dd836c6e3d0f2968cf59f1e60c163968d blob 7827
defmodule MixerHosted.Billing.RawWebhookCapture do
  @moduledoc """
  Private, first-consumer exact-byte capture. This module sends no response,
  verifies no signature, and authorizes no event. Every error connection is
  halted and unusable; the caller must dispose of its connection/stream.

  Success deadlines reject late admission, not forcibly terminate adapter work.
  The optional clock implementation is compiled only into the isolated test
  artifact; production compilation has no request-selectable clock or options.
  """
  @max_body 1_048_576
  @read_target 32_768
  @max_reads 64
  @success_ms 5_000
  @read_ms 1_000

  @type reason ::
          :envelope
          | :unsupported_framing
          | :too_large
          | :empty
          | :length_mismatch
          | :read_limit
          | :no_progress
          | :read_deadline
          | :transport_failure
          | :unavailable_state
  @spec capture(Plug.Conn.t()) ::
          {:ok, %{raw_body: binary(), signature_header_values: [binary()]}, Plug.Conn.t()}
          | {:error, reason(), Plug.Conn.t()}
  def capture(%Plug.Conn{} = conn) do
    deadline = now_ms() + @success_ms
    # This component never stores captured bytes on conn. Remove its own prior
    # result slot defensively; it cannot undo another consumer's prior reads.
    conn = %{
      conn
      | private: Map.delete(conn.private, :raw_webhook_capture),
        assigns: Map.delete(conn.assigns, :raw_webhook_capture)
    }

    with {:ok, declared, headers} <- envelope(conn) do
      read(conn, declared, headers, deadline, 0, 0, [])
    else
      {:error, reason} -> failure(reason, conn)
    end
  end

  defp envelope(conn) do
    cond do
      conn.halted or conn.state != :unset ->
        {:error, :unavailable_state}

      conn.method != "POST" or conn.request_path != "/api/v1/webhooks/stripe" or
          conn.query_string != "" ->
        {:error, :envelope}

      headers(conn, "content-encoding") != [] ->
        {:error, :envelope}

      Enum.any?(["trailer", "expect", "upgrade", "te"], &(headers(conn, &1) != [])) ->
        {:error, :unsupported_framing}

      Enum.any?(headers(conn, "connection"), &upgrade?/1) ->
        {:error, :unsupported_framing}

      not media_type?(headers(conn, "content-type")) ->
        {:error, :envelope}

      not signature?(headers(conn, "stripe-signature")) ->
        {:error, :envelope}

      true ->
        with {:ok, declared} <-
               framing(
                 Plug.Conn.get_http_protocol(conn),
                 headers(conn, "content-length"),
                 headers(conn, "transfer-encoding")
               ) do
          {:ok, declared, headers(conn, "stripe-signature")}
        end
    end
  end

  defp headers(conn, name), do: Plug.Conn.get_req_header(conn, name)
  defp signature?([value]) when is_binary(value), do: byte_size(value) in 1..4_096
  defp signature?(_), do: false

  defp upgrade?(value),
    do: value |> :binary.split(",", [:global]) |> Enum.any?(&(token(&1) == "upgrade"))

  defp media_type?([value]) when is_binary(value) and byte_size(value) in 1..128 do
    if ascii?(value) do
      case :binary.split(value, ";", [:global]) do
        [type] ->
          token(type) == "application/json"

        [type, parameter] ->
          token(type) == "application/json" and
            case :binary.split(parameter, "=", [:global]) do
              [name, charset] -> token(name) == "charset" and token(charset) == "utf-8"
              _ -> false
            end

        _ ->
          false
      end
    else
      false
    end
  end

  defp media_type?(_), do: false
  defp ascii?(<<>>), do: true
  defp ascii?(<<byte, rest::binary>>) when byte in 32..126 or byte == 9, do: ascii?(rest)
  defp ascii?(_), do: false
  defp token(value), do: value |> trim_left() |> trim_right() |> String.downcase(:ascii)
  defp trim_left(<<byte, rest::binary>>) when byte in [32, 9], do: trim_left(rest)
  defp trim_left(value), do: value
  defp trim_right(<<>>), do: ""

  defp trim_right(value) do
    if :binary.last(value) in [32, 9],
      do: trim_right(binary_part(value, 0, byte_size(value) - 1)),
      else: value
  end

  defp framing(:"HTTP/1.1", [length], []), do: canonical_length(length)

  defp framing(:"HTTP/1.1", [], [transfer]) do
    if token(transfer) == "chunked", do: {:ok, nil}, else: {:error, :unsupported_framing}
  end

  defp framing(:"HTTP/2", [], []), do: {:ok, nil}
  defp framing(:"HTTP/2", [length], []), do: canonical_length(length)
  defp framing(_, _, _), do: {:error, :unsupported_framing}

  defp canonical_length(<<first, _::binary>> = value)
       when first in ?1..?9 and byte_size(value) <= 7 do
    if digits?(value) do
      length = :erlang.binary_to_integer(value)
      if length <= @max_body, do: {:ok, length}, else: {:error, :too_large}
    else
      {:error, :unsupported_framing}
    end
  end

  defp canonical_length(_), do: {:error, :unsupported_framing}
  defp digits?(<<>>), do: true
  defp digits?(<<byte, rest::binary>>) when byte in ?0..?9, do: digits?(rest)
  defp digits?(_), do: false

  defp read(conn, declared, headers, deadline, calls, size, chunks) do
    remaining_ms = deadline - now_ms()

    remaining =
      min(@max_body - size, if(is_nil(declared), do: @max_body - size, else: declared - size))

    cond do
      remaining_ms <= 0 ->
        failure(:read_deadline, conn)

      calls >= @max_reads ->
        failure(:read_limit, conn)

      remaining <= 0 ->
        failure(:too_large, conn)

      true ->
        target = min(@read_target, remaining)

        result =
          Plug.Conn.read_body(conn,
            length: target,
            read_length: target,
            read_timeout: min(@read_ms, remaining_ms)
          )

        # Transport exceptions propagate unchanged to framework handling. Never
        # inspect/log arbitrary reasons or convert a raised read into success.
        case result do
          {tag, chunk, %Plug.Conn{} = latest} when tag in [:ok, :more] and is_binary(chunk) ->
            accept(tag, chunk, latest, declared, headers, deadline, calls + 1, size, chunks)

          {:error, _opaque_reason} ->
            failure(:transport_failure, conn)

          _ ->
            failure(:unavailable_state, conn)
        end
    end
  end

  defp accept(tag, chunk, conn, declared, headers, deadline, calls, size, chunks) do
    bytes = byte_size(chunk)
    total = size + bytes

    cond do
      now_ms() >= deadline ->
        failure(:read_deadline, conn)

      bytes > @max_body - size ->
        failure(:too_large, conn)

      not is_nil(declared) and bytes > declared - size ->
        failure(:length_mismatch, conn)

      tag == :more and bytes == 0 ->
        failure(:no_progress, conn)

      tag == :more and total == @max_body ->
        failure(:too_large, conn)

      tag == :more and total == declared ->
        failure(:length_mismatch, conn)

      tag == :more ->
        read(conn, declared, headers, deadline, calls, total, [chunk | chunks])

      total == 0 ->
        failure(:empty, conn)

      not is_nil(declared) and total != declared ->
        failure(:length_mismatch, conn)

      true ->
        body = IO.iodata_to_binary(Enum.reverse([chunk | chunks]))
        # Flattening is part of admission and cannot bypass the success deadline.
        if now_ms() < deadline do
          {:ok, %{raw_body: body, signature_header_values: headers}, conn}
        else
          failure(:read_deadline, conn)
        end
    end
  end

  defp failure(reason, conn), do: {:error, reason, Plug.Conn.halt(conn)}

  if Application.compile_env(:mixer_raw_capture_candidate, :test_build, false) do
    defp now_ms, do: MixerRawCapture.TestClock.now_ms()
  else
    defp now_ms, do: System.monotonic_time(:millisecond)
  end
end

4fade5af5d4e7f10d785d3bc0cccd05691606682 blob 4549
defmodule MixerHosted.Billing.WebhookSignature do
  @moduledoc """
  Bounded Stripe v1 signature and freshness verification over unchanged bytes.

  This pure boundary does not parse an event, deduplicate delivery, acknowledge
  HTTP, grant tenant permission or modify billing state. Callers must supply
  current endpoint-specific secrets and a trusted UTC clock on every call.
  """

  @max_time 253_402_300_799
  @tolerance 300
  @max_body 1_048_576
  @max_header 4_096
  @max_fields 32
  @max_signatures 8

  @spec verify(term(), term(), term(), term()) ::
          :ok | {:error, :invalid_signature | :verification_unavailable}
  def verify(body, headers, secrets, now) do
    if valid_secrets?(secrets) and is_integer(now) and now >= 0 and now <= @max_time do
      verify_configured(body, headers, secrets, now)
    else
      {:error, :verification_unavailable}
    end
  rescue
    # Crypto/toolchain failure must not become an authentication success.
    _ -> {:error, :verification_unavailable}
  catch
    _, _ -> {:error, :verification_unavailable}
  end

  defp valid_secrets?([one]), do: valid_secret?(one)
  defp valid_secrets?([one, two]), do: valid_secret?(one) and valid_secret?(two) and one != two
  defp valid_secrets?(_), do: false
  defp valid_secret?(secret), do: is_binary(secret) and byte_size(secret) in 16..256

  defp verify_configured(body, [header], secrets, now)
       when is_binary(body) and byte_size(body) in 1..@max_body and
              is_binary(header) and byte_size(header) in 1..@max_header do
    with true <- valid_header_bytes?(header),
         {:ok, timestamp_text, timestamp, signatures} <- parse_header(header),
         true <- abs(now - timestamp) <= @tolerance,
         true <- matches?(body, timestamp_text, signatures, secrets) do
      :ok
    else
      _ -> {:error, :invalid_signature}
    end
  end

  defp verify_configured(_, _, _, _), do: {:error, :invalid_signature}

  defp valid_header_bytes?(<<>>), do: true

  defp valid_header_bytes?(<<byte, rest::binary>>) when byte in 32..126 or byte == 9,
    do: valid_header_bytes?(rest)

  defp valid_header_bytes?(_), do: false

  defp parse_header(header) do
    fields = :binary.split(header, ",", [:global])

    if length(fields) <= @max_fields do
      case Enum.reduce_while(fields, {nil, []}, &parse_field/2) do
        {{text, timestamp}, signatures} when signatures != [] ->
          {:ok, text, timestamp, signatures}

        _ ->
          :error
      end
    else
      :error
    end
  end

  defp parse_field(field, {timestamp, signatures}) do
    case :binary.split(trim_field(field), "=") do
      ["t", text] when is_nil(timestamp) ->
        case timestamp(text) do
          {:ok, value} -> {:cont, {{text, value}, signatures}}
          :error -> {:halt, :error}
        end

      ["v1", signature] when byte_size(signature) == 64 ->
        case Base.decode16(signature, case: :mixed) do
          {:ok, bytes} when length(signatures) < @max_signatures ->
            {:cont, {timestamp, [bytes | signatures]}}

          _ ->
            {:halt, :error}
        end

      [name, value] when name not in ["t", "v1", ""] and value != "" ->
        {:cont, {timestamp, signatures}}

      _ ->
        {:halt, :error}
    end
  end

  defp trim_field(field) do
    trimmed = trim_start(field)
    trim_end(trimmed, byte_size(trimmed))
  end

  defp trim_start(<<byte, rest::binary>>) when byte in [32, 9], do: trim_start(rest)
  defp trim_start(field), do: field
  defp trim_end(_, 0), do: <<>>

  defp trim_end(field, size) do
    if :binary.at(field, size - 1) in [32, 9],
      do: trim_end(field, size - 1),
      else: binary_part(field, 0, size)
  end

  defp timestamp("0"), do: {:ok, 0}

  defp timestamp(<<first, rest::binary>> = text)
       when first in ?1..?9 and byte_size(text) <= 12 do
    if decimal?(rest) do
      value = :erlang.binary_to_integer(text)
      if value <= @max_time, do: {:ok, value}, else: :error
    else
      :error
    end
  end

  defp timestamp(_), do: :error
  defp decimal?(<<>>), do: true
  defp decimal?(<<digit, rest::binary>>) when digit in ?0..?9, do: decimal?(rest)
  defp decimal?(_), do: false

  defp matches?(body, timestamp, signatures, secrets) do
    Enum.reduce(secrets, false, fn secret, any_key ->
      expected = :crypto.mac(:hmac, :sha256, secret, [timestamp, ".", body])

      Enum.reduce(signatures, any_key, fn signature, matched ->
        equal = :crypto.hash_equals(expected, signature)
        equal or matched
      end)
    end)
  end
end

1a4df498e7d55173c1de09899b46829491fa05f9 blob 22396
defmodule MixerHosted.Billing.WebhookTransport.Sinks do
  @moduledoc "Dedicated-role sink boundary. Bootstrap and reconfiguration are trusted."
  use GenServer
  @id "mixer-private-webhook-control"
  @events for event <- [:start, :ready, :stop], do: [:thousand_island, :connection, event]
  @requests for event <- [:start, :stop, :exception], do: [:bandit, :request, event]
  @reasons [
    :none,
    :started,
    :ready,
    :request,
    :admitted,
    :rejected,
    :expired,
    :disposed,
    :owner_lost,
    :guard_lost,
    :listener_lost,
    :inventory,
    :registration,
    :capture,
    :capacity,
    :caller,
    :generation,
    :replay,
    :deadline,
    :unknown
  ]
  def start_link(approved), do: GenServer.start_link(__MODULE__, approved, name: __MODULE__)

  def events,
    do:
      @events ++
        @requests ++
        [[:thousand_island, :connection, :recv], [:thousand_island, :connection, :async_recv]]

  def init(approved) do
    Process.flag(:trap_exit, true)
    # This role permits only the explicitly installed control subscriber. Never
    # attach a second subscriber and claim it sanitizes an existing one.
    if :telemetry.list_handlers([]) != [], do: raise("unapproved telemetry subscriber")
    :ok = :telemetry.attach_many(@id, events(), &__MODULE__.control/4, nil)
    handlers = :logger.get_handler_config()
    allowed = Map.merge(%{default: :logger_std_h, ssl_handler: :logger_std_h}, approved)

    if handlers == [] or Enum.any?(handlers, &(Map.get(allowed, &1.id) != &1.module)),
      do: raise("unapproved logger handler")

    primary = :logger.get_primary_config()

    unless primary.metadata == %{} and Enum.all?(primary.filters, &approved_primary?/1),
      do: raise("unapproved primary callback")

    for handler <- handlers do
      :ok =
        :logger.set_handler_config(
          handler.id,
          :formatter,
          {:logger_formatter, %{template: [:msg, ~c"\n"]}}
        )

      expected = {&__MODULE__.filter/2, nil}

      unless Enum.all?(handler.filters, &approved_handler?/1),
        do: raise("unapproved handler callback")

      case Keyword.get(handler.filters, :mixer_private_schema) do
        nil ->
          :ok =
            :logger.add_handler_filter(
              handler.id,
              :mixer_private_schema,
              {&__MODULE__.filter/2, nil}
            )

        ^expected ->
          :ok

        _ ->
          raise("unapproved owned filter")
      end
    end

    {:ok, %{inventory: inventory(), original_handlers: handlers, counters: %{}, safe: []}}
  end

  defp identity(fun),
    do:
      {:erlang.fun_info(fun, :module), :erlang.fun_info(fun, :name), :erlang.fun_info(fun, :type)}

  defp approved_primary?(
         {:logger_translator,
          {fun, %{otp: true, sasl: false, translators: [{Logger.Translator, :translate}]}}}
       ),
       do: identity(fun) == {{:module, Logger.Utils}, {:name, :translator}, {:type, :external}}

  defp approved_primary?({:logger_process_level, {fun, []}}),
    do: identity(fun) == {{:module, Logger.Utils}, {:name, :process_level}, {:type, :external}}

  defp approved_primary?(_), do: false

  defp approved_handler?({:remote_gl, {fun, :stop}}),
    do: identity(fun) == {{:module, :logger_filters}, {:name, :remote_gl}, {:type, :external}}

  defp approved_handler?({:filter_non_ssl, {fun, {:log, :sub, [:otp, :ssl]}}}),
    do: identity(fun) == {{:module, :logger_filters}, {:name, :domain}, {:type, :external}}

  defp approved_handler?({:mixer_private_schema, {fun, nil}}), do: fun == (&__MODULE__.filter/2)
  defp approved_handler?(_), do: false

  def inventory,
    do: %{
      telemetry: :telemetry.list_handlers([]),
      logger: :logger.get_handler_config(),
      primary: :logger.get_primary_config()
    }

  def valid?, do: GenServer.call(__MODULE__, :valid, 500)
  def snapshot, do: GenServer.call(__MODULE__, :snapshot)
  def record(reason) when reason in @reasons, do: GenServer.cast(__MODULE__, {:record, reason})
  def handle_call(:valid, _, state), do: {:reply, inventory() == state.inventory, state}
  def handle_call(:snapshot, _, state), do: {:reply, Map.take(state, [:safe, :counters]), state}

  def handle_cast({:record, reason}, state) do
    count = min(Map.get(state.counters, reason, 0) + 1, 2_147_483_647)
    safe = %{event: :webhook_transport, reason: reason, count: count}

    :logger.log(:notice, %{
      mixer_transport: 1,
      event: :webhook_transport,
      reason: reason,
      count: count
    })

    {:noreply,
     %{
       state
       | counters: Map.put(state.counters, reason, count),
         safe: Enum.take([safe | state.safe], 256)
     }}
  end

  def filter(
        %{
          msg:
            {:report,
             %{mixer_transport: 1, event: :webhook_transport, reason: reason, count: count} =
               report}
        },
        _
      )
      when reason in @reasons and is_integer(count) and count >= 0 and count <= 2_147_483_647 and
             map_size(report) == 4 do
    # Reconstruct both message and metadata. No original term is forwarded.
    %{
      level: :notice,
      msg: {:report, %{event: :webhook_transport, reason: reason, count: count}},
      meta: %{domain: [:mixer_private_transport]}
    }
  end

  def filter(_, _), do: :stop

  def control(event, measurements, metadata, _) do
    # Only documented references, fixed plug identity and monotonic timestamps
    # cross into the owner. No data/conn/header/error/stacktrace term is retained.
    try do
      unless valid?(), do: throw(:inventory)

      case event do
        [:thousand_island, :connection, :start] ->
          started = System.convert_time_unit(measurements.monotonic_time, :native, :millisecond)

          :ok =
            MixerHosted.Billing.WebhookTransport.Owner.register(
              self(),
              metadata.telemetry_span_context,
              started
            )

        [:thousand_island, :connection, :ready] ->
          :ok =
            MixerHosted.Billing.WebhookTransport.Owner.ready(
              self(),
              metadata.telemetry_span_context,
              System.convert_time_unit(measurements.monotonic_time, :native, :millisecond)
            )

        [:bandit, :request, :start] ->
          started = System.convert_time_unit(measurements.monotonic_time, :native, :millisecond)

          {:ok, permit} =
            MixerHosted.Billing.WebhookTransport.Owner.request(
              self(),
              metadata.connection_telemetry_span_context,
              metadata.plug,
              started
            )

          Process.put({MixerHosted.Billing.WebhookTransport, :permit}, permit)

        _ ->
          :ok
      end
    rescue
      _ -> fail(:registration)
    catch
      _, reason -> fail(if(reason == :inventory, do: :inventory, else: :registration))
    end
  end

  defp fail(reason) do
    # Do not throw out of a telemetry callback: telemetry catches/detaches it.
    # The role is explicitly stopped, and this emitting owner cannot parse/read.
    if owner = Process.whereis(MixerHosted.Billing.WebhookTransport.Owner),
      do: GenServer.cast(owner, {:trip, reason})

    Process.exit(self(), :kill)
  end

  def terminate(_, _) do
    :telemetry.detach(@id)
    # Dedicated BEAM sinks remain protected through supervisor crash reports and
    # VM shutdown. Removing filters during role teardown would reopen the sink.
    :ok
  end
end

defmodule MixerHosted.Billing.WebhookTransport.Guard do
  @moduledoc false
  use GenServer
  def start_link(opts), do: GenServer.start_link(__MODULE__, opts)

  def child_spec(opts),
    do: %{id: make_ref(), start: {__MODULE__, :start_link, [opts]}, restart: :temporary}

  def init({owner, connection, span, generation, started}) do
    Process.flag(:trap_exit, true)
    refs = %{Process.monitor(connection) => connection, Process.monitor(owner) => owner}
    deadline = min(started + 1_000, started + 7_000)
    token = make_ref()
    timer = Process.send_after(self(), {:deadline, generation, token}, deadline, abs: true)

    {:ok,
     %{
       owner: owner,
       connection: connection,
       span: span,
       generation: generation,
       started: started,
       outer: started + 7_000,
       deadline: deadline,
       token: token,
       timer: timer,
       refs: refs,
       requests: [],
       disposed: false
     }}
  end

  def handle_call(
        {:stage, generation, deadline, request},
        _,
        %{generation: generation, disposed: false} = state
      ) do
    Process.cancel_timer(state.timer)
    deadline = min(deadline, state.outer)
    token = make_ref()

    refs =
      if is_pid(request) and request != state.connection and request not in state.requests,
        do: Map.put(state.refs, Process.monitor(request), request),
        else: state.refs

    timer = Process.send_after(self(), {:deadline, generation, token}, deadline, abs: true)
    requests = if is_pid(request), do: Enum.uniq([request | state.requests]), else: state.requests

    {:reply, :ok,
     %{state | deadline: deadline, timer: timer, token: token, refs: refs, requests: requests}}
  end

  def handle_call(_, _, state), do: {:reply, {:error, :generation}, state}
  def handle_cast({:dispose, reason}, state), do: {:noreply, kill(state, reason)}

  def handle_info({:deadline, generation, token}, %{generation: generation, token: token} = state) do
    if now() >= state.deadline do
      {:noreply, kill(state, :expired)}
    else
      timer =
        Process.send_after(self(), {:deadline, generation, token}, state.deadline, abs: true)

      {:noreply, %{state | timer: timer}}
    end
  end

  def handle_info({:DOWN, ref, :process, pid, _}, state) do
    refs = Map.delete(state.refs, ref)
    state = %{state | refs: refs}

    state =
      cond do
        pid == state.owner ->
          kill(state, :owner_lost)

        pid == state.connection ->
          for request <- state.requests, Process.alive?(request), do: Process.exit(request, :kill)
          state

        pid in state.requests and Process.alive?(state.connection) ->
          kill(state, :disposed)

        true ->
          state
      end

    remaining = Enum.reject(Map.values(refs), &(&1 == state.owner))

    if remaining == [] do
      Process.cancel_timer(state.timer)

      send(
        state.owner,
        {:disposed, state.span, state.generation, self(), now(), state.deadline, state.disposed}
      )

      {:stop, :normal, state}
    else
      {:noreply, state}
    end
  end

  def handle_info(_, state), do: {:noreply, state}

  defp kill(state, reason) do
    if Process.alive?(state.connection), do: Process.exit(state.connection, :kill)
    MixerHosted.Billing.WebhookTransport.Sinks.record(reason)
    %{state | disposed: reason}
  end

  def terminate(_, state) do
    Process.cancel_timer(state.timer)
    if Process.alive?(state.connection), do: Process.exit(state.connection, :kill)
    for p <- state.requests, Process.alive?(p), do: Process.exit(p, :kill)
    :ok
  end

  defp now, do: System.monotonic_time(:millisecond)
end

defmodule MixerHosted.Billing.WebhookTransport.Owner do
  @moduledoc false
  use GenServer
  alias MixerHosted.Billing.WebhookTransport.{Guard, Sinks}
  def start_link(plug), do: GenServer.start_link(__MODULE__, plug, name: __MODULE__)

  def register(pid, span, started),
    do: GenServer.call(__MODULE__, {:register, pid, span, started}, 500)

  def ready(pid, span, ready_at),
    do: GenServer.call(__MODULE__, {:ready, pid, span, ready_at}, 500)

  def request(pid, span, plug, started),
    do: GenServer.call(__MODULE__, {:request, pid, span, plug, started}, 500)

  def check(permit, phase), do: GenServer.call(__MODULE__, {:check, permit, phase}, 500)
  def dispose(permit), do: GenServer.cast(__MODULE__, {:dispose, permit})
  def snapshot, do: GenServer.call(__MODULE__, :snapshot)

  def init(plug) do
    Process.flag(:trap_exit, true)
    Process.send_after(self(), :inventory, 25)

    {:ok,
     %{
       plug: {plug, []},
       generation: make_ref(),
       connections: %{},
       permits: %{},
       guards: %{},
       history: [],
       peak: 0
     }}
  end

  def handle_call({:register, pid, span, started}, {pid, _}, state)
      when is_reference(span) and is_integer(started) do
    cond do
      not Sinks.valid?() ->
        {:stop, :inventory, {:error, :inventory}, state}

      map_size(state.connections) >= 16 ->
        Process.exit(pid, :kill)
        Sinks.record(:capacity)
        {:reply, {:error, :capacity}, state}

      Map.has_key?(state.connections, span) or now() >= started + 1_000 ->
        Process.exit(pid, :kill)
        {:reply, {:error, :deadline}, state}

      true ->
        generation = make_ref()

        {:ok, guard} =
          DynamicSupervisor.start_child(
            MixerHosted.Billing.WebhookTransport.Guards,
            {Guard, {self(), pid, span, generation, started}}
          )

        ref = Process.monitor(guard)

        item = %{
          pid: pid,
          guard: guard,
          generation: generation,
          outer: started + 7_000,
          deadline: started + 1_000,
          stage: :handshake
        }

        connections = Map.put(state.connections, span, item)
        Sinks.record(:started)

        {:reply, :ok,
         %{
           state
           | connections: connections,
             guards: Map.put(state.guards, ref, span),
             peak: max(state.peak, map_size(connections))
         }}
    end
  end

  def handle_call({:ready, pid, span, ready_at}, {pid, _}, state) do
    case state.connections[span] do
      %{pid: ^pid, stage: :handshake} = c ->
        if now() >= c.deadline, do: Process.exit(pid, :kill)
        deadline = min(ready_at + 1_000, c.outer)
        :ok = GenServer.call(c.guard, {:stage, c.generation, deadline, nil}, 500)

        {:reply, :ok,
         put_in(state, [:connections, span], %{c | stage: :headers, deadline: deadline})}

      _ ->
        {:stop, :registration, {:error, :registration}, state}
    end
  end

  def handle_call({:request, pid, span, plug, started}, {pid, _}, state) do
    case state.connections[span] do
      %{stage: :headers} = c when plug == state.plug ->
        deadline = min(started + 5_000, c.outer)

        if Sinks.valid?() and now() < c.deadline and now() < deadline do
          :ok = GenServer.call(c.guard, {:stage, c.generation, deadline, pid}, 500)
          token = make_ref()
          permit = {state.generation, c.generation, token}

          entry = %{
            pid: pid,
            span: span,
            deadline: deadline,
            state: :issued,
            generation: c.generation
          }

          state = %{state | permits: Map.put(state.permits, token, entry)}
          state = put_in(state, [:connections, span, :stage], :request)
          Sinks.record(:request)
          {:reply, {:ok, permit}, state}
        else
          GenServer.cast(c.guard, {:dispose, :deadline})
          {:reply, {:error, :deadline}, state}
        end

      _ ->
        {:stop, :registration, {:error, :registration}, state}
    end
  end

  def handle_call({:check, {generation, connection_generation, token}, phase}, {caller, _}, state) do
    entry = state.permits[token]

    reason =
      cond do
        not Sinks.valid?() -> :inventory
        generation != state.generation -> :generation
        is_nil(entry) -> :unknown
        entry.generation != connection_generation -> :generation
        entry.pid != caller -> :caller
        now() >= entry.deadline -> :deadline
        phase == :begin and entry.state == :issued -> :none
        phase == :finish and entry.state == :capturing -> :none
        true -> :replay
      end

    if reason == :none do
      next = if phase == :begin, do: :capturing, else: :consumed
      state = put_in(state, [:permits, token, :state], next)

      if next == :consumed do
        c = state.connections[entry.span]
        :ok = GenServer.call(c.guard, {:stage, c.generation, c.outer, nil}, 500)
        Sinks.record(:admitted)
      end

      if now() < entry.deadline do
        {:reply, if(phase == :finish, do: {:ok, entry.deadline}, else: :ok), state}
      else
        deny(caller, entry, state, :deadline)
        {:reply, {:error, :deadline}, state}
      end
    else
      deny(caller, entry, state, reason)

      if reason == :inventory,
        do: {:stop, :inventory, {:error, reason}, state},
        else: {:reply, {:error, reason}, state}
    end
  end

  def handle_call({:check, _, _}, {caller, _}, state) do
    deny(caller, nil, state, :unknown)
    {:reply, {:error, :unknown}, state}
  end

  def handle_call(:snapshot, _, state),
    do:
      {:reply,
       %{
         connections: map_size(state.connections),
         permits: map_size(state.permits),
         peak: state.peak,
         history: Enum.reverse(state.history)
       }, state}

  def handle_cast({:dispose, {_, _, token}}, state) do
    if entry = state.permits[token],
      do: GenServer.cast(state.connections[entry.span].guard, {:dispose, :disposed})

    {:noreply, state}
  end

  def handle_cast({:trip, reason}, state), do: {:stop, reason, state}

  def handle_info({:disposed, span, generation, guard, ended, deadline, reason}, state) do
    case state.connections[span] do
      %{generation: ^generation, guard: ^guard} ->
        permits = Map.reject(state.permits, fn {_, entry} -> entry.span == span end)

        history =
          Enum.take(
            [
              %{
                reason: reason,
                ended: ended,
                deadline: deadline,
                overshoot_ms: max(ended - deadline, 0)
              }
              | state.history
            ],
            512
          )

        {:noreply,
         %{
           state
           | connections: Map.delete(state.connections, span),
             permits: permits,
             history: history
         }}

      _ ->
        {:noreply, state}
    end
  end

  def handle_info({:DOWN, ref, :process, _, reason}, state) do
    {span, guards} = Map.pop(state.guards, ref)

    if span && Map.has_key?(state.connections, span) do
      Process.exit(state.connections[span].pid, :kill)
      {:stop, :guard_lost, %{state | guards: guards}}
    else
      _ = reason
      {:noreply, %{state | guards: guards}}
    end
  end

  def handle_info(:inventory, state) do
    if Sinks.valid?() do
      Process.send_after(self(), :inventory, 25)
      {:noreply, state}
    else
      {:stop, :inventory, state}
    end
  end

  def handle_info(_, state), do: {:noreply, state}

  def terminate(_, state) do
    for {_, c} <- state.connections, do: Process.exit(c.pid, :kill)
    :ok
  end

  defp deny(caller, entry, state, reason) do
    entries =
      if entry, do: [entry], else: Enum.filter(Map.values(state.permits), &(&1.pid == caller))

    for e <- entries,
        c = state.connections[e.span],
        not is_nil(c),
        do: GenServer.cast(c.guard, {:dispose, reason})
  end

  defp now, do: System.monotonic_time(:millisecond)
end

defmodule MixerHosted.Billing.WebhookTransport do
  @moduledoc "Private dedicated-role transport candidate. No public route or billing authority."
  use Supervisor
  alias __MODULE__.{Owner, Sinks}

  def start_link(plug, approved_handlers \\ %{}),
    do: Supervisor.start_link(__MODULE__, {plug, approved_handlers})

  def init({plug, approved_handlers}) do
    # Fixed profile; no request-selected policy or per-request timeout knobs.
    listener =
      {Bandit,
       [
         plug: plug,
         ip: {127, 0, 0, 1},
         port: 0,
         startup_log: false,
         http_options: [
           log_protocol_errors: false,
           log_client_closures: false,
           log_exceptions_with_status_codes: []
         ],
         http_1_options: [
           max_request_line_length: 512,
           max_header_length: 8_192,
           max_header_count: 32,
           max_requests: 1,
           log_unknown_messages: false
         ],
         http_2_options: [
           max_header_block_size: 16_384,
           max_requests: 1,
           max_reset_stream_rate: {16, 1_000},
           default_local_settings: [
             max_header_list_size: 16_384,
             header_table_size: 4_096,
             max_frame_size: 16_384,
             max_concurrent_streams: 1
           ]
         ],
         thousand_island_options: [
           num_acceptors: 1,
           num_connections: 16,
           max_connections_retry_count: 0,
           read_timeout: 1_000,
           handshake_timeout: 1_000,
           shutdown_timeout: 1_000,
           transport_options: [backlog: 128]
         ]
       ]}

    Supervisor.init(
      [
        {Sinks, approved_handlers},
        {DynamicSupervisor, name: __MODULE__.Guards, strategy: :one_for_one},
        {Owner, plug},
        listener
      ],
      strategy: :one_for_all,
      max_restarts: 0
    )
  end

  def capture(conn) do
    permit = Process.get({__MODULE__, :permit})

    with :ok <- Owner.check(permit, :begin) do
      case MixerHosted.Billing.RawWebhookCapture.capture(conn) do
        {:ok, captured, latest} ->
          case Owner.check(permit, :finish) do
            {:ok, deadline} ->
              if System.monotonic_time(:millisecond) < deadline do
                {:ok, captured, latest}
              else
                Owner.dispose(permit)
                {:error, :read_deadline, Plug.Conn.halt(latest)}
              end

            {:error, _} ->
              Owner.dispose(permit)
              {:error, :unavailable_state, Plug.Conn.halt(latest)}
          end

        {:error, reason, latest} ->
          # Dispose after private error response, with the independent deadline
          # active. Caller's fixed private plug must always execute dispose/0.
          Sinks.record(:rejected)
          {:error, reason, latest}
      end
    else
      _ -> {:error, :unavailable_state, Plug.Conn.halt(conn)}
    end
  rescue
    _ ->
      dispose()
      reraise RuntimeError, [message: "private transport capture failure"], []
  catch
    kind, _ ->
      dispose()
      :erlang.raise(kind, :private_transport_failure, [])
  end

  def dispose do
    if permit = Process.get({__MODULE__, :permit}), do: Owner.dispose(permit)
    :ok
  end
end

81501aa707fdd1059044952f7c202ddd505fa720 blob 2543
defmodule MixerHosted.BrowserAuth.ActivationPreparation do
  @moduledoc """
  Decodes the closed activation-preparation projection into provisional metadata.

  A successful decode proves shape only. It does not establish database
  provenance, freshness, authentication, authorization or a binding to the
  owner-retained claim, current verified identity or configuration. Those
  comparisons belong to the future trusted lifecycle owner. Never log inputs.
  """
  alias MixerHosted.BrowserAuth.StoredSnapshot

  @derive {Inspect, only: []}
  @enforce_keys [
    :version,
    :snapshot,
    :principal_id,
    :profile_revision,
    :binding_revision,
    :principal_revision
  ]
  defstruct @enforce_keys

  @type t :: %__MODULE__{
          version: 1,
          snapshot: %StoredSnapshot{},
          principal_id: String.t(),
          profile_revision: pos_integer(),
          binding_revision: pos_integer(),
          principal_revision: pos_integer()
        }

  @fields ~w(version snapshot principal_id profile_revision binding_revision principal_revision)
  @revision_fields ~w(profile_revision binding_revision principal_revision)
  @max_integer 9_007_199_254_740_991
  @error {:error, :session_unavailable}

  @doc "Validates exactly six string keys and retains the complete claimed StoredSnapshot."
  @spec decode(term()) :: {:ok, t()} | {:error, :session_unavailable}
  def decode(input) do
    with true <- exact?(input),
         1 <- input["version"],
         true <- text?(input["principal_id"]),
         true <- Enum.all?(@revision_fields, &positive?(input[&1])),
         {:ok,
          %StoredSnapshot{attempt: %{"status" => "claimed"}, attempt_envelope: nil} = snapshot} <-
           StoredSnapshot.decode(input["snapshot"]) do
      {:ok,
       %__MODULE__{
         version: 1,
         snapshot: snapshot,
         principal_id: input["principal_id"],
         profile_revision: input["profile_revision"],
         binding_revision: input["binding_revision"],
         principal_revision: input["principal_revision"]
       }}
    else
      _ -> @error
    end
  rescue
    _ -> @error
  catch
    _, _ -> @error
  end

  defp exact?(input),
    do:
      is_map(input) and map_size(input) == length(@fields) and
        Enum.all?(@fields, &Map.has_key?(input, &1))

  defp positive?(value), do: is_integer(value) and value in 1..@max_integer

  defp text?(value),
    do:
      is_binary(value) and byte_size(value) in 1..128 and String.valid?(value) and
        :binary.match(value, <<0>>) == :nomatch
end

0a1c622d85ec0a15bb1070e133d2f43e8753a78c blob 19706
defmodule MixerHosted.BrowserAuth.ActivationPreparationSchema do
  @moduledoc """
  Opt-in additive SQL prerequisite for provisional activation preparation.

  This does not alter StorageSchema, install a migration, enable a route, or
  provide combined version-2 catalog admission. A reviewed operator installs
  `statements/0`, then separately selects the upgrade-only provisioning plan.
  Preparation metadata is never authentication or a durable authority ticket.
  """
  @name "mixer_browser_prepare_activation"
  @signature "bytea,bytea,bytea,bytea,bigint,public.mixer_browser_access_evidence"
  @type_name "mixer_browser_access_evidence"
  @fields [
    {"profile_id", "text"},
    {"profile_version", "integer"},
    {"issuer", "text"},
    {"subject", "text"},
    {"client_id", "text"},
    {"credential_ref", "text"},
    {"issued_at", "bigint"},
    {"expires_at", "bigint"},
    {"scopes", "text[]"}
  ]
  @decoder_source Path.expand("activation_preparation.ex", __DIR__)
  @external_resource @decoder_source
  @decoder_sha256 :crypto.hash(:sha256, File.read!(@decoder_source))
                  |> Base.encode16(case: :lower)
  @settings [
    "search_path=pg_catalog",
    "statement_timeout=5s",
    "lock_timeout=500ms",
    "idle_in_transaction_session_timeout=5s",
    "bytea_output=hex"
  ]

  def signatures, do: %{@name => @signature}
  def public_signatures, do: signatures()

  @doc "Partial version-2 addition only; no complete admission consumer is supplied."
  def catalog_manifest do
    [_, body, _] = String.split(function(), "$preparation$")

    %{
      version: 2,
      baseline_version: 1,
      additive_only: true,
      functions: %{
        @name => %{
          signature: @signature,
          source: body,
          returns: "jsonb",
          argument_names: ~w(p_cookie p_state p_config p_claim p_revision i),
          settings: @settings,
          security_definer: true,
          runtime_execute: true
        }
      },
      composites: %{@type_name => @fields},
      decoder: %{
        module: "MixerHosted.BrowserAuth.ActivationPreparation",
        source_sha256: @decoder_sha256
      }
    }
  end

  @doc "Inert installation only; PUBLIC gets neither execution nor type usage."
  def statements do
    [
      "CREATE TYPE public.#{@type_name} AS (" <>
        Enum.map_join(@fields, ",", fn {name, type} -> name <> " " <> type end) <> ")",
      function(),
      "REVOKE ALL ON FUNCTION public.#{@name}(#{@signature}) FROM PUBLIC",
      "REVOKE ALL ON TYPE public.#{@type_name} FROM PUBLIC"
    ]
  end

  @doc "Upgrade existing roles only. Execute the returned transaction without omission/reordering."
  def provisioning_statements(writer_role, lifecycle_login, relation_owner) do
    writer = role!(writer_role)
    login = role!(lifecycle_login)
    owner = role!(relation_owner)

    if length(Enum.uniq([writer, login, owner])) != 3,
      do: raise(ArgumentError, "distinct lifecycle roles required")

    [
      "BEGIN",
      "SET LOCAL statement_timeout='5s'",
      "SET LOCAL lock_timeout='500ms'",
      "SET LOCAL idle_in_transaction_session_timeout='5s'",
      provisioning_preflight(writer, login, owner),
      "GRANT CREATE ON SCHEMA public TO #{writer}",
      "ALTER FUNCTION public.#{@name}(#{@signature}) OWNER TO #{writer}",
      "REVOKE CREATE ON SCHEMA public FROM #{writer}",
      "ALTER TYPE public.#{@type_name} OWNER TO #{owner}",
      "GRANT USAGE ON TYPE public.#{@type_name} TO #{writer}, #{login}",
      "GRANT EXECUTE ON FUNCTION public.#{@name}(#{@signature}) TO #{login}",
      """
      DO $finish$
      DECLARE w oid:='#{writer}'::pg_catalog.regrole;
        l oid:='#{login}'::pg_catalog.regrole; o oid:='#{owner}'::pg_catalog.regrole;
      BEGIN
        IF pg_catalog.has_schema_privilege(w,'public','CREATE')
          OR (SELECT proowner FROM pg_catalog.pg_proc WHERE oid='public.#{@name}(#{@signature})'::pg_catalog.regprocedure) IS DISTINCT FROM w
          OR (SELECT typowner FROM pg_catalog.pg_type WHERE oid='public.#{@type_name}'::pg_catalog.regtype) IS DISTINCT FROM o
          OR (SELECT count(*)<>2 OR count(DISTINCT grantee)<>2 OR
                bool_or(grantor<>w OR grantee NOT IN(w,l) OR privilege_type<>'EXECUTE' OR is_grantable)
              FROM pg_catalog.aclexplode(COALESCE(
                (SELECT proacl FROM pg_catalog.pg_proc WHERE oid='public.#{@name}(#{@signature})'::pg_catalog.regprocedure),
                pg_catalog.acldefault('f',w))))
          OR (SELECT count(*)<>3 OR count(DISTINCT grantee)<>3 OR
                bool_or(grantor<>o OR grantee NOT IN(o,w,l) OR privilege_type<>'USAGE' OR is_grantable)
              FROM pg_catalog.aclexplode(COALESCE(
                (SELECT typacl FROM pg_catalog.pg_type WHERE oid='public.#{@type_name}'::pg_catalog.regtype),
                pg_catalog.acldefault('T',o)))) THEN
          RAISE EXCEPTION 'browser preparation provisioning denied' USING ERRCODE='42501';
        END IF;
      END $finish$;
      """,
      "COMMIT"
    ]
  end

  @doc "Remove this addition only; never replay baseline rollback/provisioning."
  def rollback_statements do
    [
      "DROP FUNCTION public.#{@name}(#{@signature})",
      "DROP TYPE public.#{@type_name}"
    ]
  end

  defp role!(name) when is_binary(name) and byte_size(name) in 1..63 do
    valid =
      name != "public" and not String.starts_with?(name, "pg_") and
        name
        |> :binary.bin_to_list()
        |> Enum.with_index()
        |> Enum.all?(fn {c, i} -> c in ?a..?z or c == ?_ or (i > 0 and c in ?0..?9) end)

    if valid, do: name, else: raise(ArgumentError, "restricted role identifier required")
  end

  defp role!(_), do: raise(ArgumentError, "restricted role identifier required")

  defp provisioning_preflight(writer, login, owner) do
    """
    DO $upgrade$
    DECLARE w pg_catalog.pg_roles; l pg_catalog.pg_roles; o pg_catalog.pg_roles;
    BEGIN
      SELECT * INTO STRICT w FROM pg_catalog.pg_roles WHERE rolname='#{writer}';
      SELECT * INTO STRICT l FROM pg_catalog.pg_roles WHERE rolname='#{login}';
      SELECT * INTO STRICT o FROM pg_catalog.pg_roles WHERE rolname='#{owner}';
      IF w.rolcanlogin OR NOT l.rolcanlogin OR o.rolcanlogin
        OR w.rolsuper OR w.rolbypassrls OR w.rolcreaterole OR w.rolcreatedb OR w.rolreplication OR w.rolinherit
        OR l.rolsuper OR l.rolbypassrls OR l.rolcreaterole OR l.rolcreatedb OR l.rolreplication OR l.rolinherit
        OR o.rolsuper OR o.rolbypassrls OR o.rolcreaterole OR o.rolcreatedb OR o.rolreplication OR o.rolinherit
        OR EXISTS(SELECT 1 FROM pg_catalog.pg_auth_members WHERE member IN(w.oid,l.oid,o.oid) OR roleid IN(w.oid,l.oid,o.oid))
        OR EXISTS(SELECT 1 FROM pg_catalog.pg_namespace WHERE
          pg_catalog.has_schema_privilege(w.oid,oid,'CREATE') OR pg_catalog.has_schema_privilege(l.oid,oid,'CREATE'))
        OR NOT pg_catalog.has_schema_privilege(w.oid,'public','USAGE')
        OR NOT pg_catalog.has_schema_privilege(l.oid,'public','USAGE')
        OR EXISTS(SELECT 1 FROM pg_catalog.pg_class WHERE relowner IN(w.oid,l.oid))
        OR EXISTS(SELECT 1 FROM pg_catalog.pg_namespace WHERE nspowner IN(w.oid,l.oid))
        OR EXISTS(SELECT 1 FROM pg_catalog.pg_database WHERE datdba IN(w.oid,l.oid))
        OR EXISTS(SELECT 1 FROM pg_catalog.pg_database WHERE datname=pg_catalog.current_database()
          AND (pg_catalog.has_database_privilege(w.oid,oid,'CREATE') OR pg_catalog.has_database_privilege(l.oid,oid,'CREATE')))
        OR EXISTS(SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
          WHERE n.nspname='public' AND c.relkind IN('r','p','v','m','f') AND
            (pg_catalog.has_table_privilege(l.oid,c.oid,'SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER')
             OR pg_catalog.has_any_column_privilege(l.oid,c.oid,'SELECT,INSERT,UPDATE,REFERENCES')))
        OR (SELECT count(*) FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
          WHERE n.nspname='public' AND c.relname IN('mixer_browser_sessions','mixer_browser_session_vault','mixer_browser_oidc_attempts','mixer_browser_session_events')
            AND c.relowner=o.oid AND c.relrowsecurity AND c.relforcerowsecurity)<>4
        OR (SELECT count(*) FROM pg_catalog.pg_type t JOIN pg_catalog.pg_namespace n ON n.oid=t.typnamespace
          WHERE n.nspname='public' AND t.typname IN('mixer_browser_cipher','mixer_browser_attempt','mixer_browser_verified') AND t.typowner=o.oid
            AND pg_catalog.has_type_privilege(w.oid,t.oid,'USAGE') AND pg_catalog.has_type_privilege(l.oid,t.oid,'USAGE'))<>3
        OR (SELECT count(*) FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace
          WHERE n.nspname='public' AND pg_catalog.left(p.proname::text,14)='mixer_browser_' AND p.proname<>'#{@name}' AND p.proowner=w.oid)<>18
        OR (SELECT count(*) FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace
          WHERE n.nspname='public' AND pg_catalog.left(p.proname::text,14)='mixer_browser_' AND p.proname<>'#{@name}'
            AND pg_catalog.has_function_privilege(l.oid,p.oid,'EXECUTE'))<>9
        OR (SELECT typowner FROM pg_catalog.pg_type WHERE oid='public.#{@type_name}'::pg_catalog.regtype)<>o.oid
        OR (SELECT proowner FROM pg_catalog.pg_proc WHERE oid='public.#{@name}(#{@signature})'::pg_catalog.regprocedure)<>o.oid
        OR (SELECT count(*)<>1 OR bool_or(grantor<>o.oid OR grantee<>o.oid OR privilege_type<>'EXECUTE' OR is_grantable)
            FROM pg_catalog.aclexplode(COALESCE(
              (SELECT proacl FROM pg_catalog.pg_proc WHERE oid='public.#{@name}(#{@signature})'::pg_catalog.regprocedure),
              pg_catalog.acldefault('f',o.oid))))
        OR (SELECT count(*)<>1 OR bool_or(grantor<>o.oid OR grantee<>o.oid OR privilege_type<>'USAGE' OR is_grantable)
            FROM pg_catalog.aclexplode(COALESCE(
              (SELECT typacl FROM pg_catalog.pg_type WHERE oid='public.#{@type_name}'::pg_catalog.regtype),
              pg_catalog.acldefault('T',o.oid))))
      THEN RAISE EXCEPTION 'browser preparation provisioning denied' USING ERRCODE='42501'; END IF;
    END $upgrade$;
    """
  end

  defp function do
    """
    CREATE FUNCTION public.#{@name}(p_cookie bytea,p_state bytea,p_config bytea,p_claim bytea,p_revision bigint,i public.mixer_browser_access_evidence) RETURNS jsonb
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path=pg_catalog SET statement_timeout='5s'
    SET lock_timeout='500ms' SET idle_in_transaction_session_timeout='5s' SET bytea_output='hex'
    AS $preparation$
    DECLARE r record; b public.mixer_browser_sessions; v public.mixer_browser_session_vault;
      a public.mixer_browser_oidc_attempts; p public.mixer_authz_profiles;
      binding public.mixer_authz_bindings; principal public.mixer_authz_principals;
      entered bigint; finished bigint; scope text; seen text[]:=ARRAY[]::text[]; scope_bytes integer:=0;
    BEGIN
      entered:=pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint;
      IF p_cookie IS NULL OR octet_length(p_cookie)<>32 OR p_state IS NULL OR octet_length(p_state)<>32
        OR p_config IS NULL OR octet_length(p_config)<>32 OR p_claim IS NULL OR octet_length(p_claim)<>32
        OR p_revision IS NULL OR p_revision NOT BETWEEN 1 AND 9007199254740991
        OR i.profile_id IS NULL OR octet_length(i.profile_id) NOT BETWEEN 1 AND 128
        OR i.profile_version IS NULL OR i.profile_version<=0
        OR i.issuer IS NULL OR octet_length(i.issuer) NOT BETWEEN 1 AND 2048
        OR i.subject IS NULL OR octet_length(i.subject) NOT BETWEEN 1 AND 256
        OR i.client_id IS NULL OR octet_length(i.client_id) NOT BETWEEN 1 AND 256
        OR i.credential_ref IS NULL OR octet_length(i.credential_ref) NOT BETWEEN 1 AND 256
        OR i.issued_at IS NULL OR i.issued_at NOT BETWEEN 0 AND 9007199254740991 OR i.issued_at>entered+30
        OR i.expires_at IS NULL OR i.expires_at NOT BETWEEN 0 AND 9007199254740991
        OR i.expires_at<=GREATEST(entered,i.issued_at) OR i.expires_at-i.issued_at>900
        OR i.scopes IS NULL OR pg_catalog.array_ndims(i.scopes) IS DISTINCT FROM 1
        OR pg_catalog.array_lower(i.scopes,1) IS DISTINCT FROM 1 OR pg_catalog.cardinality(i.scopes) NOT BETWEEN 1 AND 64
        OR ('mixer.workspace.read'=ANY(i.scopes)) IS NOT TRUE
      THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
      -- PostgreSQL UTF8 text cannot contain NUL. These bounded parameter-only
      -- checks do not read relations or create an additional MVCC snapshot.
      FOREACH scope IN ARRAY i.scopes LOOP
        IF scope IS NULL OR octet_length(scope) NOT BETWEEN 1 AND 1024
          OR scope ~ '[^!#-~]' OR pg_catalog.strpos(scope,pg_catalog.chr(92))>0 OR scope=ANY(seen)
        THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
        scope_bytes:=scope_bytes+octet_length(scope)+1;
        IF scope_bytes>1025 THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
        seen:=pg_catalog.array_append(seen,scope);
      END LOOP;
      -- Every relation and the exact JSON projection share this one statement
      -- snapshot. Unique indexes bound each join; LIMIT 2 + STRICT denies extras.
      SELECT s AS browser,sv AS vault,oa AS attempt,ap AS profile,ab AS binding,pr AS principal,
        pg_catalog.jsonb_build_object('browser',pg_catalog.to_jsonb(s),'vault',pg_catalog.to_jsonb(sv),'attempt',pg_catalog.to_jsonb(oa)) AS snapshot
      INTO STRICT r
      FROM public.mixer_browser_sessions s
      JOIN public.mixer_browser_session_vault sv ON sv.browser_id=s.id
      JOIN public.mixer_browser_oidc_attempts oa ON oa.state_digest=p_state AND oa.browser_id=s.id
      LEFT JOIN public.mixer_authz_profiles ap ON ap.id=i.profile_id AND ap.version=i.profile_version
      LEFT JOIN public.mixer_authz_bindings ab ON ab.profile_id=i.profile_id AND ab.profile_version=i.profile_version AND ab.subject=i.subject
      LEFT JOIN public.mixer_authz_principals pr ON pr.id=ab.principal_id
      WHERE s.cookie_digest=p_cookie
      LIMIT 2;
      b:=r.browser; v:=r.vault; a:=r.attempt; p:=r.profile; binding:=r.binding; principal:=r.principal;
      finished:=pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint;
      -- Claim validity is checked before binding state can be disclosed.
      IF finished<entered OR (b.status IS DISTINCT FROM 'preauth' AND b.status IS DISTINCT FROM 'active') OR b.revision IS DISTINCT FROM p_revision
        OR b.config_digest IS DISTINCT FROM p_config OR b.epoch IS NULL OR b.epoch NOT BETWEEN 1 AND 9007199254740991
        OR b.generation IS NULL OR b.expected_profile_id IS DISTINCT FROM i.profile_id OR b.expected_profile_version IS DISTINCT FROM i.profile_version
        OR b.created_at IS NULL OR b.created_at NOT BETWEEN 0 AND 9007199254740991
        OR b.last_seen_at IS NULL OR b.last_seen_at<b.created_at
        OR b.absolute_expires_at IS NULL OR b.absolute_expires_at NOT BETWEEN 0 AND 9007199254740991
        OR b.idle_expires_at IS NULL OR b.idle_expires_at<=b.last_seen_at OR b.idle_expires_at>b.absolute_expires_at
        OR entered>=b.absolute_expires_at OR entered>=b.idle_expires_at OR finished>=b.absolute_expires_at OR finished>=b.idle_expires_at
        OR v.browser_id IS DISTINCT FROM b.id OR v.epoch IS DISTINCT FROM b.epoch OR v.session_revision IS DISTINCT FROM b.revision
        OR v.vault_generation IS NULL OR v.vault_generation NOT BETWEEN 1 AND 9007199254740991 OR v.envelope_kind IS DISTINCT FROM b.status
        OR v.ciphertext_version IS DISTINCT FROM 1
        OR NOT public.mixer_browser_cipher_valid(ROW(v.key_id,v.iv,v.tag,v.ciphertext)::public.mixer_browser_cipher)
        OR a.status IS DISTINCT FROM 'claimed' OR a.browser_id IS DISTINCT FROM b.id
        OR a.browser_epoch IS DISTINCT FROM b.epoch OR a.browser_revision IS DISTINCT FROM b.revision
        OR a.cookie_digest IS DISTINCT FROM b.cookie_digest OR a.generation IS DISTINCT FROM b.generation OR a.config_digest IS DISTINCT FROM b.config_digest
        OR a.created_at IS NULL OR a.created_at<b.created_at OR a.expires_at IS NULL
        OR a.expires_at NOT BETWEEN 0 AND 9007199254740991 OR a.expires_at<=a.created_at OR a.expires_at>a.created_at+300
        OR a.claim_digest IS DISTINCT FROM p_claim OR a.claimed_at IS NULL OR a.claimed_at< a.created_at
        OR a.claimed_at>entered OR a.claim_expires_at IS NULL OR a.claim_expires_at<=a.claimed_at OR a.claim_expires_at>a.expires_at OR a.claim_expires_at>a.claimed_at+60
        OR entered>=a.expires_at OR entered>=a.claim_expires_at OR finished>=a.expires_at OR finished>=a.claim_expires_at
        OR a.profile_id IS DISTINCT FROM i.profile_id OR a.profile_version IS DISTINCT FROM i.profile_version
        OR a.issuer IS DISTINCT FROM i.issuer OR a.client_id IS DISTINCT FROM i.client_id
        OR a.redirect_uri IS NULL OR octet_length(a.redirect_uri) NOT BETWEEN 1 AND 2048 OR a.return_route IS DISTINCT FROM 'workspace'
        OR a.ciphertext_version IS DISTINCT FROM 1 OR a.key_id IS NOT NULL OR a.iv IS NOT NULL OR a.tag IS NOT NULL OR a.ciphertext IS NOT NULL
        OR a.completion_reason IS NOT NULL OR finished>=i.expires_at
      THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
      IF p.id IS NULL OR p.id IS DISTINCT FROM b.expected_profile_id OR p.version IS DISTINCT FROM b.expected_profile_version
        OR p.active IS DISTINCT FROM true OR p.identity_class IS DISTINCT FROM 'human'
        OR p.issuer IS DISTINCT FROM i.issuer OR p.client_id IS DISTINCT FROM i.client_id
        OR p.state_revision IS NULL OR p.state_revision NOT BETWEEN 1 AND 9007199254740991
      THEN RAISE EXCEPTION 'browser identity unavailable' USING ERRCODE='P0001'; END IF;
      IF binding.profile_id IS NULL THEN
        RAISE EXCEPTION 'browser onboarding required' USING ERRCODE='P0001';
      END IF;
      IF binding.profile_id IS DISTINCT FROM i.profile_id OR binding.profile_version IS DISTINCT FROM i.profile_version OR binding.subject IS DISTINCT FROM i.subject
        OR binding.active IS DISTINCT FROM true OR binding.identity_class IS DISTINCT FROM 'human'
        OR binding.revision IS NULL OR binding.revision NOT BETWEEN 1 AND 9007199254740991
        OR principal.id IS NULL OR principal.id IS DISTINCT FROM binding.principal_id OR octet_length(principal.id) NOT BETWEEN 1 AND 128
        OR principal.active IS DISTINCT FROM true OR principal.identity_class IS DISTINCT FROM 'human'
        OR principal.revision IS NULL OR principal.revision NOT BETWEEN 1 AND 9007199254740991
        OR principal.not_before IS NULL OR principal.not_before>entered OR i.issued_at<principal.not_before
      THEN RAISE EXCEPTION 'browser identity unavailable' USING ERRCODE='P0001'; END IF;
      finished:=pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint;
      IF finished<entered OR finished>=b.absolute_expires_at OR finished>=b.idle_expires_at
        OR finished>=a.expires_at OR finished>=a.claim_expires_at OR finished>=i.expires_at THEN
        RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001';
      END IF;
      RETURN pg_catalog.jsonb_build_object('version',1,'snapshot',r.snapshot,'principal_id',principal.id,
        'profile_revision',p.state_revision,'binding_revision',binding.revision,'principal_revision',principal.revision);
    EXCEPTION WHEN no_data_found OR too_many_rows THEN
      RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001';
    END;
    $preparation$
    """
  end
end

5cf88660f2fcaa24d752ae695a7052ebbe47563f blob 23235
defmodule MixerHosted.BrowserAuth.Catalog do
  @moduledoc """
  Internal function/type capability prerequisite for the future lifecycle owner.

  This has no application caller and cannot authorize storage readiness. It does
  not implement the required relation, policy, constraint, index or trigger
  admission. The trusted adapter must supply its own transaction Repo, the exact
  validated RuntimeConfig expected_roles and the original monotonic deadline.
  `in_transaction?/0` proves connection checkout, not Store ownership/provenance.
  Neither the Repo nor these expectations may come from a request.
  """
  alias MixerHosted.BrowserAuth.{CatalogManifest, CatalogManifestV2}

  defmodule Unavailable do
    @moduledoc false
    defexception message: "browser catalog function surface unavailable"
  end

  @role_keys [:lifecycle_login, :writer, :relation_owner, :ordinary_runtime_login]
  @query_limit_ms 5_000
  @catalog_row_limit 4_096

  @v1 %{
    functions: CatalogManifest.functions(),
    returns: CatalogManifest.returns(),
    argument_names: CatalogManifest.argument_names(),
    composites: CatalogManifest.composites(),
    function_count: 18,
    function_limit: 19,
    function_acl_limit: 28,
    composite_count: 3,
    composite_limit: 4,
    field_limit: 26,
    type_acl_limit: 10,
    escape_limit: 19
  }
  @v2 %{
    functions: CatalogManifestV2.functions(),
    returns: CatalogManifestV2.returns(),
    argument_names: CatalogManifestV2.argument_names(),
    composites: CatalogManifestV2.composites(),
    function_count: 19,
    function_limit: 20,
    function_acl_limit: 30,
    composite_count: 4,
    composite_limit: 5,
    field_limit: 35,
    type_acl_limit: 13,
    escape_limit: 20
  }
  for manifest <- [@v1, @v2] do
    unless map_size(manifest.functions) == manifest.function_count and
             map_size(manifest.composites) == manifest.composite_count and
             manifest.function_limit == manifest.function_count + 1 and
             manifest.escape_limit == manifest.function_count + 1 and
             manifest.function_acl_limit ==
               manifest.function_count +
                 Enum.count(manifest.functions, fn {_n, f} -> f.runtime_execute end) + 1 and
             manifest.composite_limit == manifest.composite_count + 1 and
             manifest.field_limit ==
               Enum.sum(Enum.map(manifest.composites, fn {_n, f} -> length(f) end)) + 1 and
             manifest.type_acl_limit == manifest.composite_count * 3 + 1 do
      raise "reviewed browser catalog bounds are incomplete"
    end
  end

  @doc false
  def check_function_surface!(repo, expected_roles, monotonic_deadline_ms),
    do: check_function_surface!(repo, expected_roles, monotonic_deadline_ms, 1)

  @doc false
  def check_function_surface!(repo, expected_roles, monotonic_deadline_ms, version) do
    try do
      manifest = selected_manifest!(version)
      validate_roles!(expected_roles)
      require!(is_atom(repo) and repo.in_transaction?())
      now = System.monotonic_time(:millisecond)
      require!(is_integer(monotonic_deadline_ms))
      require!(monotonic_deadline_ms > now and monotonic_deadline_ms <= now + @query_limit_ms)
      context = {repo, monotonic_deadline_ms}
      session!(context, expected_roles)
      roles!(context, expected_roles)
      functions!(context, expected_roles, manifest)
      composites!(context, expected_roles, manifest)
      escape_paths!(context, expected_roles, manifest)
      remaining!(monotonic_deadline_ms)
      :function_surface_verified
    rescue
      _ -> raise Unavailable
    catch
      _, _ -> raise Unavailable
    end
  end

  # Only a future trusted owner may select these integer versions. No request,
  # map, callback or supplied module can provide a catalog expectation.
  defp selected_manifest!(version) when version === 1, do: @v1
  defp selected_manifest!(version) when version === 2, do: @v2
  defp selected_manifest!(_), do: raise(Unavailable)

  defp validate_roles!(roles) do
    require!(is_map(roles) and Enum.sort(Map.keys(roles)) == Enum.sort(@role_keys))
    names = Map.values(roles)
    require!(Enum.all?(names, &role_name?/1) and length(Enum.uniq(names)) == 4)
  end

  defp role_name?(name) when is_binary(name) and byte_size(name) in 1..63 do
    name != "public" and not String.starts_with?(name, "pg_") and
      name
      |> :binary.bin_to_list()
      |> Enum.with_index()
      |> Enum.all?(fn {c, i} -> c in ?a..?z or c == ?_ or (i > 0 and c in ?0..?9) end)
  end

  defp role_name?(_), do: false

  defp session!(context, roles) do
    require!(
      query!(context, """
      SELECT current_user::pg_catalog.text,session_user::pg_catalog.text,
        pg_catalog.current_setting('transaction_isolation'),
        pg_catalog.current_setting('statement_timeout'),
        pg_catalog.current_setting('lock_timeout'),
        pg_catalog.current_setting('idle_in_transaction_session_timeout'),
        pg_catalog.current_setting('jit'),pg_catalog.current_setting('search_path'),
        pg_catalog.current_setting('bytea_output')
      WHERE pg_catalog.octet_length(pg_catalog.current_setting('search_path'))<=64
      """) == [
        [
          roles.lifecycle_login,
          roles.lifecycle_login,
          "read committed",
          "5s",
          "500ms",
          "5s",
          "off",
          "pg_catalog",
          "hex"
        ]
      ]
    )
  end

  defp roles!(context, roles) do
    rows =
      query!(context, """
      SELECT r.oid::pg_catalog.int8,r.rolname::pg_catalog.text,r.rolcanlogin,
        r.rolinherit,r.rolsuper,r.rolbypassrls,r.rolcreaterole,r.rolcreatedb,r.rolreplication
      FROM pg_catalog.pg_roles r
      LIMIT 4097
      """)

    by_name =
      Map.new(rows, fn row ->
        remaining!(elem(context, 1))
        {Enum.at(row, 1), row}
      end)

    for key <- @role_keys do
      remaining!(elem(context, 1))
      expected_login = key in [:lifecycle_login, :ordinary_runtime_login]
      [_oid, _name | flags] = Map.fetch!(by_name, Map.fetch!(roles, key))
      require!(flags == [expected_login, false, false, false, false, false, false])
    end

    edges =
      query!(context, """
      SELECT member::pg_catalog.int8,roleid::pg_catalog.int8
      FROM pg_catalog.pg_auth_members
      LIMIT 4097
      """)

    lifecycle_oid = hd(Map.fetch!(by_name, roles.lifecycle_login))
    writer_oid = hd(Map.fetch!(by_name, roles.writer))
    owner_oid = hd(Map.fetch!(by_name, roles.relation_owner))
    ordinary_oid = hd(Map.fetch!(by_name, roles.ordinary_runtime_login))
    isolated = [lifecycle_oid, writer_oid]

    require!(
      Enum.all?(edges, fn [member, role] ->
        remaining!(elem(context, 1))
        member not in isolated and role not in isolated
      end)
    )

    reachable = reachable(MapSet.new([ordinary_oid]), edges, elem(context, 1))

    require!(
      not Enum.any?([lifecycle_oid, writer_oid, owner_oid], &MapSet.member?(reachable, &1))
    )

    privilege_reachable =
      MapSet.union(
        reachable,
        reachable(MapSet.new([owner_oid]), edges, elem(context, 1))
      )

    for [oid, name, _login, _inherit, super, bypass, create_role, create_db, replication] <- rows,
        MapSet.member?(privilege_reachable, oid) do
      remaining!(elem(context, 1))
      require!(not String.starts_with?(name, "pg_"))
      require!(not (super or bypass or create_role or create_db or replication))
    end

    # Ownership is an authority route even without an explicit ACL grant. The
    # writer may own only functions; the relation owner is intentionally allowed
    # to own the accepted installation and is checked for restricted flags above.
    owned =
      query!(context, """
      SELECT owner::pg_catalog.int8 FROM (
        SELECT relowner AS owner FROM pg_catalog.pg_class
        UNION SELECT nspowner FROM pg_catalog.pg_namespace
        UNION SELECT datdba FROM pg_catalog.pg_database
      ) owners
      LIMIT 4097
      """)

    require!(
      Enum.all?(owned, fn [oid] ->
        remaining!(elem(context, 1))
        oid not in isolated and not MapSet.member?(reachable, oid)
      end)
    )

    # A reachable role may itself own a function and make it SECURITY DEFINER.
    function_owners =
      query!(
        context,
        "SELECT DISTINCT proowner::pg_catalog.int8 FROM pg_catalog.pg_proc LIMIT 4097"
      )

    require!(
      Enum.all?(function_owners, fn [oid] ->
        remaining!(elem(context, 1))
        not MapSet.member?(reachable, oid)
      end)
    )

    require!(
      query!(
        context,
        """
        SELECT 1 FROM pg_catalog.pg_namespace n
        WHERE pg_catalog.has_schema_privilege($1::pg_catalog.text,n.oid,'CREATE')
           OR pg_catalog.has_schema_privilege($2::pg_catalog.text,n.oid,'CREATE')
           OR pg_catalog.has_schema_privilege($3::pg_catalog.text,n.oid,'CREATE')
        LIMIT 1
        """,
        [roles.lifecycle_login, roles.writer, roles.ordinary_runtime_login]
      ) == []
    )

    require!(
      query!(
        context,
        """
        SELECT pg_catalog.has_schema_privilege($1::pg_catalog.text,n.oid,'USAGE'),
          pg_catalog.has_schema_privilege($2::pg_catalog.text,n.oid,'USAGE')
        FROM pg_catalog.pg_namespace n WHERE n.nspname='public'
        """,
        [roles.lifecycle_login, roles.writer]
      ) == [[true, true]]
    )

    require!(
      query!(
        context,
        """
        SELECT 1 FROM pg_catalog.pg_database d WHERE d.datname=pg_catalog.current_database()
          AND (pg_catalog.has_database_privilege($1::pg_catalog.text,d.oid,'CREATE')
            OR pg_catalog.has_database_privilege($2::pg_catalog.text,d.oid,'CREATE')
            OR pg_catalog.has_database_privilege($3::pg_catalog.text,d.oid,'CREATE'))
        """,
        [roles.lifecycle_login, roles.writer, roles.ordinary_runtime_login]
      ) == []
    )
  end

  defp reachable(found, edges, deadline) do
    remaining!(deadline)

    expanded =
      Enum.reduce(edges, found, fn [member, role], acc ->
        remaining!(deadline)
        if MapSet.member?(found, member), do: MapSet.put(acc, role), else: acc
      end)

    if MapSet.equal?(found, expanded), do: found, else: reachable(expanded, edges, deadline)
  end

  defp functions!(context, roles, manifest) do
    rows =
      query!(
        context,
        """
        SELECT n.nspname::pg_catalog.text,p.proname::pg_catalog.text,p.oid::pg_catalog.int8,
          CASE WHEN p.pronargs<=16 AND pg_catalog.octet_length(pg_catalog.oidvectortypes(p.proargtypes))<=4096
            THEN pg_catalog.oidvectortypes(p.proargtypes) END,
          CASE WHEN pg_catalog.octet_length(pg_catalog.pg_get_function_result(p.oid))<=1024
            THEN pg_catalog.pg_get_function_result(p.oid) END,
          l.lanname::pg_catalog.text,o.rolname::pg_catalog.text,
          CASE WHEN pg_catalog.octet_length(p.prosrc)<=65536 THEN p.prosrc END,
          CASE WHEN pg_catalog.cardinality(p.proconfig)=5
            AND pg_catalog.octet_length(p.proconfig::pg_catalog.text)<=512 THEN p.proconfig END,
          p.prosecdef,p.prokind::pg_catalog.text,p.provolatile::pg_catalog.text,
          p.proisstrict,p.proleakproof,p.proparallel::pg_catalog.text,p.proretset,
          p.provariadic::pg_catalog.int8,p.pronargdefaults,
          CASE WHEN p.proargmodes IS NULL THEN NULL ELSE 'present' END,
          p.prosupport::pg_catalog.oid::pg_catalog.int8,
          CASE WHEN p.probin IS NULL THEN NULL ELSE 'present' END,p.prosqlbody IS NULL,
          CASE WHEN p.proargnames IS NULL THEN NULL
            WHEN pg_catalog.cardinality(p.proargnames)<=16
              AND pg_catalog.octet_length(p.proargnames::pg_catalog.text)<=1024 THEN p.proargnames
            ELSE ARRAY['__oversized__']::pg_catalog.text[] END,
          pg_catalog.has_function_privilege($1::pg_catalog.text,p.oid,'EXECUTE'),
          pg_catalog.has_function_privilege($2::pg_catalog.text,p.oid,'EXECUTE'),
          pg_catalog.has_function_privilege($3::pg_catalog.text,p.oid,'EXECUTE')
        FROM pg_catalog.pg_proc p
        JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace
        JOIN pg_catalog.pg_language l ON l.oid=p.prolang
        JOIN pg_catalog.pg_roles o ON o.oid=p.proowner
        WHERE pg_catalog.left(p.proname::pg_catalog.text,14)='mixer_browser_'
        ORDER BY n.nspname,p.proname,p.oid
        LIMIT #{manifest.function_limit}
        """,
        [roles.lifecycle_login, roles.writer, roles.ordinary_runtime_login]
      )

    require!(length(rows) == manifest.function_count)

    require!(
      MapSet.new(Enum.map(rows, &Enum.at(&1, 1))) ==
        MapSet.new(Map.keys(manifest.functions))
    )

    for [
          schema,
          name,
          _oid,
          args,
          result,
          language,
          owner,
          source,
          settings,
          security_definer,
          kind,
          volatility,
          strict,
          leakproof,
          parallel,
          setof,
          variadic,
          defaults,
          modes,
          support,
          binary,
          no_sql_body,
          argument_names,
          lifecycle,
          writer,
          ordinary
        ] <- rows do
      remaining!(elem(context, 1))
      expected = Map.fetch!(manifest.functions, name)
      require!(schema == "public" and language == "plpgsql" and owner == roles.writer)
      require!(args == String.replace(expected.signature, ",", ", "))
      require!(result == Map.fetch!(manifest.returns, name))
      require!(source == expected.source and is_list(settings))
      require!(Enum.sort(settings) == Enum.sort(expected.settings))

      require!(
        [security_definer, kind, volatility, strict, leakproof, parallel, setof] ==
          [true, "f", "v", false, false, "u", false]
      )

      require!(
        [variadic, defaults, modes, support, binary, no_sql_body] == [0, 0, nil, 0, nil, true]
      )

      require!(argument_names == Map.fetch!(manifest.argument_names, name))
      require!(lifecycle == expected.runtime_execute and writer and not ordinary)
    end

    acls =
      query!(context, """
      SELECT p.proname::pg_catalog.text,
        CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE g.rolname::pg_catalog.text END,
        grantor.rolname::pg_catalog.text,a.privilege_type,a.is_grantable
      FROM pg_catalog.pg_proc p
      JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace
      CROSS JOIN LATERAL pg_catalog.aclexplode(
        COALESCE(p.proacl,pg_catalog.acldefault('f',p.proowner))) a
      LEFT JOIN pg_catalog.pg_roles g ON g.oid=a.grantee
      LEFT JOIN pg_catalog.pg_roles grantor ON grantor.oid=a.grantor
      WHERE n.nspname='public' AND pg_catalog.left(p.proname::pg_catalog.text,14)='mixer_browser_'
      LIMIT #{manifest.function_acl_limit}
      """)

    expected_acls =
      Enum.flat_map(manifest.functions, fn {name, expected} ->
        [[name, roles.writer, roles.writer, "EXECUTE", false]] ++
          if expected.runtime_execute,
            do: [[name, roles.lifecycle_login, roles.writer, "EXECUTE", false]],
            else: []
      end)

    require!(Enum.sort(acls) == Enum.sort(expected_acls))
  end

  defp composites!(context, roles, manifest) do
    rows =
      query!(
        context,
        """
        SELECT n.nspname::pg_catalog.text,t.typname::pg_catalog.text,t.typtype::pg_catalog.text,
          o.rolname::pg_catalog.text,c.relkind::pg_catalog.text,
          pg_catalog.has_type_privilege($1::pg_catalog.text,t.oid,'USAGE'),
          pg_catalog.has_type_privilege($2::pg_catalog.text,t.oid,'USAGE'),
          pg_catalog.has_type_privilege($3::pg_catalog.text,t.oid,'USAGE')
        FROM pg_catalog.pg_type t
        JOIN pg_catalog.pg_namespace n ON n.oid=t.typnamespace
        JOIN pg_catalog.pg_roles o ON o.oid=t.typowner
        LEFT JOIN pg_catalog.pg_class c ON c.oid=t.typrelid
        WHERE pg_catalog.left(t.typname::pg_catalog.text,14)='mixer_browser_'
          AND (c.oid IS NULL OR c.relkind='c' OR t.typname=ANY($4::pg_catalog.text[]))
        ORDER BY n.nspname,t.typname
        LIMIT #{manifest.composite_limit}
        """,
        [
          roles.lifecycle_login,
          roles.writer,
          roles.ordinary_runtime_login,
          Map.keys(manifest.composites)
        ]
      )

    require!(length(rows) == manifest.composite_count)

    require!(
      MapSet.new(Enum.map(rows, &Enum.at(&1, 1))) == MapSet.new(Map.keys(manifest.composites))
    )

    for [schema, _name, kind, owner, relation_kind, lifecycle, writer, ordinary] <- rows do
      remaining!(elem(context, 1))

      require!(
        [schema, kind, owner, relation_kind, lifecycle, writer, ordinary] ==
          ["public", "c", roles.relation_owner, "c", true, true, false]
      )
    end

    fields =
      query!(
        context,
        """
        SELECT t.typname::pg_catalog.text,a.attname::pg_catalog.text,
          pg_catalog.format_type(a.atttypid,a.atttypmod),a.attnum::pg_catalog.int4,
          a.attisdropped,a.attnotnull,a.atthasdef,a.attgenerated::pg_catalog.text,
          a.attidentity::pg_catalog.text,a.attcollation=ft.typcollation,a.attndims::pg_catalog.int4
        FROM pg_catalog.pg_type t
        JOIN pg_catalog.pg_namespace n ON n.oid=t.typnamespace
        JOIN pg_catalog.pg_attribute a ON a.attrelid=t.typrelid AND a.attnum>0
        LEFT JOIN pg_catalog.pg_type ft ON ft.oid=a.atttypid
        WHERE n.nspname='public' AND t.typname=ANY($1::pg_catalog.text[])
        ORDER BY t.typname,a.attnum
        LIMIT #{manifest.field_limit}
        """,
        [Map.keys(manifest.composites)]
      )

    expected_fields =
      for {type, fields} <- manifest.composites,
          {{name, kind}, index} <- Enum.with_index(fields, 1),
          do: [
            type,
            name,
            kind,
            index,
            false,
            false,
            false,
            "",
            "",
            true,
            if(String.ends_with?(kind, "[]"), do: 1, else: 0)
          ]

    require!(Enum.sort(fields) == Enum.sort(expected_fields))

    acls =
      query!(
        context,
        """
        SELECT t.typname::pg_catalog.text,
          CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE g.rolname::pg_catalog.text END,
          grantor.rolname::pg_catalog.text,a.privilege_type,a.is_grantable
        FROM pg_catalog.pg_type t
        JOIN pg_catalog.pg_namespace n ON n.oid=t.typnamespace
        CROSS JOIN LATERAL pg_catalog.aclexplode(
          COALESCE(t.typacl,pg_catalog.acldefault('T',t.typowner))) a
        LEFT JOIN pg_catalog.pg_roles g ON g.oid=a.grantee
        LEFT JOIN pg_catalog.pg_roles grantor ON grantor.oid=a.grantor
        WHERE n.nspname='public' AND t.typname=ANY($1::pg_catalog.text[])
        LIMIT #{manifest.type_acl_limit}
        """,
        [Map.keys(manifest.composites)]
      )

    expected_acls =
      for type <- Map.keys(manifest.composites),
          role <- [roles.relation_owner, roles.writer, roles.lifecycle_login],
          do: [type, role, roles.relation_owner, "USAGE", false]

    require!(Enum.sort(acls) == Enum.sort(expected_acls))
  end

  defp escape_paths!(context, roles, manifest) do
    # Reject every callable application SECURITY DEFINER outside the exact
    # reviewed surface, including a helper in a second accessible schema.
    rows =
      query!(
        context,
        """
        SELECT n.nspname::pg_catalog.text,p.proname::pg_catalog.text,
          pg_catalog.has_function_privilege($1::pg_catalog.text,p.oid,'EXECUTE'),
          pg_catalog.has_function_privilege($2::pg_catalog.text,p.oid,'EXECUTE')
        FROM pg_catalog.pg_proc p
        JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace
        WHERE p.prosecdef AND n.nspname NOT IN ('pg_catalog','information_schema')
          AND (pg_catalog.has_function_privilege($1::pg_catalog.text,p.oid,'EXECUTE')
            OR pg_catalog.has_function_privilege($2::pg_catalog.text,p.oid,'EXECUTE'))
        LIMIT #{manifest.escape_limit}
        """,
        [roles.lifecycle_login, roles.writer]
      )

    require!(length(rows) == manifest.function_count)

    for [schema, name, lifecycle, writer] <- rows do
      remaining!(elem(context, 1))
      expected = Map.fetch!(manifest.functions, name)
      require!(schema == "public" and writer and lifecycle == expected.runtime_execute)
    end

    # Function/type verification must not overlook a direct table/column escape
    # for its lifecycle login. This is a deny check, not relation admission.
    require!(
      query!(
        context,
        """
        SELECT 1 FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
        WHERE n.nspname NOT IN ('pg_catalog','information_schema')
          AND c.relkind IN ('r','p','v','m','f') AND (
            EXISTS (SELECT 1 FROM pg_catalog.aclexplode(
              COALESCE(c.relacl,pg_catalog.acldefault('r',c.relowner))) a
              WHERE a.grantee=0 OR a.grantee=(SELECT r.oid FROM pg_catalog.pg_roles r
                WHERE r.rolname=$1::pg_catalog.text))
            OR pg_catalog.has_table_privilege($1::pg_catalog.text,c.oid,'SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER')
            OR EXISTS (SELECT 1 FROM pg_catalog.pg_attribute a
              WHERE a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped
                AND pg_catalog.has_column_privilege($1::pg_catalog.text,c.oid,a.attnum,'SELECT,INSERT,UPDATE,REFERENCES'))
            OR (pg_catalog.left(c.relname::pg_catalog.text,14)='mixer_browser_' AND (
              EXISTS (SELECT 1 FROM pg_catalog.aclexplode(
                COALESCE(c.relacl,pg_catalog.acldefault('r',c.relowner))) a
                WHERE CASE WHEN a.grantee=0 THEN true
                  ELSE pg_catalog.pg_has_role($2::pg_catalog.text,a.grantee,'MEMBER') END)
              OR pg_catalog.has_table_privilege($2::pg_catalog.text,c.oid,'SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER')
              OR EXISTS (SELECT 1 FROM pg_catalog.pg_attribute a
                WHERE a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped
                  AND (pg_catalog.has_column_privilege($2::pg_catalog.text,c.oid,a.attnum,'SELECT,INSERT,UPDATE,REFERENCES')
                    OR EXISTS (SELECT 1 FROM pg_catalog.aclexplode(a.attacl) acl
                      WHERE CASE WHEN acl.grantee=0 THEN true
                        ELSE pg_catalog.pg_has_role($2::pg_catalog.text,acl.grantee,'MEMBER') END))))))
        LIMIT 1
        """,
        [roles.lifecycle_login, roles.ordinary_runtime_login]
      ) == []
    )
  end

  defp query!({repo, deadline}, sql, parameters \\ []) do
    %{rows: rows} =
      Ecto.Adapters.SQL.query!(repo, sql, parameters,
        queue: false,
        timeout: remaining!(deadline),
        log: false
      )

    remaining!(deadline)
    require!(length(rows) <= @catalog_row_limit)
    rows
  end

  defp remaining!(deadline) do
    remaining = deadline - System.monotonic_time(:millisecond)
    require!(remaining > 0)
    min(remaining, @query_limit_ms)
  end

  defp require!(true), do: :ok
  defp require!(_), do: raise(Unavailable)
end

c27d571dfddad710ecd55872241ef1412b436702 blob 3589
defmodule MixerHosted.BrowserAuth.CatalogManifest do
  @moduledoc false

  # This is a build-time source expectation, never a snapshot of the database
  # being admitted. Changing the installed function cannot change this value.
  @functions MixerHosted.BrowserAuth.StorageSchema.catalog_manifest().functions
  @argument_names Map.new(
                    MixerHosted.BrowserAuth.StorageSchema.statements()
                    |> Enum.filter(
                      &String.starts_with?(&1, "CREATE FUNCTION public.mixer_browser_")
                    ),
                    fn sql ->
                      [head | _] = String.split(sql, ") RETURNS ", parts: 2)
                      [name, args] = String.split(head, "(", parts: 2)
                      name = String.replace_prefix(name, "CREATE FUNCTION public.", "")

                      names =
                        if args == "",
                          do: nil,
                          else: Enum.map(String.split(args, ","), &(String.split(&1) |> hd()))

                      {name, names}
                    end
                  )
  @returns %{
    "mixer_browser_bootstrap" => "jsonb",
    "mixer_browser_load" => "jsonb",
    "mixer_browser_begin" => "jsonb",
    "mixer_browser_claim" => "jsonb",
    "mixer_browser_provider_reject" => "jsonb",
    "mixer_browser_fail_claim" => "boolean",
    "mixer_browser_activate" => "jsonb",
    "mixer_browser_logout" => "boolean",
    "mixer_browser_expire" => "boolean",
    "mixer_browser_snapshot" => "jsonb",
    "mixer_browser_cipher_valid" => "boolean",
    "mixer_browser_audit" => "void",
    "mixer_browser_integrity" => "trigger",
    "mixer_browser_attempt_integrity" => "trigger",
    "mixer_browser_event_immutable" => "trigger",
    "mixer_browser_event_integrity" => "trigger",
    "mixer_browser_lock_existing" => "void",
    "mixer_browser_revoke_existing" => "void"
  }
  # Independently transcribed, in declared field order, from the accepted
  # ordinary StorageSchema types. These expectations do not use pg_attribute.
  @composites %{
    "mixer_browser_cipher" => [
      {"key_id", "text"},
      {"iv", "bytea"},
      {"tag", "bytea"},
      {"ciphertext", "bytea"}
    ],
    "mixer_browser_attempt" => [
      {"state_digest", "bytea"},
      {"nonce_digest", "bytea"},
      {"profile_id", "text"},
      {"profile_version", "integer"},
      {"issuer", "text"},
      {"client_id", "text"},
      {"redirect_uri", "text"},
      {"expires_at", "bigint"},
      {"cipher", "public.mixer_browser_cipher"}
    ],
    "mixer_browser_verified" => [
      {"profile_id", "text"},
      {"profile_version", "integer"},
      {"issuer", "text"},
      {"subject", "text"},
      {"client_id", "text"},
      {"credential_ref", "text"},
      {"issued_at", "bigint"},
      {"expires_at", "bigint"},
      {"scopes", "text[]"},
      {"profile_revision", "bigint"},
      {"binding_revision", "bigint"},
      {"principal_revision", "bigint"}
    ]
  }

  unless map_size(@functions) == 18 and
           MapSet.new(Map.keys(@functions)) == MapSet.new(Map.keys(@returns)) do
    raise "reviewed browser function expectation is incomplete"
  end

  unless Enum.all?(@functions, fn {_name, expected} ->
           byte_size(expected.source) <= 65_536 and
             length(String.split(expected.signature, ",")) <= 16
         end) do
    raise "reviewed browser function exceeds fixed catalog wire bounds"
  end

  def functions, do: @functions
  def argument_names, do: @argument_names
  def returns, do: @returns
  def composites, do: @composites
end

d8f74756936f30d2e6b11538fa28395c38a22a68 blob 4450
defmodule MixerHosted.BrowserAuth.CatalogManifestV2 do
  @moduledoc """
  Build-time combined function/type expectation for the preparation addition.

  This does not select a runtime owner, install SQL or admit relations. Source
  pins bind the accepted static producers and decoder; no live catalog data or
  caller-supplied expectation can change this manifest.
  """
  alias MixerHosted.BrowserAuth.{ActivationPreparationSchema, CatalogManifest}

  @source_pins %{
    "storage_schema.ex" => "676bb977bbe4c322caf63c1a5f40d86e7861847636029948b55cb01f6dedb6dd",
    "catalog_manifest.ex" => "3508c85922a1a716d39eb61ecb5daa699d6141b1aeb88a9565512c78465d1269",
    "activation_preparation_schema.ex" =>
      "d58bc6009d6118ba9469f087af99e893df6a99038cdccec11ba5048d48bf4ae8",
    "activation_preparation.ex" =>
      "e208e159719dd29ff75186667404cb6018391a2ecc3b8a3534db131d1bc281f5"
  }
  for {name, expected} <- @source_pins do
    source = Path.expand(name, __DIR__)
    @external_resource source
    actual = :crypto.hash(:sha256, File.read!(source)) |> Base.encode16(case: :lower)
    unless actual == expected, do: raise("reviewed browser v2 source pin mismatch")
  end

  @addition ActivationPreparationSchema.catalog_manifest()
  @name "mixer_browser_prepare_activation"
  @type_name "mixer_browser_access_evidence"
  @signature "bytea,bytea,bytea,bytea,bigint,public.mixer_browser_access_evidence"
  @argument_names ~w(p_cookie p_state p_config p_claim p_revision i)
  @fields [
    {"profile_id", "text"},
    {"profile_version", "integer"},
    {"issuer", "text"},
    {"subject", "text"},
    {"client_id", "text"},
    {"credential_ref", "text"},
    {"issued_at", "bigint"},
    {"expires_at", "bigint"},
    {"scopes", "text[]"}
  ]
  @settings [
    "search_path=pg_catalog",
    "statement_timeout=5s",
    "lock_timeout=500ms",
    "idle_in_transaction_session_timeout=5s",
    "bytea_output=hex"
  ]
  @decoder %{
    module: "MixerHosted.BrowserAuth.ActivationPreparation",
    source_sha256: Map.fetch!(@source_pins, "activation_preparation.ex")
  }
  @function Map.fetch!(@addition.functions, @name)

  unless @addition.version == 2 and @addition.baseline_version == 1 and
           @addition.additive_only == true and @addition.decoder == @decoder and
           Map.keys(@addition.functions) == [@name] and
           @addition.composites == %{@type_name => @fields} and
           @function.signature == @signature and @function.returns == "jsonb" and
           @function.argument_names == @argument_names and @function.settings == @settings and
           @function.security_definer == true and @function.runtime_execute == true and
           is_binary(@function.source) and byte_size(@function.source) in 1..65_536 do
    raise "reviewed browser v2 addition is incomplete"
  end

  @functions Map.merge(CatalogManifest.functions(), @addition.functions)
  @returns Map.put(CatalogManifest.returns(), @name, "jsonb")
  @arguments Map.put(CatalogManifest.argument_names(), @name, @argument_names)
  @composites Map.merge(CatalogManifest.composites(), %{@type_name => @fields})

  unless map_size(CatalogManifest.functions()) == 18 and
           map_size(CatalogManifest.composites()) == 3 and
           not Map.has_key?(CatalogManifest.functions(), @name) and
           not Map.has_key?(CatalogManifest.composites(), @type_name) and
           map_size(@functions) == 19 and map_size(@composites) == 4 and
           Enum.count(@functions, fn {_name, f} -> f.runtime_execute == true end) == 10 and
           Enum.sum(Enum.map(@composites, fn {_name, fields} -> length(fields) end)) == 34 and
           MapSet.new(Map.keys(@functions)) == MapSet.new(Map.keys(@returns)) and
           MapSet.new(Map.keys(@functions)) == MapSet.new(Map.keys(@arguments)) and
           Enum.all?(@functions, fn {_name, f} ->
             is_binary(f.source) and byte_size(f.source) in 1..65_536 and
               is_binary(f.signature) and byte_size(f.signature) in 0..4096 and
               length(String.split(f.signature, ",")) <= 16 and f.settings == @settings and
               f.security_definer == true and is_boolean(f.runtime_execute)
           end) do
    raise "reviewed browser v2 combined surface is incomplete"
  end

  def functions, do: @functions
  def argument_names, do: @arguments
  def returns, do: @returns
  def composites, do: @composites
  def decoder, do: @decoder
  def source_pins, do: @source_pins
end

afc4c80bad48364ab24e2e2fe57f7621e690f4c1 blob 8033
defmodule MixerHosted.BrowserAuth.Config do
  @moduledoc """
  Pure, restart-scoped confidential browser-client configuration.

  This constructor neither starts login nor resolves credentials. The separate
  identity startup configuration must already admit the exact active human
  profile. Raw client secrets and vault keys are never accepted configuration.
  """
  alias MixerHosted.Identity.{BoundedJSON, Encoding, Manifest, StartupConfig}

  @derive {Inspect, only: [:mode]}
  defstruct mode: :disabled,
            public_origin: nil,
            profile_id: nil,
            profile_version: nil,
            issuer: nil,
            client_id: nil,
            api_audience: nil,
            authorization_endpoint: nil,
            token_endpoint: nil,
            id_token_jwks_endpoint: nil,
            redirect_uri: nil,
            client_auth_method: nil,
            client_credential_ref: nil,
            session_vault_ref: nil,
            scope: "openid mixer.workspace.read",
            response_mode: "query",
            response_iss_required: true,
            transaction_seconds: 300,
            session_idle_seconds: 900,
            return_path: "/workspace",
            failure_path: "/login"

  @fields ~w(version public_origin profile_id profile_version issuer client_id api_audience
    authorization_endpoint token_endpoint id_token_jwks_endpoint redirect_uri
    client_auth_method client_credential_ref session_vault_ref scope response_mode
    response_iss_required)

  @doc "Loads only MIXER_BROWSER_AUTH_MODE and MIXER_BROWSER_AUTH_CONFIG; no environment reads."
  def load(env, role, identity) when is_map(env) and role in [:api, :processor] do
    case Map.get(env, "MIXER_BROWSER_AUTH_MODE", "disabled") do
      "disabled" ->
        if Map.has_key?(env, "MIXER_BROWSER_AUTH_CONFIG"),
          do: {:error, :unexpected_configuration},
          else: {:ok, %__MODULE__{}}

      "configured" when role == :api ->
        configured(Map.get(env, "MIXER_BROWSER_AUTH_CONFIG"), identity)

      "configured" ->
        {:error, :invalid_role}

      _ ->
        {:error, :invalid_mode}
    end
  end

  def load(_, _, _), do: {:error, :invalid_configuration}

  defp configured(raw, identity) do
    with {:ok, object} <- BoundedJSON.object(raw, 16_384),
         true <- map_size(object) == length(@fields),
         true <- Enum.all?(@fields, &Map.has_key?(object, &1)),
         1 <- object["version"],
         true <- metadata_text?(object["profile_id"], 128),
         true <- metadata_text?(object["client_id"], 256),
         true <- metadata_text?(object["api_audience"], 256),
         true <- canonical_url?(object["public_origin"], :origin),
         true <- canonical_url?(object["issuer"], :issuer),
         true <-
           Enum.all?(
             ~w(authorization_endpoint token_endpoint id_token_jwks_endpoint),
             &canonical_url?(object[&1], :endpoint)
           ),
         true <- object["redirect_uri"] == object["public_origin"] <> "/auth/callback",
         "client_secret_basic" <- object["client_auth_method"],
         true <- reference?(object["client_credential_ref"], "secret://"),
         true <- reference?(object["session_vault_ref"], "vault://"),
         "openid mixer.workspace.read" <- object["scope"],
         "query" <- object["response_mode"],
         true <- object["response_iss_required"],
         :ok <- match_identity(object, identity) do
      {:ok,
       %__MODULE__{
         mode: :configured,
         public_origin: object["public_origin"],
         profile_id: object["profile_id"],
         profile_version: object["profile_version"],
         issuer: object["issuer"],
         client_id: object["client_id"],
         api_audience: object["api_audience"],
         authorization_endpoint: object["authorization_endpoint"],
         token_endpoint: object["token_endpoint"],
         id_token_jwks_endpoint: object["id_token_jwks_endpoint"],
         redirect_uri: object["redirect_uri"],
         client_auth_method: :client_secret_basic,
         client_credential_ref: object["client_credential_ref"],
         session_vault_ref: object["session_vault_ref"]
       }}
    else
      _ -> {:error, :invalid_configuration}
    end
  end

  defp match_identity(object, %StartupConfig{mode: :configured, owner_options: options}) do
    with true <- Keyword.keyword?(options),
         true <- length(options) <= 8,
         true <- length(Keyword.keys(options)) == length(Enum.uniq(Keyword.keys(options))),
         entries when is_list(entries) <- Keyword.get(options, :manifest),
         {:ok, manifest} <- Manifest.validate(entries),
         binding when is_binary(binding) <- Keyword.get(options, :binding),
         %{profile: profile} <- Map.get(manifest, binding),
         true <- profile.enabled and profile.identity_class == :human,
         true <- object["profile_id"] == binding,
         true <- object["profile_version"] === profile.profile_version,
         true <- object["issuer"] == profile.issuer,
         true <- object["client_id"] == profile.client_id,
         true <- object["api_audience"] == profile.audience do
      :ok
    else
      _ -> :error
    end
  end

  defp match_identity(_, _), do: :error

  # Keep trust-matched browser metadata compatible with PostgreSQL/Vault text.
  # Preserve exact UTF-8 bytes, but reject NUL before construction.
  defp metadata_text?(value, limit),
    do: Encoding.bounded_string?(value, limit) and :binary.match(value, <<0>>) == :nomatch

  # A deliberately narrow canonical deployment form: lower-case DNS host, HTTPS
  # default port, literal safe paths, no userinfo/query/fragment, no URI aliases.
  # Endpoint addresses remain trusted operator inputs; a later network adapter
  # must independently qualify DNS, peer-address, TLS and response bounds.
  defp canonical_url?(value, kind) when is_binary(value) and byte_size(value) in 1..2048 do
    with {:ok,
          %URI{
            scheme: "https",
            host: host,
            port: 443,
            userinfo: nil,
            query: nil,
            fragment: nil,
            path: path
          }} <- URI.new(value),
         true <- host?(host),
         true <- path?(path, kind) do
      value == "https://" <> host <> (path || "")
    else
      _ -> false
    end
  end

  defp canonical_url?(_, _), do: false
  defp path?(nil, kind), do: kind in [:origin, :issuer]
  defp path?(_, :origin), do: false
  defp path?("/", kind), do: kind in [:issuer, :endpoint]

  defp path?("/" <> rest, _) do
    byte_size(rest) > 0 and
      Enum.all?(:binary.split(rest, "/", [:global]), fn segment ->
        segment != "" and segment not in [".", ".."] and
          ascii?(segment, &(&1 in ?a..?z or &1 in ?A..?Z or &1 in ?0..?9 or &1 in ~c"-._~"))
      end)
  end

  defp path?(_, _), do: false

  defp host?(value) when is_binary(value) and byte_size(value) in 1..253 do
    labels = :binary.split(value, ".", [:global])

    length(labels) >= 2 and
      match?({:error, _}, :inet.parse_address(String.to_charlist(value))) and
      Enum.all?(labels, fn label ->
        byte_size(label) in 1..63 and not String.starts_with?(label, "-") and
          not String.ends_with?(label, "-") and
          ascii?(label, &(&1 in ?a..?z or &1 in ?0..?9 or &1 == ?-))
      end)
  end

  defp host?(_), do: false

  defp reference?(value, prefix) when is_binary(value) and byte_size(value) <= 256 do
    if String.starts_with?(value, prefix) do
      rest = binary_part(value, byte_size(prefix), byte_size(value) - byte_size(prefix))

      rest != "" and
        Enum.all?(:binary.split(rest, "/", [:global]), fn segment ->
          segment != "" and segment not in [".", ".."] and
            ascii?(segment, &(&1 in ?a..?z or &1 in ?A..?Z or &1 in ?0..?9 or &1 in ~c"-._"))
        end)
    else
      false
    end
  end

  defp reference?(_, _), do: false

  defp ascii?(<<>>, _), do: true
  defp ascii?(<<byte, rest::binary>>, check), do: check.(byte) and ascii?(rest, check)
end

a7e8075eed2f8e7a0b2a723a101beff0fb953559 blob 2813
defmodule MixerHosted.BrowserAuth.ConfigurationDigest do
  @moduledoc """
  Versioned configuration identity for durable browser attempts and encrypted custody.

  Call only with the trusted constructor-validated Config. This digest binds its
  exact settings; it does not validate provider trust, resolve secrets, or confer
  permission. Only secret references are present in Config, never secret values.
  """
  alias MixerHosted.BrowserAuth.Config
  alias MixerHosted.Identity.Encoding

  @domain "mixer.browser.configuration.v1\0"
  @fields ~w(mode public_origin profile_id profile_version issuer client_id api_audience
    authorization_endpoint token_endpoint id_token_jwks_endpoint redirect_uri
    client_auth_method client_credential_ref session_vault_ref scope response_mode
    response_iss_required transaction_seconds session_idle_seconds return_path failure_path)a
  @strings [
    public_origin: 2048,
    profile_id: 128,
    issuer: 2048,
    client_id: 256,
    api_audience: 256,
    authorization_endpoint: 2048,
    token_endpoint: 2048,
    id_token_jwks_endpoint: 2048,
    redirect_uri: 2048,
    client_credential_ref: 256,
    session_vault_ref: 256
  ]
  @fixed [
    mode: :configured,
    client_auth_method: :client_secret_basic,
    scope: "openid mixer.workspace.read",
    response_mode: "query",
    response_iss_required: true,
    transaction_seconds: 300,
    session_idle_seconds: 900,
    return_path: "/workspace",
    failure_path: "/login"
  ]

  @doc "Returns the raw 32-byte SHA-256 digest used by SQL and AEAD context."
  def digest(config) do
    with {:ok, bytes} <- canonical_bytes(config) do
      {:ok, :crypto.hash(:sha256, bytes)}
    end
  rescue
    _ -> {:error, :invalid_configuration}
  end

  @doc "Closed ordered JSON pairs after a fixed domain; contains configuration metadata only."
  def canonical_bytes(%Config{} = config) do
    with true <- Enum.sort(Map.keys(config)) == Enum.sort([:__struct__ | @fields]),
         true <- Enum.all?(@fixed, fn {key, value} -> Map.fetch!(config, key) === value end),
         true <-
           is_integer(config.profile_version) and config.profile_version in 1..2_147_483_647,
         true <-
           Enum.all?(@strings, fn {key, limit} ->
             Encoding.bounded_string?(Map.fetch!(config, key), limit)
           end) do
      pairs = Enum.map(@fields, &[Atom.to_string(&1), wire_value(Map.fetch!(config, &1))])
      {:ok, @domain <> Jason.encode!([1, pairs])}
    else
      _ -> {:error, :invalid_configuration}
    end
  rescue
    _ -> {:error, :invalid_configuration}
  end

  def canonical_bytes(_), do: {:error, :invalid_configuration}
  defp wire_value(:configured), do: "configured"
  defp wire_value(:client_secret_basic), do: "client_secret_basic"
  defp wire_value(value), do: value
end

83056002b8187e637f650579d1dbf74e1e9b1ccd blob 1515
defmodule MixerHosted.BrowserAuth.Custody do
  @moduledoc """
  Pure binding of externally supplied browser vault material to its configured reference.

  This constructor does not resolve a reference, generate a key, or establish the
  provenance of supplied material. Secret injection and owner isolation remain
  separate startup responsibilities. Never log the inputs or this struct's fields.
  """
  alias MixerHosted.BrowserAuth.Vault

  @derive {Inspect, only: []}
  @enforce_keys [:reference, :key]
  defstruct @enforce_keys

  @error {:error, :session_unavailable}

  @doc "Binds a canonical vault reference to exactly one externally supplied Vault key."
  def new(reference, %{reference: reference, key_id: id, key_bytes: bytes} = material) do
    with true <- map_size(material) == 3 and reference?(reference),
         {:ok, key} <- Vault.key(id, bytes) do
      {:ok, %__MODULE__{reference: reference, key: key}}
    else
      _ -> @error
    end
  end

  def new(_, _), do: @error

  # This is the same bounded canonical reference grammar admitted by Config.
  defp reference?("vault://" <> rest = reference) when byte_size(reference) <= 256 do
    rest != "" and
      Enum.all?(:binary.split(rest, "/", [:global]), fn segment ->
        segment != "" and segment not in [".", ".."] and
          Enum.all?(:binary.bin_to_list(segment), fn byte ->
            byte in ?a..?z or byte in ?A..?Z or byte in ?0..?9 or byte in ~c"-._"
          end)
      end)
  end

  defp reference?(_), do: false
end

77741b4432038f3e7c8fff1c3a49f0d9fe997ceb blob 1683
defmodule MixerHosted.BrowserAuth.LifecycleRepo do
  @moduledoc "Dedicated lifecycle pool. No ordinary authorization, jobs or migrations use it."
  use Ecto.Repo, otp_app: :mixer_hosted, adapter: Ecto.Adapters.Postgres

  @binding Module.concat(__MODULE__, Binding)
  @fields ~w(hostname port database username password pool_size pool_count timeout
    connect_timeout queue show_sensitive_data_on_connection_error ssl)a
  @allowed @fields ++ ~w(otp_app telemetry_prefix log name)a

  @impl true
  def init(:supervisor, config) do
    unless Keyword.keyword?(config) and
             Enum.all?(Keyword.keys(config), &(&1 in @allowed)) and
             Enum.all?(@fields, &Keyword.has_key?(config, &1)) and
             Keyword.get(config, :name, __MODULE__) === __MODULE__ do
      raise ArgumentError, "browser lifecycle pool unavailable"
    end

    # Ecto.config/0 re-reads Application settings, so it cannot attest the
    # options actually used by a running pool. The pool supervisor owns this
    # protected table for exactly its lifetime. No credential is retained here.
    :ets.new(@binding, [:set, :protected, :named_table])
    :ets.insert(@binding, {:binding, fingerprint(config)})
    {:ok, Keyword.put(config, :log, false)}
  end

  def init(:runtime, config), do: {:ok, config}

  @doc false
  def bound?(expected) do
    :ets.info(@binding, :owner) === Process.whereis(__MODULE__) and
      :ets.lookup(@binding, :binding) === [{:binding, fingerprint(expected)}]
  rescue
    _ -> false
  end

  defp fingerprint(config),
    do:
      :crypto.hash(
        :sha256,
        :erlang.term_to_binary(Enum.map(@fields, &{&1, Keyword.fetch!(config, &1)}))
      )
end

