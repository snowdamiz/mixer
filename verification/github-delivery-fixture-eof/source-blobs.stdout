defmodule MixerHosted.CustomerArtifactHTTPFixture.Admin do
  use Ecto.Repo, otp_app: :mixer_artifact_http_fixture, adapter: Ecto.Adapters.Postgres
end

defmodule MixerHosted.CustomerArtifactHTTPFixture.Migration do
  use Ecto.Repo, otp_app: :mixer_artifact_http_fixture, adapter: Ecto.Adapters.Postgres
end

defmodule MixerHosted.CustomerArtifactHTTPFixture.Runtime do
  use Ecto.Repo, otp_app: :mixer_artifact_http_fixture, adapter: Ecto.Adapters.Postgres
end

defmodule MixerHosted.CustomerArtifactHTTPFixture do
  alias MixerHosted.CustomerArtifactHTTPFixture.Admin
  alias MixerHosted.Protocol.{ArtifactAdmission, ArtifactCBOR}

  def sql(query, params \\ []), do: Ecto.Adapters.SQL.query!(Admin, query, params, log: false)
  def sha(bytes), do: Base.encode16(:crypto.hash(:sha256, bytes), case: :lower)
  def now, do: System.system_time(:second)

  def seed! do
    sql(
      "TRUNCATE public.mixer_customer_idempotency,public.mixer_customer_audit_events,public.mixer_customer_artifacts,public.mixer_customer_artifact_heads,public.mixer_authz_profiles,public.mixer_authz_principals,public.mixer_authz_organizations CASCADE"
    )

    for query <- [
          "INSERT INTO public.mixer_authz_profiles(id,version,issuer,client_id,identity_class,active) VALUES ('http-profile',1,'https://issuer.fixture.invalid/oauth','reviewed-client','human',true)",
          "INSERT INTO public.mixer_authz_principals VALUES ('person','human',true,0,2),('other','human',true,0,2)",
          "INSERT INTO public.mixer_authz_bindings(profile_id,profile_version,subject,identity_class,principal_id,active) VALUES ('http-profile',1,'subject','human','person',true),('http-profile',1,'other-subject','human','other',true)",
          "INSERT INTO public.mixer_authz_families VALUES ('family','http-profile',1,'person',true,0,NULL,3),('other-family','http-profile',1,'other',true,0,NULL,3)",
          "INSERT INTO public.mixer_authz_credentials VALUES ('http-profile',1,'token','person','family',true,0,NULL,4),('http-profile',1,'other-token','other','other-family',true,0,NULL,4)",
          "INSERT INTO public.mixer_authz_organizations VALUES ('org-a',true)",
          "INSERT INTO public.mixer_authz_projects VALUES ('org-a','project-a',true)",
          "INSERT INTO public.mixer_authz_applications VALUES ('org-a','project-a','fieldlog',true)",
          "INSERT INTO public.mixer_authz_environments VALUES ('org-a','project-a','fieldlog','development',true)",
          "INSERT INTO public.mixer_authz_organization_heads VALUES ('org-a',5)",
          "INSERT INTO public.mixer_authz_project_heads VALUES ('org-a','project-a',6)",
          "INSERT INTO public.mixer_authz_memberships VALUES ('member','person','org-a','project-a','exact_project','developer',true,0,NULL,7),('other-member','other','org-a','project-a','exact_project','developer',true,0,NULL,7)"
        ],
        do: sql(query)

    {:ok, genesis} = MixerHosted.Audit.CustomerArtifactEvent.genesis("org-a", "project-a")

    sql("INSERT INTO public.mixer_customer_artifact_heads VALUES ('org-a','project-a',0,'',$1)", [
      genesis
    ])

    :ok
  end

  def counts do
    sql(
      "SELECT (SELECT count(*) FROM public.mixer_customer_artifacts),(SELECT count(*) FROM public.mixer_customer_audit_events),(SELECT count(*) FROM public.mixer_customer_idempotency),(SELECT sequence FROM public.mixer_customer_artifact_heads)"
    ).rows
  end

  # The shape is owned test input. Both private keys are freshly generated and
  # remain in memory; no fixture key is a production trust root.
  def artifact(repo) do
    payload = "HTTP integration protocol payload, not executable guest code."

    scope = %{
      "organization" => "org-a",
      "project" => "project-a",
      "app" => "fieldlog",
      "environment" => "development",
      "platform" => "ios"
    }

    limits = %{"memory_bytes" => 65_536, "fuel" => 100_000, "startup_milliseconds" => 1000}
    runtime = sha("HTTP integration runtime")

    manifest = %{
      "schema" => 3,
      "scope" => scope,
      "release_id" => "http-release",
      "source_commit" => String.duplicate("a", 40),
      "provenance_id" => "http-provenance",
      "runtime" => runtime,
      "protocol" => 3,
      "guest_abi" => 2,
      "ui_schema" => 1,
      "capability_hashes" => %{},
      "capability_grants" => %{
        "schema" => 1,
        "schema_sha256" => "b394ffd165ef28977de9743b1c1a98c419504787f2912e30d419cfb1582e15e1",
        "entries" => []
      },
      "state_min" => 1,
      "state_max" => 1,
      "payload_sha256" => sha(payload),
      "compressed_bytes" => byte_size(payload),
      "expanded_bytes" => byte_size(payload),
      "compression" => "none",
      "asset_hashes" => %{},
      "source_map_sha256" => sha("http map"),
      "limits" => limits,
      "key_id" => "http-artifact-key",
      "created_at_unix" => now()
    }

    host = %{
      "scope" => scope,
      "runtime" => runtime,
      "protocol" => 3,
      "guest_abi" => 2,
      "ui_schema" => 1,
      "capability_hashes" => %{},
      "state_version" => 1,
      "max_payload_bytes" => 4_194_304,
      "limits" => limits
    }

    {public, private} = :crypto.generate_key(:eddsa, :ed25519)

    roots = [
      %{
        "key_id" => "http-artifact-key",
        "public_key" => public,
        "scope" => scope,
        "artifact" => true,
        "assignment" => false,
        "revoked" => false,
        "not_before_unix" => now() - 60,
        "not_after_unix" => now() + 3600
      }
    ]

    {:ok, cbor} = ArtifactCBOR.encode(manifest)
    signature = :crypto.sign(:eddsa, :none, "mixer.artifact.v3\0" <> cbor, [private, :ed25519])

    bytes =
      " \n" <>
        Jason.encode!(%{
          "signed_manifest" => %{"manifest" => manifest, "signature" => Base.encode64(signature)},
          "payload" => Base.encode64(payload)
        }) <> "\n "

    config = %{repo: repo, host: host, roots: roots}
    {:ok, checked} = ArtifactAdmission.admit(bytes, host, roots, now())
    {checked, config}
  end

  def record(value) do
    if directory = System.get_env("MIXER_ARTIFACT_HTTP_EVIDENCE") do
      File.write!(Path.join(directory, "requests.jsonl"), Jason.encode!(value) <> "\n", [:append])
    end
  end
end

defmodule MixerHostedWeb.CustomerArtifactHTTPIntegrationTest do
  use ExUnit.Case, async: false
  @moduletag :customer_artifact_http_db
  alias MixerHosted.CustomerArtifacts
  alias MixerHosted.CustomerArtifacts.Schema
  alias MixerHosted.CustomerArtifactHTTPFixture, as: F
  alias MixerHosted.CustomerArtifactHTTPFixture.{Admin, Migration, Runtime}
  alias MixerHosted.Identity.{ConfiguredVerifier, KeyOwner, TLSFixture}

  @profile %{
    profile_id: "http-profile",
    profile_version: 1,
    issuer: "https://issuer.fixture.invalid/oauth",
    audience: "mixer-api",
    client_id: "reviewed-client",
    identity_class: :human,
    enabled: true
  }
  @scopes "mixer.artifact.upload mixer.artifact.read mixer.audit.read"

  setup_all do
    for app <- [:phoenix, :bandit, :ecto_sql, :postgrex, :jose, :mint, :ssl],
        do: Application.ensure_all_started(app)

    settings = [
      hostname: "127.0.0.1",
      port: String.to_integer(System.fetch_env!("MIXER_ARTIFACT_HTTP_TEST_PORT")),
      database: "mixer_customer_artifact_http",
      ssl: false,
      log: false
    ]

    start_supervised!(
      {Admin, settings ++ [username: "http_artifact_fixture_admin", pool_size: 3]}
    )

    start_supervised!(
      {Migration,
       settings ++
         [
           username: "http_artifact_fixture_admin",
           pool_size: 2,
           after_connect: fn c -> Postgrex.query!(c, "SET ROLE http_artifact_owner", []) end
         ]}
    )

    start_supervised!(
      {Runtime,
       settings ++
         [
           username: "http_artifact_runtime",
           pool_size: 1,
           telemetry_prefix: [:mixer_http_artifact_runtime],
           parameters: [application_name: "mixer-http-artifact-runtime"]
         ]}
    )

    for {version, module, file} <- [
          {20_261_025_000_003, MixerHosted.Repo.Migrations.AddCustomerAuthorization,
           "20261025000003_add_customer_authorization.exs"},
          {20_261_025_000_004, MixerHosted.Repo.Migrations.AddAuthorizationStateRevisions,
           "20261025000004_add_authorization_state_revisions.exs"},
          {20_261_025_000_005, MixerHosted.Repo.Migrations.AddCustomerArtifactStorage,
           "20261025000005_add_customer_artifact_storage.exs"}
        ] do
      unless Code.ensure_loaded?(module),
        do: Code.require_file(Path.expand("../../priv/repo/migrations/" <> file, __DIR__))

      assert :ok = Ecto.Migrator.up(Migration, version, module, log: false)
    end

    for name <-
          ~w(profiles principals bindings families credentials organizations projects applications environments organization_heads project_heads memberships),
        do: F.sql("GRANT SELECT ON public.mixer_authz_#{name} TO http_artifact_runtime")

    for name <- ~w(profiles principals families credentials organization_heads project_heads),
        do:
          F.sql(
            "GRANT EXECUTE ON FUNCTION public.mixer_authz_lock_#{name}() TO http_artifact_runtime"
          )

    for name <- ~w(artifacts audit_events idempotency),
        do: F.sql("GRANT SELECT,INSERT ON public.mixer_customer_#{name} TO http_artifact_runtime")

    F.sql(
      "GRANT SELECT,UPDATE(sequence,event_sha256,state_sha256) ON public.mixer_customer_artifact_heads TO http_artifact_runtime"
    )

    for name <-
          ~w(mixer_customer_allowed mixer_customer_artifact_metadata mixer_customer_key_exists),
        do:
          F.sql(
            "GRANT EXECUTE ON FUNCTION public.#{name}(#{Schema.signatures()[name]}) TO http_artifact_runtime"
          )

    fixture = start_supervised!(TLSFixture)
    authority = GenServer.call(fixture, :authority)
    key = JOSE.JWK.generate_key({:rsa, 2048})

    public =
      key
      |> JOSE.JWK.to_public()
      |> JOSE.JWK.to_map()
      |> elem(1)
      |> Map.merge(%{"kid" => "http-key", "alg" => "RS256", "use" => "sig"})

    TLSFixture.configure(fixture, {:body, Jason.encode!(%{"keys" => [public]})})
    workers = MixerHosted.CustomerArtifactHTTPFixture.KeyWorkers
    worker_pid = start_supervised!({DynamicSupervisor, strategy: :one_for_one, name: workers})
    assert Process.whereis(KeyOwner) == nil
    assert Process.whereis(MixerHostedWeb.Endpoint) == nil

    entry = %{
      profile: @profile,
      jwks_endpoint: %{host: "jwks.fixture.invalid", port: 443, path: "/keys"},
      transport: :hosted_https
    }

    opts = [
      name: KeyOwner,
      manifest: [entry],
      generation: 1,
      binding: @profile.profile_id,
      ca_roots: [authority.ca],
      resolvers: [{{127, 0, 0, 1}, 9}],
      worker_supervisor: workers,
      fixture: Map.take(authority, [:ip, :port])
    ]

    owner = start_supervised!(%{id: KeyOwner, start: {KeyOwner, :start_fixture, [opts]}})
    endpoint_previous = Application.fetch_env(:mixer_hosted, MixerHostedWeb.Endpoint)

    Application.put_env(:mixer_hosted, MixerHostedWeb.Endpoint,
      adapter: Bandit.PhoenixAdapter,
      server: true,
      http: [ip: {127, 0, 0, 1}, port: 0],
      secret_key_base: String.duplicate("synthetic-endpoint-fixture-", 4),
      render_errors: [formats: [json: MixerHostedWeb.ErrorJSON], layout: false],
      debug_errors: false
    )

    bandit = start_supervised!(MixerHostedWeb.Endpoint)
    {:ok, {_, port}} = MixerHostedWeb.Endpoint.server_info(:http)
    tls_setup = TLSFixture.info(fixture)
    assert tls_setup.key_dir_removed

    on_exit(fn ->
      tls_info =
        if Process.alive?(fixture),
          do: TLSFixture.info(fixture),
          else: %{key_dir_removed: tls_setup.key_dir_removed, requests: []}

      for pid <- [bandit, owner, worker_pid, fixture] do
        if Process.alive?(pid) do
          try do
            GenServer.stop(pid, :normal, 5_000)
          catch
            :exit, _ -> :ok
          end
        end
      end

      case endpoint_previous do
        {:ok, value} -> Application.put_env(:mixer_hosted, MixerHostedWeb.Endpoint, value)
        :error -> Application.delete_env(:mixer_hosted, MixerHostedWeb.Endpoint)
      end

      cleanup = %{
        bandit_stopped: not Process.alive?(bandit),
        key_owner_stopped: not Process.alive?(owner),
        jwks_workers_stopped: not Process.alive?(worker_pid),
        tls_fixture_stopped: not Process.alive?(fixture),
        ephemeral_tls_key_directory_removed: tls_info.key_dir_removed,
        jwks_tls_request_count:
          if(Process.alive?(fixture), do: length(tls_info.requests), else: nil),
        bandit_port: port,
        tls_port: authority.port
      }

      if directory = System.get_env("MIXER_ARTIFACT_HTTP_EVIDENCE"),
        do:
          File.write!(
            Path.join(directory, "http-cleanup.json"),
            Jason.encode!(cleanup, pretty: true)
          )
    end)

    %{port: port, key: key, tls_fixture: fixture}
  end

  setup context do
    F.seed!()
    {checked, config} = F.artifact(Runtime)
    previous = Application.fetch_env(:mixer_hosted, CustomerArtifacts)
    Application.put_env(:mixer_hosted, CustomerArtifacts, config)

    on_exit(fn ->
      case previous do
        {:ok, value} -> Application.put_env(:mixer_hosted, CustomerArtifacts, value)
        :error -> Application.delete_env(:mixer_hosted, CustomerArtifacts)
      end
    end)

    Map.merge(context, %{checked: checked, token: token(context.key), config: config})
  end

  defp token(key, claims \\ %{}) do
    values =
      Map.merge(
        %{
          "iss" => @profile.issuer,
          "aud" => @profile.audience,
          "sub" => "subject",
          "client_id" => @profile.client_id,
          "iat" => F.now() - 2,
          "exp" => F.now() + 600,
          "jti" => "token",
          "scope" => @scopes
        },
        claims
      )

    JOSE.JWS.sign(key, Jason.encode!(values), %{
      "alg" => "RS256",
      "typ" => "at+jwt",
      "kid" => "http-key"
    })
    |> JOSE.JWS.compact()
    |> elem(1)
  end

  defp path(ctx),
    do: "/v3/orgs/org-a/projects/project-a/artifacts/" <> ctx.checked.manifest_sha256

  defp audit_path, do: "/v3/orgs/org-a/projects/project-a/audit"

  defp upload_headers,
    do: [
      {"content-type", "application/json"},
      {"idempotency-key", "first"},
      {"x-mixer-reason", "HTTP fixture upload"}
    ]

  defp request(ctx, label, method, path, bytes \\ "", headers \\ [], opts \\ []) do
    authentication =
      case Keyword.get(opts, :token, ctx.token) do
        nil -> []
        token -> [{"authorization", "Bearer " <> token}]
      end

    framing =
      if Enum.any?(headers, fn {name, _} -> name in ["content-length", "transfer-encoding"] end),
        do: [],
        else: [{"content-length", Integer.to_string(byte_size(bytes))}]

    wire = [
      method,
      " ",
      path,
      " HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n",
      Enum.map(authentication ++ framing ++ headers, fn {name, value} ->
        [name, ": ", value, "\r\n"]
      end),
      "\r\n",
      bytes
    ]

    {:ok, socket} = :gen_tcp.connect({127, 0, 0, 1}, ctx.port, [:binary, active: false], 2000)

    try do
      :ok = :gen_tcp.send(socket, wire)
      raw = receive_response(socket, "", Keyword.get(opts, :timeout, 4000))
      [head, body] = :binary.split(raw, "\r\n\r\n")
      [status_line | lines] = :binary.split(head, "\r\n", [:global])
      [_, status | _] = String.split(status_line, " ")

      response_headers =
        Enum.map(lines, fn line ->
          [name, value] = :binary.split(line, ":")
          {String.downcase(name), String.trim(value)}
        end)

      response = %{status: String.to_integer(status), headers: response_headers, body: body}
      assert header(response, "cache-control") == ["no-store"]
      assert [request_id] = header(response, "x-request-id")
      assert byte_size(request_id) in 20..200
      public_response = if body == "", do: nil, else: Jason.decode!(body)

      F.record(%{
        label: label,
        request: %{
          method: method,
          path: path,
          body_bytes: byte_size(bytes),
          body_sha256: F.sha(bytes),
          header_names: Enum.map(headers, &elem(&1, 0)),
          bearer_present: authentication != []
        },
        response: %{
          status: response.status,
          headers: Map.new(response_headers),
          body_bytes: byte_size(body),
          body_sha256: F.sha(body),
          json: public_response
        },
        table_counts_after: F.counts()
      })

      response
    after
      :gen_tcp.close(socket)
    end
  end

  defp receive_response(socket, bytes, timeout) do
    case :gen_tcp.recv(socket, 0, timeout) do
      {:ok, next} -> receive_response(socket, bytes <> next, timeout)
      {:error, :closed} -> bytes
      other -> flunk("HTTP response did not complete: #{inspect(other)}")
    end
  end

  defp header(response, key), do: for({^key, value} <- response.headers, do: value)
  defp json(response), do: Jason.decode!(response.body)

  defp error(response, status, code) do
    assert response.status == status

    assert %{"error" => %{"code" => ^code, "message" => message}, "request_id" => id} =
             json(response)

    assert Map.keys(json(response)) |> Enum.sort() == ["error", "request_id"]
    assert is_binary(message) and byte_size(message) <= 200
    assert header(response, "x-request-id") == [id]
    assert header(response, "retry-after") == if(status == 503, do: ["1"], else: [])
  end

  test "real default bearer verifier and PostgreSQL create retry read audit and wire HEAD", ctx do
    assert TLSFixture.info(ctx.tls_fixture).requests == []

    error(
      request(
        ctx,
        "cold missing bearer does not fetch JWKS",
        "PUT",
        path(ctx),
        "",
        [{"content-length", "100000"} | upload_headers()],
        token: nil,
        timeout: 1000
      ),
      401,
      "unauthenticated"
    )

    assert TLSFixture.info(ctx.tls_fixture).requests == []

    created =
      request(
        ctx,
        "create",
        "PUT",
        path(ctx),
        ctx.checked.envelope_bytes,
        upload_headers() ++
          [{"x-forwarded-for", "198.51.100.7"}, {"x-request-id", String.duplicate("caller", 6)}]
      )

    assert created.status == 201
    transport = TLSFixture.info(ctx.tls_fixture)
    assert transport.requests != []

    if directory = System.get_env("MIXER_ARTIFACT_HTTP_EVIDENCE") do
      File.write!(
        Path.join(directory, "identity-transport.json"),
        Jason.encode!(
          %{
            request_count: length(transport.requests),
            ephemeral_tls_key_directory_removed: transport.key_dir_removed,
            requests:
              Enum.map(transport.requests, fn entry ->
                %{
                  request_line: entry.request |> String.split("\r\n") |> hd(),
                  sni: to_string(entry.tls[:sni_hostname])
                }
              end)
          },
          pretty: true
        )
      )
    end

    assert {:ok, identity} = ConfiguredVerifier.authenticate(ctx.token, F.now())
    assert identity.subject == "subject"

    assert json(created) == %{
             "artifact_sha256" => ctx.checked.manifest_sha256,
             "immutable" => true
           }

    assert F.counts() == [[1, 1, 1, 1]]

    retry =
      request(
        ctx,
        "authorized same-key retry",
        "PUT",
        path(ctx),
        ctx.checked.envelope_bytes,
        upload_headers()
      )

    assert {retry.status, retry.body} == {created.status, created.body}
    assert F.counts() == [[1, 1, 1, 1]]

    new_key =
      List.keyreplace(upload_headers(), "idempotency-key", 0, {"idempotency-key", "second"})

    unchanged =
      request(
        ctx,
        "new-key identical artifact",
        "PUT",
        path(ctx),
        ctx.checked.envelope_bytes <> " \n",
        new_key
      )

    assert unchanged.status == 200
    assert json(unchanged) == json(created)
    assert F.counts() == [[1, 2, 2, 2]]

    read =
      request(ctx, "private exact retained bytes", "GET", path(ctx), "", [
        {"x-mixer-reason", String.duplicate("ignored", 100)}
      ])

    assert read.status == 200 and read.body == ctx.checked.envelope_bytes
    assert header(read, "content-type") == ["application/json; charset=utf-8"]
    audit = request(ctx, "schema-2 audit first page", "GET", audit_path() <> "?after=&limit=1")
    assert %{"events" => [first], "next" => 1} = json(audit)
    assert first["audit_schema"] == 2 and first["sequence"] == 1
    assert first["outcome"] == "created" and first["reason"] == "HTTP fixture upload"
    assert first["source_ip"] == ["127.0.0.1"]
    assert byte_size(first["request_id"]) == 32
    refute first["request_id"] == String.duplicate("caller", 6)
    assert hd(first["actor"]) == "person"
    second = request(ctx, "schema-2 audit second page", "GET", audit_path() <> "?after=1&limit=1")
    assert %{"events" => [event], "next" => 2} = json(second)
    assert event["outcome"] == "unchanged"
    assert first["current_state_sha256"] == event["current_state_sha256"]

    assert %{"events" => [], "next" => 2} =
             request(ctx, "audit terminal page", "GET", audit_path() <> "?after=2") |> json()

    for {label, target, status, token} <- [
          {"HEAD artifact", path(ctx), 200, ctx.token},
          {"HEAD audit", audit_path(), 200, ctx.token},
          {"HEAD authentication failure", path(ctx), 401, nil}
        ] do
      head = request(ctx, label, "HEAD", target, "", [], token: token)
      assert head.status == status and head.body == ""
    end

    assert F.counts() == [[1, 2, 2, 2]]
  end

  test "authentication and exact token scope reject before a withheld body", ctx do
    incomplete = [{"content-length", "100000"} | upload_headers()]

    error(
      request(ctx, "missing bearer before body", "PUT", path(ctx), "", incomplete,
        token: nil,
        timeout: 1000
      ),
      401,
      "unauthenticated"
    )

    denied = token(ctx.key, %{"scope" => "mixer.artifact.upload.extra"})

    error(
      request(ctx, "scope before withheld body", "PUT", path(ctx), "", incomplete,
        token: denied,
        timeout: 1000
      ),
      403,
      "permission_denied"
    )

    invalid = token(ctx.key, %{"exp" => F.now() - 1})

    error(
      request(ctx, "expired RS256 bearer", "PUT", path(ctx), "{}", upload_headers(),
        token: invalid
      ),
      401,
      "unauthenticated"
    )

    assert F.counts() == [[0, 0, 0, 0]]
  end

  test "digest mismatch never writes or returns an existing cached receipt", ctx do
    wrong =
      String.replace_suffix(path(ctx), ctx.checked.manifest_sha256, String.duplicate("0", 64))

    error(
      request(
        ctx,
        "digest mismatch before create",
        "PUT",
        wrong,
        ctx.checked.envelope_bytes,
        upload_headers()
      ),
      422,
      "digest_mismatch"
    )

    assert F.counts() == [[0, 0, 0, 0]]

    assert request(
             ctx,
             "create after mismatch uses same unreserved key",
             "PUT",
             path(ctx),
             ctx.checked.envelope_bytes,
             upload_headers()
           ).status == 201

    error(
      request(
        ctx,
        "digest mismatch before cached retry",
        "PUT",
        wrong,
        ctx.checked.envelope_bytes,
        upload_headers()
      ),
      422,
      "digest_mismatch"
    )

    assert F.counts() == [[1, 1, 1, 1]]
  end

  test "current roles and credential revocation fence cached upload and private reads", ctx do
    assert request(
             ctx,
             "create before role changes",
             "PUT",
             path(ctx),
             ctx.checked.envelope_bytes,
             upload_headers()
           ).status == 201

    F.sql("UPDATE public.mixer_authz_memberships SET role='viewer' WHERE id='member'")
    assert request(ctx, "viewer private read", "GET", path(ctx)).status == 200
    assert request(ctx, "viewer audit", "GET", audit_path()).status == 200

    error(
      request(
        ctx,
        "viewer cannot replay upload",
        "PUT",
        path(ctx),
        ctx.checked.envelope_bytes,
        upload_headers()
      ),
      403,
      "permission_denied"
    )

    F.sql("UPDATE public.mixer_authz_memberships SET role='billing_manager' WHERE id='member'")
    error(request(ctx, "billing manager cannot read", "GET", path(ctx)), 403, "permission_denied")
    F.sql("UPDATE public.mixer_authz_memberships SET role='developer' WHERE id='member'")

    F.sql(
      "UPDATE public.mixer_authz_credentials SET active=false,revision=revision+1 WHERE reference='token'"
    )

    for {label, method, target, bytes, headers} <- [
          {"revoked cached upload", "PUT", path(ctx), ctx.checked.envelope_bytes,
           upload_headers()},
          {"revoked private read", "GET", path(ctx), "", []},
          {"revoked audit", "GET", audit_path(), "", []}
        ] do
      error(request(ctx, label, method, target, bytes, headers), 401, "unauthenticated")
    end

    assert F.counts() == [[1, 1, 1, 1]]
  end

  test "tenant invisibility and principal-bound keys expose no cached success", ctx do
    assert request(
             ctx,
             "create for principal binding",
             "PUT",
             path(ctx),
             ctx.checked.envelope_bytes,
             upload_headers()
           ).status == 201

    other = token(ctx.key, %{"sub" => "other-subject", "jti" => "other-token"})

    error(
      request(
        ctx,
        "other principal same key",
        "PUT",
        path(ctx),
        ctx.checked.envelope_bytes,
        upload_headers(),
        token: other
      ),
      409,
      "idempotency_conflict"
    )

    other_tenant = String.replace(path(ctx), "/org-a/", "/org-b/")
    error(request(ctx, "foreign tenant private read", "GET", other_tenant), 404, "not_found")
    F.sql("UPDATE public.mixer_authz_memberships SET active=false WHERE id='member'")
    error(request(ctx, "removed membership private read", "GET", path(ctx)), 404, "not_found")

    error(
      request(
        ctx,
        "removed membership cached upload",
        "PUT",
        path(ctx),
        ctx.checked.envelope_bytes,
        upload_headers()
      ),
      404,
      "not_found"
    )

    assert F.counts() == [[1, 1, 1, 1]]
  end

  test "wire transport rejects malformed media encodings query and closed envelope without writes",
       ctx do
    for {label, method, target, bytes, headers, status, code} <- [
          {"empty content encoding", "PUT", path(ctx), "{}",
           upload_headers() ++ [{"content-encoding", ""}], 415, "unsupported_content_encoding"},
          {"nonexact media", "PUT", path(ctx), "{}",
           List.keyreplace(
             upload_headers(),
             "content-type",
             0,
             {"content-type", "application/json; charset=utf-8"}
           ), 400, "content_type"},
          {"duplicate JSON keys", "PUT", path(ctx),
           "{\"signed_manifest\":{},\"payload\":\"x\",\"payload\":\"x\"}", upload_headers(), 400,
           "invalid_json"},
          {"extra envelope field", "PUT", path(ctx),
           "{\"signed_manifest\":{},\"payload\":\"x\",\"extra\":true}", upload_headers(), 400,
           "invalid_json"},
          {"signed admission failure", "PUT", path(ctx),
           "{\"signed_manifest\":{},\"payload\":\"eA==\"}", upload_headers(), 422,
           "artifact_invalid"},
          {"duplicate query", "GET", audit_path() <> "?after=0&after=1", "", [], 400,
           "invalid_request"},
          {"unknown query", "GET", audit_path() <> "?unknown=1", "", [], 400, "invalid_request"},
          {"cursor overflow", "GET", audit_path() <> "?after=9007199254740992", "", [], 400,
           "invalid_request"},
          {"read body", "GET", path(ctx), "x", [], 400, "invalid_request"},
          {"chunked read body", "GET", path(ctx), "1\r\nx\r\n0\r\n\r\n",
           [{"transfer-encoding", "chunked"}], 400, "invalid_request"}
        ] do
      error(request(ctx, label, method, target, bytes, headers), status, code)
      assert F.counts() == [[0, 0, 0, 0]]
    end

    oversized = String.duplicate(" ", 6_291_456) <> "x"

    error(
      request(ctx, "raw document exceeds six MiB", "PUT", path(ctx), oversized, upload_headers()),
      413,
      "body_too_large"
    )

    assert F.counts() == [[0, 0, 0, 0]]
    empty = request(ctx, "empty audit defaults", "GET", audit_path() <> "?after=&limit=")
    assert empty.status == 200 and json(empty) == %{"events" => [], "next" => 0}
  end

  test "percent escaped raw path aliases reject before artifact mutation", ctx do
    <<first, rest::binary>> = ctx.checked.manifest_sha256
    escaped_digest = "%" <> Base.encode16(<<first>>, case: :upper) <> rest

    aliases = [
      {"encoded static route", String.replace(path(ctx), "/v3/", "/%76%33/")},
      {"encoded tenant identifier", String.replace(path(ctx), "/org-a/", "/org%2Da/")},
      {"encoded digest nibble",
       String.replace(path(ctx), ctx.checked.manifest_sha256, escaped_digest)}
    ]

    for {label, target} <- aliases do
      error(
        request(ctx, label, "PUT", target, ctx.checked.envelope_bytes, upload_headers()),
        400,
        "invalid_path"
      )

      assert F.counts() == [[0, 0, 0, 0]]
    end
  end

  defp await_runtime(deadline) do
    case Ecto.Adapters.SQL.query(Runtime, "SELECT 1", [], log: false, queue: false, timeout: 100) do
      {:ok, _} ->
        :ok

      _ ->
        if System.monotonic_time(:millisecond) >= deadline,
          do: flunk("owned runtime connection did not reconnect")

        Process.sleep(25)
        await_runtime(deadline)
    end
  end

  test "database failure after writes and deferred checks returns no success and rolls back",
       ctx do
    handler = "http-artifact-precommit-failure"
    parent = self()

    :ok =
      :telemetry.attach(
        handler,
        [:mixer_http_artifact_runtime, :query],
        fn _, _, metadata, _ ->
          for table <- ~w(artifacts audit_events idempotency) do
            if String.starts_with?(metadata.query, "INSERT INTO public.mixer_customer_#{table} ") do
              rows =
                case metadata.result do
                  {:ok, %{num_rows: count}} -> count
                  _ -> :failed
                end

              send(parent, {:write_stage, table, rows})
            end
          end

          if String.starts_with?(
               metadata.query,
               "UPDATE public.mixer_customer_artifact_heads SET "
             ) do
            rows =
              case metadata.result do
                {:ok, %{num_rows: count}} -> count
                _ -> :failed
              end

            send(parent, {:write_stage, "artifact_heads", rows})
          end

          if metadata.query == "SET CONSTRAINTS ALL DEFERRED" do
            :telemetry.detach(handler)

            rows =
              F.sql(
                "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE application_name='mixer-http-artifact-runtime' AND state='idle in transaction'"
              ).rows

            send(parent, {:post_write_backend_terminated, rows})
          end
        end,
        nil
      )

    on_exit(fn -> :telemetry.detach(handler) end)

    failed =
      request(
        ctx,
        "post-write pre-commit backend failure",
        "PUT",
        path(ctx),
        ctx.checked.envelope_bytes,
        upload_headers()
      )

    for table <- ~w(artifacts audit_events idempotency artifact_heads),
        do: assert_receive({:write_stage, ^table, 1}, 2000)

    assert_receive {:post_write_backend_terminated, [[true]]}, 2000

    if directory = System.get_env("MIXER_ARTIFACT_HTTP_EVIDENCE") do
      File.write!(
        Path.join(directory, "transaction-boundary.json"),
        Jason.encode!(
          %{
            completed_local_writes: %{
              artifacts: 1,
              audit_events: 1,
              idempotency: 1,
              artifact_heads: 1
            },
            constraints_checked_before_backend_termination: true,
            backend_termination_confirmed: true,
            response_status: failed.status,
            committed_counts_after_failure: F.counts()
          },
          pretty: true
        )
      )
    end

    error(failed, 503, "authorization_unavailable")
    assert F.counts() == [[0, 0, 0, 0]]
    await_runtime(System.monotonic_time(:millisecond) + 4000)

    assert request(
             ctx,
             "retry after rollback reuses unreserved key",
             "PUT",
             path(ctx),
             ctx.checked.envelope_bytes,
             upload_headers()
           ).status == 201

    assert F.counts() == [[1, 1, 1, 1]]
  end
end

70e85544f3f6c069d1e57387a923cdffca192cdc blob 28640
defmodule MixerHostedWeb.CustomerArtifactTransportTest do
  use ExUnit.Case, async: false
  import Plug.Conn
  import Plug.Test
  alias MixerHosted.Identity.VerifiedIdentity
  alias MixerHostedWeb.CustomerArtifactController, as: Controller
  alias MixerHostedWeb.Plugs.{BearerIdentity, CustomerArtifactRequest}

  @digest String.duplicate("a", 64)
  @path "/v3/orgs/org-a/projects/project-a/artifacts/#{@digest}"
  @body " {\"payload\":\"cGF5bG9hZA==\", \"signed_manifest\":{}}\n"
  @maximum 6_291_456

  defmodule Verifier do
    @behaviour MixerHosted.Identity.Verifier
    def authenticate(token, now) do
      send(self(), {:verified, token, now})
      Process.get(:artifact_transport_identity)
    end
  end

  defmodule Facade do
    def upload_at(identity, route, digest, key, bytes, metadata) do
      send(self(), {:upload, identity, route, digest, key, bytes, metadata})

      result(
        {:ok,
         %{status: 201, manifest_sha256: digest, payload_sha256: "internal", event_sequence: 99}}
      )
    end

    def read(identity, route, digest, metadata) do
      send(self(), {:read, identity, route, digest, metadata})

      result(
        {:ok,
         %{
           manifest_sha256: digest,
           envelope_bytes: " {\"retained\":true}\n",
           payload_sha256: "private"
         }}
      )
    end

    def audit(identity, route, after_sequence, limit, metadata) do
      send(self(), {:audit, identity, route, after_sequence, limit, metadata})
      result({:ok, %{events: [], next_after_sequence: after_sequence}})
    end

    defp result(default) do
      case Process.get(:artifact_transport_result, default) do
        :raise -> raise("private database credential")
        :throw -> throw("private provider response")
        other -> other
      end
    end
  end

  defmodule Adapter do
    def read_req_body(%{inner: inner, mode: mode} = state, opts) do
      send(self(), {:body_read, opts})

      case mode do
        :raise ->
          raise("private request bytes")

        :throw ->
          throw("private request bytes")

        :error ->
          {:error, :timeout}

        :empty_more ->
          {:more, "", state}

        :deadline ->
          Process.put(:artifact_transport_milliseconds, 15_000)
          {:ok, "", state}

        :chunks ->
          length = min(Keyword.fetch!(opts, :length), 7)
          {tag, bytes, inner} = Plug.Adapters.Test.Conn.read_req_body(inner, length: length)
          {tag, bytes, %{state | inner: inner}}

        _ ->
          {tag, bytes, inner} = Plug.Adapters.Test.Conn.read_req_body(inner, opts)
          {tag, bytes, %{state | inner: inner}}
      end
    end

    def send_resp(state, status, headers, body) do
      {:ok, body, inner} = Plug.Adapters.Test.Conn.send_resp(state.inner, status, headers, body)
      {:ok, body, %{state | inner: inner}}
    end
  end

  defmodule FixtureController do
    def init(operation), do: operation

    def call(conn, operation) do
      options =
        MixerHostedWeb.CustomerArtifactController.init(
          operation: operation,
          facade: MixerHostedWeb.CustomerArtifactTransportTest.Facade,
          clock: {MixerHostedWeb.CustomerArtifactTransportTest, :milliseconds, []}
        )

      MixerHostedWeb.CustomerArtifactController.call(conn, options)
    end
  end

  defmodule FixtureClock do
    def unix_seconds, do: 1_800_000_000
  end

  defmodule FixtureRouter do
    use Phoenix.Router

    pipeline :identity do
      plug(MixerHostedWeb.Plugs.BearerIdentity,
        verifier: MixerHostedWeb.CustomerArtifactTransportTest.Verifier,
        clock: {MixerHostedWeb.CustomerArtifactTransportTest.FixtureClock, :unix_seconds, []}
      )
    end

    scope "/v3/orgs/:organization_id/projects/:project_id" do
      pipe_through(:identity)

      put(
        "/artifacts/:manifest_sha256",
        MixerHostedWeb.CustomerArtifactTransportTest.FixtureController,
        :upload
      )

      get(
        "/artifacts/:manifest_sha256",
        MixerHostedWeb.CustomerArtifactTransportTest.FixtureController,
        :read
      )

      get("/audit", MixerHostedWeb.CustomerArtifactTransportTest.FixtureController, :audit)
    end
  end

  def unix_seconds, do: 1_800_000_000
  def milliseconds, do: Process.get(:artifact_transport_milliseconds, 0)

  setup do
    Process.put(:artifact_transport_milliseconds, 0)
    Process.put(:artifact_transport_identity, {:ok, identity()})
    :ok
  end

  defp identity(scopes \\ ["mixer.artifact.upload", "mixer.artifact.read", "mixer.audit.read"]) do
    %VerifiedIdentity{
      profile_id: "profile",
      profile_version: 1,
      issuer: "https://identity.invalid",
      subject: "subject",
      client_id: "client",
      credential_ref: "credential",
      issued_at: unix_seconds() - 1,
      expires_at: unix_seconds() + 100,
      identity_class: :human,
      scopes: scopes
    }
  end

  defp request(operation \\ :upload, opts \\ []) do
    method = Keyword.get(opts, :method, if(operation == :upload, do: :put, else: :get))

    path =
      Keyword.get(
        opts,
        :path,
        if(operation == :audit, do: "/v3/orgs/org-a/projects/project-a/audit", else: @path)
      )

    query = Keyword.get(opts, :query, "")
    body = Keyword.get(opts, :body, if(operation == :upload, do: @body, else: ""))

    headers =
      Keyword.get(opts, :headers, [
        {"authorization", "Bearer opaque.Token"},
        {"content-type", "application/json"},
        {"idempotency-key", "upload-1"}
      ])

    conn = conn(method, path <> if(query == "", do: "", else: "?" <> query), body)
    {_, inner} = conn.adapter

    %{
      conn
      | req_headers: headers,
        path_params: %{
          "organization_id" => "org-a",
          "project_id" => "project-a",
          "manifest_sha256" => @digest
        },
        adapter: {Adapter, %{inner: inner, mode: Keyword.get(opts, :mode, :normal)}}
    }
  end

  defp run(conn, operation \\ :upload) do
    bearer = BearerIdentity.init(verifier: Verifier, clock: {__MODULE__, :unix_seconds, []})

    controller =
      Controller.init(
        operation: operation,
        facade: Facade,
        clock: {__MODULE__, :milliseconds, []}
      )

    conn = BearerIdentity.call(conn, bearer)
    if conn.halted, do: conn, else: Controller.call(conn, controller)
  end

  defp assert_error(conn, status, code) do
    assert conn.status == status
    assert conn.halted
    assert get_resp_header(conn, "cache-control") == ["no-store"]
    assert get_resp_header(conn, "content-type") == ["application/json; charset=utf-8"]
    assert get_resp_header(conn, "retry-after") == if(status == 503, do: ["1"], else: [])

    assert %{"error" => %{"code" => ^code, "message" => message}, "request_id" => id} =
             Jason.decode!(conn.resp_body)

    assert get_resp_header(conn, "x-request-id") == [id]
    assert byte_size(message) < 100 and byte_size(conn.resp_body) < 512
    refute conn.resp_body =~ "private"
    conn
  end

  defp no_facade do
    refute_received {:upload, _, _, _, _, _, _}
    refute_received {:read, _, _, _, _}
    refute_received {:audit, _, _, _, _, _}
  end

  test "authentication failure precedes body reads and parameter parsing" do
    conn = request(:upload, headers: [], body: "not json") |> run()
    assert_error(conn, 401, "unauthenticated")
    assert %Plug.Conn.Unfetched{} = conn.query_params
    assert %Plug.Conn.Unfetched{} = conn.body_params
    refute_received {:body_read, _}
    refute_received {:verified, _, _}
    no_facade()
  end

  test "each exact operation scope precedes query, header and body admission" do
    for operation <- [:upload, :read, :audit] do
      Process.put(
        :artifact_transport_identity,
        {:ok, identity(["mixer.artifact.*", "mixer.audit.write"])}
      )

      request(operation, query: "unknown=1", body: "secret")
      |> run(operation)
      |> assert_error(403, "permission_denied")

      assert_received {:verified, "opaque.Token", _}
      refute_received {:body_read, _}
      no_facade()
    end
  end

  test "service identities and forged plain maps cannot reach domain effects" do
    Process.put(:artifact_transport_identity, {:ok, %{identity() | identity_class: :service}})
    request() |> run() |> assert_error(403, "permission_denied")
    refute_received {:body_read, _}
    Process.put(:artifact_transport_identity, {:ok, Map.from_struct(identity())})
    request() |> run() |> assert_error(503, "identity_unavailable")
    refute_received {:body_read, _}
    no_facade()
  end

  test "upload passes only closed route, exact bytes and socket metadata then maps created result" do
    headers = [
      {"authorization", "Bearer opaque.Token"},
      {"content-type", "application/json"},
      {"idempotency-key", "upload_1.A-"},
      {"x-mixer-reason", "  preserve reason  "},
      {"forwarded", "for=203.0.113.55"},
      {"x-forwarded-for", "203.0.113.56"},
      {"cf-connecting-ip", "203.0.113.57"},
      {"x-mixer-actor", "admin"},
      {"x-mixer-request-id", "chosen-audit-id"}
    ]

    conn =
      %{request(:upload, headers: headers) | remote_ip: {0x2001, 0xDB8, 0, 0, 0, 0, 0, 1}}
      |> run()

    assert conn.status == 201
    assert Jason.decode!(conn.resp_body) == %{"artifact_sha256" => @digest, "immutable" => true}

    assert_received {:upload, %VerifiedIdentity{},
                     %{organization_id: "org-a", project_id: "project-a"}, @digest, "upload_1.A-",
                     @body, %{reason: "  preserve reason  ", source_ip: "2001:db8::1"}}

    assert %Plug.Conn.Unfetched{} = conn.body_params
    assert %Plug.Conn.Unfetched{} = conn.query_params
    assert get_resp_header(conn, "cache-control") == ["no-store"]
    assert_received {:verified, _, _}
    assert_received {:body_read, opts}
    assert Keyword.fetch!(opts, :read_timeout) == 15_000
    assert Keyword.fetch!(opts, :read_length) == 65_536
  end

  test "authorized retry retains facade original 201 or 200 status" do
    for status <- [201, 200] do
      Process.put(:artifact_transport_result, {:ok, %{status: status, manifest_sha256: @digest}})
      conn = request() |> run()
      assert conn.status == status
      assert Jason.decode!(conn.resp_body) == %{"artifact_sha256" => @digest, "immutable" => true}
    end
  end

  test "reason absent and empty use exact legacy default; UTF8 boundary preserved" do
    base = [
      {"authorization", "Bearer opaque.Token"},
      {"content-type", "application/json"},
      {"idempotency-key", "key"}
    ]

    for reason <- [nil, "", String.duplicate("é", 256)] do
      headers = if reason == nil, do: base, else: base ++ [{"x-mixer-reason", reason}]
      assert (request(:upload, headers: headers) |> run()).status == 201
      expected = if reason in [nil, ""], do: "local development operation", else: reason
      assert_received {:upload, _, _, _, _, _, %{reason: ^expected, source_ip: "127.0.0.1"}}
    end
  end

  test "duplicate, oversized or invalid UTF8 mutation reason rejects before body" do
    base = [
      {"authorization", "Bearer opaque.Token"},
      {"content-type", "application/json"},
      {"idempotency-key", "key"}
    ]

    for values <- [["same", "same"], [String.duplicate("a", 513)], [<<255>>]] do
      headers = base ++ Enum.map(values, &{"x-mixer-reason", &1})
      request(:upload, headers: headers) |> run() |> assert_error(400, "invalid_reason")
      refute_received {:body_read, _}
      no_facade()
    end
  end

  test "idempotency key enforces unique ASCII 1..128 bytes without colon" do
    base = [{"authorization", "Bearer opaque.Token"}, {"content-type", "application/json"}]

    for values <- [
          [],
          [""],
          ["same", "same"],
          ["one,two"],
          ["a:b"],
          ["é"],
          ["a b"],
          [String.duplicate("a", 129)]
        ] do
      request(:upload, headers: base ++ Enum.map(values, &{"idempotency-key", &1}))
      |> run()
      |> assert_error(400, "idempotency_required")

      refute_received {:body_read, _}
      no_facade()
    end

    assert (request(:upload, headers: base ++ [{"idempotency-key", String.duplicate("a", 128)}])
            |> run()).status == 201
  end

  test "upload requires unique exact application/json before body work" do
    base = [{"authorization", "Bearer opaque.Token"}, {"idempotency-key", "key"}]

    for values <- [
          [],
          ["text/plain"],
          ["application/json; charset=utf-8"],
          ["Application/JSON"]
        ] do
      request(:upload, headers: base ++ Enum.map(values, &{"content-type", &1}))
      |> run()
      |> assert_error(400, "content_type")

      refute_received {:body_read, _}
      no_facade()
    end

    for headers <- [
          [{"content-type", "application/json,application/json"}],
          [{"content-type", "application/json"}, {"content-type", "application/json"}]
        ] do
      request(:upload, headers: base ++ headers)
      |> run()
      |> assert_error(400, "invalid_request")

      refute_received {:body_read, _}
    end
  end

  test "any declared Content-Encoding including duplicate or identity is unsupported" do
    for values <- [["gzip"], ["identity"], [""], ["gzip", "gzip"]] do
      conn = request()

      conn = %{
        conn
        | req_headers: conn.req_headers ++ Enum.map(values, &{"content-encoding", &1})
      }

      conn |> run() |> assert_error(415, "unsupported_content_encoding")
      refute_received {:body_read, _}
      no_facade()
    end
  end

  test "route IDs and digest are bounded closed ASCII fields" do
    for field <- ["organization_id", "project_id"],
        value <- ["", "é", "a:b", "a/b", "a%2Fb", "*", String.duplicate("a", 129)] do
      conn = request()

      %{conn | path_params: Map.put(conn.path_params, field, value)}
      |> run()
      |> assert_error(400, "invalid_request")

      refute_received {:body_read, _}
      no_facade()
    end

    for digest <- [
          String.duplicate("A", 64),
          String.duplicate("a", 63),
          String.duplicate("a", 65),
          String.duplicate("g", 64)
        ] do
      conn = request()

      %{conn | path_params: Map.put(conn.path_params, "manifest_sha256", digest)}
      |> run()
      |> assert_error(400, "invalid_request")

      refute_received {:body_read, _}
      no_facade()
    end

    project = String.duplicate("a", 128)
    path = "/v3/orgs/org-a/projects/" <> project <> "/artifacts/" <> @digest
    conn = request(:upload, path: path)

    assert (%{conn | path_params: Map.put(conn.path_params, "project_id", project)}
            |> run()).status == 201
  end

  defp router_request(operation, opts \\ []) do
    conn = request(operation, opts)

    %{conn | path_params: %{}}
    |> FixtureRouter.call(FixtureRouter.init([]))
  end

  test "all canonical routes pass actual Phoenix matching before transport admission" do
    for operation <- [:upload, :read, :audit] do
      response = router_request(operation)
      assert response.status == if(operation == :upload, do: 201, else: 200)

      case operation do
        :upload -> assert_received {:upload, _, _, @digest, _, @body, _}
        :read -> assert_received {:read, _, _, @digest, _}
        :audit -> assert_received {:audit, _, _, 0, 100, _}
      end
    end
  end

  test "encoded and slash normalized aliases reject before body and facade for all operations" do
    for operation <- [:upload, :read, :audit] do
      canonical =
        if operation == :audit, do: "/v3/orgs/org-a/projects/project-a/audit", else: @path

      aliases = [
        String.replace(canonical, "/v3/", "/%76%33/"),
        String.replace(canonical, "org-a", "org%2Da"),
        String.replace(canonical, "project-a", "project%2Da"),
        String.replace(canonical, "/projects/", "//projects/"),
        canonical <> "/"
      ]

      aliases =
        if operation == :audit,
          do: aliases ++ [String.replace(canonical, "/audit", "/%61udit")],
          else:
            aliases ++
              [
                String.replace(canonical, "/artifacts/", "/%61rtifacts/"),
                String.replace(
                  canonical,
                  "/" <> @digest,
                  "/%61" <> String.slice(@digest, 1..-1//1)
                )
              ]

      for path <- aliases do
        router_request(operation, path: path) |> assert_error(400, "invalid_path")
        assert_received {:verified, "opaque.Token", _}
        refute_received {:body_read, _}
        no_facade()
      end
    end
  end

  test "raw path binding still follows identity and exact operation scope" do
    for operation <- [:upload, :read, :audit] do
      path =
        if operation == :audit,
          do: "/%76%33/orgs/org-a/projects/project-a/audit",
          else: String.replace(@path, "/v3/", "/%76%33/")

      router_request(operation, path: path, headers: []) |> assert_error(401, "unauthenticated")
      refute_received {:verified, _, _}
      refute_received {:body_read, _}
      no_facade()
      Process.put(:artifact_transport_identity, {:ok, identity([])})
      router_request(operation, path: path) |> assert_error(403, "permission_denied")
      assert_received {:verified, "opaque.Token", _}
      refute_received {:body_read, _}
      no_facade()
      Process.put(:artifact_transport_identity, {:ok, identity()})
    end
  end

  test "upload and artifact read reject any query before body reads" do
    for operation <- [:upload, :read], query <- ["x=1", "after=", "=", "&"] do
      request(operation, query: query) |> run(operation) |> assert_error(400, "invalid_request")
      refute_received {:body_read, _}
      no_facade()
    end
  end

  test "audit defaults absent and empty values and accepts bounded one-decode decimals" do
    for {query, after_sequence, limit} <- [
          {"", 0, 100},
          {"after=&limit=", 0, 100},
          {"after&limit", 0, 100},
          {"after=9007199254740991&limit=1", 9_007_199_254_740_991, 1},
          {"%61fter=%30%30%31&limit=0100", 1, 100}
        ] do
      conn = request(:audit, query: query) |> run(:audit)
      assert conn.status == 200
      assert Jason.decode!(conn.resp_body) == %{"events" => [], "next" => after_sequence}
      assert_received {:audit, _, _, ^after_sequence, ^limit, %{reason: ""}}
      assert %Plug.Conn.Unfetched{} = conn.query_params
    end
  end

  test "audit rejects duplicate unknown malformed or overflow values" do
    for query <- [
          "after=1&after=2",
          "%61fter=1&after=1",
          "limit=1&limit=1",
          "unknown=1",
          "after[]=1",
          "after=+1",
          "after=-1",
          "after=1.0",
          "after=%201",
          "after=9007199254740992",
          "after=00000000000000000",
          "limit=0",
          "limit=101",
          "limit=1e2",
          "after=%",
          "after=%ff",
          "after=%2531",
          "after=1&&limit=1",
          "after=1&",
          "=1"
        ] do
      request(:audit, query: query) |> run(:audit) |> assert_error(400, "invalid_request")
      refute_received {:body_read, _}
      no_facade()
    end
  end

  test "read and audit ignore mutation reason and untrusted actor metadata" do
    for operation <- [:read, :audit] do
      headers = [
        {"authorization", "Bearer opaque.Token"},
        {"x-mixer-reason", <<255>>},
        {"x-mixer-reason", "ignored"},
        {"x-mixer-actor", "owner"}
      ]

      assert (request(operation, headers: headers) |> run(operation)).status == 200

      if operation == :read,
        do: assert_received({:read, _, _, _, %{reason: "", source_ip: "127.0.0.1"}}),
        else: assert_received({:audit, _, _, _, _, %{reason: "", source_ip: "127.0.0.1"}})
    end
  end

  test "read emits original retained bytes with JSON media and no internal columns" do
    conn = request(:read) |> run(:read)
    assert conn.status == 200
    assert conn.resp_body == " {\"retained\":true}\n"
    assert get_resp_header(conn, "content-type") == ["application/json; charset=utf-8"]
    assert get_resp_header(conn, "cache-control") == ["no-store"]
  end

  test "audit preserves validated schema2 events without legacy actor fabrication" do
    event = %{"audit_schema" => 2, "actor" => %{"principal_id" => "principal"}, "sequence" => 7}
    Process.put(:artifact_transport_result, {:ok, %{events: [event], next_after_sequence: 7}})
    conn = request(:audit) |> run(:audit)
    assert Jason.decode!(conn.resp_body) == %{"events" => [event], "next" => 7}
  end

  test "GET and HEAD require empty actual body regardless of absent or zero Content-Length" do
    for operation <- [:read, :audit], method <- [:get, :head] do
      conn =
        request(operation,
          method: method,
          body: "x",
          headers: [{"authorization", "Bearer opaque.Token"}, {"content-length", "0"}]
        )

      # Keep GET at the adapter for JSON error assertions; HEAD wire stripping has
      # a separate assertion below and the real Bandit lane verifies sockets.
      {adapter, state} = conn.adapter
      conn = %{conn | adapter: {adapter, %{state | inner: %{state.inner | method: "GET"}}}}
      conn |> run(operation) |> assert_error(400, "invalid_request")
      no_facade()
    end
  end

  test "GET media is absent or single exact JSON after scope" do
    for operation <- [:read, :audit] do
      conn =
        request(operation,
          headers: [{"authorization", "Bearer opaque.Token"}, {"content-type", "text/plain"}]
        )

      conn |> run(operation) |> assert_error(400, "content_type")
      refute_received {:body_read, _}
      no_facade()
    end
  end

  test "body bytes at inclusive maximum pass unchanged and one byte over fails before facade" do
    padding = @maximum - byte_size(@body)
    maximum = @body <> String.duplicate(" ", padding)
    assert (request(:upload, body: maximum) |> run()).status == 201
    assert_received {:upload, _, _, _, _, ^maximum, _}
    request(:upload, body: maximum <> " ") |> run() |> assert_error(413, "body_too_large")
    no_facade()
  end

  test "partial body chunks preserve original byte order" do
    assert (request(:upload, mode: :chunks) |> run()).status == 201
    assert_received {:upload, _, _, _, _, @body, _}
  end

  test "read failures exceptions fixed deadline and chunk count reject with bounded errors" do
    for mode <- [:error, :raise, :throw, :deadline, :empty_more] do
      Process.put(:artifact_transport_milliseconds, 0)
      request(:upload, mode: mode) |> run() |> assert_error(400, "malformed_body")
      no_facade()
    end

    reads = collect_reads([])
    assert length(reads) == 132
    assert Enum.all?(reads, &(Keyword.fetch!(&1, :read_timeout) <= 15_000))
  end

  defp collect_reads(acc) do
    receive do
      {:body_read, opts} -> collect_reads([opts | acc])
    after
      0 -> acc
    end
  end

  test "invalid syntax duplicate keys UTF8 unknown and non-object envelopes are invalid_json400" do
    for bytes <- [
          "",
          "{}",
          "[]",
          "{} {}",
          ~s({"signed_manifest":[],"payload":"x"}),
          ~s({"signed_manifest":{},"payload":[]}),
          ~s({"signed_manifest":null,"payload":"x"}),
          ~s({"signed_manifest":{},"payload":null}),
          "{\"signed_manifest\":{},\"payload\":\"x\",\"extra\":true}",
          "{\"signed_manifest\":{},\"payload\":\"x\",\"payload\":\"x\"}",
          "{\"signed_manifest\":{\"x\":1,\"x\":1},\"payload\":\"x\"}",
          "{\"signed_manifest\":{},\"payload\":\"" <> <<255>> <> "\"}"
        ] do
      request(:upload, body: bytes) |> run() |> assert_error(400, "invalid_json")
      no_facade()
    end
  end

  test "facade errors map generic statuses and never leak private details" do
    for {reason, status, code} <- [
          {:invalid_request, 400, "invalid_request"},
          {:unauthenticated, 401, "unauthenticated"},
          {:permission_denied, 403, "permission_denied"},
          {:not_found, 404, "not_found"},
          {:immutable_conflict, 409, "immutable_conflict"},
          {:idempotency_conflict, 409, "idempotency_conflict"},
          {:conflict, 409, "conflict"},
          {:artifact_invalid, 422, "artifact_invalid"},
          {:digest_mismatch, 422, "digest_mismatch"},
          {:authorization_unavailable, 503, "authorization_unavailable"},
          {:storage_unavailable, 503, "storage_unavailable"},
          {{:secret, "private database credential"}, 503, "storage_unavailable"}
        ] do
      Process.put(:artifact_transport_result, {:error, reason})
      request() |> run() |> assert_error(status, code)
      assert_received {:upload, _, _, _, _, _, _}
    end

    for result <- [
          :raise,
          :throw,
          :unexpected,
          {:ok, %{status: 201, manifest_sha256: String.duplicate("b", 64)}}
        ] do
      Process.put(:artifact_transport_result, result)
      request() |> run() |> assert_error(503, "storage_unavailable")
    end
  end

  test "error metadata removes duplicate stale challenge and retry advice" do
    Process.put(:artifact_transport_result, {:error, :permission_denied})
    conn = request()

    conn = %{
      conn
      | resp_headers: [
          {"cache-control", "public"},
          {"cache-control", "max-age=999"},
          {"retry-after", "123"},
          {"retry-after", "321"},
          {"www-authenticate", "Basic"},
          {"x-request-id", "bad"},
          {"x-request-id", "also-bad"}
        ]
    }

    conn = conn |> run() |> assert_error(403, "permission_denied")
    assert get_resp_header(conn, "www-authenticate") == []
  end

  test "successful responses clear stale challenge retry and duplicate content types" do
    conn = request()

    conn = %{
      conn
      | resp_headers: [
          {"content-type", "text/plain"},
          {"content-type", "image/png"},
          {"retry-after", "999"},
          {"retry-after", "888"},
          {"www-authenticate", "Basic"},
          {"www-authenticate", "Digest"}
        ]
    }

    conn = run(conn)
    assert conn.status == 201
    assert get_resp_header(conn, "content-type") == ["application/json; charset=utf-8"]
    assert get_resp_header(conn, "www-authenticate") == []
    assert get_resp_header(conn, "retry-after") == []
    assert get_resp_header(conn, "cache-control") == ["no-store"]
  end

  test "production router protects only supported paths with existing bearer defaults" do
    for {method, path} <- [
          {:put, @path},
          {:get, @path},
          {:get, "/v3/orgs/org-a/projects/project-a/audit"}
        ] do
      conn = request(:upload, method: method, path: path, headers: [])

      conn
      |> MixerHostedWeb.Router.call(MixerHostedWeb.Router.init([]))
      |> assert_error(401, "unauthenticated")

      refute_received {:body_read, _}
      no_facade()
    end

    for {method, path} <- [
          {:post, @path},
          {:get, "/v3/orgs/org-a/projects/project-a/artifacts"},
          {:get, @path <> "/extra"}
        ] do
      assert_raise Phoenix.Router.NoRouteError, fn ->
        request(:read, method: method, path: path)
        |> MixerHostedWeb.Router.call(MixerHostedWeb.Router.init([]))
      end

      refute_received {:body_read, _}
      no_facade()
    end
  end

  test "HEAD through Plug.Head retains action authorization and adapter strips body" do
    conn = request(:read, method: :head) |> Plug.Head.call(Plug.Head.init([])) |> run(:read)
    assert conn.status == 200
    assert conn.resp_body == ""
    assert_received {:read, _, _, @digest, _}
    assert get_resp_header(conn, "cache-control") == ["no-store"]
    Process.put(:artifact_transport_identity, {:ok, identity([])})
    conn = request(:read, method: :head) |> Plug.Head.call(Plug.Head.init([])) |> run(:read)
    assert conn.status == 403
    assert conn.resp_body == ""
    no_facade()
  end

  test "init seams reject untrusted shapes and unknown dependency choices" do
    for options <- [
          [operation: :upload, facade: Facade, facade: Facade],
          [operation: :upload, facade: "module"],
          [operation: :upload, facade: Facade, repo: Facade],
          [operation: :unknown, facade: Facade]
        ] do
      assert_raise ArgumentError, fn -> Controller.init(options) end
    end

    assert_raise ArgumentError, fn ->
      CustomerArtifactRequest.init(operation: :upload, clock: {String, :not_a_clock, []})
    end

    assert Controller.init(:upload).facade == MixerHosted.CustomerArtifacts
  end
end

