defmodule MixerHosted.BrowserAuth.Protocol do
  @moduledoc """
  Bounded browser-login wire and cryptographic primitives; no provider or storage I/O.

  A parsed callback is unclaimed input. A durable owner must check and consume its
  state/browser epoch before exchanging a code or reporting provider rejection.
  Never log requests, generated URLs, cookies, tokens or returned callback values.
  """
  alias MixerHosted.BrowserAuth.Config
  @cookie "__Host-mixer-session"
  @query_keys ~w(state iss code error error_description error_uri)

  @doc "Generates 256 bits using OTP's CSPRNG; there is no caller-supplied random source."
  def random_token, do: :crypto.strong_rand_bytes(32) |> Base.url_encode64(padding: false)

  @doc "Accepts exactly canonical unpadded Base64URL encoding of 32 bytes."
  def token?(value) when is_binary(value) and byte_size(value) == 43 do
    case Base.url_decode64(value, padding: false) do
      {:ok, raw} when byte_size(raw) == 32 -> Base.url_encode64(raw, padding: false) == value
      _ -> false
    end
  end

  def token?(_), do: false

  @doc "SHA-256 lookup digest of a canonical token; plaintext custody is the caller's responsibility."
  def digest(value) do
    if token?(value),
      do: :crypto.hash(:sha256, value) |> Base.url_encode64(padding: false),
      else: {:error, :invalid_token}
  end

  def pkce_challenge(verifier) do
    case digest(verifier) do
      result when is_binary(result) -> {:ok, result}
      error -> error
    end
  end

  @doc "Builds only the fixed OIDC code/S256/query request; accepts no provider choices."
  def authorization_url(
        %Config{
          mode: :configured,
          authorization_endpoint: endpoint,
          client_id: client,
          redirect_uri: redirect
        } = config,
        values
      )
      when is_map(values) and is_binary(endpoint) and is_binary(client) and is_binary(redirect) do
    with true <- map_size(values) == 3,
         %{state: state, nonce: nonce, verifier: verifier} <- values,
         true <- token?(state) and token?(nonce),
         {:ok, challenge} <- pkce_challenge(verifier) do
      query =
        URI.encode_query([
          {"response_type", "code"},
          {"response_mode", "query"},
          {"client_id", config.client_id},
          {"redirect_uri", config.redirect_uri},
          {"scope", "openid mixer.workspace.read"},
          {"state", state},
          {"nonce", nonce},
          {"code_challenge", challenge},
          {"code_challenge_method", "S256"}
        ])

      {:ok, config.authorization_endpoint <> "?" <> query}
    else
      _ -> {:error, :invalid_request}
    end
  end

  def authorization_url(_, _), do: {:error, :invalid_request}

  @doc "max_age must already be capped to the admitted session deadline (pre-auth at most 300)."
  def session_cookie(token, max_age) when is_integer(max_age) and max_age in 1..900 do
    if token?(token),
      do:
        {:ok,
         @cookie <>
           "=" <>
           token <>
           "; Path=/; Secure; HttpOnly; SameSite=Lax; Max-Age=" <> Integer.to_string(max_age)},
      else: {:error, :invalid_token}
  end

  def session_cookie(_, _), do: {:error, :invalid_request}
  def clear_cookie, do: @cookie <> "=; Path=/; Secure; HttpOnly; SameSite=Lax; Max-Age=0"

  @doc "Reads raw duplicate-preserving headers; rejects any Authorization header or cookie ambiguity."
  def parse_session_cookie(headers) do
    with {:ok, selected} <- headers(headers),
         {:ok, cookie} <- cookies(Map.get(selected, "cookie")) do
      {:ok, cookie}
    else
      _ -> {:error, :invalid_request}
    end
  end

  @doc "Validates exact Origin and a canonical synchronizer token using OTP constant-time comparison."
  def verify_csrf(%Config{mode: :configured, public_origin: origin}, raw_headers, expected)
      when is_binary(origin) do
    with true <- token?(expected),
         {:ok, selected} <- headers(raw_headers),
         ^origin <- Map.get(selected, "origin"),
         actual when is_binary(actual) <- Map.get(selected, "x-mixer-csrf"),
         true <- token?(actual),
         true <- :crypto.hash_equals(expected, actual),
         {:ok, cookie} when is_binary(cookie) <- cookies(Map.get(selected, "cookie")) do
      :ok
    else
      _ -> {:error, :invalid_csrf}
    end
  end

  def verify_csrf(_, _, _), do: {:error, :invalid_csrf}

  @doc "Parses only GET-query callback contents; caller must separately enforce method and exact route."
  def parse_callback(config, query, body \\ "")

  def parse_callback(%Config{mode: :configured, issuer: issuer}, query, "")
      when is_binary(issuer) and is_binary(query) and byte_size(query) in 1..8192 do
    with {:ok, fields} <- query_fields(query, %{}, 0),
         state when is_binary(state) <- fields["state"],
         true <- token?(state),
         ^issuer <- fields["iss"],
         {:ok, outcome} <- outcome(fields) do
      {:ok, %{state: state, issuer: issuer, outcome: outcome}}
    else
      _ -> {:error, :invalid_callback}
    end
  end

  def parse_callback(_, _, _), do: {:error, :invalid_callback}

  # At most 64 raw header pairs and 16 KiB are walked once. Sensitive header
  # names are case-insensitive; duplicates are rejected before any projection.
  defp headers(value), do: headers(value, %{}, 0, 0)
  defp headers([], selected, _, _), do: {:ok, selected}

  defp headers([{name, value} | rest], selected, count, bytes)
       when is_binary(name) and is_binary(value) and count < 64 and
              byte_size(name) in 1..128 and byte_size(value) <= 8192 do
    size = bytes + byte_size(name) + byte_size(value)

    with true <- size <= 16_384,
         true <- ascii?(name, &(&1 in ?a..?z or &1 in ?A..?Z or &1 in ?0..?9 or &1 == ?-)),
         true <- ascii?(value, &(&1 in 32..126)),
         lower = String.downcase(name),
         false <- lower == "authorization",
         false <- Map.has_key?(selected, lower) do
      headers(rest, Map.put(selected, lower, value), count + 1, size)
    else
      _ -> :error
    end
  end

  defp headers(_, _, _, _), do: :error

  defp cookies(nil), do: {:ok, nil}
  defp cookies(value) when byte_size(value) in 1..8192, do: cookie_pairs(value, %{}, 0)
  defp cookies(_), do: :error

  defp cookie_pairs(raw, seen, count) when count < 32 do
    {pair, rest} = split_first(raw, ";")
    pair = String.trim(pair, " ")

    with {name, value} when is_binary(value) <- split_first(pair, "="),
         true <- name != "" and byte_size(name) <= 128,
         true <- ascii?(name, &(&1 in ?a..?z or &1 in ?A..?Z or &1 in ?0..?9 or &1 in ~c"-_")),
         false <- Map.has_key?(seen, name),
         true <- cookie_octets?(value),
         true <- name != @cookie or token?(value) do
      next = Map.put(seen, name, value)

      if rest == nil,
        do: {:ok, Map.get(next, @cookie)},
        else: cookie_pairs(rest, next, count + 1)
    else
      _ -> :error
    end
  end

  defp cookie_pairs(_, _, _), do: :error

  defp cookie_octets?(value),
    do:
      ascii?(
        value,
        &(&1 == 0x21 or &1 in 0x23..0x2B or &1 in 0x2D..0x3A or &1 in 0x3C..0x5B or
            &1 in 0x5D..0x7E)
      )

  # Raw key names are exact ASCII: encoded aliases never become a recognized
  # key. Values have exactly one bounded form decode. Canonical state additionally
  # forbids percent/plus encoding; issuer is compared byte-for-byte after decode.
  defp query_fields(raw, fields, count) when count < 6 do
    {pair, rest} = split_first(raw, "&")

    with {name, encoded} when is_binary(encoded) <- split_first(pair, "="),
         true <- name in @query_keys,
         false <- Map.has_key?(fields, name),
         true <- byte_size(encoded) <= encoded_limit(name),
         true <- name != "state" or token?(encoded),
         {:ok, decoded} <- form_decode(encoded, [], 0, decoded_limit(name)),
         true <- decoded != "" do
      next = Map.put(fields, name, decoded)

      if rest == nil,
        do: {:ok, next},
        else: query_fields(rest, next, count + 1)
    else
      _ -> :error
    end
  end

  defp query_fields(_, _, _), do: :error
  defp decoded_limit("state"), do: 43
  defp decoded_limit("code"), do: 4096
  defp decoded_limit("iss"), do: 2048
  defp decoded_limit("error"), do: 128
  defp decoded_limit("error_description"), do: 1024
  defp decoded_limit("error_uri"), do: 2048
  defp encoded_limit(name), do: decoded_limit(name) * 3

  defp form_decode(<<>>, acc, _, _), do: {:ok, acc |> Enum.reverse() |> :erlang.list_to_binary()}
  defp form_decode(_, _, count, limit) when count >= limit, do: :error

  defp form_decode(<<?%, a, b, rest::binary>>, acc, count, limit) do
    with x when is_integer(x) <- hex(a),
         y when is_integer(y) <- hex(b),
         byte = x * 16 + y,
         true <- byte in 32..126 do
      form_decode(rest, [byte | acc], count + 1, limit)
    else
      _ -> :error
    end
  end

  defp form_decode(<<?%, _::binary>>, _, _, _), do: :error

  defp form_decode(<<?+, rest::binary>>, acc, count, limit),
    do: form_decode(rest, [32 | acc], count + 1, limit)

  defp form_decode(<<byte, rest::binary>>, acc, count, limit)
       when byte in 0x21..0x7E and byte not in ~c"#;\\\"<>" do
    form_decode(rest, [byte | acc], count + 1, limit)
  end

  defp form_decode(_, _, _, _), do: :error
  defp hex(byte) when byte in ?0..?9, do: byte - ?0
  defp hex(byte) when byte in ?a..?f, do: byte - ?a + 10
  defp hex(byte) when byte in ?A..?F, do: byte - ?A + 10
  defp hex(_), do: :error

  defp outcome(%{"code" => code} = fields) when map_size(fields) == 3 do
    if Map.keys(fields) |> Enum.sort() == ~w(code iss state),
      do: {:ok, {:code, code}},
      else: :error
  end

  defp outcome(%{"error" => error} = fields) do
    if not Map.has_key?(fields, "code") and map_size(fields) in 3..5 and
         ascii?(error, &(&1 == 0x20 or &1 == 0x21 or &1 in 0x23..0x5B or &1 in 0x5D..0x7E)),
       do: {:ok, {:error, :provider_rejected}},
       else: :error
  end

  defp outcome(_), do: :error

  defp split_first(raw, separator) do
    case :binary.match(raw, separator) do
      {position, 1} ->
        {binary_part(raw, 0, position),
         binary_part(raw, position + 1, byte_size(raw) - position - 1)}

      :nomatch ->
        {raw, nil}
    end
  end

  defp ascii?(<<>>, _), do: true
  defp ascii?(<<byte, rest::binary>>, check), do: check.(byte) and ascii?(rest, check)
end

60be0d57896496f323701fa6684ad02397ce0924 blob 47573
defmodule MixerHosted.BrowserAuth.RelationCatalog do
  @moduledoc """
  Bounded private relation prerequisite. The trusted Store must independently own
  the Repo, checkout, original deadline, function prerequisite and rollback.
  This function is not a storage/readiness/owner admission receipt.
  """
  alias MixerHosted.BrowserAuth.RelationManifest
  @roles [:lifecycle_login, :writer, :relation_owner, :ordinary_runtime_login]
  @marker "__mixer_relation_bound__"
  @wire_limit 2 * 1024 * 1024
  @function_settings [
    "search_path=pg_catalog",
    "statement_timeout=5s",
    "lock_timeout=500ms",
    "idle_in_transaction_session_timeout=5s",
    "bytea_output=hex"
  ]

  defmodule Unavailable do
    @moduledoc false
    defexception message: "browser storage unavailable"
  end

  @doc false
  def check_relation_surface!(repo, expected_roles, original_monotonic_deadline_ms) do
    try do
      check_roles!(expected_roles)
      deadline = original_monotonic_deadline_ms
      remaining!(deadline)
      demand(is_atom(repo) and repo.in_transaction?() === true)
      state = %{repo: repo, deadline: deadline, wire: 0, backend: nil}
      {context, state} = context!(state, expected_roles)
      {role_oids, state} = roles!(state, expected_roles)
      manifest = RelationManifest.for_major(context.major)
      {relations, state} = relations!(state, role_oids)
      ids = Enum.map(relations, & &1["oid"])
      {columns, state} = columns!(state, ids, manifest)
      {constraints, state} = constraints!(state, ids, columns, manifest)
      {indexes, state} = indexes!(state, ids, columns, constraints, manifest, role_oids)
      {_, state} = triggers!(state, ids, constraints, indexes, manifest, role_oids)
      {_, state} = policies!(state, ids, manifest, role_oids)
      {_, state} = privileges!(state, ids, columns, manifest, role_oids, context.major)
      {_, state} = forbidden!(state, ids, role_oids, context.major)
      remaining!(state.deadline)
      :relation_surface_verified
    rescue
      _ -> raise Unavailable
    catch
      _, _ -> raise Unavailable
    end
  end

  defp demand(true), do: :ok
  defp demand(_), do: raise(Unavailable)

  defp check_roles!(roles) do
    demand(
      is_map(roles) and map_size(roles) == 4 and Enum.sort(Map.keys(roles)) == Enum.sort(@roles)
    )

    values = Map.values(roles)
    demand(length(Enum.uniq(values)) == 4 and Enum.all?(values, &role?/1))
  end

  defp role?(name) when is_binary(name) and byte_size(name) in 1..63 do
    name != "public" and not String.starts_with?(name, "pg_") and
      Enum.all?(Enum.with_index(:binary.bin_to_list(name)), fn {c, i} ->
        c in ?a..?z or c == ?_ or (i > 0 and c in ?0..?9)
      end)
  end

  defp role?(_), do: false

  defp remaining!(deadline) when is_integer(deadline) do
    remaining = deadline - System.monotonic_time(:millisecond)
    demand(remaining > 0 and remaining <= 5_000)
    remaining
  end

  defp remaining!(_), do: raise(Unavailable)

  # Closed wire shapes. Nullability is explicit; false never stands for NULL.
  defp fetch!(state, sql, params, schema, cap, expected_count) do
    remaining = remaining!(state.deadline)

    result =
      Ecto.Adapters.SQL.query!(state.repo, sql, params,
        timeout: remaining,
        queue: false,
        log: false
      )

    remaining!(state.deadline)

    %Postgrex.Result{
      command: :select,
      columns: names,
      rows: rows,
      num_rows: count,
      connection_id: backend,
      messages: []
    } = result

    demand(
      is_integer(backend) and backend > 0 and (is_nil(state.backend) or state.backend === backend)
    )

    state = %{state | backend: backend}
    demand(names === Enum.map(schema, &elem(&1, 0)))
    demand(is_list(rows) and is_integer(count) and count == length(rows) and count <= cap)
    demand(is_nil(expected_count) or count == expected_count)

    {decoded, state} =
      Enum.map_reduce(rows, state, fn row, acc ->
        remaining!(acc.deadline)
        demand(is_list(row) and length(row) == length(schema))

        {fields, bytes} =
          Enum.map_reduce(Enum.zip(schema, row), 0, fn {{name, type}, value}, sum ->
            size = typed!(value, type)
            {{name, value}, sum + 4 + size}
          end)

        next = %{acc | wire: acc.wire + bytes}
        demand(next.wire <= @wire_limit)
        remaining!(next.deadline)
        {Map.new(fields), next}
      end)

    remaining!(state.deadline)
    {decoded, state}
  end

  defp typed!(nil, {:nullable, _}), do: 0
  defp typed!(value, {:nullable, type}), do: typed!(value, type)
  defp typed!(value, :bool) when is_boolean(value), do: 1
  defp typed!(value, :int) when is_integer(value), do: 8
  defp typed!(value, :oid) when is_integer(value) and value >= 0 and value <= 4_294_967_295, do: 8

  defp typed!(value, {:text, cap}) when is_binary(value) do
    demand(byte_size(value) <= cap and String.valid?(value) and value != @marker)
    byte_size(value)
  end

  defp typed!(value, {:array, type, cap}) when is_list(value) do
    demand(length(value) <= cap)
    Enum.reduce(value, 20, fn x, n -> n + 4 + typed!(x, type) end)
  end

  defp typed!(_, _), do: raise(Unavailable)

  defp expr(node, relation) do
    "CASE WHEN #{node} IS NULL THEN NULL WHEN pg_catalog.octet_length(#{node}::pg_catalog.text)>32768 THEN '#{@marker}' ELSE CASE WHEN pg_catalog.octet_length(pg_catalog.pg_get_expr(#{node},#{relation},false))>8192 THEN '#{@marker}' ELSE pg_catalog.pg_get_expr(#{node},#{relation},false) END END"
  end

  defp acl_ok(acl) do
    "(#{acl} IS NULL OR (pg_catalog.cardinality(#{acl})<=64 AND pg_catalog.octet_length(#{acl}::pg_catalog.text)<=16384))"
  end

  defp context!(state, roles) do
    schema = [
      {"login", {:text, 63}},
      {"session", {:text, 63}},
      {"version", :int},
      {"isolation", {:text, 32}},
      {"path", {:text, 128}},
      {"jit", {:text, 8}},
      {"statement", {:text, 32}},
      {"lock", {:text, 32}},
      {"idle", {:text, 32}},
      {"bytea", {:text, 8}},
      {"replication", {:text, 16}},
      {"encoding", {:text, 16}},
      {"collate", {:text, 128}},
      {"ctype", {:text, 128}},
      {"provider", {:text, 8}},
      {"stored_version", {:nullable, {:text, 256}}},
      {"actual_version", {:nullable, {:text, 256}}}
    ]

    sql = """
    SELECT current_user::pg_catalog.text AS login, session_user::pg_catalog.text AS session,
      pg_catalog.current_setting('server_version_num')::pg_catalog.int4 AS version,
      pg_catalog.current_setting('transaction_isolation') AS isolation,
      pg_catalog.current_setting('search_path') AS path, pg_catalog.current_setting('jit') AS jit,
      pg_catalog.current_setting('statement_timeout') AS statement, pg_catalog.current_setting('lock_timeout') AS lock,
      pg_catalog.current_setting('idle_in_transaction_session_timeout') AS idle,
      pg_catalog.current_setting('bytea_output') AS bytea, pg_catalog.current_setting('session_replication_role') AS replication,
      pg_catalog.current_setting('server_encoding') AS encoding, d.datcollate::pg_catalog.text AS collate,
      d.datctype::pg_catalog.text AS ctype, d.datlocprovider::pg_catalog.text AS provider,
      d.datcollversion::pg_catalog.text AS stored_version,
      pg_catalog.pg_database_collation_actual_version(d.oid)::pg_catalog.text AS actual_version
    FROM pg_catalog.pg_database d WHERE d.datname=pg_catalog.current_database() LIMIT 2
    """

    {[row], state} = fetch!(state, sql, [], schema, 1, 1)
    demand(row["login"] === roles.lifecycle_login and row["session"] === roles.lifecycle_login)
    major = div(row["version"], 10_000)
    demand(major in [16, 17])

    demand(
      Map.drop(row, ["login", "session", "version"]) === %{
        "isolation" => "read committed",
        "path" => "pg_catalog",
        "jit" => "off",
        "statement" => "5s",
        "lock" => "500ms",
        "idle" => "5s",
        "bytea" => "hex",
        "replication" => "origin",
        "encoding" => "UTF8",
        "collate" => "C",
        "ctype" => "C",
        "provider" => "c",
        "stored_version" => nil,
        "actual_version" => nil
      }
    )

    {%{major: major}, state}
  end

  defp roles!(state, roles) do
    schema = [
      {"name", {:text, 63}},
      {"oid", :oid},
      {"login", :bool},
      {"unsafe", :bool},
      {"edges", :bool}
    ]

    sql = """
    SELECT r.rolname::pg_catalog.text AS name, r.oid::pg_catalog.int8 AS oid, r.rolcanlogin AS login,
      (r.rolsuper OR r.rolbypassrls OR r.rolcreaterole OR r.rolcreatedb OR r.rolreplication OR r.rolinherit) AS unsafe,
      EXISTS(SELECT 1 FROM pg_catalog.pg_auth_members m WHERE m.roleid=r.oid OR m.member=r.oid) AS edges
    FROM pg_catalog.pg_roles r WHERE r.rolname=ANY($1::pg_catalog.text[]) ORDER BY r.oid LIMIT 5
    """

    {rows, state} = fetch!(state, sql, [Map.values(roles)], schema, 4, 4)
    names = Map.new(rows, &{&1["name"], &1})

    for key <- @roles do
      row = Map.fetch!(names, roles[key])
      demand(row["oid"] > 0 and not row["unsafe"] and not row["edges"])
      demand(row["login"] === key in [:lifecycle_login, :ordinary_runtime_login])
    end

    {Map.new(@roles, &{&1, Map.fetch!(names, roles[&1])["oid"]}), state}
  end

  defp relations!(state, roles) do
    schema = [
      {"name", {:text, 127}},
      {"oid", :oid},
      {"kind", {:text, 1}},
      {"persistence", {:text, 1}},
      {"owner", :oid},
      {"rls", :bool},
      {"force", :bool},
      {"partition", :bool},
      {"typed", :oid},
      {"replica", {:text, 1}},
      {"bound", {:nullable, {:text, 8192}}},
      {"acl_ok", :bool}
    ]

    sql = """
    SELECT n.nspname::pg_catalog.text||'.'||c.relname::pg_catalog.text AS name, c.oid::pg_catalog.int8 AS oid,
      c.relkind::pg_catalog.text AS kind,c.relpersistence::pg_catalog.text AS persistence,c.relowner::pg_catalog.int8 AS owner,
      c.relrowsecurity AS rls,c.relforcerowsecurity AS force,c.relispartition AS partition,c.reloftype::pg_catalog.int8 AS typed,
      c.relreplident::pg_catalog.text AS replica,#{expr("c.relpartbound", "c.oid")} AS bound,#{acl_ok("c.relacl")} AS acl_ok
    FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
    WHERE (n.nspname='public' AND n.nspname::pg_catalog.text||'.'||c.relname::pg_catalog.text=ANY($1::pg_catalog.text[]))
       OR (pg_catalog.left(c.relname::pg_catalog.text,14)='mixer_browser_' AND c.relkind IN('r','p','v','m','f'))
    ORDER BY n.nspname,c.relname,c.oid LIMIT 10
    """

    {rows, state} = fetch!(state, sql, [RelationManifest.names()], schema, 9, 9)
    demand(Enum.sort(Enum.map(rows, & &1["name"])) === RelationManifest.names())
    demand(length(Enum.uniq(Enum.map(rows, & &1["oid"]))) == 9)

    each!(rows, state, fn r ->
      demand(
        r["oid"] > 0 and
          Map.drop(r, ["name", "oid"]) === %{
            "kind" => "r",
            "persistence" => "p",
            "owner" => roles.relation_owner,
            "rls" => true,
            "force" => true,
            "partition" => false,
            "typed" => 0,
            "replica" => "d",
            "bound" => nil,
            "acl_ok" => true
          }
      )
    end)

    {rows, state}
  end

  defp each!(rows, state, fun) do
    Enum.each(rows, fn row ->
      remaining!(state.deadline)
      fun.(row)
      remaining!(state.deadline)
    end)
  end

  defp names_cte do
    "WITH targets AS (SELECT c.oid,n.nspname::pg_catalog.text||'.'||c.relname::pg_catalog.text AS name FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace WHERE c.oid=ANY($1::pg_catalog.oid[])) "
  end

  defp columns!(state, ids, manifest) do
    schema = [
      {"relation", {:text, 127}},
      {"relid", :oid},
      {"number", :int},
      {"name", {:text, 63}},
      {"dropped", :bool},
      {"type_oid", :oid},
      {"type", {:text, 127}},
      {"base", :oid},
      {"type_kind", {:text, 1}},
      {"typmod", :int},
      {"dimensions", :int},
      {"notnull", :bool},
      {"identity", {:text, 1}},
      {"generated", {:text, 1}},
      {"local", :bool},
      {"inherited", :int},
      {"has_default", :bool},
      {"default", {:nullable, {:text, 8192}}},
      {"has_missing", :bool},
      {"missing", {:nullable, {:text, 16384}}},
      {"collation_oid", :oid},
      {"collation", {:nullable, {:text, 127}}},
      {"collation_safe", :bool},
      {"acl_null", :bool},
      {"acl_ok", :bool}
    ]

    sql =
      names_cte() <>
        """
        SELECT x.name AS relation,a.attrelid::pg_catalog.int8 AS relid,a.attnum::pg_catalog.int4 AS number,
          a.attname::pg_catalog.text AS name,a.attisdropped AS dropped,a.atttypid::pg_catalog.int8 AS type_oid,
          tn.nspname::pg_catalog.text||'.'||t.typname::pg_catalog.text AS type,t.typbasetype::pg_catalog.int8 AS base,
          t.typtype::pg_catalog.text AS type_kind,a.atttypmod AS typmod,a.attndims AS dimensions,a.attnotnull AS notnull,
          a.attidentity::pg_catalog.text AS identity,a.attgenerated::pg_catalog.text AS generated,a.attislocal AS local,
          a.attinhcount AS inherited,a.atthasdef AS has_default,#{expr("d.adbin", "a.attrelid")} AS default,
          a.atthasmissing AS has_missing,
          CASE WHEN a.attmissingval IS NULL THEN NULL WHEN pg_catalog.cardinality(a.attmissingval)>1 OR pg_catalog.octet_length(a.attmissingval::pg_catalog.text)>16384 THEN '#{@marker}' ELSE a.attmissingval::pg_catalog.text END AS missing,
          a.attcollation::pg_catalog.int8 AS collation_oid,
          CASE WHEN a.attcollation=0 THEN NULL ELSE cn.nspname::pg_catalog.text||'.'||co.collname::pg_catalog.text END AS collation,
          (a.attcollation=0 OR (co.collprovider='d' AND co.collisdeterministic AND co.collencoding=-1 AND co.collcollate IS NULL AND co.collctype IS NULL AND co.collversion IS NULL)) AS collation_safe,
          a.attacl IS NULL AS acl_null,#{acl_ok("a.attacl")} AS acl_ok
        FROM targets x JOIN pg_catalog.pg_attribute a ON a.attrelid=x.oid
        JOIN pg_catalog.pg_type t ON t.oid=a.atttypid JOIN pg_catalog.pg_namespace tn ON tn.oid=t.typnamespace
        LEFT JOIN pg_catalog.pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum
        LEFT JOIN pg_catalog.pg_collation co ON co.oid=a.attcollation LEFT JOIN pg_catalog.pg_namespace cn ON cn.oid=co.collnamespace
        WHERE a.attnum>0 ORDER BY x.name,a.attnum LIMIT 125
        """

    {rows, state} = fetch!(state, sql, [ids], schema, 124, 124)

    types = %{
      "integer" => "int4",
      "bigint" => "int8",
      "boolean" => "bool",
      "bytea" => "bytea",
      "text" => "text"
    }

    each!(Map.to_list(manifest["structure"]["relations"]), state, fn {rel, spec} ->
      actual = Enum.filter(rows, &(&1["relation"] == rel))
      demand(length(actual) == length(spec["columns"]))

      each!(Enum.with_index(Enum.zip(actual, spec["columns"]), 1), state, fn {{r, c}, i} ->
        typ = Map.fetch!(types, c["type"])

        demand(
          r["name"] === c["name"] and r["number"] === i and r["type"] === "pg_catalog." <> typ and
            r["type_oid"] > 0
        )

        demand(
          not r["dropped"] and r["base"] == 0 and r["type_kind"] == "b" and r["typmod"] == -1 and
            r["dimensions"] == 0
        )

        demand(
          r["notnull"] === not c["nullable"] and r["identity"] == "" and r["generated"] == "" and
            r["local"] and r["inherited"] == 0
        )

        demand(r["default"] === c["default"] and r["has_default"] === not is_nil(c["default"]))

        fast =
          {rel, c["name"]} in [
            {"public.mixer_authz_profiles", "state_revision"},
            {"public.mixer_authz_bindings", "revision"}
          ]

        demand(
          (not r["has_missing"] and is_nil(r["missing"])) or
            (fast and r["has_missing"] and r["missing"] == "{1}")
        )

        demand(
          r["collation_safe"] and
            r["collation"] === if(typ == "text", do: "pg_catalog.default", else: nil)
        )

        demand(r["collation_oid"] > 0 === (typ == "text") and r["acl_ok"])
        mutable = c["name"] in manifest["structure"]["writer_grants"][rel]["update_columns"]
        demand(r["acl_null"] === not mutable)
      end)
    end)

    {rows, state}
  end

  defp key_names(array, rel) do
    "CASE WHEN pg_catalog.cardinality(#{array})>32 THEN ARRAY['#{@marker}']::pg_catalog.text[] ELSE ARRAY(SELECT a.attname::pg_catalog.text FROM pg_catalog.unnest(#{array}) WITH ORDINALITY k(num,ord) LEFT JOIN pg_catalog.pg_attribute a ON a.attrelid=#{rel} AND a.attnum=k.num ORDER BY k.ord) END"
  end

  defp operators(array) do
    "CASE WHEN pg_catalog.cardinality(#{array})>32 THEN ARRAY['#{@marker}']::pg_catalog.text[] ELSE ARRAY(SELECT n.nspname::pg_catalog.text||'.'||o.oprname::pg_catalog.text||':'||ln.nspname::pg_catalog.text||'.'||l.typname::pg_catalog.text||':'||rn.nspname::pg_catalog.text||'.'||r.typname::pg_catalog.text FROM pg_catalog.unnest(#{array}) WITH ORDINALITY k(id,ord) LEFT JOIN pg_catalog.pg_operator o ON o.oid=k.id LEFT JOIN pg_catalog.pg_namespace n ON n.oid=o.oprnamespace LEFT JOIN pg_catalog.pg_type l ON l.oid=o.oprleft LEFT JOIN pg_catalog.pg_namespace ln ON ln.oid=l.typnamespace LEFT JOIN pg_catalog.pg_type r ON r.oid=o.oprright LEFT JOIN pg_catalog.pg_namespace rn ON rn.oid=r.typnamespace ORDER BY k.ord) END"
  end

  defp constraints!(state, ids, columns, manifest) do
    schema = [
      {"oid", :oid},
      {"relid", :oid},
      {"relation", {:text, 127}},
      {"kind", {:text, 1}},
      {"deferrable", :bool},
      {"deferred", :bool},
      {"validated", :bool},
      {"local", :bool},
      {"inherited", :int},
      {"noinherit", :bool},
      {"parent", :oid},
      {"domain", :oid},
      {"target_oid", :oid},
      {"target", {:nullable, {:text, 127}}},
      {"keys", {:array, {:text, 63}, 32}},
      {"target_keys", {:array, {:text, 63}, 32}},
      {"match", {:text, 1}},
      {"update", {:text, 1}},
      {"delete", {:text, 1}},
      {"index", :oid},
      {"pfeq", {:array, {:text, 256}, 32}},
      {"ppeq", {:array, {:text, 256}, 32}},
      {"ffeq", {:array, {:text, 256}, 32}},
      {"expression", {:nullable, {:text, 8192}}},
      {"excluded", :bool},
      {"delete_columns", :bool}
    ]

    sql =
      names_cte() <>
        """
        SELECT c.oid::pg_catalog.int8 AS oid,c.conrelid::pg_catalog.int8 AS relid,
          n.nspname::pg_catalog.text||'.'||r.relname::pg_catalog.text AS relation,c.contype::pg_catalog.text AS kind,
          c.condeferrable AS deferrable,c.condeferred AS deferred,c.convalidated AS validated,c.conislocal AS local,
          c.coninhcount AS inherited,c.connoinherit AS noinherit,c.conparentid::pg_catalog.int8 AS parent,c.contypid::pg_catalog.int8 AS domain,
          c.confrelid::pg_catalog.int8 AS target_oid,
          CASE WHEN c.confrelid=0 THEN NULL ELSE tn.nspname::pg_catalog.text||'.'||tr.relname::pg_catalog.text END AS target,
          #{key_names("c.conkey", "c.conrelid")} AS keys,#{key_names("c.confkey", "c.confrelid")} AS target_keys,
          c.confmatchtype::pg_catalog.text AS match,c.confupdtype::pg_catalog.text AS update,c.confdeltype::pg_catalog.text AS delete,
          c.conindid::pg_catalog.int8 AS index,#{operators("c.conpfeqop")} AS pfeq,#{operators("c.conppeqop")} AS ppeq,
          #{operators("c.conffeqop")} AS ffeq,#{expr("c.conbin", "c.conrelid")} AS expression,
          c.conexclop IS NOT NULL AS excluded,c.confdelsetcols IS NOT NULL AS delete_columns
        FROM pg_catalog.pg_constraint c JOIN pg_catalog.pg_class r ON r.oid=c.conrelid JOIN pg_catalog.pg_namespace n ON n.oid=r.relnamespace
        LEFT JOIN pg_catalog.pg_class tr ON tr.oid=c.confrelid LEFT JOIN pg_catalog.pg_namespace tn ON tn.oid=tr.relnamespace
        WHERE c.conrelid IN(SELECT oid FROM targets) OR c.confrelid IN(SELECT oid FROM targets)
        ORDER BY c.oid LIMIT 110
        """

    {rows, state} = fetch!(state, sql, [ids], schema, 109, 109)
    demand(length(Enum.uniq(Enum.map(rows, & &1["oid"]))) == 109)

    demand(
      Enum.frequencies(Enum.map(rows, & &1["kind"])) === %{
        "c" => 80,
        "p" => 9,
        "u" => 4,
        "f" => 12,
        "t" => 4
      }
    )

    each!(rows, state, fn r ->
      trigger = r["kind"] == "t"

      demand(
        r["oid"] > 0 and r["local"] and r["validated"] and r["inherited"] == 0 and
          r["parent"] == 0 and r["domain"] == 0
      )

      demand(
        r["deferrable"] === trigger and r["deferred"] === trigger and
          r["noinherit"] === (r["kind"] != "c")
      )

      demand(not r["excluded"] and not r["delete_columns"])

      if r["kind"] != "f" do
        demand(
          r["target_oid"] == 0 and is_nil(r["target"]) and r["target_keys"] == [] and
            r["pfeq"] == [] and r["ppeq"] == [] and r["ffeq"] == []
        )

        demand(r["match"] == " " and r["update"] == " " and r["delete"] == " ")
      end

      if r["kind"] in ["c", "t"], do: demand(r["index"] == 0)
      if r["kind"] != "c", do: demand(is_nil(r["expression"]))
      if trigger, do: demand(r["keys"] == [])
    end)

    actual_checks =
      for r <- rows, r["kind"] == "c", do: {r["relation"], r["expression"], r["keys"]}

    expected_checks =
      for r <- manifest["check_keys"], do: {r["relation"], r["expression"], r["columns"]}

    demand(Enum.frequencies(actual_checks) === Enum.frequencies(expected_checks))

    each!(rows, state, fn r ->
      matching = Enum.filter(columns, &(&1["relation"] == r["relation"]))
      if matching != [], do: demand(Enum.all?(matching, &(&1["relid"] == r["relid"])))
    end)

    actual_keys =
      for r <- rows, r["kind"] in ["p", "u"], do: {r["relation"], r["kind"], r["keys"]}

    expected_keys =
      Enum.flat_map(manifest["structure"]["relations"], fn {rel, spec} ->
        [{rel, "p", spec["primary_key"]}] ++ Enum.map(spec["unique"], &{rel, "u", &1})
      end)

    demand(Enum.frequencies(actual_keys) === Enum.frequencies(expected_keys))

    expected_fks =
      Enum.flat_map(manifest["structure"]["relations"], fn {rel, spec} ->
        Enum.map(
          spec["foreign_keys"],
          &{rel, &1["columns"], &1["relation"], &1["referenced_columns"]}
        )
      end) ++
        Enum.map(
          manifest["structure"]["incoming_foreign_keys"],
          &{&1["source_relation"], &1["columns"], &1["relation"], &1["referenced_columns"]}
        )

    fks = Enum.filter(rows, &(&1["kind"] == "f"))

    demand(
      Enum.frequencies(
        Enum.map(fks, &{&1["relation"], &1["keys"], &1["target"], &1["target_keys"]})
      ) === Enum.frequencies(expected_fks)
    )

    each!(fks, state, fn r ->
      demand(r["match"] == "s" and r["update"] == "a" and r["delete"] == "a" and r["index"] > 0)

      eqs =
        Enum.map(r["target_keys"], fn key ->
          c = Enum.find(columns, &(&1["relid"] == r["target_oid"] and &1["name"] == key))
          demand(not is_nil(c))
          "pg_catalog.=:" <> c["type"] <> ":" <> c["type"]
        end)

      demand(r["pfeq"] === eqs and r["ppeq"] === eqs and r["ffeq"] === eqs)

      demand(
        Enum.all?(columns, fn c -> c["relation"] != r["relation"] or c["relid"] == r["relid"] end)
      )
    end)

    {rows, state}
  end

  defp bounded_array(array, select) do
    "CASE WHEN pg_catalog.cardinality(#{array})>32 THEN ARRAY['#{@marker}']::pg_catalog.text[] ELSE ARRAY(#{select}) END"
  end

  defp indexes!(state, ids, columns, constraints, manifest, roles) do
    schema = [
      {"oid", :oid},
      {"relid", :oid},
      {"relation", {:text, 127}},
      {"name", {:text, 63}},
      {"namespace", {:text, 63}},
      {"owner", :oid},
      {"method", {:text, 63}},
      {"natts", :int},
      {"nkeys", :int},
      {"unique", :bool},
      {"primary", :bool},
      {"nulls", :bool},
      {"exclusion", :bool},
      {"immediate", :bool},
      {"clustered", :bool},
      {"valid", :bool},
      {"xmin", :bool},
      {"ready", :bool},
      {"live", :bool},
      {"replica", :bool},
      {"keys", {:array, {:text, 63}, 32}},
      {"opclasses", {:array, {:text, 256}, 32}},
      {"collations", {:array, {:nullable, {:text, 127}}, 32}},
      {"collation_oids", {:array, :oid, 32}},
      {"options", {:array, :int, 32}},
      {"expression", {:nullable, {:text, 8192}}},
      {"predicate", {:nullable, {:text, 8192}}},
      {"kind", {:text, 1}},
      {"partition", :bool},
      {"persistence", {:text, 1}},
      {"inheritance", :bool}
    ]

    ops =
      bounded_array(
        "i.indclass::pg_catalog.oid[]",
        "SELECT n.nspname::pg_catalog.text||'.'||o.opcname::pg_catalog.text||':'||tn.nspname::pg_catalog.text||'.'||t.typname::pg_catalog.text||':'||fn.nspname::pg_catalog.text||'.'||f.opfname::pg_catalog.text FROM pg_catalog.unnest(i.indclass::pg_catalog.oid[]) WITH ORDINALITY k(id,ord) LEFT JOIN pg_catalog.pg_opclass o ON o.oid=k.id LEFT JOIN pg_catalog.pg_namespace n ON n.oid=o.opcnamespace LEFT JOIN pg_catalog.pg_type t ON t.oid=o.opcintype LEFT JOIN pg_catalog.pg_namespace tn ON tn.oid=t.typnamespace LEFT JOIN pg_catalog.pg_opfamily f ON f.oid=o.opcfamily LEFT JOIN pg_catalog.pg_namespace fn ON fn.oid=f.opfnamespace WHERE o.opcmethod=c.relam AND f.opfmethod=c.relam ORDER BY k.ord"
      )

    colls =
      bounded_array(
        "i.indcollation::pg_catalog.oid[]",
        "SELECT CASE WHEN k.id=0 THEN NULL ELSE n.nspname::pg_catalog.text||'.'||c.collname::pg_catalog.text END FROM pg_catalog.unnest(i.indcollation::pg_catalog.oid[]) WITH ORDINALITY k(id,ord) LEFT JOIN pg_catalog.pg_collation c ON c.oid=k.id LEFT JOIN pg_catalog.pg_namespace n ON n.oid=c.collnamespace ORDER BY k.ord"
      )

    sql =
      names_cte() <>
        """
        SELECT i.indexrelid::pg_catalog.int8 AS oid,i.indrelid::pg_catalog.int8 AS relid,x.name AS relation,
          c.relname::pg_catalog.text AS name,n.nspname::pg_catalog.text AS namespace,c.relowner::pg_catalog.int8 AS owner,
          am.amname::pg_catalog.text AS method,i.indnatts::pg_catalog.int4 AS natts,i.indnkeyatts::pg_catalog.int4 AS nkeys,
          i.indisunique AS unique,i.indisprimary AS primary,i.indnullsnotdistinct AS nulls,i.indisexclusion AS exclusion,
          i.indimmediate AS immediate,i.indisclustered AS clustered,i.indisvalid AS valid,i.indcheckxmin AS xmin,
          i.indisready AS ready,i.indislive AS live,i.indisreplident AS replica,
          #{key_names("i.indkey::pg_catalog.int2[]", "i.indrelid")} AS keys,#{ops} AS opclasses,#{colls} AS collations,
        CASE WHEN pg_catalog.cardinality(i.indcollation::pg_catalog.oid[])>32 THEN ARRAY[4294967295]::pg_catalog.oid[] ELSE i.indcollation::pg_catalog.oid[] END AS collation_oids,
          CASE WHEN pg_catalog.cardinality(i.indoption::pg_catalog.int2[])>32 THEN ARRAY[-1]::pg_catalog.int2[] ELSE i.indoption::pg_catalog.int2[] END AS options,
          #{expr("i.indexprs", "i.indrelid")} AS expression,#{expr("i.indpred", "i.indrelid")} AS predicate,
          c.relkind::pg_catalog.text AS kind,c.relispartition AS partition,c.relpersistence::pg_catalog.text AS persistence,
          EXISTS(SELECT 1 FROM pg_catalog.pg_inherits h WHERE h.inhrelid=c.oid OR h.inhparent=c.oid) AS inheritance
        FROM targets x JOIN pg_catalog.pg_index i ON i.indrelid=x.oid JOIN pg_catalog.pg_class c ON c.oid=i.indexrelid
        JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace JOIN pg_catalog.pg_am am ON am.oid=c.relam
        ORDER BY i.indexrelid LIMIT 15
        """

    {rows, state} = fetch!(state, sql, [ids], schema, 14, 14)
    demand(length(Enum.uniq(Enum.map(rows, & &1["oid"]))) == 14)

    each!(rows, state, fn r ->
      demand(
        r["oid"] > 0 and r["owner"] == roles.relation_owner and r["namespace"] == "public" and
          r["method"] == "btree"
      )

      demand(
        r["natts"] == length(r["keys"]) and r["nkeys"] == r["natts"] and r["unique"] and
          r["immediate"] and r["valid"] and r["ready"] and r["live"]
      )

      demand(
        not Enum.any?(~w(nulls exclusion clustered xmin replica partition inheritance), &r[&1])
      )

      demand(
        r["kind"] == "i" and r["persistence"] == "p" and is_nil(r["expression"]) and
          r["options"] === List.duplicate(0, r["nkeys"])
      )

      keycols =
        Enum.map(r["keys"], fn key ->
          Enum.find(columns, &(&1["relid"] == r["relid"] and &1["name"] == key))
        end)

      demand(Enum.all?(keycols, &is_map/1))

      opclasses =
        Enum.map(keycols, fn c ->
          type = String.replace_prefix(c["type"], "pg_catalog.", "")
          family = if type in ["int4", "int8"], do: "integer_ops", else: type <> "_ops"
          "pg_catalog." <> type <> "_ops:" <> c["type"] <> ":pg_catalog." <> family
        end)

      demand(
        r["opclasses"] === opclasses and r["collations"] === Enum.map(keycols, & &1["collation"]) and
          r["collation_oids"] === Enum.map(keycols, & &1["collation_oid"])
      )

      backing = Enum.filter(constraints, &(&1["kind"] in ["p", "u"] and &1["index"] == r["oid"]))

      if is_nil(r["predicate"]) do
        demand(length(backing) == 1)
        [c] = backing

        demand(
          c["relid"] == r["relid"] and c["keys"] === r["keys"] and
            r["primary"] === (c["kind"] == "p")
        )
      else
        demand(
          backing == [] and r["name"] == "mixer_browser_one_attempt" and
            r["relation"] == "public.mixer_browser_oidc_attempts"
        )

        demand(r["keys"] === ["browser_id", "browser_epoch"] and not r["primary"])
        [expected] = manifest["expressions"]["predicates"]
        demand(r["predicate"] === expected["expression"])
      end
    end)

    demand(Enum.count(rows, &(not is_nil(&1["predicate"]))) == 1)

    each!(Enum.filter(constraints, &(&1["kind"] in ["p", "u", "f"])), state, fn c ->
      i = Enum.find(rows, &(&1["oid"] == c["index"]))
      demand(is_map(i))
      demand(i["relid"] === if(c["kind"] == "f", do: c["target_oid"], else: c["relid"]))
      demand(i["keys"] === if(c["kind"] == "f", do: c["target_keys"], else: c["keys"]))
      demand(is_nil(i["predicate"]))
    end)

    {rows, state}
  end

  defp triggers!(state, ids, constraints, indexes, manifest, roles) do
    schema = [
      {"oid", :oid},
      {"relid", :oid},
      {"relation", {:text, 127}},
      {"name", {:text, 63}},
      {"internal", :bool},
      {"events", :int},
      {"enabled", {:text, 1}},
      {"function_oid", :oid},
      {"function", {:text, 127}},
      {"nargs", :int},
      {"result", {:text, 127}},
      {"language", {:text, 63}},
      {"function_owner", :oid},
      {"definer", :bool},
      {"source", {:nullable, {:text, 65536}}},
      {"settings", {:nullable, {:array, {:text, 256}, 32}}},
      {"function_acl", :bool},
      {"deferrable", :bool},
      {"deferred", :bool},
      {"arguments", :int},
      {"args", {:text, 8192}},
      {"columns", {:array, :int, 32}},
      {"qual", {:nullable, {:text, 8192}}},
      {"old", {:nullable, {:text, 63}}},
      {"new", {:nullable, {:text, 63}}},
      {"parent", :oid},
      {"opposite", :oid},
      {"index", :oid},
      {"constraint", :oid}
    ]

    sql =
      names_cte() <>
        """
        SELECT t.oid::pg_catalog.int8 AS oid,t.tgrelid::pg_catalog.int8 AS relid,n.nspname::pg_catalog.text||'.'||c.relname::pg_catalog.text AS relation,
          t.tgname::pg_catalog.text AS name,t.tgisinternal AS internal,t.tgtype::pg_catalog.int4 AS events,t.tgenabled::pg_catalog.text AS enabled,
          p.oid::pg_catalog.int8 AS function_oid,pn.nspname::pg_catalog.text||'.'||p.proname::pg_catalog.text AS function,
          p.pronargs::pg_catalog.int4 AS nargs,tn.nspname::pg_catalog.text||'.'||rt.typname::pg_catalog.text AS result,
          l.lanname::pg_catalog.text AS language,p.proowner::pg_catalog.int8 AS function_owner,p.prosecdef AS definer,
          CASE WHEN t.tgisinternal THEN NULL WHEN pg_catalog.octet_length(p.prosrc)>65536 THEN '#{@marker}' ELSE p.prosrc END AS source,
          CASE WHEN pg_catalog.cardinality(p.proconfig)>32 OR pg_catalog.octet_length(p.proconfig::pg_catalog.text)>8192 THEN ARRAY['#{@marker}']::pg_catalog.text[] ELSE p.proconfig END AS settings,
          CASE WHEN t.tgisinternal THEN true WHEN NOT #{acl_ok("p.proacl")} THEN false ELSE
            NOT EXISTS(SELECT 1 FROM pg_catalog.aclexplode(COALESCE(p.proacl,pg_catalog.acldefault('f',p.proowner))) a
              WHERE a.grantee<>$2::pg_catalog.oid OR a.grantor<>$2::pg_catalog.oid OR a.privilege_type<>'EXECUTE' OR a.is_grantable)
            AND NOT pg_catalog.has_function_privilege($3::pg_catalog.oid,p.oid,'EXECUTE')
            AND NOT pg_catalog.has_function_privilege($4::pg_catalog.oid,p.oid,'EXECUTE') END AS function_acl,
          t.tgdeferrable AS deferrable,t.tginitdeferred AS deferred,t.tgnargs::pg_catalog.int4 AS arguments,
          CASE WHEN pg_catalog.octet_length(t.tgargs)>4096 THEN '#{@marker}' ELSE pg_catalog.encode(t.tgargs,'hex') END AS args,
          CASE WHEN pg_catalog.cardinality(t.tgattr::pg_catalog.int2[])>32 THEN ARRAY[-1]::pg_catalog.int2[] ELSE t.tgattr::pg_catalog.int2[] END AS columns,
          #{expr("t.tgqual", "t.tgrelid")} AS qual,t.tgoldtable::pg_catalog.text AS old,t.tgnewtable::pg_catalog.text AS new,
          t.tgparentid::pg_catalog.int8 AS parent,t.tgconstrrelid::pg_catalog.int8 AS opposite,t.tgconstrindid::pg_catalog.int8 AS index,t.tgconstraint::pg_catalog.int8 AS constraint
        FROM pg_catalog.pg_trigger t JOIN pg_catalog.pg_class c ON c.oid=t.tgrelid JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
        JOIN pg_catalog.pg_proc p ON p.oid=t.tgfoid AND p.prokind='f'
        JOIN pg_catalog.pg_namespace pn ON pn.oid=p.pronamespace JOIN pg_catalog.pg_type rt ON rt.oid=p.prorettype
        JOIN pg_catalog.pg_namespace tn ON tn.oid=rt.typnamespace JOIN pg_catalog.pg_language l ON l.oid=p.prolang
        WHERE t.tgrelid IN(SELECT oid FROM targets) OR t.tgconstraint IN(
          SELECT k.oid FROM pg_catalog.pg_constraint k WHERE k.conrelid IN(SELECT oid FROM targets) OR k.confrelid IN(SELECT oid FROM targets))
        ORDER BY t.oid LIMIT 54
        """

    {rows, state} =
      fetch!(
        state,
        sql,
        [ids, roles.writer, roles.lifecycle_login, roles.ordinary_runtime_login],
        schema,
        53,
        53
      )

    demand(length(Enum.uniq(Enum.map(rows, & &1["oid"]))) == 53)

    each!(rows, state, fn t ->
      demand(
        t["oid"] > 0 and t["function_oid"] > 0 and t["enabled"] == "O" and t["nargs"] == 0 and
          t["result"] == "pg_catalog.trigger"
      )

      demand(
        t["arguments"] == 0 and t["args"] == "" and t["columns"] == [] and is_nil(t["qual"]) and
          is_nil(t["old"]) and is_nil(t["new"]) and t["parent"] == 0
      )
    end)

    ri = Enum.filter(rows, & &1["internal"])
    demand(length(ri) == 48)

    funcs = %{
      "pg_catalog.RI_FKey_check_ins" => {5, :child},
      "pg_catalog.RI_FKey_check_upd" => {17, :child},
      "pg_catalog.RI_FKey_noaction_del" => {9, :parent},
      "pg_catalog.RI_FKey_noaction_upd" => {17, :parent}
    }

    each!(Enum.filter(constraints, &(&1["kind"] == "f")), state, fn c ->
      group = Enum.filter(ri, &(&1["constraint"] == c["oid"]))

      demand(
        Enum.frequencies(Enum.map(group, & &1["function"])) === Map.new(Map.keys(funcs), &{&1, 1})
      )

      each!(group, state, fn t ->
        {events, side} = Map.fetch!(funcs, t["function"])

        demand(
          t["events"] == events and not t["deferrable"] and not t["deferred"] and
            t["language"] == "internal"
        )

        demand(t["relid"] == if(side == :child, do: c["relid"], else: c["target_oid"]))
        demand(t["opposite"] == if(side == :child, do: c["target_oid"], else: c["relid"]))
        demand(t["index"] == c["index"] and Enum.any?(indexes, &(&1["oid"] == t["index"])))
      end)
    end)

    user = Enum.reject(rows, & &1["internal"])
    demand(length(user) == 5)
    expected = manifest["structure"]["user_triggers"]

    demand(
      Enum.frequencies(Enum.map(user, &{&1["relation"], &1["name"]})) ===
        Enum.frequencies(Enum.map(expected, &{&1["relation"], &1["name"]}))
    )

    each!(user, state, fn t ->
      e = Enum.find(expected, &(&1["relation"] == t["relation"] and &1["name"] == t["name"]))
      function = String.trim_trailing(e["function"], "()")

      demand(
        t["function"] === function and
          t["source"] ===
            manifest["trigger_sources"][String.replace_prefix(function, "public.", "")]
      )

      demand(
        t["language"] == "plpgsql" and t["definer"] and t["function_owner"] == roles.writer and
          t["function_acl"]
      )

      demand(Enum.sort(t["settings"]) === Enum.sort(@function_settings))

      events =
        if e["name"] == "mixer_browser_immutable",
          do: 27,
          else: if(e["events"] == ["INSERT"], do: 5, else: 21)

      demand(
        t["events"] == events and t["deferrable"] === e["deferrable"] and
          t["deferred"] === e["initially_deferred"]
      )

      demand(t["opposite"] == 0 and t["index"] == 0)

      if e["constraint"] do
        c = Enum.find(constraints, &(&1["oid"] == t["constraint"]))
        demand(is_map(c) and c["kind"] == "t" and c["relid"] == t["relid"])
      else
        demand(t["constraint"] == 0)
      end
    end)

    demand(
      length(Enum.uniq(Enum.map(Enum.filter(user, &(&1["constraint"] > 0)), & &1["constraint"]))) ==
        4
    )

    each!(Enum.group_by(rows, & &1["function"]), state, fn {_, ts} ->
      demand(length(Enum.uniq(Enum.map(ts, & &1["function_oid"]))) == 1)
    end)

    {rows, state}
  end

  defp policies!(state, ids, manifest, roles) do
    schema = [
      {"relation", {:text, 127}},
      {"name", {:text, 63}},
      {"command", {:text, 1}},
      {"permissive", :bool},
      {"roles", {:array, :oid, 4}},
      {"using", {:nullable, {:text, 8192}}},
      {"check", {:nullable, {:text, 8192}}}
    ]

    sql =
      names_cte() <>
        """
        SELECT x.name AS relation,p.polname::pg_catalog.text AS name,p.polcmd::pg_catalog.text AS command,p.polpermissive AS permissive,
          CASE WHEN pg_catalog.cardinality(p.polroles)>4 THEN ARRAY[4294967295]::pg_catalog.oid[] ELSE p.polroles END AS roles,
          #{expr("p.polqual", "p.polrelid")} AS using,#{expr("p.polwithcheck", "p.polrelid")} AS check
        FROM targets x JOIN pg_catalog.pg_policy p ON p.polrelid=x.oid ORDER BY p.oid LIMIT 33
        """

    {rows, state} = fetch!(state, sql, [ids], schema, 32, 32)
    commands = %{"SELECT" => "r", "INSERT" => "a", "UPDATE" => "w", "DELETE" => "d", "ALL" => "*"}

    expected =
      Enum.flat_map(manifest["structure"]["policies"], fn {rel, ps} ->
        Enum.map(ps, fn p ->
          e =
            Enum.find(
              manifest["expressions"]["policies"],
              &(&1["relation"] == rel and &1["polname"] == p["name"])
            )

          %{
            "relation" => rel,
            "name" => p["name"],
            "command" => commands[p["command"]],
            "permissive" => p["permissive"],
            "roles" => if(p["roles"] == ["PUBLIC"], do: [0], else: [roles.writer]),
            "using" => e["using_expr"],
            "check" => e["check_expr"]
          }
        end)
      end)

    demand(Enum.frequencies(rows) === Enum.frequencies(expected))
    {rows, state}
  end

  defp table_tokens(16), do: ~w(SELECT INSERT UPDATE DELETE TRUNCATE REFERENCES TRIGGER)
  defp table_tokens(17), do: ~w(SELECT INSERT UPDATE DELETE TRUNCATE REFERENCES TRIGGER MAINTAIN)
  defp apps(roles), do: [roles.lifecycle_login, roles.writer, roles.ordinary_runtime_login]

  defp privileges!(state, ids, columns, manifest, roles, major) do
    schema = [
      {"relation", {:text, 127}},
      {"column", {:nullable, {:text, 63}}},
      {"null", :bool},
      {"grantee", :oid},
      {"grantor", :oid},
      {"privilege", {:text, 16}},
      {"option", :bool}
    ]

    sql =
      names_cte() <>
        """
        SELECT q.relation,q.column,q.null,q.grantee,q.grantor,q.privilege,q.option FROM (
          SELECT x.name AS relation,NULL::pg_catalog.text AS column,c.relacl IS NULL AS null,
            a.grantee::pg_catalog.int8 AS grantee,a.grantor::pg_catalog.int8 AS grantor,a.privilege_type::pg_catalog.text AS privilege,a.is_grantable AS option
          FROM targets x JOIN pg_catalog.pg_class c ON c.oid=x.oid
          CROSS JOIN LATERAL pg_catalog.aclexplode(CASE WHEN #{acl_ok("c.relacl")} THEN COALESCE(c.relacl,pg_catalog.acldefault('r',c.relowner)) ELSE NULL::pg_catalog.aclitem[] END) a
          UNION ALL
          SELECT x.name,a.attname::pg_catalog.text,false,e.grantee::pg_catalog.int8,e.grantor::pg_catalog.int8,e.privilege_type::pg_catalog.text,e.is_grantable
          FROM targets x JOIN pg_catalog.pg_attribute a ON a.attrelid=x.oid
          CROSS JOIN LATERAL pg_catalog.aclexplode(CASE WHEN #{acl_ok("a.attacl")} THEN a.attacl ELSE NULL::pg_catalog.aclitem[] END) e
          WHERE a.attnum>0
        ) q ORDER BY q.relation,q.column,q.grantee,q.privilege LIMIT 513
        """

    expected =
      Enum.flat_map(manifest["structure"]["writer_grants"], fn {rel, g} ->
        base =
          Enum.map(
            table_tokens(major),
            &acl_row(rel, nil, roles.relation_owner, roles.relation_owner, &1)
          )

        writer = Enum.map(g["table"], &acl_row(rel, nil, roles.writer, roles.relation_owner, &1))

        mutable =
          Enum.map(
            g["update_columns"],
            &acl_row(rel, &1, roles.writer, roles.relation_owner, "UPDATE")
          )

        ordinary =
          if String.starts_with?(rel, "public.mixer_authz_"),
            do: [acl_row(rel, nil, roles.ordinary_runtime_login, roles.relation_owner, "SELECT")],
            else: []

        base ++ writer ++ mutable ++ ordinary
      end)

    {rows, state} = fetch!(state, sql, [ids], schema, 512, length(expected))
    demand(Enum.frequencies(rows) === Enum.frequencies(expected))
    tokens = table_tokens(major)

    effective_sql =
      Enum.map_join(tokens, ",", fn token ->
        "pg_catalog.has_table_privilege(r.role,x.oid,'#{token}')"
      end)

    schema = [{"role", :oid}, {"relation", {:text, 127}}, {"rights", {:array, :bool, 8}}]

    sql =
      names_cte() <>
        """
        SELECT r.role::pg_catalog.int8 AS role,x.name AS relation,ARRAY[#{effective_sql}] AS rights
        FROM pg_catalog.unnest($2::pg_catalog.oid[]) r(role) CROSS JOIN targets x ORDER BY r.role,x.oid LIMIT 28
        """

    {tables, state} = fetch!(state, sql, [ids, apps(roles)], schema, 27, 27)

    each!(tables, state, fn r ->
      expected =
        Enum.map(tokens, fn privilege ->
          grants = manifest["structure"]["writer_grants"][r["relation"]]

          cond do
            r["role"] == roles.writer ->
              privilege in grants["table"]

            r["role"] == roles.ordinary_runtime_login ->
              privilege == "SELECT" and String.starts_with?(r["relation"], "public.mixer_authz_")

            r["role"] == roles.lifecycle_login ->
              false

            true ->
              raise Unavailable
          end
        end)

      demand(r["rights"] === expected)
    end)

    demand(length(Enum.uniq(Enum.map(tables, &{&1["role"], &1["relation"]}))) == 27)

    checks =
      Enum.map_join(~w(SELECT INSERT UPDATE REFERENCES), ",", fn token ->
        "pg_catalog.has_column_privilege(r.role,a.attrelid,a.attnum,'#{token}')"
      end)

    schema = [{"role", :oid}, {"relid", :oid}, {"number", :int}, {"rights", {:array, :bool, 4}}]

    sql =
      names_cte() <>
        """
        SELECT r.role::pg_catalog.int8 AS role,a.attrelid::pg_catalog.int8 AS relid,a.attnum::pg_catalog.int4 AS number,ARRAY[#{checks}] AS rights
        FROM pg_catalog.unnest($2::pg_catalog.oid[]) r(role) CROSS JOIN targets x
        JOIN pg_catalog.pg_attribute a ON a.attrelid=x.oid WHERE a.attnum>0 ORDER BY r.role,a.attrelid,a.attnum LIMIT 373
        """

    {cols, state} = fetch!(state, sql, [ids, apps(roles)], schema, 372, 372)

    each!(cols, state, fn r ->
      c = Enum.find(columns, &(&1["relid"] == r["relid"] and &1["number"] == r["number"]))
      demand(is_map(c))
      g = manifest["structure"]["writer_grants"][c["relation"]]

      expected =
        cond do
          r["role"] == roles.writer ->
            [
              "SELECT" in g["table"],
              "INSERT" in g["table"],
              c["name"] in g["update_columns"],
              false
            ]

          r["role"] == roles.ordinary_runtime_login ->
            [String.starts_with?(c["relation"], "public.mixer_authz_"), false, false, false]

          r["role"] == roles.lifecycle_login ->
            [false, false, false, false]

          true ->
            raise Unavailable
        end

      demand(r["rights"] === expected)
    end)

    demand(length(Enum.uniq(Enum.map(cols, &{&1["role"], &1["relid"], &1["number"]}))) == 372)
    {rows, state}
  end

  defp acl_row(rel, column, grantee, grantor, privilege),
    do: %{
      "relation" => rel,
      "column" => column,
      "null" => false,
      "grantee" => grantee,
      "grantor" => grantor,
      "privilege" => privilege,
      "option" => false
    }

  defp forbidden!(state, ids, roles, major) do
    # Fixed EXISTS deny all writer/lifecycle rights outside the exact nine,
    # including column-only grants and writable views/foreign relations. Function,
    # type and complete role-topology checks remain separate prerequisites.
    tests =
      Enum.map_join(table_tokens(major), " OR ", fn token ->
        "pg_catalog.has_table_privilege(r.role,c.oid,'#{token}')"
      end)

    columns =
      Enum.map_join(~w(SELECT INSERT UPDATE REFERENCES), " OR ", fn token ->
        "pg_catalog.has_any_column_privilege(r.role,c.oid,'#{token}')"
      end)

    sql =
      names_cte() <>
        """
        SELECT 1::pg_catalog.int4 AS forbidden WHERE
          EXISTS(SELECT 1 FROM pg_catalog.pg_inherits h WHERE h.inhrelid IN(SELECT oid FROM targets) OR h.inhparent IN(SELECT oid FROM targets))
          OR EXISTS(SELECT 1 FROM pg_catalog.pg_rewrite w WHERE w.ev_class IN(SELECT oid FROM targets))
          OR EXISTS(SELECT 1 FROM pg_catalog.pg_foreign_table f WHERE f.ftrelid IN(SELECT oid FROM targets))
          OR EXISTS(SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
            CROSS JOIN pg_catalog.unnest($2::pg_catalog.oid[]) r(role)
            WHERE n.nspname<>'information_schema' AND pg_catalog.left(n.nspname::pg_catalog.text,3)<>'pg_'
              AND c.relkind IN('r','p','v','m','f','S') AND c.oid NOT IN(SELECT oid FROM targets)
              AND (c.relowner=r.role OR CASE WHEN c.relkind='S' THEN
                pg_catalog.has_sequence_privilege(r.role,c.oid,'SELECT') OR pg_catalog.has_sequence_privilege(r.role,c.oid,'UPDATE') OR pg_catalog.has_sequence_privilege(r.role,c.oid,'USAGE')
                ELSE (#{tests}) OR (#{columns}) END))
          OR EXISTS(SELECT 1 FROM pg_catalog.pg_namespace n CROSS JOIN pg_catalog.unnest($2::pg_catalog.oid[]) r(role)
            WHERE n.nspowner=r.role OR pg_catalog.has_schema_privilege(r.role,n.oid,'CREATE'))
        LIMIT 1
        """

    fetch!(state, sql, [ids, [roles.writer, roles.lifecycle_login]], [{"forbidden", :int}], 0, 0)
  end
end

ee03554fdbb3ad0ddcae171da14410ac6b9d4183 blob 1463
defmodule MixerHosted.BrowserAuth.RelationManifest do
  @moduledoc false
  @root Path.expand("../../..", __DIR__)
  @resources for major <- [16, 17],
                 do: Path.join(@root, "priv/browser_auth/relation_surface_v1_pg#{major}.json")
  for path <- @resources, do: @external_resource(path)

  @expected_hashes %{
    16 => "079b8cdeb3c039284b3ae402664230f6abc01782ab5e7f08219a06067e22cadf",
    17 => "100df9346930b778611b46e821484db025671819b3bb966cfcb496014ce42785"
  }
  @manifests Map.new(Enum.zip([16, 17], @resources), fn {major, path} ->
               bytes = File.read!(path)
               digest = :crypto.hash(:sha256, bytes) |> Base.encode16(case: :lower)

               if digest != Map.fetch!(@expected_hashes, major),
                 do: raise("unreviewed relation manifest")

               {major, Jason.decode!(bytes)}
             end)
  @bindings @manifests[16]["source_bindings"]
  if @bindings != @manifests[17]["source_bindings"], do: raise("relation source binding mismatch")

  for {relative, digest} <- @bindings do
    path = Path.join(Path.dirname(@root), relative)
    @external_resource path
    actual = :crypto.hash(:sha256, File.read!(path)) |> Base.encode16(case: :lower)
    if actual != digest, do: raise("unreviewed relation source")
  end

  def for_major(major) when major in [16, 17], do: Map.fetch!(@manifests, major)
  def names, do: @manifests[16]["structure"]["relations"] |> Map.keys() |> Enum.sort()
end

00be6753705675eed3835856b04447e45c9a512b blob 7874
defmodule MixerHosted.BrowserAuth.RuntimeConfig do
  @moduledoc """
  Pure browser lifecycle settings derived from the trusted ordinary startup value.

  No application, environment, database, resolver, or running owner is consulted.
  Struct shape cannot attest startup provenance; later composition must pass the
  same ordinary RuntimeConfig to both supervised graphs. This starts no capability.
  """
  alias MixerHosted.BrowserAuth.{Config, ConfigurationDigest, Custody, Vault}
  alias MixerHosted.RuntimeConfig, as: HostedConfig

  @enforce_keys [
    :mode,
    :browser_config,
    :configuration_digest,
    :lifecycle_repo,
    :expected_roles,
    :custody
  ]
  defstruct @enforce_keys

  @error {:error, :session_unavailable}
  @hosted_keys ~w(role repo oban endpoint database_connection_bound identity_startup)a
  @repo_keys ~w(hostname port database username password pool_size pool_count timeout
    connect_timeout queue_target queue_interval show_sensitive_data_on_connection_error ssl)a
  @ssl_keys ~w(verify cacerts server_name_indication customize_hostname_check)a
  @lifecycle_keys ~w(username password writer_role relation_owner)a
  @browser_keys ~w(MIXER_BROWSER_AUTH_MODE MIXER_BROWSER_AUTH_CONFIG)

  @doc "Constructs disabled settings or one bounded dedicated lifecycle connection policy."
  def new(browser_env, %HostedConfig{} = hosted, lifecycle, custody) do
    with true <- exact_map?(hosted, [:__struct__ | @hosted_keys]),
         true <- browser_env?(browser_env),
         {:ok, config} <- Config.load(browser_env, hosted.role, hosted.identity_startup) do
      construct(config, hosted, lifecycle, custody)
    else
      _ -> @error
    end
  rescue
    _ -> @error
  catch
    _, _ -> @error
  end

  def new(_, _, _, _), do: @error

  defp construct(%Config{mode: :disabled}, _hosted, nil, nil) do
    {:ok,
     %__MODULE__{
       mode: :disabled,
       browser_config: nil,
       configuration_digest: nil,
       lifecycle_repo: nil,
       expected_roles: nil,
       custody: nil
     }}
  end

  defp construct(%Config{mode: :configured} = config, hosted, lifecycle, custody) do
    with true <- exact_map?(lifecycle, @lifecycle_keys),
         true <- repo?(hosted.repo, hosted.database_connection_bound),
         true <- bounded_binary?(lifecycle.password),
         roles = %{
           lifecycle_login: lifecycle.username,
           writer: lifecycle.writer_role,
           relation_owner: lifecycle.relation_owner,
           ordinary_runtime_login: hosted.repo[:username]
         },
         true <- roles?(roles),
         {:ok, custody} <- custody(custody, config.session_vault_ref),
         {:ok, digest} <- ConfigurationDigest.digest(config) do
      {:ok,
       %__MODULE__{
         mode: :configured,
         browser_config: config,
         configuration_digest: digest,
         lifecycle_repo: lifecycle_repo(hosted.repo, lifecycle),
         expected_roles: roles,
         custody: custody
       }}
    else
      _ -> @error
    end
  end

  defp construct(_, _, _, _), do: @error

  defp custody(%Custody{reference: reference, key: %Vault.Key{} = key} = custody, reference) do
    with true <- exact_map?(custody, [:__struct__, :reference, :key]),
         true <- exact_map?(key, [:__struct__, :id, :bytes]),
         {:ok, validated} <-
           Custody.new(reference, %{
             reference: reference,
             key_id: key.id,
             key_bytes: key.bytes
           }) do
      {:ok, validated}
    else
      _ -> @error
    end
  end

  defp custody(_, _), do: @error

  defp browser_env?(env) when is_map(env) do
    Enum.all?(Map.keys(env), &(&1 in @browser_keys)) and
      case Map.get(env, "MIXER_BROWSER_AUTH_MODE", "disabled") do
        "disabled" -> not Map.has_key?(env, "MIXER_BROWSER_AUTH_CONFIG")
        "configured" -> exact_map?(env, @browser_keys)
        _ -> false
      end
  end

  defp browser_env?(_), do: false

  defp repo?(repo, connection_bound) do
    exact_keyword?(repo, @repo_keys) and host?(repo[:hostname]) and repo[:port] === 5432 and
      bounded_binary?(repo[:database]) and bounded_binary?(repo[:username]) and
      bounded_binary?(repo[:password]) and is_integer(repo[:pool_size]) and
      repo[:pool_size] in 2..20 and connection_bound === repo[:pool_size] + 1 and
      repo[:pool_count] === 1 and repo[:timeout] === 5_000 and
      repo[:connect_timeout] === 5_000 and repo[:queue_target] === 50 and
      repo[:queue_interval] === 1_000 and
      repo[:show_sensitive_data_on_connection_error] === false and
      tls?(repo[:ssl], repo[:hostname])
  end

  defp tls?(ssl, host) do
    # Compare the OTP policy itself; never evaluate a supplied callback.
    exact_keyword?(ssl, @ssl_keys) and ssl[:verify] === :verify_peer and
      ssl[:server_name_indication] === String.to_charlist(host) and roots?(ssl[:cacerts]) and
      exact_keyword?(ssl[:customize_hostname_check], [:match_fun]) and
      ssl[:customize_hostname_check][:match_fun] ===
        :public_key.pkix_verify_hostname_match_fun(:https)
  end

  defp roots?(roots) when is_list(roots) and roots != [] do
    Enum.all?(roots, fn
      {:cert, der, decoded} when is_binary(der) ->
        :public_key.pkix_decode_cert(der, :otp) === decoded

      der when is_binary(der) ->
        :public_key.pkix_decode_cert(der, :otp)
        true

      _ ->
        false
    end)
  end

  defp roots?(_), do: false

  defp lifecycle_repo(repo, lifecycle) do
    [
      hostname: repo[:hostname],
      port: repo[:port],
      database: repo[:database],
      username: lifecycle.username,
      password: lifecycle.password,
      pool_size: 2,
      pool_count: 1,
      timeout: 5_000,
      connect_timeout: 5_000,
      queue: false,
      show_sensitive_data_on_connection_error: false,
      ssl: repo[:ssl]
    ]
  end

  defp roles?(roles) do
    values = Map.values(roles)
    Enum.all?(values, &role?/1) and length(Enum.uniq(values)) == 4
  end

  # Keep the existing StorageSchema provisioning contract's restricted grammar.
  defp role?(name) when is_binary(name) and byte_size(name) in 1..63 do
    name != "public" and not String.starts_with?(name, "pg_") and
      name
      |> :binary.bin_to_list()
      |> Enum.with_index()
      |> Enum.all?(fn {byte, index} ->
        byte in ?a..?z or byte == ?_ or (index > 0 and byte in ?0..?9)
      end)
  end

  defp role?(_), do: false

  defp host?(host) when is_binary(host) and byte_size(host) in 1..253 do
    labels = :binary.split(host, ".", [:global])

    length(labels) >= 2 and
      match?({:error, _}, :inet.parse_address(String.to_charlist(host))) and
      Enum.all?(labels, fn label ->
        byte_size(label) in 1..63 and not String.contains?(label, "-pooler") and
          not String.starts_with?(label, "-") and not String.ends_with?(label, "-") and
          Enum.all?(:binary.bin_to_list(label), fn byte ->
            byte in ?a..?z or byte in ?0..?9 or byte == ?-
          end)
      end)
  end

  defp host?(_), do: false

  defp exact_map?(map, keys),
    do: is_map(map) and map_size(map) == length(keys) and Enum.all?(keys, &Map.has_key?(map, &1))

  defp exact_keyword?(options, keys),
    do:
      is_list(options) and Keyword.keyword?(options) and length(options) == length(keys) and
        Enum.sort(Keyword.keys(options)) == Enum.sort(keys)

  defp bounded_binary?(value), do: is_binary(value) and byte_size(value) in 1..4096
end

defimpl Inspect, for: MixerHosted.BrowserAuth.RuntimeConfig do
  def inspect(%{mode: :configured}, _options),
    do: "#MixerHosted.BrowserAuth.RuntimeConfig<mode: :configured, lifecycle_connection_bound: 2>"

  def inspect(%{mode: :disabled}, _options),
    do: "#MixerHosted.BrowserAuth.RuntimeConfig<mode: :disabled, lifecycle_connection_bound: 0>"

  def inspect(_, _options), do: "#MixerHosted.BrowserAuth.RuntimeConfig<unavailable>"
end

a5ac1a3760918c7e232cba40f83ef4743094460c blob 20613
defmodule MixerHosted.BrowserAuth.RuntimeOwner do
  @moduledoc """
  Manually supervised, fixed preauthentication owner. No Application wiring yet.

  Storage readiness requires both current catalogs on the dedicated pool. It is
  never browser authentication readiness. Startup receives trusted configuration;
  this component cannot attest that a future Application used the same loader.
  Private preauthentication values must never be logged or serialized to HTTP.
  """
  use GenServer
  alias MixerHosted.BrowserAuth.{ConfigurationDigest, Custody, LifecycleRepo}

  alias MixerHosted.BrowserAuth.{
    PreauthDraft,
    Protocol,
    RuntimeConfig,
    Store,
    StoredSnapshot,
    Vault
  }

  alias MixerHosted.Identity.KeyOwner

  def start_link(%RuntimeConfig{} = runtime),
    do: GenServer.start_link(__MODULE__, runtime, name: __MODULE__)

  def status do
    GenServer.call(__MODULE__, :status, 1000)
  catch
    :exit, _ -> %{phase: :unavailable, generation: 0}
  end

  @doc "Creates private preauthentication data only; no authenticated session or HTTP cookie is installed."
  def bootstrap(metadata) do
    deadline = System.monotonic_time(:millisecond) + 5000
    wall = System.system_time(:second)

    with true <- metadata?(metadata),
         {:ok, lease} <- reserve(deadline, wall) do
      execute(lease, fn ->
        cookie = Protocol.random_token()
        csrf = Protocol.random_token()
        runtime = lease.runtime
        config = runtime.browser_config

        context = %{
          purpose: :preauth,
          browser_id: :crypto.strong_rand_bytes(16),
          cookie_digest: :crypto.hash(:sha256, cookie),
          csrf_digest: :crypto.hash(:sha256, csrf),
          epoch: 1,
          revision: 1,
          generation: Protocol.random_token(),
          vault_generation: 1,
          config_digest: runtime.configuration_digest,
          profile_id: config.profile_id,
          profile_version: config.profile_version,
          principal_id: nil,
          family_id: nil,
          credential_ref: nil,
          credential_revision: nil
        }

        with {:ok, sealed} <- Vault.seal(runtime.custody.key, context, %Vault.Preauth{csrf: csrf}) do
          draft = %PreauthDraft.Bootstrap{
            lease: lease,
            context: context,
            sealed: sealed,
            cookie: cookie,
            csrf: csrf,
            expires_at: wall + 300
          }

          finish_result(lease, cookie, Store.bootstrap(draft, metadata))
        else
          _ -> Store.failure(:effect, :not_started)
        end
      end)
    else
      _ -> Store.failure(:admission, :not_started)
    end
  rescue
    _ -> Store.failure(:admission, :not_started)
  catch
    _, _ -> Store.failure(:admission, :not_started)
  end

  def load(cookie) do
    deadline = System.monotonic_time(:millisecond) + 5000
    wall = System.system_time(:second)

    with true <- Protocol.token?(cookie),
         {:ok, lease} <- reserve(deadline, wall) do
      execute(lease, fn ->
        input = %PreauthDraft.Load{lease: lease, cookie_digest: :crypto.hash(:sha256, cookie)}
        finish_result(lease, cookie, Store.load(input))
      end)
    else
      _ -> Store.failure(:admission, :not_started)
    end
  rescue
    _ -> Store.failure(:admission, :not_started)
  catch
    _, _ -> Store.failure(:admission, :not_started)
  end

  @doc "Begins only a private preauthentication OIDC attempt; no route or authenticated session is installed."
  def begin_login(cookie, raw_headers, return_route, metadata) do
    deadline = System.monotonic_time(:millisecond) + 5000
    wall = System.system_time(:second)

    with true <- metadata?(metadata) and return_route === :workspace and Protocol.token?(cookie),
         {:ok, ^cookie} <- Protocol.parse_session_cookie(raw_headers),
         {:ok, lease} <- reserve(deadline, wall) do
      execute(lease, fn ->
        input = %PreauthDraft.Load{lease: lease, cookie_digest: :crypto.hash(:sha256, cookie)}

        with {:ok, %StoredSnapshot{} = source} <- Store.discover_begin(input),
             {:ok, draft} <- prepare_begin(lease, raw_headers, source),
             {:ok, _snapshot} <- Store.begin_login(draft, metadata) do
          finish_receipt(lease, draft.attempt_context.expires_at, %PreauthDraft.Authorization{
            url: draft.url,
            expires_at: draft.attempt_context.expires_at
          })
        else
          {:error, %Store.Failure{}} = error -> error
          _ -> Store.failure(:decode, :committed)
        end
      end)
    else
      _ -> Store.failure(:admission, :not_started)
    end
  rescue
    _ -> Store.failure(:admission, :not_started)
  catch
    _, _ -> Store.failure(:admission, :not_started)
  end

  defp prepare_begin(lease, raw_headers, source) do
    runtime = lease.runtime
    config = runtime.browser_config
    envelope = source.session_envelope

    expires =
      min(
        lease.started_at + 300,
        min(source.browser["idle_expires_at"], source.browser["absolute_expires_at"])
      )

    with :ok <- checkpoint(lease),
         :preauth <- envelope.context.purpose,
         {:ok, %Vault.Preauth{csrf: csrf}} <-
           Vault.open(runtime.custody.key, envelope.context, envelope.sealed),
         :ok <- Protocol.verify_csrf(config, raw_headers, csrf),
         true <- System.system_time(:second) < expires do
      state = Protocol.random_token()
      nonce = Protocol.random_token()
      verifier = Protocol.random_token()
      c = envelope.context

      context = %{
        c
        | epoch: c.epoch + 1,
          revision: c.revision + 1,
          vault_generation: c.vault_generation + 1
      }

      attempt = %{
        purpose: :attempt,
        state_digest: :crypto.hash(:sha256, state),
        browser_id: context.browser_id,
        cookie_digest: context.cookie_digest,
        epoch: context.epoch,
        revision: context.revision,
        generation: context.generation,
        config_digest: runtime.configuration_digest,
        profile_id: config.profile_id,
        profile_version: config.profile_version,
        issuer: config.issuer,
        client_id: config.client_id,
        redirect_uri: config.redirect_uri,
        expires_at: expires
      }

      with {:ok, url} <-
             Protocol.authorization_url(config, %{state: state, nonce: nonce, verifier: verifier}),
           true <- byte_size(url) <= 8192,
           {:ok, sealed} <- Vault.seal(runtime.custody.key, context, %Vault.Preauth{csrf: csrf}),
           {:ok, attempt_sealed} <-
             Vault.seal(runtime.custody.key, attempt, %Vault.Verifier{verifier: verifier}),
           :ok <- checkpoint(lease) do
        {:ok,
         %PreauthDraft.Begin{
           lease: lease,
           source: source,
           context: context,
           sealed: sealed,
           attempt_context: attempt,
           attempt_sealed: attempt_sealed,
           state: state,
           nonce: nonce,
           verifier: verifier,
           csrf: csrf,
           url: url
         }}
      else
        {:error, %Store.Failure{}} = error -> error
        _ -> Store.failure(:effect, :not_started)
      end
    else
      {:error, %Store.Failure{}} = error -> error
      _ -> Store.failure(:decode, :committed)
    end
  end

  # These are closed internal owner messages. Actual GenServer caller identity
  # and exact retained lease equality are checked; no supplied PID is authority.
  @doc false
  def checkpoint(%PreauthDraft.Lease{} = lease), do: call(lease, {:checkpoint, lease})
  def checkpoint(_), do: Store.failure(:admission, :not_started)

  defp reserve(deadline, wall),
    do: GenServer.call(__MODULE__, {:reserve, deadline, wall}, remaining(deadline))

  defp execute(lease, operation) do
    # Only the fixed private orchestration functions create this closure;
    # no exported function accepts caller code or runs provider I/O.
    result =
      try do
        operation.()
      rescue
        _ -> Store.failure(:effect, :unknown)
      catch
        _, _ -> Store.failure(:commit, :unknown)
      end

    case result do
      %PreauthDraft.Publication{} = receipt ->
        # Finish already released the exact retained caller permit. No external
        # cleanup call may delay a successful value after this final sample.
        publish(lease, receipt)

      error ->
        if match?({:error, %Store.Failure{}}, error), do: call(lease, {:failed, lease, error})

        # Caller-authorized fallback only. Expiry/monitors clean up after the
        # unchanged deadline. A completed finish needs no second release.
        if System.monotonic_time(:millisecond) < lease.deadline,
          do: call(lease, {:release, lease})

        error
    end
  end

  defp finish_receipt(lease, expires, value) do
    case call(lease, {:finish, lease, expires}) do
      {:ok, checked_wall} when is_integer(checked_wall) ->
        %PreauthDraft.Publication{checked_wall: checked_wall, expires_at: expires, value: value}

      _ ->
        Store.failure(:commit, :committed)
    end
  rescue
    _ -> Store.failure(:commit, :committed)
  catch
    _, _ -> Store.failure(:commit, :committed)
  end

  defp publish(lease, receipt) do
    # The retained PID/status samples current dependency/configuration binding;
    # neither a registered replacement nor a new timeout can authorize release.
    with true <- System.monotonic_time(:millisecond) < lease.deadline,
         %{phase: :storage_ready, generation: generation} <- call(lease, :status),
         true <- generation === lease.generation,
         wall = System.system_time(:second),
         true <- wall >= receipt.checked_wall,
         true <- is_nil(receipt.expires_at) or wall < receipt.expires_at,
         true <- System.monotonic_time(:millisecond) < lease.deadline,
         true <- Process.whereis(__MODULE__) === lease.owner do
      {:ok, receipt.value}
    else
      _ -> Store.failure(:commit, :committed)
    end
  rescue
    _ -> Store.failure(:commit, :committed)
  catch
    _, _ -> Store.failure(:commit, :committed)
  end

  defp finish_result(lease, _cookie, {:ok, nil}) do
    finish_receipt(lease, nil, nil)
  end

  defp finish_result(lease, cookie, {:ok, snapshot}) do
    # Store has returned a confirmed COMMIT before any decryption occurs here.
    envelope = snapshot.session_envelope
    expires_at = min(snapshot.browser["idle_expires_at"], snapshot.browser["absolute_expires_at"])

    with :preauth <- envelope.context.purpose,
         {:ok, %Vault.Preauth{csrf: csrf}} <-
           Vault.open(lease.runtime.custody.key, envelope.context, envelope.sealed) do
      finish_receipt(lease, expires_at, %PreauthDraft.Preauth{
        cookie: cookie,
        csrf: csrf,
        expires_at: expires_at,
        source: snapshot
      })
    else
      _ -> Store.failure(:decode, :committed)
    end
  end

  defp finish_result(_lease, _cookie, error), do: error

  defp call(lease, message) do
    if Process.whereis(__MODULE__) === lease.owner,
      do: GenServer.call(lease.owner, message, remaining(lease.deadline)),
      else: Store.failure(:commit, :committed)
  catch
    :exit, _ -> Store.failure(:commit, :committed)
  end

  @impl true
  def init(%RuntimeConfig{mode: :disabled} = runtime) do
    if Enum.all?(
         [
           runtime.browser_config,
           runtime.configuration_digest,
           runtime.lifecycle_repo,
           runtime.expected_roles,
           runtime.custody
         ],
         &is_nil/1
       ),
       do: {:ok, %{phase: :disabled, generation: 0, operations: %{}, monitors: %{}}},
       else: {:stop, :session_unavailable}
  end

  def init(%RuntimeConfig{mode: :configured} = runtime) do
    deadline = System.monotonic_time(:millisecond) + 5000

    with :ok <- validate_runtime(runtime),
         repo when is_pid(repo) <- Process.whereis(LifecycleRepo),
         identity when is_pid(identity) <- Process.whereis(KeyOwner),
         ordinary when is_pid(ordinary) <- Process.whereis(MixerHosted.Repo) do
      monitors = Map.new([repo, identity, ordinary], &{Process.monitor(&1), &1})

      phase =
        if Store.admit(runtime, deadline) === {:ok, :admitted},
          do: :storage_ready,
          else: :unavailable

      {:ok,
       %{
         phase: phase,
         generation: 1,
         runtime: runtime,
         repo: repo,
         identity: identity,
         ordinary: ordinary,
         operations: %{},
         monitors: monitors
       }}
    else
      _ -> {:stop, :session_unavailable}
    end
  end

  @impl true
  def format_status(status) do
    Map.new(status, fn
      {:state, state} -> {:state, Map.take(state, [:phase, :generation])}
      {key, _} when key in [:message, :reason, :log] -> {key, :redacted}
      pair -> pair
    end)
  end

  @impl true
  def handle_call(:status, _from, state) do
    state = current(state)
    {:reply, Map.take(state, [:phase, :generation]), state}
  end

  def handle_call({:reserve, deadline, wall}, {caller, _}, state) do
    state = current(state)

    if state.phase === :storage_ready and map_size(state.operations) < 32 and
         valid_time?(deadline, wall) do
      ref = make_ref()

      lease = %PreauthDraft.Lease{
        owner: self(),
        reference: ref,
        caller: caller,
        generation: state.generation,
        deadline: deadline,
        started_at: wall,
        runtime: state.runtime
      }

      monitor = Process.monitor(caller)
      expiry = make_ref()
      timer = Process.send_after(self(), {:expire, ref, expiry}, remaining(deadline))

      operations =
        Map.put(state.operations, ref, %{
          lease: lease,
          monitor: monitor,
          timer: timer,
          expiry: expiry,
          last_wall: wall
        })

      {:reply, {:ok, lease}, %{state | operations: operations}}
    else
      {:reply, Store.failure(:admission, :not_started), state}
    end
  end

  def handle_call({:checkpoint, lease}, {caller, _}, state) do
    state = current(state)
    {valid, state} = sample_lease(state, lease, caller)

    reply =
      if valid, do: :ok, else: Store.failure(:commit, :committed)

    {:reply, reply, state}
  end

  def handle_call({:finish, lease, expires}, {caller, _}, state) do
    state = current(state)
    {current_lease, state} = sample_lease(state, lease, caller)
    checked_wall = if current_lease, do: state.operations[lease.reference].last_wall

    valid =
      current_lease and
        (is_nil(expires) or (is_integer(expires) and checked_wall < expires))

    reply =
      if valid,
        do: {:ok, checked_wall},
        else: Store.failure(:commit, :committed)

    state = if valid, do: release(state, lease.reference), else: state
    {:reply, reply, state}
  end

  def handle_call({:failed, lease, {:error, %Store.Failure{} = error}}, {caller, _}, state) do
    if owned_lease?(state, lease, caller) and failure?(error) do
      state =
        if (error.phase === :admission and error.outcome !== :not_started) or
             error.outcome === :unknown, do: invalidate(state), else: state

      {:reply, :ok, release(state, lease.reference)}
    else
      {:reply, Store.failure(:admission, :not_started), state}
    end
  end

  def handle_call({:release, lease}, {caller, _}, state) do
    if owned_lease?(state, lease, caller),
      do: {:reply, :ok, release(state, lease.reference)},
      else: {:reply, Store.failure(:admission, :not_started), state}
  end

  def handle_call(_, _from, state), do: {:reply, Store.failure(:admission, :not_started), state}

  @impl true
  def handle_cast(_, state), do: {:noreply, state}

  @impl true
  def handle_info({:DOWN, monitor, :process, _pid, _reason}, state) do
    if Map.has_key?(state.monitors, monitor) do
      {:noreply, invalidate(state)}
    else
      reference =
        Enum.find_value(state.operations, fn {ref, operation} ->
          if operation.monitor === monitor, do: ref
        end)

      {:noreply, release(state, reference)}
    end
  end

  def handle_info({:expire, reference, expiry}, state) do
    # An expired operation may be waiting for COMMIT acknowledgement. Releasing
    # its slot cannot preserve readiness on an outcome we can no longer fence.
    state =
      case Map.get(state.operations, reference) do
        %{expiry: ^expiry} -> invalidate(state)
        _ -> state
      end

    {:noreply, state}
  end

  def handle_info(_, state), do: {:noreply, state}

  defp current(%{phase: :storage_ready} = state) do
    if Process.whereis(LifecycleRepo) === state.repo and
         Process.whereis(KeyOwner) === state.identity and
         Process.whereis(MixerHosted.Repo) === state.ordinary and repo_bound?(state.runtime),
       do: state,
       else: invalidate(state)
  end

  defp current(state), do: state

  defp invalidate(%{phase: :disabled} = state), do: state

  defp invalidate(state) do
    state = Enum.reduce(Map.keys(state.operations), state, &release(&2, &1))
    %{state | phase: :unavailable, generation: state.generation + 1}
  end

  defp owned_lease?(state, %PreauthDraft.Lease{} = lease, caller) do
    case Map.get(state.operations, lease.reference) do
      %{lease: ^lease} -> lease.caller === caller and lease.owner === self()
      _ -> false
    end
  end

  defp owned_lease?(_, _, _), do: false

  defp failure?(
         %Store.Failure{code: :session_unavailable, phase: phase, outcome: outcome} = error
       ),
       do:
         map_size(error) == 4 and phase in [:admission, :effect, :decode, :commit] and
           outcome in [:not_started, :rolled_back, :committed, :unknown]

  defp failure?(_), do: false

  defp valid_lease?(state, lease, caller),
    do:
      state.phase === :storage_ready and
        owned_lease?(state, lease, caller) and lease.generation === state.generation and
        valid_time?(lease.deadline, lease.started_at)

  defp sample_lease(state, lease, caller) do
    if valid_lease?(state, lease, caller) do
      operation = Map.fetch!(state.operations, lease.reference)
      wall = System.system_time(:second)

      if wall >= operation.last_wall do
        operations = Map.put(state.operations, lease.reference, %{operation | last_wall: wall})
        {true, %{state | operations: operations}}
      else
        {false, invalidate(state)}
      end
    else
      {false, state}
    end
  end

  defp release(state, reference) do
    case Map.pop(state.operations, reference) do
      {nil, _} ->
        state

      {%{monitor: monitor, timer: timer}, operations} ->
        Process.demonitor(monitor, [:flush])
        Process.cancel_timer(timer)
        %{state | operations: operations}
    end
  end

  defp validate_runtime(runtime) do
    with true <- map_size(runtime) == 7,
         {:ok, digest} <- ConfigurationDigest.digest(runtime.browser_config),
         true <- digest === runtime.configuration_digest,
         %Custody{reference: reference, key: key} <- runtime.custody,
         true <- reference === runtime.browser_config.session_vault_ref,
         {:ok, custody} <-
           Custody.new(reference, %{reference: reference, key_id: key.id, key_bytes: key.bytes}),
         true <- custody === runtime.custody,
         true <- repo_bound?(runtime),
         true <-
           MixerHosted.Repo.config()[:username] === runtime.expected_roles.ordinary_runtime_login do
      :ok
    else
      _ -> :error
    end
  rescue
    _ -> :error
  end

  defp repo_bound?(runtime) do
    runtime.lifecycle_repo[:pool_size] === 2 and runtime.lifecycle_repo[:pool_count] === 1 and
      runtime.lifecycle_repo[:queue] === false and runtime.lifecycle_repo[:timeout] === 5000 and
      runtime.lifecycle_repo[:connect_timeout] === 5000 and
      runtime.lifecycle_repo[:show_sensitive_data_on_connection_error] === false and
      runtime.lifecycle_repo[:username] === runtime.expected_roles.lifecycle_login and
      LifecycleRepo.bound?(runtime.lifecycle_repo)
  rescue
    _ -> false
  end

  defp valid_time?(deadline, wall),
    do:
      is_integer(deadline) and is_integer(wall) and
        System.monotonic_time(:millisecond) < deadline and
        deadline <= System.monotonic_time(:millisecond) + 5000 and
        System.system_time(:second) >= wall

  defp remaining(deadline), do: max(1, min(5000, deadline - System.monotonic_time(:millisecond)))

  defp metadata?(%{request_id: id} = metadata)
       when map_size(metadata) == 1 and is_binary(id) and byte_size(id) == 32,
       do: Enum.all?(:binary.bin_to_list(id), &(&1 in ?0..?9 or &1 in ?a..?f))

  defp metadata?(_), do: false
end

0b192479ba5ec76471e760709ababd166d8db6ec blob 63975
defmodule MixerHosted.BrowserAuth.StorageSchema do
  @moduledoc """
  Fixed PostgreSQL lifecycle capability; SQL only, without a running Repo.

  Migration installation is inert. A reviewed operator must separately provision
  existing dedicated roles with `provisioning_statements/2`. This API returns an
  explicit plan and never creates a role, login, password, provider or key.
  Encrypted discovery snapshots are not authentication or verifier evidence.
  """
  @browser_tables ~w(sessions session_vault oidc_attempts session_events)
  @authz_tables ~w(profiles principals bindings families credentials)
  @public_helpers ~w(bootstrap load begin claim provider_reject fail_claim activate logout expire)
  @max 9_007_199_254_740_991

  def maximum_integer, do: @max

  def signatures do
    %{
      "mixer_browser_bootstrap" =>
        "bytea,bytea,text,bytea,bytea,text,integer,bigint,public.mixer_browser_cipher,text",
      "mixer_browser_load" => "bytea,bytea",
      "mixer_browser_begin" =>
        "bytea,bytea,bytea,bigint,public.mixer_browser_attempt,public.mixer_browser_cipher,text",
      "mixer_browser_claim" => "bytea,bytea,bytea,bigint,bytea,bigint,text",
      "mixer_browser_provider_reject" => "bytea,bytea,bytea,bigint,text",
      "mixer_browser_fail_claim" => "bytea,bytea,bytea,bytea,text,text",
      "mixer_browser_activate" =>
        "bytea,bytea,bytea,bytea,bigint,public.mixer_browser_verified,bytea,bytea,text,text,bigint,public.mixer_browser_cipher,text",
      "mixer_browser_logout" => "bytea,bytea,bytea,bigint,text",
      "mixer_browser_expire" => "bytea,bigint,text",
      "mixer_browser_snapshot" => "bytea,bytea",
      "mixer_browser_cipher_valid" => "public.mixer_browser_cipher",
      "mixer_browser_audit" =>
        "public.mixer_browser_sessions,public.mixer_browser_sessions,text,text,bytea,text,public.mixer_browser_verified",
      "mixer_browser_integrity" => "",
      "mixer_browser_attempt_integrity" => "",
      "mixer_browser_event_immutable" => "",
      "mixer_browser_event_integrity" => "",
      "mixer_browser_lock_existing" => "public.mixer_browser_sessions",
      "mixer_browser_revoke_existing" => "public.mixer_browser_sessions,bigint"
    }
  end

  def public_signatures do
    Map.take(signatures(), Enum.map(@public_helpers, &("mixer_browser_" <> &1)))
  end

  @doc "Exact source/configuration manifest for independent catalog admission."
  def catalog_manifest do
    defs =
      Map.new(functions(), fn sql ->
        [head, body, _] = String.split(sql, "$browser$")

        name =
          head
          |> String.split("(", parts: 2)
          |> hd()
          |> String.replace_prefix("CREATE FUNCTION public.", "")

        {name,
         %{
           signature: Map.fetch!(signatures(), name),
           source: body,
           security_definer: true,
           settings: [
             "search_path=pg_catalog",
             "statement_timeout=5s",
             "lock_timeout=500ms",
             "idle_in_transaction_session_timeout=5s",
             "bytea_output=hex"
           ],
           runtime_execute: Map.has_key?(public_signatures(), name)
         }}
      end)

    %{
      version: 1,
      functions: defs,
      relations: Enum.map(@browser_tables, &("mixer_browser_" <> &1)),
      authz_relations: Enum.map(@authz_tables, &("mixer_authz_" <> &1)),
      browser_mutable_columns:
        Map.new(
          ~w(sessions session_vault oidc_attempts),
          &{&1, String.split(mutable_columns(&1), ",")}
        ),
      policies: %{read: "true", insert: "true", update: "true", lock_check: "false"},
      transaction: %{isolation: "read committed", statement_ms: 5000, lock_ms: 500, idle_ms: 5000}
    }
  end

  def statements do
    types() ++
      tables() ++
      functions() ++
      triggers() ++
      Enum.flat_map(@browser_tables, fn name ->
        table = "public.mixer_browser_" <> name

        [
          "ALTER TABLE #{table} ENABLE ROW LEVEL SECURITY",
          "ALTER TABLE #{table} FORCE ROW LEVEL SECURITY",
          "REVOKE ALL ON #{table} FROM PUBLIC"
        ]
      end) ++
      Enum.map(signatures(), fn {name, args} ->
        "REVOKE ALL ON FUNCTION public.#{name}(#{args}) FROM PUBLIC"
      end) ++
      Enum.map(
        ~w(cipher attempt verified),
        &"REVOKE ALL ON TYPE public.mixer_browser_#{&1} FROM PUBLIC"
      )
  end

  # Operator-only generation of a fixed plan. No database or runtime input is
  # consulted here. Do not expose this function through an HTTP/application API.
  def provisioning_statements(writer_role, lifecycle_login) do
    writer = role!(writer_role)
    login = role!(lifecycle_login)
    if writer == login, do: raise(ArgumentError, "distinct lifecycle roles required")

    [
      "BEGIN",
      provisioning_preflight(writer, login),
      "GRANT USAGE, CREATE ON SCHEMA public TO #{writer}"
    ] ++
      Enum.map(signatures(), fn {name, args} ->
        "ALTER FUNCTION public.#{name}(#{args}) OWNER TO #{writer}"
      end) ++
      [
        "REVOKE CREATE ON SCHEMA public FROM #{writer}",
        "GRANT USAGE ON SCHEMA public TO #{login}"
      ] ++
      Enum.flat_map(~w(cipher attempt verified), fn type ->
        ["GRANT USAGE ON TYPE public.mixer_browser_#{type} TO #{writer}, #{login}"]
      end) ++
      role_policies(writer) ++
      Enum.map(public_signatures(), fn {name, args} ->
        "GRANT EXECUTE ON FUNCTION public.#{name}(#{args}) TO #{login}"
      end) ++ ["COMMIT"]
  end

  def rollback_statements do
    # Owner is recorded in the exact capability, not accepted from a session GUC.
    # Inert migration functions share the migration/table owner and need no revoke.
    # Functions returning/accepting session row types precede the session table.
    [
      """
      DO $rollback$
      DECLARE w name; t name;
      BEGIN
        SELECT r.rolname INTO w FROM pg_catalog.pg_proc p
        JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace
        JOIN pg_catalog.pg_roles r ON r.oid=p.proowner
        WHERE n.nspname='public' AND p.proname='mixer_browser_load'
          AND pg_catalog.pg_get_function_identity_arguments(p.oid)='p_cookie bytea, p_config bytea';
        SELECT r.rolname INTO t FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_roles r ON r.oid=c.relowner
        WHERE c.oid='public.mixer_browser_sessions'::pg_catalog.regclass;
        IF w IS NOT NULL AND w <> t THEN
          EXECUTE pg_catalog.format('REVOKE SELECT ON public.mixer_authz_profiles,public.mixer_authz_principals,public.mixer_authz_bindings,public.mixer_authz_families,public.mixer_authz_credentials FROM %I', w);
          EXECUTE pg_catalog.format('REVOKE UPDATE(state_revision) ON public.mixer_authz_profiles FROM %I', w);
          EXECUTE pg_catalog.format('REVOKE UPDATE(revision) ON public.mixer_authz_principals FROM %I', w);
          EXECUTE pg_catalog.format('REVOKE INSERT,UPDATE(active,revision) ON public.mixer_authz_families FROM %I', w);
          EXECUTE pg_catalog.format('REVOKE INSERT,UPDATE(active,revision) ON public.mixer_authz_credentials FROM %I', w);
        END IF;
      END $rollback$;
      """
    ] ++
      Enum.flat_map(@authz_tables, fn table ->
        Enum.map(
          ~w(read lock insert update),
          &"DROP POLICY IF EXISTS mixer_browser_#{&1} ON public.mixer_authz_#{table}"
        )
      end) ++
      Enum.flat_map(@browser_tables, fn table ->
        [
          "DROP TRIGGER IF EXISTS mixer_browser_integrity ON public.mixer_browser_#{table}",
          "DROP TRIGGER IF EXISTS mixer_browser_immutable ON public.mixer_browser_#{table}"
        ]
      end) ++
      Enum.map(
        ~w(session_events oidc_attempts session_vault),
        &"DROP TABLE public.mixer_browser_#{&1}"
      ) ++
      Enum.map(signatures(), fn {name, args} -> "DROP FUNCTION public.#{name}(#{args})" end) ++
      ["DROP TABLE public.mixer_browser_sessions"] ++
      Enum.map(~w(verified attempt cipher), &"DROP TYPE public.mixer_browser_#{&1}")
  end

  defp role!(name) when is_binary(name) and byte_size(name) in 1..63 do
    valid =
      name != "public" and not String.starts_with?(name, "pg_") and
        name
        |> :binary.bin_to_list()
        |> Enum.with_index()
        |> Enum.all?(fn {c, i} -> c in ?a..?z or c == ?_ or (i > 0 and c in ?0..?9) end)

    if valid, do: name, else: raise(ArgumentError, "restricted role identifier required")
  end

  defp role!(_), do: raise(ArgumentError, "restricted role identifier required")

  defp provisioning_preflight(writer, login) do
    """
    DO $admit$
    DECLARE w pg_catalog.pg_roles; l pg_catalog.pg_roles;
    BEGIN
      SELECT * INTO STRICT w FROM pg_catalog.pg_roles WHERE rolname='#{writer}';
      SELECT * INTO STRICT l FROM pg_catalog.pg_roles WHERE rolname='#{login}';
      IF w.rolcanlogin OR w.rolsuper OR w.rolbypassrls OR w.rolcreaterole OR w.rolcreatedb OR w.rolreplication OR w.rolinherit
        OR NOT l.rolcanlogin OR l.rolsuper OR l.rolbypassrls OR l.rolcreaterole OR l.rolcreatedb OR l.rolreplication OR l.rolinherit
        OR EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members WHERE member IN(w.oid,l.oid) OR roleid IN(w.oid,l.oid))
        OR EXISTS (SELECT 1 FROM pg_catalog.pg_class WHERE relowner IN(w.oid,l.oid))
        OR EXISTS (SELECT 1 FROM pg_catalog.pg_namespace WHERE nspowner IN(w.oid,l.oid)
          OR pg_catalog.has_schema_privilege(w.oid,oid,'CREATE') OR pg_catalog.has_schema_privilege(l.oid,oid,'CREATE'))
        OR EXISTS (SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
          WHERE n.nspname='public' AND c.relkind IN('r','p','v','m','f') AND
           (pg_catalog.has_table_privilege(w.oid,c.oid,'SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER')
            OR pg_catalog.has_table_privilege(l.oid,c.oid,'SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER')
            OR pg_catalog.has_any_column_privilege(w.oid,c.oid,'SELECT,INSERT,UPDATE,REFERENCES')
            OR pg_catalog.has_any_column_privilege(l.oid,c.oid,'SELECT,INSERT,UPDATE,REFERENCES')))
      THEN RAISE EXCEPTION 'browser lifecycle provisioning denied' USING ERRCODE='42501'; END IF;
    END $admit$;
    """
  end

  defp role_policies(writer) do
    Enum.flat_map(@browser_tables, fn table ->
      rel = "public.mixer_browser_" <> table

      if table == "session_events" do
        [
          "CREATE POLICY mixer_browser_read ON #{rel} FOR SELECT TO #{writer} USING (true)",
          "CREATE POLICY mixer_browser_insert ON #{rel} FOR INSERT TO #{writer} WITH CHECK (true)",
          "GRANT SELECT,INSERT ON #{rel} TO #{writer}"
        ]
      else
        [
          "CREATE POLICY mixer_browser_read ON #{rel} FOR SELECT TO #{writer} USING (true)",
          "CREATE POLICY mixer_browser_insert ON #{rel} FOR INSERT TO #{writer} WITH CHECK (true)",
          "CREATE POLICY mixer_browser_update ON #{rel} FOR UPDATE TO #{writer} USING (true) WITH CHECK (true)",
          "GRANT SELECT,INSERT ON #{rel} TO #{writer}",
          "GRANT UPDATE(#{mutable_columns(table)}) ON #{rel} TO #{writer}"
        ]
      end
    end) ++
      Enum.flat_map(@authz_tables, fn table ->
        rel = "public.mixer_authz_" <> table

        read = [
          "CREATE POLICY mixer_browser_read ON #{rel} FOR SELECT TO #{writer} USING (true)",
          "GRANT SELECT ON #{rel} TO #{writer}"
        ]

        case table do
          "bindings" ->
            read

          lock when lock in ["profiles", "principals"] ->
            column = if table == "profiles", do: "state_revision", else: "revision"

            read ++
              [
                "CREATE POLICY mixer_browser_lock ON #{rel} FOR UPDATE TO #{writer} USING (true) WITH CHECK (false)",
                "GRANT UPDATE(#{column}) ON #{rel} TO #{writer}"
              ]

          _ ->
            read ++
              [
                "CREATE POLICY mixer_browser_insert ON #{rel} FOR INSERT TO #{writer} WITH CHECK (true)",
                "CREATE POLICY mixer_browser_update ON #{rel} FOR UPDATE TO #{writer} USING (true) WITH CHECK (true)",
                "GRANT INSERT,UPDATE(active,revision) ON #{rel} TO #{writer}"
              ]
        end
      end)
  end

  defp mutable_columns("sessions"),
    do:
      "cookie_digest,status,epoch,revision,generation,csrf_digest,last_seen_at,absolute_expires_at,idle_expires_at,profile_id,profile_version,principal_id,family_id,credential_ref,credential_revision,audit_sequence"

  defp mutable_columns("session_vault"),
    do:
      "epoch,session_revision,vault_generation,ciphertext_version,envelope_kind,key_id,iv,tag,ciphertext"

  defp mutable_columns("oidc_attempts"),
    do:
      "status,claim_digest,claimed_at,claim_expires_at,completion_reason,key_id,iv,tag,ciphertext"

  defp types do
    [
      "CREATE TYPE public.mixer_browser_cipher AS (key_id text,iv bytea,tag bytea,ciphertext bytea)",
      "CREATE TYPE public.mixer_browser_attempt AS (state_digest bytea,nonce_digest bytea,profile_id text,profile_version integer,issuer text,client_id text,redirect_uri text,expires_at bigint,cipher public.mixer_browser_cipher)",
      "CREATE TYPE public.mixer_browser_verified AS (profile_id text,profile_version integer,issuer text,subject text,client_id text,credential_ref text,issued_at bigint,expires_at bigint,scopes text[],profile_revision bigint,binding_revision bigint,principal_revision bigint)"
    ]
  end

  defp tables do
    [
      """
      CREATE TABLE public.mixer_browser_sessions (
        id bytea PRIMARY KEY CHECK (octet_length(id)=16),
        cookie_digest bytea NOT NULL UNIQUE CHECK (octet_length(cookie_digest)=32),
        status text NOT NULL CHECK (status IN('preauth','active','revoked','expired')),
        epoch bigint NOT NULL CHECK (epoch BETWEEN 1 AND 9007199254740991),
        revision bigint NOT NULL CHECK (revision BETWEEN 1 AND 9007199254740991),
        generation text NOT NULL CHECK (generation ~ '^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$'),
        csrf_digest bytea NOT NULL CHECK (octet_length(csrf_digest)=32),
        created_at bigint NOT NULL CHECK (created_at BETWEEN 0 AND 9007199254740991),
        last_seen_at bigint NOT NULL CHECK (last_seen_at >= created_at),
        absolute_expires_at bigint NOT NULL CHECK (absolute_expires_at > created_at AND absolute_expires_at <=9007199254740991),
        idle_expires_at bigint NOT NULL CHECK (idle_expires_at > created_at AND idle_expires_at <=absolute_expires_at),
        expected_profile_id text NOT NULL CHECK (octet_length(expected_profile_id) BETWEEN 1 AND 128),
        expected_profile_version integer NOT NULL CHECK (expected_profile_version > 0),
        initial_config_digest bytea NOT NULL CHECK (octet_length(initial_config_digest)=32),
        config_digest bytea NOT NULL CHECK (octet_length(config_digest)=32),
        profile_id text,profile_version integer,principal_id text,family_id text,credential_ref text,credential_revision bigint,
        audit_sequence bigint NOT NULL CHECK (audit_sequence BETWEEN 1 AND 9007199254740991),
        CHECK ((profile_id IS NULL AND profile_version IS NULL AND principal_id IS NULL AND family_id IS NULL AND credential_ref IS NULL AND credential_revision IS NULL AND status<>'active') OR
          (profile_id IS NOT NULL AND profile_version IS NOT NULL AND principal_id IS NOT NULL AND family_id IS NOT NULL AND credential_ref IS NOT NULL AND credential_revision IS NOT NULL AND credential_revision BETWEEN 1 AND 9007199254740991 AND status<>'preauth')),
        FOREIGN KEY(profile_id,profile_version,credential_ref) REFERENCES public.mixer_authz_credentials(profile_id,profile_version,reference),
        FOREIGN KEY(family_id,profile_id,profile_version,principal_id) REFERENCES public.mixer_authz_families(id,profile_id,profile_version,principal_id)
      )
      """,
      """
      CREATE TABLE public.mixer_browser_session_vault (
        browser_id bytea PRIMARY KEY REFERENCES public.mixer_browser_sessions(id),
        epoch bigint NOT NULL CHECK (epoch BETWEEN 1 AND 9007199254740991),
        session_revision bigint NOT NULL CHECK (session_revision BETWEEN 1 AND 9007199254740991),
        vault_generation bigint NOT NULL CHECK (vault_generation BETWEEN 1 AND 9007199254740991),
        ciphertext_version integer NOT NULL CHECK (ciphertext_version=1),
        envelope_kind text NOT NULL CHECK (envelope_kind IN('preauth','active','erased')),
        key_id text,iv bytea,tag bytea,ciphertext bytea,
        CHECK ((envelope_kind='erased' AND key_id IS NULL AND iv IS NULL AND tag IS NULL AND ciphertext IS NULL) OR
          (envelope_kind IN('preauth','active') AND key_id IS NOT NULL AND key_id ~ '^[A-Za-z0-9._-]{1,128}$' AND iv IS NOT NULL AND octet_length(iv)=12 AND tag IS NOT NULL AND octet_length(tag)=16 AND ciphertext IS NOT NULL AND octet_length(ciphertext) BETWEEN 1 AND 8192))
      )
      """,
      """
      CREATE TABLE public.mixer_browser_oidc_attempts (
        state_digest bytea PRIMARY KEY CHECK(octet_length(state_digest)=32),
        browser_id bytea NOT NULL REFERENCES public.mixer_browser_sessions(id),
        browser_epoch bigint NOT NULL CHECK(browser_epoch BETWEEN 1 AND 9007199254740991),
        browser_revision bigint NOT NULL CHECK(browser_revision BETWEEN 1 AND 9007199254740991),
        cookie_digest bytea NOT NULL CHECK(octet_length(cookie_digest)=32),
        generation text NOT NULL CHECK(generation ~ '^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$'),
        config_digest bytea NOT NULL CHECK(octet_length(config_digest)=32),
        profile_id text NOT NULL CHECK(octet_length(profile_id) BETWEEN 1 AND 128),
        profile_version integer NOT NULL CHECK(profile_version > 0),
        issuer text NOT NULL CHECK(octet_length(issuer) BETWEEN 1 AND 2048),
        client_id text NOT NULL CHECK(octet_length(client_id) BETWEEN 1 AND 256),
        redirect_uri text NOT NULL CHECK(octet_length(redirect_uri) BETWEEN 1 AND 2048),
        return_route text NOT NULL CHECK(return_route='workspace'),
        nonce_digest bytea NOT NULL CHECK(octet_length(nonce_digest)=32),
        created_at bigint NOT NULL CHECK(created_at BETWEEN 0 AND 9007199254740991),
        expires_at bigint NOT NULL CHECK(expires_at > created_at AND expires_at<=created_at+300 AND expires_at<=9007199254740991),
        status text NOT NULL CHECK(status IN('pending','claimed','provider_rejected','completed','failed','superseded')),
        claim_digest bytea CHECK(octet_length(claim_digest)=32),
        claimed_at bigint, claim_expires_at bigint,
        completion_reason text CHECK(completion_reason IN('provider_rejected','exchange_failed','oidc_failed','identity_failed','session_failed','completed','superseded','expired','logout')),
        ciphertext_version integer NOT NULL DEFAULT 1 CHECK(ciphertext_version=1),
        key_id text,iv bytea,tag bytea,ciphertext bytea,
        CHECK ((status='pending' AND claim_digest IS NULL AND claimed_at IS NULL AND claim_expires_at IS NULL AND completion_reason IS NULL AND key_id IS NOT NULL AND key_id ~ '^[A-Za-z0-9._-]{1,128}$' AND iv IS NOT NULL AND octet_length(iv)=12 AND tag IS NOT NULL AND octet_length(tag)=16 AND ciphertext IS NOT NULL AND octet_length(ciphertext) BETWEEN 1 AND 8192) OR
          (status<>'pending' AND key_id IS NULL AND iv IS NULL AND tag IS NULL AND ciphertext IS NULL AND
           ((status='claimed' AND completion_reason IS NULL AND claim_digest IS NOT NULL AND claimed_at IS NOT NULL AND claim_expires_at IS NOT NULL AND claimed_at>=created_at AND claim_expires_at>claimed_at AND claim_expires_at<=expires_at) OR
            (completion_reason IS NOT NULL AND ((status='provider_rejected' AND completion_reason='provider_rejected') OR (status='completed' AND completion_reason='completed' AND claim_digest IS NOT NULL) OR (status='failed' AND completion_reason IN('exchange_failed','oidc_failed','identity_failed','session_failed') AND claim_digest IS NOT NULL) OR (status='superseded' AND completion_reason IN('superseded','expired','logout')))))))
      )
      """,
      "CREATE UNIQUE INDEX mixer_browser_one_attempt ON public.mixer_browser_oidc_attempts(browser_id,browser_epoch) WHERE status IN('pending','claimed')",
      """
      CREATE TABLE public.mixer_browser_session_events (
        browser_id bytea NOT NULL REFERENCES public.mixer_browser_sessions(id),
        sequence bigint NOT NULL CHECK(sequence BETWEEN 1 AND 9007199254740991),
        audit_schema integer NOT NULL CHECK(audit_schema=1),
        operation text NOT NULL CHECK(operation IN('bootstrap','begin','claim','provider_reject','fail_claim','activate','replace','logout','expire')),
        outcome text NOT NULL CHECK(outcome IN('created','pending','claimed','provider_rejected','failed','active','revoked','expired')),
        request_id text NOT NULL CHECK(request_id ~ '^[0-9a-f]{32}$'),
        recorded_at bigint NOT NULL CHECK(recorded_at BETWEEN 0 AND 9007199254740991),
        old_revision bigint, new_revision bigint NOT NULL CHECK(new_revision BETWEEN 1 AND 9007199254740991), old_epoch bigint,new_epoch bigint NOT NULL CHECK(new_epoch BETWEEN 1 AND 9007199254740991),
        old_status text,new_status text NOT NULL CHECK(new_status IN('preauth','active','revoked','expired')),
        config_digest bytea NOT NULL CHECK(octet_length(config_digest)=32), attempt_state_digest bytea CHECK(octet_length(attempt_state_digest)=32),
        profile_id text,profile_version integer,principal_id text,family_id text,
        issuer_hash bytea CHECK(octet_length(issuer_hash)=32),subject_hash bytea CHECK(octet_length(subject_hash)=32),
        client_hash bytea CHECK(octet_length(client_hash)=32),credential_hash bytea CHECK(octet_length(credential_hash)=32),
        profile_revision bigint,binding_revision bigint,principal_revision bigint,family_revision bigint,credential_revision bigint,
        token_issued_at bigint,token_expires_at bigint,
        PRIMARY KEY(browser_id,sequence),
        CHECK((sequence=1 AND operation='bootstrap' AND old_revision IS NULL AND old_epoch IS NULL AND old_status IS NULL AND new_revision=1 AND new_epoch=1 AND new_status='preauth' AND outcome='created') OR
          (sequence>1 AND old_revision IS NOT NULL AND old_revision BETWEEN 1 AND 9007199254740991 AND old_epoch IS NOT NULL AND old_epoch BETWEEN 1 AND 9007199254740991 AND old_status IS NOT NULL AND old_status IN('preauth','active') AND
           ((operation='begin' AND outcome='pending' AND new_status=old_status AND new_revision=old_revision+1 AND new_epoch=old_epoch+1) OR
            (operation='claim' AND outcome='claimed' AND new_status=old_status AND new_revision=old_revision AND new_epoch=old_epoch) OR
            (operation='provider_reject' AND outcome='provider_rejected' AND new_status=old_status AND new_revision=old_revision AND new_epoch=old_epoch) OR
            (operation='fail_claim' AND outcome='failed' AND new_status=old_status AND new_revision=old_revision AND new_epoch=old_epoch) OR
            (operation='activate' AND outcome='active' AND old_status='preauth' AND new_status='active' AND new_revision=old_revision+1 AND new_epoch=old_epoch+1) OR
            (operation='replace' AND outcome='active' AND old_status='active' AND new_status='active' AND new_revision=old_revision+1 AND new_epoch=old_epoch+1) OR
            (operation='logout' AND outcome='revoked' AND new_status='revoked' AND new_revision=old_revision+1 AND new_epoch=old_epoch+1) OR
            (operation='expire' AND outcome='expired' AND new_status='expired' AND new_revision=old_revision+1 AND new_epoch=old_epoch+1)))),
        CHECK((operation IN('activate','replace') AND token_issued_at IS NOT NULL AND token_expires_at>token_issued_at AND issuer_hash IS NOT NULL AND subject_hash IS NOT NULL AND client_hash IS NOT NULL AND credential_hash IS NOT NULL) OR
          (operation NOT IN('activate','replace') AND token_issued_at IS NULL AND token_expires_at IS NULL AND issuer_hash IS NULL AND subject_hash IS NULL AND client_hash IS NULL AND credential_hash IS NULL))
      )
      """
    ]
  end

  defp function(name, args, result, body) do
    """
    CREATE FUNCTION public.#{name}(#{args}) RETURNS #{result}
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path=pg_catalog SET statement_timeout='5s'
    SET lock_timeout='500ms' SET idle_in_transaction_session_timeout='5s' SET bytea_output='hex'
    AS $browser$
    #{body}
    $browser$
    """
  end

  defp functions do
    primitive_functions() ++ lifecycle_functions()
  end

  defp primitive_functions do
    [
      function("mixer_browser_cipher_valid", "c public.mixer_browser_cipher", "boolean", """
      BEGIN
        RETURN c.key_id IS NOT NULL AND c.key_id ~ '^[A-Za-z0-9._-]{1,128}$'
          AND c.iv IS NOT NULL AND octet_length(c.iv)=12 AND c.tag IS NOT NULL AND octet_length(c.tag)=16
          AND c.ciphertext IS NOT NULL AND octet_length(c.ciphertext) BETWEEN 1 AND 8192;
      END;
      """),
      function("mixer_browser_snapshot", "p_browser bytea,p_state bytea", "jsonb", """
      DECLARE b public.mixer_browser_sessions; v public.mixer_browser_session_vault; a public.mixer_browser_oidc_attempts;
      BEGIN
        SELECT * INTO STRICT b FROM public.mixer_browser_sessions WHERE id=p_browser;
        SELECT * INTO v FROM public.mixer_browser_session_vault WHERE browser_id=b.id;
        IF p_state IS NOT NULL THEN SELECT * INTO a FROM public.mixer_browser_oidc_attempts WHERE state_digest=p_state AND browser_id=b.id; END IF;
        RETURN pg_catalog.jsonb_build_object('browser',pg_catalog.to_jsonb(b),'vault',CASE WHEN v.browser_id IS NULL THEN NULL ELSE pg_catalog.to_jsonb(v) END,
          'attempt',CASE WHEN a.state_digest IS NULL THEN NULL ELSE pg_catalog.to_jsonb(a) END);
      END;
      """),
      function(
        "mixer_browser_audit",
        "o public.mixer_browser_sessions,n public.mixer_browser_sessions,p_operation text,p_outcome text,p_state bytea,p_request text,i public.mixer_browser_verified",
        "void",
        """
        BEGIN
          INSERT INTO public.mixer_browser_session_events(browser_id,sequence,audit_schema,operation,outcome,request_id,recorded_at,
            old_revision,new_revision,old_epoch,new_epoch,old_status,new_status,config_digest,attempt_state_digest,profile_id,profile_version,principal_id,family_id,
            issuer_hash,subject_hash,client_hash,credential_hash,profile_revision,binding_revision,principal_revision,family_revision,credential_revision,token_issued_at,token_expires_at)
          VALUES(n.id,n.audit_sequence,1,p_operation,p_outcome,p_request,pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint,
            o.revision,n.revision,o.epoch,n.epoch,o.status,n.status,n.config_digest,p_state,n.profile_id,n.profile_version,n.principal_id,n.family_id,
            CASE WHEN i.issuer IS NULL THEN NULL ELSE pg_catalog.sha256(pg_catalog.convert_to('mixer.browser.audit.issuer.v1','UTF8')||pg_catalog.decode('00','hex')||pg_catalog.int4send(octet_length(i.issuer))||pg_catalog.convert_to(i.issuer,'UTF8')) END,
            CASE WHEN i.subject IS NULL THEN NULL ELSE pg_catalog.sha256(pg_catalog.convert_to('mixer.browser.audit.subject.v1','UTF8')||pg_catalog.decode('00','hex')||pg_catalog.int4send(octet_length(i.subject))||pg_catalog.convert_to(i.subject,'UTF8')) END,
            CASE WHEN i.client_id IS NULL THEN NULL ELSE pg_catalog.sha256(pg_catalog.convert_to('mixer.browser.audit.client.v1','UTF8')||pg_catalog.decode('00','hex')||pg_catalog.int4send(octet_length(i.client_id))||pg_catalog.convert_to(i.client_id,'UTF8')) END,
            CASE WHEN i.credential_ref IS NULL THEN NULL ELSE pg_catalog.sha256(pg_catalog.convert_to('mixer.browser.audit.jti.v1','UTF8')||pg_catalog.decode('00','hex')||pg_catalog.int4send(octet_length(i.credential_ref))||pg_catalog.convert_to(i.credential_ref,'UTF8')) END,
            i.profile_revision,i.binding_revision,i.principal_revision,CASE WHEN i.profile_id IS NULL THEN NULL ELSE 1 END,n.credential_revision,i.issued_at,i.expires_at);
        END;
        """
      ),
      function("mixer_browser_lock_existing", "d public.mixer_browser_sessions", "void", """
      DECLARE f public.mixer_authz_families; c public.mixer_authz_credentials; count_credentials integer;
      BEGIN
        IF d.family_id IS NULL THEN RETURN; END IF;
        PERFORM 1 FROM public.mixer_authz_profiles WHERE id=d.profile_id AND version=d.profile_version FOR UPDATE;
        PERFORM 1 FROM public.mixer_authz_principals WHERE id=d.principal_id FOR UPDATE;
        SELECT * INTO STRICT f FROM public.mixer_authz_families WHERE id=d.family_id FOR UPDATE;
        PERFORM 1 FROM public.mixer_authz_credentials WHERE family_id=d.family_id ORDER BY profile_id COLLATE "C",profile_version,reference COLLATE "C" LIMIT 2 FOR UPDATE;
        SELECT count(*) INTO count_credentials FROM (SELECT 1 FROM public.mixer_authz_credentials WHERE family_id=d.family_id LIMIT 2) bounded;
        IF count_credentials<>1 OR f.profile_id<>d.profile_id OR f.profile_version<>d.profile_version OR f.principal_id<>d.principal_id THEN
          RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001';
        END IF;
        SELECT * INTO STRICT c FROM public.mixer_authz_credentials WHERE profile_id=d.profile_id AND profile_version=d.profile_version AND reference=d.credential_ref;
        IF c.principal_id<>d.principal_id OR c.family_id<>d.family_id THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
      END;
      """),
      function(
        "mixer_browser_revoke_existing",
        "d public.mixer_browser_sessions,p_now bigint",
        "void",
        """
        BEGIN
          IF d.family_id IS NULL THEN RETURN; END IF;
          UPDATE public.mixer_authz_families SET active=false,revision=revision+1 WHERE id=d.family_id AND active;
          UPDATE public.mixer_authz_credentials SET active=false,revision=revision+1 WHERE family_id=d.family_id AND active;
        END;
        """
      ),
      function("mixer_browser_integrity", "", "trigger", """
      DECLARE e public.mixer_browser_session_events; v public.mixer_browser_session_vault; c public.mixer_authz_credentials; b public.mixer_browser_sessions;
      BEGIN
        IF TG_TABLE_NAME='mixer_browser_session_vault' THEN
          SELECT * INTO STRICT b FROM public.mixer_browser_sessions WHERE id=NEW.browser_id;
        ELSE b:=NEW;
        END IF;
        SELECT * INTO e FROM public.mixer_browser_session_events WHERE browser_id=b.id AND sequence=b.audit_sequence;
        IF NOT FOUND OR e.new_revision<>b.revision OR e.new_epoch<>b.epoch OR e.new_status<>b.status OR e.config_digest<>b.config_digest THEN
          RAISE EXCEPTION 'browser audit transition missing' USING ERRCODE='23514'; END IF;
        IF TG_TABLE_NAME='mixer_browser_session_vault' THEN
          IF TG_OP='INSERT' THEN
            IF e.operation<>'bootstrap' OR NEW.vault_generation<>1 OR NEW.epoch<>1 OR NEW.session_revision<>1 THEN RAISE EXCEPTION 'browser vault initial transition invalid' USING ERRCODE='23514'; END IF;
          ELSE
            IF e.operation NOT IN('begin','activate','replace','logout','expire') OR NEW.browser_id<>OLD.browser_id OR NEW.vault_generation<>OLD.vault_generation+1
              OR NEW.epoch<>OLD.epoch+1 OR NEW.session_revision<>OLD.session_revision+1
            THEN RAISE EXCEPTION 'browser vault transition invalid' USING ERRCODE='23514'; END IF;
          END IF;
        END IF;
        IF TG_TABLE_NAME='mixer_browser_sessions' THEN
          IF TG_OP='INSERT' THEN
            IF b.audit_sequence<>1 OR e.operation<>'bootstrap' OR e.old_revision IS NOT NULL THEN RAISE EXCEPTION 'browser initial transition invalid' USING ERRCODE='23514'; END IF;
          ELSE
            IF b.audit_sequence<>OLD.audit_sequence+1 OR e.old_revision<>OLD.revision OR e.old_epoch<>OLD.epoch OR e.old_status<>OLD.status OR b.id<>OLD.id
              OR b.created_at<>OLD.created_at OR b.initial_config_digest<>OLD.initial_config_digest OR b.config_digest<>OLD.config_digest OR OLD.status IN('revoked','expired')
              OR (b.revision=OLD.revision AND (pg_catalog.to_jsonb(b)-'audit_sequence') IS DISTINCT FROM (pg_catalog.to_jsonb(OLD)-'audit_sequence'))
              OR b.revision NOT IN(OLD.revision,OLD.revision+1) OR b.epoch NOT IN(OLD.epoch,OLD.epoch+1)
            THEN RAISE EXCEPTION 'browser transition invalid' USING ERRCODE='23514'; END IF;
          END IF;
        END IF;
        SELECT * INTO v FROM public.mixer_browser_session_vault WHERE browser_id=b.id;
        IF b.status IN('preauth','active') THEN
          IF NOT FOUND OR v.epoch<>b.epoch OR v.session_revision<>b.revision OR v.envelope_kind<>b.status THEN RAISE EXCEPTION 'browser vault linkage invalid' USING ERRCODE='23514'; END IF;
        ELSIF FOUND AND (v.ciphertext IS NOT NULL) THEN RAISE EXCEPTION 'terminal browser vault retained' USING ERRCODE='23514'; END IF;
        IF b.status='active' THEN
          SELECT * INTO STRICT c FROM public.mixer_authz_credentials WHERE profile_id=b.profile_id AND profile_version=b.profile_version AND reference=b.credential_ref;
          IF c.principal_id<>b.principal_id OR c.family_id<>b.family_id OR c.revision<>b.credential_revision THEN RAISE EXCEPTION 'browser credential linkage invalid' USING ERRCODE='23514'; END IF;
        END IF;
        RETURN NULL;
      END;
      """),
      function("mixer_browser_attempt_integrity", "", "trigger", """
      DECLARE b public.mixer_browser_sessions; e public.mixer_browser_session_events;
      BEGIN
        SELECT * INTO STRICT b FROM public.mixer_browser_sessions WHERE id=NEW.browser_id;
        SELECT * INTO STRICT e FROM public.mixer_browser_session_events WHERE browser_id=b.id AND sequence=b.audit_sequence;
        IF TG_OP='UPDATE' AND (OLD.status NOT IN('pending','claimed') OR NEW.state_digest<>OLD.state_digest OR NEW.browser_id<>OLD.browser_id OR NEW.browser_epoch<>OLD.browser_epoch
          OR NEW.browser_revision<>OLD.browser_revision OR NEW.config_digest<>OLD.config_digest OR NEW.profile_id<>OLD.profile_id OR NEW.profile_version<>OLD.profile_version
          OR NEW.issuer<>OLD.issuer OR NEW.client_id<>OLD.client_id OR NEW.redirect_uri<>OLD.redirect_uri OR NEW.nonce_digest<>OLD.nonce_digest OR NEW.expires_at<>OLD.expires_at
          OR NEW.cookie_digest<>OLD.cookie_digest OR NEW.generation<>OLD.generation OR NEW.created_at<>OLD.created_at
          OR (OLD.status='claimed' AND (NEW.status NOT IN('completed','failed','superseded') OR NEW.claim_digest IS DISTINCT FROM OLD.claim_digest OR NEW.claimed_at IS DISTINCT FROM OLD.claimed_at OR NEW.claim_expires_at IS DISTINCT FROM OLD.claim_expires_at))
          OR (OLD.status='pending' AND NEW.status NOT IN('claimed','provider_rejected','superseded')))
        THEN RAISE EXCEPTION 'browser attempt transition invalid' USING ERRCODE='23514'; END IF;
        IF TG_OP='INSERT' THEN
          IF e.operation<>'begin' OR e.attempt_state_digest IS DISTINCT FROM NEW.state_digest OR NEW.status<>'pending'
            OR NEW.browser_epoch<>b.epoch OR NEW.browser_revision<>b.revision OR NEW.cookie_digest<>b.cookie_digest OR NEW.generation<>b.generation OR NEW.config_digest<>b.config_digest
          THEN RAISE EXCEPTION 'browser attempt event missing' USING ERRCODE='23514'; END IF;
        ELSE
          IF (NEW.status='claimed' AND (e.operation<>'claim' OR e.attempt_state_digest IS DISTINCT FROM NEW.state_digest))
            OR (NEW.status='provider_rejected' AND (e.operation<>'provider_reject' OR e.attempt_state_digest IS DISTINCT FROM NEW.state_digest))
            OR (NEW.status='completed' AND (e.operation NOT IN('activate','replace') OR e.attempt_state_digest IS DISTINCT FROM NEW.state_digest))
            OR (NEW.status='failed' AND (e.operation<>'fail_claim' OR e.attempt_state_digest IS DISTINCT FROM NEW.state_digest))
            OR (NEW.status='superseded' AND (e.operation NOT IN('begin','logout','expire') OR (e.operation='begin' AND e.attempt_state_digest IS NOT DISTINCT FROM NEW.state_digest)))
          THEN RAISE EXCEPTION 'browser attempt event missing' USING ERRCODE='23514'; END IF;
        END IF;
        RETURN NULL;
      END;
      """),
      function("mixer_browser_event_immutable", "", "trigger", """
      BEGIN RAISE EXCEPTION 'browser audit is immutable' USING ERRCODE='42501'; END;
      """),
      function("mixer_browser_event_integrity", "", "trigger", """
      DECLARE b public.mixer_browser_sessions; p public.mixer_browser_session_events;
      BEGIN
        SELECT * INTO STRICT b FROM public.mixer_browser_sessions WHERE id=NEW.browser_id;
        IF NEW.sequence>b.audit_sequence OR (NEW.sequence=b.audit_sequence AND (NEW.new_revision<>b.revision OR NEW.new_epoch<>b.epoch OR NEW.new_status<>b.status OR NEW.config_digest<>b.config_digest)) THEN
          RAISE EXCEPTION 'orphan browser event' USING ERRCODE='23514'; END IF;
        IF NEW.sequence>1 THEN
          SELECT * INTO STRICT p FROM public.mixer_browser_session_events WHERE browser_id=NEW.browser_id AND sequence=NEW.sequence-1;
          IF NEW.old_revision<>p.new_revision OR NEW.old_epoch<>p.new_epoch OR NEW.old_status<>p.new_status THEN RAISE EXCEPTION 'browser audit chain invalid' USING ERRCODE='23514'; END IF;
        END IF;
        RETURN NULL;
      END;
      """)
    ]
  end

  defp triggers do
    [
      "CREATE CONSTRAINT TRIGGER mixer_browser_integrity AFTER INSERT OR UPDATE ON public.mixer_browser_sessions DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION public.mixer_browser_integrity()",
      "CREATE CONSTRAINT TRIGGER mixer_browser_integrity AFTER INSERT OR UPDATE ON public.mixer_browser_session_vault DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION public.mixer_browser_integrity()",
      "CREATE CONSTRAINT TRIGGER mixer_browser_integrity AFTER INSERT OR UPDATE ON public.mixer_browser_oidc_attempts DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION public.mixer_browser_attempt_integrity()",
      "CREATE CONSTRAINT TRIGGER mixer_browser_integrity AFTER INSERT ON public.mixer_browser_session_events DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION public.mixer_browser_event_integrity()",
      "CREATE TRIGGER mixer_browser_immutable BEFORE UPDATE OR DELETE ON public.mixer_browser_session_events FOR EACH ROW EXECUTE FUNCTION public.mixer_browser_event_immutable()"
    ]
  end

  defp lifecycle_functions do
    bootstrap_and_load() ++ attempts() ++ activation() ++ termination()
  end

  defp bootstrap_and_load do
    [
      function(
        "mixer_browser_bootstrap",
        "p_id bytea,p_cookie bytea,p_generation text,p_csrf bytea,p_config bytea,p_profile text,p_version integer,p_deadline bigint,p_cipher public.mixer_browser_cipher,p_request text",
        "jsonb",
        """
        DECLARE b public.mixer_browser_sessions; n bigint;
        BEGIN
          n:=pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint;
          IF p_deadline IS NULL OR p_deadline<=n OR p_deadline>n+300 OR NOT public.mixer_browser_cipher_valid(p_cipher) THEN
            RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          INSERT INTO public.mixer_browser_sessions(id,cookie_digest,status,epoch,revision,generation,csrf_digest,created_at,last_seen_at,absolute_expires_at,idle_expires_at,
            expected_profile_id,expected_profile_version,initial_config_digest,config_digest,audit_sequence)
          VALUES(p_id,p_cookie,'preauth',1,1,p_generation,p_csrf,n,n,p_deadline,p_deadline,p_profile,p_version,p_config,p_config,1) RETURNING * INTO b;
          INSERT INTO public.mixer_browser_session_vault(browser_id,epoch,session_revision,vault_generation,ciphertext_version,envelope_kind,key_id,iv,tag,ciphertext)
          VALUES(b.id,b.epoch,b.revision,1,1,'preauth',p_cipher.key_id,p_cipher.iv,p_cipher.tag,p_cipher.ciphertext);
          -- A unique insertion may wait for a concurrent transaction to abort.
          n:=pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint;
          IF n>=p_deadline THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          PERFORM public.mixer_browser_audit(NULL::public.mixer_browser_sessions,b,'bootstrap','created',NULL,p_request,NULL::public.mixer_browser_verified);
          RETURN public.mixer_browser_snapshot(b.id,NULL);
        END;
        """
      ),
      function("mixer_browser_load", "p_cookie bytea,p_config bytea", "jsonb", """
      DECLARE b public.mixer_browser_sessions; s bytea; n bigint;
      BEGIN
        SELECT * INTO b FROM public.mixer_browser_sessions WHERE cookie_digest=p_cookie FOR SHARE;
        n:=pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint;
        IF NOT FOUND OR b.status NOT IN('preauth','active') OR b.config_digest IS DISTINCT FROM p_config OR n>=b.absolute_expires_at OR n>=b.idle_expires_at THEN
          RETURN NULL; END IF;
        SELECT state_digest INTO s FROM public.mixer_browser_oidc_attempts WHERE browser_id=b.id AND browser_epoch=b.epoch AND status='pending' LIMIT 1;
        RETURN public.mixer_browser_snapshot(b.id,s);
      END;
      """)
    ]
  end

  defp attempts do
    [
      function(
        "mixer_browser_begin",
        "p_cookie bytea,p_csrf bytea,p_config bytea,p_revision bigint,a public.mixer_browser_attempt,p_cipher public.mixer_browser_cipher,p_request text",
        "jsonb",
        """
        DECLARE o public.mixer_browser_sessions; b public.mixer_browser_sessions; v public.mixer_browser_session_vault; n bigint;
        BEGIN
          SELECT * INTO o FROM public.mixer_browser_sessions WHERE cookie_digest=p_cookie FOR UPDATE;
          IF NOT FOUND THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          PERFORM 1 FROM public.mixer_browser_oidc_attempts WHERE browser_id=o.id AND status IN('pending','claimed') ORDER BY state_digest FOR UPDATE;
          SELECT * INTO STRICT v FROM public.mixer_browser_session_vault WHERE browser_id=o.id FOR UPDATE;
          n:=pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint;
          IF o.status NOT IN('preauth','active') OR o.csrf_digest IS DISTINCT FROM p_csrf OR o.config_digest IS DISTINCT FROM p_config OR o.revision IS DISTINCT FROM p_revision
            OR n>=o.absolute_expires_at OR n>=o.idle_expires_at OR a.profile_id IS DISTINCT FROM o.expected_profile_id OR a.profile_version IS DISTINCT FROM o.expected_profile_version
            OR a.expires_at IS NULL OR a.expires_at<=n OR a.expires_at>LEAST(n+300,o.absolute_expires_at,o.idle_expires_at)
            OR NOT public.mixer_browser_cipher_valid(a.cipher) OR NOT public.mixer_browser_cipher_valid(p_cipher)
          THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          UPDATE public.mixer_browser_oidc_attempts SET status='superseded',completion_reason='superseded',key_id=NULL,iv=NULL,tag=NULL,ciphertext=NULL
            WHERE browser_id=o.id AND status IN('pending','claimed');
          UPDATE public.mixer_browser_sessions SET epoch=epoch+1,revision=revision+1,audit_sequence=audit_sequence+1 WHERE id=o.id RETURNING * INTO b;
          UPDATE public.mixer_browser_session_vault SET epoch=b.epoch,session_revision=b.revision,vault_generation=vault_generation+1,
            key_id=p_cipher.key_id,iv=p_cipher.iv,tag=p_cipher.tag,ciphertext=p_cipher.ciphertext WHERE browser_id=b.id;
          INSERT INTO public.mixer_browser_oidc_attempts(state_digest,browser_id,browser_epoch,browser_revision,cookie_digest,generation,config_digest,profile_id,profile_version,
            issuer,client_id,redirect_uri,return_route,nonce_digest,created_at,expires_at,status,key_id,iv,tag,ciphertext)
          VALUES(a.state_digest,b.id,b.epoch,b.revision,b.cookie_digest,b.generation,b.config_digest,a.profile_id,a.profile_version,a.issuer,a.client_id,a.redirect_uri,'workspace',a.nonce_digest,n,a.expires_at,'pending',(a.cipher).key_id,(a.cipher).iv,(a.cipher).tag,(a.cipher).ciphertext);
          -- A colliding state insertion can wait even after all explicit locks.
          n:=pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint;
          IF n>=a.expires_at OR n>=o.absolute_expires_at OR n>=o.idle_expires_at THEN
            RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          PERFORM public.mixer_browser_audit(o,b,'begin','pending',a.state_digest,p_request,NULL::public.mixer_browser_verified);
          RETURN public.mixer_browser_snapshot(b.id,a.state_digest);
        END;
        """
      ),
      function(
        "mixer_browser_claim",
        "p_cookie bytea,p_state bytea,p_config bytea,p_revision bigint,p_claim bytea,p_deadline bigint,p_request text",
        "jsonb",
        """
        DECLARE o public.mixer_browser_sessions; b public.mixer_browser_sessions; a public.mixer_browser_oidc_attempts; n bigint; changed integer;
        BEGIN
          SELECT * INTO o FROM public.mixer_browser_sessions WHERE cookie_digest=p_cookie FOR UPDATE;
          IF NOT FOUND THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          SELECT * INTO a FROM public.mixer_browser_oidc_attempts WHERE browser_id=o.id AND state_digest=p_state FOR UPDATE;
          n:=pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint;
          IF NOT FOUND OR o.status NOT IN('preauth','active') OR o.config_digest IS DISTINCT FROM p_config OR o.revision IS DISTINCT FROM p_revision
            OR a.status<>'pending' OR a.browser_epoch<>o.epoch OR a.browser_revision<>o.revision OR a.config_digest<>o.config_digest
            OR a.cookie_digest<>o.cookie_digest OR a.generation<>o.generation OR n>=a.expires_at OR n>=o.absolute_expires_at OR n>=o.idle_expires_at
            OR p_claim IS NULL OR octet_length(p_claim)<>32 OR p_deadline IS NULL OR p_deadline<=n OR p_deadline>LEAST(a.expires_at,n+60)
          THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          UPDATE public.mixer_browser_oidc_attempts SET status='claimed',claim_digest=p_claim,claimed_at=n,claim_expires_at=p_deadline,key_id=NULL,iv=NULL,tag=NULL,ciphertext=NULL
            WHERE state_digest=p_state AND status='pending' AND browser_epoch=o.epoch;
          GET DIAGNOSTICS changed=ROW_COUNT;
          IF changed<>1 THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          UPDATE public.mixer_browser_sessions SET audit_sequence=audit_sequence+1 WHERE id=o.id RETURNING * INTO b;
          PERFORM public.mixer_browser_audit(o,b,'claim','claimed',p_state,p_request,NULL::public.mixer_browser_verified);
          RETURN public.mixer_browser_snapshot(b.id,p_state);
        END;
        """
      ),
      function(
        "mixer_browser_provider_reject",
        "p_cookie bytea,p_state bytea,p_config bytea,p_revision bigint,p_request text",
        "jsonb",
        """
        DECLARE o public.mixer_browser_sessions; b public.mixer_browser_sessions; a public.mixer_browser_oidc_attempts; n bigint; changed integer;
        BEGIN
          SELECT * INTO o FROM public.mixer_browser_sessions WHERE cookie_digest=p_cookie FOR UPDATE;
          IF NOT FOUND THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          SELECT * INTO a FROM public.mixer_browser_oidc_attempts WHERE browser_id=o.id AND state_digest=p_state FOR UPDATE;
          n:=pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint;
          IF NOT FOUND OR o.status NOT IN('preauth','active') OR o.config_digest IS DISTINCT FROM p_config OR o.revision IS DISTINCT FROM p_revision
            OR a.status<>'pending' OR a.browser_epoch<>o.epoch OR a.browser_revision<>o.revision OR a.config_digest<>o.config_digest
            OR a.cookie_digest<>o.cookie_digest OR a.generation<>o.generation OR n>=a.expires_at OR n>=o.absolute_expires_at OR n>=o.idle_expires_at
          THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          UPDATE public.mixer_browser_oidc_attempts SET status='provider_rejected',completion_reason='provider_rejected',key_id=NULL,iv=NULL,tag=NULL,ciphertext=NULL
            WHERE state_digest=p_state AND status='pending' AND browser_epoch=o.epoch;
          GET DIAGNOSTICS changed=ROW_COUNT;
          IF changed<>1 THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          UPDATE public.mixer_browser_sessions SET audit_sequence=audit_sequence+1 WHERE id=o.id RETURNING * INTO b;
          PERFORM public.mixer_browser_audit(o,b,'provider_reject','provider_rejected',p_state,p_request,NULL::public.mixer_browser_verified);
          RETURN public.mixer_browser_snapshot(b.id,p_state);
        END;
        """
      ),
      function(
        "mixer_browser_fail_claim",
        "p_cookie bytea,p_state bytea,p_config bytea,p_claim bytea,p_reason text,p_request text",
        "boolean",
        """
        DECLARE o public.mixer_browser_sessions; b public.mixer_browser_sessions; a public.mixer_browser_oidc_attempts; n bigint;
        BEGIN
          SELECT * INTO o FROM public.mixer_browser_sessions WHERE cookie_digest=p_cookie FOR UPDATE;
          IF NOT FOUND THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          SELECT * INTO a FROM public.mixer_browser_oidc_attempts WHERE browser_id=o.id AND state_digest=p_state FOR UPDATE;
          n:=pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint;
          IF NOT FOUND OR o.status NOT IN('preauth','active') OR o.config_digest IS DISTINCT FROM p_config OR a.config_digest<>o.config_digest
            OR a.status<>'claimed' OR a.browser_epoch<>o.epoch OR a.browser_revision<>o.revision OR a.claim_digest IS DISTINCT FROM p_claim
            OR p_reason IS NULL OR p_reason NOT IN('exchange_failed','oidc_failed','identity_failed','session_failed') OR n>=a.expires_at OR n>=a.claim_expires_at OR n>=o.absolute_expires_at OR n>=o.idle_expires_at
          THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          UPDATE public.mixer_browser_oidc_attempts SET status='failed',completion_reason=p_reason,key_id=NULL,iv=NULL,tag=NULL,ciphertext=NULL WHERE state_digest=p_state;
          UPDATE public.mixer_browser_sessions SET audit_sequence=audit_sequence+1 WHERE id=o.id RETURNING * INTO b;
          PERFORM public.mixer_browser_audit(o,b,'fail_claim','failed',p_state,p_request,NULL::public.mixer_browser_verified);
          RETURN true;
        END;
        """
      )
    ]
  end

  defp activation do
    [
      function(
        "mixer_browser_activate",
        "p_cookie bytea,p_state bytea,p_config bytea,p_claim bytea,p_revision bigint,i public.mixer_browser_verified,p_new_cookie bytea,p_new_csrf bytea,p_generation text,p_family text,p_deadline bigint,p_cipher public.mixer_browser_cipher,p_request text",
        "jsonb",
        """
        DECLARE d public.mixer_browser_sessions; o public.mixer_browser_sessions; b public.mixer_browser_sessions;
          a public.mixer_browser_oidc_attempts; v public.mixer_browser_session_vault; p public.mixer_authz_profiles;
          binding public.mixer_authz_bindings; principal public.mixer_authz_principals; old_family public.mixer_authz_families; n bigint; cnt integer;
        BEGIN
          SELECT * INTO d FROM public.mixer_browser_sessions WHERE cookie_digest=p_cookie;
          IF NOT FOUND OR i.profile_id IS NULL OR i.profile_version IS NULL OR i.subject IS NULL THEN
            RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          PERFORM 1 FROM public.mixer_authz_profiles WHERE (id,version) IN((i.profile_id,i.profile_version),(d.profile_id,d.profile_version))
            ORDER BY id COLLATE "C",version FOR UPDATE;
          SELECT * INTO p FROM public.mixer_authz_profiles WHERE id=i.profile_id AND version=i.profile_version;
          IF NOT FOUND THEN RAISE EXCEPTION 'browser identity unavailable' USING ERRCODE='P0001'; END IF;
          SELECT * INTO binding FROM public.mixer_authz_bindings WHERE profile_id=i.profile_id AND profile_version=i.profile_version AND subject=i.subject;
          IF NOT FOUND THEN RAISE EXCEPTION 'browser onboarding required' USING ERRCODE='P0001'; END IF;
          PERFORM 1 FROM public.mixer_authz_principals WHERE id IN(binding.principal_id,d.principal_id) ORDER BY id COLLATE "C" FOR UPDATE;
          SELECT * INTO STRICT principal FROM public.mixer_authz_principals WHERE id=binding.principal_id;
          IF d.family_id IS NOT NULL THEN
            SELECT * INTO STRICT old_family FROM public.mixer_authz_families WHERE id=d.family_id FOR UPDATE;
            PERFORM 1 FROM public.mixer_authz_credentials WHERE family_id=d.family_id ORDER BY profile_id COLLATE "C",profile_version,reference COLLATE "C" LIMIT 2 FOR UPDATE;
            SELECT count(*) INTO cnt FROM (SELECT 1 FROM public.mixer_authz_credentials WHERE family_id=d.family_id LIMIT 2) bounded;
            IF cnt<>1 OR old_family.profile_id<>d.profile_id OR old_family.profile_version<>d.profile_version OR old_family.principal_id<>d.principal_id
              OR NOT EXISTS(SELECT 1 FROM public.mixer_authz_credentials WHERE profile_id=d.profile_id AND profile_version=d.profile_version AND reference=d.credential_ref AND principal_id=d.principal_id AND family_id=d.family_id AND revision=d.credential_revision)
            THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          END IF;
          SELECT * INTO STRICT o FROM public.mixer_browser_sessions WHERE id=d.id FOR UPDATE;
          SELECT * INTO a FROM public.mixer_browser_oidc_attempts WHERE browser_id=o.id AND state_digest=p_state FOR UPDATE;
          IF NOT FOUND THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          SELECT * INTO STRICT v FROM public.mixer_browser_session_vault WHERE browser_id=o.id FOR UPDATE;
          n:=pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint;
          IF o IS DISTINCT FROM d OR o.status NOT IN('preauth','active') OR o.revision IS DISTINCT FROM p_revision OR o.config_digest IS DISTINCT FROM p_config
            OR a.status<>'claimed' OR a.browser_epoch<>o.epoch OR a.browser_revision<>o.revision OR a.config_digest<>o.config_digest OR a.cookie_digest<>o.cookie_digest OR a.generation<>o.generation
            OR a.claim_digest IS DISTINCT FROM p_claim OR n>=a.expires_at OR n>=a.claim_expires_at OR n>=o.absolute_expires_at OR n>=o.idle_expires_at
            OR i.profile_id IS DISTINCT FROM a.profile_id OR i.profile_version IS DISTINCT FROM a.profile_version OR i.issuer IS DISTINCT FROM a.issuer OR i.client_id IS DISTINCT FROM a.client_id
            OR p.id IS DISTINCT FROM o.expected_profile_id OR p.version IS DISTINCT FROM o.expected_profile_version
            OR NOT p.active OR p.identity_class<>'human' OR p.issuer IS DISTINCT FROM i.issuer OR p.client_id IS DISTINCT FROM i.client_id OR p.state_revision IS DISTINCT FROM i.profile_revision
            OR NOT binding.active OR binding.identity_class<>'human' OR binding.revision IS DISTINCT FROM i.binding_revision
            OR NOT principal.active OR principal.identity_class<>'human' OR principal.revision IS DISTINCT FROM i.principal_revision OR principal.not_before>n
            OR i.issued_at IS NULL OR i.issued_at<principal.not_before OR i.issued_at>n+30 OR i.issued_at<0 OR i.expires_at IS NULL OR i.expires_at<=GREATEST(n,i.issued_at) OR i.expires_at>9007199254740991
            OR i.scopes IS NULL OR ('mixer.workspace.read'=ANY(i.scopes)) IS NOT TRUE OR cardinality(i.scopes)>64
            OR i.credential_ref IS NULL OR octet_length(i.credential_ref) NOT BETWEEN 1 AND 256
            OR p_deadline IS NULL OR p_deadline<=n OR p_deadline>LEAST(i.expires_at,n+900)
            OR p_family IS NULL OR p_family !~ '^browser_[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$'
            OR p_new_cookie IS NULL OR octet_length(p_new_cookie)<>32 OR p_new_cookie=o.cookie_digest
            OR p_new_csrf IS NULL OR octet_length(p_new_csrf)<>32 OR p_new_csrf=o.csrf_digest
            OR p_generation IS NULL OR p_generation=o.generation OR NOT public.mixer_browser_cipher_valid(p_cipher)
            OR (d.family_id IS NOT NULL AND (NOT old_family.active OR old_family.not_before>n OR (old_family.expires_at IS NOT NULL AND old_family.expires_at<=n)))
          THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          -- Unique INSERTs preserve every credential and family tombstone forever.
          INSERT INTO public.mixer_authz_families(id,profile_id,profile_version,principal_id,active,not_before,expires_at,revision)
            VALUES(p_family,i.profile_id,i.profile_version,principal.id,true,LEAST(i.issued_at,n),i.expires_at,1);
          INSERT INTO public.mixer_authz_credentials(profile_id,profile_version,reference,principal_id,family_id,active,not_before,expires_at,revision)
            VALUES(i.profile_id,i.profile_version,i.credential_ref,principal.id,p_family,true,LEAST(i.issued_at,n),i.expires_at,1);
          -- A uniqueness insertion can wait; repeat all temporal decisions afterwards.
          n:=pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint;
          IF n>=a.expires_at OR n>=a.claim_expires_at OR n>=o.absolute_expires_at OR n>=o.idle_expires_at OR n>=i.expires_at OR n>=p_deadline THEN
            RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          PERFORM public.mixer_browser_revoke_existing(o,n);
          UPDATE public.mixer_browser_sessions SET cookie_digest=p_new_cookie,csrf_digest=p_new_csrf,generation=p_generation,status='active',epoch=epoch+1,revision=revision+1,
            last_seen_at=n,absolute_expires_at=p_deadline,idle_expires_at=p_deadline,profile_id=i.profile_id,profile_version=i.profile_version,principal_id=principal.id,
            family_id=p_family,credential_ref=i.credential_ref,credential_revision=1,audit_sequence=audit_sequence+1 WHERE id=o.id RETURNING * INTO b;
          -- Cookie rotation also claims a unique index entry and can wait.
          n:=pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint;
          IF n>=a.expires_at OR n>=a.claim_expires_at OR n>=o.absolute_expires_at OR n>=o.idle_expires_at OR n>=i.expires_at OR n>=p_deadline
            OR (d.family_id IS NOT NULL AND old_family.expires_at IS NOT NULL AND old_family.expires_at<=n) THEN
            RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          UPDATE public.mixer_browser_session_vault SET epoch=b.epoch,session_revision=b.revision,vault_generation=vault_generation+1,envelope_kind='active',
            key_id=p_cipher.key_id,iv=p_cipher.iv,tag=p_cipher.tag,ciphertext=p_cipher.ciphertext WHERE browser_id=b.id;
          UPDATE public.mixer_browser_oidc_attempts SET status='completed',completion_reason='completed',key_id=NULL,iv=NULL,tag=NULL,ciphertext=NULL WHERE state_digest=p_state;
          PERFORM public.mixer_browser_audit(o,b,CASE WHEN o.family_id IS NULL THEN 'activate' ELSE 'replace' END,'active',p_state,p_request,i);
          RETURN public.mixer_browser_snapshot(b.id,p_state);
        END;
        """
      )
    ]
  end

  defp termination do
    [
      function(
        "mixer_browser_logout",
        "p_cookie bytea,p_csrf bytea,p_config bytea,p_revision bigint,p_request text",
        "boolean",
        """
        DECLARE d public.mixer_browser_sessions; o public.mixer_browser_sessions; b public.mixer_browser_sessions; n bigint;
        BEGIN
          SELECT * INTO d FROM public.mixer_browser_sessions WHERE cookie_digest=p_cookie;
          IF NOT FOUND THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          IF d.status='revoked' AND d.csrf_digest IS NOT DISTINCT FROM p_csrf AND d.config_digest IS NOT DISTINCT FROM p_config THEN RETURN true; END IF;
          PERFORM public.mixer_browser_lock_existing(d);
          SELECT * INTO STRICT o FROM public.mixer_browser_sessions WHERE id=d.id FOR UPDATE;
          PERFORM 1 FROM public.mixer_browser_oidc_attempts WHERE browser_id=o.id AND status IN('pending','claimed') ORDER BY state_digest FOR UPDATE;
          PERFORM 1 FROM public.mixer_browser_session_vault WHERE browser_id=o.id FOR UPDATE;
          n:=pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint;
          IF o IS DISTINCT FROM d OR o.status NOT IN('preauth','active') OR o.revision IS DISTINCT FROM p_revision OR o.csrf_digest IS DISTINCT FROM p_csrf OR o.config_digest IS DISTINCT FROM p_config THEN
            RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          PERFORM public.mixer_browser_revoke_existing(o,n);
          UPDATE public.mixer_browser_sessions SET status='revoked',epoch=epoch+1,revision=revision+1,audit_sequence=audit_sequence+1 WHERE id=o.id RETURNING * INTO b;
          UPDATE public.mixer_browser_oidc_attempts SET status='superseded',completion_reason='logout',key_id=NULL,iv=NULL,tag=NULL,ciphertext=NULL WHERE browser_id=o.id AND status IN('pending','claimed');
          UPDATE public.mixer_browser_session_vault SET epoch=b.epoch,session_revision=b.revision,vault_generation=vault_generation+1,envelope_kind='erased',key_id=NULL,iv=NULL,tag=NULL,ciphertext=NULL WHERE browser_id=o.id;
          PERFORM public.mixer_browser_audit(o,b,'logout','revoked',NULL,p_request,NULL::public.mixer_browser_verified);
          RETURN true;
        END;
        """
      ),
      function(
        "mixer_browser_expire",
        "p_browser bytea,p_revision bigint,p_request text",
        "boolean",
        """
        DECLARE d public.mixer_browser_sessions; o public.mixer_browser_sessions; b public.mixer_browser_sessions; n bigint;
        BEGIN
          SELECT * INTO d FROM public.mixer_browser_sessions WHERE id=p_browser;
          IF NOT FOUND THEN RETURN false; END IF;
          IF d.status IN('revoked','expired') THEN RETURN false; END IF;
          PERFORM public.mixer_browser_lock_existing(d);
          SELECT * INTO STRICT o FROM public.mixer_browser_sessions WHERE id=d.id FOR UPDATE;
          PERFORM 1 FROM public.mixer_browser_oidc_attempts WHERE browser_id=o.id AND status IN('pending','claimed') ORDER BY state_digest FOR UPDATE;
          PERFORM 1 FROM public.mixer_browser_session_vault WHERE browser_id=o.id FOR UPDATE;
          n:=pg_catalog.floor(extract(epoch FROM pg_catalog.clock_timestamp()))::bigint;
          IF o IS DISTINCT FROM d OR o.revision IS DISTINCT FROM p_revision OR o.status NOT IN('preauth','active') THEN RAISE EXCEPTION 'browser session unavailable' USING ERRCODE='P0001'; END IF;
          IF n<o.absolute_expires_at AND n<o.idle_expires_at THEN RETURN false; END IF;
          PERFORM public.mixer_browser_revoke_existing(o,n);
          UPDATE public.mixer_browser_sessions SET status='expired',epoch=epoch+1,revision=revision+1,audit_sequence=audit_sequence+1 WHERE id=o.id RETURNING * INTO b;
          UPDATE public.mixer_browser_oidc_attempts SET status='superseded',completion_reason='expired',key_id=NULL,iv=NULL,tag=NULL,ciphertext=NULL WHERE browser_id=o.id AND status IN('pending','claimed');
          UPDATE public.mixer_browser_session_vault SET epoch=b.epoch,session_revision=b.revision,vault_generation=vault_generation+1,envelope_kind='erased',key_id=NULL,iv=NULL,tag=NULL,ciphertext=NULL WHERE browser_id=o.id;
          PERFORM public.mixer_browser_audit(o,b,'expire','expired',NULL,p_request,NULL::public.mixer_browser_verified);
          RETURN true;
        END;
        """
      )
    ]
  end
end

