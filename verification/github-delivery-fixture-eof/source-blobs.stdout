defmodule MixerHosted.Identity.StartupLifecycleTest do
  use ExUnit.Case, async: false

  alias MixerHosted.Identity.{
    ConfiguredVerifier,
    KeyOwner,
    KeyOwnerSupervisor,
    StartupConfig,
    StartupFixture
  }

  setup_all do
    StartupFixture.prepare_database()
    :ok
  end

  setup do
    prior = Application.get_all_env(:mixer_hosted)

    on_exit(fn ->
      Application.stop(:mixer_hosted)

      for {key, _} <- Application.get_all_env(:mixer_hosted),
          do: Application.delete_env(:mixer_hosted, key)

      for {key, value} <- prior, do: Application.put_env(:mixer_hosted, key, value)
    end)

    :ok
  end

  defp start(identity) do
    StartupFixture.app_settings(identity)
    assert {:ok, _} = Application.ensure_all_started(:mixer_hosted)
  end

  defp liveness do
    {:ok, {_, port}} = MixerHostedWeb.Endpoint.server_info(:http)
    url = ~c"http://127.0.0.1:" ++ Integer.to_charlist(port) ++ ~c"/health/live"
    assert {:ok, {{_, 200, _}, _, body}} = :httpc.request(:get, {url, []}, [timeout: 2_000], [])
    assert Jason.decode!(body) == %{"status" => "alive"}
  end

  defp eventually(fun, tries \\ 100)
  defp eventually(fun, 0), do: assert(fun.())

  defp eventually(fun, tries) do
    if fun.(),
      do: :ok,
      else:
        (
          Process.sleep(10)
          eventually(fun, tries - 1)
        )
  end

  test "IS01 actual disabled startup has endpoint and no identity owner" do
    start(StartupConfig.load!(%{}, :api, []))
    assert Process.whereis(KeyOwner) == nil

    assert {:error, :identity_unavailable} =
             ConfiguredVerifier.authenticate("synthetic", System.system_time(:second))

    liveness()
  end

  test "IS01 actual disabled processor starts no endpoint or identity owner" do
    disabled = StartupConfig.load!(%{}, :processor, [])

    settings =
      MixerHosted.RuntimeConfig.load!(
        Map.put(StartupFixture.foundation_env(), "MIXER_HOSTED_ROLE", "processor")
      )

    StartupFixture.app_settings(disabled)
    Application.put_env(:mixer_hosted, :role, :processor)
    Application.put_env(:mixer_hosted, Oban, settings.oban)
    assert {:ok, _} = Application.ensure_all_started(:mixer_hosted)
    assert Process.whereis(KeyOwner) == nil
    assert Process.whereis(MixerHostedWeb.Endpoint) == nil

    assert Enum.map(Oban.config().queues, fn {name, options} -> {name, options[:limit]} end) ==
             settings.oban[:queues]
  end

  test "IS03 actual configured application owns an empty bounded component before endpoint" do
    settings =
      StartupFixture.configuration(StartupFixture.envelope(), StartupFixture.standard_roots())

    [MixerHosted.Repo, {Oban, _}, {KeyOwnerSupervisor, _}, MixerHostedWeb.Endpoint] =
      MixerHosted.Application.children(:api, [], settings)

    start(settings)
    owner = Process.whereis(KeyOwner)
    assert is_pid(owner)
    root_children = Supervisor.which_children(MixerHosted.Supervisor)

    assert {KeyOwnerSupervisor, component, :supervisor, _} =
             List.keyfind(root_children, KeyOwnerSupervisor, 0)

    assert Enum.any?(Supervisor.which_children(component), fn {_, pid, _, _} -> pid == owner end)
    state = :sys.get_state(owner)

    for key <- [:snapshots, :attempts, :flights, :waiters, :admitted, :negatives],
        do: assert(state[key] == %{})

    assert DynamicSupervisor.count_children(state.workers).active == 0
    liveness()

    StartupFixture.evidence("startup-empty-state.json", %{
      actualApplication: true,
      endpointLiveness: 200,
      ownerRegistered: true,
      initialSnapshots: 0,
      initialAttempts: 0,
      initialFlights: 0,
      startupFetches: 0
    })
  end

  test "IS03 missing validated binding and invalid required owner prevent endpoint startup" do
    StartupFixture.app_settings(StartupConfig.load!(%{}, :api, []))
    Application.delete_env(:mixer_hosted, :identity_startup)
    assert {:error, _} = Application.ensure_all_started(:mixer_hosted)
    assert Process.whereis(MixerHostedWeb.Endpoint) == nil
    assert Process.whereis(KeyOwner) == nil

    valid =
      StartupFixture.configuration(StartupFixture.envelope(), StartupFixture.standard_roots())

    # Existing production constructor must reject test-only transport options.
    bad = %{
      valid
      | owner_options: valid.owner_options ++ [fixture: %{ip: {127, 0, 0, 1}, port: 1}]
    }

    StartupFixture.app_settings(bad)
    assert {:error, _} = Application.ensure_all_started(:mixer_hosted)
    assert Process.whereis(MixerHostedWeb.Endpoint) == nil
    assert Process.whereis(KeyOwner) == nil
  end

  test "IS04 disabled bound profile rejects via public adapter without any flight" do
    object =
      put_in(StartupFixture.envelope(), ["profiles", Access.at(0), "profile", "enabled"], false)

    start(StartupFixture.configuration(object, StartupFixture.standard_roots()))

    assert {:error, :unauthenticated} =
             ConfiguredVerifier.authenticate("synthetic", System.system_time(:second))

    state = :sys.get_state(KeyOwner)
    assert state.attempts == %{}
    assert state.flights == %{}
    liveness()
  end

  test "IS05 actual owner supervision restarts empty and application shutdown removes authority" do
    settings =
      StartupFixture.configuration(StartupFixture.envelope(), StartupFixture.standard_roots())

    start(settings)
    owner = Process.whereis(KeyOwner)
    old_state = :sys.get_state(owner)
    old_workers = Process.whereis(old_state.workers)
    Process.exit(owner, :kill)
    eventually(fn -> is_pid(Process.whereis(KeyOwner)) and Process.whereis(KeyOwner) != owner end)
    state = :sys.get_state(KeyOwner)
    refute state.epoch == old_state.epoch
    assert state.snapshots == %{}
    assert Process.whereis(state.workers) != old_workers
    liveness()
    assert :ok = Application.stop(:mixer_hosted)
    assert Process.whereis(KeyOwner) == nil
    assert Process.whereis(state.workers) == nil
    assert Process.whereis(MixerHostedWeb.Endpoint) == nil

    assert {:error, :identity_unavailable} =
             ConfiguredVerifier.authenticate("synthetic", System.system_time(:second))

    start(settings)
    refute :sys.get_state(KeyOwner).epoch == state.epoch
    assert :sys.get_state(KeyOwner).snapshots == %{}

    StartupFixture.evidence("startup-lifecycle.json", %{
      actualApplication: true,
      ownerCrashRestart: true,
      workerSupervisorReplaced: true,
      newEpoch: true,
      shutdownAuthorityRemoved: true,
      restartEmpty: true
    })
  end
end

f2a157969b90757dc64f6bf3d9b2e62c43f81117 blob 4995
defmodule MixerHosted.Identity.StartupLinuxNetworkTest do
  use ExUnit.Case, async: false

  @moduletag skip:
               not (:os.type() == {:unix, :linux} and
                      System.get_env("MIXER_ISOLATED_NETNS") == "1")
  alias MixerHosted.Identity.{
    Admission,
    ConfiguredVerifier,
    KeyOwner,
    StartupDNSFixture,
    StartupFixture,
    TLSFixture
  }

  defp eventually(fun, tries \\ 250)
  defp eventually(fun, 0), do: assert(fun.())

  defp eventually(fun, tries) do
    if fun.(),
      do: :ok,
      else:
        (
          Process.sleep(10)
          eventually(fun, tries - 1)
        )
  end

  test "IS04 IS05 actual configured startup cold production DNS TLS admission and lifecycle" do
    prior = Application.get_all_env(:mixer_hosted)

    on_exit(fn ->
      Application.stop(:mixer_hosted)

      for {key, _} <- Application.get_all_env(:mixer_hosted),
          do: Application.delete_env(:mixer_hosted, key)

      for {key, value} <- prior, do: Application.put_env(:mixer_hosted, key, value)
    end)

    StartupFixture.prepare_database()
    server = start_supervised!({TLSFixture, ip: {8, 8, 8, 8}, port: 443})
    dns = start_supervised!(StartupDNSFixture)
    authority = GenServer.call(server, :authority)
    key = JOSE.JWK.generate_key({:rsa, 2048})

    public =
      key
      |> JOSE.JWK.to_public()
      |> JOSE.JWK.to_map()
      |> elem(1)
      |> Map.merge(%{"kid" => "startup-key", "alg" => "RS256", "use" => "sig"})

    TLSFixture.configure(server, {:body, Jason.encode!(%{"keys" => [public]})})
    settings = StartupFixture.configuration(StartupFixture.envelope(), [authority.ca])
    assert settings.owner_options[:resolvers] == [{{127, 0, 0, 1}, 53}]
    StartupFixture.app_settings(settings)
    assert {:ok, _} = Application.ensure_all_started(:mixer_hosted)
    assert :sys.get_state(KeyOwner).snapshots == %{}
    assert GenServer.call(dns, :queries) == []
    assert TLSFixture.info(server).accepted == 0
    {:ok, {_, port}} = MixerHostedWeb.Endpoint.server_info(:http)
    url = ~c"http://127.0.0.1:" ++ Integer.to_charlist(port) ++ ~c"/health/live"
    assert {:ok, {{_, 200, _}, _, _}} = :httpc.request(:get, {url, []}, [timeout: 2_000], [])
    token = StartupFixture.token(key)
    now = System.system_time(:second)
    assert {:ok, identity} = ConfiguredVerifier.authenticate(token, now)
    assert identity.subject == "synthetic-startup-subject"
    assert identity.identity_class == :human
    assert length(GenServer.call(dns, :queries)) == 2
    assert TLSFixture.info(server).accepted == 1
    assert map_size(:sys.get_state(KeyOwner).snapshots) == 1
    eventually(fn -> TLSFixture.info(server).closed == 1 end)
    {:ok, permit} = Admission.acquire(KeyOwner, :configured)
    {:ok, lease} = KeyOwner.checkout(KeyOwner, permit, System.system_time(:second))
    old_epoch = :sys.get_state(KeyOwner).epoch
    assert :ok = Application.stop(:mixer_hosted)
    assert Process.whereis(KeyOwner) == nil
    assert {:error, :identity_unavailable} = ConfiguredVerifier.authenticate(token, now)
    assert {:ok, _} = Application.ensure_all_started(:mixer_hosted)
    assert :sys.get_state(KeyOwner).snapshots == %{}
    refute :sys.get_state(KeyOwner).epoch == old_epoch
    assert {:error, :identity_unavailable} = KeyOwner.finish(KeyOwner, lease)
    Admission.release(permit)
    assert {:ok, _} = ConfiguredVerifier.authenticate(token, System.system_time(:second))
    eventually(fn -> TLSFixture.info(server).closed == 2 end)
    assert :ok = Application.stop(:mixer_hosted)
    assert {:ok, _} = Application.ensure_all_started(:mixer_hosted)
    TLSFixture.configure(server, :stall)

    task =
      Task.async(fn -> ConfiguredVerifier.authenticate(token, System.system_time(:second)) end)

    eventually(fn -> TLSFixture.info(server).accepted == 3 end)
    assert :ok = Application.stop(:mixer_hosted)
    assert {:error, :identity_unavailable} = Task.await(task, 3_000)
    eventually(fn -> TLSFixture.info(server).closed == 3 end)
    assert TLSFixture.info(server).sockets == %{}
    assert Process.whereis(KeyOwner) == nil
    assert Process.whereis(Module.concat(KeyOwner, FetchSupervisor)) == nil
    assert Process.whereis(MixerHostedWeb.Endpoint) == nil

    StartupFixture.evidence("startup-production-network.json", %{
      actualApplication: true,
      endpointLiveness: 200,
      namespace: "owned Linux network-none NET_ADMIN; 8.8.8.8 on lo:1",
      resolver: "127.0.0.1:53",
      destination: "8.8.8.8:443",
      startupDNSQueries: 0,
      startupConnections: 0,
      coldTokenAdmitted: true,
      coldDNSQueries: 2,
      coldConnections: 1,
      oldLeaseRejectedAfterRestart: true,
      restartColdAdmission: true,
      shutdownInflightCancelled: true,
      allThreeConnectionsClosed: true,
      fixtureKeyDirectoryRemoved: TLSFixture.info(server).key_dir_removed,
      publicAdapter: "ConfiguredVerifier.authenticate/2",
      productionPolicyBypasses: 0
    })
  end
end

0481ec55ca162baf30af4e411a2248f53080e625 blob 16835
defmodule MixerHosted.Protocol.ArtifactAdmissionTest do
  use ExUnit.Case, async: false
  alias MixerHosted.Protocol.{ArtifactAdmission, ArtifactCBOR, ArtifactJSON, ArtifactV3Policy}
  @fixtures Path.expand("../../../../services/protocol/testdata", __DIR__)
  @fixture Path.join(@fixtures, "signed-release-v3.json")
  @corpus Path.join(@fixtures, "release-v3-cases.json")
  @domain "mixer.artifact.v3\0"

  defp fixture do
    f = @fixture |> File.read!() |> Jason.decode!()

    Map.update!(f, "roots", fn roots ->
      Enum.map(roots, &Map.update!(&1, "public_key", fn b -> Base.decode64!(b) end))
    end)
  end

  defp signed_bytes do
    bytes = File.read!(@fixture)
    {:ok, spans, _} = ArtifactJSON.preflight(bytes, 65_536)

    {_, _, start, size} =
      Enum.find(spans, fn {start, size, _, _} ->
        Jason.decode!(binary_part(bytes, start, size)) == "signed_manifest"
      end)

    binary_part(bytes, start, size)
  end

  defp envelope(signed, payload),
    do:
      "{\"signed_manifest\":" <>
        signed <> ",\"payload\":" <> Jason.encode!(Base.encode64(payload)) <> "}"

  defp payload(f), do: Base.decode64!(f["payload"])

  defp admit(bytes, f),
    do: ArtifactAdmission.admit(bytes, f["host"], f["roots"], f["verification_time_unix"])

  defp standalone(bytes, f),
    do:
      ArtifactAdmission.admit_signed(
        bytes,
        payload(f),
        f["host"],
        f["roots"],
        f["verification_time_unix"]
      )

  defp sha(b), do: Base.encode16(:crypto.hash(:sha256, b), case: :lower)

  # Ephemeral private keys remain in this test process and are never retained.
  defp ephemeral(f) do
    {public, private} = :crypto.generate_key(:eddsa, :ed25519)
    root = hd(f["roots"]) |> Map.put("public_key", public)
    {Map.put(f, "roots", [root]), private}
  end

  defp sign(manifest, private, domain \\ @domain) do
    {:ok, cbor} = ArtifactCBOR.encode(manifest)
    signature = :crypto.sign(:eddsa, :none, domain <> cbor, [private, :ed25519])
    Jason.encode!(%{"manifest" => manifest, "signature" => Base.encode64(signature)})
  end

  test "exact original fixture bytes, CBOR, preimage and digest, with a checked signed target" do
    f = fixture()
    bytes = envelope(signed_bytes(), payload(f))
    assert {:ok, checked} = admit(bytes, f)
    assert checked.envelope_bytes == bytes
    assert checked.signed_manifest_bytes == signed_bytes()
    assert Base.encode16(checked.canonical_manifest_cbor, case: :lower) == f["manifest_cbor_hex"]

    assert Base.encode16(@domain <> checked.canonical_manifest_cbor, case: :lower) ==
             f["manifest_message_hex"]

    assert checked.manifest_sha256 == f["artifact_sha256"]

    assert checked.target ==
             Map.merge(f["host"]["scope"], %{
               "runtime" => f["host"]["runtime"],
               "manifest_sha256" => f["artifact_sha256"]
             })

    assert {:ok, ^checked} =
             ArtifactAdmission.recheck(
               checked,
               f["host"],
               f["roots"],
               f["verification_time_unix"]
             )
  end

  test "154 unchanged original signed manifest cases and 39 origin plus 14 namespace cases" do
    f = fixture()
    corpus = @corpus |> File.read!() |> Jason.decode!()
    assert length(corpus["cases"]) == 154
    assert length(corpus["origin_cases"]) == 39
    assert length(corpus["namespace_cases"]) == 14
    assert length(corpus["assignment_cases"]) == 36

    Enum.each(corpus["cases"], fn c ->
      assert match?({:ok, _}, standalone(c["signed_manifest_json"], f)) == c["accepted"],
             c["name"]
    end)

    Enum.each(corpus["origin_cases"], fn c ->
      assert ArtifactV3Policy.valid_origin?(c["value"]) == c["accepted"], c["value"]
    end)

    Enum.each(corpus["namespace_cases"], fn c ->
      assert ArtifactV3Policy.valid_namespace?(c["value"]) == c["accepted"], c["value"]
    end)
  end

  test "every closed manifest, scope, limits, descriptor and entry field rejects missing, extra, case and null" do
    f = fixture()
    manifest = f["signed_manifest"]["manifest"]

    paths = [
      [],
      ["scope"],
      ["limits"],
      ["capability_grants"],
      ["capability_grants", "entries", Access.at(0)]
    ]

    Enum.each(paths, fn path ->
      value = if path == [], do: manifest, else: get_in(manifest, path)

      Enum.each(Map.keys(value), fn key ->
        wrong_type =
          cond do
            is_map(value[key]) -> []
            is_list(value[key]) -> %{}
            is_binary(value[key]) -> 1
            is_integer(value[key]) -> "1"
          end

        for replacement <- [
              Map.put(value, key, wrong_type),
              Map.delete(value, key),
              Map.put(value, key, nil),
              Map.put(value, String.upcase(key), value[key]),
              Map.put(value, "unknown", true)
            ] do
          changed = if path == [], do: replacement, else: put_in(manifest, path, replacement)
          refute ArtifactV3Policy.manifest?(changed), inspect({path, key})
        end
      end)
    end)

    for key <-
          ~w(schema protocol guest_abi ui_schema state_min state_max compressed_bytes expanded_bytes created_at_unix) do
      for bad <- [-1, 3.0, "1", nil, true, 18_446_744_073_709_551_616] do
        refute ArtifactV3Policy.manifest?(Map.put(manifest, key, bad)), key
      end
    end
  end

  test "ordered duplicate detection and lexical closed numeric and Unicode rejection" do
    for bytes <- [
          "{\"a\":1,\"a\":2}",
          "{\"a\":1,\"\\u0061\":2}",
          "{\"x\":{\"a\":1,\"a\":2}}",
          "{\"a\":null}",
          "{\"a\":1.0}",
          "{\"a\":1e0}",
          "{\"a\":-0}",
          "{\"a\":01}",
          "{\"a\":18446744073709551616}",
          "{\"a\":\"\\uD800\"}",
          "{\"a\":\"\\uDC00\"}",
          "{\"a\":\"\\x12\"}",
          <<?{, ?", ?a, ?", ?:, ?", 255, ?", ?}>>,
          "{}{}",
          "[1,]",
          "{\"a\":1,}"
        ] do
      assert {:error, _} = ArtifactJSON.decode(bytes, 65_536)
    end

    assert {:ok, %{"a" => 18_446_744_073_709_551_615}, _, _} =
             ArtifactJSON.decode("{\"a\":18446744073709551615}", 65_536)

    assert {:ok, %{"a" => "😀"}, _, _} = ArtifactJSON.decode("{\"a\":\"\\ud83d\\ude00\"}", 65_536)
    assert {:ok, _, _, _} = ArtifactJSON.decode("{\"a\":9007199254740993}", 65_536)
  end

  test "lexical structural boundaries count before decoder collection allocation" do
    nested = String.duplicate("[", 16) <> "0" <> String.duplicate("]", 16)
    assert {:ok, _, %{max_depth: 16}} = ArtifactJSON.preflight(nested, 65_536)
    assert {:error, _} = ArtifactJSON.preflight("[" <> nested <> "]", 65_536)
    assert {:ok, _, _} = ArtifactJSON.preflight(Jason.encode!(List.duplicate(0, 256)), 65_536)
    assert {:error, _} = ArtifactJSON.preflight(Jason.encode!(List.duplicate(0, 257)), 65_536)
    exact = List.duplicate(List.duplicate(0, 256), 15) ++ [List.duplicate(0, 239)]
    assert {:ok, _, %{items: 4096}} = ArtifactJSON.preflight(Jason.encode!(exact), 65_536)

    assert {:error, _} =
             ArtifactJSON.preflight(
               Jason.encode!(List.replace_at(exact, 15, List.duplicate(0, 240))),
               65_536
             )

    object = for n <- 1..256, into: %{}, do: {Integer.to_string(n), 0}
    assert {:ok, _, _} = ArtifactJSON.preflight(Jason.encode!(object), 65_536)
    assert {:error, _} = ArtifactJSON.preflight(Jason.encode!(Map.put(object, "257", 0)), 65_536)
  end

  test "standalone, embedded signed bytes, payload and whole-envelope exact and one-over bounds" do
    f = fixture()
    signed = signed_bytes()
    standalone_exact = String.duplicate(" ", 65_536 - byte_size(signed)) <> signed
    assert {:ok, data} = standalone(standalone_exact, f)
    assert data.signed_manifest_bytes == standalone_exact
    refute Map.has_key?(data, :envelope_bytes)
    assert {:error, _} = standalone(" " <> standalone_exact, f)

    embedded_exact =
      "{" <>
        String.duplicate(" ", 65_536 - byte_size(signed)) <>
        binary_part(signed, 1, byte_size(signed) - 1)

    assert {:ok, checked} = admit(envelope(embedded_exact, payload(f)), f)
    assert byte_size(checked.signed_manifest_bytes) == 65_536

    assert {:error, _} =
             admit(
               envelope(
                 "{ " <> binary_part(embedded_exact, 1, byte_size(embedded_exact) - 1),
                 payload(f)
               ),
               f
             )

    {f, private} = ephemeral(f)
    payload = :binary.copy(<<42>>, 4_194_304)

    m =
      f["signed_manifest"]["manifest"]
      |> Map.put("payload_sha256", sha(payload))
      |> Map.put("compressed_bytes", byte_size(payload))
      |> Map.put("expanded_bytes", byte_size(payload))

    bytes = envelope(sign(m, private), payload)
    exact = bytes <> String.duplicate(" ", 6_291_456 - byte_size(bytes))
    assert byte_size(exact) == 6_291_456
    assert {:ok, checked} = admit(exact, f)
    assert byte_size(checked.payload) == 4_194_304
    assert {:error, :envelope_limit} = admit(exact <> " ", f)
    assert {:error, _} = admit(envelope(sign(m, private), payload <> "x"), f)
    assert {:error, _} = admit(envelope(sign(m, private), ""), f)
    one = "x"

    m =
      m
      |> Map.put("payload_sha256", sha(one))
      |> Map.put("compressed_bytes", 1)
      |> Map.put("expanded_bytes", 1)

    assert {:ok, _} = admit(envelope(sign(m, private), one), f)
  end

  test "envelope and signed outer fields are closed and canonical padded base64 is checked before decode" do
    f = fixture()
    signed = signed_bytes()
    p64 = Base.encode64(payload(f))
    bytes = envelope(signed, payload(f))

    for bad <- [
          "{}",
          "[]",
          "null",
          bytes <> "{}",
          String.replace(bytes, "\"payload\":", "\"Payload\":"),
          String.replace(bytes, "\"payload\":", "\"extra\":0,\"payload\":"),
          String.replace(bytes, "\"payload\":", "\"payload\":\"eA==\",\"payload\":"),
          String.replace(bytes, "\"payload\":", "\"\\u0070ayload\":\"eA==\",\"payload\":"),
          String.replace(bytes, Jason.encode!(p64), "null"),
          String.replace(bytes, Jason.encode!(p64), "[]")
        ] do
      assert {:error, _} = admit(bad, f)
    end

    for invalid <- [
          "eA",
          "eA=",
          "eB==",
          "eA==\n",
          "eA--",
          "eA__",
          "eA===",
          "=AAA",
          "AA=A",
          "",
          "A"
        ] do
      assert {:error, _} =
               admit(
                 "{\"signed_manifest\":" <>
                   signed <> ",\"payload\":" <> Jason.encode!(invalid) <> "}",
                 f
               )
    end

    sm = f["signed_manifest"]

    for bad <- [
          Map.delete(sm, "signature"),
          Map.put(sm, "Signature", sm["signature"]),
          Map.put(sm, "extra", 1),
          Map.put(sm, "signature", nil),
          Map.put(sm, "signature", "AAAA")
        ] do
      assert {:error, _} = standalone(Jason.encode!(bad), f)
    end

    # Canonical tail-bit changes must reject even if Base.decode64 accepts them.
    text = sm["signature"]
    alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    <<last>> = binary_part(text, 85, 1)
    {index, _} = :binary.match(alphabet, <<last>>)
    invalid = binary_part(text, 0, 85) <> binary_part(alphabet, index + 1, 1) <> "=="
    assert {:error, _} = standalone(Jason.encode!(Map.put(sm, "signature", invalid)), f)
  end

  test "full host and root policies, uint64 exactness, wrong signature and current-policy recheck" do
    f = fixture()
    bytes = envelope(signed_bytes(), payload(f))
    assert {:ok, checked} = admit(bytes, f)
    root = hd(f["roots"])
    now = f["verification_time_unix"]

    root_changes = [
      {"key_id", "another"},
      {"public_key", <<0::256>>},
      {"public_key", <<0>>},
      {"public_key", root["public_key"] <> "x"},
      {"artifact", false},
      {"revoked", true},
      {"artifact", "true"},
      {"assignment", 0},
      {"revoked", nil},
      {"not_before_unix", now + 1},
      {"not_after_unix", now},
      {"not_before_unix", -1},
      {"not_after_unix", 18_446_744_073_709_551_616},
      {"scope", Map.put(root["scope"], "project", "other")}
    ]

    Enum.each(root_changes, fn {key, value} ->
      roots = [Map.put(root, key, value)]
      assert {:error, _} = ArtifactAdmission.admit(bytes, f["host"], roots, now), key
      assert {:error, _} = ArtifactAdmission.recheck(checked, f["host"], roots, now), key
    end)

    for roots <- [
          [],
          List.duplicate(root, 129),
          [root, root],
          [root, Map.put(root, "key_id", "other") |> Map.put("public_key", "bad")],
          [Map.put(root, "not_before_unix", 5) |> Map.put("not_after_unix", 5)]
        ] do
      assert {:error, _} = ArtifactAdmission.admit(bytes, f["host"], roots, now)
    end

    for key <- Map.keys(root) do
      assert {:error, _} = ArtifactAdmission.admit(bytes, f["host"], [Map.delete(root, key)], now)
    end

    valid_window = [root |> Map.put("not_before_unix", now) |> Map.put("not_after_unix", now + 1)]
    assert {:ok, _} = ArtifactAdmission.admit(bytes, f["host"], valid_window, now)
    assert {:error, _} = ArtifactAdmission.recheck(checked, f["host"], valid_window, now + 1)

    for bad <- [-1, 1.0, nil, 18_446_744_073_709_551_616] do
      assert {:error, _} = ArtifactAdmission.admit(bytes, f["host"], f["roots"], bad)
    end

    h = f["host"]

    for {key, value} <- [
          {"protocol", 2},
          {"protocol", 3.0},
          {"guest_abi", 1},
          {"ui_schema", 2},
          {"runtime", String.duplicate("0", 64)},
          {"scope", Map.put(h["scope"], "app", "other")},
          {"state_version", 2},
          {"state_version", -1},
          {"capability_hashes", %{}},
          {"capability_hashes", nil},
          {"max_payload_bytes", 1},
          {"max_payload_bytes", 4_194_305},
          {"limits", Map.put(h["limits"], "fuel", 1)},
          {"limits", Map.put(h["limits"], "memory_bytes", 0)}
        ] do
      assert {:error, _} =
               ArtifactAdmission.recheck(checked, Map.put(h, key, value), f["roots"], now),
             key
    end

    for key <- Map.keys(h) do
      assert {:error, _} = ArtifactAdmission.recheck(checked, Map.delete(h, key), f["roots"], now)
    end

    {ef, private} = ephemeral(f)
    m = ef["signed_manifest"]["manifest"]
    assert {:error, _} = admit(envelope(sign(m, private, "mixer.artifact.v2\0"), payload(f)), ef)
    assert {:error, _} = admit(envelope(sign(m, private), payload(f) <> "x"), ef)

    assert {:error, _} =
             admit(envelope(sign(m, private), :binary.copy("x", byte_size(payload(f)))), ef)

    wide =
      m
      |> Map.put("state_min", 9_007_199_254_740_993)
      |> Map.put("state_max", 18_446_744_073_709_551_615)
      |> Map.put("created_at_unix", 18_446_744_073_709_551_615)

    wide_host = Map.put(ef["host"], "state_version", 9_007_199_254_740_993)

    assert {:ok, _} =
             ArtifactAdmission.admit(
               envelope(sign(wide, private), payload(f)),
               wide_host,
               ef["roots"],
               now
             )

    for key <- Map.keys(Map.from_struct(checked)) do
      changed = Map.put(checked, key, nil)
      assert {:error, _} = ArtifactAdmission.recheck(changed, h, f["roots"], now), inspect(key)
    end

    assert {:error, _} = ArtifactAdmission.recheck(%{valid: true}, h, f["roots"], now)
  end

  test "semantic grant, asset, compression and signed resource rejection does not rely on signatures" do
    m = fixture()["signed_manifest"]["manifest"]

    for {key, value} <- [
          {"schema", 2},
          {"source_commit", String.duplicate("A", 40)},
          {"source_map_sha256", String.duplicate("A", 64)},
          {"compression", "gzip"},
          {"asset_hashes", %{"asset" => String.duplicate("a", 64)}},
          {"state_min", 2},
          {"capability_hashes", %{"other" => String.duplicate("a", 64)}},
          {"compressed_bytes", 4_194_305},
          {"limits", Map.put(m["limits"], "fuel", 1_000_001)},
          {"created_at_unix", 0}
        ] do
      refute ArtifactV3Policy.manifest?(Map.put(m, key, value)), key
    end

    descriptor = m["capability_grants"]

    for entries <- [
          Enum.reverse(descriptor["entries"]),
          [hd(descriptor["entries"]), hd(descriptor["entries"])],
          nil
        ] do
      refute ArtifactV3Policy.manifest?(
               Map.put(m, "capability_grants", Map.put(descriptor, "entries", entries))
             )
    end

    empty = Map.put(descriptor, "entries", [])
    assert ArtifactV3Policy.manifest?(Map.put(m, "capability_grants", empty))
  end
end

fc24118c75ef9d8ef332c2c604ef52f445f0ab32 blob 7872
defmodule MixerHosted.Protocol.ArtifactCBORTest do
  use ExUnit.Case, async: true

  alias MixerHosted.Protocol.ArtifactCBOR

  @vector Path.expand("../../../../services/protocol/testdata/signed-release-v3.json", __DIR__)

  test "unsigned integer transitions use the shortest supported representation" do
    for {value, hex} <- [
          {0, "00"},
          {23, "17"},
          {24, "1818"},
          {255, "18ff"},
          {256, "190100"},
          {65_535, "19ffff"},
          {65_536, "1a00010000"},
          {4_294_967_295, "1affffffff"},
          {4_294_967_296, "1b0000000100000000"},
          {18_446_744_073_709_551_615, "1bffffffffffffffff"}
        ] do
      assert_hex(value, hex)
    end
  end

  test "text counts UTF-8 bytes and never normalizes Unicode" do
    for {value, hex} <- [
          {"", "60"},
          {"a", "6161"},
          {"IETF", "6449455446"},
          {"\u00fc", "62c3bc"},
          {"水", "63e6b0b4"},
          {"\u{1f600}", "64f09f9880"},
          {"\u00e9", "62c3a9"},
          {"e\u0301", "6365cc81"},
          {"\u0000", "6100"}
        ] do
      assert_hex(value, hex)
    end

    for {count, prefix} <- [
          {23, <<0x77>>},
          {24, <<0x78, 24>>},
          {255, <<0x78, 255>>},
          {256, <<0x79, 1, 0>>}
        ] do
      value = String.duplicate("a", count)
      assert ArtifactCBOR.encode(value) == {:ok, prefix <> value}
    end
  end

  test "booleans, definite arrays and text maps preserve the artifact subset" do
    assert_hex(false, "f4")
    assert_hex(true, "f5")
    assert_hex([], "80")
    assert_hex(%{}, "a0")
    assert_hex([1, [2, 3], [4, 5]], "8301820203820405")
    assert_hex(%{"a" => 1, "b" => [2, 3]}, "a26161016162820203")
    assert_hex(~c"abc", "83186118621863")
  end

  test "map ordering compares complete encoded text keys rather than source text" do
    # Source-text lexical order would put aa before b. UTF-8 and empty keys
    # exercise encoded lengths; canonically equivalent strings remain distinct.
    assert_hex(%{"aa" => 2, "b" => 1}, "a261620162616102")

    assert_hex(
      %{"z" => 1, "é" => 2, "e\u0301" => 3, "" => 0},
      "a46000617a0162c3a9026365cc8103"
    )

    pairs = [{"aa", 2}, {"b", 1}, {"", 0}, {"nested", %{"xx" => false, "c" => true}}]

    assert ArtifactCBOR.encode(Map.new(pairs)) ==
             ArtifactCBOR.encode(Map.new(Enum.reverse(pairs)))
  end

  test "the existing signed v3 artifact, assignment and grant vector is byte exact" do
    vector = @vector |> File.read!() |> Jason.decode!()
    assert vector["test_only"] == true

    for {name, body, domain, root_index} <- [
          {"manifest", "manifest", "mixer.artifact.v3\0", 0},
          {"assignment", "assignment", "mixer.assignment.v3\0", 1}
        ] do
      signed = vector["signed_" <> name]
      assert {:ok, encoded} = ArtifactCBOR.encode(signed[body])
      assert Base.encode16(encoded, case: :lower) == vector[name <> "_cbor_hex"]
      preimage = domain <> encoded
      assert Base.encode16(preimage, case: :lower) == vector[name <> "_message_hex"]

      public_key =
        vector["roots"] |> Enum.at(root_index) |> Map.fetch!("public_key") |> Base.decode64!()

      signature = Base.decode64!(signed["signature"])
      assert :crypto.verify(:eddsa, :none, preimage, signature, [public_key, :ed25519])
      refute :crypto.verify(:eddsa, :none, preimage <> <<0>>, signature, [public_key, :ed25519])

      if name == "manifest" do
        digest = :crypto.hash(:sha256, encoded) |> Base.encode16(case: :lower)
        assert digest == vector["artifact_sha256"]
      end
    end

    assert {:ok, grants} = ArtifactCBOR.encode(vector["grant_descriptor"])
    assert Base.encode16(grants, case: :lower) == vector["grant_descriptor_cbor_hex"]
    descriptor_hash = :crypto.hash(:sha256, grants) |> Base.encode16(case: :lower)

    assert descriptor_hash ==
             vector["signed_manifest"]["manifest"]["capability_grants"]["schema_sha256"]
  end

  test "unsupported types and nontext keys fail without implicit conversion" do
    for value <- [
          nil,
          -1,
          18_446_744_073_709_551_616,
          1.0,
          :unknown,
          {:bytes, <<1>>},
          <<1::1>>,
          self(),
          make_ref(),
          fn -> :ok end,
          %URI{},
          %{:a => 1},
          %{1 => "a"},
          %{false => 1},
          %{"nested" => %{a: 1}},
          [1 | 2]
        ] do
      assert ArtifactCBOR.encode(value) == {:error, :invalid_value}
    end
  end

  test "malformed UTF-8 fails in values and keys" do
    for invalid <- [
          <<0xFF>>,
          <<0xC0, 0xAF>>,
          <<0xE2, 0x82>>,
          <<0xED, 0xA0, 0x80>>,
          <<0xF4, 0x90, 0x80, 0x80>>
        ] do
      assert ArtifactCBOR.encode(invalid) == {:error, :invalid_value}
      assert ArtifactCBOR.encode(%{invalid => 1}) == {:error, :invalid_value}
      assert ArtifactCBOR.encode([invalid]) == {:error, :invalid_value}
    end
  end

  test "byte budget includes every prefix and all nested key and value bytes" do
    assert ArtifactCBOR.encode("", 1) == {:ok, <<0x60>>}
    assert ArtifactCBOR.encode("a", 1) == {:error, :limit_exceeded}
    assert ArtifactCBOR.encode([0], 2) == {:ok, <<0x81, 0>>}
    assert ArtifactCBOR.encode([0], 1) == {:error, :limit_exceeded}
    assert ArtifactCBOR.encode(%{"a" => 0}, 4) == {:ok, <<0xA1, 0x61, ?a, 0>>}
    assert ArtifactCBOR.encode(%{"a" => 0}, 3) == {:error, :limit_exceeded}

    nested = %{"key" => [false, %{"value" => 24}]}
    {:ok, encoded} = ArtifactCBOR.encode(nested)
    assert ArtifactCBOR.encode(nested, byte_size(encoded)) == {:ok, encoded}
    assert ArtifactCBOR.encode(nested, byte_size(encoded) - 1) == {:error, :limit_exceeded}

    assert {:ok, maximum} = ArtifactCBOR.encode(String.duplicate("a", 65_533))
    assert byte_size(maximum) == 65_536
    assert ArtifactCBOR.encode(String.duplicate("a", 65_534)) == {:error, :limit_exceeded}
    assert ArtifactCBOR.encode(%{String.duplicate("a", 65_533) => 0}) == {:error, :limit_exceeded}

    for limit <- [0, -1, 65_537, 1.0, nil, :unlimited] do
      assert ArtifactCBOR.encode(0, limit) == {:error, :invalid_value}
    end
  end

  test "per-container bounds apply before traversal and never truncate inputs" do
    assert {:ok, _} = ArtifactCBOR.encode(List.duplicate(0, 256))
    assert ArtifactCBOR.encode(List.duplicate(0, 257)) == {:error, :limit_exceeded}
    assert ArtifactCBOR.encode(List.duplicate(0, 100_000)) == {:error, :limit_exceeded}
    map = Map.new(1..256, &{Integer.to_string(&1), 0})
    assert {:ok, _} = ArtifactCBOR.encode(map)
    assert ArtifactCBOR.encode(Map.put(map, "overflow", 0)) == {:error, :limit_exceeded}
  end

  test "global item budget includes containers and map keys" do
    rows = List.duplicate(List.duplicate(false, 256), 15)
    exact = rows ++ [List.duplicate(false, 239)]
    assert {:ok, _} = ArtifactCBOR.encode(exact)
    assert ArtifactCBOR.encode(rows ++ [List.duplicate(false, 240)]) == {:error, :limit_exceeded}

    map = Map.new(1..119, &{Integer.to_string(&1), false})
    assert {:ok, _} = ArtifactCBOR.encode(rows ++ [map, false])
    assert ArtifactCBOR.encode(rows ++ [map, false, false]) == {:error, :limit_exceeded}
  end

  test "depth budget bounds both arrays and maps" do
    arrays = Enum.reduce(1..16, 0, fn _, value -> [value] end)
    maps = Enum.reduce(1..16, 0, fn _, value -> %{"key" => value} end)
    assert {:ok, _} = ArtifactCBOR.encode(arrays)
    assert {:ok, _} = ArtifactCBOR.encode(maps)
    assert ArtifactCBOR.encode([arrays]) == {:error, :limit_exceeded}
    assert ArtifactCBOR.encode(%{"key" => maps}) == {:error, :limit_exceeded}
  end

  defp assert_hex(value, hex) do
    assert {:ok, encoded} = ArtifactCBOR.encode(value)
    assert Base.encode16(encoded, case: :lower) == hex
  end
end

30864e162abb24028ff2553a8b27331088fe972e blob 3555
defmodule MixerHostedWeb.BearerIdentityCompileTest do
  use ExUnit.Case, async: false

  alias MixerHostedWeb.Plugs.BearerIdentity

  defmodule InitProbe do
    def init(options) do
      send(:persistent_term.get({__MODULE__, :owner}), :initializing_bearer)
      BearerIdentity.init(options)
    end

    def call(conn, options), do: BearerIdentity.call(conn, options)
  end

  test "pipeline initialization waits for verifier and clock in a cold parallel compile" do
    key = {InitProbe, :owner}
    :persistent_term.put(key, self())

    directory =
      Path.join(System.tmp_dir!(), "mixer-bearer-compile-#{System.unique_integer([:positive])}")

    File.mkdir!(directory)

    modules = [
      MixerHostedWeb.ColdCompileVerifier,
      MixerHostedWeb.ColdCompileClock,
      MixerHostedWeb.ColdCompilePipeline
    ]

    try do
      for module <- modules, do: refute(Code.loaded?(module))

      verifier = Path.join(directory, "verifier.ex")
      clock = Path.join(directory, "clock.ex")
      pipeline = Path.join(directory, "pipeline.ex")

      for {path, module, definitions} <- [
            {verifier, Enum.at(modules, 0),
             "def authenticate(_, _), do: {:error, :unauthenticated}"},
            {clock, Enum.at(modules, 1), "def now, do: System.system_time(:second)"}
          ] do
        File.write!(path, """
        defmodule #{inspect(module)} do
          send(:persistent_term.get(#{inspect(key)}), {:dependency_waiting, self()})
          receive do
            :continue -> :ok
          after
            5_000 -> raise "compile test dependency was not released"
          end
          #{definitions}
        end
        """)
      end

      File.write!(pipeline, """
      send(:persistent_term.get(#{inspect(key)}), {:pipeline_waiting, self()})
      receive do
        :continue -> :ok
      after
        5_000 -> raise "compile test pipeline was not released"
      end
      defmodule MixerHostedWeb.ColdCompilePipeline do
        use Plug.Builder
        plug #{inspect(InitProbe)}, verifier: MixerHostedWeb.ColdCompileVerifier,
          clock: {MixerHostedWeb.ColdCompileClock, :now, []}
      end
      """)

      task =
        Task.async(fn ->
          Kernel.ParallelCompiler.compile([verifier, clock, pipeline],
            return_diagnostics: true,
            max_concurrency: 3
          )
        end)

      assert_receive {:dependency_waiting, first}, 5_000
      assert_receive {:dependency_waiting, second}, 5_000
      assert_receive {:pipeline_waiting, caller}, 5_000
      send(caller, :continue)
      assert_receive :initializing_bearer, 5_000

      # Keep both dependencies in compilation until the plug has attempted init.
      # A load-only check returns an error here; the compiler-aware check waits.
      premature = Task.yield(task, 100)
      send(first, :continue)
      send(second, :continue)
      result = premature || Task.yield(task, 5_000) || Task.shutdown(task, :brutal_kill)
      assert premature == nil
      assert {:ok, {:ok, compiled, %{compile_warnings: [], runtime_warnings: []}}} = result
      assert Enum.sort(compiled) == Enum.sort(modules)

      conn = apply(Enum.at(modules, 2), :call, [Plug.Test.conn(:get, "/protected"), []])
      assert conn.status == 401
      assert conn.halted
      refute Map.has_key?(conn.assigns, :verified_identity)
    after
      :persistent_term.erase(key)
      File.rm_rf!(directory)

      for module <- Enum.reverse(modules) do
        :code.purge(module)
        :code.delete(module)
      end
    end
  end
end

2c3f3dd2818ad0019f4a719ef840742b072c4b51 blob 25213
defmodule MixerHostedWeb.BearerIdentityTest do
  use ExUnit.Case, async: false

  import Plug.Conn
  import Plug.Test

  alias MixerHosted.Identity.{
    AccessTokenVerifier,
    ConfiguredVerifier,
    TrustSnapshot,
    VerifiedIdentity
  }

  alias MixerHostedWeb.Plugs.BearerIdentity

  @now 1_800_000_000

  defmodule ProbeVerifier do
    @behaviour MixerHosted.Identity.Verifier
    def authenticate(token, now) do
      send(self(), {:verification_called, token, now})
      Process.get(:bearer_test_result, {:error, :unauthenticated})
    end
  end

  defmodule SnapshotVerifier do
    @behaviour MixerHosted.Identity.Verifier
    def authenticate(token, now) do
      send(self(), {:snapshot_verification_called, token, now})
      AccessTokenVerifier.verify(token, now, Process.get(:bearer_test_snapshot))
    end
  end

  defmodule RaisingVerifier do
    @behaviour MixerHosted.Identity.Verifier
    def authenticate(_, _), do: raise("private provider response and credential")
  end

  defmodule ThrowingVerifier do
    @behaviour MixerHosted.Identity.Verifier
    def authenticate(_, _), do: throw({:secret, "private provider response"})
  end

  defmodule ExitingVerifier do
    @behaviour MixerHosted.Identity.Verifier
    def authenticate(_, _), do: exit(:shutdown)
  end

  def fixed_clock, do: @now
  def bad_clock, do: "not a time"
  def raising_clock, do: raise("private clock details")

  setup_all do
    {:ok, _} = Application.ensure_all_started(:jose)
    private = JOSE.JWK.generate_key({:rsa, 2_048})
    public = private |> JOSE.JWK.to_public() |> JOSE.JWK.to_map() |> elem(1)

    public =
      Map.merge(public, %{
        "kid" => "http-transport-owned-test-key",
        "alg" => "RS256",
        "use" => "sig",
        "key_ops" => ["verify"]
      })

    profile = %{
      profile_id: "http-transport-owned-test-profile",
      profile_version: 1,
      issuer: "https://transport-issuer.invalid/oauth",
      audience: "http-transport-test-api",
      client_id: "http-transport-test-client",
      identity_class: :human,
      enabled: true
    }

    {:ok, snapshot} =
      TrustSnapshot.new(profile, Jason.encode!(%{"keys" => [public]}), @now - 1, @now + 120)

    claims = %{
      "iss" => profile.issuer,
      "aud" => profile.audience,
      "sub" => "synthetic-http-subject",
      "client_id" => profile.client_id,
      "jti" => "synthetic-http-credential",
      "iat" => @now - 10,
      "exp" => @now + 100,
      "scope" => "mixer.artifact.read untrusted.admin",
      "role" => "owner",
      "organization_id" => "not-authority"
    }

    {:ok, private: private, snapshot: snapshot, claims: claims}
  end

  setup do
    Process.put(:bearer_test_result, {:ok, identity()})
    {:ok, opts: options()}
  end

  defp identity do
    %VerifiedIdentity{
      profile_id: "typed-test-profile",
      profile_version: 1,
      issuer: "https://test.invalid/oauth",
      subject: "synthetic-subject",
      client_id: "synthetic-client",
      credential_ref: "synthetic-credential",
      issued_at: @now - 1,
      expires_at: @now + 30,
      identity_class: :human,
      scopes: []
    }
  end

  defp options(overrides \\ []) do
    [verifier: ProbeVerifier, clock: {__MODULE__, :fixed_clock, []}]
    |> Keyword.merge(overrides)
    |> BearerIdentity.init()
  end

  defp request(headers \\ [{"authorization", "Bearer exact.Token-1"}], target \\ "/protected") do
    %{conn(:get, target) | req_headers: headers}
  end

  defp assert_error(conn, status, code, challenge) do
    assert conn.status == status
    assert conn.halted
    refute Map.has_key?(conn.assigns, :verified_identity)
    assert get_resp_header(conn, "cache-control") == ["no-store"]
    assert get_resp_header(conn, "content-type") == ["application/json; charset=utf-8"]
    assert get_resp_header(conn, "www-authenticate") == List.wrap(challenge)
    assert get_resp_header(conn, "retry-after") == if(status == 503, do: ["1"], else: [])
    assert byte_size(conn.resp_body) < 512
    assert %{"error" => error, "request_id" => request_id} = Jason.decode!(conn.resp_body)
    assert Enum.sort(Map.keys(error)) == ["code", "message"]
    assert error["code"] == code
    assert is_binary(error["message"]) and byte_size(error["message"]) < 100
    assert get_resp_header(conn, "x-request-id") == [request_id]
    assert byte_size(request_id) in 20..200
    assert Enum.sort(Map.keys(Jason.decode!(conn.resp_body))) == ["error", "request_id"]
    conn
  end

  defp invalid_request(conn, opts) do
    conn
    |> BearerIdentity.call(opts)
    |> assert_error(400, "invalid_request", ~s(Bearer error="invalid_request"))
  end

  test "missing header is a bare 401 challenge and clears a stale assigned identity", %{
    opts: opts
  } do
    request([])
    |> assign(:verified_identity, identity())
    |> BearerIdentity.call(opts)
    |> assert_error(401, "unauthenticated", "Bearer")

    refute_receive {:verification_called, _, _}
  end

  test "standard scheme casing and one or more spaces preserve exact token bytes", %{opts: opts} do
    for scheme <- ["Bearer", "bearer", "BEARER", "bEaReR"], spaces <- [" ", "   "] do
      token = "aZ09-._~+/=="
      conn = request([{"authorization", scheme <> spaces <> token}]) |> BearerIdentity.call(opts)
      refute conn.halted
      assert conn.assigns == %{verified_identity: identity()}
      assert get_resp_header(conn, "cache-control") == ["no-store"]
      assert_receive {:verification_called, ^token, @now}
    end
  end

  test "4096-byte header and 4089-byte token boundaries are enforced", %{opts: opts} do
    token = String.duplicate("a", 4_089)
    accepted = request([{"authorization", "Bearer " <> token}]) |> BearerIdentity.call(opts)
    refute accepted.halted
    assert_receive {:verification_called, ^token, @now}

    for value <- ["Bearer " <> token <> "a", "Bearer  " <> token] do
      invalid_request(request([{"authorization", value}]), opts)
      refute_receive {:verification_called, _, _}
    end
  end

  test "duplicate headers reject even if identical or paired with an empty value", %{opts: opts} do
    for values <- [["Bearer a", "Bearer a"], ["Bearer a", "Bearer b"], ["", "Bearer a"]] do
      invalid_request(request(Enum.map(values, &{"authorization", &1})), opts)
      refute_receive {:verification_called, _, _}
    end
  end

  test "malformed, comma-joined, unsupported and ambiguous schemes reject before verification", %{
    opts: opts
  } do
    for value <- [
          "",
          "Bearer",
          "Bearer ",
          " Bearer abc",
          "Bearer\tabc",
          "Bearer abc ",
          "Bearer abc def",
          "Bearer a,b",
          "Bearer a, Bearer b",
          "Basic abc",
          "Digest abc",
          "Bearer \"abc\"",
          "Bearer =",
          "Bearer abc=def",
          "Bearer abc;def",
          "Bearér abc",
          "Bearer abc:secret",
          "Bearer abc\\def"
        ] do
      invalid_request(request([{"authorization", value}]), opts)
      refute_receive {:verification_called, _, _}
    end
  end

  test "every ASCII control, DEL, non-ASCII and invalid UTF8 credential is malformed", %{
    opts: opts
  } do
    for byte <- Enum.to_list(0..31) ++ [127, 128, 255] do
      invalid_request(request([{"authorization", "Bearer a" <> <<byte>> <> "b"}]), opts)
      refute_receive {:verification_called, _, _}
    end
  end

  test "verifier rejection is a generic invalid-token response with no stale identity", %{
    opts: opts
  } do
    Process.put(:bearer_test_result, {:error, :unauthenticated})

    result =
      request()
      |> assign(:verified_identity, identity())
      |> BearerIdentity.call(opts)
      |> assert_error(401, "unauthenticated", ~s(Bearer error="invalid_token"))

    assert_receive {:verification_called, "exact.Token-1", @now}
    refute result.resp_body =~ "exact.Token-1"
    refute result.resp_body =~ "synthetic-subject"
  end

  test "unavailability and unsupported verifier results fail closed without details", %{
    opts: opts
  } do
    for result <- [
          {:error, :identity_unavailable},
          {:error, :rate_limit},
          {:error, "private DSN"},
          {:ok, %{subject: "forged", role: "owner"}},
          {:ok, nil},
          :ok,
          nil,
          {:error, :unauthenticated, "private provider response"}
        ] do
      Process.put(:bearer_test_result, result)

      response =
        request()
        |> assign(:verified_identity, identity())
        |> BearerIdentity.call(opts)
        |> assert_error(503, "identity_unavailable", nil)

      refute response.resp_body =~ "private"
      refute response.resp_body =~ "forged"
      assert_receive {:verification_called, "exact.Token-1", @now}
    end
  end

  test "ordinary adapter exceptions and throws are generic unavailable responses" do
    for verifier <- [RaisingVerifier, ThrowingVerifier] do
      result = request() |> BearerIdentity.call(options(verifier: verifier))
      assert_error(result, 503, "identity_unavailable", nil)
      refute result.resp_body =~ "private"
    end
  end

  test "process exits are not hidden by an all-class catch" do
    assert catch_exit(BearerIdentity.call(request(), options(verifier: ExitingVerifier))) ==
             :shutdown
  end

  test "only a fresh typed result is assigned and HTTP authority assertions are inert", %{
    opts: opts
  } do
    expected = %{identity() | subject: "newly-verified"}
    Process.put(:bearer_test_result, {:ok, expected})

    result =
      request([
        {"authorization", "Bearer a"},
        {"x-role", "owner"},
        {"x-organization-id", "other"}
      ])
      |> assign(:verified_identity, %{identity() | subject: "stale"})
      |> assign(:unrelated, :preserved)
      |> BearerIdentity.call(opts)

    assert result.assigns == %{verified_identity: expected, unrelated: :preserved}
    assert_receive {:verification_called, "a", @now}
    refute result.halted
  end

  test "reserved query token names and bracket forms reject before verifying with or without a header",
       %{opts: opts} do
    for query <- [
          "access_token=a",
          "access_token",
          "%61ccess%5ftoken=a",
          "x=1&access_token=a",
          "access_token[]=a",
          "access_token%5Bvalue%5D=a",
          "access_token=a&access_token=b"
        ],
        headers <- [[], [{"authorization", "Bearer a"}]] do
      invalid_request(request(headers, "/protected?" <> query), opts)
      refute_receive {:verification_called, _, _}
    end
  end

  test "query names are bounded and malformed or hidden control escapes fail closed", %{
    opts: opts
  } do
    for query <- [
          "%x1=value",
          "%0=value",
          "%00access_token=a",
          "%FF=value",
          "x%7f=value",
          String.duplicate("a", 257) <> "=v",
          Enum.map_join(1..129, "&", fn _ -> "x=v" end),
          "x=" <> String.duplicate("a", 8_191)
        ] do
      invalid_request(request([{"authorization", "Bearer a"}], "/protected?" <> query), opts)
      refute_receive {:verification_called, _, _}
    end
  end

  test "ordinary query values and fetched params do not provide identity or consume parameters",
       %{opts: opts} do
    raw = "q=access_token%3Da&filter[name]=x&access_token_hint=y&nested[access_token]=z"

    original =
      request([{"authorization", "Bearer a"}], "/protected?" <> raw) |> fetch_query_params()

    result = BearerIdentity.call(original, opts)
    refute result.halted
    assert result.query_string == original.query_string
    assert result.query_params == original.query_params
    assert result.params == original.params
    assert_receive {:verification_called, "a", @now}
  end

  test "query byte, field and decoded-name limits accept their exact boundary", %{opts: opts} do
    for query <- [
          "x=" <> String.duplicate("v", 8_190),
          String.duplicate("a", 256) <> "=v",
          Enum.map_join(1..128, "&", fn _ -> "x=v" end)
        ] do
      result =
        request([{"authorization", "Bearer a"}], "/protected?" <> query)
        |> BearerIdentity.call(opts)

      refute result.halted
      assert_receive {:verification_called, "a", @now}
    end
  end

  test "form bodies are rejected untouched, regardless of token presence or prior parsing", %{
    opts: opts
  } do
    for type <- [
          "application/x-www-form-urlencoded",
          "APPLICATION/X-WWW-FORM-URLENCODED; charset=UTF-8"
        ],
        body <- ["access_token=secret", "ordinary=value"],
        headers <- [[], [{"authorization", "Bearer a"}]] do
      original = conn(:post, "/protected", body)
      original = %{original | req_headers: [{"content-type", type} | headers]}
      result = invalid_request(original, opts)
      assert result.body_params == original.body_params
      assert {:ok, ^body, _} = read_body(result)
      refute_receive {:verification_called, _, _}
    end

    parsed = request([{"content-type", "application/x-www-form-urlencoded"}])
    invalid_request(%{parsed | body_params: %{"access_token" => "secret"}}, opts)
    refute_receive {:verification_called, _, _}
  end

  test "duplicate, malformed, comma-joined and oversized Content-Type never select a convenient value",
       %{opts: opts} do
    for types <- [
          ["application/json", "application/x-www-form-urlencoded"],
          ["application/json", "application/json"],
          ["application/json, application/x-www-form-urlencoded"],
          ["application/x-www-form-urlencoded, application/json"],
          ["invalid"],
          ["application/"],
          ["application/ "],
          ["application/; charset=utf-8"],
          [~s(application/; profile="one,two")],
          ["application/; ;"],
          ["*/*"],
          [String.duplicate("a", 1_025)]
        ] do
      headers = [{"authorization", "Bearer a"} | Enum.map(types, &{"content-type", &1})]
      invalid_request(request(headers), opts)
      refute_receive {:verification_called, _, _}
    end
  end

  test "JSON and other bodies remain unread and tokens in them have no authentication fallback",
       %{opts: opts} do
    for type <- ["application/json", "application/octet-stream"], header? <- [true, false] do
      body = ~s({"access_token":"body-secret","role":"owner"})
      original = conn(:post, "/protected", body) |> put_req_header("content-type", type)

      original =
        if header?,
          do: put_req_header(original, "authorization", "Bearer header-token"),
          else: original

      result = BearerIdentity.call(original, opts)
      assert result.body_params == original.body_params
      assert result.params == original.params
      assert {:ok, ^body, _} = read_body(result)

      if header? do
        refute result.halted
        assert_receive {:verification_called, "header-token", @now}
      else
        assert_error(result, 401, "unauthenticated", "Bearer")
        refute_receive {:verification_called, _, _}
      end
    end
  end

  test "malformed Content-Type parameter tails reject without verification", %{opts: opts} do
    for type <- [
          "application/json; charset=utf-8, application/x-www-form-urlencoded",
          "application/json; invalid-parameter",
          ~s(application/json; profile="unterminated),
          "application/json; charset=",
          "application/json; charset =utf-8",
          "application/json; charset= utf-8",
          ~s(application/json; profile="ok"extra),
          "application/json\r\n; charset=utf-8"
        ] do
      invalid_request(request([{"authorization", "Bearer a"}, {"content-type", type}]), opts)
      refute_received {:verification_called, _, _}
    end
  end

  test "complete quoted parameters and empty parameter slots remain accepted", %{opts: opts} do
    for type <- [
          ~s(application/json; profile="one,two;three"),
          ~S(application/json; profile="one\"two\\three"),
          ~s(application/json; profile=""; charset=utf-8),
          "application/json; ; charset=utf-8;\t;",
          "application/json; profile=\"" <> <<128, 255>> <> "\""
        ] do
      result =
        request([{"authorization", "Bearer a"}, {"content-type", type}])
        |> BearerIdentity.call(opts)

      refute result.halted
      assert_received {:verification_called, "a", @now}
    end
  end

  test "Content-Type quoted values reject controls and require paired escapes", %{opts: opts} do
    for byte <- 0..255 do
      type = "application/json; profile=\"a" <> <<byte>> <> "b\""

      result =
        request([{"authorization", "Bearer a"}, {"content-type", type}])
        |> BearerIdentity.call(opts)

      if byte == 9 or byte in 32..33 or byte in 35..126 or byte >= 128 do
        refute result.halted, "allowed quoted byte #{byte}"
        assert_received {:verification_called, "a", @now}
      else
        assert result.status == 400, "forbidden quoted byte #{byte}"
        refute_received {:verification_called, _, _}
      end
    end
  end

  test "denials normalize every duplicate response metadata header", %{opts: opts} do
    for {headers, outcome, status, code, challenge} <- [
          {[], {:ok, identity()}, 401, "unauthenticated", "Bearer"},
          {[{"authorization", "Basic a"}], {:ok, identity()}, 400, "invalid_request",
           ~s(Bearer error="invalid_request")},
          {[{"authorization", "Bearer a"}], {:error, :unauthenticated}, 401, "unauthenticated",
           ~s(Bearer error="invalid_token")},
          {[{"authorization", "Bearer a"}], {:error, :identity_unavailable}, 503,
           "identity_unavailable", nil}
        ] do
      Process.put(:bearer_test_result, outcome)

      stale =
        for name <- [
              "x-request-id",
              "www-authenticate",
              "retry-after",
              "cache-control",
              "content-type"
            ],
            value <- [
              "old-response-first-12345",
              "old-response-second-12345",
              "old-response-third-12345"
            ],
            do: {name, value}

      original = %{request(headers) | resp_headers: [{"x-preserved", "yes"} | stale]}
      result = BearerIdentity.call(original, opts) |> assert_error(status, code, challenge)
      assert [id] = get_resp_header(result, "x-request-id")
      refute String.starts_with?(id, "old-response-")
      assert get_resp_header(result, "cache-control") == ["no-store"]
      assert get_resp_header(result, "content-type") == ["application/json; charset=utf-8"]
      assert get_resp_header(result, "x-preserved") == ["yes"]

      if headers == [{"authorization", "Bearer a"}],
        do: assert_received({:verification_called, "a", @now})
    end
  end

  test "successful identity admission also replaces duplicate request IDs and cache directives",
       %{opts: opts} do
    original = %{
      request()
      | resp_headers: [
          {"x-request-id", "old-response-first-12345"},
          {"x-request-id", "old-response-second-12345"},
          {"cache-control", "public"},
          {"cache-control", "max-age=600"}
        ]
    }

    result = BearerIdentity.call(original, opts)
    refute result.halted
    assert [_] = get_resp_header(result, "x-request-id")
    assert get_resp_header(result, "cache-control") == ["no-store"]
    assert_received {:verification_called, "exact.Token-1", @now}
  end

  test "cookies are ignored data and never become an identity mechanism", %{opts: opts} do
    cookie = {"cookie", "access_token=cookie-secret; session=cookie-session"}
    missing = request([cookie]) |> BearerIdentity.call(opts)
    assert_error(missing, 401, "unauthenticated", "Bearer")
    refute_receive {:verification_called, _, _}

    present =
      request([cookie, {"authorization", "Bearer header-token"}]) |> BearerIdentity.call(opts)

    refute present.halted
    assert_receive {:verification_called, "header-token", @now}
    assert present.req_cookies == %Plug.Conn.Unfetched{aspect: :cookies}
  end

  test "request IDs reuse a bounded safe upstream response ID and replace unsafe values", %{
    opts: opts
  } do
    id = "http-transport-request-12345"
    upstream = request([]) |> put_resp_header("x-request-id", id)

    result =
      upstream |> BearerIdentity.call(opts) |> assert_error(401, "unauthenticated", "Bearer")

    assert Jason.decode!(result.resp_body)["request_id"] == id

    for unsafe <- ["tiny", String.duplicate("a", 201), String.duplicate("a", 20) <> "\nsecret"] do
      original = %{request([]) | resp_headers: [{"x-request-id", unsafe}]}

      result =
        original |> BearerIdentity.call(opts) |> assert_error(401, "unauthenticated", "Bearer")

      refute Jason.decode!(result.resp_body)["request_id"] == unsafe
    end
  end

  test "existing Plug.RequestId output joins the JSON envelope", %{opts: opts} do
    original = Plug.RequestId.call(request([]), Plug.RequestId.init([]))

    result =
      original |> BearerIdentity.call(opts) |> assert_error(401, "unauthenticated", "Bearer")

    assert get_resp_header(result, "x-request-id") == get_resp_header(original, "x-request-id")
  end

  test "trusted dependency injection is closed and validated at init" do
    for options <- [
          %{},
          [unknown: true],
          [verifier: ProbeVerifier, verifier: ProbeVerifier],
          [verifier: "ProbeVerifier"],
          [verifier: String],
          [clock: fn -> @now end],
          [clock: {System, :does_not_exist, []}],
          [clock: {System, :system_time, :second}]
        ] do
      assert_raise ArgumentError, fn -> BearerIdentity.init(options) end
    end

    assert BearerIdentity.init([]) == %{
             verifier: ConfiguredVerifier,
             clock: {System, :system_time, [:second]}
           }
  end

  test "default clock forwards actual Unix seconds and invalid clock results fail closed" do
    before = System.system_time(:second)
    result = request() |> BearerIdentity.call(BearerIdentity.init(verifier: ProbeVerifier))
    after_time = System.system_time(:second)
    refute result.halted
    assert_receive {:verification_called, "exact.Token-1", time}
    assert time >= before and time <= after_time

    for function <- [:bad_clock, :raising_clock] do
      result = request() |> BearerIdentity.call(options(clock: {__MODULE__, function, []}))
      assert_error(result, 503, "identity_unavailable", nil)
      refute_receive {:verification_called, _, _}
    end
  end

  test "default ConfiguredVerifier with no started owner is unavailable, never a raw-token fallback" do
    assert Process.whereis(MixerHosted.Identity.KeyOwner) == nil

    assert ConfiguredVerifier.authenticate("synthetic.token", System.system_time(:second)) ==
             {:error, :identity_unavailable}

    result =
      request()
      |> assign(:verified_identity, identity())
      |> BearerIdentity.call(BearerIdentity.init([]))

    assert_error(result, 503, "identity_unavailable", nil)
  end

  defp sign(private, claims) do
    header = %{"alg" => "RS256", "typ" => "at+jwt", "kid" => "http-transport-owned-test-key"}
    JOSE.JWS.sign(private, Jason.encode!(claims), header) |> JOSE.JWS.compact() |> elem(1)
  end

  test "real RS256 and TrustSnapshot verification joins HTTP without granting token-claimed authority",
       c do
    Process.put(:bearer_test_snapshot, c.snapshot)
    token = sign(c.private, c.claims)
    opts = options(verifier: SnapshotVerifier)
    result = request([{"authorization", "Bearer " <> token}]) |> BearerIdentity.call(opts)

    assert %VerifiedIdentity{subject: "synthetic-http-subject", scopes: ["mixer.artifact.read"]} =
             result.assigns.verified_identity

    assert Map.keys(result.assigns) == [:verified_identity]
    refute result.halted
    assert_receive {:snapshot_verification_called, ^token, @now}
  end

  test "real signature, expiry, audience and snapshot freshness failures preserve generic HTTP denials",
       c do
    Process.put(:bearer_test_snapshot, c.snapshot)
    opts = options(verifier: SnapshotVerifier)
    good = sign(c.private, c.claims)
    [head, payload, signature] = :binary.split(good, ".", [:global])
    <<first, tail::binary>> = Base.url_decode64!(signature, padding: false)
    bad_signature = Base.url_encode64(<<Bitwise.bxor(first, 1), tail::binary>>, padding: false)

    for token <- [
          Enum.join([head, payload, bad_signature], "."),
          sign(c.private, %{c.claims | "exp" => @now}),
          sign(c.private, %{c.claims | "aud" => "wrong-audience"})
        ] do
      result =
        request([{"authorization", "Bearer " <> token}])
        |> assign(:verified_identity, identity())
        |> BearerIdentity.call(opts)

      assert_error(result, 401, "unauthenticated", ~s(Bearer error="invalid_token"))
      refute result.resp_body =~ "synthetic-http"
      assert_receive {:snapshot_verification_called, ^token, @now}
    end

    Process.put(:bearer_test_snapshot, %{c.snapshot | fresh_until: @now})
    result = request([{"authorization", "Bearer " <> good}]) |> BearerIdentity.call(opts)
    assert_error(result, 503, "identity_unavailable", nil)
  end
end

b82ada6175dcd5f7a3d73467cf35cdc0e98131d2 blob 7201
defmodule MixerHostedWeb.BrowserWorkspaceDispatcherCaptureAdapterTest do
  use ExUnit.Case, async: true
  alias MixerHosted.Identity.VerifiedIdentity
  alias MixerHostedWeb.BrowserWorkspaceDispatcher.CaptureAdapter
  alias MixerHostedWeb.CustomerWorkspaceController, as: Controller

  # Explicitly synthetic trusted facade fixture using the existing controller's
  # trusted test seam. These are capture/controller receipts, never dispatcher,
  # configured verifier, ordinary Repo, database or session-success receipts.
  defmodule SyntheticTrustedFacade do
    def organizations(_identity, _page), do: Process.get(:synthetic_capture_result)
    def projects(_identity, _organization, _page), do: Process.get(:synthetic_capture_result)
  end

  defp synthetic_identity do
    %VerifiedIdentity{
      profile_id: "synthetic-profile",
      profile_version: 1,
      issuer: "https://synthetic.invalid",
      subject: "synthetic-subject",
      client_id: "synthetic-client",
      credential_ref: "synthetic-credential",
      issued_at: 1,
      expires_at: 2,
      identity_class: :human,
      scopes: ["mixer.workspace.read"]
    }
  end

  defp controller(result, operation \\ :organizations) do
    Process.put(:synthetic_capture_result, result)

    conn = %Plug.Conn{
      adapter: CaptureAdapter.new(),
      owner: nil,
      method: "GET",
      request_path: if(operation == :organizations, do: "/v3/orgs", else: "/v3/projects"),
      query_string:
        if(operation == :organizations, do: "limit=100", else: "organization_id=org&limit=100"),
      assigns: %{verified_identity: synthetic_identity()},
      resp_headers: [{"x-request-id", String.duplicate("a", 32)}]
    }

    Controller.call(conn, Controller.init(operation: operation, facade: SyntheticTrustedFacade))
  after
    Process.delete(:synthetic_capture_result)
  end

  test "initial state, empty read and one captured iodata response contain no transport" do
    assert {CaptureAdapter, %{sends: 0} = state} = CaptureAdapter.new()
    assert CaptureAdapter.read_req_body(state, []) == {:ok, "", state}
    headers = [{"content-type", "application/json; charset=utf-8"}]

    assert {:ok, "{}", captured} = CaptureAdapter.send_resp(state, 200, headers, ["{", ?}])
    assert captured == %{sends: 1, status: 200, headers: headers, body: "{}"}
    assert CaptureAdapter.read_req_body(captured, length: 1) == {:ok, "", captured}
    assert CaptureAdapter.get_peer_data(state) == %{address: {0, 0, 0, 0}, port: 0, ssl_cert: nil}
    assert CaptureAdapter.get_sock_data(state) == %{address: {0, 0, 0, 0}, port: 0}
    assert CaptureAdapter.get_ssl_data(state) == nil
    assert CaptureAdapter.get_http_protocol(state) == :local_capture
  end

  test "binary and nested iodata body cap admits exactly its boundary" do
    {_, state} = CaptureAdapter.new()
    body = String.duplicate("x", 262_144)
    assert {:ok, ^body, _} = CaptureAdapter.send_resp(state, 200, [], body)

    assert {:ok, ^body, _} =
             CaptureAdapter.send_resp(state, 200, [], [
               binary_part(body, 0, 131_072),
               [binary_part(body, 131_072, 131_072)]
             ])

    for invalid <- [[body, "x"], [256], ["valid" | :invalid], :not_iodata] do
      assert_raise ArgumentError, "local response unavailable", fn ->
        CaptureAdapter.send_resp(state, 200, [], invalid)
      end
    end
  end

  test "second send and every unsupported response operation fail with a fixed reason" do
    {_, state} = CaptureAdapter.new()
    {:ok, _, captured} = CaptureAdapter.send_resp(state, 200, [], "{}")

    for callback <- [
          fn -> CaptureAdapter.send_resp(captured, 200, [], "private-marker") end,
          fn -> CaptureAdapter.send_file(state, 200, [], "/private-missing-file", 0, :all) end,
          fn -> CaptureAdapter.send_chunked(state, 200, []) end,
          fn -> CaptureAdapter.chunk(state, "private-marker") end,
          fn -> CaptureAdapter.upgrade(state, :private_protocol, :private_options) end,
          fn -> CaptureAdapter.inform(state, 103, []) end,
          fn -> CaptureAdapter.push(state, "/private-path", []) end
        ] do
      assert_raise ArgumentError, "local response unavailable", callback
    end
  end

  test "ordinary Plug send with owner nil preserves preexisting caller mailbox" do
    send(self(), {:plug_conn, :sent})
    send(self(), {:synthetic_capture_mailbox, :preserved})
    {:messages, before} = Process.info(self(), :messages)
    conn = Plug.Conn.send_resp(%Plug.Conn{adapter: CaptureAdapter.new(), owner: nil}, 200, "{}")
    assert conn.state == :sent
    assert Process.info(self(), :messages) == {:messages, before}
    assert_receive {:plug_conn, :sent}
    assert_receive {:synthetic_capture_mailbox, :preserved}
    refute_receive {:plug_conn, :sent}, 0
  end

  test "canonical controller accepts synthetic 65 and 100 row pages without a second decoder" do
    for count <- [65, 100] do
      rows =
        for n <- 1..count,
            do: %{
              id: "org-" <> String.pad_leading(Integer.to_string(n), 3, "0"),
              display_name: nil,
              organization_roles: []
            }

      page = %{organizations: rows, next_cursor: nil}
      conn = controller({:ok, page})
      assert conn.status == 200 and conn.state == :sent
      assert conn.resp_body == Jason.encode!(page)
      assert {CaptureAdapter, %{sends: 1, body: body}} = conn.adapter
      assert body == conn.resp_body
      assert length(Jason.decode!(body)["organizations"]) == count
      assert MixerHosted.Identity.BoundedJSON.object(body, 262_144) == :error
    end
  end

  test "canonical controller accepts a synthetic project page and rejects invalid rows" do
    row = %{organization_id: "org", id: "project", display_name: "Project", roles: ["viewer"]}
    page = %{projects: [row], next_cursor: nil}
    conn = controller({:ok, page}, :projects)
    assert conn.status == 200
    assert conn.resp_body == Jason.encode!(page)

    for invalid <- [
          Map.put(row, :organization_id, "other"),
          Map.put(row, :roles, []),
          Map.put(row, :secret, "private-marker")
        ] do
      conn = controller({:ok, %{projects: [invalid], next_cursor: nil}}, :projects)
      assert conn.status == 503 and conn.state == :sent
      refute conn.resp_body =~ "private-marker"
      assert Plug.Conn.get_resp_header(conn, "retry-after") == ["1"]
    end
  end

  test "canonical controller denials keep fixed redacted bodies and headers" do
    for {reason, status} <- [
          {:unauthenticated, 401},
          {:permission_denied, 403},
          {:not_found, 404},
          {:invalid_request, 400},
          {:authorization_unavailable, 503}
        ] do
      conn = controller({:error, reason})
      assert conn.status == status and conn.state == :sent
      assert Plug.Conn.get_resp_header(conn, "cache-control") == ["no-store"]

      assert Plug.Conn.get_resp_header(conn, "content-type") == [
               "application/json; charset=utf-8"
             ]

      assert Plug.Conn.get_resp_header(conn, "x-request-id") == [String.duplicate("a", 32)]
      assert byte_size(conn.resp_body) < 512
    end
  end
end

a4ffcfc78aeac9eb1c0a17e848d909c54751c8c1 blob 5465
defmodule MixerHostedWeb.BrowserWorkspaceDispatcherRequestTest do
  use ExUnit.Case, async: true
  alias MixerHosted.CustomerWorkspace.Input
  alias MixerHosted.Identity.VerifiedIdentity
  alias MixerHostedWeb.BrowserWorkspaceDispatcher.{CaptureAdapter, Request}
  alias MixerHostedWeb.Plugs.CustomerWorkspaceRequest

  defmodule Page do
    defstruct limit: 50, cursor: nil
  end

  # Deliberately synthetic trusted transport fixture; no token was verified and
  # no identity owner or ordinary Repo authorization is exercised by these tests.
  defp synthetic_identity do
    %VerifiedIdentity{
      profile_id: "synthetic-profile",
      profile_version: 1,
      issuer: "https://synthetic.invalid",
      subject: "synthetic-subject",
      client_id: "synthetic-client",
      credential_ref: "synthetic-credential",
      issued_at: 1,
      expires_at: 2,
      identity_class: :human,
      scopes: ["mixer.workspace.read"]
    }
  end

  defp admit(request) do
    conn = %Plug.Conn{
      adapter: CaptureAdapter.new(),
      request_path: request.path,
      method: "GET",
      query_string: request.query,
      assigns: %{verified_identity: synthetic_identity()},
      resp_headers: [{"x-request-id", String.duplicate("a", 32)}]
    }

    CustomerWorkspaceRequest.call(conn, CustomerWorkspaceRequest.init(request.operation))
  end

  test "fixed organization path and decimal limit include both bounds and large page sizes" do
    for limit <- [1, 65, 100] do
      assert {:ok, %{operation: :organizations, path: "/v3/orgs", query: query} = request} =
               Request.new({:organizations, %{limit: limit, cursor: nil}})

      assert query == "limit=#{limit}"
      conn = admit(request)
      refute conn.halted

      assert conn.assigns.customer_workspace_request == %{
               organization_id: nil,
               page: %{limit: limit, cursor: nil}
             }
    end
  end

  test "exact hostile IDs are encoded once and roundtrip through canonical request admission" do
    for organization <- [" ", " org ", "a+b&c=d%2F?#/", "租户 café", String.duplicate("z", 128)] do
      cursor = Input.cursor("projects", organization, " after+&%/租 ")

      assert {:ok, request} =
               Request.new({:projects, organization, %{limit: 100, cursor: cursor}})

      assert request == %{
               operation: :projects,
               path: "/v3/projects",
               query:
                 "organization_id=" <>
                   URI.encode_www_form(organization) <>
                   "&limit=100&cursor=" <> URI.encode_www_form(cursor)
             }

      assert byte_size(request.query) <= 8_192
      conn = admit(request)
      refute conn.halted

      assert conn.assigns.customer_workspace_request == %{
               organization_id: organization,
               page: %{limit: 100, cursor: cursor}
             }
    end
  end

  test "canonical organization cursor is serialized unchanged and decoded again by transport" do
    cursor = Input.cursor("organizations", nil, "org+ &%/租")
    assert {:ok, request} = Request.new({:organizations, %{limit: 1, cursor: cursor}})
    assert request.query == "limit=1&cursor=" <> URI.encode_www_form(cursor)
    conn = admit(request)
    refute conn.halted
    assert conn.assigns.customer_workspace_request.page.cursor == cursor

    assert CustomerWorkspaceRequest.decode_cursor(cursor, :organizations, nil) ==
             {:ok, "org+ &%/租"}
  end

  test "request and page shapes are closed" do
    page = %{limit: 50, cursor: nil}

    for value <- [
          nil,
          :organizations,
          [:organizations, page],
          {:unknown, page},
          {:organizations, page, %{}},
          {:projects, page},
          {:organizations, %{limit: 50}},
          {:organizations, %{cursor: nil}},
          {:organizations, %{"limit" => 50, "cursor" => nil}},
          {:organizations, Map.put(page, :after, "org")},
          {:organizations, %Page{}},
          {:organizations, %{limit: 0, cursor: nil}},
          {:organizations, %{limit: 101, cursor: nil}},
          {:organizations, %{limit: 1.0, cursor: nil}},
          {:organizations, %{limit: "1", cursor: nil}},
          {:organizations, %{limit: 50, cursor: ""}},
          {:organizations, %{limit: 50, cursor: "not-canonical"}},
          {:organizations, %{limit: 50, cursor: String.duplicate("x", 1401)}}
        ] do
      assert Request.new(value) == {:error, :invalid_request}
    end
  end

  test "organization identifiers reject invalid bytes without normalization" do
    for organization <- [
          nil,
          :org,
          "",
          "*",
          "line\nfeed",
          <<0>>,
          <<255>>,
          String.duplicate("x", 129)
        ] do
      assert Request.new({:projects, organization, %{limit: 50, cursor: nil}}) ==
               {:error, :invalid_request}
    end
  end

  test "cursor cannot cross an operation or exact organization" do
    organizations = Input.cursor("organizations", nil, "after")
    projects = Input.cursor("projects", "org", "after")

    for value <- [
          {:projects, "org", %{limit: 50, cursor: organizations}},
          {:organizations, %{limit: 50, cursor: projects}},
          {:projects, "org ", %{limit: 50, cursor: projects}},
          {:projects, "other", %{limit: 50, cursor: projects}}
        ] do
      assert Request.new(value) == {:error, :invalid_request}
    end
  end
end

