defmodule MixerHosted.Authorization.TransactionFixture.Admin do
  use Ecto.Repo, otp_app: :mixer_transaction_fixture, adapter: Ecto.Adapters.Postgres
end

defmodule MixerHosted.Authorization.TransactionFixture.Migration do
  use Ecto.Repo, otp_app: :mixer_transaction_fixture, adapter: Ecto.Adapters.Postgres
end

defmodule MixerHosted.Authorization.TransactionFixture.Runtime do
  use Ecto.Repo, otp_app: :mixer_transaction_fixture, adapter: Ecto.Adapters.Postgres
end

defmodule MixerHosted.Authorization.TransactionFixture.Foreign do
  use Ecto.Repo, otp_app: :mixer_transaction_fixture, adapter: Ecto.Adapters.Postgres
end

defmodule MixerHosted.Authorization.TransactionFixture do
  alias MixerHosted.Authorization
  alias MixerHosted.Authorization.Scope
  alias MixerHosted.Authorization.TransactionFixture.{Admin, Runtime}
  alias MixerHosted.Identity.VerifiedIdentity

  @tables ~w(profiles principals bindings families credentials organizations projects applications environments organization_heads project_heads memberships)
  @locks ~w(profiles principals families credentials organization_heads project_heads)
  def tables, do: @tables
  def locks, do: @locks
  def sql(sql, params \\ []), do: Ecto.Adapters.SQL.query!(Admin, sql, params, log: false)

  def runtime_sql(sql, params \\ []),
    do: Ecto.Adapters.SQL.query!(Runtime, sql, params, log: false)

  def now, do: System.system_time(:second)

  def identity(changes \\ %{}) do
    struct!(
      VerifiedIdentity,
      Map.merge(
        %{
          profile_id: "profile",
          profile_version: 1,
          issuer: "https://issuer.example",
          subject: "subject",
          client_id: "client",
          credential_ref: "token",
          issued_at: now() - 20,
          expires_at: now() + 600,
          identity_class: :human,
          scopes: ["mixer.artifact.read", "mixer.artifact.upload", "mixer.audit.read"]
        },
        changes
      )
    )
  end

  def target(changes \\ %{}) do
    struct!(
      Scope,
      Map.merge(
        %{
          organization_id: "org",
          project_id: "project",
          application_id: "app",
          environment_id: "env"
        },
        changes
      )
    )
  end

  def run(
        callback \\ fn _ -> {:ok, :accepted} end,
        i \\ identity(),
        a \\ "artifact.read",
        t \\ target(),
        repo \\ Runtime
      ),
      do: Authorization.with_authorized_transaction(i, a, t, callback, repo)

  def seed! do
    sql(
      "TRUNCATE " <>
        Enum.map_join(Enum.reverse(@tables), ",", &("public.mixer_authz_" <> &1)) <> " CASCADE"
    )

    sql("TRUNCATE public.transaction_probe")

    sql(
      "INSERT INTO public.mixer_authz_profiles(id,version,issuer,client_id,identity_class,active) VALUES ('profile',1,'https://issuer.example','client','human',true)"
    )

    sql("INSERT INTO public.mixer_authz_principals VALUES ('person','human',true,0,2)")

    sql(
      "INSERT INTO public.mixer_authz_bindings(profile_id,profile_version,subject,identity_class,principal_id,active) VALUES ('profile',1,'subject','human','person',true)"
    )

    sql(
      "INSERT INTO public.mixer_authz_families VALUES ('family','profile',1,'person',true,0,NULL,3)"
    )

    sql(
      "INSERT INTO public.mixer_authz_credentials VALUES ('profile',1,'token','person','family',true,0,NULL,4)"
    )

    sql("INSERT INTO public.mixer_authz_organizations VALUES ('org',true)")
    sql("INSERT INTO public.mixer_authz_projects VALUES ('org','project',true)")
    sql("INSERT INTO public.mixer_authz_applications VALUES ('org','project','app',true)")
    sql("INSERT INTO public.mixer_authz_environments VALUES ('org','project','app','env',true)")
    sql("INSERT INTO public.mixer_authz_organization_heads VALUES ('org',5)")
    sql("INSERT INTO public.mixer_authz_project_heads VALUES ('org','project',6)")

    sql(
      "INSERT INTO public.mixer_authz_memberships VALUES ('member','person','org','project','exact_project','developer',true,0,NULL,7)"
    )

    :ok
  end

  def probe!, do: runtime_sql("INSERT INTO public.transaction_probe(id) VALUES ('written')")
  def empty_probe?, do: sql("SELECT count(*) FROM public.transaction_probe").rows == [[0]]

  def clean? do
    not MixerHosted.Authorization.Transaction.Context.active?() and
      runtime_sql("SELECT coalesce(current_setting('mixer.authz.transaction_marker',true),'')").rows ==
        [[""]] and
      runtime_sql("SELECT count(*) FROM public.mixer_authz_credentials").rows == [[0]]
  end

  def await_expiry(i) do
    remaining = max(0, i.expires_at * 1_000 - System.system_time(:millisecond) + 10)
    Process.sleep(remaining)
  end

  def edge! do
    # Begin near the next wall-clock second so expiry during a sub-500ms lock
    # wait is deterministic without changing the production clock seam.
    delay = Integer.mod(820 - Integer.mod(System.system_time(:millisecond), 1_000), 1_000)
    Process.sleep(delay)
  end
end

defmodule MixerHosted.Authorization.TransactionTest do
  use ExUnit.Case, async: false
  @moduletag :customer_transaction_db
  alias MixerHosted.Authorization
  alias MixerHosted.Authorization.Transaction.{Context, Snapshot}
  alias MixerHosted.Authorization.TransactionFixture, as: F
  alias MixerHosted.Authorization.TransactionFixture.{Admin, Migration, Runtime, Foreign}

  setup_all do
    settings = [
      hostname: "127.0.0.1",
      port: String.to_integer(System.fetch_env!("MIXER_TRANSACTION_TEST_PORT")),
      database: "mixer_customer_transaction",
      ssl: false,
      log: false
    ]

    start_supervised!({Admin, settings ++ [username: "txn_fixture_admin", pool_size: 4]})

    start_supervised!(
      {Migration,
       settings ++
         [
           username: "txn_fixture_admin",
           pool_size: 2,
           after_connect: fn conn -> Postgrex.query!(conn, "SET ROLE txn_authz_owner", []) end
         ]}
    )

    start_supervised!({Runtime, settings ++ [username: "txn_authz_runtime", pool_size: 2]})
    start_supervised!({Foreign, settings ++ [username: "txn_authz_runtime", pool_size: 1]})

    for {module, file} <- [
          {MixerHosted.Repo.Migrations.AddCustomerAuthorization,
           "20261025000003_add_customer_authorization.exs"},
          {MixerHosted.Repo.Migrations.AddAuthorizationStateRevisions,
           "20261025000004_add_authorization_state_revisions.exs"}
        ] do
      unless Code.ensure_loaded?(module) do
        Code.require_file(Path.expand("../../../priv/repo/migrations/" <> file, __DIR__))
      end
    end

    assert :ok =
             Ecto.Migrator.up(
               Migration,
               20_261_025_000_003,
               MixerHosted.Repo.Migrations.AddCustomerAuthorization,
               log: false
             )

    assert :ok =
             Ecto.Migrator.up(
               Migration,
               20_261_025_000_004,
               MixerHosted.Repo.Migrations.AddAuthorizationStateRevisions,
               log: false
             )

    assert :already_up =
             Ecto.Migrator.up(
               Migration,
               20_261_025_000_004,
               MixerHosted.Repo.Migrations.AddAuthorizationStateRevisions,
               log: false
             )

    for table <- F.tables(),
        do: F.sql("GRANT SELECT ON public.mixer_authz_#{table} TO txn_authz_runtime")

    for table <- F.locks(),
        do:
          F.sql(
            "GRANT EXECUTE ON FUNCTION public.mixer_authz_lock_#{table}() TO txn_authz_runtime"
          )

    F.sql("CREATE TABLE public.transaction_probe(id text NOT NULL)")
    F.sql("GRANT SELECT,INSERT ON public.transaction_probe TO txn_authz_runtime")
    :ok
  end

  setup do
    F.seed!()
    on_exit(fn -> assert F.clean?() end)
    :ok
  end

  test "owned local SQL transaction commits complete bounded snapshot and never accepts a pure decision" do
    i = F.identity()

    assert {:ok, snapshot} =
             F.run(
               fn ctx ->
                 assert Runtime.in_transaction?()

                 snapshot =
                   Context.effect!(ctx, Runtime, "artifact.read", F.target(), fn fresh ->
                     F.probe!()
                     fresh
                   end)

                 assert snapshot.profile.state_revision == 1
                 assert snapshot.binding.revision == 1
                 assert snapshot.principal.revision == 2
                 assert snapshot.family.revision == 3
                 assert snapshot.credential.revision == 4
                 assert snapshot.family.id == snapshot.credential.family_id
                 assert [member] = snapshot.memberships
                 assert member.revision == 7 and member.role == "developer"

                 assert snapshot.organization_head.revision == 5 and
                          snapshot.project_head.revision == 6

                 assert snapshot.identity.issued_at == i.issued_at
                 assert snapshot.identity.expires_at == i.expires_at
                 assert byte_size(snapshot.request_id) == 32
                 assert byte_size(snapshot.binding.subject_digest) == 64
                 refute Map.has_key?(snapshot.identity, :subject)
                 assert ctx.snapshot.request_id == snapshot.request_id
                 {:ok, snapshot}
               end,
               i
             )

    assert [["written"]] == F.sql("SELECT id FROM public.transaction_probe").rows
    assert snapshot.action == "artifact.read"

    assert_raise Context.Invalid, fn ->
      Context.checkpoint!(
        struct(MixerHosted.Authorization.Policy.Decision),
        Runtime,
        "artifact.read",
        F.target()
      )
    end
  end

  test "all roles retain their exact action ceilings and audit requires project-only scope" do
    for role <- ~w(owner administrator developer release_manager billing_manager viewer),
        action <- ~w(artifact.read artifact.upload audit.read) do
      F.sql("UPDATE public.mixer_authz_memberships SET role=$1", [role])

      target =
        if action == "audit.read",
          do: F.target(%{application_id: nil, environment_id: nil}),
          else: F.target()

      allowed =
        if action == "artifact.upload",
          do: role in ~w(owner administrator developer),
          else: role != "billing_manager"

      expected = if allowed, do: {:ok, :accepted}, else: {:error, :permission_denied}
      assert expected == F.run(fn _ -> {:ok, :accepted} end, F.identity(), action, target)
    end

    assert {:error, :invalid_request} = F.run(fn _ -> flunk() end, F.identity(), "audit.read")
  end

  test "identity-only preparation clears tenant and directory selection without artifact authority" do
    identity = F.identity()

    settings = ~w(organization_id project_id application_id environment_id directory_mode)

    assert {:ok, linkage} =
             Runtime.checkout(fn ->
               for key <- settings do
                 F.runtime_sql("SELECT set_config($1,'inherited',false)", ["mixer.authz." <> key])
               end

               try do
                 Runtime.transaction(fn ->
                   linkage =
                     MixerHosted.Authorization.Postgres.Session.prepare_identity!(
                       Runtime,
                       MixerHosted.Authorization.Policy.identity_key(identity)
                     )

                   assert [["", "", "", "", ""]] =
                            F.runtime_sql("""
                            SELECT current_setting('mixer.authz.organization_id'),
                              current_setting('mixer.authz.project_id'),
                              current_setting('mixer.authz.application_id'),
                              current_setting('mixer.authz.environment_id'),
                              current_setting('mixer.authz.directory_mode')
                            """).rows

                   refute Context.active?()

                   assert [] ==
                            F.runtime_sql("SELECT id FROM public.mixer_authz_organizations").rows

                   linkage
                 end)
               after
                 for key <- settings do
                   F.runtime_sql("SELECT set_config($1,'',false)", ["mixer.authz." <> key])
                 end
               end
             end)

    assert linkage.principal_id == "person"
    assert linkage.family_id == "family"
  end

  test "changing directory mode invalidates artifact context and rolls back prior effects" do
    for mode <- ["organizations", "projects"] do
      assert {:error, :authorization_unavailable} =
               F.run(fn ctx ->
                 Context.effect!(ctx, Runtime, "artifact.read", F.target(), fn _ -> F.probe!() end)

                 F.runtime_sql("SELECT set_config('mixer.authz.directory_mode',$1,true)", [mode])
                 {:ok, :must_not_commit}
               end)

      assert [] == F.sql("SELECT id FROM public.transaction_probe").rows
    end
  end

  test "invalid identity action target and nested invocation fail before a callback" do
    for {i, a, t} <- [
          {nil, "artifact.read", F.target()},
          {F.identity(), "publish", F.target()},
          {F.identity(), "artifact.read", %{organization_id: "org"}}
        ] do
      assert {:error, _} =
               Authorization.with_authorized_transaction(
                 i,
                 a,
                 t,
                 fn _ -> flunk() end,
                 MissingTransactionRepo
               )
    end

    assert {:ok, {:error, :authorization_unavailable}} =
             Runtime.transaction(fn -> F.run(fn _ -> flunk() end) end)

    assert {:ok, :outer} =
             F.run(fn _ ->
               assert {:error, :authorization_unavailable} = F.run(fn _ -> flunk() end)
               {:ok, :outer}
             end)
  end

  test "context rejects every changed field and latches rescued rollback attempts" do
    assert {:ok, original} = F.run(fn ctx -> {:ok, ctx} end)

    assert_raise Context.Invalid, fn ->
      Context.checkpoint!(original, Runtime, "artifact.read", F.target())
    end

    changes = [
      owner: self(),
      repo: Foreign,
      dynamic_repo: Foreign,
      connection: [],
      marker: "forged",
      identity: F.identity(%{subject: "forged"}),
      action: "artifact.upload",
      target: F.target(%{environment_id: "forged"}),
      snapshot: %{},
      admitted_at: 0,
      deadline: 0
    ]

    for {field, value} <- changes do
      assert {:error, :authorization_unavailable} =
               F.run(fn ctx ->
                 changed =
                   if field == :owner,
                     do: %{ctx | owner: spawn(fn -> :ok end)},
                     else: Map.put(ctx, field, value)

                 try do
                   Context.checkpoint!(changed, Runtime, "artifact.read", F.target())
                 catch
                   _, _ -> :caught
                 end

                 F.probe!()
                 {:ok, :rescued}
               end)

      assert F.empty_probe?()
    end

    assert {:error, :authorization_unavailable} =
             F.run(fn ctx ->
               try do
                 Context.checkpoint!(
                   Map.put(ctx, :role, "owner"),
                   Runtime,
                   "artifact.read",
                   F.target()
                 )
               catch
                 _, _ -> :caught
               end

               {:ok, :rescued}
             end)
  end

  test "wrong process foreign repo action target transaction marker and identity GUC reject" do
    assert {:ok, :owner} =
             F.run(fn ctx ->
               assert :rejected =
                        Task.async(fn ->
                          assert_raise Context.Invalid, fn ->
                            Context.checkpoint!(ctx, Runtime, "artifact.read", F.target())
                          end

                          :rejected
                        end)
                        |> Task.await()

               {:ok, :owner}
             end)

    for attempt <- [
          fn ctx -> Context.checkpoint!(ctx, Foreign, "artifact.read", F.target()) end,
          fn ctx -> Context.checkpoint!(ctx, Runtime, "artifact.upload", F.target()) end,
          fn ctx ->
            Context.checkpoint!(
              ctx,
              Runtime,
              "artifact.read",
              F.target(%{environment_id: "other"})
            )
          end,
          fn ctx ->
            F.runtime_sql("SELECT set_config('mixer.authz.transaction_marker','replaced',true)")
            Context.checkpoint!(ctx, Runtime, "artifact.read", F.target())
          end,
          fn ctx ->
            F.runtime_sql("SELECT set_config('mixer.authz.subject','replaced',true)")
            Context.checkpoint!(ctx, Runtime, "artifact.read", F.target())
          end
        ] do
      assert {:error, :authorization_unavailable} =
               F.run(fn ctx ->
                 attempt.(ctx)
                 {:ok, :unexpected}
               end)
    end

    assert {:error, :authorization_unavailable} =
             F.run(fn ctx ->
               previous = Runtime.put_dynamic_repo(Foreign)

               try do
                 Context.checkpoint!(ctx, Runtime, "artifact.read", F.target())
               after
                 Runtime.put_dynamic_repo(previous)
               end

               {:ok, :unexpected}
             end)
  end

  test "after rollback and another real transaction cannot reuse a captured context" do
    parent = self()

    assert {:error, :conflict} =
             F.run(fn ctx ->
               send(parent, {:old_context, ctx})
               {:error, :conflict}
             end)

    assert_receive {:old_context, old}

    assert_raise Context.Invalid, fn ->
      Context.checkpoint!(old, Runtime, "artifact.read", F.target())
    end

    assert {:error, :authorization_unavailable} =
             F.run(fn _ ->
               Context.checkpoint!(old, Runtime, "artifact.read", F.target())
               {:ok, :unexpected}
             end)

    assert {:ok, :accepted} = F.run()
  end

  test "every callback error malformed value exception throw and exit rolls back actual local SQL" do
    callbacks = [
      fn _ -> {:error, :conflict} end,
      fn _ -> {:error, :storage_unavailable} end,
      fn _ -> {:error, :secret_unbounded_reason} end,
      fn _ -> :ok end,
      fn _ -> {:ok, :x, :extra} end,
      fn _ -> raise "synthetic failure" end,
      fn _ -> throw(:synthetic_failure) end,
      fn _ -> exit(:synthetic_failure) end,
      fn _ -> Runtime.rollback(:authorization_unavailable) end
    ]

    for callback <- callbacks do
      assert {:error, _} =
               F.run(fn ctx ->
                 F.probe!()
                 callback.(ctx)
               end)

      assert F.empty_probe?()
      assert F.clean?()
    end

    assert {:ok, :accepted} = F.run()
  end

  test "failed effects latch rollback even when outer callbacks catch and return success" do
    effects = [
      fn -> raise "synthetic effect failure" end,
      fn -> throw(:synthetic_effect_failure) end,
      fn -> exit(:synthetic_effect_failure) end,
      fn -> {:error, :conflict} end,
      fn -> {:error, :storage_unavailable} end,
      fn -> {:error, :unknown_effect_reason} end
    ]

    for effect <- effects do
      assert {:error, :authorization_unavailable} =
               F.run(fn ctx ->
                 try do
                   Context.effect!(ctx, Runtime, "artifact.read", F.target(), fn _ ->
                     F.probe!()
                     effect.()
                   end)
                 rescue
                   _ -> :caught
                 catch
                   _, _ -> :caught
                 end

                 {:ok, :caught_and_would_commit}
               end)

      assert F.empty_probe?()
      assert F.clean?()
    end

    assert {:error, :conflict} =
             F.run(fn ctx ->
               Context.effect!(ctx, Runtime, "artifact.read", F.target(), fn _ ->
                 F.probe!()
                 {:error, :conflict}
               end)

               {:ok, :would_commit}
             end)

    assert F.empty_probe?()
  end

  test "expiry before effect blocks effect and final expiry rolls back an earlier local SQL write" do
    i = F.identity(%{expires_at: F.now() + 1})

    assert {:error, :unauthenticated} =
             F.run(
               fn ctx ->
                 F.await_expiry(i)

                 Context.effect!(ctx, Runtime, "artifact.read", F.target(), fn _ ->
                   flunk("expired effect")
                 end)

                 {:ok, :unexpected}
               end,
               i
             )

    assert F.empty_probe?()
    i = F.identity(%{expires_at: F.now() + 1})

    assert {:error, :unauthenticated} =
             F.run(
               fn ctx ->
                 Context.effect!(ctx, Runtime, "artifact.read", F.target(), fn _ -> F.probe!() end)

                 F.await_expiry(i)
                 {:ok, :would_commit}
               end,
               i
             )

    assert F.empty_probe?()
  end

  test "fresh time after an actual profile lock wait rejects a token expired during that wait" do
    parent = self()

    writer =
      Task.async(fn ->
        Admin.transaction(fn ->
          F.sql("SELECT 1 FROM public.mixer_authz_profiles FOR UPDATE")
          send(parent, {:locked, self()})

          receive do
            :release -> :ok
          after
            2_000 -> flunk("writer release timeout")
          end
        end)
      end)

    assert_receive {:locked, writer_pid}
    F.edge!()
    i = F.identity(%{expires_at: F.now() + 1})

    authorization =
      Task.async(fn ->
        Runtime.checkout(fn ->
          [[backend]] = F.runtime_sql("SELECT pg_backend_pid()").rows
          send(parent, {:authorization_backend, backend})
          F.run(fn _ -> flunk("expired callback") end, i)
        end)
      end)

    assert_receive {:authorization_backend, backend}

    blocked =
      Enum.reduce_while(1..30, false, fn _, _ ->
        if F.sql("SELECT wait_event_type='Lock' FROM pg_stat_activity WHERE pid=$1", [backend]).rows ==
             [[true]] do
          {:halt, true}
        else
          Process.sleep(3)
          {:cont, false}
        end
      end)

    assert blocked, "authorization must observably wait on the actual row lock"
    F.await_expiry(i)
    send(writer_pid, :release)
    assert {:ok, :ok} = Task.await(writer)
    assert {:error, :unauthenticated} = Task.await(authorization)
    assert F.empty_probe?()
  end

  test "separate family token membership windows and profile binding state are retained and enforced" do
    for table <- ~w(profiles bindings principals families credentials) do
      F.sql("UPDATE public.mixer_authz_#{table} SET active=false")
      assert {:error, :unauthenticated} = F.run()
      F.sql("UPDATE public.mixer_authz_#{table} SET active=true")
    end

    for table <- ~w(families credentials) do
      F.sql("UPDATE public.mixer_authz_#{table} SET not_before=$1", [F.now() - 10])
      assert {:error, :unauthenticated} = F.run()
      F.sql("UPDATE public.mixer_authz_#{table} SET not_before=0,expires_at=$1", [F.now()])
      assert {:error, :unauthenticated} = F.run()
      F.sql("UPDATE public.mixer_authz_#{table} SET expires_at=NULL")
    end

    F.sql("UPDATE public.mixer_authz_memberships SET expires_at=$1", [F.now() + 1])

    assert {:error, _} =
             F.run(fn ctx ->
               Process.sleep(1_100)
               Context.checkpoint!(ctx, Runtime, "artifact.read", F.target())
               {:ok, :unexpected}
             end)
  end

  test "snapshot validation independently rejects extra missing changed nested and oversized data" do
    i = F.identity()

    assert {:ok, {s, d}} =
             F.run(
               fn ctx ->
                 # Policy is used here solely to independently exercise the closed data
                 # projection validator; the returned Decision is never domain authority.
                 e =
                   MixerHosted.Authorization.Postgres.Evidence.load!(
                     Runtime,
                     %{
                       identity: MixerHosted.Authorization.Policy.identity_key(i),
                       action: "artifact.read",
                       target: F.target()
                     },
                     %{principal_id: "person", family_id: "family"}
                   )

                 {:ok, d} =
                   MixerHosted.Authorization.Policy.evaluate(
                     i,
                     "artifact.read",
                     F.target(),
                     e,
                     ctx.snapshot.checked_at
                   )

                 {:ok, {ctx.snapshot, d}}
               end,
               i
             )

    assert Snapshot.valid?(s, i, d)

    for bad <- [
          Map.put(s, :extra, true),
          Map.delete(s, :family),
          put_in(s, [:profile, :state_revision], 0),
          put_in(s, [:binding, :subject_digest], "bad"),
          put_in(s, [:family, :id], "wrong"),
          put_in(s, [:family, :revision], 0),
          put_in(s, [:credential, :family_id], "wrong"),
          put_in(s, [:identity, :expires_at], 0),
          put_in(s, [:organization_head, :revision], 0),
          Map.put(s, :memberships, List.duplicate(hd(s.memberships), 65)),
          Map.put(s, :memberships, [hd(s.memberships) | :improper]),
          Map.put(s, :request_id, "unbounded"),
          put_in(s, [:profile, :extra], true)
        ] do
      refute Snapshot.valid?(bad, i, d)
    end
  end

  test "fresh snapshots select surviving membership rows without modifying the initial Context" do
    F.sql("UPDATE public.mixer_authz_memberships SET expires_at=$1", [F.now() + 1])

    F.sql(
      "INSERT INTO public.mixer_authz_memberships VALUES ('surviving','person','org','project','exact_project','viewer',true,0,NULL,8)"
    )

    assert {:ok, :survived} =
             F.run(fn ctx ->
               assert Enum.map(ctx.snapshot.memberships, & &1.id) == ["member", "surviving"]
               Process.sleep(1_100)
               fresh = Context.checkpoint!(ctx, Runtime, "artifact.read", F.target())
               assert Enum.map(fresh.memberships, & &1.id) == ["surviving"]
               assert Enum.map(ctx.snapshot.memberships, & &1.id) == ["member", "surviving"]
               {:ok, :survived}
             end)
  end

  test "monotonic full-transaction deadline rolls back SQL despite an otherwise unexpired identity" do
    assert {:error, :authorization_unavailable} =
             F.run(fn ctx ->
               Context.effect!(ctx, Runtime, "artifact.read", F.target(), fn _ -> F.probe!() end)
               Process.sleep(5_020)
               {:ok, :would_commit}
             end)

    assert F.empty_probe?()
  end

  test "wall-clock regression guard rejects below its last successful checkpoint and latches failure" do
    # Controlled state corruption exercises the regression path without changing
    # the host clock or introducing a caller-supplied production clock. It is not
    # evidence of an actual operating-system clock adjustment.
    assert {:error, :authorization_unavailable} =
             F.run(fn ctx ->
               key = {Context, :active}
               state = Process.get(key)
               Process.put(key, %{state | last_time: F.now() + 60})

               try do
                 Context.effect!(ctx, Runtime, "artifact.read", F.target(), fn _ ->
                   flunk("regressed clock effect")
                 end)
               catch
                 _, _ -> :caught
               end

               {:ok, :would_commit}
             end)

    assert F.empty_probe?()
  end

  test "lock timeout rejects before binding and leaves no context for connection reuse" do
    parent = self()

    writer =
      Task.async(fn ->
        Admin.transaction(fn ->
          F.sql("SELECT 1 FROM public.mixer_authz_profiles FOR UPDATE")
          send(parent, {:profile_held, self()})

          receive do
            :release -> :ok
          after
            2_000 -> flunk("writer release timeout")
          end
        end)
      end)

    assert_receive {:profile_held, writer_pid}
    started = System.monotonic_time(:millisecond)
    assert {:error, :authorization_unavailable} = F.run()
    elapsed = System.monotonic_time(:millisecond) - started
    assert elapsed >= 450 and elapsed < 1_500
    send(writer_pid, :release)
    assert {:ok, :ok} = Task.await(writer)
    assert F.clean?()
    assert {:ok, :accepted} = F.run()
  end

  test "new revision baseline is one and constraints reject zero negative or excessive revisions" do
    assert [[1]] = F.sql("SELECT state_revision FROM public.mixer_authz_profiles").rows
    assert [[1]] = F.sql("SELECT revision FROM public.mixer_authz_bindings").rows

    for {table, column} <- [{"profiles", "state_revision"}, {"bindings", "revision"}],
        value <- [0, -1, 9_007_199_254_740_992] do
      assert_raise Postgrex.Error, fn ->
        F.sql("UPDATE public.mixer_authz_#{table} SET #{column}=$1", [value])
      end
    end

    assert {:ok, :accepted} = F.run()
  end

  test "direct privileged owner DML and indirect predefined roles fail the owned transaction" do
    for repo <- [Admin, Migration],
        do:
          assert(
            {:error, :authorization_unavailable} =
              F.run(fn _ -> flunk() end, F.identity(), "artifact.read", F.target(), repo)
          )

    for grant <- [
          "GRANT txn_authz_owner TO txn_authz_runtime",
          "GRANT UPDATE(active) ON public.mixer_authz_principals TO txn_authz_runtime"
        ] do
      F.sql(grant)

      try do
        assert {:error, :authorization_unavailable} = F.run()
      after
        if String.starts_with?(grant, "GRANT txn"),
          do: F.sql("REVOKE txn_authz_owner FROM txn_authz_runtime"),
          else:
            F.sql("REVOKE UPDATE(active) ON public.mixer_authz_principals FROM txn_authz_runtime")
      end
    end

    for [role] <-
          F.sql(
            "SELECT rolname::text FROM pg_roles WHERE substr(rolname::text,1,3)='pg_' AND rolname <> 'pg_database_owner' ORDER BY rolname"
          ).rows do
      F.sql("GRANT #{role} TO txn_authz_runtime")

      try do
        assert {:error, :authorization_unavailable} = F.run()
      after
        F.sql("REVOKE #{role} FROM txn_authz_runtime")
      end
    end

    F.sql("CREATE ROLE txn_indirect NOLOGIN NOINHERIT")
    F.sql("GRANT txn_indirect TO txn_authz_runtime WITH INHERIT FALSE, SET TRUE")

    try do
      assert {:ok, :accepted} = F.run()

      for role <-
            ~w(pg_read_server_files pg_write_server_files pg_execute_server_program pg_monitor) do
        F.sql("GRANT #{role} TO txn_indirect WITH INHERIT FALSE, SET TRUE")

        try do
          assert {:error, :authorization_unavailable} = F.run()
        after
          F.sql("REVOKE #{role} FROM txn_indirect")
        end
      end
    after
      F.sql("REVOKE txn_indirect FROM txn_authz_runtime")
      F.sql("DROP ROLE txn_indirect")
    end

    assert {:ok, :accepted} = F.run()
  end
end

3eab7786ac575afac514519e0a582c30b88f2571 blob 4874
defmodule MixerHosted.Billing.RawWebhookCaptureHTTP2Test do
  use ExUnit.Case, async: false
  alias MixerHosted.HTTP2WireFixture, as: F
  @moduletag timeout: 26_000
  @cap 1_048_576

  setup_all do
    # One shared deadline covers all five methods/seven subcases, including teardown.
    %{http2_budget: F.budget()}
  end

  test "B1 actual HTTP/2 batching can return more than the requested 32 KiB", context do
    F.run(context.http2_budget, "B1-batching", :capture, fn ->
      body = body(40_001)
      prefix = for n <- 0..31, do: {binary_part(body, n, 1), false}

      tail = [
        {binary_part(body, 32, 16_384), false},
        {binary_part(body, 16_416, 16_384), false},
        {binary_part(body, 32_800, 7_201), true}
      ]

      F.send_data(prefix ++ tail)
      F.fence()
      F.release()
      result = F.result()
      assert_capture(result, body)
      oversized = Enum.any?(F.reads(), &(&1.bytes > 32_768))
      assert oversized, "the mandatory real over-target batching witness was not observed"
      assert_reads(32_768)
      assert F.bytes_sent() == 40_001
      F.fence()
    end)
  end

  test "B2 paced no-length HTTP/2 input admits exactly the application byte cap", context do
    F.run(context.http2_budget, "B2-exact-cap", :capture, fn ->
      body = body(@cap)
      F.release()
      paced(body, 32, true)
      result = F.result()
      assert_capture(result, body)
      assert F.bytes_sent() == @cap
      assert length(F.reads()) == 32
      assert Enum.all?(F.reads(), &(&1.bytes == 32_768))
      assert List.last(F.reads()).tag == :ok
      assert_reads(32_768)
      F.fence()
    end)
  end

  test "B3 a sent cap-plus-one input is refused and its halted stream is disposed", context do
    F.run(context.http2_budget, "B3-cap-plus-one", :capture, fn ->
      body = body(@cap + 1)
      F.release()
      paced(body, 31, false)
      offset = 31 * 32_768

      F.send_data([
        {binary_part(body, offset, 16_384), false},
        {binary_part(body, offset + 16_384, 16_384), false},
        {binary_part(body, @cap, 1), true}
      ])

      result = F.result()
      assert result.kind == :capture and result.tag == :error
      assert result.reason == :too_large and result.halted
      refute Map.has_key?(result, :body)
      assert F.bytes_sent() == @cap + 1
      assert_reads(32_768)
      # This can refuse at a nonterminal cap; it need not consume the final extra byte.
      F.fence()
    end)
  end

  test "D1 nonprogress controls preserve the package public read deadline", context do
    for profile <- [:settings, :window_update] do
      F.run(context.http2_budget, "D1-#{profile}", :package_read, fn ->
        result = F.nonprogress(profile)
        assert result.kind == :package_read and result.tag == :more
        assert result.bytes == 0
        refute result.halted
        assert [%{tag: :more, bytes: 0, length: 32_768, read_timeout: 1_000}] = F.reads()
      end)
    end
  end

  test "D2 Mixer refuses the timed public empty-more result as no_progress", context do
    for profile <- [:settings, :window_update] do
      F.run(context.http2_budget, "D2-#{profile}", :capture, fn ->
        result = F.nonprogress(profile)
        assert result.kind == :capture and result.tag == :error
        assert result.reason == :no_progress and result.halted
        refute Map.has_key?(result, :body)
        assert [%{tag: :more, bytes: 0, length: 32_768, read_timeout: 1_000}] = F.reads()
        # The one-second public read and Mixer's five-second admission deadline differ.
      end)
    end
  end

  defp paced(body, count, end_last) do
    for index <- 1..count do
      offset = (index - 1) * 32_768

      F.send_data([
        {binary_part(body, offset, 16_384), false},
        {binary_part(body, offset + 16_384, 16_384), end_last and index == count}
      ])

      read = F.wait_reads(index)
      assert read.bytes == 32_768
      assert read.tag == if(end_last and index == count, do: :ok, else: :more)
    end
  end

  defp assert_capture(result, expected) do
    assert result.kind == :capture and result.tag == :ok
    refute result.halted
    assert result.elapsed < 5_000
    # Bounded diagnostics: never let ExUnit pretty-print either large body.
    identical = result.body == expected
    assert identical, "captured body bytes differ"
    assert result.signatures == [F.signature()]
  end

  defp assert_reads(target) do
    reads = F.reads()
    assert length(reads) in 1..64

    assert Enum.all?(reads, fn read ->
             read.length == target and read.read_length == target and
               read.read_timeout in 1..1_000 and read.finished >= read.started
           end)
  end

  defp body(size) do
    seed = <<0, 255, 13, 10, 195, 169, 92, 34, 123, 125, 120, 121, 122, 49, 50, 51>>
    binary_part(:binary.copy(seed, div(size + 15, 16)), 0, size)
  end
end

a1847a8c637ddd53fbd1b454ee4f553225792aa3 blob 10728
defmodule MixerHosted.Billing.RawWebhookCaptureTest.Adapter do
  def get_http_protocol(state), do: state.protocol

  def read_req_body(%{steps: [step | rest], index: index} = state, opts) do
    Process.put(:fake_calls, Process.get(:fake_calls, []) ++ [{index, opts}])
    next = %{state | steps: rest, index: index + 1}

    case step do
      {:raw, shape} ->
        shape

      {tag, bytes} when tag in [:ok, :more] ->
        {tag, bytes, next}

      {:error, reason} ->
        {:error, reason}

      {:raise, module} ->
        raise module, "synthetic transport exception"

      {:sleep, ms, tag, bytes} ->
        Process.sleep(ms)
        {tag, bytes, next}

      shape ->
        shape
    end
  end
end

defmodule MixerHosted.Billing.RawWebhookCaptureTest do
  use ExUnit.Case, async: false
  alias MixerHosted.Billing.RawWebhookCapture, as: C
  @max 1_048_576
  setup do
    Process.delete(:capture_clock_sequence)
    Process.delete(:capture_clock_last)
    Process.put(:fake_calls, [])
    :ok
  end

  def conn(steps \\ [{:ok, "a"}], extra \\ []) do
    %Plug.Conn{
      method: "POST",
      request_path: "/api/v1/webhooks/stripe",
      query_string: "",
      req_headers:
        [{"content-type", "application/json"}, {"stripe-signature", "t=1,v1=literal"}] ++ extra,
      adapter:
        {MixerHosted.Billing.RawWebhookCaptureTest.Adapter,
         %{steps: steps, index: 0, protocol: :"HTTP/2"}}
    }
  end

  def rejected(conn, reason) do
    assert {:error, ^reason, latest} = C.capture(conn)
    assert latest.halted
    refute Map.has_key?(latest.private, :raw_webhook_capture)
    refute Map.has_key?(latest.assigns, :raw_webhook_capture)
    latest
  end

  test "exact bytes, original exposed singleton and newest connection survive" do
    bytes = <<0, 255, 13, 10, 195, 169, 92, 117, 48, 48, 54, 49>>
    c = conn([{:more, binary_part(bytes, 0, 4)}, {:ok, binary_part(bytes, 4, 8)}])

    c = %{
      c
      | req_headers: [{"content-type", "application/json"}, {"stripe-signature", " t=1,v1=A "}]
    }

    assert {:ok, %{raw_body: ^bytes, signature_header_values: [" t=1,v1=A "]}, result} =
             C.capture(c)

    assert elem(result.adapter, 1).index == 2
    assert Enum.map(Process.get(:fake_calls), &elem(&1, 0)) == [0, 1]
    assert result.assigns == %{} and result.private == %{}
  end

  test "reject fixed envelope variants before reads" do
    for c <- [
          %{conn() | method: "HEAD"},
          %{conn() | method: "GET"},
          %{conn() | request_path: "/api/v1/webhooks/stripe/"},
          %{conn() | request_path: "/api/v1/webhooks/%73tripe"},
          %{conn() | request_path: "/API/v1/webhooks/stripe"},
          %{conn() | query_string: "x=1"}
        ] do
      rejected(c, :envelope)
    end

    assert Process.get(:fake_calls) == []
  end

  test "metadata grammar permits only selected ASCII variants" do
    for ct <- ["application/json", " Application/JSON\t", "application/json ; CHARSET = utf-8\t"] do
      c = %{conn() | req_headers: [{"content-type", ct}, {"stripe-signature", "x"}]}
      assert {:ok, _, _} = C.capture(c)
    end

    for ct <- [
          "",
          "application/json,application/json",
          "application/json;charset=\"utf-8\"",
          "application/json;charset=utf-16",
          "application/json;x=y",
          "application/json;;",
          "application/json;charset=utf-8;charset=utf-8",
          "application/json\n",
          <<255>>,
          String.duplicate("a", 129)
        ] do
      rejected(
        %{conn() | req_headers: [{"content-type", ct}, {"stripe-signature", "x"}]},
        :envelope
      )
    end
  end

  test "duplicate missing oversized signatures and metadata reject without reading" do
    base = [{"content-type", "application/json"}]

    for sigs <- [
          [],
          [{"stripe-signature", ""}],
          [{"stripe-signature", String.duplicate("a", 4097)}],
          [{"stripe-signature", "a"}, {"stripe-signature", "b"}]
        ] do
      rejected(%{conn() | req_headers: base ++ sigs}, :envelope)
    end

    for extra <- [
          [{"content-type", "application/json"}],
          [{"content-encoding", "identity"}],
          [{"content-encoding", ""}]
        ] do
      rejected(conn([{:ok, "a"}], extra), :envelope)
    end

    for header <- ["trailer", "expect", "upgrade", "te"] do
      rejected(conn([{:ok, "a"}], [{header, ""}]), :unsupported_framing)
    end

    rejected(conn([{:ok, "a"}], [{"connection", "keep-alive, Upgrade"}]), :unsupported_framing)
    assert Process.get(:fake_calls) == []

    for sig <- ["a", "t=1,v1=x,garbage", String.duplicate("x", 4096)] do
      c = %{conn() | req_headers: base ++ [{"stripe-signature", sig}]}
      assert {:ok, %{signature_header_values: [^sig]}, _} = C.capture(c)
    end
  end

  test "framing is fixed across protocol versions" do
    for proto <- [:"HTTP/1.0", :"HTTP/3", :unknown] do
      {adapter, state} = conn().adapter
      rejected(%{conn() | adapter: {adapter, %{state | protocol: proto}}}, :unsupported_framing)
    end

    {adapter, state} = conn().adapter
    h1 = %{conn() | adapter: {adapter, %{state | protocol: :"HTTP/1.1"}}}
    rejected(h1, :unsupported_framing)

    assert {:ok, _, _} =
             C.capture(%{h1 | req_headers: h1.req_headers ++ [{"content-length", "1"}]})

    assert {:ok, _, _} =
             C.capture(%{h1 | req_headers: h1.req_headers ++ [{"transfer-encoding", "chunked"}]})

    rejected(conn([{:ok, "a"}], [{"transfer-encoding", "chunked"}]), :unsupported_framing)
  end

  test "canonical lengths have strict occurrence and byte grammar" do
    for length <- ["0", "01", "+1", "-1", " 1", "1 ", "1, 1", "99999999", "1x", ""] do
      rejected(conn([{:ok, "a"}], [{"content-length", length}]), :unsupported_framing)
    end

    rejected(conn([{:ok, "a"}], [{"content-length", "1048577"}]), :too_large)

    rejected(
      conn([{:ok, "a"}], [{"content-length", "1"}, {"content-length", "1"}]),
      :unsupported_framing
    )
  end

  test "actual returned byte count beats advisory target before retaining" do
    # 40KiB exceeds the 32KiB request but remains inside the aggregate cap.
    body = String.duplicate("a", 40_000)
    assert {:ok, %{raw_body: ^body}, _} = C.capture(conn([{:ok, body}]))
    assert [{0, opts}] = Process.get(:fake_calls)

    assert opts[:length] == 32_768 and opts[:read_length] == 32_768 and
             opts[:read_timeout] == 1_000

    rejected(conn([{:ok, String.duplicate("a", @max + 1)}]), :too_large)
    rejected(conn([{:ok, "ab"}], [{"content-length", "1"}]), :length_mismatch)
  end

  test "body min max more terminal and empty final boundaries" do
    rejected(conn([{:ok, ""}]), :empty)
    assert {:ok, _, _} = C.capture(conn([{:ok, String.duplicate("a", @max)}]))
    rejected(conn([{:more, String.duplicate("a", @max)}]), :too_large)
    rejected(conn([{:more, "a"}], [{"content-length", "1"}]), :length_mismatch)
    assert {:ok, %{raw_body: "a"}, _} = C.capture(conn([{:more, "a"}, {:ok, ""}]))
    rejected(conn([{:ok, "a"}], [{"content-length", "2"}]), :length_mismatch)
  end

  test "no progress and 64-call budget never drain a 65th read" do
    rejected(conn([{:more, ""}]), :no_progress)
    Process.put(:fake_calls, [])
    rejected(conn(List.duplicate({:more, "a"}, 64) ++ [{:ok, "a"}]), :read_limit)
    assert length(Process.get(:fake_calls)) == 64
    Process.put(:fake_calls, [])

    assert {:ok, %{raw_body: bytes}, _} =
             C.capture(conn(List.duplicate({:more, "a"}, 63) ++ [{:ok, "a"}]))

    assert byte_size(bytes) == 64 and length(Process.get(:fake_calls)) == 64
  end

  test "latest connection retained on opaque error without storing request reason" do
    c = conn([{:more, "a"}, {:error, {:synthetic, "BODY_SENTINEL"}}])
    latest = rejected(c, :transport_failure)
    assert elem(latest.adapter, 1).index == 1
    refute inspect(latest.assigns) =~ "BODY_SENTINEL"
  end

  test "documented nonbinary result fails closed, malformed Plug result raises" do
    rejected(conn([{:ok, ["not-binary"]}]), :unavailable_state)

    for shape <- [:wrong, {:ok, "a"}, {:ok, "a", :extra, :wrong}] do
      assert_raise CaseClauseError, fn -> C.capture(conn([{:raw, shape}])) end
    end

    assert_raise RuntimeError, "synthetic transport exception", fn ->
      C.capture(conn([{:raise, RuntimeError}]))
    end
  end

  test "production module excludes the test clock and ignores process clock spoofing" do
    {:ok, {_, [atoms: atoms]}} = :beam_lib.chunks(:code.which(C), [:atoms])

    refute Enum.any?(atoms, fn {_, atom} ->
             Atom.to_string(atom) == "Elixir.MixerRawCapture.TestClock"
           end)

    assert C.__info__(:functions) == [capture: 1]
    Process.put(:capture_clock_sequence, [0, 5000])
    assert {:ok, %{raw_body: "a"}, _} = C.capture(conn())
    assert Process.get(:capture_clock_sequence) == [0, 5000]
  end

  test "real late adapter result rejects without claiming hard cancellation" do
    started = System.monotonic_time(:millisecond)
    rejected(conn([{:sleep, 5_050, :ok, "a"}]), :read_deadline)
    assert System.monotonic_time(:millisecond) - started >= 5_050
    assert [{0, _}] = Process.get(:fake_calls)
  end

  test "captured unparsed bytes compose with the actual signature verifier" do
    body = <<0, 255, 13, 10, 123, 32, 125>>
    secret = "independent-test-secret"
    timestamp = 1_700_000_000
    mac = :crypto.mac(:hmac, :sha256, secret, Integer.to_string(timestamp) <> "." <> body)
    header = "t=#{timestamp},v1=#{Base.encode16(mac, case: :lower)}"
    original = conn([{:more, binary_part(body, 0, 2)}, {:ok, binary_part(body, 2, 5)}])

    original = %{
      original
      | req_headers: [{"content-type", "application/json"}, {"stripe-signature", header}]
    }

    assert {:ok, %{raw_body: captured, signature_header_values: headers}, _} = C.capture(original)
    assert captured == body and headers == [header]

    assert :ok =
             MixerHosted.Billing.WebhookSignature.verify(captured, headers, [secret], timestamp)

    assert {:error, :invalid_signature} =
             MixerHosted.Billing.WebhookSignature.verify(
               captured <> " ",
               headers,
               [secret],
               timestamp
             )
  end

  test "request and conn private fields cannot select clock and stale result cleared" do
    c = conn()

    c = %{
      c
      | private: %{clock: fn -> 0 end, raw_webhook_capture: "old"},
        assigns: %{raw_webhook_capture: "old"}
    }

    assert {:ok, _, latest} = C.capture(c)
    refute Map.has_key?(latest.private, :raw_webhook_capture)
    refute Map.has_key?(latest.assigns, :raw_webhook_capture)
  end
end

