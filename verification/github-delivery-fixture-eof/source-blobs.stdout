  test "deferred SQL rejects incomplete writes changed retained fields forged projections actors and chain gaps" do
    for mode <-
          ~w(artifact_only event_only dedup_only no_artifact no_event no_dedup no_head wrong_payload wrong_signature wrong_canonical wrong_signed_bytes wrong_envelope wrong_manifest_hash cross_tenant wrong_event_cbor broken_predecessor wrong_projection wrong_actor wrong_authorization sequence_gap string_schema)a do
      assert {:error, _} = F.raw(mode), inspect(mode)
      assert [[0, 0, 0, 0]] = F.counts(), inspect(mode)
