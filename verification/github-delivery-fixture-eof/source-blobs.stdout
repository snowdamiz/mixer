defmodule MixerHosted.Identity.JWKSTransport do
  @moduledoc false
  alias MixerHosted.Identity.{BoundedTCP, DNSResolver, HTTPFreshness, HTTPWireGuard}

  @headers [
    {"accept", "application/jwk-set+json, application/json"},
    {"accept-encoding", "identity"},
    {"connection", "close"}
  ]
  def fetch(entry, deadline, configuration, watcher) do
    with {:ok, ip} <-
           DNSResolver.resolve(entry.jwks_endpoint.host, configuration.resolvers, deadline) do
      connect(entry, ip, entry.jwks_endpoint.port, deadline, configuration.ca_roots, watcher)
    end
  end

  # These functions do not exist in production BEAMs. Only fixture ports and
  # destination selection change; certificate/hostname validation stays enabled.
  if Mix.env() == :test do
    def fetch_fixture(entry, ip, port, deadline, roots, watcher),
      do: connect(entry, ip, port, deadline, roots, watcher)
  end

  defp connect(entry, ip, port, deadline, roots, watcher) do
    BoundedTCP.with_watchdog(watcher, deadline, fn ->
      do_connect(entry, ip, port, deadline, roots, watcher)
    end)
  end

  defp do_connect(entry, ip, port, deadline, roots, watcher) do
    host = entry.jwks_endpoint.host

    opts = [
      hostname: host,
      protocols: [:http1],
      mode: :passive,
      max_header_list_size: 10_240,
      transport_opts: [
        cb_info: {BoundedTCP, :tcp, :tcp_closed, :tcp_error, :tcp_passive},
        verify: :verify_peer,
        cacerts: roots,
        timeout: remaining(deadline),
        send_timeout: remaining(deadline),
        send_timeout_close: true,
        versions: [:"tlsv1.2", :"tlsv1.3"],
        recbuf: 16_384,
        buffer: 16_384,
        inet4: tuple_size(ip) == 4,
        inet6: tuple_size(ip) == 8,
        max_handshake_size: 65_536
      ]
    ]

    with {:ok, conn} <- Mint.HTTP.connect(:https, ip, port, opts) do
      socket = Mint.HTTP.get_socket(conn)

      try do
        with :ok <- register_socket(watcher, socket, deadline),
             {:ok, {^ip, ^port}} <- :ssl.peername(socket),
             request_clock = clock(),
             {:ok, conn, ref} <-
               Mint.HTTP.request(conn, "GET", entry.jwks_endpoint.path, @headers, nil),
             {:ok, body, wire, metrics} <-
               receive_loop(conn, ref, HTTPWireGuard.new(), [], 0, deadline, %{
                 max_batch: 0,
                 max_parser_buffer: 0,
                 max_mailbox: 0,
                 max_heap_bytes: 0
               }),
             response_clock = clock(),
             {:ok, freshness} <-
               HTTPFreshness.calculate(wire.headers, request_clock, response_clock),
             true <- remaining(deadline) > 0 do
          {:ok, Map.merge(freshness, %{body: body, metrics: metrics, peer: ip})}
        else
          {:error, reason} when is_atom(reason) -> {:error, reason}
          _ -> {:error, :transport_rejected}
        end
      after
        Mint.HTTP.close(conn)
      end
    else
      _ -> {:error, :tls_rejected}
    end
  rescue
    _ -> {:error, :transport_rejected}
  catch
    _, _ -> {:error, :transport_rejected}
  end

  defp register_socket(nil, _, _), do: :ok

  defp register_socket(watcher, socket, deadline) do
    ref = make_ref()
    send(watcher, {:register_socket, self(), socket, ref})

    receive do
      {^ref, :ok} -> :ok
    after
      remaining(deadline) -> {:error, :deadline}
    end
  end

  defp receive_loop(conn, ref, wire, chunks, size, deadline, metrics) do
    socket = Mint.HTTP.get_socket(conn)

    count =
      case wire.phase do
        {:length, n} when n > 0 -> min(n, 4_096)
        {:chunk, n} when n > 0 -> min(n, 4_096)
        :chunk_crlf -> 2
        _ -> 1
      end

    if remaining(deadline) > 0 do
      case :ssl.recv(socket, count, remaining(deadline)) do
        {:ok, data} when byte_size(data) <= count ->
          with {:ok, wire} <- HTTPWireGuard.feed(wire, data),
               {:ok, conn, events} <- Mint.HTTP.stream(conn, {:ssl, socket, data}),
               {:ok, chunks, size, done} <- events(events, ref, chunks, size) do
            metrics = measure(conn, metrics, byte_size(data))

            if done and wire.done,
              do: {:ok, IO.iodata_to_binary(Enum.reverse(chunks)), wire, metrics},
              else: receive_loop(conn, ref, wire, chunks, size, deadline, metrics)
          else
            {:error, reason} when is_atom(reason) -> {:error, reason}
            _ -> {:error, :response_rejected}
          end

        {:error, :closed} ->
          with :close <- wire.phase,
               {:ok, _, events} <- Mint.HTTP.stream(conn, {:ssl_closed, socket}),
               {:ok, chunks, _, true} <- events(events, ref, chunks, size) do
            {:ok, IO.iodata_to_binary(Enum.reverse(chunks)), wire, metrics}
          else
            _ -> {:error, :truncated_response}
          end

        {:error, :timeout} ->
          {:error, :deadline}

        _ ->
          {:error, :socket_error}
      end
    else
      {:error, :deadline}
    end
  end

  defp events(events, ref, chunks, size) do
    Enum.reduce_while(events, {:ok, chunks, size, false}, fn
      {:data, ^ref, data}, {:ok, chunks, size, done} when size + byte_size(data) <= 262_144 ->
        {:cont, {:ok, [:binary.copy(data) | chunks], size + byte_size(data), done}}

      {:done, ^ref}, {:ok, chunks, size, _} ->
        {:cont, {:ok, chunks, size, true}}

      {:status, ^ref, _}, acc ->
        {:cont, acc}

      {:headers, ^ref, _}, acc ->
        {:cont, acc}

      _, _ ->
        {:halt, {:error, :response_rejected}}
    end)
  end

  defp measure(conn, m, batch) do
    info = Process.info(self(), [:message_queue_len, :memory])

    %{
      m
      | max_batch: max(m.max_batch, batch),
        max_parser_buffer: max(m.max_parser_buffer, byte_size(conn.buffer)),
        max_mailbox: max(m.max_mailbox, info[:message_queue_len]),
        max_heap_bytes: max(m.max_heap_bytes, info[:memory])
    }
  end

  defp clock, do: {System.system_time(:millisecond), System.monotonic_time(:millisecond)}
  defp remaining(d), do: max(0, d - System.monotonic_time(:millisecond))
end

8d8f602d8b77a05d546cbfd8dac93acc2c604ef2 blob 15903
defmodule MixerHosted.Identity.KeyOwner do
  @moduledoc "Owns configured trust generations, bounded refresh flights and final verification fences."
  use GenServer
  alias MixerHosted.Identity.{Admission, Encoding, FetchFlight, Manifest, TrustSnapshot}

  defmodule Lease do
    @moduledoc false
    @enforce_keys [:epoch, :generation, :id, :snapshot_generation, :snapshot, :permit]
    defstruct @enforce_keys
  end

  @allowed ~w(name manifest generation binding ca_roots resolvers worker_supervisor)a
  def start_link(options),
    do: GenServer.start_link(__MODULE__, options, name: Keyword.get(options, :name, __MODULE__))

  def child_spec(options),
    do: %{id: __MODULE__, start: {__MODULE__, :start_link, [options]}, shutdown: :infinity}

  if Mix.env() == :test do
    def start_fixture(options),
      do:
        GenServer.start_link(__MODULE__, {:fixture, options},
          name: Keyword.fetch!(options, :name)
        )
  end

  def release(owner, permit), do: safe_call(owner, {:release, permit}, 2_200)
  def checkout(owner, permit, now), do: safe_call(owner, {:checkout, permit, now}, 2_200)
  def finish(owner, lease), do: safe_call(owner, {:finish, lease}, 2_200)

  def note_unknown(owner, lease, kid),
    do: safe_call(owner, {:unknown, lease, kid, System.monotonic_time(:millisecond)}, 2_200)

  def replace_manifest(owner, expected, candidate),
    do: safe_call(owner, {:replace, expected, candidate}, 2_200)

  defp safe_call(owner, message, timeout) do
    GenServer.call(owner, message, timeout)
  catch
    :exit, _ -> {:error, :identity_unavailable}
  end

  if Mix.env() == :test do
    def init({:fixture, options}),
      do: initialize(Keyword.delete(options, :fixture), Keyword.fetch!(options, :fixture))
  end

  def init(options), do: initialize(options, nil)

  defp initialize(options, fixture) do
    Process.flag(:trap_exit, true)

    with true <- Keyword.keyword?(options) and Enum.all?(Keyword.keys(options), &(&1 in @allowed)),
         {:ok, entries} <- Manifest.validate(Keyword.get(options, :manifest)),
         binding when is_binary(binding) <- Keyword.get(options, :binding),
         true <- Map.has_key?(entries, binding),
         roots when is_list(roots) and roots != [] <- Keyword.get(options, :ca_roots),
         true <- Enum.all?(roots, &ca_root?/1),
         resolvers when is_list(resolvers) and resolvers != [] and length(resolvers) <= 3 <-
           Keyword.get(options, :resolvers),
         true <- Enum.all?(resolvers, &resolver?/1),
         generation when is_integer(generation) and generation > 0 <-
           Keyword.get(options, :generation),
         workers when is_atom(workers) <- Keyword.get(options, :worker_supervisor) do
      name = Keyword.get(options, :name, __MODULE__)
      table = Admission.new(name, entries, binding)
      config = %{ca_roots: roots, resolvers: resolvers}
      config = if fixture, do: Map.put(config, :fixture, fixture), else: config
      Process.send_after(self(), :reap, 1_000)

      {:ok,
       %{
         name: name,
         entries: entries,
         history: Map.new(entries, fn {id, entry} -> {id, %{entry: entry, retired: false}} end),
         binding: binding,
         generation: generation,
         epoch: make_ref(),
         table: table,
         configuration: config,
         workers: workers,
         snapshots: %{},
         attempts: %{},
         tombstones: %{},
         flights: %{},
         waiters: %{},
         admitted: %{},
         negatives: %{},
         sequence: 0,
         clock: clock(),
         clock_valid: true
       }}
    else
      _ -> {:stop, :invalid_identity_configuration}
    end
  end

  defp ca_root?(der) when is_binary(der) do
    :public_key.pkix_decode_cert(der, :otp)
    true
  rescue
    _ -> false
  end

  defp ca_root?(_), do: false

  defp resolver?({ip, port}),
    do: is_tuple(ip) and tuple_size(ip) in [4, 8] and is_integer(port) and port in 1..65535

  defp resolver?(_), do: false

  def handle_call({:checkout, permit, now}, from, s) do
    s = sample_clock(s)
    caller = elem(from, 0)

    if Admission.valid?(permit, s.table, caller) do
      id = elem(permit, 3)
      {s, _} = monitor_permit(s, permit, caller)

      cond do
        s.entries[id] == nil or not s.entries[id].profile.enabled ->
          {:reply, {:error, :unauthenticated}, s}

        not Encoding.numeric_date?(now) or abs(now * 1_000 - elem(s.clock, 0)) > 1_000 ->
          {:reply, {:error, :identity_unavailable}, s}

        fresh?(s, id, now) ->
          {:reply, {:ok, lease(s, id, permit)}, s}

        true ->
          case ensure_flight(s, id, elem(permit, 5), :required) do
            {:ok, s, pid, deadline} ->
              timer =
                Process.send_after(
                  self(),
                  {:waiter_timeout, permit},
                  max(0, deadline - elem(s.clock, 1))
                )

              {:noreply,
               put_in(s.waiters[permit], %{
                 from: from,
                 id: id,
                 flight: pid,
                 timer: timer,
                 now: now
               })}

            {:error, s} ->
              {:reply, {:error, :identity_unavailable}, s}
          end
      end
    else
      {:reply, {:error, :identity_unavailable}, s}
    end
  end

  def handle_call({:finish, %Lease{} = l}, from, s) do
    s = sample_clock(s)

    result =
      cond do
        not Admission.valid?(l.permit, s.table, elem(from, 0)) ->
          {:error, :identity_unavailable}

        s.entries[l.id] == nil or not s.entries[l.id].profile.enabled ->
          {:error, :unauthenticated}

        not current?(s, l) ->
          {:error, :retry_current}

        not fresh?(s, l.id, div(elem(s.clock, 0), 1_000)) ->
          {:error, :identity_unavailable}

        true ->
          :ok
      end

    {:reply, result, s}
  end

  def handle_call({:unknown, %Lease{} = l, kid, requested}, from, s) do
    s = sample_clock(s)

    if Admission.valid?(l.permit, s.table, elem(from, 0)) and current?(s, l) and
         Encoding.bounded_string?(kid, 128) and
         fresh?(s, l.id, div(elem(s.clock, 0), 1_000)) and
         TrustSnapshot.key(l.snapshot, kid) == :error do
      now = elem(s.clock, 1)
      neg = Map.get(s.negatives, l.id, %{}) |> Map.reject(fn {_, v} -> v.expires <= now end)

      if Map.has_key?(neg, kid) do
        {:reply, :ok, put_in(s.negatives[l.id], neg)}
      else
        neg =
          if map_size(neg) >= 128 do
            {old, _} = Enum.min_by(neg, fn {k, v} -> {v.sequence, k} end)
            Map.delete(neg, old)
          else
            neg
          end

        seq = s.sequence + 1

        neg =
          Map.put(neg, kid, %{
            sequence: seq,
            generation: l.snapshot_generation,
            expires: min(now + 30_000, s.snapshots[l.id].expires_mono)
          })

        s = %{s | sequence: seq, negatives: Map.put(s.negatives, l.id, neg)}

        s =
          case ensure_flight(s, l.id, requested, :background) do
            {:ok, s, _, _} -> s
            {:error, s} -> s
          end

        {:reply, :ok, s}
      end
    else
      {:reply, :ok, s}
    end
  end

  def handle_call({:replace, expected, candidate}, _from, s) do
    s = sample_clock(s)
    now = elem(s.clock, 1)
    tombs = Map.reject(s.tombstones, fn {_, v} -> v.expires <= now end)

    with true <- expected == s.generation,
         {:ok, entries} <- Manifest.validate(candidate),
         true <- Manifest.transition(s.history, entries),
         history =
           Map.new(s.history, fn {id, value} ->
             {id, %{value | retired: not Map.has_key?(entries, id)}}
           end),
         history =
           Map.merge(
             history,
             Map.new(entries, fn {id, entry} -> {id, %{entry: entry, retired: false}} end)
           ),
         true <- map_size(history) <= 16,
         removed = Map.drop(s.entries, Map.keys(entries)),
         tombs =
           Enum.reduce(removed, tombs, fn {id, entry}, acc ->
             Map.put(acc, id, %{entry: entry, expires: now + 30_000})
           end),
         tombs = Map.drop(tombs, Map.keys(entries)),
         true <- map_size(tombs) + map_size(entries) <= 16 do
      changed = for {id, e} <- s.entries, entries[id] != e, do: id

      Enum.each(s.flights, fn {pid, f} -> if f.id in changed, do: send(pid, :cancel) end)

      snapshots = Map.drop(s.snapshots, changed)
      neg = Map.drop(s.negatives, changed)
      attempts = Map.take(s.attempts, Map.keys(entries) ++ Map.keys(tombs))

      Admission.configure(
        s.table,
        Map.merge(entries, Map.new(tombs, fn {id, v} -> {id, v.entry} end)),
        s.binding
      )

      {:reply, {:ok, s.generation + 1},
       %{
         s
         | entries: entries,
           history: history,
           generation: s.generation + 1,
           tombstones: tombs,
           snapshots: snapshots,
           negatives: neg,
           attempts: attempts
       }}
    else
      _ -> {:reply, {:error, :invalid_manifest}, s}
    end
  end

  def handle_call({:release, permit}, from, s) do
    if Admission.valid?(permit, s.table, elem(from, 0)),
      do: {:reply, :ok, drop_permit(s, permit)},
      else: {:reply, :ok, s}
  end

  def handle_call(_, _, s), do: {:reply, {:error, :identity_unavailable}, s}

  defp monitor_permit(s, permit, pid) do
    if s.admitted[permit] do
      {s, s.admitted[permit]}
    else
      ref = Process.monitor(pid)
      {%{s | admitted: Map.put(s.admitted, permit, ref)}, ref}
    end
  end

  defp ensure_flight(s, id, admitted, mode) do
    case Enum.find(s.flights, fn {_, f} -> f.id == id end) do
      {pid, f} ->
        {:ok, s, pid, f.deadline}

      nil ->
        now = elem(s.clock, 1)

        if map_size(s.flights) < 4 and admitted + 2_000 > now and
             now - Map.get(s.attempts, id, now - 30_000) >= 30_000 do
          deadline = admitted + 2_000

          opts = %{
            owner: self(),
            entry: s.entries[id],
            deadline: deadline,
            configuration: s.configuration
          }

          s = put_in(s.attempts[id], now)

          case DynamicSupervisor.start_child(s.workers, {FetchFlight, opts}) do
            {:ok, pid} ->
              ref = Process.monitor(pid)

              f = %{
                id: id,
                generation: s.generation,
                epoch: s.epoch,
                entry: s.entries[id],
                deadline: deadline,
                monitor: ref,
                result: nil,
                mode: mode
              }

              {:ok, put_in(s.flights[pid], f), pid, deadline}

            _ ->
              {:error, s}
          end
        else
          {:error, s}
        end
    end
  end

  def handle_info({:flight_result, pid, result}, s) do
    if s.flights[pid], do: {:noreply, put_in(s.flights[pid].result, result)}, else: {:noreply, s}
  end

  def handle_info({:DOWN, ref, :process, pid, _}, s) do
    cond do
      s.flights[pid] && s.flights[pid].monitor == ref ->
        s = sample_clock(s)
        f = s.flights[pid]
        s = publish(s, f)
        s = %{s | flights: Map.delete(s.flights, pid)}
        {done, rest} = Enum.split_with(s.waiters, fn {_, w} -> w.flight == pid end)

        Enum.each(done, fn {permit, w} ->
          Process.cancel_timer(w.timer)

          result =
            cond do
              s.entries[w.id] == nil or not s.entries[w.id].profile.enabled ->
                {:error, :unauthenticated}

              fresh?(s, w.id, div(elem(s.clock, 0), 1_000)) ->
                {:ok, lease(s, w.id, permit)}

              true ->
                {:error, :identity_unavailable}
            end

          GenServer.reply(w.from, result)
        end)

        {:noreply, %{s | waiters: Map.new(rest)}}

      true ->
        permits = for {permit, r} <- s.admitted, r == ref, do: permit
        s = Enum.reduce(permits, s, fn p, acc -> drop_permit(acc, p) end)
        {:noreply, s}
    end
  end

  def handle_info({:waiter_timeout, permit}, s) do
    case s.waiters[permit] do
      nil ->
        {:noreply, s}

      w ->
        error =
          if s.entries[w.id] == nil or not s.entries[w.id].profile.enabled,
            do: :unauthenticated,
            else: :identity_unavailable

        GenServer.reply(w.from, {:error, error})
        send(w.flight, :cancel)
        {:noreply, %{s | waiters: Map.delete(s.waiters, permit)}}
    end
  end

  def handle_info(:reap, s) do
    Admission.reap(s.table)
    released = for {p, _} <- s.admitted, not Admission.valid?(p, s.table, elem(p, 4)), do: p
    s = Enum.reduce(released, s, &drop_permit(&2, &1))
    Process.send_after(self(), :reap, 1_000)
    {:noreply, s}
  end

  def handle_info(_, s), do: {:noreply, s}

  defp drop_permit(s, p) do
    if s.admitted[p], do: Process.demonitor(s.admitted[p], [:flush])
    Admission.release(p)
    waiter = s.waiters[p]
    if waiter, do: Process.cancel_timer(waiter.timer)
    s = %{s | admitted: Map.delete(s.admitted, p), waiters: Map.delete(s.waiters, p)}

    if ((waiter != nil and s.flights[waiter.flight] != nil) &&
          s.flights[waiter.flight].mode == :required) and
         not Enum.any?(s.waiters, fn {_, w} -> w.flight == waiter.flight end),
       do: send(waiter.flight, :cancel)

    s
  end

  defp publish(s, %{result: {:ok, snapshot, meta}} = f) do
    now = elem(s.clock, 1)

    if s.clock_valid and now < f.deadline and now < meta.expires_mono and
         f.generation == s.generation and f.epoch == s.epoch and s.entries[f.id] == f.entry and
         f.entry.profile.enabled do
      generation = make_ref()
      record = %{snapshot: snapshot, generation: generation, expires_mono: meta.expires_mono}

      %{
        s
        | snapshots: Map.put(s.snapshots, f.id, record),
          negatives: Map.delete(s.negatives, f.id)
      }
    else
      s
    end
  end

  defp publish(s, _), do: s

  defp lease(s, id, permit),
    do: %Lease{
      epoch: s.epoch,
      generation: s.generation,
      id: id,
      snapshot_generation: s.snapshots[id].generation,
      snapshot: s.snapshots[id].snapshot,
      permit: permit
    }

  defp current?(s, l),
    do:
      l.epoch == s.epoch and l.generation == s.generation and s.snapshots[l.id] != nil and
        s.snapshots[l.id].generation == l.snapshot_generation

  defp fresh?(s, id, now),
    do:
      s.clock_valid and s.snapshots[id] != nil and elem(s.clock, 1) < s.snapshots[id].expires_mono and
        TrustSnapshot.status(s.snapshots[id].snapshot, now) == :fresh

  defp sample_clock(s) do
    {wall, mono} = now = clock()
    {old_wall, old_mono} = s.clock
    stable = mono >= old_mono and abs(wall - old_wall - (mono - old_mono)) <= 1_000

    if stable do
      %{s | clock: now, clock_valid: true}
    else
      Enum.each(s.flights, fn {pid, _} -> send(pid, :cancel) end)

      %{
        s
        | clock: now,
          clock_valid: false,
          snapshots: %{},
          negatives: %{},
          epoch: make_ref()
      }
    end
  end

  defp clock, do: {System.system_time(:millisecond), System.monotonic_time(:millisecond)}

  def terminate(_, s) do
    Admission.close(s.name, s.table)

    Enum.each(s.waiters, fn {_, w} -> GenServer.reply(w.from, {:error, :identity_unavailable}) end)

    workers = s.workers

    Enum.each(s.flights, fn {pid, f} ->
      try do
        DynamicSupervisor.terminate_child(workers, pid)
      catch
        :exit, {:noproc, {GenServer, :call, [^workers, {:terminate_child, ^pid}, :infinity]}} ->
          :ok
      end

      # A dead worker supervisor cannot acknowledge cleanup. The exact flight's
      # existing monitor still gates owner exit and one_for_all replacement.
      receive do
        {:DOWN, ref, :process, ^pid, _} when ref == f.monitor -> :ok
      end
    end)
  end
end

be8d6979f20643c544c99674c88dbacd7acbc86a blob 1072
defmodule MixerHosted.Identity.KeyOwnerSupervisor do
  @moduledoc "Explicitly configured private identity component; it starts no provider implicitly."
  use Supervisor
  alias MixerHosted.Identity.KeyOwner
  def start_link(options), do: Supervisor.start_link(__MODULE__, options)

  if Mix.env() == :test do
    def start_fixture(options), do: Supervisor.start_link(__MODULE__, {:fixture, options})
    def init({:fixture, options}), do: initialize(options, :start_fixture)
  end

  def init(options), do: initialize(options, :start_link)

  defp initialize(options, owner_start) do
    name = Keyword.get(options, :name, KeyOwner)
    workers = Module.concat(name, FetchSupervisor)
    owner_options = Keyword.put(options, :worker_supervisor, workers)
    owner = KeyOwner.child_spec(owner_options)
    owner = %{owner | start: {KeyOwner, owner_start, [owner_options]}}

    children = [
      {DynamicSupervisor, strategy: :one_for_one, name: workers},
      owner
    ]

    Supervisor.init(children, strategy: :one_for_all, max_restarts: 3, max_seconds: 5)
  end
end

14569b0593975124fa4ea9e90b449d362fd96d72 blob 3157
defmodule MixerHosted.Identity.Manifest do
  @moduledoc false
  alias MixerHosted.Identity.Encoding
  @fields ~w(profile_id profile_version issuer audience client_id identity_class enabled)a
  def validate(entries) when is_list(entries) and length(entries) <= 8 do
    with true <- Enum.all?(entries, &entry?/1),
         ids = Enum.map(entries, & &1.profile.profile_id),
         true <- length(Enum.uniq(ids)) == length(ids) do
      {:ok, Map.new(entries, &{&1.profile.profile_id, &1})}
    else
      _ -> {:error, :invalid_manifest}
    end
  end

  def validate(_), do: {:error, :invalid_manifest}

  defp entry?(
         %{
           profile: p,
           jwks_endpoint: %{host: h, port: 443, path: path} = ep,
           transport: :hosted_https
         } = e
       ) do
    map_size(e) == 3 and map_size(ep) == 3 and profile?(p) and host?(h) and path?(path)
  end

  defp entry?(_), do: false

  defp profile?(p) when is_map(p) do
    Enum.sort(Map.keys(p)) == Enum.sort(@fields) and Encoding.bounded_string?(p.profile_id, 128) and
      is_integer(p.profile_version) and p.profile_version in 1..2_147_483_647 and
      issuer?(p.issuer) and Encoding.bounded_string?(p.audience, 256) and
      Encoding.bounded_string?(p.client_id, 256) and
      p.identity_class in [:human, :service] and is_boolean(p.enabled)
  end

  defp profile?(_), do: false

  defp issuer?(s) when is_binary(s) and byte_size(s) in 1..2048 do
    case URI.new(s) do
      {:ok, %URI{scheme: "https", host: h, userinfo: nil, query: nil, fragment: nil}} ->
        is_binary(h) and h != ""

      _ ->
        false
    end
  end

  defp issuer?(_), do: false

  defp host?(s) when is_binary(s) and byte_size(s) in 1..253 do
    labels = String.split(s, ".")

    match?({:error, _}, :inet.parse_address(String.to_charlist(s))) and
      Enum.all?(labels, fn l ->
        byte_size(l) in 1..63 and Regex.match?(~r/\A[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\z/, l)
      end)
  end

  defp host?(_), do: false

  defp path?(s) when is_binary(s) and byte_size(s) in 1..2048 do
    String.starts_with?(s, "/") and Regex.match?(~r/\A[A-Za-z0-9_~.\/-]+\z/, s) and
      not Enum.any?(String.split(s, "/"), &(&1 in [".", ".."]))
  end

  defp path?(_), do: false

  def transition(history, new) do
    Enum.all?(new, fn {id, e} ->
      case history[id] do
        nil ->
          true

        %{entry: prior, retired: retired} ->
          a = prior.profile
          b = e.profile

          immutable =
            Map.take(a, [:issuer, :client_id, :identity_class]) ==
              Map.take(b, [:issuer, :client_id, :identity_class])

          unchanged = prior == e

          disable =
            a.enabled and not b.enabled and a.profile_version == b.profile_version and
              Map.put(a, :enabled, false) == b and prior.jwks_endpoint == e.jwks_endpoint

          needs_new_version = retired or (not a.enabled and b.enabled)

          immutable and
            if(needs_new_version,
              do: b.profile_version > a.profile_version,
              else: unchanged or disable or b.profile_version > a.profile_version
            )
      end
    end)
  end
end

4a266785e99485adc94f136e270bead6e7f28d3e blob 5214
defmodule MixerHosted.Identity.StartupConfig do
  @moduledoc "Validated, restart-scoped operator identity settings."
  alias MixerHosted.Identity.{BoundedJSON, Manifest}
  @derive {Inspect, only: [:mode]}
  @enforce_keys [:mode, :owner_options]
  defstruct @enforce_keys
  @envelope ~w(version generation binding profiles resolvers)
  @entry ~w(profile jwks_endpoint transport)
  @profile ~w(profile_id profile_version issuer audience client_id identity_class enabled)
  @endpoint ~w(host port path)

  # Roots are supplied by RuntimeConfig from OTP, never the environment. Keeping
  # the constructor pure also allows isolated synthetic-CA startup verification.
  def load!(env, role, roots) when is_map(env) and role in [:api, :processor] do
    case Map.get(env, "MIXER_IDENTITY_MODE", "disabled") do
      "disabled" ->
        if Map.has_key?(env, "MIXER_IDENTITY_CONFIG"), do: invalid!(:unexpected_configuration)
        %__MODULE__{mode: :disabled, owner_options: []}

      "configured" when role == :api ->
        configured!(Map.get(env, "MIXER_IDENTITY_CONFIG"), roots)

      "configured" ->
        invalid!(:role)

      _ ->
        invalid!(:mode)
    end
  end

  defp configured!(raw, roots) do
    with {:ok, object} <- BoundedJSON.object(raw, 65_536),
         true <- exact?(object, @envelope),
         1 <- object["version"],
         generation when is_integer(generation) and generation in 1..2_147_483_647 <-
           object["generation"],
         profiles when is_list(profiles) and length(profiles) in 1..8 <- object["profiles"],
         {:ok, entries} <- convert_all(profiles, &entry/1),
         {:ok, manifest} <- Manifest.validate(entries),
         binding when is_binary(binding) <- object["binding"],
         true <- Map.has_key?(manifest, binding),
         addresses when is_list(addresses) and length(addresses) in 1..3 <- object["resolvers"],
         true <- length(Enum.uniq(addresses)) == length(addresses),
         {:ok, resolvers} <- convert_all(addresses, &resolver/1) do
      if not valid_roots?(roots), do: invalid!(:ca_roots)

      %__MODULE__{
        mode: :configured,
        owner_options: [
          manifest: entries,
          generation: generation,
          binding: binding,
          resolvers: resolvers,
          ca_roots: roots
        ]
      }
    else
      _ -> invalid!(:configuration)
    end
  end

  defp entry(value) when is_map(value) do
    with true <- exact?(value, @entry),
         p when is_map(p) <- value["profile"],
         true <- exact?(p, @profile),
         endpoint when is_map(endpoint) <- value["jwks_endpoint"],
         true <- exact?(endpoint, @endpoint),
         :hosted_https <- transport(value["transport"]),
         class when class in [:human, :service] <- identity_class(p["identity_class"]) do
      {:ok,
       %{
         profile: %{
           profile_id: p["profile_id"],
           profile_version: p["profile_version"],
           issuer: p["issuer"],
           audience: p["audience"],
           client_id: p["client_id"],
           identity_class: class,
           enabled: p["enabled"]
         },
         jwks_endpoint: %{
           host: endpoint["host"],
           port: endpoint["port"],
           path: endpoint["path"]
         },
         transport: :hosted_https
       }}
    else
      _ -> :error
    end
  end

  defp entry(_), do: :error
  defp transport("hosted_https"), do: :hosted_https
  defp transport(_), do: :error
  defp identity_class("human"), do: :human
  defp identity_class("service"), do: :service
  defp identity_class(_), do: :error

  defp resolver(value) when is_binary(value) and byte_size(value) in 1..45 do
    with {:ok, address} <- :inet.parse_address(String.to_charlist(value)),
         true <- tuple_size(address) in [4, 8],
         ^value <- address |> :inet.ntoa() |> List.to_string() do
      {:ok, {address, 53}}
    else
      _ -> :error
    end
  end

  defp resolver(_), do: :error
  defp exact?(map, keys), do: Enum.sort(Map.keys(map)) == Enum.sort(keys)

  defp convert_all(values, convert) do
    Enum.reduce_while(values, {:ok, []}, fn value, {:ok, result} ->
      case convert.(value) do
        {:ok, converted} -> {:cont, {:ok, [converted | result]}}
        _ -> {:halt, :error}
      end
    end)
    |> case do
      {:ok, result} -> {:ok, Enum.reverse(result)}
      :error -> :error
    end
  end

  defp valid_roots?(roots) when is_list(roots) and roots != [] do
    Enum.all?(roots, fn
      der when is_binary(der) ->
        try do
          :public_key.pkix_decode_cert(der, :otp)
          true
        rescue
          _ -> false
        end

      _ ->
        false
    end)
  end

  defp valid_roots?(_), do: false
  defp invalid!(:mode), do: raise(ArgumentError, "invalid identity startup: mode")
  defp invalid!(:role), do: raise(ArgumentError, "invalid identity startup: role")

  defp invalid!(:configuration),
    do: raise(ArgumentError, "invalid identity startup: configuration")

  defp invalid!(:ca_roots), do: raise(ArgumentError, "invalid identity startup: ca_roots")

  defp invalid!(:unexpected_configuration),
    do: raise(ArgumentError, "invalid identity startup: unexpected_configuration")
end

