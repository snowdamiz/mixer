  defp artifact?(%ArtifactRef{} = ref),
    do:
      exact?(Map.from_struct(ref), [:kind, :sha256, :size_bytes]) and
        ref.kind in @artifact_kinds and sha?(ref.sha256) and
        integer?(ref.size_bytes, 1, @max_time)

