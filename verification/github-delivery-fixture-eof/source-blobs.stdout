          "octet_length(issuer_hash)=32",
          "octet_length(subject_hash)=32",
          "octet_length(client_hash)=32",
          "octet_length(credential_hash)=32",
          "(sequence=1 AND operation='bootstrap' AND old_revision IS NULL AND old_epoch IS NULL AND old_status IS NULL AND new_revision=1 AND new_epoch=1 AND new_status='preauth' AND outcome='created') OR (sequence>1 AND old_revision IS NOT NULL AND old_revision BETWEEN 1 AND 9007199254740991 AND old_epoch IS NOT NULL AND old_epoch BETWEEN 1 AND 9007199254740991 AND old_status IS NOT NULL AND old_status IN('preauth','active') AND ((operation='begin' AND outcome='pending' AND new_status=old_status AND new_revision=old_revision+1 AND new_epoch=old_epoch+1) OR (operation='claim' AND outcome='claimed' AND new_status=old_status AND new_revision=old_revision AND new_epoch=old_epoch) OR (operation='provider_reject' AND outcome='provider_rejected' AND new_status=old_status AND new_revision=old_revision AND new_epoch=old_epoch) OR (operation='fail_claim' AND outcome='failed' AND new_status=old_status AND new_revision=old_revision AND new_epoch=old_epoch) OR (operation='activate' AND outcome='active' AND old_status='preauth' AND new_status='active' AND new_revision=old_revision+1 AND new_epoch=old_epoch+1) OR (operation='replace' AND outcome='active' AND old_status='active' AND new_status='active' AND new_revision=old_revision+1 AND new_epoch=old_epoch+1) OR (operation='logout' AND outcome='revoked' AND new_status='revoked' AND new_revision=old_revision+1 AND new_epoch=old_epoch+1) OR (operation='expire' AND outcome='expired' AND new_status='expired' AND new_revision=old_revision+1 AND new_epoch=old_epoch+1)))",
          "(operation IN('activate','replace') AND token_issued_at IS NOT NULL AND token_expires_at>token_issued_at AND issuer_hash IS NOT NULL AND subject_hash IS NOT NULL AND client_hash IS NOT NULL AND credential_hash IS NOT NULL) OR (operation NOT IN('activate','replace') AND token_issued_at IS NULL AND token_expires_at IS NULL AND issuer_hash IS NULL AND subject_hash IS NULL AND client_hash IS NULL AND credential_hash IS NULL)"
        ],
