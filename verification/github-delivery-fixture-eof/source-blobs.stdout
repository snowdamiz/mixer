  test "maximum admitted payload succeeds under unchanged production transaction bounds" do
    {c, config} = F.data()
    {public, private} = :crypto.generate_key(:eddsa, :ed25519)
    payload = :binary.copy(<<42>>, 4_194_304)
    digest = Base.encode16(:crypto.hash(:sha256, payload), case: :lower)

    manifest =
      c.manifest
      |> Map.put("payload_sha256", digest)
      |> Map.put("compressed_bytes", byte_size(payload))
      |> Map.put("expanded_bytes", byte_size(payload))

    {:ok, cbor} = ArtifactCBOR.encode(manifest)
    signature = :crypto.sign(:eddsa, :none, "mixer.artifact.v3\0" <> cbor, [private, :ed25519])

    envelope =
      Jason.encode!(%{
        "signed_manifest" => %{"manifest" => manifest, "signature" => Base.encode64(signature)},
        "payload" => Base.encode64(payload)
      })

    config = %{config | roots: Enum.map(config.roots, &Map.put(&1, "public_key", public))}
    {:ok, checked} = ArtifactAdmission.admit(envelope, config.host, config.roots, F.now())

    assert {:ok, %{status: 201}} =
             F.run(fn ctx -> PostgresStorage.upload(ctx, checked, F.command(), config) end)

    assert [[4_194_304]] =
             F.sql("SELECT octet_length(payload) FROM public.mixer_customer_artifacts").rows
  end

  test "literal reserved role prefix permits a benign pgordinary membership and rejects actual predefined indirect NOINHERIT paths" do
    F.sql(
      "CREATE ROLE pgordinary NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS"
    )

    F.sql("GRANT pgordinary TO storage_runtime")

    try do
      assert {:ok, _} = F.upload()

      F.sql(
        "CREATE ROLE storage_indirect NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS"
      )

      F.sql("GRANT pg_monitor TO storage_indirect")
      F.sql("GRANT storage_indirect TO storage_runtime")

      try do
        assert {:error, :authorization_unavailable} = F.upload()
      after
        F.sql("REVOKE storage_indirect FROM storage_runtime")
        F.sql("REVOKE pg_monitor FROM storage_indirect")
        F.sql("DROP ROLE storage_indirect")
      end
    after
      F.sql("REVOKE pgordinary FROM storage_runtime")
      F.sql("DROP ROLE pgordinary")
    end

    assert {:ok, %{event_sequence: 1}} = F.upload()
  end
end

