defmodule MixerHosted.Billing.WebhookTransportTest.ForbiddenAdapter do
  def get_http_protocol(_) do
    send(self(), :forbidden_adapter_read)
    raise "synthetic private adapter protocol"
  end

  def read_req_body(_, _) do
    send(self(), :forbidden_adapter_read)
    raise "synthetic private adapter body"
  end
end

defmodule MixerHosted.Billing.WebhookTransportTest do
  use ExUnit.Case, async: false
  alias MixerHosted.Billing.WebhookTransport, as: Transport
  alias MixerHosted.Billing.WebhookTransport.Sinks

  defp report(overrides \\ %{}) do
    Map.merge(
      %{mixer_transport: 1, event: :webhook_transport, reason: :rejected, count: 1},
      overrides
    )
  end

  test "safe counters reconstruct message and metadata without forwarding private fields" do
    original = %{
      level: :emergency,
      msg: {:report, report()},
      meta: %{
        body: "private body",
        signature: "private signature",
        pid: self(),
        file: "private path"
      },
      private: %{request: "private request"}
    }

    assert Sinks.filter(original, nil) == %{
             level: :notice,
             msg: {:report, %{event: :webhook_transport, reason: :rejected, count: 1}},
             meta: %{domain: [:mixer_private_transport]}
           }
  end

  test "raw messages and reports with additional private fields are dropped" do
    for message <- [
          {:string, "private request body"},
          {"private format ~p", ["private signature"]},
          {:report, %{body: "private body"}},
          {:report, Map.put(report(), :body, "private body")},
          {:report, Map.put(report(), :query, "private query")},
          {:report, Map.put(report(), :error, {RuntimeError, "private error"})},
          {:report, [mixer_transport: 1, event: :webhook_transport, reason: :rejected, count: 1]}
        ] do
      assert :stop == Sinks.filter(%{level: :error, msg: message, meta: %{body: "private"}}, nil)
    end
  end

  test "counters accept finite integer endpoints and reject unbounded or unknown schema" do
    for count <- [0, 2_147_483_647] do
      assert %{msg: {:report, %{count: ^count}}} =
               Sinks.filter(%{msg: {:report, report(%{count: count})}}, nil)
    end

    for changes <- [
          %{count: -1},
          %{count: 2_147_483_648},
          %{count: 1.0},
          %{count: "1"},
          %{count: nil},
          %{reason: "rejected"},
          %{reason: :private_unknown},
          %{event: :request},
          %{mixer_transport: 2}
        ] do
      assert :stop == Sinks.filter(%{msg: {:report, report(changes)}}, nil)
    end
  end

  test "filter does not invoke an arbitrary report callback" do
    callback = fn ->
      send(self(), :private_callback_invoked)
      "private body"
    end

    assert :stop == Sinks.filter(%{msg: {:report, callback}, meta: %{report_cb: callback}}, nil)
    refute_received :private_callback_invoked
  end

  test "ordinary application leaves private transport inactive" do
    assert Process.whereis(Transport.Owner) == nil
    assert Process.whereis(Transport.Sinks) == nil
    assert Process.whereis(Transport.Guards) == nil
  end

  test "absent role and permit fail before any request adapter call" do
    assert Process.whereis(Transport.Owner) == nil
    Process.delete({Transport, :permit})
    conn = %Plug.Conn{adapter: {__MODULE__.ForbiddenAdapter, %{body: "private body"}}}
    assert catch_exit(Transport.capture(conn)) == :private_transport_failure
    refute_received :forbidden_adapter_read
    assert Process.get({Transport, :permit}) == nil
  end

  test "forged process-local permit cannot authorize capture without the role" do
    assert Process.whereis(Transport.Owner) == nil
    Process.put({Transport, :permit}, {make_ref(), make_ref(), make_ref()})

    try do
      conn = %Plug.Conn{adapter: {__MODULE__.ForbiddenAdapter, %{body: "private body"}}}
      assert catch_exit(Transport.capture(conn)) == :private_transport_failure
      refute_received :forbidden_adapter_read
    after
      Process.delete({Transport, :permit})
    end
  end
end

a42ffb50dd951fa78b86833319b39e266b0fd314 blob 17926
defmodule MixerHosted.BrowserAuth.ActivationPreparationTest do
  use ExUnit.Case, async: true
  import ExUnit.CaptureLog
  alias MixerHosted.BrowserAuth.{ActivationPreparation, StoredSnapshot, Vault}

  @error {:error, :session_unavailable}
  @max_integer 9_007_199_254_740_991
  @csrf Base.url_encode64(:binary.copy(<<11>>, 32), padding: false)
  @verifier Base.url_encode64(:binary.copy(<<12>>, 32), padding: false)
  @generation Base.url_encode64(:binary.copy(<<13>>, 32), padding: false)
  @replacement Base.url_encode64(:binary.copy(<<14>>, 32), padding: false)
  @revision_fields ~w(profile_revision binding_revision principal_revision)

  defp raw(byte, size \\ 32), do: :binary.copy(<<byte>>, size)
  defp hex(bytes), do: "\\x" <> Base.encode16(bytes, case: :lower)

  defp key do
    {:ok, key} = Vault.key("preparation-fixture-key", raw(42))
    key
  end

  defp context(kind) do
    %{
      purpose: kind,
      browser_id: raw(1, 16),
      cookie_digest: raw(2),
      csrf_digest: :crypto.hash(:sha256, @csrf),
      epoch: 2,
      revision: 2,
      generation: @generation,
      vault_generation: 2,
      config_digest: raw(3),
      profile_id: "human-main",
      profile_version: 1,
      principal_id: if(kind == :active, do: "old-principal"),
      family_id: if(kind == :active, do: "old-family"),
      credential_ref: if(kind == :active, do: "old-credential"),
      credential_revision: if(kind == :active, do: 1)
    }
  end

  defp cipher(context, plaintext) do
    {:ok, sealed} = Vault.seal(key(), context, plaintext)

    %{
      "ciphertext_version" => sealed.version,
      "key_id" => sealed.key_id,
      "iv" => hex(sealed.iv),
      "tag" => hex(sealed.tag),
      "ciphertext" => hex(sealed.ciphertext)
    }
  end

  defp fixture(kind \\ :preauth) do
    c = context(kind)

    plaintext =
      if kind == :preauth,
        do: %Vault.Preauth{csrf: @csrf},
        else: %Vault.Active{csrf: @csrf, access_token: "fixture.access-token.secret"}

    browser = %{
      "id" => hex(c.browser_id),
      "cookie_digest" => hex(c.cookie_digest),
      "status" => Atom.to_string(kind),
      "epoch" => c.epoch,
      "revision" => c.revision,
      "generation" => c.generation,
      "csrf_digest" => hex(c.csrf_digest),
      "created_at" => 100,
      "last_seen_at" => 101,
      "absolute_expires_at" => 1000,
      "idle_expires_at" => 700,
      "expected_profile_id" => c.profile_id,
      "expected_profile_version" => c.profile_version,
      "initial_config_digest" => hex(c.config_digest),
      "config_digest" => hex(c.config_digest),
      "profile_id" => if(kind == :active, do: c.profile_id),
      "profile_version" => if(kind == :active, do: c.profile_version),
      "principal_id" => c.principal_id,
      "family_id" => c.family_id,
      "credential_ref" => c.credential_ref,
      "credential_revision" => c.credential_revision,
      "audit_sequence" => c.revision
    }

    vault =
      Map.merge(cipher(c, plaintext), %{
        "browser_id" => hex(c.browser_id),
        "epoch" => c.epoch,
        "session_revision" => c.revision,
        "vault_generation" => c.vault_generation,
        "envelope_kind" => Atom.to_string(kind)
      })

    attempt = %{
      "state_digest" => hex(raw(4)),
      "browser_id" => hex(c.browser_id),
      "cookie_digest" => hex(c.cookie_digest),
      "browser_epoch" => c.epoch,
      "browser_revision" => c.revision,
      "generation" => c.generation,
      "config_digest" => hex(c.config_digest),
      "profile_id" => c.profile_id,
      "profile_version" => c.profile_version,
      "issuer" => "https://identity.example.test",
      "client_id" => "console-client",
      "redirect_uri" => "https://console.example.test/auth/callback",
      "return_route" => "workspace",
      "nonce_digest" => hex(raw(5)),
      "created_at" => 110,
      "expires_at" => 400,
      "status" => "claimed",
      "claim_digest" => hex(raw(6)),
      "claimed_at" => 120,
      "claim_expires_at" => 180,
      "completion_reason" => nil,
      "ciphertext_version" => 1,
      "key_id" => nil,
      "iv" => nil,
      "tag" => nil,
      "ciphertext" => nil
    }

    %{
      "version" => 1,
      "snapshot" => %{"browser" => browser, "vault" => vault, "attempt" => attempt},
      "principal_id" => "incoming-principal",
      "profile_revision" => 7,
      "binding_revision" => 11,
      "principal_revision" => 13
    }
  end

  defp pending(input) do
    a = input["snapshot"]["attempt"]

    context = %{
      purpose: :attempt,
      state_digest: raw(4),
      browser_id: raw(1, 16),
      cookie_digest: raw(2),
      epoch: 2,
      revision: 2,
      generation: @generation,
      config_digest: raw(3),
      profile_id: a["profile_id"],
      profile_version: a["profile_version"],
      issuer: a["issuer"],
      client_id: a["client_id"],
      redirect_uri: a["redirect_uri"],
      expires_at: a["expires_at"]
    }

    attempt =
      Map.merge(a, cipher(context, %Vault.Verifier{verifier: @verifier}))
      |> Map.merge(%{
        "status" => "pending",
        "claim_digest" => nil,
        "claimed_at" => nil,
        "claim_expires_at" => nil
      })

    put_in(input, ["snapshot", "attempt"], attempt)
  end

  defp provider_rejected(input) do
    update_in(input, ["snapshot", "attempt"], fn attempt ->
      Map.merge(attempt, %{
        "status" => "provider_rejected",
        "claim_digest" => nil,
        "claimed_at" => nil,
        "claim_expires_at" => nil,
        "completion_reason" => "provider_rejected"
      })
    end)
  end

  defp completed do
    input = fixture(:active)

    c = %{
      context(:active)
      | epoch: 3,
        revision: 3,
        vault_generation: 3,
        cookie_digest: raw(7),
        generation: @replacement
    }

    input
    |> update_in(["snapshot", "browser"], fn browser ->
      Map.merge(browser, %{
        "epoch" => c.epoch,
        "revision" => c.revision,
        "audit_sequence" => 4,
        "cookie_digest" => hex(c.cookie_digest),
        "generation" => c.generation
      })
    end)
    |> update_in(["snapshot", "vault"], fn vault ->
      Map.merge(vault, cipher(c, %Vault.Active{csrf: @csrf, access_token: "new.access-token"}))
      |> Map.merge(%{"epoch" => 3, "session_revision" => 3, "vault_generation" => 3})
    end)
    |> put_in(["snapshot", "attempt", "status"], "completed")
    |> put_in(["snapshot", "attempt", "completion_reason"], "completed")
  end

  test "claimed preauth and active projections retain the complete decoded snapshot" do
    for kind <- [:preauth, :active] do
      input = fixture(kind)
      assert {:ok, expected} = StoredSnapshot.decode(input["snapshot"])
      assert {:ok, %ActivationPreparation{} = decoded} = ActivationPreparation.decode(input)
      assert decoded.snapshot === expected
      assert decoded.snapshot.attempt["status"] == "claimed"
      assert decoded.snapshot.attempt_envelope == nil
      assert decoded.snapshot.attempt["claim_digest"] == raw(6)
      assert decoded.snapshot.session_envelope.context == context(kind)

      assert Map.from_struct(decoded) == %{
               version: 1,
               snapshot: expected,
               principal_id: "incoming-principal",
               profile_revision: 7,
               binding_revision: 11,
               principal_revision: 13
             }

      assert {:ok, plaintext} =
               Vault.open(
                 key(),
                 expected.session_envelope.context,
                 expected.session_envelope.sealed
               )

      assert plaintext.csrf == @csrf
    end
  end

  test "non-map and structurally unrelated inputs return only the session error" do
    for input <- [nil, true, false, 1, 1.0, "secret", [], [fixture()], {:ok, fixture()}, self()] do
      assert ActivationPreparation.decode(input) === @error
    end
  end

  test "every top-level field is required" do
    input = fixture()

    for field <- Map.keys(input) do
      assert ActivationPreparation.decode(Map.delete(input, field)) === @error
    end
  end

  test "extra keys atom aliases and forged structures fail closed" do
    input = fixture()

    for field <- ["extra", :extra, :__struct__, "__struct__", :version, :snapshot] do
      assert ActivationPreparation.decode(Map.put(input, field, "secret")) === @error
    end

    for field <- Map.keys(input) do
      alias_input = input |> Map.delete(field) |> Map.put(String.to_atom(field), input[field])
      assert ActivationPreparation.decode(alias_input) === @error
    end

    assert ActivationPreparation.decode(%{
             __struct__: ActivationPreparation,
             version: 1,
             snapshot: input["snapshot"],
             principal_id: input["principal_id"],
             profile_revision: 7,
             binding_revision: 11,
             principal_revision: 13
           }) === @error
  end

  test "version admits only exact integer one" do
    input = fixture()

    for value <- [nil, 0, -1, 2, 1.0, true, "1", :v1, [], %{}] do
      assert ActivationPreparation.decode(Map.put(input, "version", value)) === @error
    end
  end

  test "principal text rejects invalid types empty excess bytes NUL and malformed UTF8" do
    input = fixture()

    for value <- [
          nil,
          true,
          1,
          :principal,
          [],
          %{},
          "",
          String.duplicate("p", 129),
          String.duplicate("é", 65),
          "principal\0secret",
          <<0>>,
          <<255>>,
          <<195>>
        ] do
      assert ActivationPreparation.decode(Map.put(input, "principal_id", value)) === @error
    end
  end

  test "principal text follows existing byte-bound UTF8 semantics without normalization" do
    input = fixture()

    for value <- ["p", String.duplicate("p", 128), String.duplicate("é", 64), " ", "a\nb"] do
      assert {:ok, decoded} = ActivationPreparation.decode(Map.put(input, "principal_id", value))
      assert decoded.principal_id === value
    end
  end

  test "every provisional revision rejects non-positive unsafe and non-integer values" do
    input = fixture()

    for field <- @revision_fields,
        value <- [
          nil,
          0,
          -1,
          1.0,
          "1",
          true,
          [],
          %{},
          @max_integer + 1,
          1_000_000_000_000_000_000
        ] do
      assert ActivationPreparation.decode(Map.put(input, field, value)) === @error
    end
  end

  test "revision bounds are independent positive safe53 integers" do
    input = fixture()

    for field <- @revision_fields, value <- [1, @max_integer] do
      assert {:ok, decoded} = ActivationPreparation.decode(Map.put(input, field, value))
      assert Map.fetch!(decoded, String.to_existing_atom(field)) === value
    end
  end

  test "all nested object boundaries delegate exact-key and type admission" do
    input = fixture()

    for path <- [
          ["snapshot"],
          ["snapshot", "browser"],
          ["snapshot", "vault"],
          ["snapshot", "attempt"]
        ] do
      row = get_in(input, path)

      for field <- Map.keys(row) do
        assert ActivationPreparation.decode(put_in(input, path, Map.delete(row, field))) ===
                 @error
      end

      for value <- [
            nil,
            [],
            "secret",
            0,
            Map.put(row, "extra", "secret"),
            Map.put(row, :__struct__, StoredSnapshot)
          ] do
        assert ActivationPreparation.decode(put_in(input, path, value)) === @error
      end
    end

    assert {:ok, decoded} = StoredSnapshot.decode(input["snapshot"])
    assert ActivationPreparation.decode(Map.put(input, "snapshot", decoded)) === @error
  end

  test "valid snapshots with absent pending rejected or completed attempts are unavailable" do
    input = fixture()

    for candidate <- [
          put_in(input, ["snapshot", "attempt"], nil),
          pending(input),
          provider_rejected(input),
          completed()
        ] do
      assert {:ok, %StoredSnapshot{}} = StoredSnapshot.decode(candidate["snapshot"])
      assert ActivationPreparation.decode(candidate) === @error
    end
  end

  test "claimed attempt ciphertext must already be erased" do
    input = fixture()

    for field <- ~w(key_id iv tag ciphertext), value <- ["retained-secret", "", false] do
      assert ActivationPreparation.decode(put_in(input, ["snapshot", "attempt", field], value)) ===
               @error
    end

    assert ActivationPreparation.decode(
             put_in(input, ["snapshot", "attempt_envelope"], "retained-secret")
           ) === @error
  end

  test "nested browser vault and attempt disagreement is rejected" do
    input = fixture()

    for {path, value} <- [
          {["snapshot", "vault", "browser_id"], hex(raw(9, 16))},
          {["snapshot", "vault", "epoch"], 3},
          {["snapshot", "vault", "session_revision"], 3},
          {["snapshot", "vault", "envelope_kind"], "active"},
          {["snapshot", "attempt", "browser_id"], hex(raw(9, 16))},
          {["snapshot", "attempt", "browser_epoch"], 3},
          {["snapshot", "attempt", "browser_revision"], 3},
          {["snapshot", "attempt", "cookie_digest"], hex(raw(9))},
          {["snapshot", "attempt", "generation"], @replacement},
          {["snapshot", "attempt", "config_digest"], hex(raw(9))},
          {["snapshot", "attempt", "profile_id"], "other-profile"},
          {["snapshot", "attempt", "profile_version"], 2},
          {["snapshot", "attempt", "profile_version"], 1.0}
        ] do
      assert ActivationPreparation.decode(put_in(input, path, value)) === @error
    end
  end

  test "claimed attempt digest times completion and version remain closed" do
    input = fixture()

    for {field, value} <- [
          {"claim_digest", nil},
          {"claim_digest", hex(raw(6, 31))},
          {"claim_digest", "\\xAB"},
          {"claimed_at", 109},
          {"claimed_at", 120.0},
          {"claim_expires_at", 120},
          {"claim_expires_at", 181},
          {"claim_expires_at", 401},
          {"completion_reason", "completed"},
          {"status", "unclaimed"},
          {"ciphertext_version", 2},
          {"ciphertext_version", 1.0}
        ] do
      assert ActivationPreparation.decode(put_in(input, ["snapshot", "attempt", field], value)) ===
               @error
    end
  end

  test "malformed session ciphertext and bytea encodings map to the same error" do
    input = fixture()

    for {field, value} <- [
          {"iv", nil},
          {"iv", hex(raw(1, 11))},
          {"tag", hex(raw(1, 17))},
          {"tag", "\\x" <> String.duplicate("AB", 16)},
          {"ciphertext", "\\x"},
          {"ciphertext", hex(raw(1, 8193))},
          {"key_id", "invalid:key"},
          {"ciphertext_version", 2}
        ] do
      assert ActivationPreparation.decode(put_in(input, ["snapshot", "vault", field], value)) ===
               @error
    end
  end

  test "redacted Inspect reveals no snapshot principal revision or ciphertext metadata" do
    input = fixture(:active)
    assert {:ok, decoded} = ActivationPreparation.decode(input)
    inspected = inspect(decoded, limit: :infinity, printable_limit: :infinity)
    assert inspected == "#MixerHosted.BrowserAuth.ActivationPreparation<...>"

    for value <- [
          input["principal_id"],
          input["snapshot"]["browser"]["principal_id"],
          input["snapshot"]["browser"]["credential_ref"],
          @generation,
          @csrf,
          "preparation-fixture-key",
          input["snapshot"]["vault"]["ciphertext"],
          "profile_revision",
          "binding_revision",
          "principal_revision"
        ] do
      refute inspected =~ value
    end
  end

  test "failures return no supplied secrets and decoding emits no log messages" do
    input = fixture()
    secret = "decoder-error-secret"

    assert capture_log(fn ->
             for candidate <- [
                   Map.put(input, "principal_id", secret <> "\0"),
                   Map.put(input, "profile_revision", secret),
                   put_in(input, ["snapshot", "attempt", "ciphertext"], secret),
                   put_in(input, ["snapshot", "vault", "key_id"], secret <> ":"),
                   Map.put(input, "unknown", secret)
                 ] do
               assert ActivationPreparation.decode(candidate) === @error
               refute inspect(ActivationPreparation.decode(candidate)) =~ secret
             end
           end) == ""
  end

  test "shape acceptance authenticates neither ciphertext nor freshness" do
    input = put_in(fixture(), ["snapshot", "vault", "tag"], hex(raw(9, 16)))
    assert {:ok, decoded} = ActivationPreparation.decode(input)
    envelope = decoded.snapshot.session_envelope
    assert Vault.open(key(), envelope.context, envelope.sealed) == {:error, :vault_unavailable}
    assert decoded.snapshot.browser["absolute_expires_at"] == 1000
    assert decoded.snapshot.attempt["claim_expires_at"] == 180
  end

  test "provisional metadata is not bound to old active identity or owner-retained evidence" do
    input = fixture(:active)
    assert {:ok, decoded} = ActivationPreparation.decode(input)
    assert decoded.snapshot.browser["principal_id"] == "old-principal"
    assert decoded.principal_id == "incoming-principal"

    changed =
      input
      |> Map.put("principal_id", "other-provisional-principal")
      |> Map.put("profile_revision", 19)
      |> Map.put("binding_revision", 23)
      |> Map.put("principal_revision", 29)

    assert {:ok, other} = ActivationPreparation.decode(changed)
    assert other.snapshot === decoded.snapshot
    assert other.principal_id == "other-provisional-principal"
    assert other.profile_revision == 19
    assert other.binding_revision == 23
    assert other.principal_revision == 29
  end
end

6208a6fb335ec9c2baf9f4433ee0505740fcfd00 blob 15194
defmodule MixerHosted.BrowserAuth.ConfigTest do
  use ExUnit.Case, async: true
  alias MixerHosted.BrowserAuth.Config
  alias MixerHosted.Identity.{Manifest, StartupConfig}

  def object do
    %{
      "version" => 1,
      "public_origin" => "https://console.example.invalid",
      "profile_id" => "human-main",
      "profile_version" => 7,
      "issuer" => "https://identity.example.invalid/tenant",
      "client_id" => "mixer-console",
      "api_audience" => "mixer-api",
      "authorization_endpoint" => "https://identity.example.invalid/authorize",
      "token_endpoint" => "https://identity.example.invalid/token",
      "id_token_jwks_endpoint" => "https://identity.example.invalid/oidc/keys",
      "redirect_uri" => "https://console.example.invalid/auth/callback",
      "client_auth_method" => "client_secret_basic",
      "client_credential_ref" => "secret://mixer/oidc/client-v1",
      "session_vault_ref" => "vault://mixer/browser-session-v1",
      "scope" => "openid mixer.workspace.read",
      "response_mode" => "query",
      "response_iss_required" => true
    }
  end

  def identity do
    %StartupConfig{
      mode: :configured,
      owner_options: [
        binding: "human-main",
        generation: 1,
        manifest: [
          %{
            profile: %{
              profile_id: "human-main",
              profile_version: 7,
              issuer: "https://identity.example.invalid/tenant",
              audience: "mixer-api",
              client_id: "mixer-console",
              identity_class: :human,
              enabled: true
            },
            jwks_endpoint: %{host: "identity.example.invalid", port: 443, path: "/api/keys"},
            transport: :hosted_https
          }
        ]
      ]
    }
  end

  def load(object \\ object(), identity \\ identity()) do
    Config.load(
      %{
        "MIXER_BROWSER_AUTH_MODE" => "configured",
        "MIXER_BROWSER_AUTH_CONFIG" => Jason.encode!(object)
      },
      :api,
      identity
    )
  end

  def config do
    {:ok, config} = load()
    config
  end

  defp matching_identity(object) do
    original = identity()
    [entry] = original.owner_options[:manifest]

    profile = %{
      entry.profile
      | profile_id: object["profile_id"],
        issuer: object["issuer"],
        client_id: object["client_id"],
        audience: object["api_audience"]
    }

    options =
      original.owner_options
      |> Keyword.put(:binding, profile.profile_id)
      |> Keyword.put(:manifest, [%{entry | profile: profile}])

    %{original | owner_options: options}
  end

  test "default and explicit disabled modes start no capability on either role" do
    for role <- [:api, :processor], env <- [%{}, %{"MIXER_BROWSER_AUTH_MODE" => "disabled"}] do
      assert {:ok, %Config{mode: :disabled, issuer: nil}} = Config.load(env, role, nil)
    end
  end

  test "disabled rejects even empty or nil stray browser configuration" do
    for value <- [nil, "", "{}"], role <- [:api, :processor] do
      assert {:error, :unexpected_configuration} =
               Config.load(%{"MIXER_BROWSER_AUTH_CONFIG" => value}, role, identity())
    end
  end

  test "invalid modes roles and missing configured data fail closed" do
    for mode <- [nil, true, :configured, "", "CONFIGURED", "enabled"] do
      assert {:error, :invalid_mode} =
               Config.load(%{"MIXER_BROWSER_AUTH_MODE" => mode}, :api, identity())
    end

    assert {:error, :invalid_role} =
             Config.load(%{"MIXER_BROWSER_AUTH_MODE" => "configured"}, :processor, identity())

    assert {:error, :invalid_configuration} =
             Config.load(%{"MIXER_BROWSER_AUTH_MODE" => "configured"}, :api, identity())

    assert {:error, :invalid_configuration} = Config.load(%{}, :arbitrary, identity())
    assert {:error, :invalid_configuration} = Config.load([], :api, identity())
  end

  test "configured client preserves exact trusted binding and fixed policy" do
    assert {:ok, config} = load()
    assert config.mode == :configured
    assert config.profile_id == "human-main"
    assert config.profile_version == 7
    assert config.return_path == "/workspace"
    assert config.failure_path == "/login"
    assert config.redirect_uri == config.public_origin <> "/auth/callback"
    assert config.transaction_seconds == 300
    assert config.session_idle_seconds == 900
    assert config.client_auth_method == :client_secret_basic
    assert inspect(config) == "#MixerHosted.BrowserAuth.Config<mode: :configured, ...>"
  end

  test "matched trusted metadata rejects NUL before constructing a SQL or Vault config" do
    for key <- ~w(profile_id client_id api_audience),
        value <- [<<0>>, <<0>> <> "metadata", "meta" <> <<0>> <> "data", "metadata" <> <<0>>] do
      object = Map.put(object(), key, value)
      identity = matching_identity(object)

      # The existing identity contract admits these exact bounded UTF-8 values.
      # A matching manifest therefore cannot explain the browser denial.
      assert {:ok, _} = Manifest.validate(identity.owner_options[:manifest])
      assert {:error, :invalid_configuration} = load(object, identity)
    end
  end

  test "matched metadata preserves exact non-NUL Unicode and existing control-byte policy" do
    for key <- ~w(profile_id client_id api_audience),
        value <- ["x", "é", "e\u0301", "值😀", "tab\tline\nreturn\r" <> <<1, 127>>] do
      object = Map.put(object(), key, value)
      assert {:ok, config} = load(object, matching_identity(object))
      assert Map.fetch!(config, String.to_existing_atom(key)) == value
    end
  end

  test "matched metadata bounds count UTF-8 bytes with exact endpoints" do
    for {key, limit} <- [{"profile_id", 128}, {"client_id", 256}, {"api_audience", 256}],
        value <- [String.duplicate("a", limit), String.duplicate("é", div(limit, 2))] do
      object = Map.put(object(), key, value)
      assert byte_size(value) == limit
      assert {:ok, config} = load(object, matching_identity(object))
      assert Map.fetch!(config, String.to_existing_atom(key)) == value

      for invalid <- ["", value <> "a"] do
        invalid_object = Map.put(object, key, invalid)

        assert {:error, :invalid_configuration} =
                 load(invalid_object, matching_identity(invalid_object))
      end
    end
  end

  test "malformed UTF-8 metadata fails with a fixed error in JSON and trusted manifests" do
    for key <- ~w(profile_id client_id api_audience),
        malformed <- [<<255>>, <<195>>, <<192, 128>>, <<237, 160, 128>>] do
      invalid_object = Map.put(object(), key, malformed)

      assert {:error, :invalid_configuration} =
               load(object(), matching_identity(invalid_object))

      raw =
        object()
        |> Jason.encode!()
        |> :binary.replace(Jason.encode!(object()[key]), <<?", malformed::binary, ?">>)

      assert {:error, :invalid_configuration} =
               Config.load(
                 %{"MIXER_BROWSER_AUTH_MODE" => "configured", "MIXER_BROWSER_AUTH_CONFIG" => raw},
                 :api,
                 matching_identity(invalid_object)
               )
    end
  end

  test "URL reference and fixed text fields already reject NUL in configured JSON" do
    for {key, value} <- object(),
        is_binary(value),
        key not in ~w(profile_id client_id api_audience) do
      object = Map.put(object(), key, value <> <<0>>)
      assert {:error, :invalid_configuration} = load(object, matching_identity(object))
    end
  end

  test "whole JSON byte limit still accepts an exact valid document and rejects one byte more" do
    raw = Jason.encode!(object())
    padded = raw <> String.duplicate(" ", 16_384 - byte_size(raw))

    for {input, expected} <- [{padded, :ok}, {padded <> " ", :error}] do
      result =
        Config.load(
          %{"MIXER_BROWSER_AUTH_MODE" => "configured", "MIXER_BROWSER_AUTH_CONFIG" => input},
          :api,
          identity()
        )

      assert elem(result, 0) == expected
      if expected == :error, do: assert(result == {:error, :invalid_configuration})
    end
  end

  test "every missing key and every extra client-controlled choice is rejected" do
    for key <- Map.keys(object()) do
      assert {:error, :invalid_configuration} = load(Map.delete(object(), key))
    end

    for key <-
          ~w(client_secret vault_key return_to return_routes return_path failure_path audience prompt tenant nonce state discovery_url cookie_policy timeouts) do
      assert {:error, :invalid_configuration} =
               load(Map.put(object(), key, "untrusted-sensitive-value"))
    end
  end

  test "duplicate and escaped-equivalent JSON keys are not collapsed" do
    raw = Jason.encode!(object())

    for suffix <- [~s(,"client_id":"other"}), ~s(,"client_\u0069d":"other"})] do
      duplicate = binary_part(raw, 0, byte_size(raw) - 1) <> suffix

      assert {:error, :invalid_configuration} =
               Config.load(
                 %{
                   "MIXER_BROWSER_AUTH_MODE" => "configured",
                   "MIXER_BROWSER_AUTH_CONFIG" => duplicate
                 },
                 :api,
                 identity()
               )
    end
  end

  test "configuration is bounded before JSON decode and rejects malformed payload types" do
    for raw <- [nil, 1, "[]", "{", <<255>>, String.duplicate(" ", 16_385)] do
      assert {:error, :invalid_configuration} =
               Config.load(
                 %{"MIXER_BROWSER_AUTH_MODE" => "configured", "MIXER_BROWSER_AUTH_CONFIG" => raw},
                 :api,
                 identity()
               )
    end
  end

  test "identity matching requires exact enabled bound human profile and integer version" do
    for {key, bad} <- [
          {"profile_id", "another"},
          {"profile_version", 8},
          {"profile_version", 7.0},
          {"issuer", "https://identity.example.invalid/other"},
          {"client_id", "other"},
          {"api_audience", "other"}
        ] do
      assert {:error, :invalid_configuration} = load(Map.put(object(), key, bad))
    end

    for identity <- [
          nil,
          %StartupConfig{mode: :disabled, owner_options: []},
          %{mode: :configured, owner_options: identity().owner_options}
        ] do
      assert {:error, :invalid_configuration} = load(object(), identity)
    end
  end

  test "disabled service malformed duplicate or differently bound trust entries cannot enable login" do
    original = identity()
    [entry] = original.owner_options[:manifest]

    for profile <- [
          Map.put(entry.profile, :enabled, false),
          Map.put(entry.profile, :identity_class, :service),
          Map.delete(entry.profile, :issuer)
        ] do
      options = Keyword.put(original.owner_options, :manifest, [%{entry | profile: profile}])

      assert {:error, :invalid_configuration} =
               load(object(), %{original | owner_options: options})
    end

    for options <- [
          Keyword.put(original.owner_options, :binding, "missing"),
          Keyword.put(original.owner_options, :manifest, [entry, entry]),
          [{:binding, "human-main"} | original.owner_options],
          []
        ] do
      assert {:error, :invalid_configuration} =
               load(object(), %{original | owner_options: options})
    end
  end

  test "origins reject credentials paths aliases alternate ports non-DNS and unsafe characters" do
    for bad <- [
          "http://console.example.invalid",
          "https://console.example.invalid/",
          "https://console.example.invalid:443",
          "https://console.example.invalid:444",
          "https://CONSOLE.example.invalid",
          "https://console.example.invalid.",
          "https://console.example.invalid?x",
          "https://console.example.invalid#x",
          "https://user@console.example.invalid",
          "https://127.0.0.1",
          "https://[::1]",
          "https://localhost",
          "https://console%2eexample.invalid",
          "https://console.example.invalid\r\n",
          "https://console..invalid"
        ] do
      assert {:error, :invalid_configuration} = load(Map.put(object(), "public_origin", bad))
    end
  end

  test "endpoints are literal canonical HTTPS paths without discovery query fragments or normalization" do
    for key <- ~w(authorization_endpoint token_endpoint id_token_jwks_endpoint),
        bad <- [
          "https://identity.example.invalid",
          "https://identity.example.invalid:443/token",
          "https://identity.example.invalid/token?client=x",
          "https://identity.example.invalid/token#x",
          "https://identity.example.invalid/a/../token",
          "https://identity.example.invalid//token",
          "https://identity.example.invalid/%74oken",
          "https://identity.example.invalid/token/",
          "https://identity.example.invalid\\token",
          "https://user:secret@identity.example.invalid/token",
          "https://-bad.example.invalid/token",
          123
        ] do
      assert {:error, :invalid_configuration} = load(Map.put(object(), key, bad))
    end
  end

  test "exact redirect cannot become an open redirect or alias" do
    for bad <- [
          "https://elsewhere.example.invalid/auth/callback",
          "/auth/callback",
          "https://console.example.invalid/auth/callback/",
          "https://console.example.invalid/auth/%63allback",
          "https://console.example.invalid:443/auth/callback",
          "https://console.example.invalid/auth/callback?return_to=https://evil.invalid"
        ] do
      assert {:error, :invalid_configuration} = load(Map.put(object(), "redirect_uri", bad))
    end
  end

  test "fixed scopes protocol modes version and confidential method cannot widen" do
    for {key, bad} <- [
          {"scope", "openid mixer.workspace.read offline_access"},
          {"scope", "mixer.workspace.read openid"},
          {"scope", ["openid", "mixer.workspace.read"]},
          {"response_mode", "form_post"},
          {"response_iss_required", false},
          {"version", 1.0},
          {"version", 2},
          {"client_auth_method", "none"},
          {"client_auth_method", "private_key_jwt"},
          {"client_auth_method", "client_secret_post"}
        ] do
      assert {:error, :invalid_configuration} = load(Map.put(object(), key, bad))
    end
  end

  test "secrets are references only and malformed references give fixed sanitized errors" do
    for {key, bad} <- [
          {"client_credential_ref", "raw-client-secret"},
          {"client_credential_ref", "secret://"},
          {"client_credential_ref", "secret://a/../b"},
          {"client_credential_ref", "secret://a?secret=raw"},
          {"client_credential_ref", "secret://a%2fb"},
          {"session_vault_ref", "secret://a"},
          {"session_vault_ref", "vault://a//b"},
          {"session_vault_ref", "vault://" <> String.duplicate("x", 250)}
        ] do
      assert {:error, :invalid_configuration} = load(Map.put(object(), key, bad))
    end

    refute inspect(config()) =~ "secret://"
    refute inspect(config()) =~ "identity.example"
  end
end

5669e2fa8b261206cdb2f52cf405a4433673c957 blob 5649
defmodule MixerHosted.BrowserAuth.ConfigurationDigestTest do
  use ExUnit.Case, async: true
  alias MixerHosted.BrowserAuth.{Config, ConfigurationDigest}
  alias MixerHosted.BrowserAuth.ConfigTest, as: Fixture

  test "constructor configuration has deterministic versioned bytes and a raw SHA256 identity" do
    config = Fixture.config()
    assert {:ok, bytes} = ConfigurationDigest.canonical_bytes(config)
    assert <<"mixer.browser.configuration.v1", 0, json::binary>> = bytes
    assert [1, pairs] = Jason.decode!(json)
    assert length(pairs) == 21

    assert Enum.map(pairs, &hd/1) ==
             ~w(mode public_origin profile_id profile_version issuer client_id api_audience authorization_endpoint token_endpoint id_token_jwks_endpoint redirect_uri client_auth_method client_credential_ref session_vault_ref scope response_mode response_iss_required transaction_seconds session_idle_seconds return_path failure_path)

    assert ["profile_version", 7] in pairs
    assert ["response_iss_required", true] in pairs
    assert ["client_auth_method", "client_secret_basic"] in pairs
    assert {:ok, digest} = ConfigurationDigest.digest(config)
    assert byte_size(digest) == 32
    assert digest == :crypto.hash(:sha256, bytes)
    # Independent fixed-order UTF-8 JSON/SHA-256 baseline. Text admission must
    # not change the version, field order or encoding of valid configurations.
    assert byte_size(bytes) == 910

    assert Base.encode16(digest, case: :lower) ==
             "3116d5ef6ac718b3d2442df3648c60ab3fa1d640f73d429ed2b30490f1e2d7f3"

    assert {:ok, ^digest} = ConfigurationDigest.digest(Fixture.config())
  end

  test "every admitted variable changes the configuration fence without normalization" do
    config = Fixture.config()
    assert {:ok, baseline} = ConfigurationDigest.digest(config)

    for field <-
          ~w(public_origin profile_id issuer client_id api_audience authorization_endpoint token_endpoint id_token_jwks_endpoint redirect_uri client_credential_ref session_vault_ref)a do
      # Fingerprinting binds exact trusted values. Config.load remains the URL/trust validator.
      assert {:ok, other} = ConfigurationDigest.digest(Map.update!(config, field, &(&1 <> "x")))
      assert other != baseline
    end

    assert {:ok, other} = ConfigurationDigest.digest(%{config | profile_version: 8})
    assert other != baseline
    assert {:ok, left} = ConfigurationDigest.digest(%{config | client_id: "é"})
    assert {:ok, right} = ConfigurationDigest.digest(%{config | client_id: "e\u0301"})
    assert left != right
  end

  test "JSON configuration input order and map construction order cannot change identity" do
    object = Fixture.object()

    raw =
      "{" <>
        Enum.map_join(Enum.reverse(Enum.sort(object)), ",", fn {k, v} ->
          Jason.encode!(k) <> ":" <> Jason.encode!(v)
        end) <> "}"

    assert {:ok, config} =
             Config.load(
               %{"MIXER_BROWSER_AUTH_MODE" => "configured", "MIXER_BROWSER_AUTH_CONFIG" => raw},
               :api,
               Fixture.identity()
             )

    assert ConfigurationDigest.digest(config) == ConfigurationDigest.digest(Fixture.config())
    rebuilt = config |> Map.to_list() |> Enum.reverse() |> Map.new()
    assert ConfigurationDigest.digest(rebuilt) == ConfigurationDigest.digest(config)
  end

  test "disabled, unknown fields and future policy choices do not mint a current digest" do
    config = Fixture.config()

    for value <- [
          nil,
          %{},
          %Config{},
          Map.put(config, :client_secret, "private"),
          Map.delete(config, :scope)
        ] do
      assert {:error, :invalid_configuration} = ConfigurationDigest.digest(value)
    end

    for {key, value} <- [
          mode: :disabled,
          client_auth_method: :none,
          scope: "openid",
          response_mode: "form_post",
          response_iss_required: false,
          transaction_seconds: 301,
          session_idle_seconds: 901,
          return_path: "/elsewhere",
          failure_path: "/elsewhere"
        ] do
      assert {:error, :invalid_configuration} =
               ConfigurationDigest.digest(Map.put(config, key, value))
    end
  end

  test "malformed scalar values fail with a fixed error before serialization" do
    config = Fixture.config()

    for value <- [nil, "", 1, %{}, [], <<255>>, String.duplicate("x", 2049)] do
      assert {:error, :invalid_configuration} =
               ConfigurationDigest.digest(%{config | issuer: value})
    end

    for value <- [0, -1, 1.5, "7", 2_147_483_648] do
      assert {:error, :invalid_configuration} =
               ConfigurationDigest.digest(%{config | profile_version: value})
    end

    assert {:error, :invalid_configuration} =
             ConfigurationDigest.digest(%{config | client_id: String.duplicate("a", 257)})
  end

  test "length boundaries and separate fields remain distinct and bounded" do
    config = %{
      Fixture.config()
      | profile_id: String.duplicate("a", 128),
        client_id: String.duplicate("b", 256),
        issuer: String.duplicate("c", 2048)
    }

    assert {:ok, bytes} = ConfigurationDigest.canonical_bytes(config)
    assert byte_size(bytes) < 16_384

    assert {:ok, left} =
             ConfigurationDigest.digest(%{config | client_id: "a", api_audience: "bc"})

    assert {:ok, right} =
             ConfigurationDigest.digest(%{config | client_id: "ab", api_audience: "c"})

    assert left != right

    assert {:error, :invalid_configuration} =
             ConfigurationDigest.digest(%{config | profile_id: config.profile_id <> "a"})
  end
end

