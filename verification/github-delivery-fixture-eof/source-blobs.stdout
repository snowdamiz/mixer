          "generation ~ '^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$'",
          "octet_length(csrf_digest)=32",
          "created_at BETWEEN 0 AND 9007199254740991",
          "last_seen_at >= created_at",
          "absolute_expires_at > created_at AND absolute_expires_at <=9007199254740991",
          "idle_expires_at > created_at AND idle_expires_at <=absolute_expires_at",
