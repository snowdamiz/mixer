defmodule MixerHosted.Identity.RawFixture do
  @moduledoc false
  use GenServer
  def start_link(_), do: GenServer.start_link(__MODULE__, [])
  def info(pid), do: GenServer.call(pid, :info)

  def init(options) do
    Process.flag(:trap_exit, true)

    {:ok, listener} =
      :gen_tcp.listen(0, [:binary, ip: {127, 0, 0, 1}, active: false, reuseaddr: true])

    {:ok, {_, port}} = :inet.sockname(listener)
    owner = self()
    mode = Keyword.get(options, :mode, :stall)
    acceptor = spawn_link(fn -> accept(listener, owner, mode) end)

    {:ok,
     %{
       listener: listener,
       port: port,
       acceptor: acceptor,
       sockets: %{},
       accepted: 0,
       closed: 0,
       max_active: 0
     }}
  end

  defp accept(listener, owner, mode) do
    case :gen_tcp.accept(listener, 100) do
      {:ok, socket} ->
        pid =
          spawn_link(fn ->
            receive do
              :go -> watch(socket, owner, mode)
            end
          end)

        :ok = :gen_tcp.controlling_process(socket, pid)
        send(owner, {:accepted, pid, socket})
        send(pid, :go)
        accept(listener, owner, mode)

      {:error, :timeout} ->
        accept(listener, owner, mode)

      _ ->
        :ok
    end
  end

  defp watch(socket, owner, :plaintext) do
    :gen_tcp.send(socket, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\n{}")
    :gen_tcp.close(socket)
    send(owner, {:closed, self(), System.monotonic_time(:millisecond)})
  end

  defp watch(socket, owner, :stall), do: watch(socket, owner)

  defp watch(socket, owner) do
    case :gen_tcp.recv(socket, 0, 3_000) do
      {:ok, _client_hello} -> watch(socket, owner)
      {:error, :closed} -> send(owner, {:closed, self(), System.monotonic_time(:millisecond)})
      _ -> :ok
    end

    :gen_tcp.close(socket)
  end

  def handle_call(:info, _, s), do: {:reply, Map.drop(s, [:listener, :acceptor, :sockets]), s}

  def handle_info({:accepted, pid, socket}, s),
    do:
      {:noreply,
       %{
         s
         | accepted: s.accepted + 1,
           sockets: Map.put(s.sockets, pid, socket),
           max_active: max(s.max_active, map_size(s.sockets) + 1)
       }}

  def handle_info({:closed, pid, time}, s),
    do:
      {:noreply,
       s
       |> Map.put(:last_close_mono, time)
       |> Map.put(:closed, s.closed + 1)
       |> Map.put(:sockets, Map.delete(s.sockets, pid))}

  def handle_info({:EXIT, _, _}, s), do: {:noreply, s}

  def terminate(_, s) do
    :gen_tcp.close(s.listener)
    Process.exit(s.acceptor, :kill)

    Enum.each(s.sockets, fn {pid, socket} ->
      :gen_tcp.close(socket)
      Process.exit(pid, :kill)
    end)
  end
end

e080477080b886b6aff1870519019c0d42477538 blob 2893
defmodule MixerHosted.Identity.SocketProbe do
  @moduledoc false
  use GenServer
  # Test instrumentation is intentionally tied to the installed OTP29 sslsocket
  # record for measurement only; no product code reads that opaque record.
  def start_link(_), do: GenServer.start_link(__MODULE__, [])
  def info(pid), do: GenServer.call(pid, :info)

  def init(_) do
    Process.send_after(self(), :sample, 1)

    {:ok,
     %{
       sockets: %{},
       seen: 0,
       closed: 0,
       max_active: 0,
       max_ssl_memory: 0,
       max_ssl_binary_bytes: 0,
       max_ssl_mailbox: 0,
       max_socket_recbuf: 0,
       max_transport_buffer: 0
     }}
  end

  def handle_info({:register_raw_socket, worker, _socket, ref}, s) do
    send(worker, {ref, :ok})
    {:noreply, s}
  end

  def handle_info({:register_connection, worker, _raw, _pid, ref}, s) do
    send(worker, {ref, :ok})
    {:noreply, s}
  end

  def handle_info({:register_socket, worker, socket, ref}, s) do
    Process.monitor(worker)
    send(worker, {ref, :ok})

    s = %{
      s
      | sockets: Map.put(s.sockets, worker, socket),
        seen: s.seen + 1,
        max_active: max(s.max_active, map_size(s.sockets) + 1)
    }

    {:noreply, sample(s)}
  end

  def handle_info(:sample, s) do
    Process.send_after(self(), :sample, 1)
    {:noreply, sample(s)}
  end

  def handle_info({:DOWN, _, :process, worker, _}, s) do
    socket = s.sockets[worker]

    closed =
      case :ssl.peername(socket) do
        {:error, _} -> 1
        _ -> 0
      end

    {:noreply, %{s | sockets: Map.delete(s.sockets, worker), closed: s.closed + closed}}
  end

  def handle_call(:info, _, s), do: {:reply, Map.delete(sample(s), :sockets), s}

  defp sample(s) do
    Enum.reduce(s.sockets, s, fn {_, socket}, acc ->
      pids = [elem(socket, 2), elem(socket, 3)]

      acc =
        Enum.reduce(pids, acc, fn pid, a ->
          case Process.info(pid, [:memory, :binary, :message_queue_len]) do
            nil ->
              a

            info ->
              bytes = Enum.reduce(info[:binary], 0, fn {_, n, _}, total -> total + n end)

              %{
                a
                | max_ssl_memory: max(a.max_ssl_memory, info[:memory]),
                  max_ssl_binary_bytes: max(a.max_ssl_binary_bytes, bytes),
                  max_ssl_mailbox: max(a.max_ssl_mailbox, info[:message_queue_len])
              }
          end
        end)

      recbuf =
        case :ssl.getopts(socket, [:recbuf]) do
          {:ok, [recbuf: n]} -> n
          _ -> 0
        end

      buffer =
        case :inet.getopts(elem(socket, 1), [:buffer]) do
          {:ok, [buffer: n]} -> n
          _ -> 0
        end

      %{
        acc
        | max_socket_recbuf: max(acc.max_socket_recbuf, recbuf),
          max_transport_buffer: max(acc.max_transport_buffer, buffer)
      }
    end)
  rescue
    _ -> s
  end
end

