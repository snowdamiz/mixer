      "public.mixer_browser_session_events": {
        "checks": [
          "sequence BETWEEN 1 AND 9007199254740991",
          "audit_schema=1",
          "operation IN('bootstrap','begin','claim','provider_reject','fail_claim','activate','replace','logout','expire')",
          "outcome IN('created','pending','claimed','provider_rejected','failed','active','revoked','expired')",
          "request_id ~ '^[0-9a-f]{32}$'",
          "recorded_at BETWEEN 0 AND 9007199254740991",
          "new_revision BETWEEN 1 AND 9007199254740991",
          "new_epoch BETWEEN 1 AND 9007199254740991",
          "new_status IN('preauth','active','revoked','expired')",
          "octet_length(config_digest)=32",
