import Config

config :mixer_hosted, ecto_repos: [MixerHosted.Repo]
config :phoenix, :json_library, Jason
config :jose, json_module: :jose_json_jason, unsecured_signing: false, crypto_fallback: false

config :mixer_hosted, MixerHostedWeb.Endpoint,
  adapter: Bandit.PhoenixAdapter,
  server: false,
  render_errors: [formats: [json: MixerHostedWeb.ErrorJSON], layout: false],
  debug_errors: false

config :logger, level: :warning

eeacfa787f6a338edb99c4a820302a8ff88c1108 blob 549
import Config

# Tests start their own isolated services explicitly with --no-start. Normal
# startup and releases have no fallback credentials, database, or combined role.
if config_env() != :test do
  settings = MixerHosted.RuntimeConfig.load!(System.get_env())
  config :mixer_hosted, :role, settings.role
  config :mixer_hosted, :identity_startup, settings.identity_startup
  config :mixer_hosted, MixerHosted.Repo, settings.repo
  config :mixer_hosted, Oban, settings.oban
  config :mixer_hosted, MixerHostedWeb.Endpoint, settings.endpoint
end

bada5fb16541797c7a64bd241e2fabef54fcc723 blob 1278
defmodule MixerHosted.Application do
  @moduledoc false
  use Application
  alias MixerHosted.Identity.{KeyOwnerSupervisor, StartupConfig}

  @impl true
  def start(_type, _args) do
    role = Application.fetch_env!(:mixer_hosted, :role)

    children =
      children(
        role,
        Application.fetch_env!(:mixer_hosted, Oban),
        Application.fetch_env!(:mixer_hosted, :identity_startup)
      )

    Supervisor.start_link(children, strategy: :one_for_one, name: MixerHosted.Supervisor)
  end

  @doc false
  def children(role, oban),
    do: children(role, oban, %StartupConfig{mode: :disabled, owner_options: []})

  @doc false
  def children(:api, oban, %StartupConfig{mode: :disabled}),
    do: [MixerHosted.Repo, {Oban, oban}, MixerHostedWeb.Endpoint]

  def children(:api, oban, %StartupConfig{mode: :configured, owner_options: options}),
    do: [MixerHosted.Repo, {Oban, oban}, {KeyOwnerSupervisor, options}, MixerHostedWeb.Endpoint]

  def children(:processor, oban, %StartupConfig{mode: :disabled}),
    do: [MixerHosted.Repo, {Oban, oban}]

  @impl true
  def config_change(changed, _new, removed) do
    if Application.fetch_env!(:mixer_hosted, :role) == :api do
      MixerHostedWeb.Endpoint.config_change(changed, removed)
    end

    :ok
  end
end

0181b5b3cda1d1432be62db05402d2a425b810d9 blob 17388
defmodule MixerHosted.Audit.CustomerArtifactEvent do
  @moduledoc """
  Pure, bounded schema-2 customer artifact audit codec.

  Snapshots and records are forgeable data, never storage authority. Building a
  record does not admit an artifact, verify a signature, acquire a lock or prove
  database freshness. Decode verifies only invariants retained by the wire data.
  All digests are lowercase hexadecimal text; external references are hashed in
  separate namespaces. No raw subject, issuer, client or credential is retained.
  """

  alias MixerHosted.Authorization.{Policy, Scope}
  alias MixerHosted.Authorization.Transaction.Snapshot
  alias MixerHosted.Identity.{Encoding, VerifiedIdentity}
  alias MixerHosted.Protocol.ArtifactCBOR

  @max 9_007_199_254_740_991
  @action "artifact.upload"
  @scope "mixer.artifact.upload"
  @roles ~w(owner administrator developer)
  @fields ~w(audit_schema sequence tenant actor authorization target action outcome reason request_id source_ip recorded_at previous_state_sha256 current_state_sha256 previous_event_sha256 request_sha256 envelope_sha256)
  @display_fields @fields ++ ["event_sha256"]
  @artifact_fields ~w(organization_id project_id application_id environment_id platform runtime_sha256 manifest_sha256 payload_sha256 envelope_sha256)a
  @command_fields ~w(sequence previous_state_sha256 previous_event_sha256 outcome reason source_ip)a
  @snapshot_fields ~w(request_id profile binding principal credential family memberships organization_head project_head identity action target checked_at)a
  @member_fields ~w(id principal_id role scope project_binding active not_before expires_at revision)a
  @immutable_fields @snapshot_fields -- [:memberships, :checked_at]
  @row_fields [:event_cbor, :event_sha256, :display]

  defmodule Record do
    @moduledoc "A forgeable pure value; validation grants no storage or actor authority."
    @enforce_keys [:event_cbor, :event_sha256, :display]
    defstruct @enforce_keys
    @type t :: %__MODULE__{event_cbor: binary(), event_sha256: binary(), display: map()}
  end

  @type error :: {:error, :invalid_audit_event}

  @spec build(term(), term(), term(), term(), term()) :: {:ok, Record.t()} | error()
  def build(identity, locked, fresh, artifact, command) do
    with true <- is_struct(identity, VerifiedIdentity),
         true <- snapshot?(locked, identity),
         true <- snapshot?(fresh, identity),
         true <- Enum.all?(@immutable_fields, &(Map.fetch!(locked, &1) === Map.fetch!(fresh, &1))),
         true <-
           fresh.checked_at >= locked.checked_at and fresh.checked_at <= locked.checked_at + 5,
         true <- strict?(artifact, @artifact_fields),
         true <- strict?(command, @command_fields),
         {:ok, target} <- artifact_target(artifact),
         true <- target_scope(target) === fresh.target,
         true <- command?(command),
         {:ok, binding_bytes} <-
           ArtifactCBOR.encode([identity.profile_id, identity.profile_version, identity.subject]),
         {:ok, request} <- request_hash(target, artifact.envelope_sha256, command.reason),
         {:ok, current} <- current_state(target, artifact.envelope_sha256, command) do
      actor = [
        fresh.principal.id,
        "human",
        identity.profile_id,
        identity.profile_version,
        hash("binding_key", binding_bytes),
        hash("issuer", identity.issuer),
        hash("subject", identity.subject),
        hash("client", identity.client_id),
        hash("credential_ref", identity.credential_ref),
        fresh.family.id,
        identity.issued_at,
        identity.expires_at
      ]

      authorization = [
        locked.checked_at,
        fresh.checked_at,
        [fresh.profile.state_revision, true],
        [fresh.binding.revision, true],
        [fresh.principal.revision, true, fresh.principal.not_before],
        [
          fresh.credential.revision,
          true,
          fresh.credential.not_before,
          optional(fresh.credential.expires_at)
        ],
        [fresh.family.revision, true, fresh.family.not_before, optional(fresh.family.expires_at)],
        fresh.organization_head.revision,
        fresh.project_head.revision,
        @scope,
        Enum.map(fresh.memberships, &member_array/1)
      ]

      display =
        Enum.zip(@fields, [
          2,
          command.sequence,
          Enum.take(target, 2),
          actor,
          authorization,
          target,
          @action,
          command.outcome,
          command.reason,
          fresh.request_id,
          optional(command.source_ip),
          fresh.checked_at,
          command.previous_state_sha256,
          current,
          command.previous_event_sha256,
          request,
          artifact.envelope_sha256
        ])
        |> Map.new()

      with {:ok, bytes} <- ArtifactCBOR.encode(Enum.map(@fields, &Map.fetch!(display, &1))) do
        decode(Map.put(display, "event_sha256", hash("audit", bytes)))
      else
        _ -> invalid()
      end
    else
      _ -> invalid()
    end
  rescue
    _ -> invalid()
  catch
    _, _ -> invalid()
  end

  @spec decode(term()) :: {:ok, Record.t()} | error()
  def decode(display) do
    with true <- strict?(display, @display_fields),
         true <- display["audit_schema"] === 2 and positive?(display["sequence"]),
         [org, project] <- display["tenant"],
         true <- Scope.identifier?(org) and Scope.identifier?(project),
         {:ok, actor} <- actor(display["actor"]),
         true <-
           authorization?(display["authorization"], actor, display["recorded_at"], org, project),
         true <- target?(display["target"]),
         [^org, ^project | _] <- display["target"],
         true <- display["action"] === @action,
         true <- reason?(display["reason"]),
         true <- hex?(display["request_id"], 32),
         true <- optional_ip?(display["source_ip"]),
         true <- digest?(display["event_sha256"]) and digest?(display["envelope_sha256"]),
         command = %{
           sequence: display["sequence"],
           previous_state_sha256: display["previous_state_sha256"],
           previous_event_sha256: display["previous_event_sha256"],
           outcome: display["outcome"],
           reason: display["reason"],
           source_ip: nil
         },
         true <- command?(command),
         true <- initial_state?(command, org, project),
         {:ok, current} <- current_state(display["target"], display["envelope_sha256"], command),
         true <- current === display["current_state_sha256"],
         {:ok, request} <-
           request_hash(display["target"], display["envelope_sha256"], display["reason"]),
         true <- request === display["request_sha256"],
         {:ok, bytes} <- ArtifactCBOR.encode(Enum.map(@fields, &Map.fetch!(display, &1))),
         digest = hash("audit", bytes),
         true <- digest === display["event_sha256"] do
      {:ok, %Record{event_cbor: bytes, event_sha256: digest, display: display}}
    else
      _ -> invalid()
    end
  rescue
    _ -> invalid()
  catch
    _, _ -> invalid()
  end

  @spec validate_row(term()) :: :ok | error()
  def validate_row(row) do
    with {:ok, row} <- row_map(row),
         true <- is_binary(row.event_cbor) and byte_size(row.event_cbor) in 1..65_536,
         true <- digest?(row.event_sha256),
         {:ok, decoded} <- decode(row.display),
         true <-
           decoded.event_cbor === row.event_cbor and decoded.event_sha256 === row.event_sha256 do
      :ok
    else
      _ -> invalid()
    end
  end

  @spec validate_edge(term(), term()) :: :ok | error()
  def validate_edge(current, previous) do
    with :ok <- validate_row(current),
         {:ok, current} <- row_map(current) do
      c = current.display

      if c["sequence"] == 1 do
        if is_nil(previous), do: :ok, else: invalid()
      else
        with :ok <- validate_row(previous),
             {:ok, previous} <- row_map(previous),
             p = previous.display,
             true <- c["tenant"] === p["tenant"] and c["sequence"] == p["sequence"] + 1,
             true <- c["previous_event_sha256"] === previous.event_sha256,
             true <- c["previous_state_sha256"] === p["current_state_sha256"] do
          :ok
        else
          _ -> invalid()
        end
      end
    else
      _ -> invalid()
    end
  end

  @spec genesis(term(), term()) :: {:ok, binary()} | error()
  def genesis(organization, project) do
    if Scope.identifier?(organization) and Scope.identifier?(project) do
      {:ok, bytes} = ArtifactCBOR.encode([2, organization, project])
      {:ok, hash("state", bytes)}
    else
      invalid()
    end
  end

  @spec request_hash(term(), term(), term()) :: {:ok, binary()} | error()
  def request_hash(target, envelope_sha256, reason) do
    with true <- target?(target) and digest?(envelope_sha256) and reason?(reason),
         {:ok, bytes} <- ArtifactCBOR.encode([2, @action, target, envelope_sha256, reason]) do
      {:ok, hash("upload.request", bytes)}
    else
      _ -> invalid()
    end
  end

  defp snapshot?(s, identity) do
    with true <- strict?(s, @snapshot_fields),
         true <- bounded_list?(s.memberships, 64) and s.memberships != [],
         true <-
           Enum.all?(s.memberships, fn m ->
             strict?(m, @member_fields) and Scope.identifier?(m.id) and m.role in @roles
           end),
         true <-
           is_map(s.principal) and is_map(s.credential) and
             is_map(s.organization_head) and is_map(s.project_head),
         decision = %Policy.Decision{
           action: s.action,
           target: s.target,
           principal_id: s.principal.id,
           credential_ref: identity.credential_ref,
           profile_id: identity.profile_id,
           profile_version: identity.profile_version,
           membership_ids: Enum.map(s.memberships, & &1.id),
           roles: s.memberships |> Enum.map(& &1.role) |> Enum.uniq() |> Enum.sort(),
           principal_revision: s.principal.revision,
           credential_revision: s.credential.revision,
           organization_revision: s.organization_head.revision,
           project_revision: s.project_head.revision,
           evaluated_at: s.checked_at
         },
         true <- Snapshot.valid?(s, identity, decision),
         true <- s.action === @action and s.principal.not_before <= s.checked_at do
      true
    else
      _ -> false
    end
  end

  defp artifact_target(a) do
    target = [
      a.organization_id,
      a.project_id,
      a.application_id,
      a.environment_id,
      a.platform,
      a.runtime_sha256,
      a.manifest_sha256,
      a.payload_sha256
    ]

    if target?(target) and digest?(a.envelope_sha256), do: {:ok, target}, else: invalid()
  end

  defp target?([org, project, app, env, platform, runtime, manifest, payload]),
    do:
      Enum.all?([org, project, app, env], &Scope.identifier?/1) and
        platform in ["ios", "android"] and Enum.all?([runtime, manifest, payload], &digest?/1)

  defp target?(_), do: false

  defp target_scope([org, project, app, env | _]),
    do: %Scope{
      organization_id: org,
      project_id: project,
      application_id: app,
      environment_id: env
    }

  defp actor([
         principal,
         "human",
         profile,
         version,
         binding,
         issuer,
         subject,
         client,
         credential,
         family,
         issued,
         expires
       ]) do
    if Scope.identifier?(principal) and Encoding.bounded_string?(profile, 128) and
         is_integer(version) and version in 1..2_147_483_647 and Scope.identifier?(family) and
         Enum.all?([binding, issuer, subject, client, credential], &digest?/1) and
         date?(issued) and date?(expires) and issued < expires do
      {:ok, %{issued: issued, expires: expires}}
    else
      invalid()
    end
  end

  defp actor(_), do: invalid()

  defp authorization?(
         [
           locked,
           fresh,
           [pr, true],
           [br, true],
           [principal_r, true, principal_start],
           [cr, true, credential_start, credential_end],
           [fr, true, family_start, family_end],
           org_r,
           project_r,
           @scope,
           members
         ],
         actor,
         recorded,
         org,
         project
       ) do
    date?(locked) and date?(fresh) and fresh >= locked and fresh <= locked + 5 and
      recorded === fresh and actor.issued <= locked + 30 and fresh < actor.expires and
      Enum.all?([pr, br, principal_r, cr, fr, org_r, project_r], &positive?/1) and
      date?(principal_start) and principal_start <= locked and principal_start <= actor.issued and
      state_window?(credential_start, credential_end, locked, fresh, actor.issued) and
      state_window?(family_start, family_end, locked, fresh, actor.issued) and
      members?(members, fresh, org, project)
  end

  defp authorization?(_, _, _, _, _), do: false

  defp state_window?(start, finish, locked, fresh, issued),
    do: date?(start) and start <= locked and start <= issued and end?(finish, start, fresh)

  defp end?([], _start, _now), do: true
  defp end?([finish], start, now), do: date?(finish) and start < finish and now < finish
  defp end?(_, _, _), do: false

  defp members?(members, now, org, project) do
    bounded_list?(members, 64) and members != [] and
      Enum.all?(members, &member?(&1, now, org, project)) and
      sorted_ids?(members, nil)
  end

  defp member?(
         [id, role, revision, org, optional_project, binding, true, start, finish],
         now,
         org,
         project
       ),
       do:
         Scope.identifier?(id) and role in @roles and positive?(revision) and
           ((optional_project === [] and binding === "all_projects") or
              (optional_project === [project] and binding === "exact_project")) and
           date?(start) and start <= now and end?(finish, start, now)

  defp member?(_, _, _, _), do: false

  defp sorted_ids?([], _previous), do: true
  defp sorted_ids?([[id | _] | rest], nil), do: sorted_ids?(rest, id)
  defp sorted_ids?([[id | _] | rest], previous), do: id > previous and sorted_ids?(rest, id)

  defp member_array(m),
    do: [
      m.id,
      m.role,
      m.revision,
      m.scope.organization_id,
      optional(m.scope.project_id),
      Atom.to_string(m.project_binding),
      true,
      m.not_before,
      optional(m.expires_at)
    ]

  defp command?(c),
    do:
      positive?(c.sequence) and digest?(c.previous_state_sha256) and
        ((c.sequence == 1 and c.previous_event_sha256 === "") or
           (c.sequence > 1 and digest?(c.previous_event_sha256))) and
        c.outcome in ["created", "unchanged"] and reason?(c.reason) and
        (is_nil(c.source_ip) or canonical_ip?(c.source_ip))

  defp initial_state?(%{sequence: 1, previous_state_sha256: previous}, org, project),
    do: genesis(org, project) === {:ok, previous}

  defp initial_state?(_, _, _), do: true

  defp current_state(_target, _envelope, %{outcome: "unchanged", previous_state_sha256: previous}),
       do: {:ok, previous}

  defp current_state(
         [org, project, _app, _env, _platform, _runtime, manifest, payload],
         envelope,
         c
       ) do
    with {:ok, bytes} <-
           ArtifactCBOR.encode([
             2,
             org,
             project,
             c.previous_state_sha256,
             c.sequence,
             manifest,
             envelope,
             payload
           ]) do
      {:ok, hash("state", bytes)}
    end
  end

  defp optional_ip?([]), do: true
  defp optional_ip?([ip]), do: canonical_ip?(ip)
  defp optional_ip?(_), do: false

  defp canonical_ip?(ip) when is_binary(ip) and byte_size(ip) in 2..45 do
    with true <- String.valid?(ip),
         {:ok, address} <- :inet.parse_address(String.to_charlist(ip)),
         rendered = address |> :inet.ntoa() |> List.to_string() do
      rendered === ip
    else
      _ -> false
    end
  end

  defp canonical_ip?(_), do: false

  defp row_map(%Record{} = row) when map_size(row) == 4 do
    value = Map.from_struct(row)
    if strict?(value, @row_fields), do: {:ok, value}, else: invalid()
  end

  defp row_map(row) do
    if strict?(row, @row_fields), do: {:ok, row}, else: invalid()
  end

  defp strict?(value, fields) when is_map(value) and not is_struct(value),
    do: map_size(value) == length(fields) and Enum.all?(fields, &Map.has_key?(value, &1))

  defp strict?(_, _), do: false
  defp bounded_list?([], _), do: true

  defp bounded_list?([_ | tail], remaining) when remaining > 0,
    do: bounded_list?(tail, remaining - 1)

  defp bounded_list?(_, _), do: false
  defp optional(nil), do: []
  defp optional(value), do: [value]
  defp reason?(v), do: is_binary(v) and byte_size(v) <= 512 and String.valid?(v)
  defp date?(v), do: Encoding.numeric_date?(v)
  defp positive?(v), do: is_integer(v) and v in 1..@max
  defp digest?(v), do: hex?(v, 64)

  defp hex?(v, n) when is_binary(v) and byte_size(v) == n,
    do: Enum.all?(:binary.bin_to_list(v), &(&1 in ?0..?9 or &1 in ?a..?f))

  defp hex?(_, _), do: false

  defp hash(field, bytes),
    do:
      :crypto.hash(:sha256, "mixer.hosted.customer." <> field <> ".v2\0" <> bytes)
      |> Base.encode16(case: :lower)

  defp invalid, do: {:error, :invalid_audit_event}
end

a0d080d167c300dfc3ce1c842aed5a435b1d9ffd blob 12893
defmodule MixerHosted.Audit.UploadEvent do
  @moduledoc """
  Validates the closed hosted artifact-upload audit representation.

  Reconstructs exact CBOR, domain hash and PostgreSQL display bytes from an
  already decoded map. A retained row and its immediate predecessor can be
  checked without reading an entire chain. This proves internal consistency;
  it does not authenticate an actor, verify an artifact signature, authorize a
  write or prove history against a privileged coherent rewrite.

  The input is already allocated by the caller. Shape and field bounds are
  checked before encoding: 16 display keys, at most 64 memberships, fixed
  arrays, a 512-byte reason, 16 KiB CBOR and 32 KiB display. Malformed input
  returns a fixed error without retaining source values in diagnostics.
  """

  @row_keys ~w(organization project event_id event_cbor event_hash previous_hash
    previous_state current_state display_json display_bytes)a

  @spec decode(term()) :: {:ok, map()} | {:error, :invalid_audit_event}
  def decode(display) do
    event = from_display(display)
    bytes = encode(event)
    digest = hash("mixer.hosted.audit.v1", bytes)
    ensure(display["hash"] == hex(digest), "display hash")
    rendered = postgres_display(display)
    ensure(byte_size(rendered) <= 32_768, "display budget")
    {:ok, %{event_cbor: bytes, event_hash: digest, display_bytes: rendered}}
  rescue
    _ -> {:error, :invalid_audit_event}
  end

  @spec validate_row(term()) :: :ok | {:error, :invalid_audit_event}
  def validate_row(row) do
    ensure(
      is_map(row) and map_size(row) == 10 and
        Enum.all?(@row_keys, &Map.has_key?(row, &1)),
      "closed row"
    )

    ensure(
      is_binary(row.event_cbor) and byte_size(row.event_cbor) <= 16_384 and
        is_binary(row.display_bytes) and byte_size(row.display_bytes) <= 32_768,
      "row budget"
    )

    for field <- [:event_hash, :previous_state, :current_state] do
      value = Map.fetch!(row, field)
      ensure(is_binary(value) and byte_size(value) == 32, "row digest")
    end

    ensure(
      is_binary(row.previous_hash) and byte_size(row.previous_hash) in [0, 32],
      "previous hash"
    )

    validate_row!(row)
  rescue
    _ -> {:error, :invalid_audit_event}
  end

  @spec validate_edge(term(), term()) :: :ok | {:error, :invalid_audit_event}
  def validate_edge(current, previous) do
    :ok = validate_row(current)

    if current.event_id == 1 do
      ensure(is_nil(previous), "initial predecessor")
    else
      :ok = validate_row(previous)

      ensure(
        previous.organization == current.organization and
          previous.project == current.project and
          previous.event_id + 1 == current.event_id and
          previous.event_hash == current.previous_hash and
          previous.current_state == current.previous_state,
        "adjacent edge"
      )
    end

    :ok
  rescue
    _ -> {:error, :invalid_audit_event}
  end

  @u64 18_446_744_073_709_551_615
  defp encode(value, limit \\ 16_384) when is_integer(limit) and limit in 1..65_536 do
    {_, _} = measure(value, 0, 4096, limit)
    encoded = enc(value)
    if byte_size(encoded) > limit, do: raise(ArgumentError, "encoded budget")
    encoded
  end

  defp measure(_, depth, _, _) when depth > 16, do: raise(ArgumentError, "depth")
  defp measure(_, _, nodes, _) when nodes < 1, do: raise(ArgumentError, "nodes")

  defp measure(value, depth, nodes, budget) do
    if budget < 1, do: raise(ArgumentError, "encoded budget")

    {header, children} =
      case value do
        nil ->
          {1, []}

        n when is_integer(n) and n in 0..@u64 ->
          {byte_size(head(0, n)), []}

        {:bytes, b} when is_binary(b) ->
          {byte_size(head(2, byte_size(b))) + byte_size(b), []}

        t when is_binary(t) ->
          if not String.valid?(t), do: raise(ArgumentError, "UTF8")
          {byte_size(head(3, byte_size(t))) + byte_size(t), []}

        a when is_list(a) and length(a) <= 256 ->
          {byte_size(head(4, length(a))), a}

        _ ->
          raise(ArgumentError, "unsupported type")
      end

    if header > budget, do: raise(ArgumentError, "encoded budget")

    Enum.reduce(children, {nodes - 1, budget - header}, fn child, {remaining, left} ->
      measure(child, depth + 1, remaining, left)
    end)
  end

  defp enc(nil), do: <<0xF6>>
  defp enc(n) when is_integer(n) and n in 0..@u64, do: head(0, n)
  defp enc({:bytes, b}) when is_binary(b), do: head(2, byte_size(b)) <> b

  defp enc(t) when is_binary(t) do
    if not String.valid?(t), do: raise(ArgumentError, "UTF8")
    head(3, byte_size(t)) <> t
  end

  defp enc(a) when is_list(a) and length(a) <= 256,
    do: head(4, length(a)) <> IO.iodata_to_binary(Enum.map(a, &enc/1))

  defp enc(_), do: raise(ArgumentError, "unsupported type")
  defp head(m, n) when n < 24, do: <<m * 32 + n>>
  defp head(m, n) when n <= 255, do: <<m * 32 + 24, n>>
  defp head(m, n) when n <= 65_535, do: <<m * 32 + 25, n::16>>
  defp head(m, n) when n <= 4_294_967_295, do: <<m * 32 + 26, n::32>>
  defp head(m, n), do: <<m * 32 + 27, n::64>>
  defp hash(domain, b), do: :crypto.hash(:sha256, domain <> <<0>> <> b)
  defp b(v), do: {:bytes, v}
  defp hex(v), do: Base.encode16(v, case: :lower)

  # Fixed schema validation precedes rendering; no SQL validator is consulted.
  @display_keys ~w(audit_schema id tenant actor decision target action reason request_id source_ip recorded_at previous_state current_state previous_hash request_hash hash)
  @roles ~w(owner administrator developer release_manager billing_manager viewer)
  @upload_roles ~w(owner administrator developer)
  @seconds 9_007_199_254_740_991
  @revision 9_223_372_036_854_775_807

  defp from_display(d) do
    ensure(
      is_map(d) and map_size(d) == 16 and Enum.all?(@display_keys, &Map.has_key?(d, &1)),
      "closed display"
    )

    ensure(is_integer(d["audit_schema"]) and d["audit_schema"] == 1, "schema")
    ensure(d["action"] == "artifact.upload", "action")
    [o, p] = array!(d["tenant"], 2)
    id!(o)
    id!(p)

    [
      principal,
      kind,
      binding,
      profile,
      version,
      issuer,
      subject,
      client,
      credential,
      family,
      auth
    ] = array!(d["actor"], 11)

    ensure(kind == "human", "class")
    [time, pr, ar, fr, orr, pjr, members] = array!(d["decision"], 7)
    [to, tp, app, env, platform, runtime, manifest] = array!(d["target"], 7)
    ensure(to == o and tp == p, "tenant/target")
    ensure(platform in ["ios", "android"], "platform")
    eid = uint!(d["id"], 1, @u64)
    completed = uint!(auth, 0, @seconds)
    decision = uint!(time, 0, @seconds)
    recorded = uint!(d["recorded_at"], 0, @seconds)

    ensure(
      completed >= decision - 45 and completed <= decision + 30 and recorded >= decision,
      "time"
    )

    ensure(bounded_length!(members, 64) in 1..64, "members")

    decoded_members =
      Enum.map(members, fn m ->
        [uuid, role, rev] = array!(m, 3)
        ensure(role in @roles, "role")
        [b(uuid!(uuid)), role, uint!(rev, 1, @revision)]
      end)

    member_ids = Enum.map(decoded_members, fn [{:bytes, id}, _, _] -> id end)
    ensure(member_ids == Enum.sort(Enum.uniq(member_ids)), "member order/unique")

    ensure(
      Enum.any?(decoded_members, fn [_, role, _] -> role in @upload_roles end),
      "upload ceiling"
    )

    previous_hash = hex!(d["previous_hash"], if(eid == 1, do: 0, else: 32))
    hex!(d["hash"], 32)

    event = [
      1,
      eid,
      [o, p],
      [
        b(uuid!(principal)),
        kind,
        b(uuid!(binding)),
        text!(profile, 1, 128),
        uint!(version, 1, 2_147_483_647),
        b(hex!(issuer, 32)),
        b(hex!(subject, 32)),
        b(hex!(client, 32)),
        b(hex!(credential, 32)),
        b(uuid!(family)),
        completed
      ],
      [
        decision,
        uint!(pr, 1, @revision),
        uint!(ar, 1, @revision),
        uint!(fr, 1, @revision),
        uint!(orr, 1, @revision),
        uint!(pjr, 1, @revision),
        decoded_members
      ],
      [
        id!(to),
        id!(tp),
        id!(app),
        id!(env),
        platform,
        b(hex!(runtime, 32)),
        b(hex!(manifest, 32))
      ],
      "artifact.upload",
      text!(d["reason"], 0, 512),
      b(uuid!(d["request_id"])),
      ip!(d["source_ip"]),
      recorded,
      b(hex!(d["previous_state"], 32)),
      b(hex!(d["current_state"], 32)),
      b(previous_hash),
      b(hex!(d["request_hash"], 32))
    ]

    ensure(byte_size(encode(event)) <= 16_384, "event budget")
    event
  rescue
    _ -> raise ArgumentError, "invalid typed display"
  end

  # Retained row projections remain separate from typed display decoding.
  defp validate_row!(%{
         organization: o,
         project: p,
         event_id: id,
         event_cbor: bytes,
         event_hash: hash,
         previous_hash: previous_hash,
         previous_state: previous_state,
         current_state: current_state,
         display_json: d,
         display_bytes: display_bytes
       }) do
    event = from_display(d)
    ensure(is_integer(id) and id in 1..@u64 and d["id"] == Integer.to_string(id), "row id")
    ensure(d["tenant"] == [o, p], "row tenant")

    ensure(
      bytes == encode(event) and hash == hash("mixer.hosted.audit.v1", bytes),
      "row cbor/hash"
    )

    ensure(
      d["hash"] == hex(hash) and d["previous_hash"] == hex(previous_hash) and
        d["previous_state"] == hex(previous_state) and d["current_state"] == hex(current_state),
      "row projections"
    )

    ensure(display_bytes == postgres_display(d), "display bytes")

    if id == 1 do
      ensure(
        previous_hash == <<>> and
          previous_state == hash("mixer.hosted.state.v1", encode([1, o, p])),
        "initial edge"
      )
    end

    :ok
  end

  defp postgres_display(v) when is_map(v) do
    "{" <>
      (v
       |> Map.to_list()
       |> Enum.sort_by(fn {k, _} -> {byte_size(k), k} end)
       |> Enum.map_join(", ", fn {k, value} ->
         postgres_display(k) <> ": " <> postgres_display(value)
       end)) <> "}"
  end

  defp postgres_display(v) when is_list(v),
    do: "[" <> Enum.map_join(v, ", ", &postgres_display/1) <> "]"

  # PostgreSQL jsonb_out string spelling for this closed retained schema.
  # Operate on validated source bytes; never substitute inside encoded JSON.
  defp postgres_display(v) when is_binary(v) do
    ensure(String.valid?(v) and not String.contains?(v, <<0>>), "PostgreSQL text")

    escaped =
      for <<c <- v>> do
        case c do
          34 ->
            ~S(\")

          92 ->
            ~S(\\)

          8 ->
            ~S(\b)

          12 ->
            ~S(\f)

          10 ->
            ~S(\n)

          13 ->
            ~S(\r)

          9 ->
            ~S(\t)

          control when control < 32 ->
            [
              "\\u00",
              binary_part("0123456789abcdef", div(control, 16), 1),
              binary_part("0123456789abcdef", rem(control, 16), 1)
            ]

          byte ->
            <<byte>>
        end
      end

    IO.iodata_to_binary([34, escaped, 34])
  end

  defp postgres_display(nil), do: "null"
  defp postgres_display(1), do: "1"

  defp ensure(true, _), do: :ok
  defp ensure(_, message), do: raise(ArgumentError, message)
  defp bounded_length!(v, limit), do: bounded_length!(v, limit, 0)
  defp bounded_length!([], _, count), do: count

  defp bounded_length!([_ | tail], limit, count) when count < limit,
    do: bounded_length!(tail, limit, count + 1)

  defp bounded_length!(_, _, _), do: raise(ArgumentError, "array bound")

  defp array!(v, n) do
    ensure(bounded_length!(v, n) == n, "array shape")
    v
  end

  defp text!(v, lo, hi) do
    ensure(
      is_binary(v) and byte_size(v) >= lo and byte_size(v) <= hi and String.valid?(v) and
        not String.contains?(v, <<0>>),
      "text"
    )

    v
  end

  defp uint!(v, lo, hi) do
    text!(v, 1, 20)
    ensure(Regex.match?(~r/\A(?:0|[1-9][0-9]*)\z/, v), "decimal")
    n = String.to_integer(v)
    ensure(n >= lo and n <= hi, "integer range")
    n
  end

  defp uuid!(v) do
    text!(v, 36, 36)

    ensure(
      Regex.match?(~r/\A[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z/, v),
      "uuid"
    )

    v |> String.replace("-", "") |> Base.decode16!(case: :lower)
  end

  defp hex!(v, n) do
    text!(v, n * 2, n * 2)
    ensure(Regex.match?(~r/\A[0-9a-f]*\z/, v), "hex")
    Base.decode16!(v, case: :lower)
  end

  defp id!(v) do
    text!(v, 1, 128)
    ensure(Regex.match?(~r/\A[A-Za-z0-9_.-]+\z/, v), "id")
    v
  end

  defp ip!(nil), do: nil

  defp ip!(v) do
    text!(v, 1, 45)
    {:ok, address} = :inet.parse_strict_address(String.to_charlist(v))
    ensure(address |> :inet.ntoa() |> to_string() == v, "canonical ip")
    v
  end
end

4c046fcd8adcc30542035f34c01aac93ec9e22ea blob 4183
defmodule MixerHosted.Authorization do
  @moduledoc """
  Owns the fresh customer authorization and local SQL transaction.

  The callback must return `{:ok, value}` or `{:error, bounded_reason}` and may
  perform only synchronous local SQL. External effects cannot be rolled back.
  A pure Policy.Decision is never accepted as domain authority. The optional Repo
  argument is trusted server configuration, never request data. No HTTP route
  activates this seam and no caller-supplied clock is accepted.
  """

  alias MixerHosted.Authorization.Policy
  alias MixerHosted.Authorization.Postgres.{Evidence, Session}
  alias MixerHosted.Authorization.Transaction.{Context, Snapshot}

  @errors [
    :invalid_request,
    :unauthenticated,
    :not_found,
    :permission_denied,
    :authorization_unavailable,
    :conflict,
    :immutable_conflict,
    :idempotency_conflict,
    :storage_unavailable
  ]

  @doc "Resolves project-visible metadata, then binds the exact artifact environment in an owned transaction."
  def with_artifact_read_transaction(
        identity,
        project_target,
        manifest_sha256,
        callback,
        repo \\ MixerHosted.Repo
      ) do
    MixerHosted.Authorization.ArtifactRead.run(
      identity,
      project_target,
      manifest_sha256,
      callback,
      repo
    )
  end

  def with_authorized_transaction(identity, action, target, callback, repo \\ MixerHosted.Repo) do
    admitted_at = System.system_time(:second)
    deadline = System.monotonic_time(:millisecond) + 5_000

    with {:ok, scope} <- Policy.request(identity, action, target, admitted_at),
         true <- is_function(callback, 1),
         false <- Context.active?(),
         false <- repo.in_transaction?() do
      lookup = %{identity: Policy.identity_key(identity), action: action, target: scope}

      case repo.transaction(
             fn ->
               try do
                 linkage = Session.prepare!(repo, lookup)
                 evidence = Evidence.load!(repo, lookup, linkage)
                 now = System.system_time(:second)

                 if now < admitted_at or System.monotonic_time(:millisecond) >= deadline,
                   do: repo.rollback(:authorization_unavailable)

                 decision = evaluate!(repo, identity, action, scope, evidence, now)
                 snapshot = Snapshot.load!(repo, identity, evidence, linkage, decision, now)

                 context =
                   Context.bind!(
                     repo,
                     identity,
                     action,
                     scope,
                     evidence,
                     snapshot,
                     admitted_at,
                     deadline
                   )

                 Context.checkpoint!(context, repo, action, scope)

                 case callback.(context) do
                   {:ok, value} ->
                     # The last successful checkpoint is immediately before
                     # returning to Ecto's commit. No user callback follows it.
                     Context.checkpoint!(context, repo, action, scope)
                     {:ok, value}

                   {:error, reason} when reason in @errors ->
                     repo.rollback(reason)

                   _ ->
                     repo.rollback(:authorization_unavailable)
                 end
               after
                 Context.clear!()
               end
             end,
             timeout: 5_000,
             queue: false
           ) do
        {:ok, {:ok, value}} -> {:ok, value}
        {:error, reason} when reason in @errors -> {:error, reason}
        _ -> {:error, :authorization_unavailable}
      end
    else
      {:error, reason} when reason in @errors -> {:error, reason}
      _ -> {:error, :authorization_unavailable}
    end
  rescue
    _ -> {:error, :authorization_unavailable}
  catch
    _, _ -> {:error, :authorization_unavailable}
  end

  defp evaluate!(repo, identity, action, target, evidence, now) do
    case Policy.evaluate(identity, action, target, evidence, now) do
      {:ok, decision} -> decision
      {:error, reason} -> repo.rollback(reason)
    end
  end
end

348dfe3bf7e6a062dc691234ecc87d6e4dddef1d blob 7879
defmodule MixerHosted.Authorization.ArtifactRead do
  @moduledoc false

  alias MixerHosted.Authorization.{Policy, Scope}
  alias MixerHosted.Authorization.Postgres.{Evidence, Session}
  alias MixerHosted.Authorization.Transaction.{Context, Snapshot}
  alias MixerHosted.CustomerArtifacts.PostgresStorage
  alias MixerHosted.Protocol.{ArtifactCBOR, ArtifactJSON, ArtifactV3Policy}

  @columns ~w(organization_id project_id application_id environment_id platform runtime_sha256 manifest_sha256 signed_manifest_bytes)
  @errors [
    :invalid_request,
    :unauthenticated,
    :not_found,
    :permission_denied,
    :authorization_unavailable,
    :conflict,
    :immutable_conflict,
    :idempotency_conflict,
    :storage_unavailable
  ]

  def run(identity, project_target, digest, callback, repo) do
    admitted_at = System.system_time(:second)
    deadline = System.monotonic_time(:millisecond) + 5_000

    with {:ok, project} <- Policy.metadata_request(identity, project_target, admitted_at),
         :ok <- valid_digest(digest),
         true <- is_function(callback, 2),
         false <- Context.active?(),
         false <- repo.in_transaction?() do
      lookup = %{
        identity: Policy.identity_key(identity),
        action: "artifact.read",
        target: project
      }

      result =
        repo.transaction(
          fn ->
            try do
              linkage = Session.prepare!(repo, lookup)

              Session.context!(repo,
                action: "artifact.read",
                token_issued_at: Integer.to_string(identity.issued_at),
                token_expires_at: Integer.to_string(identity.expires_at),
                required_scope: "mixer.artifact.read",
                phase: "metadata"
              )

              evidence = Evidence.load!(repo, lookup, linkage)
              now = current!(repo, admitted_at, deadline)
              evaluate_metadata!(repo, identity, project, evidence, now)
              PostgresStorage.check_topology!(repo)
              metadata = resolve!(repo, project, digest)

              # The project stage never binds a Context. Only the immutable
              # signed manifest may supply the actual app/environment target.
              target = metadata.target

              Session.context!(repo,
                application_id: target.application_id,
                environment_id: target.environment_id,
                phase: "effect"
              )

              lookup = %{lookup | target: target}
              evidence = Evidence.load!(repo, lookup, linkage)
              now = current!(repo, admitted_at, deadline, now)
              decision = evaluate!(repo, identity, target, evidence, now)
              snapshot = Snapshot.load!(repo, identity, evidence, linkage, decision, now)

              context =
                Context.bind!(
                  repo,
                  identity,
                  "artifact.read",
                  target,
                  evidence,
                  snapshot,
                  admitted_at,
                  deadline
                )

              Context.checkpoint!(context, repo, "artifact.read", target)

              case callback.(context, metadata) do
                {:ok, value} ->
                  Context.checkpoint!(context, repo, "artifact.read", target)
                  {:ok, value}

                {:error, reason} when reason in @errors ->
                  repo.rollback(reason)

                _ ->
                  repo.rollback(:authorization_unavailable)
              end
            after
              Context.clear!()
            end
          end,
          timeout: 5_000,
          queue: false
        )

      case result do
        {:ok, {:ok, value}} -> {:ok, value}
        {:error, reason} when reason in @errors -> {:error, reason}
        _ -> {:error, :authorization_unavailable}
      end
    else
      {:error, reason} when reason in @errors -> {:error, reason}
      _ -> {:error, :authorization_unavailable}
    end
  rescue
    _ -> {:error, :authorization_unavailable}
  catch
    _, _ -> {:error, :authorization_unavailable}
  end

  defp resolve!(repo, project, digest) do
    result =
      Session.query!(repo, "SELECT * FROM public.mixer_customer_artifact_metadata($1)", [digest])

    case decode_result(result, project, digest) do
      {:ok, metadata} -> metadata
      {:error, reason} -> repo.rollback(reason)
    end
  end

  @doc false
  def decode_result(%{columns: @columns, rows: []}, _project, _digest),
    do: {:error, :not_found}

  def decode_result(%{columns: @columns, rows: [row]}, project, digest),
    do: decode_metadata(row, project, digest)

  def decode_result(_, _, _), do: {:error, :storage_unavailable}

  @doc false
  def decode_metadata(
        [organization, project, application, environment, platform, runtime, digest, bytes],
        %Scope{organization_id: organization, project_id: project} = project_scope,
        digest
      )
      when is_binary(bytes) and byte_size(bytes) in 1..65_536 do
    with {:ok, ^project_scope} <- Scope.new(project_scope),
         true <- Scope.project_only?(project_scope),
         true <-
           Enum.all?([organization, project, application, environment], &ArtifactV3Policy.id?/1),
         true <- platform in ["ios", "android"],
         true <- ArtifactV3Policy.digest?(runtime) and ArtifactV3Policy.digest?(digest),
         {:ok, signed, _, _} <- ArtifactJSON.decode(bytes, 65_536),
         true <- ArtifactV3Policy.exact?(signed, ~w(manifest signature)),
         manifest = signed["manifest"],
         true <- ArtifactV3Policy.manifest?(manifest),
         true <- signature_shape?(signed["signature"]),
         true <-
           manifest["scope"] == %{
             "organization" => organization,
             "project" => project,
             "app" => application,
             "environment" => environment,
             "platform" => platform
           } and manifest["runtime"] == runtime,
         {:ok, cbor} <- ArtifactCBOR.encode(manifest),
         true <- hash(cbor) == digest do
      {:ok,
       %{
         target: %Scope{
           organization_id: organization,
           project_id: project,
           application_id: application,
           environment_id: environment
         },
         platform: platform,
         runtime_sha256: runtime,
         manifest_sha256: digest,
         signed_manifest_bytes: bytes,
         canonical_manifest_cbor: cbor,
         manifest: manifest
       }}
    else
      _ -> {:error, :storage_unavailable}
    end
  end

  def decode_metadata(_, _, _), do: {:error, :storage_unavailable}

  defp signature_shape?(text) when is_binary(text) and byte_size(text) == 88 do
    case Base.decode64(text, padding: true) do
      {:ok, decoded} when byte_size(decoded) == 64 -> Base.encode64(decoded) == text
      _ -> false
    end
  end

  defp signature_shape?(_), do: false

  defp valid_digest(digest),
    do: if(ArtifactV3Policy.digest?(digest), do: :ok, else: {:error, :invalid_request})

  defp hash(bytes), do: Base.encode16(:crypto.hash(:sha256, bytes), case: :lower)

  defp current!(repo, admitted_at, deadline, previous \\ 0) do
    now = System.system_time(:second)

    if now < admitted_at or now < previous or System.monotonic_time(:millisecond) >= deadline,
      do: repo.rollback(:authorization_unavailable)

    now
  end

  defp evaluate_metadata!(repo, identity, target, evidence, now) do
    case Policy.metadata_evaluate(identity, target, evidence, now) do
      {:ok, decision} -> decision
      {:error, reason} -> repo.rollback(reason)
    end
  end

  defp evaluate!(repo, identity, target, evidence, now) do
    case Policy.evaluate(identity, "artifact.read", target, evidence, now) do
      {:ok, decision} -> decision
      {:error, reason} -> repo.rollback(reason)
    end
  end
end

b480c02d8e27e02c75c7fa45fc2557fb3c460ff7 blob 14476
defmodule MixerHosted.Authorization.Policy do
  @moduledoc """
  Pure first-slice role and token-scope intersection.

  Inputs are current server repository evidence, never HTTP roles or claims.
  Validation cannot prove database freshness, lineage, locks or revocation.
  A result is an evaluation, not a transaction context or storage capability.
  Only human artifact read/upload and project audit read are implemented.
  """

  alias MixerHosted.Authorization.Scope
  alias MixerHosted.Identity.{Encoding, VerifiedIdentity}

  @max_integer 9_007_199_254_740_991
  @roles ~w(owner administrator developer release_manager billing_manager viewer)
  @read_roles ~w(owner administrator developer release_manager viewer)
  @write_roles ~w(owner administrator developer)
  @actions %{
    "artifact.read" => {"mixer.artifact.read", @read_roles},
    "artifact.upload" => {"mixer.artifact.upload", @write_roles},
    "audit.read" => {"mixer.audit.read", @read_roles}
  }
  @identity_fields [
    :profile_id,
    :profile_version,
    :issuer,
    :subject,
    :client_id,
    :credential_ref,
    :issued_at,
    :expires_at,
    :identity_class,
    :scopes
  ]
  @binding_fields [
    :profile_id,
    :profile_version,
    :issuer,
    :subject,
    :client_id,
    :identity_class,
    :principal_id
  ]
  @principal_fields [:id, :identity_class, :active, :not_before, :revision]
  @credential_fields [:reference, :principal_id, :active, :not_before, :expires_at, :revision]
  @membership_fields [
    :id,
    :principal_id,
    :role,
    :scope,
    :project_binding,
    :active,
    :not_before,
    :expires_at,
    :revision
  ]
  @evidence_fields [
    :binding,
    :binding_active,
    :profile_active,
    :principal,
    :credential,
    :target,
    :memberships,
    :organization_revision,
    :project_revision
  ]

  defmodule Decision do
    @moduledoc "An audit-oriented pure evaluation; domain stores must not accept it as authority."
    @enforce_keys [
      :action,
      :target,
      :principal_id,
      :credential_ref,
      :profile_id,
      :profile_version,
      :membership_ids,
      :roles,
      :principal_revision,
      :credential_revision,
      :organization_revision,
      :project_revision,
      :evaluated_at
    ]
    defstruct @enforce_keys
    @type t :: %__MODULE__{}
  end

  @type error ::
          :invalid_request
          | :unauthenticated
          | :not_found
          | :permission_denied
          | :authorization_unavailable
  @type result :: {:ok, Decision.t()} | {:error, error()}
  @type evidence :: map()
  @decision_fields Decision.__struct__() |> Map.from_struct() |> Map.keys()

  @doc false
  def valid_decision?(%Decision{} = decision, identity, action, target, now) do
    with {:ok, ^target} <- request(identity, action, target, now),
         {:ok, {required_scope, allowed_roles}} <- Map.fetch(@actions, action) do
      map_size(decision) == length(@decision_fields) + 1 and
        strict?(Map.from_struct(decision), @decision_fields) and
        decision.action == action and decision.target == target and
        decision.credential_ref == identity.credential_ref and
        decision.profile_id == identity.profile_id and
        decision.profile_version == identity.profile_version and decision.evaluated_at == now and
        Scope.identifier?(decision.principal_id) and
        bounded_list?(decision.membership_ids, 64) and decision.membership_ids != [] and
        Enum.all?(decision.membership_ids, &Scope.identifier?/1) and
        Enum.sort(Enum.uniq(decision.membership_ids)) == decision.membership_ids and
        bounded_list?(decision.roles, length(@roles)) and decision.roles != [] and
        Enum.all?(decision.roles, &(&1 in allowed_roles)) and
        Enum.sort(Enum.uniq(decision.roles)) == decision.roles and
        length(decision.roles) <= length(decision.membership_ids) and
        required_scope in identity.scopes and
        revision?(decision.principal_revision) and revision?(decision.credential_revision) and
        revision?(decision.organization_revision) and revision?(decision.project_revision)
    else
      _ -> false
    end
  end

  def valid_decision?(_, _, _, _, _), do: false

  @spec evaluate(term(), term(), term(), term(), term()) :: result()
  def evaluate(identity, action, target, evidence, now) do
    with {:ok, target} <- request(identity, action, target, now) do
      evaluate_request(identity, action, target, evidence, now)
    end
  end

  @doc false
  def metadata_evaluate(identity, target, evidence, now) do
    with {:ok, target} <- metadata_request(identity, target, now) do
      evaluate_request(identity, "artifact.read", target, evidence, now)
    end
  end

  defp evaluate_request(identity, action, target, evidence, now) do
    with {:ok, evidence} <- evidence(evidence),
         :ok <- current_identity(identity, evidence, now),
         :ok <- live_target(target, evidence.target),
         memberships = eligible_memberships(evidence.memberships, target, now),
         :ok <- visible(memberships),
         {:ok, roles, membership_ids} <- permission(identity, action, memberships) do
      {:ok,
       %Decision{
         action: action,
         target: target,
         principal_id: evidence.principal.id,
         credential_ref: identity.credential_ref,
         profile_id: identity.profile_id,
         profile_version: identity.profile_version,
         membership_ids: membership_ids,
         roles: roles,
         principal_revision: evidence.principal.revision,
         credential_revision: evidence.credential.revision,
         organization_revision: evidence.organization_revision,
         project_revision: evidence.project_revision,
         evaluated_at: now
       }}
    end
  end

  @doc false
  @spec request(term(), term(), term(), term()) :: {:ok, Scope.t()} | {:error, error()}
  def request(identity, action, target, now) do
    request_target(identity, action, target, now, &valid_action_target?(action, &1))
  end

  @doc false
  def metadata_request(identity, target, now) do
    # Metadata admission is project-only, using the actual read action. It never
    # creates full artifact authority or borrows audit.read's scope/permission.
    with {:ok, scope} <-
           request_target(identity, "artifact.read", target, now, &Scope.project_only?/1) do
      if "mixer.artifact.read" in identity.scopes,
        do: {:ok, scope},
        else: {:error, :permission_denied}
    end
  end

  defp request_target(identity, action, target, now, target_check) do
    cond do
      not Encoding.numeric_date?(now) ->
        {:error, :invalid_request}

      not valid_identity?(identity) ->
        {:error, :unauthenticated}

      identity.expires_at <= now or identity.issued_at > now + 30 ->
        {:error, :unauthenticated}

      identity.identity_class != :human ->
        {:error, :permission_denied}

      not (is_binary(action) and byte_size(action) in 1..32 and is_map_key(@actions, action)) ->
        {:error, :permission_denied}

      true ->
        with {:ok, scope} <- Scope.new(target),
             true <- target_check.(scope) do
          {:ok, scope}
        else
          _ -> {:error, :invalid_request}
        end
    end
  end

  @doc false
  def identity_key(%VerifiedIdentity{} = identity),
    do:
      Map.take(identity, @binding_fields -- [:principal_id])
      |> Map.put(:credential_ref, identity.credential_ref)

  defp valid_identity?(%VerifiedIdentity{} = identity) do
    map_size(identity) == length(@identity_fields) + 1 and
      strict?(Map.from_struct(identity), @identity_fields) and
      Encoding.bounded_string?(identity.profile_id, 128) and
      profile_version?(identity.profile_version) and
      Encoding.bounded_string?(identity.issuer, 2_048) and
      Encoding.bounded_string?(identity.subject, 256) and
      Encoding.bounded_string?(identity.client_id, 256) and
      Encoding.bounded_string?(identity.credential_ref, 256) and
      identity.identity_class in [:human, :service] and
      Encoding.numeric_date?(identity.issued_at) and Encoding.numeric_date?(identity.expires_at) and
      identity.issued_at < identity.expires_at and bounded_list?(identity.scopes, 32) and
      Enum.all?(identity.scopes, &Encoding.bounded_string?(&1, 256)) and
      Enum.uniq(identity.scopes) == identity.scopes
  end

  defp valid_identity?(_), do: false

  defp valid_action_target?("audit.read", scope), do: Scope.project_only?(scope)
  defp valid_action_target?(_action, scope), do: Scope.environment?(scope)

  defp evidence(value) do
    with true <- strict?(value, @evidence_fields),
         true <- strict?(value.binding, @binding_fields),
         true <- strict?(value.principal, @principal_fields),
         true <- strict?(value.credential, @credential_fields),
         true <- strict?(value.target, [:scope, :active]),
         {:ok, target} <- Scope.new(value.target.scope),
         true <- is_boolean(value.target.active),
         true <- is_boolean(value.binding_active) and is_boolean(value.profile_active),
         true <- valid_binding?(value.binding),
         true <- valid_principal?(value.principal),
         true <- valid_credential?(value.credential),
         true <- revision?(value.organization_revision) and revision?(value.project_revision),
         true <- bounded_list?(value.memberships, 64),
         {:ok, memberships} <- memberships(value.memberships),
         true <- Enum.all?(memberships, &(&1.principal_id == value.principal.id)) do
      {:ok, %{value | memberships: memberships, target: %{value.target | scope: target}}}
    else
      _ -> {:error, :authorization_unavailable}
    end
  end

  defp valid_binding?(binding) do
    Scope.identifier?(binding.principal_id) and
      Encoding.bounded_string?(binding.profile_id, 128) and
      profile_version?(binding.profile_version) and
      Encoding.bounded_string?(binding.issuer, 2_048) and
      Encoding.bounded_string?(binding.subject, 256) and
      Encoding.bounded_string?(binding.client_id, 256) and
      binding.identity_class in [:human, :service]
  end

  defp valid_principal?(principal),
    do:
      Scope.identifier?(principal.id) and principal.identity_class in [:human, :service] and
        is_boolean(principal.active) and Encoding.numeric_date?(principal.not_before) and
        revision?(principal.revision)

  defp valid_credential?(credential),
    do:
      Encoding.bounded_string?(credential.reference, 256) and
        Scope.identifier?(credential.principal_id) and is_boolean(credential.active) and
        window?(credential.not_before, credential.expires_at) and revision?(credential.revision)

  defp memberships(values) do
    Enum.reduce_while(values, {:ok, [], MapSet.new()}, fn value, {:ok, result, ids} ->
      with true <- strict?(value, @membership_fields),
           true <-
             Scope.identifier?(value.id) and Scope.identifier?(value.principal_id) and
               value.role in @roles,
           false <- MapSet.member?(ids, value.id),
           {:ok, scope} <- Scope.new(value.scope),
           true <- membership_scope?(scope, value.project_binding),
           true <- is_boolean(value.active) and window?(value.not_before, value.expires_at),
           true <- revision?(value.revision) do
        {:cont, {:ok, [%{value | scope: scope} | result], MapSet.put(ids, value.id)}}
      else
        _ -> {:halt, :invalid}
      end
    end)
    |> case do
      {:ok, result, _ids} -> {:ok, Enum.reverse(result)}
      _ -> :invalid
    end
  end

  defp membership_scope?(%Scope{project_id: nil}, binding),
    do: binding in [:organization_only, :all_projects]

  defp membership_scope?(%Scope{application_id: nil}, :exact_project), do: true
  defp membership_scope?(_, _), do: false

  defp current_identity(identity, evidence, now) do
    binding = evidence.binding
    principal = evidence.principal
    credential = evidence.credential

    if Enum.all?(@binding_fields -- [:principal_id], fn field ->
         Map.fetch!(identity, field) == Map.fetch!(binding, field)
       end) and binding.principal_id == principal.id and
         credential.principal_id == principal.id and principal.identity_class == :human and
         credential.reference == identity.credential_ref and evidence.profile_active and
         evidence.binding_active and principal.active and credential.active and
         principal.not_before <= now and identity.issued_at >= principal.not_before and
         identity.issued_at >= credential.not_before and
         in_window?(credential.not_before, credential.expires_at, now) do
      :ok
    else
      {:error, :unauthenticated}
    end
  end

  defp live_target(target, %{scope: target, active: true}), do: :ok
  defp live_target(_target, _evidence), do: {:error, :not_found}

  defp eligible_memberships(memberships, target, now),
    do:
      Enum.filter(memberships, fn member ->
        member.active and in_window?(member.not_before, member.expires_at, now) and
          Scope.membership_covers?(member, target)
      end)

  defp visible([]), do: {:error, :not_found}
  defp visible(_), do: :ok

  defp permission(identity, action, memberships) do
    {scope, roles} = Map.fetch!(@actions, action)
    permitted = Enum.filter(memberships, &(&1.role in roles))

    if scope in identity.scopes and permitted != [] do
      {:ok, permitted |> Enum.map(& &1.role) |> Enum.uniq() |> Enum.sort(),
       permitted |> Enum.map(& &1.id) |> Enum.sort()}
    else
      {:error, :permission_denied}
    end
  end

  defp strict?(value, fields) when is_map(value) and not is_struct(value),
    do: map_size(value) == length(fields) and Enum.all?(fields, &Map.has_key?(value, &1))

  defp strict?(_, _), do: false
  defp profile_version?(value), do: is_integer(value) and value in 1..2_147_483_647
  defp revision?(value), do: is_integer(value) and value in 1..@max_integer
  defp window?(start, nil), do: Encoding.numeric_date?(start)

  defp window?(start, finish),
    do: Encoding.numeric_date?(start) and Encoding.numeric_date?(finish) and start < finish

  defp in_window?(start, finish, now), do: start <= now and (is_nil(finish) or now < finish)

  # Reject improper and over-limit lists before Enum traversal or duplicate checks.
  defp bounded_list?([], _remaining), do: true

  defp bounded_list?([_ | rest], remaining) when remaining > 0,
    do: bounded_list?(rest, remaining - 1)

  defp bounded_list?(_, _), do: false
end

c91424106b1963fa3f88f0a22a47f5769c0e058a blob 6737
defmodule MixerHosted.Authorization.Postgres.Evidence do
  @moduledoc false

  alias MixerHosted.Authorization.{Scope, Postgres.Session}

  def load!(repo, lookup, linkage) do
    # Every state query is a separate READ COMMITTED statement after the final
    # lock wait. Never use a pre-lock snapshot as current authorization evidence.
    i = lookup.identity

    [profile_active, issuer, client, identity_class] =
      Session.one!(
        repo,
        "SELECT active, issuer, client_id, identity_class FROM public.mixer_authz_profiles",
        [],
        :unauthenticated
      )

    [principal_id, binding_active] =
      Session.one!(
        repo,
        "SELECT principal_id, active FROM public.mixer_authz_bindings",
        [],
        :unauthenticated
      )

    [id, principal_class, active, not_before, revision] =
      Session.one!(
        repo,
        "SELECT id, identity_class, active, not_before, revision FROM public.mixer_authz_principals",
        [],
        :unauthenticated
      )

    [
      reference,
      credential_principal,
      family_id,
      credential_active,
      credential_start,
      credential_end,
      credential_revision
    ] =
      Session.one!(
        repo,
        "SELECT reference, principal_id, family_id, active, not_before, expires_at, revision FROM public.mixer_authz_credentials",
        [],
        :unauthenticated
      )

    [family_principal, family_active, family_start, family_end] =
      Session.one!(
        repo,
        "SELECT principal_id, active, not_before, expires_at FROM public.mixer_authz_families",
        [],
        :unauthenticated
      )

    if principal_id != linkage.principal_id or id != principal_id or
         credential_principal != principal_id or family_principal != principal_id or
         family_id != linkage.family_id or reference != i.credential_ref or
         issuer != i.issuer or client != i.client_id or identity_class != "human" or
         principal_class != "human" do
      repo.rollback(:unauthenticated)
    end

    [organization_revision] =
      Session.one!(
        repo,
        "SELECT revision FROM public.mixer_authz_organization_heads",
        [],
        :not_found
      )

    [project_revision] =
      Session.one!(repo, "SELECT revision FROM public.mixer_authz_project_heads", [], :not_found)

    memberships = memberships!(repo, lookup.target, principal_id)

    %{
      binding: %{
        profile_id: i.profile_id,
        profile_version: i.profile_version,
        issuer: issuer,
        subject: i.subject,
        client_id: client,
        identity_class: :human,
        principal_id: principal_id
      },
      binding_active: binding_active,
      profile_active: profile_active,
      principal: %{
        id: id,
        identity_class: :human,
        active: active,
        not_before: not_before,
        revision: revision
      },
      credential: %{
        reference: reference,
        principal_id: principal_id,
        active: credential_active and family_active,
        not_before: max(credential_start, family_start),
        expires_at: earliest(credential_end, family_end),
        revision: credential_revision
      },
      target: target!(repo, lookup.target),
      memberships: memberships,
      organization_revision: organization_revision,
      project_revision: project_revision
    }
  end

  defp memberships!(repo, target, principal) do
    rows =
      Session.query!(
        repo,
        """
        SELECT id, principal_id, role, organization_id, project_id, project_binding,
          active, not_before, expires_at, revision
        FROM public.mixer_authz_memberships
        WHERE principal_id = $1 AND organization_id = $2
          AND ((project_id IS NULL AND project_binding = 'all_projects')
            OR (project_id = $3 AND project_binding = 'exact_project'))
        ORDER BY id LIMIT 65
        """,
        [principal, target.organization_id, target.project_id]
      ).rows

    if length(rows) > 64, do: repo.rollback(:authorization_unavailable)

    Enum.map(rows, fn [
                        id,
                        principal_id,
                        role,
                        organization,
                        project,
                        binding,
                        active,
                        start,
                        finish,
                        revision
                      ] ->
      %{
        id: id,
        principal_id: principal_id,
        role: role,
        scope: %Scope{organization_id: organization, project_id: project},
        project_binding: project_binding(binding),
        active: active,
        not_before: start,
        expires_at: finish,
        revision: revision
      }
    end)
  end

  defp target!(repo, %Scope{application_id: nil} = target) do
    [organization, project, organization_active, project_active] =
      Session.one!(
        repo,
        """
        SELECT o.id, p.id, o.active, p.active
        FROM public.mixer_authz_projects p
        JOIN public.mixer_authz_organizations o ON o.id = p.organization_id
        WHERE p.organization_id = $1 AND p.id = $2
        """,
        [target.organization_id, target.project_id],
        :not_found
      )

    %{
      scope: %Scope{organization_id: organization, project_id: project},
      active: organization_active and project_active
    }
  end

  defp target!(repo, target) do
    [organization, project, application, environment, oa, pa, aa, ea] =
      Session.one!(
        repo,
        """
        SELECT o.id, p.id, a.id, e.id, o.active, p.active, a.active, e.active
        FROM public.mixer_authz_environments e
        JOIN public.mixer_authz_applications a ON (a.organization_id, a.project_id, a.id) =
          (e.organization_id, e.project_id, e.application_id)
        JOIN public.mixer_authz_projects p ON (p.organization_id, p.id) = (a.organization_id, a.project_id)
        JOIN public.mixer_authz_organizations o ON o.id = p.organization_id
        WHERE e.organization_id = $1 AND e.project_id = $2 AND e.application_id = $3 AND e.id = $4
        """,
        [target.organization_id, target.project_id, target.application_id, target.environment_id],
        :not_found
      )

    %{
      scope: %Scope{
        organization_id: organization,
        project_id: project,
        application_id: application,
        environment_id: environment
      },
      active: oa and pa and aa and ea
    }
  end

  defp earliest(nil, finish), do: finish
  defp earliest(start, nil), do: start
  defp earliest(a, b), do: min(a, b)
  defp project_binding("all_projects"), do: :all_projects
  defp project_binding("exact_project"), do: :exact_project
end

e9b14a0dfc23d63e280f580e19eced2478381692 blob 6489
defmodule MixerHosted.Authorization.Postgres.Session do
  @moduledoc false

  @tables ~w(profiles principals bindings families credentials organizations projects applications environments organization_heads project_heads memberships)
  @locks ~w(profiles principals families credentials organization_heads project_heads)

  def prepare!(repo, lookup) do
    linkage = prepare_identity_scope!(repo, lookup.identity, lookup.target)
    lock!(repo, "organization_heads", :not_found)
    lock!(repo, "project_heads", :not_found)
    linkage
  end

  # Read-only directory callers must separately validate current identity state,
  # select and lock their bounded tenant rows, and recheck before commit. This
  # helper supplies only linkage and identity locks, never artifact authority.
  def prepare_identity!(repo, identity) do
    prepare_identity_scope!(repo, identity, %{
      organization_id: nil,
      project_id: nil,
      application_id: nil,
      environment_id: nil
    })
  end

  defp prepare_identity_scope!(repo, i, scope) do
    if not repo.in_transaction?(), do: repo.rollback(:authorization_unavailable)

    query!(repo, "SET TRANSACTION ISOLATION LEVEL READ COMMITTED")
    query!(repo, "SET LOCAL statement_timeout = '5000ms'")
    query!(repo, "SET LOCAL lock_timeout = '500ms'")
    query!(repo, "SET LOCAL idle_in_transaction_session_timeout = '5000ms'")
    # These bounded authorization reads must not pay LLVM compilation cost for
    # RLS-expanded plans. LOCAL restores the connection's prior policy at either
    # transaction outcome; never change a pooled connection's session policy.
    query!(repo, "SET LOCAL jit = off")

    case query!(repo, "SELECT pg_catalog.current_setting('jit')").rows do
      [["off"]] -> :ok
      _ -> repo.rollback(:authorization_unavailable)
    end

    topology!(repo)

    context!(repo,
      profile_id: i.profile_id,
      profile_version: Integer.to_string(i.profile_version),
      issuer: i.issuer,
      subject: i.subject,
      client_id: i.client_id,
      identity_class: "human",
      credential_ref: i.credential_ref,
      organization_id: scope.organization_id,
      project_id: scope.project_id,
      application_id: scope.application_id,
      environment_id: scope.environment_id,
      principal_id: nil,
      family_id: nil,
      directory_mode: nil
    )

    lock!(repo, "profiles", :unauthenticated)

    principal =
      one!(repo, "SELECT principal_id FROM public.mixer_authz_bindings", [], :unauthenticated)
      |> hd()

    context!(repo, principal_id: principal)
    lock!(repo, "principals", :unauthenticated)

    [^principal, family] =
      one!(
        repo,
        "SELECT principal_id, family_id FROM public.mixer_authz_credentials",
        [],
        :unauthenticated
      )

    context!(repo, family_id: family)
    lock!(repo, "families", :unauthenticated)
    lock!(repo, "credentials", :unauthenticated)
    %{principal_id: principal, family_id: family}
  end

  def finish!(repo), do: query!(repo, "SELECT 1")

  def context!(repo, entries) do
    Enum.each(entries, fn {key, value} ->
      query!(repo, "SELECT pg_catalog.set_config($1, $2, true)", [
        "mixer.authz.#{key}",
        value || ""
      ])
    end)
  end

  def query!(repo, sql, params \\ []),
    do: Ecto.Adapters.SQL.query!(repo, sql, params, timeout: 5_000, queue: false)

  def one!(repo, sql, params, error) do
    case query!(repo, sql, params).rows do
      [row] -> row
      _ -> repo.rollback(error)
    end
  end

  defp lock!(repo, table, error) when table in @locks do
    case query!(repo, "SELECT public.mixer_authz_lock_#{table}()").rows do
      [[true]] -> :ok
      _ -> repo.rollback(error)
    end
  end

  defp topology!(repo) do
    # Check the effective login and every reachable privileged/owner role. The
    # runtime cannot SET ROLE back to an owner, bypass RLS, or perform authz DML.
    [[safe_role]] =
      query!(repo, """
      SELECT current_user = session_user AND NOT EXISTS (
        SELECT 1 FROM pg_catalog.pg_roles r
        WHERE pg_catalog.pg_has_role(current_user, r.oid, 'MEMBER')
          AND (r.rolsuper OR r.rolbypassrls OR r.rolcreaterole OR r.rolcreatedb OR r.rolreplication
            OR pg_catalog.substr(r.rolname::text, 1, 3) = 'pg_'))
      """).rows

    tables = Enum.map(@tables, &("mixer_authz_" <> &1))

    [[count, safe_tables]] =
      query!(
        repo,
        """
        SELECT count(*), bool_and(c.relrowsecurity AND c.relforcerowsecurity
          AND NOT owner.rolcanlogin AND NOT owner.rolsuper AND NOT owner.rolbypassrls
          AND NOT pg_catalog.pg_has_role(current_user, c.relowner, 'MEMBER')
          AND pg_catalog.has_table_privilege(current_user, c.oid, 'SELECT')
          AND NOT pg_catalog.has_table_privilege(current_user, c.oid, 'INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER')
          AND NOT pg_catalog.has_any_column_privilege(current_user, c.oid, 'INSERT,UPDATE,REFERENCES'))
        FROM pg_catalog.pg_class c
        JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        JOIN pg_catalog.pg_roles owner ON owner.oid = c.relowner
        WHERE n.nspname = 'public' AND c.relname = ANY($1::text[]) AND c.relkind = 'r'
        """,
        [tables]
      ).rows

    functions = Enum.map(@locks, &("mixer_authz_lock_" <> &1))

    [[function_count, safe_functions]] =
      query!(
        repo,
        """
        SELECT count(*), bool_and(p.prosecdef AND p.pronargs = 0
          AND p.proconfig = ARRAY['search_path=pg_catalog']::text[]
          AND NOT owner.rolcanlogin AND NOT owner.rolsuper AND NOT owner.rolbypassrls
          AND NOT pg_catalog.pg_has_role(current_user, p.proowner, 'MEMBER')
          AND pg_catalog.has_function_privilege(current_user, p.oid, 'EXECUTE')
          AND NOT EXISTS (SELECT 1 FROM pg_catalog.aclexplode(
            COALESCE(p.proacl, pg_catalog.acldefault('f', p.proowner))) a
            WHERE a.grantee = 0 AND a.privilege_type = 'EXECUTE'))
        FROM pg_catalog.pg_proc p
        JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace
        JOIN pg_catalog.pg_roles owner ON owner.oid = p.proowner
        WHERE n.nspname = 'public' AND p.proname = ANY($1::text[])
        """,
        [functions]
      ).rows

    if safe_role and count == length(@tables) and safe_tables and
         function_count == length(@locks) and safe_functions do
      :ok
    else
      repo.rollback(:authorization_unavailable)
    end
  end
end

