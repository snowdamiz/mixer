      ],
      "expression": "(((status = 'pending'::text) AND (claim_digest IS NULL) AND (claimed_at IS NULL) AND (claim_expires_at IS NULL) AND (completion_reason IS NULL) AND (key_id IS NOT NULL) AND (key_id ~ '^[A-Za-z0-9._-]{1,128}$'::text) AND (iv IS NOT NULL) AND (octet_length(iv) = 12) AND (tag IS NOT NULL) AND (octet_length(tag) = 16) AND (ciphertext IS NOT NULL) AND ((octet_length(ciphertext) >= 1) AND (octet_length(ciphertext) <= 8192))) OR ((status <> 'pending'::text) AND (key_id IS NULL) AND (iv IS NULL) AND (tag IS NULL) AND (ciphertext IS NULL) AND (((status = 'claimed'::text) AND (completion_reason IS NULL) AND (claim_digest IS NOT NULL) AND (claimed_at IS NOT NULL) AND (claim_expires_at IS NOT NULL) AND (claimed_at >= created_at) AND (claim_expires_at > claimed_at) AND (claim_expires_at <= expires_at)) OR ((completion_reason IS NOT NULL) AND (((status = 'provider_rejected'::text) AND (completion_reason = 'provider_rejected'::text)) OR ((status = 'completed'::text) AND (completion_reason = 'completed'::text) AND (claim_digest IS NOT NULL)) OR ((status = 'failed'::text) AND (completion_reason = ANY (ARRAY['exchange_failed'::text, 'oidc_failed'::text, 'identity_failed'::text, 'session_failed'::text])) AND (claim_digest IS NOT NULL)) OR ((status = 'superseded'::text) AND (completion_reason = ANY (ARRAY['superseded'::text, 'expired'::text, 'logout'::text]))))))))",
      "relation": "public.mixer_browser_oidc_attempts"
