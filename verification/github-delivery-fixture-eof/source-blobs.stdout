defmodule MixerHosted.CustomerWorkspace.Fixture.Admin do
  use Ecto.Repo, otp_app: :workspace_fixture, adapter: Ecto.Adapters.Postgres
end

defmodule MixerHosted.CustomerWorkspace.Fixture.Migration do
  use Ecto.Repo, otp_app: :workspace_fixture, adapter: Ecto.Adapters.Postgres
end

defmodule MixerHosted.CustomerWorkspace.Fixture.Runtime do
  use Ecto.Repo, otp_app: :workspace_fixture, adapter: Ecto.Adapters.Postgres

  # Test-only transaction-boundary fault injection. Production accepts no hook.
  def prepare_transaction(fun, opts) when is_function(fun, 0) do
    wrapped = fn ->
      result = fun.()

      case Process.get({__MODULE__, :fault}) do
        :rollback ->
          rollback(:synthetic_failure)

        :commit_constraint ->
          Ecto.Adapters.SQL.query!(
            __MODULE__,
            "INSERT INTO public.workspace_commit_probe VALUES (1),(1)",
            [],
            log: false
          )

        _ ->
          :ok
      end

      result
    end

    {wrapped, opts}
  end
end

defmodule MixerHosted.CustomerWorkspace.Fixture do
  alias MixerHosted.CustomerWorkspace.Fixture.{Admin, Runtime}
  alias MixerHosted.Identity.VerifiedIdentity
  def sql(sql, params \\ []), do: Ecto.Adapters.SQL.query!(Admin, sql, params, log: false)
  def runtime(sql, params \\ []), do: Ecto.Adapters.SQL.query!(Runtime, sql, params, log: false)
  def now, do: System.system_time(:second)

  def identity(changes \\ %{}) do
    struct!(
      VerifiedIdentity,
      Map.merge(
        %{
          profile_id: "profile",
          profile_version: 1,
          issuer: "https://issuer.example",
          subject: "subject",
          client_id: "client",
          credential_ref: "token",
          issued_at: now() - 20,
          expires_at: now() + 600,
          identity_class: :human,
          scopes: ["mixer.workspace.read"]
        },
        changes
      )
    )
  end

  def seed! do
    sql(
      "TRUNCATE public.mixer_authz_profiles, public.mixer_authz_principals, public.mixer_authz_organizations CASCADE"
    )

    for statement <- [
          "INSERT INTO public.mixer_authz_profiles(id,version,issuer,client_id,identity_class,active) VALUES ('profile',1,'https://issuer.example','client','human',true)",
          "INSERT INTO public.mixer_authz_principals VALUES ('person','human',true,0,1),('other','human',true,0,1)",
          "INSERT INTO public.mixer_authz_bindings(profile_id,profile_version,subject,identity_class,principal_id,active) VALUES ('profile',1,'subject','human','person',true),('profile',1,'other','human','other',true)",
          "INSERT INTO public.mixer_authz_families VALUES ('family','profile',1,'person',true,0,NULL,1),('other-family','profile',1,'other',true,0,NULL,1)",
          "INSERT INTO public.mixer_authz_credentials VALUES ('profile',1,'token','person','family',true,0,NULL,1),('profile',1,'other-token','other','other-family',true,0,NULL,1)",
          "INSERT INTO public.mixer_authz_organizations(id,active,display_name) VALUES ('org-a',true,'Team A'),('org-b',true,NULL),('org-inactive',false,'Inactive')",
          "INSERT INTO public.mixer_authz_projects(organization_id,id,active,display_name) VALUES ('org-a','project-a',true,'Project A'),('org-a','project-b',true,NULL),('org-a','project-inactive',false,'Inactive'),('org-b','project-a',true,'Foreign'),('org-inactive','project-a',true,'Inactive org')",
          "INSERT INTO public.mixer_authz_organization_heads SELECT id,1 FROM public.mixer_authz_organizations",
          "INSERT INTO public.mixer_authz_project_heads SELECT organization_id,id,1 FROM public.mixer_authz_projects"
        ],
        do: sql(statement)

    member("member", "org-a", "project-a", "exact_project", "developer")
    member("foreign", "org-b", "project-a", "exact_project", "owner", "other")
    :ok
  end

  def member(id, org, project, binding, role, actor \\ "person") do
    sql(
      "INSERT INTO public.mixer_authz_memberships VALUES ($1,$2,$3,$4,$5,$6,true,0,NULL,1)",
      [id, actor, org, project, binding, role]
    )
  end

  def context(mode, changes \\ []) do
    MixerHosted.Authorization.Postgres.Session.prepare_identity!(
      Runtime,
      MixerHosted.Authorization.Policy.identity_key(identity())
    )

    MixerHosted.Authorization.Postgres.Session.context!(
      Runtime,
      Keyword.merge(
        [
          directory_mode: mode,
          organization_id: if(mode == "projects", do: "org-a", else: nil),
          project_id: nil,
          application_id: nil,
          environment_id: nil,
          action: "workspace.read",
          required_scope: "mixer.workspace.read",
          phase: "directory",
          token_issued_at: Integer.to_string(now() - 20),
          token_expires_at: Integer.to_string(now() + 600)
        ],
        changes
      )
    )
  end

  def held_writer(table, org, project, mutation, parent, release_timeout \\ 2_000) do
    Admin.transaction(fn ->
      sql("SELECT 1 FROM public.mixer_authz_organizations WHERE id = $1 FOR SHARE", [org])

      condition =
        if table == "organization_heads",
          do: "organization_id = $1",
          else: "organization_id = $1 AND project_id = $2"

      params = if table == "organization_heads", do: [org], else: [org, project]
      sql("SELECT 1 FROM public.mixer_authz_#{table} WHERE #{condition} FOR UPDATE", params)
      send(parent, {:writer_locked, self()})

      receive do
        :commit -> mutation.()
      after
        release_timeout -> raise "writer not released"
      end
    end)
  end

  def reader_waiting? do
    sql(
      "SELECT EXISTS (SELECT 1 FROM pg_stat_activity WHERE usename = 'workspace_runtime' AND wait_event_type = 'Lock')"
    ).rows == [[true]]
  end

  def eventually(fun, left \\ 100)
  def eventually(fun, 0), do: fun.()

  def eventually(fun, left),
    do:
      if(fun.(),
        do: true,
        else:
          (
            Process.sleep(5)
            eventually(fun, left - 1)
          )
      )
end

defmodule MixerHosted.CustomerWorkspaceTest do
  use ExUnit.Case, async: false
  alias MixerHosted.CustomerWorkspace, as: Workspace
  alias MixerHosted.CustomerWorkspace.Input
  alias MixerHosted.CustomerWorkspace.Fixture, as: F
  alias MixerHosted.CustomerWorkspace.Fixture.{Admin, Migration, Runtime}
  @page %{limit: 50, cursor: nil}

  setup_all do
    Logger.configure(level: :warning)

    settings = [
      hostname: "127.0.0.1",
      port: String.to_integer(System.fetch_env!("MIXER_WORKSPACE_TEST_PORT")),
      database: "mixer_customer_workspace",
      ssl: false,
      log: false
    ]

    start_supervised!({Admin, settings ++ [username: "workspace_fixture_admin", pool_size: 6]})

    start_supervised!(
      {Migration,
       settings ++
         [
           username: "workspace_fixture_admin",
           pool_size: 2,
           after_connect: fn c -> Postgrex.query!(c, "SET ROLE workspace_owner", []) end
         ]}
    )

    start_supervised!(
      {Runtime,
       settings ++
         [username: "workspace_runtime", pool_size: 4, telemetry_prefix: [:workspace_probe]]}
    )

    for {version, module} <- [
          {20_261_025_000_003, MixerHosted.Repo.Migrations.AddCustomerAuthorization},
          {20_261_025_000_004, MixerHosted.Repo.Migrations.AddAuthorizationStateRevisions},
          {20_261_025_000_006, MixerHosted.Repo.Migrations.AddCustomerWorkspaceDiscovery}
        ],
        do: assert(:ok = Ecto.Migrator.up(Migration, version, module, log: false))

    # Observe additive rollback and reapply on the owned disposable database.
    assert :ok =
             Ecto.Migrator.down(
               Migration,
               20_261_025_000_006,
               MixerHosted.Repo.Migrations.AddCustomerWorkspaceDiscovery,
               log: false
             )

    assert [[0]] =
             F.sql(
               "SELECT count(*) FROM information_schema.columns WHERE table_name IN ('mixer_authz_organizations','mixer_authz_projects') AND column_name = 'display_name'"
             ).rows

    assert :ok =
             Ecto.Migrator.up(
               Migration,
               20_261_025_000_006,
               MixerHosted.Repo.Migrations.AddCustomerWorkspaceDiscovery,
               log: false
             )

    if path = System.get_env("MIXER_WORKSPACE_MIGRATION_RESULT"),
      do:
        File.write!(
          path,
          Jason.encode!(%{apply: true, rollback: true, reapply: true, disposable: true})
        )

    for name <-
          ~w(profiles principals bindings families credentials organizations projects applications environments organization_heads project_heads memberships),
        do: F.sql("GRANT SELECT ON public.mixer_authz_#{name} TO workspace_runtime")

    for name <- ~w(profiles principals families credentials organization_heads project_heads),
        do:
          F.sql(
            "GRANT EXECUTE ON FUNCTION public.mixer_authz_lock_#{name}() TO workspace_runtime"
          )

    F.sql(
      "CREATE TABLE public.workspace_commit_probe (id integer UNIQUE DEFERRABLE INITIALLY DEFERRED)"
    )

    F.sql("GRANT INSERT ON public.workspace_commit_probe TO workspace_runtime")
    :ok
  end

  setup do
    F.seed!()
    :ok
  end

  defp orgs(identity \\ F.identity(), page \\ @page),
    do: Workspace.organizations(identity, page, Runtime)

  defp projects(org \\ "org-a", identity \\ F.identity(), page \\ @page),
    do: Workspace.projects(identity, org, page, Runtime)

  test "all six roles and three explicit binding modes have precise discovery semantics" do
    for role <- ~w(owner administrator developer release_manager billing_manager viewer),
        binding <- ~w(organization_only all_projects exact_project) do
      F.sql("DELETE FROM public.mixer_authz_memberships WHERE principal_id = 'person'")
      project = if binding == "exact_project", do: "project-a", else: nil
      F.member("selected", "org-a", project, binding, role)
      assert {:ok, %{organizations: [org], next_cursor: nil}} = orgs()
      assert org.id == "org-a"
      assert org.organization_roles == if(binding == "exact_project", do: [], else: [role])
      assert {:ok, %{projects: result, next_cursor: nil}} = projects()

      expected =
        case binding do
          "organization_only" -> []
          "all_projects" -> ["project-a", "project-b"]
          "exact_project" -> ["project-a"]
        end

      assert Enum.map(result, & &1.id) == expected

      assert Enum.all?(result, &(&1.roles == [role] and &1.organization_id == "org-a"))
    end
  end

  test "role summaries are sorted unique and exact-project roles remain project scoped" do
    F.member("owner", "org-a", nil, "organization_only", "owner")
    F.member("viewer", "org-a", nil, "all_projects", "viewer")
    F.member("dev-again", "org-a", "project-a", "exact_project", "developer")
    assert {:ok, %{organizations: [%{organization_roles: ["owner", "viewer"]}]}} = orgs()
    assert {:ok, %{projects: [a, b]}} = projects()
    assert a.roles == ["developer", "viewer"]
    assert b.roles == ["viewer"]
  end

  test "inactive exact project identifies its active organization without project visibility" do
    F.sql("UPDATE public.mixer_authz_projects SET active = false WHERE organization_id = 'org-a'")
    assert {:ok, %{organizations: [%{id: "org-a"}], next_cursor: nil}} = orgs()
    assert {:ok, %{projects: [], next_cursor: nil}} = projects()
    F.sql("UPDATE public.mixer_authz_organizations SET active = false WHERE id = 'org-a'")
    assert {:ok, %{organizations: []}} = orgs()
    assert {:error, :not_found} = projects()
  end

  test "foreign and missing organizations are indistinguishable and no membership yields empty directory" do
    assert {:error, :not_found} = projects("org-b")
    assert {:error, :not_found} = projects("missing")
    assert {:error, :not_found} = projects("org-inactive")
    F.sql("DELETE FROM public.mixer_authz_memberships WHERE principal_id = 'person'")
    assert {:ok, %{organizations: [], next_cursor: nil}} = orgs()
  end

  test "strict human identity and exact new token scope precede database work" do
    for scopes <- [[], ["mixer.artifact.read"], ["mixer.workspace.read.extra"], ["*"]],
        do: assert({:error, :permission_denied} = orgs(F.identity(%{scopes: scopes})))

    assert {:error, :permission_denied} = orgs(F.identity(%{identity_class: :service}))

    for i <- [
          Map.from_struct(F.identity()),
          Map.put(F.identity(), :extra, true),
          F.identity(%{expires_at: F.now()}),
          F.identity(%{issued_at: F.now() + 31}),
          F.identity(%{scopes: ["mixer.workspace.read", "mixer.workspace.read"]}),
          F.identity(%{scopes: ["mixer.workspace.read" | :bad]})
        ],
        do: assert({:error, :unauthenticated} = orgs(i))

    assert {:error, :permission_denied} =
             Workspace.organizations(F.identity(%{scopes: []}), @page, MissingRepo)
  end

  test "every current identity revoke fence rejects and unknown credentials never bootstrap" do
    for mutation <- [
          "UPDATE public.mixer_authz_profiles SET active = false",
          "UPDATE public.mixer_authz_bindings SET active = false",
          "UPDATE public.mixer_authz_principals SET active = false WHERE id = 'person'",
          "UPDATE public.mixer_authz_families SET active = false WHERE id = 'family'",
          "UPDATE public.mixer_authz_credentials SET active = false WHERE reference = 'token'",
          "UPDATE public.mixer_authz_principals SET not_before = extract(epoch FROM clock_timestamp())::bigint WHERE id = 'person'",
          "UPDATE public.mixer_authz_families SET not_before = extract(epoch FROM clock_timestamp())::bigint WHERE id = 'family'",
          "UPDATE public.mixer_authz_credentials SET not_before = extract(epoch FROM clock_timestamp())::bigint WHERE reference = 'token'",
          "UPDATE public.mixer_authz_families SET expires_at = 1 WHERE id = 'family'",
          "UPDATE public.mixer_authz_credentials SET expires_at = 1 WHERE reference = 'token'"
        ] do
      F.seed!()
      F.sql(mutation)
      assert {:error, :unauthenticated} = orgs(), mutation
    end

    F.seed!()

    for changes <- [
          %{credential_ref: "missing"},
          %{subject: "missing"},
          %{issuer: "https://foreign.example"},
          %{client_id: "foreign"},
          %{profile_version: 2},
          %{credential_ref: "other-token"}
        ],
        do: assert({:error, :unauthenticated} = orgs(F.identity(changes)))
  end

  test "expired, future and inactive memberships disclose no workspace" do
    for predicate <- ["active = false", "expires_at = 1", "not_before = 9007199254740990"] do
      F.seed!()
      F.sql("UPDATE public.mixer_authz_memberships SET #{predicate} WHERE id = 'member'")
      assert {:ok, %{organizations: []}} = orgs()
      assert {:error, :not_found} = projects()
    end
  end

  test "actual nullable names are preserved and malformed stored names fail closed" do
    assert {:ok, %{organizations: [%{display_name: "Team A"}]}} = orgs()
    F.member("all", "org-a", nil, "all_projects", "viewer")
    assert {:ok, %{projects: [%{display_name: "Project A"}, %{display_name: nil}]}} = projects()

    F.sql("UPDATE public.mixer_authz_organizations SET display_name = $1 WHERE id = 'org-a'", [
      "  Équipe *  "
    ])

    assert {:ok, %{organizations: [%{display_name: "  Équipe *  "}]}} = orgs()

    boundary = String.duplicate("é", 128)

    F.sql("UPDATE public.mixer_authz_organizations SET display_name = $1 WHERE id = 'org-a'", [
      boundary
    ])

    assert {:ok, %{organizations: [%{display_name: ^boundary}]}} = orgs()

    for name <- ["bad\nname", "bad" <> <<127>>, "bad" <> <<0xC2, 0x85>>] do
      F.sql("UPDATE public.mixer_authz_organizations SET display_name = $1 WHERE id = 'org-a'", [
        name
      ])

      assert {:error, :authorization_unavailable} = orgs()
    end

    assert_raise Postgrex.Error, fn ->
      F.sql("UPDATE public.mixer_authz_organizations SET display_name = '' WHERE id = 'org-a'")
    end

    assert_raise Postgrex.Error, fn ->
      F.sql("UPDATE public.mixer_authz_organizations SET display_name = $1 WHERE id = 'org-a'", [
        boundary <> "x"
      ])
    end
  end

  test "full Scope IDs and C collation survive multi-page organization and project discovery" do
    F.sql("DELETE FROM public.mixer_authz_memberships WHERE principal_id = 'person'")
    ids = [".", "..", "a/b", "a:b", "a+b", "a%b", "quote'\"", "équipe", "日本"]

    for {id, index} <- Enum.with_index(ids) do
      F.sql("INSERT INTO public.mixer_authz_organizations(id,active) VALUES ($1,true)", [id])
      F.sql("INSERT INTO public.mixer_authz_organization_heads VALUES ($1,1)", [id])

      F.sql(
        "INSERT INTO public.mixer_authz_projects(organization_id,id,active) VALUES ($1,$1,true)",
        [id]
      )

      F.sql("INSERT INTO public.mixer_authz_project_heads VALUES ($1,$1,1)", [id])
      F.member("m#{index}", id, nil, "all_projects", "viewer")
      assert {:ok, %{projects: [%{id: ^id, organization_id: ^id}]}} = projects(id)
    end

    assert walk_orgs(nil, []) == Enum.sort(ids)

    assert {:ok, %{organizations: [], next_cursor: nil}} =
             orgs(F.identity(), %{limit: 2, cursor: Input.cursor("organizations", nil, "􏿿")})
  end

  test "projects paginate independently and bind cursors to exact organization" do
    F.member("all", "org-a", nil, "all_projects", "viewer")

    assert {:ok, %{projects: [%{id: "project-a"}], next_cursor: cursor}} =
             projects("org-a", F.identity(), %{limit: 1, cursor: nil})

    assert is_binary(cursor)

    assert {:ok, %{projects: [%{id: "project-b"}], next_cursor: nil}} =
             projects("org-a", F.identity(), %{limit: 1, cursor: cursor})

    assert {:error, :invalid_request} =
             projects("org-b", F.identity(), %{limit: 1, cursor: cursor})

    assert {:error, :invalid_request} = orgs(F.identity(), %{limit: 1, cursor: cursor})
  end

  test "closed bounded pagination rejects noncanonical and duplicate cursor JSON" do
    for page <- [
          %{},
          %{limit: 1},
          %{limit: 1, cursor: nil, extra: true},
          %{limit: 0, cursor: nil},
          %{limit: 101, cursor: nil},
          %{limit: "1", cursor: nil},
          %{limit: 1.0, cursor: nil},
          %{limit: 1, cursor: ""},
          %{limit: 1, cursor: String.duplicate("A", 1401)}
        ],
        do: assert({:error, :invalid_request} = orgs(F.identity(), page))

    for raw <- [
          ~s({"v":1,"kind":"organizations","after":"x","extra":true}),
          ~s({"v":1,"kind":"organizations","after":"x","after":"y"}),
          ~s({"v":1,"kind":"organizations","after":"x","\\u0061fter":"y"}),
          ~s({"kind":"organizations","v":1,"after":"x"}),
          ~s({"v":1, "kind":"organizations","after":"x"}),
          ~s({"v":1,"kind":"organizations","after":"\\u0078"}),
          ~s({"v":2,"kind":"organizations","after":"x"}),
          ~s({"v":1,"kind":"organizations","after":"*"})
        ] do
      assert {:error, :invalid_request} =
               orgs(F.identity(), %{limit: 1, cursor: Base.url_encode64(raw, padding: false)})
    end

    canonical = Input.cursor("organizations", nil, "x")
    assert {:error, :invalid_request} = orgs(F.identity(), %{limit: 1, cursor: canonical <> "="})
    assert {:error, :invalid_request} = projects("*")
  end

  test "directory RLS is closed by mode action phase scope identity and ordinary resource context" do
    for changes <- [
          [directory_mode: "bad"],
          [action: "artifact.read"],
          [required_scope: "mixer.artifact.read"],
          [phase: "effect"],
          [token_expires_at: "1"],
          [project_id: "project-a"],
          [organization_id: "org-a"]
        ] do
      assert {:ok, :ok} =
               Runtime.transaction(fn ->
                 F.context("organizations", changes)
                 assert F.runtime("SELECT id FROM public.mixer_authz_organizations").rows == []
                 assert F.runtime("SELECT id FROM public.mixer_authz_memberships").rows == []
                 :ok
               end)
    end

    assert {:ok, :ok} =
             Runtime.transaction(fn ->
               F.context("organizations")

               assert F.runtime("SELECT id FROM public.mixer_authz_organizations").rows == [
                        ["org-a"]
                      ]

               assert F.runtime("SELECT id FROM public.mixer_authz_projects").rows == []
               assert F.runtime("SELECT id FROM public.mixer_authz_applications").rows == []

               assert F.runtime("SELECT id FROM public.mixer_authz_memberships").rows == [
                        ["member"]
                      ]

               :ok
             end)

    assert {:ok, :ok} =
             Runtime.transaction(fn ->
               F.context("")
               assert F.runtime("SELECT id FROM public.mixer_authz_organizations").rows == []
               assert {:error, :authorization_unavailable} = orgs()
               :ok
             end)

    assert F.runtime("SELECT current_setting('mixer.authz.directory_mode',true)").rows in [
             [[nil]],
             [[""]]
           ]

    assert {:ok, %{organizations: [_]}} = orgs()
  end

  test "ordinary empty-mode resource RLS retains exact artifact ancestry" do
    F.sql(
      "INSERT INTO public.mixer_authz_applications VALUES ('org-a','project-a','app',true),('org-a','project-b','app',true),('org-b','project-a','app',true)"
    )

    F.sql(
      "INSERT INTO public.mixer_authz_environments VALUES ('org-a','project-a','app','env',true),('org-a','project-b','app','env',true),('org-b','project-a','app','env',true)"
    )

    assert {:ok, :ok} =
             Runtime.transaction(fn ->
               F.context("",
                 organization_id: "org-a",
                 project_id: "project-a",
                 application_id: "app",
                 environment_id: "env",
                 action: "artifact.read",
                 required_scope: "mixer.artifact.read",
                 phase: "effect"
               )

               assert F.runtime("SELECT id FROM public.mixer_authz_organizations").rows == [
                        ["org-a"]
                      ]

               assert F.runtime("SELECT id FROM public.mixer_authz_projects").rows == [
                        ["project-a"]
                      ]

               assert F.runtime("SELECT id FROM public.mixer_authz_memberships").rows == [
                        ["member"]
                      ]

               assert F.runtime(
                        "SELECT organization_id,project_id,id FROM public.mixer_authz_applications"
                      ).rows == [["org-a", "project-a", "app"]]

               assert F.runtime(
                        "SELECT organization_id,project_id,application_id,id FROM public.mixer_authz_environments"
                      ).rows == [["org-a", "project-a", "app", "env"]]

               :ok
             end)

    F.sql(
      "UPDATE public.mixer_authz_memberships SET project_id = NULL,project_binding = 'organization_only',role = 'owner' WHERE id = 'member'"
    )

    assert {:ok, :ok} =
             Runtime.transaction(fn ->
               F.context("",
                 organization_id: "org-a",
                 project_id: "project-a",
                 application_id: "app",
                 environment_id: "env",
                 action: "artifact.read",
                 required_scope: "mixer.artifact.read",
                 phase: "effect"
               )

               assert F.runtime("SELECT id FROM public.mixer_authz_organizations").rows == []
               assert F.runtime("SELECT id FROM public.mixer_authz_projects").rows == []
               assert F.runtime("SELECT id FROM public.mixer_authz_applications").rows == []
               assert F.runtime("SELECT id FROM public.mixer_authz_environments").rows == []
               :ok
             end)

    # No workspace action was added to the artifact authority-producing path.
    assert {:error, :permission_denied} =
             MixerHosted.Authorization.Policy.request(
               F.identity(),
               "workspace.read",
               %{organization_id: "org-a"},
               F.now()
             )
  end

  test "runtime has no mutation or bypass authority and topology violations suppress results" do
    assert_raise Postgrex.Error, fn ->
      F.runtime("UPDATE public.mixer_authz_organizations SET active = false")
    end

    F.sql("GRANT UPDATE ON public.mixer_authz_organizations TO workspace_runtime")

    try do
      assert {:error, :authorization_unavailable} = orgs()
    after
      F.sql("REVOKE UPDATE ON public.mixer_authz_organizations FROM workspace_runtime")
    end

    F.sql("ALTER TABLE public.mixer_authz_projects NO FORCE ROW LEVEL SECURITY")

    try do
      assert {:error, :authorization_unavailable} = orgs()
    after
      F.sql("ALTER TABLE public.mixer_authz_projects FORCE ROW LEVEL SECURITY")
    end

    assert {:error, :authorization_unavailable} =
             Workspace.organizations(F.identity(), @page, Admin)
  end

  test "committed selected project revocation during final head wait is freshly seen" do
    parent = self()

    writer =
      Task.async(fn ->
        F.held_writer(
          "project_heads",
          "org-a",
          "project-a",
          fn ->
            F.sql("UPDATE public.mixer_authz_memberships SET active = false WHERE id = 'member'")
          end,
          parent
        )
      end)

    assert_receive {:writer_locked, pid}
    reader = Task.async(fn -> projects() end)
    assert F.eventually(&F.reader_waiting?/0)
    send(pid, :commit)
    assert {:ok, _} = Task.await(writer)
    assert {:error, :authorization_unavailable} = Task.await(reader)
    assert {:error, :not_found} = projects()
  end

  test "committed selected organization revocation during head wait is freshly seen" do
    F.member("all", "org-a", nil, "all_projects", "viewer")
    parent = self()

    writer =
      Task.async(fn ->
        F.held_writer(
          "organization_heads",
          "org-a",
          nil,
          fn ->
            F.sql("UPDATE public.mixer_authz_organizations SET active = false WHERE id = 'org-a'")
          end,
          parent
        )
      end)

    assert_receive {:writer_locked, pid}
    reader = Task.async(fn -> orgs() end)
    assert F.eventually(&F.reader_waiting?/0)
    send(pid, :commit)
    assert {:ok, _} = Task.await(writer)
    assert {:error, :authorization_unavailable} = Task.await(reader)
  end

  test "missing selected heads and read errors are unavailable and next call is clean" do
    F.sql(
      "DELETE FROM public.mixer_authz_project_heads WHERE organization_id = 'org-a' AND project_id = 'project-a'"
    )

    assert {:error, :authorization_unavailable} = orgs()
    F.sql("INSERT INTO public.mixer_authz_project_heads VALUES ('org-a','project-a',1)")
    assert {:ok, %{organizations: [_]}} = orgs()
    F.sql("REVOKE SELECT ON public.mixer_authz_memberships FROM workspace_runtime")

    try do
      assert {:error, :authorization_unavailable} = orgs()
    after
      F.sql("GRANT SELECT ON public.mixer_authz_memberships TO workspace_runtime")
    end

    assert {:ok, %{organizations: [_]}} = orgs()
  end

  test "actual deferred commit constraint failure and explicit rollback suppress prepared pages" do
    for fault <- [:rollback, :commit_constraint] do
      Process.put({Runtime, :fault}, fault)

      try do
        assert {:error, :authorization_unavailable} = orgs()
        assert [[0]] = F.sql("SELECT count(*) FROM public.workspace_commit_probe").rows
      after
        Process.delete({Runtime, :fault})
      end

      assert {:ok, %{organizations: [_]}} = orgs()
    end
  end

  test "large customers do not inherit the artifact policy's membership cap" do
    F.sql("""
    INSERT INTO public.mixer_authz_projects(organization_id,id,active)
    SELECT 'org-a', 'bulk-' || lpad(n::text,3,'0'), true FROM generate_series(1,120) n
    """)

    F.sql("""
    INSERT INTO public.mixer_authz_project_heads
    SELECT organization_id,id,1 FROM public.mixer_authz_projects WHERE id LIKE 'bulk-%'
    """)

    F.sql("""
    INSERT INTO public.mixer_authz_memberships
    SELECT 'member-' || id, 'person', organization_id,id,'exact_project','viewer',true,0,NULL,1
    FROM public.mixer_authz_projects WHERE id LIKE 'bulk-%'
    """)

    assert {:ok, %{projects: first, next_cursor: cursor}} =
             projects("org-a", F.identity(), %{limit: 100, cursor: nil})

    assert length(first) == 100
    assert Enum.all?(first, &(&1.roles == ["viewer"]))
    assert is_binary(cursor)

    assert {:ok, %{projects: last, next_cursor: nil}} =
             projects("org-a", F.identity(), %{limit: 100, cursor: cursor})

    assert length(last) == 21
    assert length(Enum.uniq(Enum.map(first ++ last, & &1.id))) == 121
  end

  test "a lost frozen exact-project visibility witness is never replaced by an unlocked survivor" do
    F.member("zzz-survivor", "org-a", "project-b", "exact_project", "viewer")
    parent = self()

    writer =
      Task.async(fn ->
        F.held_writer(
          "project_heads",
          "org-a",
          "project-a",
          fn ->
            F.sql("UPDATE public.mixer_authz_memberships SET active = false WHERE id = 'member'")
          end,
          parent
        )
      end)

    assert_receive {:writer_locked, pid}
    reader = Task.async(fn -> orgs() end)
    assert F.eventually(&F.reader_waiting?/0)
    send(pid, :commit)
    assert {:ok, _} = Task.await(writer)
    assert {:error, :authorization_unavailable} = Task.await(reader)
    assert {:ok, %{organizations: [%{id: "org-a"}]}} = orgs()
  end

  test "membership expiry across a real bounded head lock wait suppresses selected rows" do
    parent = self()

    writer =
      Task.async(fn ->
        F.held_writer("project_heads", "org-a", "project-a", fn -> :ok end, parent, 5_000)
      end)

    assert_receive {:writer_locked, pid}, 1_000
    expiry = F.now() + 3

    F.sql("UPDATE public.mixer_authz_memberships SET expires_at = $1 WHERE id = 'member'", [
      expiry
    ])

    handler = {__MODULE__, make_ref()}
    probe = {__MODULE__, :head_expiry_probe}
    head_query = "SELECT public.mixer_authz_lock_project_heads()"

    :telemetry.attach(
      handler,
      [:workspace_probe, :query],
      fn _, measurements, metadata, _ ->
        stage = Process.get(probe)

        witness_query? =
          String.contains?(
            metadata.query,
            "FROM public.mixer_authz_memberships WHERE id = ANY($1::text[])"
          )

        cond do
          stage == :select_witness and witness_query? ->
            send(
              parent,
              {:expiry_witness_selected, metadata.result, System.system_time(:millisecond)}
            )

            Process.put(probe, :witness_selected)

          stage == :witness_selected and
              metadata.params == ["mixer.authz.project_id", "project-a"] ->
            Process.put(probe, :project_context)

          stage == :project_context and
              metadata.params == ["mixer.authz.environment_id", ""] ->
            # All DB, writer and reader preparation is finished. Align only the
            # immediately following real lock query within its unchanged 500ms
            # production timeout, after capturing the membership's actual expiry.
            delay = expiry * 1000 - System.system_time(:millisecond) - 300
            if delay > 0, do: Process.sleep(delay)
            Process.put(probe, :waiting_for_head)
            send(parent, {:expiry_entering_head_lock, System.system_time(:millisecond)})

          stage == :waiting_for_head and metadata.query == head_query ->
            send(
              parent,
              {:expiry_head_lock_completed, metadata.result, System.system_time(:millisecond),
               System.convert_time_unit(measurements.query_time, :native, :microsecond)}
            )

            Process.put(probe, :head_completed)

          stage == :head_completed and
              metadata.query ==
                "SELECT id, display_name FROM public.mixer_authz_organizations WHERE active AND id = ANY($1::text[])" ->
            send(
              parent,
              {:expiry_selected_rows_reread, metadata.result, System.system_time(:millisecond)}
            )

            Process.put(probe, :done)

          true ->
            :ok
        end
      end,
      nil
    )

    reader =
      Task.async(fn ->
        Process.put(probe, :select_witness)
        orgs()
      end)

    try do
      assert_receive {:expiry_witness_selected, {:ok, %{rows: [witness]}}, selected_at}, 2_000
      assert Enum.at(witness, 8) == expiry
      assert selected_at < expiry * 1000
      assert_receive {:expiry_entering_head_lock, entering_at}, 4_000
      assert entering_at < expiry * 1000

      assert F.eventually(fn ->
               F.sql(
                 "SELECT EXISTS (SELECT 1 FROM pg_stat_activity WHERE usename = 'workspace_runtime' AND wait_event_type = 'Lock' AND query = $1)",
                 [head_query]
               ).rows == [[true]]
             end)

      waiting_at = System.system_time(:millisecond)
      assert waiting_at < expiry * 1000
      delay = expiry * 1000 - System.system_time(:millisecond) + 2
      if delay > 0, do: Process.sleep(delay)
      released_at = System.system_time(:millisecond)
      assert released_at >= expiry * 1000
      send(pid, :commit)
      assert {:ok, _} = Task.await(writer)
      assert {:error, :authorization_unavailable} = Task.await(reader)

      assert_receive {:expiry_head_lock_completed, {:ok, %{rows: [[true]]}}, completed_at,
                      lock_query_us}

      assert completed_at >= expiry * 1000
      assert_receive {:expiry_selected_rows_reread, {:ok, %{rows: []}}, reread_at}
      assert reread_at >= expiry * 1000

      if path = System.get_env("MIXER_WORKSPACE_LOCK_EXPIRY_RESULT") do
        File.write!(
          path,
          Jason.encode!(%{
            expiry_unix_second: expiry,
            selected_unix_millisecond: selected_at,
            entering_unix_millisecond: entering_at,
            waiting_unix_millisecond: waiting_at,
            released_unix_millisecond: released_at,
            completed_unix_millisecond: completed_at,
            reread_unix_millisecond: reread_at,
            lock_query_microsecond: lock_query_us,
            lock_completed_successfully: true,
            expired_selected_rows_reread_empty: true
          })
        )
      end
    after
      send(pid, :commit)
      Task.shutdown(writer, 1_000)
      Task.shutdown(reader, 1_000)
      :telemetry.detach(handler)
    end

    assert {:ok, %{organizations: []}} = orgs()
  end

  test "changed directory GUCs or active artifact context invalidate finalization" do
    owner = self()
    handler = {__MODULE__, make_ref()}

    :telemetry.attach(
      handler,
      [:workspace_probe, :query],
      fn _, _, metadata, _ ->
        if metadata.query == "SELECT 1" and Process.get(:workspace_context_probe) do
          changes = Process.delete(:workspace_context_probe)
          MixerHosted.Authorization.Postgres.Session.context!(Runtime, changes)
          send(owner, :context_change_observed)
        end
      end,
      nil
    )

    try do
      for change <- [
            [directory_mode: "projects"],
            [phase: "effect"],
            [organization_id: "org-b"],
            [required_scope: "mixer.artifact.read"],
            [transaction_marker: "changed"]
          ] do
        Process.put(:workspace_context_probe, change)
        assert {:error, :authorization_unavailable} = orgs()
        assert_receive :context_change_observed
      end
    after
      :telemetry.detach(handler)
      Process.delete(:workspace_context_probe)
    end

    context_key = {MixerHosted.Authorization.Transaction.Context, :active}
    Process.put(context_key, %{synthetic_active_context: true})

    try do
      assert {:error, :authorization_unavailable} = orgs()
    after
      Process.delete(context_key)
    end

    assert {:ok, %{organizations: [_]}} = orgs()
  end

  test "expiry during the final SQL boundary suppresses a prepared page" do
    expiry = F.now() + 2
    owner = self()
    handler = {__MODULE__, make_ref()}

    :telemetry.attach(
      handler,
      [:workspace_probe, :query],
      fn _, _, metadata, _ ->
        if metadata.query == "SELECT 1" and Process.get(:workspace_expiry_probe) do
          Process.delete(:workspace_expiry_probe)
          send(owner, :final_boundary_observed)
          remaining = expiry * 1000 - System.system_time(:millisecond)
          if remaining > 0, do: Process.sleep(remaining + 1)
        end
      end,
      nil
    )

    Process.put(:workspace_expiry_probe, true)

    try do
      assert {:error, :unauthenticated} = orgs(F.identity(%{expires_at: expiry}))
      assert_receive :final_boundary_observed
    after
      :telemetry.detach(handler)
      Process.delete(:workspace_expiry_probe)
    end

    assert {:ok, %{organizations: [_]}} = orgs()
  end

  test "a revoker racing a selected locked read waits until its owning commit" do
    owner = self()
    handler = {__MODULE__, make_ref()}

    :telemetry.attach(
      handler,
      [:workspace_probe, :query],
      fn _, _, metadata, _ ->
        if metadata.query == "SELECT 1" and Process.get(:workspace_hold_probe) do
          Process.delete(:workspace_hold_probe)
          send(owner, {:read_ready_to_commit, self()})

          receive do
            :release_read -> :ok
          after
            2_000 -> raise "read not released"
          end
        end
      end,
      nil
    )

    try do
      reader =
        Task.async(fn ->
          Process.put(:workspace_hold_probe, true)
          orgs()
        end)

      assert_receive {:read_ready_to_commit, reader_pid}, 1_000

      writer =
        Task.async(fn ->
          Admin.transaction(fn ->
            F.sql(
              "SELECT 1 FROM public.mixer_authz_organization_heads WHERE organization_id = 'org-a' FOR SHARE"
            )

            F.sql(
              "SELECT 1 FROM public.mixer_authz_project_heads WHERE organization_id = 'org-a' AND project_id = 'project-a' FOR UPDATE"
            )

            F.sql("UPDATE public.mixer_authz_memberships SET active = false WHERE id = 'member'")
          end)
        end)

      assert F.eventually(fn ->
               F.sql(
                 "SELECT EXISTS (SELECT 1 FROM pg_stat_activity WHERE usename = 'workspace_fixture_admin' AND wait_event_type = 'Lock')"
               ).rows == [[true]]
             end)

      send(reader_pid, :release_read)
      assert {:ok, %{organizations: [_]}} = Task.await(reader)
      assert {:ok, _} = Task.await(writer)
      assert {:ok, %{organizations: []}} = orgs()
    after
      :telemetry.detach(handler)
    end
  end

  defp walk_orgs(cursor, acc) do
    assert {:ok, %{organizations: rows, next_cursor: next}} =
             orgs(F.identity(), %{limit: 2, cursor: cursor})

    result = acc ++ Enum.map(rows, & &1.id)
    if next, do: walk_orgs(next, result), else: result
  end
end

23c685438feb73bbaa18693b3ef1a8f7f5f15827 blob 22379
defmodule MixerHosted.Identity.AccessTokenVerifierTest do
  use ExUnit.Case, async: false

  alias MixerHosted.Identity.{AccessTokenVerifier, TrustSnapshot, VerifiedIdentity}

  @now 1_800_000_000
  @profile %{
    profile_id: "synthetic-rfc9068-rs256-v1",
    profile_version: 1,
    issuer: "https://issuer.invalid/oauth",
    audience: "mixer-api",
    client_id: "registered-client",
    identity_class: :human,
    enabled: true
  }

  setup_all do
    {:ok, _} = Application.ensure_all_started(:jose)
    private = JOSE.JWK.generate_key({:rsa, 2_048})
    large_private = JOSE.JWK.generate_key({:rsa, 4_096})
    wrong_private = JOSE.JWK.generate_key({:rsa, 2_048})
    weak_private = JOSE.JWK.generate_key({:rsa, 1_024})
    public = public(private)

    {:ok,
     private: private,
     large_private: large_private,
     wrong_private: wrong_private,
     weak_private: weak_private,
     public: public,
     snapshot: snapshot([public]),
     header: %{"alg" => "RS256", "kid" => "test-rsa", "typ" => "at+jwt"},
     claims: %{
       "iss" => @profile.issuer,
       "aud" => @profile.audience,
       "sub" => "subject-1",
       "client_id" => @profile.client_id,
       "jti" => "credential-1",
       "iat" => @now - 1,
       "exp" => @now + 299,
       "scope" => "mixer.artifact.read mixer.artifact.upload mixer.audit.read"
     }}
  end

  defp public(private, kid \\ "test-rsa") do
    private
    |> JOSE.JWK.to_public()
    |> JOSE.JWK.to_map()
    |> elem(1)
    |> Map.merge(%{"kid" => kid, "alg" => "RS256", "use" => "sig", "key_ops" => ["verify"]})
  end

  defp snapshot(keys, profile \\ @profile, fetched_at \\ @now - 1, fresh_until \\ @now + 299) do
    {:ok, value} =
      TrustSnapshot.new(profile, Jason.encode!(%{"keys" => keys}), fetched_at, fresh_until)

    value
  end

  defp sign(context, claims \\ nil, header \\ nil) do
    JOSE.JWS.sign(context.private, json(claims || context.claims), header || context.header)
    |> JOSE.JWS.compact()
    |> elem(1)
  end

  defp json(raw) when is_binary(raw), do: raw
  defp json(value), do: Jason.encode!(value)

  # Signing arbitrary original JSON bytes exercises policy independently of the
  # test serializer. The product uses JOSE, never this test-only raw signer.
  defp sign_raw(context, raw_header, raw_payload) do
    input =
      Base.url_encode64(raw_header, padding: false) <>
        "." <> Base.url_encode64(raw_payload, padding: false)

    {_, key} = JOSE.JWK.to_key(context.private)
    signature = :public_key.sign(input, :sha256, key)
    input <> "." <> Base.url_encode64(signature, padding: false)
  end

  defp reject(context, token) do
    assert AccessTokenVerifier.verify(token, @now, context.snapshot) == {:error, :unauthenticated}
  end

  defp invalid_snapshot(keys, profile \\ @profile) do
    assert TrustSnapshot.new(profile, json(%{"keys" => keys}), @now - 1, @now + 299) ==
             {:error, :invalid_trust_configuration}
  end

  test "real 2048/4096-bit RS256 signatures and both access-token type spellings", c do
    for key <- [c.private, c.large_private], typ <- ["at+jwt", "application/at+jwt"] do
      context = %{c | private: key}
      trust = snapshot([public(key)])
      token = sign(context, nil, %{c.header | "typ" => typ})
      assert {:ok, identity} = AccessTokenVerifier.verify(token, @now, trust)

      assert Map.from_struct(identity) == %{
               profile_id: @profile.profile_id,
               profile_version: 1,
               issuer: @profile.issuer,
               subject: "subject-1",
               client_id: @profile.client_id,
               credential_ref: "credential-1",
               issued_at: @now - 1,
               expires_at: @now + 299,
               identity_class: :human,
               scopes: ["mixer.artifact.read", "mixer.artifact.upload", "mixer.audit.read"]
             }

      assert %VerifiedIdentity{} = identity
    end
  end

  test "signature and payload changes, wrong key and noncanonical signature are rejected", c do
    [header, payload, signature] = :binary.split(sign(c), ".", [:global])

    changed =
      Jason.encode!(%{c.claims | "sub" => "attacker"}) |> Base.url_encode64(padding: false)

    reject(c, Enum.join([header, changed, signature], "."))
    <<first, rest::binary>> = Base.url_decode64!(signature, padding: false)

    changed_signature =
      Base.url_encode64(<<Bitwise.bxor(first, 1), rest::binary>>, padding: false)

    reject(c, Enum.join([header, payload, changed_signature], "."))
    reject(c, sign(%{c | private: c.wrong_private}))
    reject(c, Enum.join([header, payload, signature <> "="], "."))

    # A 2048-bit RSA signature ends with four unused base64 bits. Alter only
    # those bits: decoded bytes match, but the wire encoding is noncanonical.
    alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    last = :binary.last(signature)
    {index, 1} = :binary.match(alphabet, <<last>>)

    alternate =
      binary_part(signature, 0, byte_size(signature) - 1) <> <<:binary.at(alphabet, index + 1)>>

    assert Base.url_decode64!(alternate, padding: false) ==
             Base.url_decode64!(signature, padding: false)

    reject(c, Enum.join([header, payload, alternate], "."))
  end

  test "none and genuine unsupported RSA/HMAC/EC/EdDSA signatures cannot widen policy", c do
    none_header =
      Jason.encode!(%{c.header | "alg" => "none"}) |> Base.url_encode64(padding: false)

    payload = Jason.encode!(c.claims) |> Base.url_encode64(padding: false)
    reject(c, none_header <> "." <> payload <> ".")

    for alg <- ["RS512", "PS256"] do
      token = sign(c, nil, %{c.header | "alg" => alg})
      assert {true, _, _} = JOSE.JWS.verify_strict(c.private, [alg], token)
      reject(c, token)
    end

    {_, pem} = JOSE.JWK.to_pem(JOSE.JWK.from_map(c.public))
    hmac = JOSE.JWK.from_oct(pem)

    for {alg, key} <- [
          {"HS256", hmac},
          {"ES256", JOSE.JWK.generate_key({:ec, :secp256r1})},
          {"EdDSA", JOSE.JWK.generate_key({:okp, :Ed25519})}
        ] do
      token = sign(%{c | private: key}, nil, %{c.header | "alg" => alg})
      assert {true, _, _} = JOSE.JWS.verify_strict(key, [alg], token)
      reject(c, token)
    end

    refute JOSE.crypto_fallback()
    refute JOSE.unsecured_signing()
    assert JOSE.json_module() == :jose_json_jason
  end

  test "unsupported purpose, missing header and every extension are signed rejections", c do
    for typ <- ["JWT", "id+jwt", "application/jwt", "workload+jwt", "AT+JWT", nil, 1] do
      reject(c, sign_raw(c, json(%{c.header | "typ" => typ}), json(c.claims)))
    end

    for field <- ["alg", "typ", "kid"] do
      reject(c, sign_raw(c, json(Map.delete(c.header, field)), json(c.claims)))
    end

    for {field, value} <- [
          {"crit", ["unknown"]},
          {"b64", false},
          {"jku", "https://attacker.invalid/keys"},
          {"x5u", "https://attacker.invalid/cert"},
          {"jwk", c.public},
          {"x5c", ["cert"]},
          {"zip", "DEF"},
          {"cty", "JWT"},
          {"unknown", true}
        ] do
      reject(c, sign_raw(c, json(Map.put(c.header, field, value)), json(c.claims)))
    end

    for kid <- ["", :binary.copy("x", 129), nil, 1, ["test-rsa"]] do
      reject(c, sign_raw(c, json(%{c.header | "kid" => kid}), json(c.claims)))
    end
  end

  test "compact binary and decoded JSON bounds reject ambiguous formats", c do
    token = sign(c)
    [header, payload, signature] = :binary.split(token, ".", [:global])

    for bad <- [
          nil,
          123,
          [],
          %{},
          "",
          "a",
          "a.b",
          "a.b.c.d",
          token <> ".",
          " " <> token,
          token <> "\n",
          "Bearer " <> token,
          header <> ".." <> signature,
          header <> "=." <> payload <> "." <> signature,
          "☃.e30.e30",
          :binary.copy("x", 4_090),
          <<255>>,
          json(%{"protected" => header, "payload" => payload})
        ] do
      reject(c, bad)
    end

    for raw <- ["[]", "null", "1", "\"string\"", "{", <<123, 255, 125>>] do
      reject(c, sign_raw(c, json(c.header), raw))
      reject(c, sign_raw(c, raw, json(c.claims)))
    end

    reject(c, sign_raw(c, :binary.copy(" ", 2_049), json(c.claims)))
    reject(c, sign(c, Map.put(c.claims, "extra", :binary.copy("x", 3_073))))
  end

  test "duplicate and escaped-equivalent JSON names fail at every nested position", c do
    raw = json(c.claims)

    for extra <- [
          ~S("sub":"different"),
          ~S("s\u0075b":"different"),
          ~S("extra":{"x":1,"x":2}),
          ~S("extra":[{"x":1,"\u0078":2}]),
          ~S("extra":{"deep":[{"leaf":{"a":1,"a":2}}]})
        ] do
      duplicate = binary_part(raw, 0, byte_size(raw) - 1) <> "," <> extra <> "}"
      token = sign(c, duplicate)
      assert {true, ^duplicate, _} = JOSE.JWS.verify_strict(c.private, ["RS256"], token)
      reject(c, token)
    end

    for raw_header <- [
          ~S({"alg":"RS256","alg":"RS256","kid":"test-rsa","typ":"at+jwt"}),
          ~S({"alg":"RS256","\u0061lg":"RS256","kid":"test-rsa","typ":"at+jwt"})
        ] do
      reject(c, sign_raw(c, raw_header, raw))
    end

    # Escapes without ambiguity are legitimate, and original bytes are signed.
    escaped = String.replace(raw, "subject-1", ~S(subject-\u0031))

    assert {:ok, %{subject: "subject-1"}} =
             AccessTokenVerifier.verify(sign(c, escaped), @now, c.snapshot)
  end

  test "structure bounds apply also to unknown signed claims", c do
    for extra <- [
          Enum.to_list(1..65),
          Map.new(1..65, &{"field-#{&1}", 1}),
          Enum.reduce(1..17, "leaf", fn _, value -> %{"nested" => value} end)
        ] do
      reject(c, sign(c, Map.put(c.claims, "extra", extra)))
    end
  end

  test "required claims and exact issuer/client bindings are enforced", c do
    for field <- ~w(iss sub aud client_id iat exp jti) do
      reject(c, sign(c, Map.delete(c.claims, field)))
      reject(c, sign(c, Map.put(c.claims, field, nil)))
    end

    for {field, value} <- [
          {"iss", "https://other.invalid"},
          {"iss", @profile.issuer <> "/"},
          {"client_id", "another-client"},
          {"sub", 1},
          {"sub", ""},
          {"sub", :binary.copy("s", 257)},
          {"jti", false},
          {"jti", ""},
          {"jti", :binary.copy("j", 257)}
        ] do
      reject(c, sign(c, Map.put(c.claims, field, value)))
    end
  end

  test "audience accepts exact strings and unique bounded arrays", c do
    for audience <- [
          @profile.audience,
          ["other-api", @profile.audience],
          Enum.map(1..7, &"api-#{&1}") ++ [@profile.audience]
        ] do
      assert {:ok, _} =
               AccessTokenVerifier.verify(
                 sign(c, %{c.claims | "aud" => audience}),
                 @now,
                 c.snapshot
               )
    end

    for audience <- [
          "another-api",
          [],
          [@profile.audience, @profile.audience],
          [@profile.audience, nil],
          [@profile.audience, ""],
          [@profile.audience, :binary.copy("a", 257)],
          [@profile.audience | Enum.map(1..8, &"api-#{&1}")],
          %{"aud" => @profile.audience},
          1
        ] do
      reject(c, sign(c, %{c.claims | "aud" => audience}))
    end
  end

  test "scope is bounded OAuth syntax and only exact supported names survive", c do
    claims =
      Map.merge(c.claims, %{
        "scope" => "owner project:* mixer.artifact.read",
        "kind" => "service",
        "organization" => "victim",
        "project" => "victim",
        "roles" => ["owner"],
        "groups" => ["admins"]
      })

    assert {:ok, identity} = AccessTokenVerifier.verify(sign(c, claims), @now, c.snapshot)
    assert identity.scopes == ["mixer.artifact.read"]
    assert identity.identity_class == :human

    refute Enum.any?(
             [:organization, :project, :roles, :groups, :token, :claims, :permissions],
             &Map.has_key?(identity, &1)
           )

    for claims <- [Map.delete(c.claims, "scope"), %{c.claims | "scope" => "owner"}] do
      assert {:ok, %{scopes: []}} = AccessTokenVerifier.verify(sign(c, claims), @now, c.snapshot)
    end

    for scope <- [
          nil,
          [],
          "",
          " ",
          " owner",
          "owner ",
          "owner  other",
          "owner\tother",
          "owner\nother",
          "owner\\other",
          "owner\"other",
          "snow☃",
          "owner owner",
          :binary.copy("a", 1_025),
          Enum.map_join(1..33, " ", &"s#{&1}")
        ] do
      reject(c, sign(c, %{c.claims | "scope" => scope}))
    end

    assert {:ok, %{scopes: []}} =
             AccessTokenVerifier.verify(
               sign(c, %{c.claims | "scope" => :binary.copy("a", 1_024)}),
               @now,
               c.snapshot
             )

    assert {:ok, _} =
             AccessTokenVerifier.verify(
               sign(c, %{c.claims | "scope" => Enum.map_join(1..32, " ", &"s#{&1}")}),
               @now,
               c.snapshot
             )
  end

  test "signed workspace scope survives exactly without granting artifact or claimed roles", c do
    for scope <- ["mixer.workspace.read", "owner mixer.workspace.read project:*"] do
      claims =
        Map.merge(c.claims, %{"scope" => scope, "roles" => ["owner"], "organization" => "other"})

      assert {:ok, %VerifiedIdentity{scopes: ["mixer.workspace.read"]} = identity} =
               AccessTokenVerifier.verify(sign(c, claims), @now, c.snapshot)

      refute Map.has_key?(identity, :roles)
      refute Map.has_key?(identity, :organization)
    end

    for scope <- [
          "mixer.workspace",
          "mixer.workspace.read.extra",
          "mixer.workspace.*",
          "MIXER.workspace.read"
        ] do
      assert {:ok, %VerifiedIdentity{scopes: []}} =
               AccessTokenVerifier.verify(
                 sign(c, %{c.claims | "scope" => scope}),
                 @now,
                 c.snapshot
               )
    end

    all = "mixer.workspace.read " <> c.claims["scope"]

    assert {:ok, %VerifiedIdentity{scopes: scopes}} =
             AccessTokenVerifier.verify(sign(c, %{c.claims | "scope" => all}), @now, c.snapshot)

    assert scopes == [
             "mixer.artifact.read",
             "mixer.artifact.upload",
             "mixer.audit.read",
             "mixer.workspace.read"
           ]

    reject(c, sign(c, %{c.claims | "scope" => "mixer.workspace.read mixer.workspace.read"}))
  end

  test "expiry is exclusive, future skew is at most 30 and times are bounded integers", c do
    for patch <- [
          %{"iat" => @now - 1, "exp" => @now},
          %{"exp" => @now - 1},
          %{"iat" => @now + 31},
          %{"nbf" => @now + 31},
          %{"nbf" => c.claims["exp"]},
          %{"iat" => -1},
          %{"exp" => -1},
          %{"nbf" => -1},
          %{"iat" => 1.8e9},
          %{"exp" => "1800000300"},
          %{"nbf" => nil},
          %{"iat" => 9_007_199_254_740_992},
          %{"exp" => 9_007_199_254_740_992},
          %{"nbf" => 9_007_199_254_740_992},
          %{"iat" => @now + 1, "exp" => @now + 1}
        ] do
      reject(c, sign(c, Map.merge(c.claims, patch)))
    end

    for patch <- [%{"exp" => @now + 1}, %{"iat" => @now + 30}, %{"nbf" => @now + 30}] do
      assert {:ok, _} =
               AccessTokenVerifier.verify(sign(c, Map.merge(c.claims, patch)), @now, c.snapshot)
    end
  end

  test "configured human and service lifetimes have exact separate ceilings", c do
    for {kind, lifetime} <- [human: 900, service: 300] do
      trust = snapshot([c.public], %{@profile | identity_class: kind})
      valid = %{c.claims | "iat" => @now, "exp" => @now + lifetime}

      assert {:ok, %{identity_class: ^kind}} =
               AccessTokenVerifier.verify(sign(c, valid), @now, trust)

      assert {:error, :unauthenticated} =
               AccessTokenVerifier.verify(
                 sign(c, %{valid | "exp" => @now + lifetime + 1}),
                 @now,
                 trust
               )
    end
  end

  test "missing, stale or future-fetched trust is unavailable; authoritative disable denies", c do
    token = sign(c)

    for trust <- [
          nil,
          :unavailable,
          %{},
          snapshot([c.public], @profile, @now - 300, @now),
          snapshot([c.public], @profile, @now + 1, @now + 2)
        ] do
      assert AccessTokenVerifier.verify(token, @now, trust) == {:error, :identity_unavailable}
    end

    for bad_now <- [-1, nil, 1.8e9, 9_007_199_254_740_992] do
      assert AccessTokenVerifier.verify(token, bad_now, c.snapshot) ==
               {:error, :identity_unavailable}
    end

    disabled = snapshot([c.public], %{@profile | enabled: false})
    assert AccessTokenVerifier.verify(token, @now, disabled) == {:error, :unauthenticated}

    assert AccessTokenVerifier.verify(token, @now + 10_000, disabled) ==
             {:error, :unauthenticated}

    assert {:ok, _} = AccessTokenVerifier.verify(token, @now - 1, c.snapshot)
  end

  test "whole-snapshot validation rejects ambiguous private weak or unsupported keys", c do
    for key <- [
          Map.put(c.public, "unknown", "value"),
          Map.put(c.public, "key_ops", nil),
          Map.put(c.public, "key_ops", ["sign"]),
          Map.put(c.public, "key_ops", ["verify", "verify"]),
          Map.put(c.public, "alg", "HS256"),
          Map.put(c.public, "use", "enc"),
          Map.put(c.public, "kty", "oct"),
          Map.put(c.public, "kid", ""),
          Map.put(c.public, "kid", :binary.copy("k", 129)),
          public(c.weak_private),
          Map.put(c.public, "e", Base.url_encode64(<<3>>, padding: false)),
          Map.put(c.public, "n", c.public["n"] <> "="),
          Map.put(
            c.public,
            "n",
            Base.url_encode64(<<0>> <> Base.url_decode64!(c.public["n"], padding: false),
              padding: false
            )
          ),
          Map.put(c.public, "n", Base.url_encode64(:binary.copy(<<255>>, 513), padding: false)),
          nil,
          [],
          "key"
        ] do
      invalid_snapshot([key])
      invalid_snapshot([c.public, key])
    end

    for field <- ~w(d p q dp dq qi oth k x y crv x5c x5u jku jwk pem) do
      invalid_snapshot([Map.put(c.public, field, "private-or-alternate-material")])
    end

    {_, private_map} = JOSE.JWK.to_map(c.private)
    invalid_snapshot([Map.merge(c.public, private_map)])
    for field <- ~w(kty alg use kid n e), do: invalid_snapshot([Map.delete(c.public, field)])
    invalid_snapshot([])
    invalid_snapshot([c.public, c.public])
    invalid_snapshot(Enum.map(1..17, &Map.put(c.public, "kid", "key-#{&1}")))

    assert {:ok, _} =
             TrustSnapshot.new(
               @profile,
               json(%{"keys" => [Map.delete(c.public, "key_ops")]}),
               @now,
               @now + 300
             )

    assert {:ok, _} =
             TrustSnapshot.new(
               @profile,
               json(%{"keys" => Enum.map(1..16, &Map.put(c.public, "kid", "key-#{&1}"))}),
               @now,
               @now + 300
             )
  end

  test "raw JWKS bounds, duplicates including escaped names and invalid profiles reject atomically",
       c do
    jwks = json(%{"keys" => [c.public]})

    for raw <- [
          "[]",
          "null",
          "{",
          nil,
          [],
          :binary.copy(" ", 262_145),
          ~S({"keys":[],"\u006beys":[]}),
          String.replace(jwks, "\"kty\":\"RSA\"", ~S("kty":"RSA","\u006bty":"RSA")),
          json(%{"keys" => [c.public], "other" => true})
        ] do
      assert TrustSnapshot.new(@profile, raw, @now, @now + 300) ==
               {:error, :invalid_trust_configuration}
    end

    for patch <- [
          %{profile_id: ""},
          %{profile_id: :binary.copy("p", 129)},
          %{profile_version: 0},
          %{profile_version: 2_147_483_648},
          %{profile_version: 1.0},
          %{issuer: "http://issuer.invalid"},
          %{issuer: "https://user:pass@issuer.invalid"},
          %{issuer: "https://issuer.invalid?x=1"},
          %{issuer: "https://issuer.invalid#fragment"},
          %{audience: ""},
          %{client_id: ""},
          %{audience: :binary.copy("a", 257)},
          %{client_id: :binary.copy("c", 257)},
          %{identity_class: :admin},
          %{enabled: nil},
          %{unknown: true}
        ] do
      invalid_snapshot([c.public], Map.merge(@profile, patch))
    end

    for field <- Map.keys(@profile), do: invalid_snapshot([c.public], Map.delete(@profile, field))

    for {fetched, fresh} <- [
          {@now, @now},
          {@now, @now + 301},
          {-1, @now},
          {@now, -1},
          {@now, 1.8e9},
          {nil, @now},
          {@now, 9_007_199_254_740_992}
        ] do
      assert TrustSnapshot.new(@profile, jwks, fetched, fresh) ==
               {:error, :invalid_trust_configuration}
    end
  end

  test "snapshot replacement is explicit and successful removal immediately excludes old key",
       c do
    new_public = public(c.wrong_private, "rotated-rsa")
    overlap = snapshot([c.public, new_public])

    rotated_token =
      sign(%{c | private: c.wrong_private}, nil, %{c.header | "kid" => "rotated-rsa"})

    old_token = sign(c)
    assert {:ok, _} = AccessTokenVerifier.verify(old_token, @now, overlap)
    assert {:ok, _} = AccessTokenVerifier.verify(rotated_token, @now, overlap)
    replacement = snapshot([new_public], %{@profile | profile_version: 2})
    assert {:error, :unauthenticated} = AccessTokenVerifier.verify(old_token, @now, replacement)

    assert {:ok, %{profile_version: 2}} =
             AccessTokenVerifier.verify(rotated_token, @now, replacement)

    invalid_snapshot([new_public, new_public])
    # Rejected construction creates no replacement, and cannot extend the old
    # caller-held snapshot beyond its original bound.
    assert {:ok, _} = AccessTokenVerifier.verify(old_token, @now, overlap)

    assert {:error, :identity_unavailable} =
             AccessTokenVerifier.verify(old_token, @now + 299, overlap)

    reject(c, sign(c, nil, %{c.header | "kid" => "unknown-rsa"}))
  end
end

cc431452af97ec4429efe454e194a051ac829346 blob 24827
defmodule MixerHosted.Identity.KeyOwnerInflightLifecycleTest do
  use ExUnit.Case, async: false

  alias MixerHosted.Identity.{
    Admission,
    ConfiguredVerifier,
    KeyOwner,
    KeyOwnerSupervisor,
    TLSFixture
  }

  defmodule Recorder do
    use GenServer

    def start_link(case_id, name), do: GenServer.start_link(__MODULE__, {case_id, name})
    def put(pid, key, value), do: GenServer.call(pid, {:put, key, value})
    def get(pid), do: GenServer.call(pid, :get)
    def track(pid, role, resource), do: GenServer.call(pid, {:track, role, resource})

    def init({case_id, name}) do
      {:ok,
       %{
         case_id: case_id,
         name: name,
         stage: "created",
         resources: %{},
         values: %{},
         observations: %{},
         raw_reply: %{
           kind: "unobserved",
           result: "unobserved",
           before_deadline: false,
           observed_at_ms: -1,
           pointer: "unobserved",
           owner_alive: false,
           table_alive: false
         },
         public_reply: "unobserved",
         fault_reason: "unobserved",
         deadline_margin_ms: -1,
         pointer_samples: [],
         cleanup_errors: [],
         cleanup: %{}
       }}
    end

    def handle_call({:put, key, value}, _, state), do: {:reply, :ok, Map.put(state, key, value)}
    def handle_call(:get, _, state), do: {:reply, state, state}

    def handle_call({:track, role, resource}, _, state)
        when is_pid(resource) or is_port(resource) do
      resources =
        Map.put_new_lazy(state.resources, resource, fn ->
          monitor =
            if is_pid(resource),
              do: Process.monitor(resource),
              else: :erlang.monitor(:port, resource)

          %{role: role, monitor: monitor, down: false, reason: "unobserved", down_ms: -1}
        end)

      {:reply, :ok, %{state | resources: resources}}
    end

    def handle_info({:DOWN, monitor, _, resource, reason}, state) do
      resources =
        case state.resources[resource] do
          %{monitor: ^monitor} = value ->
            Map.put(state.resources, resource, %{
              value
              | down: true,
                reason: inspect(reason, limit: 30),
                down_ms: System.monotonic_time(:millisecond)
            })

          _ ->
            state.resources
        end

      {:noreply, %{state | resources: resources}}
    end
  end

  @owners [__MODULE__.GracefulOwner, __MODULE__.WorkerDeathOwner]
  @entry %{
    profile: %{
      profile_id: "inflight",
      profile_version: 1,
      issuer: "https://issuer.fixture.invalid/oauth",
      audience: "mixer-api",
      client_id: "inflight-test",
      identity_class: :human,
      enabled: true
    },
    jwks_endpoint: %{host: "jwks.fixture.invalid", port: 443, path: "/keys"},
    transport: :hosted_https
  }
  @facts [
    :tls_preconditions,
    :raw_explicit_reply,
    :fresh_denial,
    :raw_port_closed_while_held,
    :parent_stop_pending,
    :old_resources_down_at_stop,
    :owner_alive_at_raw_reply,
    :table_alive_at_raw_reply,
    :pointer_absent_at_raw_reply,
    :replacement_observed,
    :replacement_empty,
    :old_resources_down_before_replacement,
    :old_permit_rejected,
    :stale_lease_rejected,
    :public_denial,
    :callback_clean
  ]

  def owner_names, do: @owners
  defp now, do: System.system_time(:second)
  defp mono, do: System.monotonic_time(:millisecond)
  defp pointer(name), do: :persistent_term.get({Admission, name}, :absent)
  defp workers(name), do: Module.concat(name, FetchSupervisor)
  defp alive?(pid) when is_pid(pid), do: Process.alive?(pid)
  defp alive?(port) when is_port(port), do: Port.info(port) != nil
  defp alive?(_), do: false

  defp wait_until(fun, remaining \\ 100)
  defp wait_until(fun, 0), do: assert(fun.())

  defp wait_until(fun, remaining) do
    if fun.() do
      :ok
    else
      Process.sleep(5)
      wait_until(fun, remaining - 1)
    end
  end

  defp value(recorder, key, value) do
    state = Recorder.get(recorder)
    Recorder.put(recorder, :values, Map.put(state.values, key, value))
    value
  end

  defp fact(recorder, key, value) do
    state = Recorder.get(recorder)
    Recorder.put(recorder, :observations, Map.put(state.observations, key, value))
    value
  end

  defp track(recorder, role, resource) do
    if is_pid(resource) or is_port(resource), do: Recorder.track(recorder, role, resource)
    resource
  end

  # Test instrumentation follows the pinned OTP 29 sslsocket record. Product code
  # never reads it. Capture per-socket handlers/senders and the handle's raw port.
  defp socket_resources(recorder, role, socket) do
    assert is_tuple(socket) and tuple_size(socket) == 8 and elem(socket, 0) == :sslsocket
    for pid <- [elem(socket, 2), elem(socket, 3)], is_pid(pid), do: track(recorder, role, pid)
    ports(recorder, role, elem(socket, 1))
    socket
  end

  defp ports(recorder, role, port) when is_port(port), do: track(recorder, role, port)

  defp ports(recorder, role, tuple) when is_tuple(tuple),
    do: ports(recorder, role, Tuple.to_list(tuple))

  defp ports(recorder, role, list) when is_list(list),
    do: Enum.each(list, &ports(recorder, role, &1))

  defp ports(_, _, _), do: :ok

  defp sample_pointer(recorder, phase) do
    state = Recorder.get(recorder)
    current = pointer(state.name)
    old = state.values[:old]

    kind =
      cond do
        current == :absent ->
          "absent"

        old != nil and current == old.table ->
          "old"

        is_reference(current) and :ets.info(current, :owner) == Process.whereis(state.name) ->
          "current"

        true ->
          "other"
      end

    sample = %{phase: phase, at_ms: mono(), kind: kind, table: inspect(current)}
    Recorder.put(recorder, :pointer_samples, state.pointer_samples ++ [sample])
    current
  end

  defp start_case(case_id, name) do
    {:ok, recorder} = Recorder.start_link(case_id, name)
    Process.unlink(recorder)

    on_exit(fn ->
      try do
        cleanup(recorder)
      rescue
        exception ->
          cleanup_error(recorder, "cleanup collector raised: #{Exception.message(exception)}")
      catch
        kind, reason -> cleanup_error(recorder, "cleanup collector #{kind}: #{inspect(reason)}")
      end

      state = Recorder.get(recorder)
      :ok = GenServer.stop(recorder, :normal, 500)
      report = report(state, not Process.alive?(recorder))
      write_evidence(case_id <> "-observation.json", report)
      assert report.cleanup_errors == []

      assert Enum.all?(
               Map.drop(report.cleanup, [
                 :resume_result,
                 :component_stop_result,
                 :fixture_stop_result
               ]),
               fn {_, value} -> value == true end
             )

      assert report.cleanup.component_stop_result in [":ok", ":already_stopped"]
      assert report.cleanup.fixture_stop_result in [":ok", ":already_stopped"]
    end)

    assert Process.whereis(name) == nil and Process.whereis(workers(name)) == nil
    assert pointer(name) == :absent
    {:ok, fixture} = TLSFixture.start_link()
    Process.unlink(fixture)
    value(recorder, :fixture, track(recorder, :fixture, fixture))
    fixture_state = :sys.get_state(fixture)

    value(
      recorder,
      :listener,
      socket_resources(recorder, :listener_socket, fixture_state.listener)
    )

    value(recorder, :acceptor, track(recorder, :acceptor, fixture_state.acceptor))
    authority = GenServer.call(fixture, :authority)
    :ok = TLSFixture.configure(fixture, {:barrier, self(), TLSFixture.response("{\"keys\":[]}")})

    options = [
      name: name,
      manifest: [@entry],
      generation: 1,
      binding: "inflight",
      ca_roots: [authority.ca],
      resolvers: [{{127, 0, 0, 1}, 9}],
      fixture: Map.take(authority, [:ip, :port])
    ]

    {:ok, component} = KeyOwnerSupervisor.start_fixture(options)
    Process.unlink(component)
    value(recorder, :component, track(recorder, :component, component))
    owner = value(recorder, :owner, track(recorder, :owner, Process.whereis(name)))
    old = value(recorder, :old, :sys.get_state(owner))
    value(recorder, :workers, track(recorder, :workers, Process.whereis(old.workers)))
    {:ok, probe_permit} = Admission.acquire(name, :configured)
    value(recorder, :permit, probe_permit)
    value(recorder, :options, options)
    parent = self()

    {raw, _monitor} =
      spawn_monitor(fn ->
        {:ok, permit} = Admission.acquire(name, :configured)
        send(parent, {:raw_permit, self(), permit})

        result =
          try do
            reply = GenServer.call(owner, {:checkout, permit, now()}, 2_200)
            %{kind: "reply", result: inspect(reply), before_deadline: false}
          catch
            :exit, reason ->
              %{kind: "exit", result: inspect(reason, limit: 30), before_deadline: false}
          end

        send(
          parent,
          {:raw_checkout, self(), result, mono(), pointer(name), Process.alive?(owner),
           :ets.info(old.table) != :undefined}
        )

        Admission.release(permit)
      end)

    value(recorder, :raw_caller, track(recorder, :raw_caller, raw))
    assert_receive {:raw_permit, ^raw, permit}, 500
    value(recorder, :raw_permit, permit)

    {public, _monitor} =
      spawn_monitor(fn ->
        result = ConfiguredVerifier.authenticate(name, :configured, "synthetic", now())
        send(parent, {:public_checkout, self(), result})
      end)

    value(recorder, :public_caller, track(recorder, :public_caller, public))
    assert_receive {:tls_response_ready, handler}, 700
    value(recorder, :server_handler, track(recorder, :server_handler, handler))
    server = :sys.get_state(fixture)
    assert map_size(server.sockets) == 1
    server_socket = Map.fetch!(server.sockets, handler)
    value(recorder, :server_socket, socket_resources(recorder, :server_socket, server_socket))
    assert [%{request: request, tls: tls}] = server.requests
    assert String.starts_with?(request, "GET /keys HTTP/1.1\r\n")
    assert tls[:sni_hostname] in [~c"jwks.fixture.invalid", "jwks.fixture.invalid"]
    assert tls[:protocol] in [:"tlsv1.2", :"tlsv1.3"]
    value(recorder, :tls_protocol, Atom.to_string(tls[:protocol]))

    wait_until(fn -> map_size(:sys.get_state(owner).waiters) == 2 end)
    state = :sys.get_state(owner)
    assert [{flight, _}] = Map.to_list(state.flights)
    value(recorder, :flight, track(recorder, :flight, flight))
    f = value(recorder, :flight_state, :sys.get_state(flight))
    assert is_pid(f.connection) and is_port(f.raw_socket) and f.socket != nil
    assert Enum.all?([f.connection, f.raw_socket, f.worker], &alive?/1)
    value(recorder, :worker, track(recorder, :worker, f.worker))
    value(recorder, :controller, track(recorder, :controller, f.connection))
    value(recorder, :raw_socket, track(recorder, :raw_socket, f.raw_socket))
    socket_resources(recorder, :client_socket, f.socket)
    value(recorder, :deadline, elem(hd(Map.to_list(state.flights)), 1).deadline)
    assert state.snapshots == %{} and map_size(state.waiters) == 2
    fact(recorder, :tls_preconditions, true)
    Recorder.put(recorder, :stage, "completed-tls-pending-jwks")
    recorder
  end

  defp hold_controller(recorder) do
    state = Recorder.get(recorder)
    :ok = :sys.suspend(state.values.controller, 300)
    value(recorder, :suspended, true)
    margin = state.values.deadline - mono()
    Recorder.put(recorder, :deadline_margin_ms, margin)
    assert margin >= 750
    sample_pointer(recorder, "before-trigger")
    Recorder.put(recorder, :stage, "controller-held-trigger-ready")
    state.values
  end

  defp raw_reply(recorder) do
    state = Recorder.get(recorder)
    raw = state.values.raw_caller
    assert_receive {:raw_checkout, ^raw, result, at, ptr, owner_alive, table_alive}, 600

    result =
      Map.merge(result, %{
        before_deadline: at < state.values.deadline,
        observed_at_ms: at,
        pointer: inspect(ptr),
        owner_alive: owner_alive,
        table_alive: table_alive
      })

    Recorder.put(recorder, :raw_reply, result)

    fact(
      recorder,
      :raw_explicit_reply,
      result.kind == "reply" and result.result == "{:error, :identity_unavailable}" and
        result.before_deadline
    )

    fact(recorder, :pointer_absent_at_raw_reply, ptr == :absent)
    fact(recorder, :owner_alive_at_raw_reply, owner_alive)
    fact(recorder, :table_alive_at_raw_reply, table_alive)
    sample_pointer(recorder, "raw-reply-observed")
  end

  defp release(recorder) do
    state = Recorder.get(recorder)
    controller = state.values[:controller]

    result =
      if alive?(controller) and state.values[:suspended] do
        try do
          :sys.resume(controller, 300)
        catch
          :exit, reason -> {:error, reason}
        end
      else
        :already_stopped
      end

    value(recorder, :resume_result, inspect(result))

    value(
      recorder,
      :resume_results,
      (Recorder.get(recorder).values[:resume_results] || []) ++ [inspect(result)]
    )

    if result not in [:ok, :already_stopped],
      do: cleanup_error(recorder, "controller resume failed: #{inspect(result)}")

    value(recorder, :suspended, false)

    if alive?(state.values[:server_handler]),
      do: send(state.values.server_handler, :release_response)

    value(recorder, :barrier_released, true)
  end

  defp public_reply(recorder) do
    state = Recorder.get(recorder)
    public = state.values.public_caller
    assert_receive {:public_checkout, ^public, result}, 2_500
    Recorder.put(recorder, :public_reply, inspect(result))
    fact(recorder, :public_denial, result == {:error, :identity_unavailable})
  end

  defp stop(pid) do
    if alive?(pid), do: GenServer.stop(pid, :normal, 1_000), else: :already_stopped
  catch
    :exit, reason -> {:error, reason}
  end

  defp cleanup(recorder) do
    release(recorder)
    state = Recorder.get(recorder)

    for role <- [:owner, :workers] do
      registered = Process.whereis(if role == :owner, do: state.name, else: workers(state.name))
      if is_pid(registered), do: track(recorder, role, registered)
    end

    component_result = stop(state.values[:component])

    if component_result not in [:ok, :already_stopped],
      do: cleanup_error(recorder, "component stop failed: #{inspect(component_result)}")

    fixture = state.values[:fixture]

    peer_closed =
      not alive?(fixture) or wait_observed(fn -> TLSFixture.info(fixture).closed == 1 end)

    if not peer_closed,
      do: cleanup_error(recorder, "server peer closure not observed before fixture stop")

    fixture_info =
      if alive?(state.values[:fixture]), do: TLSFixture.info(state.values.fixture), else: nil

    if fixture_info != nil, do: value(recorder, :fixture_info, fixture_info)
    fixture_result = stop(state.values[:fixture])

    if fixture_result not in [:ok, :already_stopped],
      do: cleanup_error(recorder, "fixture stop failed: #{inspect(fixture_result)}")

    state = Recorder.get(recorder)

    for key <- [:raw_caller, :public_caller, :stop_caller] do
      pid = state.values[key]
      if alive?(pid), do: Process.exit(pid, :kill)
    end

    # Only these exact recorded resources are observed; no VM/process inventory.
    all_gone =
      wait_observed(fn ->
        Enum.all?(Recorder.get(recorder).resources, fn {resource, _} -> not alive?(resource) end)
      end)

    all_down =
      wait_observed(fn ->
        Enum.all?(Recorder.get(recorder).resources, fn {_, resource} -> resource.down end)
      end)

    if not all_gone or not all_down,
      do: cleanup_error(recorder, "recorded owned resource remains or DOWN missing")

    state = Recorder.get(recorder)
    info = state.values[:fixture_info]

    Recorder.put(recorder, :cleanup, %{
      resume_result: state.values[:resume_result] || "unobserved",
      component_stop_result: inspect(component_result),
      fixture_stop_result: inspect(fixture_result),
      barrier_released: state.values[:barrier_released] == true,
      all_resources_down: Enum.all?(state.resources, fn {_, resource} -> resource.down end),
      current_admission_absent: pointer(state.name) == :absent,
      owner_absent: Process.whereis(state.name) == nil,
      workers_absent: Process.whereis(workers(state.name)) == nil,
      old_table_gone:
        state.values[:old] == nil or :ets.info(state.values.old.table) == :undefined,
      key_directory_removed: info != nil and info.key_dir_removed,
      fixture_peer_closed: info != nil and info.accepted == 1 and info.closed == 1
    })
  end

  defp wait_observed(fun, remaining \\ 100)
  defp wait_observed(fun, 0), do: fun.()

  defp wait_observed(fun, remaining) do
    if fun.() do
      true
    else
      Process.sleep(5)
      wait_observed(fun, remaining - 1)
    end
  catch
    :exit, _ -> false
  end

  defp cleanup_error(recorder, message) do
    state = Recorder.get(recorder)
    Recorder.put(recorder, :cleanup_errors, state.cleanup_errors ++ [message])
  end

  defp report(state, recorder_stopped) do
    cleanup_defaults = %{
      resume_result: "unobserved",
      component_stop_result: "unobserved",
      fixture_stop_result: "unobserved",
      barrier_released: false,
      all_resources_down: false,
      current_admission_absent: false,
      owner_absent: false,
      workers_absent: false,
      old_table_gone: false,
      key_directory_removed: false,
      fixture_peer_closed: false
    }

    %{
      schema: 1,
      case_id: state.case_id,
      stage: state.stage,
      deadline_margin_ms: state.deadline_margin_ms,
      tls_protocol: state.values[:tls_protocol] || "unobserved",
      raw_reply: state.raw_reply,
      resume_results: state.values[:resume_results] || [],
      public_reply: state.public_reply,
      fault_reason: state.fault_reason,
      cleanup_errors: state.cleanup_errors,
      observations: Map.new(@facts, &{&1, Map.get(state.observations, &1, false)}),
      pointer_samples: state.pointer_samples,
      resources:
        Enum.map(state.resources, fn {resource, entry} ->
          %{
            role: Atom.to_string(entry.role),
            id: inspect(resource),
            down: entry.down,
            reason: entry.reason,
            down_ms: entry.down_ms
          }
        end),
      cleanup:
        Map.put(Map.merge(cleanup_defaults, state.cleanup), :recorder_stopped, recorder_stopped)
    }
  end

  defp write_evidence(name, value) do
    case System.get_env("MIXER_KEY_OWNER_LIFECYCLE_EVIDENCE") do
      nil -> :ok
      directory -> File.write!(Path.join(directory, name), Jason.encode!(value, pretty: true))
    end
  end

  test "KOL08-GRACEFUL ordinary parent shutdown drains a pending real TLS response" do
    recorder = start_case("KOL08-GRACEFUL", __MODULE__.GracefulOwner)

    try do
      values = hold_controller(recorder)
      parent = self()

      {stopper, _monitor} =
        spawn_monitor(fn ->
          result = Supervisor.stop(values.component, :normal, :infinity)
          send(parent, {:component_stopped, self(), result})
        end)

      value(recorder, :stop_caller, track(recorder, :stop_caller, stopper))
      raw_reply(recorder)
      wait_until(fn -> Port.info(values.raw_socket) == nil end)
      fact(recorder, :raw_port_closed_while_held, true)

      fact(
        recorder,
        :fresh_denial,
        Admission.acquire(__MODULE__.GracefulOwner, :configured) ==
          {:error, :identity_unavailable} and
          ConfiguredVerifier.authenticate(
            __MODULE__.GracefulOwner,
            :configured,
            "synthetic",
            now()
          ) == {:error, :identity_unavailable}
      )

      refute_receive {:component_stopped, ^stopper, _}, 50
      fact(recorder, :parent_stop_pending, alive?(stopper) and alive?(values.controller))
      Recorder.put(recorder, :stage, "graceful-drain-held")
      release(recorder)
      assert_receive {:component_stopped, ^stopper, :ok}, 1_000

      fact(
        recorder,
        :old_resources_down_at_stop,
        Enum.all?(
          [
            values.component,
            values.owner,
            values.workers,
            values.flight,
            values.worker,
            values.controller,
            values.raw_socket
          ],
          &(not alive?(&1))
        )
      )

      public_reply(recorder)

      for key <- [
            :raw_explicit_reply,
            :fresh_denial,
            :raw_port_closed_while_held,
            :parent_stop_pending,
            :old_resources_down_at_stop,
            :owner_alive_at_raw_reply,
            :table_alive_at_raw_reply,
            :pointer_absent_at_raw_reply,
            :public_denial
          ] do
        assert Recorder.get(recorder).observations[key], "missing graceful observation #{key}"
      end

      Recorder.put(recorder, :stage, "graceful-gate-passed")
    after
      cleanup(recorder)
    end
  end

  test "KOL09-KILL records the active-flight worker-supervisor death resource gate" do
    recorder = start_case("KOL09-KILL", __MODULE__.WorkerDeathOwner)

    try do
      values = hold_controller(recorder)
      owner_monitor = Process.monitor(values.owner)
      workers_monitor = Process.monitor(values.workers)
      Process.exit(values.workers, :kill)
      assert_receive {:DOWN, ^workers_monitor, :process, _, :killed}, 500
      raw_reply(recorder)
      assert_receive {:DOWN, ^owner_monitor, :process, _, reason}, 700
      Recorder.put(recorder, :fault_reason, inspect(reason, limit: 50))
      fact(recorder, :callback_clean, reason == :shutdown)

      wait_until(fn ->
        is_pid(Process.whereis(__MODULE__.WorkerDeathOwner)) and
          Process.whereis(__MODULE__.WorkerDeathOwner) != values.owner
      end)

      replacement = Process.whereis(__MODULE__.WorkerDeathOwner)
      current = :sys.get_state(replacement)
      track(recorder, :owner, replacement)
      track(recorder, :workers, Process.whereis(current.workers))

      fact(
        recorder,
        :replacement_observed,
        current.table != values.old.table and current.epoch != values.old.epoch
      )

      initially_empty =
        Enum.all?(
          [:snapshots, :attempts, :flights, :waiters, :admitted, :negatives],
          &(current[&1] == %{})
        ) and DynamicSupervisor.count_children(current.workers).active == 0

      fact(
        recorder,
        :old_resources_down_before_replacement,
        Enum.all?(
          [values.flight, values.worker, values.controller, values.raw_socket],
          &(not alive?(&1))
        )
      )

      assert sample_pointer(recorder, "replacement-while-old-controller-held") == current.table
      Recorder.put(recorder, :stage, "worker-death-order-witness-retained")
      release(recorder)
      public_reply(recorder)

      wait_until(fn ->
        Enum.all?(
          [values.flight, values.worker, values.controller, values.raw_socket],
          &(not alive?(&1))
        )
      end)

      after_drain = :sys.get_state(replacement)

      fact(
        recorder,
        :replacement_empty,
        initially_empty and
          Enum.all?(
            [:snapshots, :attempts, :flights, :waiters, :admitted, :negatives],
            &(after_drain[&1] == %{})
          )
      )

      fact(
        recorder,
        :old_permit_rejected,
        KeyOwner.checkout(__MODULE__.WorkerDeathOwner, values.permit, now()) ==
          {:error, :identity_unavailable}
      )

      lease = %KeyOwner.Lease{
        epoch: values.old.epoch,
        generation: values.old.generation,
        id: "inflight",
        snapshot_generation: make_ref(),
        snapshot: :synthetic_rejection_only,
        permit: values.permit
      }

      fact(
        recorder,
        :stale_lease_rejected,
        KeyOwner.finish(__MODULE__.WorkerDeathOwner, lease) == {:error, :identity_unavailable}
      )

      assert pointer(__MODULE__.WorkerDeathOwner) == current.table

      # Keep this adverse witness red until an independently reviewed correction
      # is justified by its actual callback reason and old-resource ordering.
      for key <- [
            :raw_explicit_reply,
            :replacement_observed,
            :replacement_empty,
            :old_resources_down_before_replacement,
            :callback_clean,
            :old_permit_rejected,
            :stale_lease_rejected,
            :public_denial
          ] do
        assert Recorder.get(recorder).observations[key],
               "failed active-flight resource gate #{key}"
      end

      Recorder.put(recorder, :stage, "worker-death-resource-gate-passed")
    after
      cleanup(recorder)
    end
  end
end

4da59b52ee537962f04183be4fb37ecf1e20c56c blob 14688
defmodule MixerHosted.Identity.KeyOwnerLifecycleTest do
  use ExUnit.Case, async: false

  alias MixerHosted.Identity.{Admission, ConfiguredVerifier, KeyOwner, KeyOwnerSupervisor}

  @owners [
    __MODULE__.KOL01Owner,
    __MODULE__.KOL02Owner,
    __MODULE__.KOL03Owner,
    __MODULE__.KOL05Owner,
    __MODULE__.KOL06Owner,
    __MODULE__.KOL07Owner
  ]
  @admission_name __MODULE__.KOL04Admission
  @binding "lifecycle-disabled"
  @entry %{
    profile: %{
      profile_id: @binding,
      profile_version: 1,
      issuer: "https://issuer.lifecycle.invalid/oauth",
      audience: "mixer-api",
      client_id: "lifecycle-test",
      identity_class: :human,
      enabled: false
    },
    jwks_endpoint: %{host: "jwks.lifecycle.invalid", port: 443, path: "/keys"},
    transport: :hosted_https
  }
  @empty [:snapshots, :attempts, :flights, :waiters, :admitted, :negatives]

  # The standalone runner inspects only these exact test-owned registrations.
  def owner_names, do: @owners
  def admission_names, do: [@admission_name | @owners]

  setup_all do
    root =
      case System.get_env("MIXER_KEY_OWNER_LIFECYCLE_ROOT_PEM") do
        nil ->
          :public_key.cacerts_get()
          |> Enum.map(fn
            {:cert, der, _} -> der
            der -> der
          end)
          |> hd()

        path ->
          [{:Certificate, der, :not_encrypted}] = :public_key.pem_decode(File.read!(path))
          der
      end

    assert is_binary(root)
    {:ok, root: root}
  end

  defp workers(name), do: Module.concat(name, FetchSupervisor)
  defp pointer(name), do: :persistent_term.get({Admission, name}, :absent)
  defp now, do: System.system_time(:second)

  defp options(name, root) do
    [
      name: name,
      manifest: [@entry],
      generation: 1,
      binding: @binding,
      ca_roots: [root],
      resolvers: [{{127, 0, 0, 1}, 9}]
    ]
  end

  defp evidence(name, observation) do
    case System.get_env("MIXER_KEY_OWNER_LIFECYCLE_EVIDENCE") do
      nil -> :ok
      directory -> File.write!(Path.join(directory, name <> ".json"), Jason.encode!(observation))
    end
  end

  defp resume_owned(pid) do
    if Process.alive?(pid), do: :sys.resume(pid, 500), else: :already_stopped
  catch
    :exit, reason -> {:error, inspect(reason)}
  end

  defp stop_owned(pid) do
    if Process.alive?(pid), do: Supervisor.stop(pid, :normal, 1_000), else: :already_stopped
  catch
    :exit, reason -> {:error, inspect(reason)}
  end

  defp reap_caller(pid, monitor) do
    if Process.alive?(pid) do
      Process.exit(pid, :kill)

      assert_receive {:DOWN, ^monitor, :process, ^pid, _reason}, 1_000
    end

    Process.demonitor(monitor, [:flush])
    refute Process.alive?(pid)
  end

  defp component(name, root) do
    assert Process.whereis(name) == nil
    assert Process.whereis(workers(name)) == nil
    assert pointer(name) == :absent
    {:ok, pid} = KeyOwnerSupervisor.start_link(options(name, root))
    Process.unlink(pid)

    # Register exact-PID recovery before any test assertion or suspension.
    on_exit(fn ->
      resumed = resume_owned(pid)

      owned_children =
        Enum.filter([Process.whereis(name), Process.whereis(workers(name))], &is_pid/1)

      stopped = stop_owned(pid)

      observation = %{
        component_stopped: not Process.alive?(pid),
        observed_exact_children_stopped: Enum.all?(owned_children, &(not Process.alive?(&1))),
        owner_absent: Process.whereis(name) == nil,
        workers_absent: Process.whereis(workers(name)) == nil,
        admission_absent: pointer(name) == :absent,
        resume_result: inspect(resumed),
        stop_result: inspect(stopped)
      }

      evidence(Atom.to_string(name) <> "-cleanup", observation)
      assert observation.component_stopped
      assert observation.observed_exact_children_stopped
      assert observation.owner_absent
      assert observation.workers_absent
      assert observation.admission_absent
      assert stopped in [:ok, :already_stopped]
    end)

    {pid, Process.whereis(name), :sys.get_state(name)}
  end

  defp wait_until(fun, remaining \\ 100)
  defp wait_until(fun, 0), do: assert(fun.())

  defp wait_until(fun, remaining) do
    if fun.() do
      :ok
    else
      Process.sleep(10)
      wait_until(fun, remaining - 1)
    end
  end

  defp assert_empty(state) do
    for key <- @empty, do: assert(state[key] == %{})
    assert DynamicSupervisor.count_children(state.workers).active == 0
  end

  defp stale_lease(state, permit) do
    # Rejection-only value: disabled profiles never acquire an authenticated lease.
    %KeyOwner.Lease{
      epoch: state.epoch,
      generation: state.generation,
      id: @binding,
      snapshot_generation: make_ref(),
      snapshot: nil,
      permit: permit
    }
  end

  defp assert_stopped(component, name, owner, state) do
    worker_pid = Process.whereis(state.workers)
    assert is_pid(worker_pid)
    assert :ok = Supervisor.stop(component, :normal, 1_000)
    refute Process.alive?(owner)
    refute Process.alive?(worker_pid)
    assert Process.whereis(name) == nil
    assert Process.whereis(state.workers) == nil
    assert :ets.info(state.table) == :undefined
    assert pointer(name) == :absent
    assert {:error, :identity_unavailable} = Admission.acquire(name, :configured)

    assert {:error, :identity_unavailable} =
             ConfiguredVerifier.authenticate(name, :configured, "synthetic", now())
  end

  test "KOL01 ordinary parent shutdown clears its exact admission", %{root: root} do
    name = __MODULE__.KOL01Owner
    {component, owner, state} = component(name, root)
    assert Process.info(owner, :trap_exit) == {:trap_exit, true}
    assert :ets.info(state.table, :owner) == owner
    assert pointer(name) == state.table
    assert_empty(state)
    assert {:ok, permit} = Admission.acquire(name, :configured)
    assert :ok = Admission.release(permit)

    assert {:error, :unauthenticated} =
             ConfiguredVerifier.authenticate(name, :configured, "synthetic", now())

    assert_empty(:sys.get_state(owner))
    assert_stopped(component, name, owner, state)
  end

  test "KOL02 explicit child termination and restart reject old permits", %{root: root} do
    name = __MODULE__.KOL02Owner
    {component, owner, old} = component(name, root)
    workers = Process.whereis(old.workers)
    assert {:ok, old_permit} = Admission.acquire(name, :configured)
    old_lease = stale_lease(old, old_permit)
    assert :ok = Supervisor.terminate_child(component, KeyOwner)
    refute Process.alive?(owner)
    assert Process.whereis(name) == nil
    assert Process.whereis(old.workers) == workers
    assert :ets.info(old.table) == :undefined
    assert pointer(name) == :absent
    assert {:ok, replacement} = Supervisor.restart_child(component, KeyOwner)
    current = :sys.get_state(replacement)
    refute replacement == owner
    refute current.table == old.table
    refute current.epoch == old.epoch
    assert_empty(current)
    assert pointer(name) == current.table
    assert {:ok, permit} = Admission.acquire(name, :configured)
    assert {:error, :identity_unavailable} = KeyOwner.checkout(name, old_permit, now())
    assert {:error, :identity_unavailable} = KeyOwner.finish(name, old_lease)
    assert :ok = KeyOwner.release(name, old_permit)
    assert :ok = Admission.release(old_permit)
    assert Admission.valid?(permit, current.table, self())
    assert :ok = Admission.release(permit)
    assert_stopped(component, name, replacement, current)
  end

  test "KOL03 forced death fails closed across the suspended restart barrier", %{root: root} do
    name = __MODULE__.KOL03Owner
    {component, owner, old} = component(name, root)
    old_workers = Process.whereis(old.workers)
    assert {:ok, permit} = Admission.acquire(name, :configured)
    lease = stale_lease(old, permit)
    monitor = Process.monitor(owner)
    assert :ok = :sys.suspend(component, 500)

    try do
      Process.exit(owner, :kill)
      assert_receive {:DOWN, ^monitor, :process, ^owner, :killed}, 1_000
      assert :ets.info(old.table) == :undefined
      assert pointer(name) == old.table
      assert Process.whereis(name) == nil
      assert Process.whereis(old.workers) == old_workers
      assert {:error, :identity_unavailable} = Admission.acquire(name, :configured)

      assert {:error, :identity_unavailable} =
               ConfiguredVerifier.authenticate(name, :configured, "synthetic", now())

      assert {:error, :identity_unavailable} = KeyOwner.finish(name, lease)
    after
      assert :ok = resume_owned(component)
      Process.demonitor(monitor, [:flush])
    end

    wait_until(fn ->
      replacement = Process.whereis(name)

      is_pid(replacement) and replacement != owner and
        Process.whereis(old.workers) != old_workers
    end)

    replacement = Process.whereis(name)
    current = :sys.get_state(replacement)
    refute current.table == old.table
    refute current.epoch == old.epoch
    assert_empty(current)
    assert pointer(name) == current.table
    assert {:error, :identity_unavailable} = KeyOwner.checkout(name, permit, now())
    assert {:error, :identity_unavailable} = KeyOwner.finish(name, lease)
    assert :ok = Admission.release(permit)
    assert_stopped(component, name, replacement, current)
  end

  test "KOL04 close requires the current table and its creator" do
    name = @admission_name
    assert pointer(name) == :absent
    old = Admission.new(name, %{@binding => @entry}, @binding)
    current = Admission.new(name, %{@binding => @entry}, @binding)

    try do
      refute Admission.close(name, old)
      assert pointer(name) == current
      parent = self()
      reply = make_ref()

      {caller, monitor} =
        spawn_monitor(fn -> send(parent, {reply, Admission.close(name, current)}) end)

      try do
        assert_receive {^reply, false}, 1_000
        assert_receive {:DOWN, ^monitor, :process, ^caller, :normal}, 1_000
      after
        reap_caller(caller, monitor)
      end

      assert pointer(name) == current
      assert :ets.delete(old)
      refute Admission.close(name, old)
      assert pointer(name) == current
      assert Admission.close(name, current)
      refute Admission.close(name, current)
      assert pointer(name) == :absent
      assert :ets.info(current, :owner) == self()
      refute function_exported?(Admission, :close, 1)
    after
      # These are exact test-created tables; no unconditional registry erasure.
      Admission.close(name, current)
      for table <- [old, current], :ets.info(table, :owner) == self(), do: :ets.delete(table)

      observation = %{
        admission_absent: pointer(name) == :absent,
        exact_tables_deleted: Enum.all?([old, current], &(:ets.info(&1) == :undefined))
      }

      evidence("KOL04-cleanup", observation)
      assert observation.admission_absent
      assert observation.exact_tables_deleted
    end
  end

  test "KOL05 duplicate registered start preserves the first table", %{root: root} do
    name = __MODULE__.KOL05Owner
    {component, owner, state} = component(name, root)

    assert {:error, {:already_started, ^owner}} =
             KeyOwner.start_link(
               Keyword.put(options(name, root), :worker_supervisor, state.workers)
             )

    assert Process.whereis(name) == owner
    assert pointer(name) == state.table
    assert :ets.info(state.table, :owner) == owner
    assert :sys.get_state(owner).epoch == state.epoch
    assert_empty(:sys.get_state(owner))
    assert_stopped(component, name, owner, state)
  end

  test "KOL06 invalid ordinary startup never publishes admission", %{root: root} do
    name = __MODULE__.KOL06Owner

    on_exit(fn ->
      wait_until(fn -> Process.whereis(name) == nil and Process.whereis(workers(name)) == nil end)

      observation = %{
        owner_absent: Process.whereis(name) == nil,
        workers_absent: Process.whereis(workers(name)) == nil,
        admission_absent: pointer(name) == :absent
      }

      evidence("KOL06-cleanup", observation)

      assert observation.owner_absent and observation.workers_absent and
               observation.admission_absent
    end)

    for invalid <- [
          Keyword.put(options(name, root), :manifest, []),
          Keyword.put(options(name, root), :binding, "missing"),
          Keyword.put(options(name, root), :ca_roots, [])
        ] do
      parent = self()
      reply = make_ref()

      {caller, monitor} =
        spawn_monitor(fn ->
          Process.flag(:trap_exit, true)
          result = KeyOwnerSupervisor.start_link(invalid)

          # Unexpected success is still stopped by its exact owner before reporting.
          if match?({:ok, _}, result), do: Supervisor.stop(elem(result, 1), :normal, 1_000)
          send(parent, {reply, result})
        end)

      try do
        assert_receive {^reply,
                        {:error,
                         {:shutdown,
                          {:failed_to_start_child, KeyOwner, :invalid_identity_configuration}}}},
                       1_000

        assert_receive {:DOWN, ^monitor, :process, ^caller, :normal}, 1_000
      after
        reap_caller(caller, monitor)
      end

      assert Process.whereis(name) == nil
      assert Process.whereis(workers(name)) == nil
      assert pointer(name) == :absent
    end
  end

  test "KOL07 worker supervisor death restarts both empty children", %{root: root} do
    name = __MODULE__.KOL07Owner
    {component, owner, old} = component(name, root)
    old_workers = Process.whereis(old.workers)
    assert_empty(old)
    assert {:ok, permit} = Admission.acquire(name, :configured)
    lease = stale_lease(old, permit)
    owner_monitor = Process.monitor(owner)
    workers_monitor = Process.monitor(old_workers)
    Process.exit(old_workers, :kill)
    assert_receive {:DOWN, ^workers_monitor, :process, ^old_workers, :killed}, 1_000
    assert_receive {:DOWN, ^owner_monitor, :process, ^owner, :shutdown}, 1_000
    wait_until(fn -> is_pid(Process.whereis(name)) and Process.whereis(name) != owner end)
    replacement = Process.whereis(name)
    current = :sys.get_state(replacement)
    refute Process.whereis(current.workers) == old_workers
    refute current.table == old.table
    refute current.epoch == old.epoch
    assert :ets.info(old.table) == :undefined
    assert pointer(name) == current.table
    assert_empty(current)
    assert {:error, :identity_unavailable} = KeyOwner.checkout(name, permit, now())
    assert {:error, :identity_unavailable} = KeyOwner.finish(name, lease)
    assert :ok = Admission.release(permit)
    assert_stopped(component, name, replacement, current)
  end
end

