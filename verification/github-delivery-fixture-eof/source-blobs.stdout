  test "catalog source manifest is exact and public execution is revoked" do
    manifest = StorageSchema.catalog_manifest()

    for {name, expected} <- manifest.functions do
      assert [[expected.source, expected.settings, "browser_writer"]] ==
               F.q!(
                 Admin,
                 "SELECT prosrc,proconfig,pg_catalog.pg_get_userbyid(proowner) FROM pg_catalog.pg_proc WHERE oid=('public.'||$1||'('||$2||')')::regprocedure",
                 [name, expected.signature]
               ).rows

      assert [[false]] ==
               F.q!(
                 Admin,
                 "SELECT pg_catalog.has_function_privilege('browser_ordinary',('public.'||$1||'('||$2||')')::regprocedure,'EXECUTE')",
                 [name, expected.signature]
               ).rows
    end
  end

  test "real SQL snapshots decode and reopen durable AEAD custody through independent connections",
       %{conn: c} do
    alias MixerHosted.BrowserAuth.{Vault, StoredSnapshot}
    {:ok, key} = Vault.key("fixture-v1", F.random())
    raw_csrf = F.token()
    csrf = :crypto.hash(:sha256, raw_csrf)
    id = F.random(16)
    cookie = F.random()
    config = F.random()
    generation = F.token()

    context = %{
      purpose: :preauth,
      browser_id: id,
      cookie_digest: cookie,
      csrf_digest: csrf,
      epoch: 1,
      revision: 1,
      generation: generation,
      vault_generation: 1,
      config_digest: config,
      profile_id: "humans",
      profile_version: 1,
      principal_id: nil,
      family_id: nil,
      credential_ref: nil,
      credential_revision: nil
    }

    {:ok, sealed} = Vault.seal(key, context, %Vault.Preauth{csrf: raw_csrf})
    cipher = fn sealed -> {:cipher, {sealed.key_id, sealed.iv, sealed.tag, sealed.ciphertext}} end

    assert {:ok, snapshot} =
             F.call(c, :bootstrap, [
               id,
               cookie,
               generation,
               csrf,
               config,
               "humans",
               1,
               F.now() + 250,
               cipher.(sealed),
               F.request()
             ])

    assert {:ok, decoded} = StoredSnapshot.decode(snapshot)
    assert decoded.session_envelope.context == context

    assert {:ok, %Vault.Preauth{csrf: ^raw_csrf}} =
             Vault.open(key, decoded.session_envelope.context, decoded.session_envelope.sealed)

    a = %{
      state: F.random(),
      nonce: F.random(),
      profile: "humans",
      issuer: "https://issuer.fixture",
      client: "console",
      redirect: "https://console.fixture/auth/callback",
      expires: F.now() + 150
    }

    verifier = F.token()

    attempt_context = %{
      purpose: :attempt,
      state_digest: a.state,
      browser_id: id,
      cookie_digest: cookie,
      epoch: 2,
      revision: 2,
      generation: generation,
      config_digest: config,
      profile_id: "humans",
      profile_version: 1,
      issuer: a.issuer,
      client_id: a.client,
      redirect_uri: a.redirect,
      expires_at: a.expires
    }

    {:ok, attempt_cipher} = Vault.seal(key, attempt_context, %Vault.Verifier{verifier: verifier})
    context = %{context | epoch: 2, revision: 2, vault_generation: 2}
    {:ok, sealed} = Vault.seal(key, context, %Vault.Preauth{csrf: raw_csrf})

    a =
      Map.put(
        a,
        :cipher,
        {attempt_cipher.key_id, attempt_cipher.iv, attempt_cipher.tag, attempt_cipher.ciphertext}
      )

    assert {:ok, snapshot} =
             F.call(c, :begin, [
               cookie,
               csrf,
               config,
               1,
               {:attempt, a},
               cipher.(sealed),
               F.request()
             ])

    assert {:ok, decoded} = StoredSnapshot.decode(snapshot)
    assert decoded.attempt_envelope.context == attempt_context

    assert {:ok, %Vault.Verifier{verifier: ^verifier}} =
             Vault.open(key, decoded.attempt_envelope.context, decoded.attempt_envelope.sealed)

    # Recovered verifier is in owner memory before durable claim erases it.
    claim = F.random()

    assert {:ok, snapshot} =
             F.call(c, :claim, [cookie, a.state, config, 2, claim, F.now() + 55, F.request()])

    assert {:ok, %StoredSnapshot{attempt_envelope: nil}} = StoredSnapshot.decode(snapshot)
    i = F.identity()
    new_cookie = F.random()
    new_raw_csrf = F.token()
    new_csrf = :crypto.hash(:sha256, new_raw_csrf)
    new_generation = F.token()
    family = "browser_" <> F.token()
    token = "synthetic-api-access-token"

    active = %{
      context
      | purpose: :active,
        cookie_digest: new_cookie,
        csrf_digest: new_csrf,
        epoch: 3,
        revision: 3,
        generation: new_generation,
        vault_generation: 3,
        principal_id: "person-1",
        family_id: family,
        credential_ref: i.jti,
        credential_revision: 1
    }

    {:ok, sealed} =
      Vault.seal(key, active, %Vault.Active{csrf: new_raw_csrf, access_token: token})

    assert {:ok, snapshot} =
             F.call(c, :activate, [
               cookie,
               a.state,
               config,
               claim,
               2,
               {:verified, i},
               new_cookie,
               new_csrf,
               new_generation,
               family,
               F.now() + 500,
               cipher.(sealed),
               F.request()
             ])

    assert {:ok, decoded} = StoredSnapshot.decode(snapshot)
    assert decoded.session_envelope.context == active

    assert {:ok, %Vault.Active{csrf: ^new_raw_csrf, access_token: ^token}} =
             Vault.open(key, decoded.session_envelope.context, decoded.session_envelope.sealed)

    restarted = F.connection!()
    Postgrex.query!(restarted, "SET bytea_output='escape'", [])
    assert {:ok, snapshot} = F.call(restarted, :load, [new_cookie, config])
    assert {:ok, decoded} = StoredSnapshot.decode(snapshot)
    assert decoded.attempt == nil

    assert {:ok, %Vault.Active{access_token: ^token}} =
             Vault.open(key, decoded.session_envelope.context, decoded.session_envelope.sealed)

    GenServer.stop(restarted)
    # Provider-error output is also accepted by the real typed decoder.
    other = F.bootstrap(c)
    {other, attempt} = F.begin_login(c, other)

    assert {:ok, rejected} =
             F.call(c, :provider_reject, [
               other.cookie,
               attempt.state,
               other.config,
               other.revision,
               F.request()
             ])

    assert {:ok, %StoredSnapshot{attempt_envelope: nil}} = StoredSnapshot.decode(rejected)
  end

  test "non-superuser operator ownership failure rolls back temporary grants and remains inert" do
    alias MixerHosted.BrowserAuth.StorageFixture.OperatorMigration

    settings = [
      hostname: "127.0.0.1",
      port: F.port(),
      database: "browser_operator_storage",
      username: "browser_operator",
      pool_size: 2,
      log: false
    ]

    start_supervised!({OperatorMigration, settings})
    F.install!(OperatorMigration)
    {:ok, operator} = Postgrex.start_link(Keyword.put(settings, :pool_size, 1))
    Process.unlink(operator)
    plan = StorageSchema.provisioning_statements("browser_writer", "browser_lifecycle")
    assert ["BEGIN", admission, temporary_create | rest] = plan
    for sql <- ["BEGIN", admission, temporary_create], do: Postgrex.query!(operator, sql, [])

    assert {:error, %Postgrex.Error{postgres: %{code: :insufficient_privilege}}} =
             Postgrex.query(operator, hd(rest), [])

    Postgrex.query!(operator, "ROLLBACK", [])

    assert [[false, true]] ==
             Postgrex.query!(
               operator,
               "SELECT pg_catalog.has_schema_privilege('browser_writer','public','CREATE'),pg_catalog.has_schema_privilege('browser_writer','public','USAGE')",
               []
             ).rows

    assert [[true]] ==
             Postgrex.query!(
               operator,
               "SELECT bool_and(pg_catalog.pg_get_userbyid(proowner)='browser_operator') FROM pg_catalog.pg_proc WHERE proname LIKE 'mixer_browser_%'",
               []
             ).rows

    assert [[0]] ==
             Postgrex.query!(
               operator,
               "SELECT count(*) FROM pg_catalog.pg_policies WHERE schemaname='public' AND policyname LIKE 'mixer_browser_%'",
               []
             ).rows

    assert [[false, false]] ==
             Postgrex.query!(
               operator,
               "SELECT pg_catalog.has_table_privilege('browser_writer','public.mixer_browser_sessions','INSERT'),pg_catalog.has_function_privilege('browser_lifecycle','public.mixer_browser_load(bytea,bytea)','EXECUTE')",
               []
             ).rows

    GenServer.stop(operator)
  end

  test "controlled rollback and reapply preserve ordinary directory and revoke writer authz grants" do
    ordinary = F.connection!("browser_ordinary")
    assert [["org"]] == directory_rows(ordinary)

    assert :ok =
             Ecto.Migrator.down(
               Migration,
               20_261_025_000_007,
               MixerHosted.Repo.Migrations.AddBrowserSessions,
               log: false
             )

    assert [["org"]] == directory_rows(ordinary)

    assert [[false, false, false]] ==
             F.q!(
               Admin,
               "SELECT pg_catalog.has_table_privilege('browser_writer','public.mixer_authz_families','SELECT'),pg_catalog.has_table_privilege('browser_writer','public.mixer_authz_families','INSERT'),pg_catalog.has_column_privilege('browser_writer','public.mixer_authz_profiles','state_revision','UPDATE')"
             ).rows

    assert :ok =
             Ecto.Migrator.up(
               Migration,
               20_261_025_000_007,
               MixerHosted.Repo.Migrations.AddBrowserSessions,
               log: false
             )

    F.provision!()
    assert [["org"]] == directory_rows(ordinary)
    GenServer.stop(ordinary)
  end

  defp directory_rows(conn, overrides \\ %{}) do
    before = directory_settings(conn)
    [backend, _jit, statement, lock, idle] = before
    Postgrex.query!(conn, "BEGIN", [])

    try do
      # Match the ordinary runtime's bounded transaction preparation without
      # changing this connection's inherited policy or any timeout.
      Postgrex.query!(conn, "SET LOCAL jit = off", [])
      assert [backend, "off", statement, lock, idle] == directory_settings(conn)
      configure(conn, overrides)

      rows =
        Postgrex.query!(conn, "SELECT id FROM public.mixer_authz_organizations ORDER BY id", []).rows

      Postgrex.query!(conn, "COMMIT", [])
      rows
    rescue
      error ->
        Postgrex.query!(conn, "ROLLBACK", [])
        reraise error, __STACKTRACE__
    after
      assert before == directory_settings(conn)
    end
  end

  defp directory_settings(conn) do
    Postgrex.query!(
      conn,
      "SELECT pg_catalog.pg_backend_pid(),pg_catalog.current_setting('jit'),pg_catalog.current_setting('statement_timeout'),pg_catalog.current_setting('lock_timeout'),pg_catalog.current_setting('idle_in_transaction_session_timeout')",
      []
    ).rows
    |> hd()
  end

  defp configure(conn, overrides) do
    values = %{
      "profile_id" => "humans",
      "profile_version" => "1",
      "issuer" => "https://issuer.fixture",
      "client_id" => "console",
      "identity_class" => "human",
      "principal_id" => "person-1",
      "subject" => "subject-1",
      "family_id" => "ordinary-family",
      "credential_ref" => "ordinary-jti",
      "directory_mode" => "organizations",
      "action" => "workspace.read",
      "required_scope" => "mixer.workspace.read",
      "phase" => "directory",
      "project_id" => "",
      "application_id" => "",
      "environment_id" => "",
      "organization_id" => "",
      "token_issued_at" => Integer.to_string(F.now() - 5),
      "token_expires_at" => Integer.to_string(F.now() + 300)
    }

    Enum.each(Map.merge(values, overrides), fn {key, value} ->
      Postgrex.query!(conn, "SELECT pg_catalog.set_config($1,$2,true)", [
        "mixer.authz." <> key,
        value
      ])
    end)

    :ok
  end
end

52aad97d8be69c153d50c02ef4e4bbe835dd0733 blob 15352
defmodule MixerHosted.BrowserAuth.StoredSnapshotTest do
  use ExUnit.Case, async: true
  alias MixerHosted.BrowserAuth.{StoredSnapshot, Vault}
  @error {:error, :snapshot_unavailable}
  @csrf Base.url_encode64(:binary.copy(<<11>>, 32), padding: false)
  @verifier Base.url_encode64(:binary.copy(<<12>>, 32), padding: false)
  @generation Base.url_encode64(:binary.copy(<<13>>, 32), padding: false)
  @replacement Base.url_encode64(:binary.copy(<<14>>, 32), padding: false)

  defp raw(byte, size \\ 32), do: :binary.copy(<<byte>>, size)
  defp hex(bytes), do: "\\x" <> Base.encode16(bytes, case: :lower)

  defp key do
    {:ok, value} = Vault.key("key-v1", raw(42))
    value
  end

  defp context(kind) do
    %{
      purpose: kind,
      browser_id: raw(1, 16),
      cookie_digest: raw(2),
      csrf_digest: :crypto.hash(:sha256, @csrf),
      epoch: 2,
      revision: 2,
      generation: @generation,
      vault_generation: 2,
      config_digest: raw(3),
      profile_id: "human-main",
      profile_version: 1,
      principal_id: if(kind == :active, do: "person-1"),
      family_id: if(kind == :active, do: "browser_" <> @generation),
      credential_ref: if(kind == :active, do: "jti-1"),
      credential_revision: if(kind == :active, do: 1)
    }
  end

  defp cipher(context, plaintext) do
    {:ok, value} = Vault.seal(key(), context, plaintext)

    %{
      "ciphertext_version" => value.version,
      "key_id" => value.key_id,
      "iv" => hex(value.iv),
      "tag" => hex(value.tag),
      "ciphertext" => hex(value.ciphertext)
    }
  end

  defp fixture(kind \\ :preauth) do
    c = context(kind)

    plaintext =
      if kind == :preauth,
        do: %Vault.Preauth{csrf: @csrf},
        else: %Vault.Active{csrf: @csrf, access_token: "header.payload.signature"}

    browser = %{
      "id" => hex(c.browser_id),
      "cookie_digest" => hex(c.cookie_digest),
      "status" => Atom.to_string(kind),
      "epoch" => 2,
      "revision" => 2,
      "generation" => c.generation,
      "csrf_digest" => hex(c.csrf_digest),
      "created_at" => 100,
      "last_seen_at" => 101,
      "absolute_expires_at" => 1000,
      "idle_expires_at" => 700,
      "expected_profile_id" => c.profile_id,
      "expected_profile_version" => c.profile_version,
      "initial_config_digest" => hex(c.config_digest),
      "config_digest" => hex(c.config_digest),
      "profile_id" => if(kind == :active, do: c.profile_id),
      "profile_version" => if(kind == :active, do: c.profile_version),
      "principal_id" => c.principal_id,
      "family_id" => c.family_id,
      "credential_ref" => c.credential_ref,
      "credential_revision" => c.credential_revision,
      "audit_sequence" => 2
    }

    vault =
      Map.merge(cipher(c, plaintext), %{
        "browser_id" => hex(c.browser_id),
        "epoch" => 2,
        "session_revision" => 2,
        "vault_generation" => 2,
        "envelope_kind" => Atom.to_string(kind)
      })

    %{"browser" => browser, "vault" => vault, "attempt" => nil}
  end

  defp pending(kind \\ :preauth) do
    c = context(kind)

    a = %{
      purpose: :attempt,
      state_digest: raw(4),
      browser_id: c.browser_id,
      cookie_digest: c.cookie_digest,
      epoch: 2,
      revision: 2,
      generation: c.generation,
      config_digest: c.config_digest,
      profile_id: c.profile_id,
      profile_version: c.profile_version,
      issuer: "https://id.example.test",
      client_id: "console-client",
      redirect_uri: "https://console.example.test/auth/callback",
      expires_at: 400
    }

    row = %{
      "state_digest" => hex(a.state_digest),
      "browser_id" => hex(a.browser_id),
      "cookie_digest" => hex(a.cookie_digest),
      "browser_epoch" => 2,
      "browser_revision" => 2,
      "generation" => a.generation,
      "config_digest" => hex(a.config_digest),
      "profile_id" => a.profile_id,
      "profile_version" => a.profile_version,
      "issuer" => a.issuer,
      "client_id" => a.client_id,
      "redirect_uri" => a.redirect_uri,
      "expires_at" => 400,
      "created_at" => 110,
      "return_route" => "workspace",
      "nonce_digest" => hex(raw(5)),
      "status" => "pending",
      "claim_digest" => nil,
      "claimed_at" => nil,
      "claim_expires_at" => nil,
      "completion_reason" => nil
    }

    Map.put(
      fixture(kind),
      "attempt",
      Map.merge(row, cipher(a, %Vault.Verifier{verifier: @verifier}))
    )
  end

  defp consumed(status, kind \\ :preauth) do
    input = pending(kind)
    row = Enum.reduce(~w(key_id iv tag ciphertext), input["attempt"], &Map.put(&2, &1, nil))
    row = Map.put(row, "status", status)

    row =
      if status == "provider_rejected" do
        Map.put(row, "completion_reason", "provider_rejected")
      else
        Map.merge(row, %{
          "claim_digest" => hex(raw(6)),
          "claimed_at" => 120,
          "claim_expires_at" => 180,
          "completion_reason" => if(status == "completed", do: "completed")
        })
      end

    Map.put(input, "attempt", row)
  end

  defp completed do
    input = consumed("completed", :active)
    # Activation rotates the browser and vault; attempt metadata retains begin values.
    c = %{
      context(:active)
      | epoch: 3,
        revision: 3,
        vault_generation: 3,
        cookie_digest: raw(7),
        generation: @replacement
    }

    browser =
      Map.merge(input["browser"], %{
        "epoch" => 3,
        "revision" => 3,
        "audit_sequence" => 4,
        "cookie_digest" => hex(c.cookie_digest),
        "generation" => c.generation
      })

    vault =
      Map.merge(
        input["vault"],
        cipher(c, %Vault.Active{csrf: @csrf, access_token: "header.payload.signature"})
      )
      |> Map.merge(%{"epoch" => 3, "session_revision" => 3, "vault_generation" => 3})

    %{input | "browser" => browser, "vault" => vault}
  end

  test "preauth and active PostgreSQL JSON decode to exact authenticated Vault contexts" do
    for kind <- [:preauth, :active] do
      assert {:ok, snapshot} = StoredSnapshot.decode(fixture(kind))
      assert snapshot.session_envelope.context == context(kind)

      assert {:ok, plaintext} =
               Vault.open(
                 key(),
                 snapshot.session_envelope.context,
                 snapshot.session_envelope.sealed
               )

      assert plaintext.csrf == @csrf
      assert snapshot.attempt == nil
      assert snapshot.attempt_envelope == nil
      assert snapshot.browser["id"] == raw(1, 16)
      refute inspect(snapshot) =~ @generation
      refute inspect(snapshot.session_envelope) =~ "key-v1"
    end
  end

  test "pending attempt uses saved begin values and authenticates a real verifier" do
    for kind <- [:preauth, :active] do
      assert {:ok, snapshot} = StoredSnapshot.decode(pending(kind))
      assert snapshot.attempt_envelope.context.revision == 2

      assert {:ok, %Vault.Verifier{verifier: @verifier}} =
               Vault.open(
                 key(),
                 snapshot.attempt_envelope.context,
                 snapshot.attempt_envelope.sealed
               )

      assert snapshot.attempt["nonce_digest"] == raw(5)
    end
  end

  test "claim and provider rejection retain only closed consumed metadata" do
    for kind <- [:preauth, :active], status <- ["claimed", "provider_rejected"] do
      assert {:ok, snapshot} = StoredSnapshot.decode(consumed(status, kind))
      assert snapshot.attempt["status"] == status
      assert snapshot.attempt_envelope == nil
      assert snapshot.session_envelope.context.revision == 2

      assert {:ok, _} =
               Vault.open(
                 key(),
                 snapshot.session_envelope.context,
                 snapshot.session_envelope.sealed
               )
    end
  end

  test "completed metadata binds old begin context to a newly rotated active browser" do
    assert {:ok, snapshot} = StoredSnapshot.decode(completed())
    assert snapshot.attempt["browser_revision"] == 2
    assert snapshot.session_envelope.context.revision == 3
    assert snapshot.attempt_envelope == nil

    assert {:ok, %Vault.Active{}} =
             Vault.open(
               key(),
               snapshot.session_envelope.context,
               snapshot.session_envelope.sealed
             )

    for {field, value} <- [
          {"browser_epoch", 3},
          {"browser_revision", 1},
          {"cookie_digest", hex(raw(7))},
          {"generation", @replacement}
        ] do
      assert StoredSnapshot.decode(put_in(completed(), ["attempt", field], value)) == @error
    end
  end

  test "all object boundaries reject missing unknown atom and structural fields" do
    input = pending()

    for path <- [[], ["browser"], ["vault"], ["attempt"]] do
      row = if path == [], do: input, else: get_in(input, path)
      replace = fn value -> if path == [], do: value, else: put_in(input, path, value) end

      for field <- Map.keys(row) do
        assert StoredSnapshot.decode(replace.(Map.delete(row, field))) == @error
      end

      for value <- [
            nil,
            [],
            "row",
            0,
            Map.put(row, "extra", true),
            Map.put(row, :status, "active"),
            Map.put(row, :__struct__, StoredSnapshot)
          ] do
        if path == ["attempt"] and value == nil do
          assert {:ok, _} = StoredSnapshot.decode(replace.(value))
        else
          assert StoredSnapshot.decode(replace.(value)) == @error
        end
      end
    end
  end

  test "canonical bytea excludes aliases wrong widths odd hex and unbounded ciphertext" do
    input = pending()

    for path <- [
          ["browser", "id"],
          ["browser", "cookie_digest"],
          ["browser", "csrf_digest"],
          ["browser", "initial_config_digest"],
          ["browser", "config_digest"],
          ["vault", "browser_id"],
          ["vault", "iv"],
          ["vault", "tag"],
          ["attempt", "state_digest"],
          ["attempt", "nonce_digest"]
        ] do
      for value <- [
            nil,
            1,
            "",
            "\\x0",
            "\\xGG",
            "\\xAB",
            "AB",
            raw(1),
            get_in(input, path) <> "00"
          ] do
        assert StoredSnapshot.decode(put_in(input, path, value)) == @error
      end
    end

    for value <- ["\\x", hex(raw(1, 8193)), "\\xabc", nil] do
      assert StoredSnapshot.decode(put_in(input, ["vault", "ciphertext"], value)) == @error
    end
  end

  test "browser state linkage counters profiles and times fail closed" do
    for {field, values} <- [
          {"status", ["revoked", "expired", "authenticated", nil]},
          {"epoch", [0, -1, 1.0, 9_007_199_254_740_992]},
          {"revision", [0, "2", 1.0]},
          {"audit_sequence", [1, -1, 2.0]},
          {"generation", ["", @generation <> "=", String.duplicate("A", 42) <> "B"]},
          {"expected_profile_id", [nil, "", "a\0b", <<255>>, String.duplicate("a", 129)]},
          {"expected_profile_version", [0, 1.0, 2_147_483_648]},
          {"created_at", [-1, 102]},
          {"last_seen_at", [99, 700]},
          {"idle_expires_at", [101, 1001]},
          {"absolute_expires_at", [699, 9_007_199_254_740_992]},
          {"principal_id", ["person-1"]},
          {"profile_version", [1]}
        ] do
      for value <- values,
          do:
            assert(StoredSnapshot.decode(put_in(fixture(), ["browser", field], value)) == @error)
    end

    for field <-
          ~w(profile_id profile_version principal_id family_id credential_ref credential_revision) do
      assert StoredSnapshot.decode(put_in(fixture(:active), ["browser", field], nil)) == @error
    end

    for {field, value} <- [
          {"profile_id", "other"},
          {"profile_version", 2},
          {"profile_version", 1.0},
          {"credential_ref", String.duplicate("x", 257)},
          {"credential_revision", 0}
        ] do
      assert StoredSnapshot.decode(put_in(fixture(:active), ["browser", field], value)) == @error
    end
  end

  test "vault metadata cannot be swapped or silently upgraded" do
    for {field, value} <- [
          {"browser_id", hex(raw(9, 16))},
          {"epoch", 3},
          {"session_revision", 3},
          {"epoch", 2.0},
          {"session_revision", 2.0},
          {"vault_generation", 0},
          {"ciphertext_version", 2},
          {"ciphertext_version", 1.0},
          {"envelope_kind", "active"},
          {"envelope_kind", "erased"},
          {"key_id", "a:b"}
        ] do
      assert StoredSnapshot.decode(put_in(fixture(), ["vault", field], value)) == @error
    end
  end

  test "attempt context cannot cross browser config identity or revision" do
    for {field, value} <- [
          {"browser_id", hex(raw(9, 16))},
          {"cookie_digest", hex(raw(9))},
          {"browser_epoch", 1},
          {"browser_revision", 3},
          {"config_digest", hex(raw(9))},
          {"profile_id", "other"},
          {"profile_version", 2},
          {"profile_version", 1.0},
          {"ciphertext_version", 1.0},
          {"generation", @replacement},
          {"return_route", "https://evil.test"},
          {"created_at", 99},
          {"expires_at", 411},
          {"expires_at", 110},
          {"issuer", "bad\0value"},
          {"client_id", String.duplicate("x", 257)},
          {"redirect_uri", <<255>>},
          {"status", "failed"},
          {"status", "superseded"}
        ] do
      assert StoredSnapshot.decode(put_in(pending(), ["attempt", field], value)) == @error
    end
  end

  test "claim metadata and ciphertext erasure are enforced for every returned state" do
    for field <- ~w(claim_digest claimed_at claim_expires_at completion_reason) do
      assert StoredSnapshot.decode(put_in(pending(), ["attempt", field], "unexpected")) == @error
    end

    for input <- [consumed("claimed"), consumed("provider_rejected"), completed()],
        field <- ~w(key_id iv tag ciphertext) do
      assert StoredSnapshot.decode(put_in(input, ["attempt", field], "retained")) == @error
    end

    for {field, value} <- [
          {"claim_digest", nil},
          {"claimed_at", 109},
          {"claim_expires_at", 120},
          {"claim_expires_at", 181},
          {"claim_expires_at", 401},
          {"completion_reason", "completed"}
        ] do
      assert StoredSnapshot.decode(put_in(consumed("claimed"), ["attempt", field], value)) ==
               @error
    end

    assert StoredSnapshot.decode(
             put_in(consumed("provider_rejected"), ["attempt", "claim_digest"], hex(raw(6)))
           ) == @error

    assert StoredSnapshot.decode(put_in(completed(), ["attempt", "completion_reason"], nil)) ==
             @error
  end

  test "decoding is not authentication: changed ciphertext requires cryptographic rejection" do
    input = put_in(fixture(), ["vault", "tag"], hex(raw(9, 16)))
    assert {:ok, snapshot} = StoredSnapshot.decode(input)

    assert Vault.open(key(), snapshot.session_envelope.context, snapshot.session_envelope.sealed) ==
             {:error, :vault_unavailable}

    # Timestamps deliberately remain historical. Fresh-time admission belongs to the owner/SQL.
    assert snapshot.browser["absolute_expires_at"] == 1000
  end
end

5f17a527339900b3410353de659ef006d6ed13c9 blob 20940
defmodule MixerHosted.BrowserAuth.VaultTest do
  use ExUnit.Case, async: true
  alias MixerHosted.BrowserAuth.Vault
  alias Vault.{Active, Key, Preauth, Sealed, Verifier}
  @error {:error, :vault_unavailable}
  @csrf Base.url_encode64(:binary.copy(<<11>>, 32), padding: false)
  @verifier Base.url_encode64(:binary.copy(<<12>>, 32), padding: false)
  @generation Base.url_encode64(:binary.copy(<<13>>, 32), padding: false)

  defp key do
    {:ok, key} = Vault.key("session-key-v1", :binary.copy(<<42>>, 32))
    key
  end

  defp session(purpose \\ :preauth) do
    base = %{
      purpose: purpose,
      browser_id: :binary.copy(<<1>>, 16),
      cookie_digest: :binary.copy(<<2>>, 32),
      csrf_digest: :crypto.hash(:sha256, @csrf),
      epoch: 1,
      revision: 2,
      generation: @generation,
      vault_generation: 3,
      config_digest: :binary.copy(<<4>>, 32),
      profile_id: "human-main",
      profile_version: 7,
      principal_id: nil,
      family_id: nil,
      credential_ref: nil,
      credential_revision: nil
    }

    if purpose == :active do
      Map.merge(base, %{
        principal_id: "person-1",
        family_id: "browser_" <> @generation,
        credential_ref: "external-jti-1",
        credential_revision: 5
      })
    else
      base
    end
  end

  defp attempt do
    Map.take(session(), [
      :browser_id,
      :cookie_digest,
      :epoch,
      :revision,
      :generation,
      :config_digest,
      :profile_id,
      :profile_version
    ])
    |> Map.merge(%{
      purpose: :attempt,
      state_digest: :binary.copy(<<5>>, 32),
      issuer: "https://id.example.test",
      client_id: "console-client",
      redirect_uri: "https://console.example.test/auth/callback",
      expires_at: 123_456
    })
  end

  defp plaintext(:preauth), do: %Preauth{csrf: @csrf}
  defp plaintext(:active), do: %Active{csrf: @csrf, access_token: "header.payload.signature"}
  defp plaintext(:attempt), do: %Verifier{verifier: @verifier}
  defp context(:attempt), do: attempt()
  defp context(purpose), do: session(purpose)

  defp flip(<<first, rest::binary>>), do: <<Bitwise.bxor(first, 1), rest::binary>>
  defp lp(bytes), do: <<byte_size(bytes)::unsigned-big-32, bytes::binary>>
  defp u64(value), do: <<value::unsigned-big-64>>

  # Test-only standard platform encryption permits authenticated malformed payloads.
  # The production module exposes no nonce injection or raw plaintext encrypt API.
  defp authenticated(context, raw) do
    key = key()
    {:ok, aad} = Vault.associated_data(key.id, context)
    iv = :binary.copy(<<9>>, 12)

    {ciphertext, tag} =
      :crypto.crypto_one_time_aead(:aes_256_gcm, key.bytes, iv, raw, aad, 16, true)

    %Sealed{version: 1, key_id: key.id, iv: iv, tag: tag, ciphertext: ciphertext}
  end

  test "exact externally supplied 256-bit key and bounded identifier" do
    assert {:ok, %Key{}} = Vault.key("a._-09AZ", :binary.copy(<<0>>, 32))
    assert {:ok, %Key{}} = Vault.key(String.duplicate("a", 128), :binary.copy(<<0>>, 32))

    for id <- [nil, "", "a/b", "secret://key", "bad\n", "é", String.duplicate("a", 129)],
        do: assert(Vault.key(id, :binary.copy(<<0>>, 32)) == @error)

    for bytes <- [nil, [], "", :binary.copy(<<0>>, 31), :binary.copy(<<0>>, 33)],
        do: assert(Vault.key("key-1", bytes) == @error)
  end

  test "preauth, active and verifier envelopes round trip independently" do
    for purpose <- [:preauth, :active, :attempt] do
      assert {:ok, sealed} = Vault.seal(key(), context(purpose), plaintext(purpose))
      assert sealed.version == 1
      assert byte_size(sealed.iv) == 12
      assert byte_size(sealed.tag) == 16
      assert byte_size(sealed.ciphertext) <= 8192
      assert {:ok, result} = Vault.open(key(), context(purpose), sealed)
      assert result == plaintext(purpose)
      refute :binary.match(sealed.ciphertext, @csrf) != :nomatch
    end
  end

  test "every encryption generates an independent IV including different purposes" do
    values =
      for index <- 1..96 do
        purpose = Enum.at([:preauth, :active, :attempt], rem(index, 3))
        {:ok, sealed} = Vault.seal(key(), context(purpose), plaintext(purpose))
        sealed.iv
      end

    assert length(Enum.uniq(values)) == 96
    refute function_exported?(Vault, :seal, 4)
  end

  test "raw 32-byte digests differ from wire canonical43 and browser ID is exactly16 bytes" do
    for field <- [:cookie_digest, :csrf_digest, :config_digest] do
      assert Vault.seal(key(), Map.put(session(), field, @generation), plaintext(:preauth)) ==
               @error
    end

    assert Vault.seal(key(), Map.put(session(), :browser_id, @generation), plaintext(:preauth)) ==
             @error

    assert Vault.seal(key(), Map.put(attempt(), :state_digest, @generation), plaintext(:attempt)) ==
             @error
  end

  test "AAD is independently specified length-prefixed and ordered for preauth" do
    c = session()

    expected =
      "mixer.browser.vault.v1\0" <>
        IO.iodata_to_binary(
          Enum.map(
            [
              <<1>>,
              "session-key-v1",
              <<1>>,
              c.browser_id,
              c.cookie_digest,
              c.csrf_digest,
              u64(c.epoch),
              u64(c.revision),
              c.generation,
              u64(c.vault_generation),
              c.config_digest,
              c.profile_id,
              u64(c.profile_version),
              <<0>>
            ],
            &lp/1
          )
        )

    assert Vault.associated_data("session-key-v1", c) == {:ok, expected}
  end

  test "AAD is independently specified for active exact linkage and attempt" do
    c = session(:active)

    expected =
      "mixer.browser.vault.v1\0" <>
        IO.iodata_to_binary(
          Enum.map(
            [
              <<1>>,
              "session-key-v1",
              <<2>>,
              c.browser_id,
              c.cookie_digest,
              c.csrf_digest,
              u64(c.epoch),
              u64(c.revision),
              c.generation,
              u64(c.vault_generation),
              c.config_digest,
              c.profile_id,
              u64(c.profile_version),
              <<1>>,
              c.principal_id,
              c.family_id,
              c.credential_ref,
              u64(c.credential_revision)
            ],
            &lp/1
          )
        )

    assert Vault.associated_data("session-key-v1", c) == {:ok, expected}
    c = attempt()

    expected =
      "mixer.browser.attempt.v1\0" <>
        IO.iodata_to_binary(
          Enum.map(
            [
              <<1>>,
              "session-key-v1",
              <<3>>,
              c.state_digest,
              c.browser_id,
              c.cookie_digest,
              u64(c.epoch),
              u64(c.revision),
              c.generation,
              c.config_digest,
              c.profile_id,
              u64(c.profile_version),
              c.issuer,
              c.client_id,
              c.redirect_uri,
              u64(c.expires_at)
            ],
            &lp/1
          )
        )

    assert Vault.associated_data("session-key-v1", c) == {:ok, expected}
  end

  test "every current session field including authz linkage is authenticated" do
    for purpose <- [:preauth, :active] do
      c = context(purpose)
      {:ok, sealed} = Vault.seal(key(), c, plaintext(purpose))

      for {field, value} <- c, field != :purpose do
        changed =
          case value do
            nil ->
              "foreign"

            value when is_integer(value) ->
              value + 1

            _value when field == :generation ->
              Base.url_encode64(:binary.copy(<<14>>, 32), padding: false)

            value when is_binary(value) ->
              flip(value)
          end

        assert Vault.open(key(), Map.put(c, field, changed), sealed) == @error,
               "changed field: #{field}"
      end

      other = if purpose == :preauth, do: :active, else: :preauth
      assert Vault.open(key(), context(other), sealed) == @error
    end
  end

  test "every current attempt field is authenticated" do
    c = attempt()
    {:ok, sealed} = Vault.seal(key(), c, plaintext(:attempt))

    for {field, value} <- c, field != :purpose do
      changed =
        case value do
          value when is_integer(value) ->
            value + 1

          _value when field == :generation ->
            Base.url_encode64(:binary.copy(<<15>>, 32), padding: false)

          value when is_binary(value) ->
            flip(value)
        end

      assert Vault.open(key(), Map.put(c, field, changed), sealed) == @error,
             "changed field: #{field}"
    end

    assert Vault.open(key(), session(), sealed) == @error
    {:ok, session_sealed} = Vault.seal(key(), session(), plaintext(:preauth))
    assert Vault.open(key(), attempt(), session_sealed) == @error
  end

  test "wrong key material and key version including same bytes under another ID deny" do
    {:ok, sealed} = Vault.seal(key(), session(), plaintext(:preauth))
    {:ok, other_material} = Vault.key(key().id, :binary.copy(<<43>>, 32))
    {:ok, other_version} = Vault.key("session-key-v2", key().bytes)
    assert Vault.open(other_material, session(), sealed) == @error
    assert Vault.open(other_version, session(), sealed) == @error
    assert Vault.open(other_version, session(), %{sealed | key_id: other_version.id}) == @error
  end

  test "ciphertext IV and full16-byte tag are authenticated" do
    {:ok, sealed} = Vault.seal(key(), session(), plaintext(:preauth))

    for tampered <- [
          %{sealed | iv: flip(sealed.iv)},
          %{sealed | tag: flip(sealed.tag)},
          %{sealed | ciphertext: flip(sealed.ciphertext)}
        ] do
      assert Vault.open(key(), session(), tampered) == @error
    end

    assert Vault.open(key(), session(), %{sealed | tag: binary_part(sealed.tag, 0, 15)}) == @error
    assert Vault.open(key(), session(), %{sealed | iv: sealed.iv <> <<0>>}) == @error

    assert Vault.open(key(), session(), %{sealed | ciphertext: sealed.ciphertext <> <<0>>}) ==
             @error
  end

  test "unknown or malformed stored fields and ciphertext bounds deny" do
    {:ok, sealed} = Vault.seal(key(), session(), plaintext(:preauth))

    for field <- [:version, :key_id, :iv, :tag, :ciphertext], value <- [nil, 0, [], %{}] do
      assert Vault.open(key(), session(), Map.put(sealed, field, value)) == @error
    end

    for value <- [
          nil,
          %{},
          Map.from_struct(sealed),
          Map.put(sealed, :extra, "secret"),
          %{sealed | version: 2},
          %{sealed | ciphertext: ""},
          %{sealed | ciphertext: :binary.copy(<<0>>, 8193)}
        ] do
      assert Vault.open(key(), session(), value) == @error
    end
  end

  test "closed context rejects unknown missing string and malformed keys" do
    for purpose <- [:preauth, :active, :attempt] do
      c = context(purpose)

      for field <- Map.keys(c) do
        assert Vault.seal(key(), Map.delete(c, field), plaintext(purpose)) == @error
      end

      for value <- [
            nil,
            [],
            Map.put(c, :extra, true),
            Map.new(c, fn {k, v} -> {Atom.to_string(k), v} end)
          ] do
        assert Vault.seal(key(), value, plaintext(purpose)) == @error
      end
    end
  end

  test "positive bounded integers and SQL profile version compatibility" do
    for purpose <- [:preauth, :active, :attempt] do
      c = context(purpose)
      fields = Enum.filter(Map.keys(c), &is_integer(c[&1]))

      for field <- fields, value <- [-1, 0, 1.0, "1", 9_007_199_254_740_992] do
        assert Vault.seal(key(), Map.put(c, field, value), plaintext(purpose)) == @error
      end

      assert Vault.seal(key(), Map.put(c, :profile_version, 2_147_483_648), plaintext(purpose)) ==
               @error
    end

    c = %{session() | epoch: 9_007_199_254_740_991, profile_version: 2_147_483_647}
    assert {:ok, _} = Vault.seal(key(), c, plaintext(:preauth))
  end

  test "identity bounds use exact UTF8 with no NUL and preserve byte distinctions" do
    c = session(:active)

    for {field, limit} <- [
          profile_id: 128,
          principal_id: 128,
          family_id: 128,
          credential_ref: 256
        ] do
      assert {:ok, _} =
               Vault.seal(
                 key(),
                 Map.put(c, field, String.duplicate("a", limit)),
                 plaintext(:active)
               )

      for value <- ["", <<255>>, "a\0b", String.duplicate("a", limit + 1)] do
        assert Vault.seal(key(), Map.put(c, field, value), plaintext(:active)) == @error
      end
    end

    for {field, limit} <- [issuer: 2048, client_id: 256, redirect_uri: 2048] do
      assert {:ok, _} =
               Vault.seal(
                 key(),
                 Map.put(attempt(), field, String.duplicate("a", limit)),
                 plaintext(:attempt)
               )

      assert Vault.seal(
               key(),
               Map.put(attempt(), field, String.duplicate("a", limit + 1)),
               plaintext(:attempt)
             ) == @error
    end

    {:ok, first} = Vault.associated_data(key().id, %{c | principal_id: "ab", family_id: "c"})
    {:ok, second} = Vault.associated_data(key().id, %{c | principal_id: "a", family_id: "bc"})
    refute first == second
  end

  test "preauth must have no linkage and active requires complete linkage" do
    for field <- [:principal_id, :family_id, :credential_ref, :credential_revision] do
      assert Vault.seal(
               key(),
               Map.put(session(), field, session(:active)[field]),
               plaintext(:preauth)
             ) == @error

      assert Vault.seal(key(), Map.put(session(:active), field, nil), plaintext(:active)) ==
               @error
    end
  end

  test "typed envelopes reject other kinds arbitrary maps extra fields refresh and ID tokens" do
    for purpose <- [:preauth, :active, :attempt] do
      for other <- [:preauth, :active, :attempt], purpose != other do
        assert Vault.seal(key(), context(purpose), plaintext(other)) == @error
      end

      for bad <- [
            nil,
            [],
            Map.from_struct(plaintext(purpose)),
            Map.put(plaintext(purpose), :refresh_token, "private"),
            Map.put(plaintext(purpose), :id_token, "private")
          ] do
        assert Vault.seal(key(), context(purpose), bad) == @error
      end
    end
  end

  test "CSRF must match canonical32-byte token and independent digest both directions" do
    for csrf <- [
          nil,
          "",
          String.duplicate("A", 42),
          String.duplicate("A", 44),
          String.duplicate("A", 42) <> "B",
          @verifier
        ] do
      assert Vault.seal(key(), session(), %Preauth{csrf: csrf}) == @error
    end

    raw = <<1, 43::unsigned-big-32, @verifier::binary>>
    assert Vault.open(key(), session(), authenticated(session(), raw)) == @error
    raw = <<1, 43::unsigned-big-32, String.duplicate("A", 42) <> "B"::binary>>
    assert Vault.open(key(), session(), authenticated(session(), raw)) == @error
  end

  test "PKCE verifier and generation reject noncanonical aliases" do
    for value <- [nil, "", String.duplicate("A", 42) <> "B", @verifier <> "="] do
      assert Vault.seal(key(), attempt(), %Verifier{verifier: value}) == @error
      assert Vault.seal(key(), %{session() | generation: value}, plaintext(:preauth)) == @error
    end
  end

  test "access token bounded at4089 bytes and never acts as authentication" do
    c = session(:active)

    assert {:ok, sealed} =
             Vault.seal(key(), c, %Active{csrf: @csrf, access_token: String.duplicate("a", 4089)})

    assert byte_size(sealed.ciphertext) == 4141
    assert {:ok, %Active{access_token: token}} = Vault.open(key(), c, sealed)
    assert byte_size(token) == 4089
    assert {:ok, _} = Vault.seal(key(), c, %Active{csrf: @csrf, access_token: "AZaz09._~+/-=="})

    for token <- [nil, "", String.duplicate("a", 4090), "a b", "a\nb", "a?b", "a=b", "=", <<255>>] do
      assert Vault.seal(key(), c, %Active{csrf: @csrf, access_token: token}) == @error
    end
  end

  test "authenticated unknown kind trailing bytes and incorrect length encodings deny" do
    values = [
      <<>>,
      <<0>>,
      <<4>>,
      <<1, 0, 0, 0, 0>>,
      <<1, 0, 0, 0, 44, @csrf::binary>>,
      <<1, 0, 0, 0, 43, @csrf::binary, 0>>,
      <<3, 0, 0, 0, 43, @verifier::binary>>,
      <<1, 0, 0, 0, 43, @csrf::binary, 0, 0, 0, 1, 1>>
    ]

    for value <- values do
      assert Vault.open(key(), session(), authenticated(session(), value)) == @error
    end

    active = <<2, 0, 0, 0, 43, @csrf::binary, 0, 0, 0, 1, ?a>>

    assert Vault.open(key(), session(:active), authenticated(session(:active), active <> <<0>>)) ==
             @error

    assert Vault.open(
             key(),
             session(:active),
             authenticated(session(:active), <<2, 0, 0, 0, 43, @csrf::binary, 0xFFFFFFFF::32>>)
           ) == @error

    assert Vault.open(
             key(),
             attempt(),
             authenticated(attempt(), <<3, 0, 0, 0, 43, @verifier::binary, 0>>)
           ) == @error
  end

  test "oversized but authenticated plaintext remains unavailable" do
    raw = <<2, 43::32, @csrf::binary, 4090::32, String.duplicate("a", 4090)::binary>>
    assert Vault.open(key(), session(:active), authenticated(session(:active), raw)) == @error

    assert Vault.open(key(), session(), authenticated(session(), :binary.copy(<<1>>, 8192))) ==
             @error
  end

  test "Inspect hides key plaintext ciphertext IV and tag even nested" do
    {:ok, sealed} = Vault.seal(key(), session(), plaintext(:preauth))
    assert inspect(key()) == "#MixerHosted.BrowserAuth.Vault.Key<...>"
    assert inspect(plaintext(:preauth)) == "#MixerHosted.BrowserAuth.Vault.Preauth<...>"
    assert inspect(plaintext(:active)) == "#MixerHosted.BrowserAuth.Vault.Active<...>"
    assert inspect(plaintext(:attempt)) == "#MixerHosted.BrowserAuth.Vault.Verifier<...>"
    rendered = inspect(%{key: key(), values: [plaintext(:active), plaintext(:attempt), sealed]})

    for private <- [
          @csrf,
          @verifier,
          "header.payload.signature",
          "session-key-v1",
          inspect(sealed.iv),
          inspect(sealed.tag)
        ],
        do: refute(String.contains?(rendered, private))
  end

  test "all public malformed key errors are fixed without private text" do
    for bad <- [
          nil,
          %{},
          Map.from_struct(key()),
          Map.put(key(), :extra, "private"),
          %{key() | bytes: "private"}
        ] do
      assert Vault.seal(bad, session(), plaintext(:preauth)) == @error
      assert Vault.open(bad, session(), nil) == @error
    end

    assert Vault.associated_data("private/unsafe", session()) == @error
  end

  test "platform AES256GCM known answer zero key IV and128-bit plaintext" do
    {ciphertext, tag} =
      :crypto.crypto_one_time_aead(:aes_256_gcm, <<0::256>>, <<0::96>>, <<0::128>>, "", 16, true)

    assert Base.encode16(ciphertext, case: :lower) == "cea7403d4d606b6e074ec5d3baf39d18"
    assert Base.encode16(tag, case: :lower) == "d0d1c8a799996bf0265b98b5d48ab919"

    assert :crypto.crypto_one_time_aead(
             :aes_256_gcm,
             <<0::256>>,
             <<0::96>>,
             ciphertext,
             "",
             tag,
             false
           ) == <<0::128>>
  end

  test "official NIST AES256GCM example4 authenticates nonempty plaintext and AAD" do
    key =
      Base.decode16!("feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308",
        case: :lower
      )

    iv = Base.decode16!("cafebabefacedbaddecaf888", case: :lower)

    aad =
      Base.decode16!(
        "3ad77bb40d7a3660a89ecaf32466ef97f5d3d58503b9699de785895a96fdbaaf43b1cd7f598ece23881b00e3ed0306887b0c785e27e8ad3f8223207104725dd4",
        case: :lower
      )

    plaintext =
      Base.decode16!(
        "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255",
        case: :lower
      )

    ciphertext =
      Base.decode16!(
        "522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f662898015ad",
        case: :lower
      )

    tag = Base.decode16!("c06d76f31930fef37acae23ed465ae62", case: :lower)

    assert :crypto.crypto_one_time_aead(:aes_256_gcm, key, iv, plaintext, aad, 16, true) ==
             {ciphertext, tag}

    assert :crypto.crypto_one_time_aead(:aes_256_gcm, key, iv, ciphertext, aad, tag, false) ==
             plaintext

    assert :crypto.crypto_one_time_aead(:aes_256_gcm, key, iv, ciphertext, flip(aad), tag, false) ==
             :error
  end
end

d35e6315e49eb59eacf525a9ac719b60968a8316 blob 21354
defmodule MixerHosted.Builds.AdmissionTest do
  use ExUnit.Case, async: false
  import Ecto.Query
  alias Ecto.Multi
  alias MixerHosted.{Repo, Test.BuildIntentWorker}
  alias MixerHosted.Builds.{Admission, Lifecycle, Record, Storage}
  alias Admission.{Capacity, Lease, Reservation}
  @moduletag :database

  setup_all do
    start_supervised!(
      {Repo,
       hostname: "127.0.0.1",
       port: String.to_integer(System.fetch_env!("MIXER_TEST_DATABASE_PORT")),
       database: "mixer_admission_test",
       username: "mixer_fixture",
       pool_size: 8,
       ssl: false}
    )

    path = Application.app_dir(:mixer_hosted, "priv/repo/migrations")
    assert length(Ecto.Migrator.run(Repo, path, :up, all: true)) == 10
    assert [] == Ecto.Migrator.run(Repo, path, :up, all: true)
    start_supervised!({Oban, repo: Repo, queues: false, plugins: false, testing: :manual})
    :ok
  end

  setup do
    Repo.query!(
      "TRUNCATE mixer_build_coordinator_leases, mixer_build_reservations, mixer_build_capacities, mixer_build_organization_capacities, mixer_build_fleet_platform_capacities, mixer_build_fleet_capacity, mixer_builds, oban_jobs"
    )

    assert {:ok, _} =
             Multi.new()
             |> Admission.configure_fleet_multi(:fleet, :new, 10_000)
             |> Admission.configure_fleet_platform_multi(:ios, %{platform: :ios}, :new, 10_000)
             |> Admission.configure_fleet_platform_multi(
               :android,
               %{platform: :android},
               :new,
               10_000
             )
             |> Admission.configure_organization_multi(
               :org,
               %{organization_id: "org-a"},
               :new,
               10_000
             )
             |> Admission.configure_organization_multi(
               :other_org,
               %{organization_id: "other-org"},
               :new,
               10_000
             )
             |> Repo.transaction()

    :ok
  end

  defp spec(overrides \\ %{}) do
    Map.merge(
      %{
        organization_id: "org-a",
        project_id: "project-a",
        application_id: "app-a",
        build_id: "build-a",
        platform: :ios,
        source: %{
          kind: :revision,
          sha256: String.duplicate("a", 64),
          reference: "repository@commit"
        },
        toolchain_lock_sha256: String.duplicate("b", 64),
        build_definition_sha256: String.duplicate("c", 64)
      },
      overrides
    )
  end

  defp scope(s \\ spec()),
    do: Map.take(s, [:organization_id, :project_id, :application_id, :build_id, :platform])

  defp capacity_scope(s \\ scope()), do: Map.take(s, [:organization_id, :platform])
  defp policy, do: %{max_attempts: 3, timeout_ms: 100_000, retry_backoff_ms: 0}
  defp job(intent), do: BuildIntentWorker.new(intent)

  defp create(s \\ spec(), p \\ policy()) do
    Storage.create_multi(Multi.new(), :created, s, p, "request-#{s.build_id}", 1, &job/1)
    |> Repo.transaction()
  end

  defp configure(s \\ capacity_scope(), revision \\ :new, limit \\ 1) do
    Admission.configure_multi(Multi.new(), :capacity, s, revision, limit) |> Repo.transaction()
  end

  defp claim(s \\ scope(), owner \\ "coordinator-a", ttl \\ 60_000) do
    Admission.claim_multi(Multi.new(), :claim, s, owner, ttl) |> Repo.transaction()
  end

  defp renew(token, ttl \\ 60_000),
    do: Admission.renew_multi(Multi.new(), :renew, token, ttl) |> Repo.transaction()

  defp transition(token, revision, id, event, factory \\ &job/1) do
    Admission.transition_multi(Multi.new(), :build, token, revision, id, event, factory)
    |> Repo.transaction()
  end

  defp release(token, event),
    do: Admission.release_multi(Multi.new(), :release, token, event) |> Repo.transaction()

  defp start_claim(claimed) do
    {:ok, ref} = Lifecycle.worker_ref(claimed.build)

    assert {:ok, %{build: started}} =
             transition(claimed.token, claimed.record.revision, "start", %{type: :start, ref: ref})

    {started, ref}
  end

  defp expire_lease do
    Repo.query!(
      "UPDATE mixer_build_coordinator_leases SET expires_at = timezone('UTC', clock_timestamp()) - interval '1 second'"
    )
  end

  defp failed(ref),
    do: %{
      type: :completed,
      ref: ref,
      result: %{
        outcome: :failed,
        class: :infrastructure,
        code: :worker_lost,
        diagnostic_sha256: String.duplicate("d", 64)
      }
    }

  defp now_ms do
    %{rows: [[now]]} =
      Repo.query!("SELECT floor(extract(epoch FROM clock_timestamp()) * 1000)::bigint")

    now
  end

  test "capacity requires explicit exact configuration with bounded limit and revision CAS" do
    assert {:ok, _} = create()
    assert {:error, :claim, :scope_not_found_or_unconfigured, _} = claim()
    assert {:ok, %{capacity: %{revision: 0, limit: 1}}} = configure()
    assert {:error, :capacity, :capacity_exists, _} = configure()
    assert {:ok, %{capacity: %{revision: 1, limit: 0}}} = configure(capacity_scope(), 0, 0)
    assert {:error, :capacity, :stale_capacity_revision, _} = configure(capacity_scope(), 0, 2)
    assert {:error, :claim, :capacity_exhausted, _} = claim()

    for limit <- [-1, 10_001, 1.0, nil] do
      assert {:error, :capacity, :invalid_capacity_policy, _} =
               configure(capacity_scope(), 1, limit)
    end

    assert Repo.aggregate(Capacity, :count) == 1
    assert Repo.aggregate(Reservation, :count) == 0
  end

  test "simultaneous claims across replicas cannot overbook the last slot" do
    assert {:ok, _} = configure()
    specs = for n <- 1..6, do: spec(%{build_id: "build-#{n}"})
    for s <- specs, do: assert({:ok, _} = create(s))
    parent = self()

    tasks =
      for s <- specs do
        Task.async(fn ->
          send(parent, {:ready, self()})

          receive do
            :go -> claim(scope(s), "owner-#{s.build_id}")
          end
        end)
      end

    for _ <- specs, do: assert_receive({:ready, _}, 1000)
    for task <- tasks, do: send(task.pid, :go)
    results = Enum.map(tasks, &Task.await(&1, 10_000))
    assert Enum.count(results, &match?({:ok, _}, &1)) == 1
    assert Enum.count(results, &match?({:error, :claim, :capacity_exhausted, _}, &1)) == 5
    assert Repo.aggregate(from(r in Reservation, where: r.held), :count) == 1
    assert Repo.aggregate(Lease, :count) == 1
  end

  test "same org/platform shares across projects while other organizations/platforms are independent" do
    a = spec()
    b = spec(%{project_id: "other-project", application_id: "other-app", build_id: "other-build"})
    c = spec(%{organization_id: "other-org"})
    d = spec(%{platform: :android})
    for s <- [a, b, c, d], do: assert({:ok, _} = create(s))
    for s <- [a, c, d], do: assert({:ok, _} = configure(capacity_scope(scope(s))))
    assert {:ok, _} = claim(scope(a))
    assert {:error, :claim, :capacity_exhausted, _} = claim(scope(b))
    assert {:ok, _} = claim(scope(c))
    assert {:ok, _} = claim(scope(d))
    assert Repo.aggregate(Reservation, :count) == 3
  end

  test "shrinking below occupancy or pausing preserves existing reconciliation ownership" do
    assert {:ok, _} = configure(capacity_scope(), :new, 2)
    assert {:ok, _} = create()
    other = spec(%{build_id: "second"})
    assert {:ok, _} = create(other)
    assert {:ok, %{claim: a}} = claim()
    assert {:ok, _} = claim(scope(other))
    assert {:ok, _} = configure(capacity_scope(), 0, 0)
    assert {:ok, %{claim: duplicate}} = claim()
    assert duplicate.token == a.token and duplicate.lease.expires_at == a.lease.expires_at
    expire_lease()
    assert {:ok, %{claim: taken}} = claim(scope(), "replacement")
    assert taken.token.epoch == a.token.epoch + 1
    assert Repo.aggregate(from(r in Reservation, where: r.held), :count) == 2
  end

  test "live duplicate claims never extend leases; renewal is explicit and exclusively fenced" do
    assert {:ok, _} = configure()
    assert {:ok, _} = create()
    assert {:ok, %{claim: a}} = claim()
    assert {:ok, %{claim: same}} = claim(scope(), "coordinator-a", 300_000)
    assert same.outcome == :duplicate and same.lease.expires_at == a.lease.expires_at
    assert {:error, :claim, :lease_held, _} = claim(scope(), "coordinator-b")
    assert {:ok, %{renew: renewed}} = renew(a.token, 300_000)
    assert renewed.token == a.token
    assert DateTime.compare(renewed.lease.expires_at, a.lease.expires_at) == :gt
    assert {:error, :renew, :stale_lease, _} = renew(%{a.token | epoch: a.token.epoch + 1})
    assert {:error, :renew, :stale_lease, _} = renew(%{a.token | owner_id: "coordinator-b"})
  end

  test "expired claims advance epoch even for the same holder and stale tokens cannot revive" do
    assert {:ok, _} = configure()
    assert {:ok, _} = create()
    assert {:ok, %{claim: a}} = claim()
    expire_lease()
    assert {:error, :renew, :stale_lease, _} = renew(a.token)
    assert {:ok, %{claim: b}} = claim()
    assert b.token.epoch == a.token.epoch + 1
    assert {:error, :renew, :stale_lease, _} = renew(a.token)
    expire_lease()
    assert {:ok, %{claim: c}} = claim(scope(), "coordinator-c")
    assert c.token.epoch == b.token.epoch + 1
  end

  test "renew samples the database clock after waiting for the capacity lock" do
    assert {:ok, _} = configure()
    assert {:ok, _} = create()
    assert {:ok, %{claim: a}} = claim()
    parent = self()

    locker =
      Task.async(fn ->
        Repo.transaction(fn ->
          Repo.query!("SELECT * FROM mixer_build_capacities FOR UPDATE")
          send(parent, :locked)

          receive do
            :expire -> :ok
          end

          assert %{rows: [[true]]} =
                   Repo.query!(
                     "UPDATE mixer_build_coordinator_leases SET expires_at = timezone('UTC', clock_timestamp()) + interval '200 milliseconds' RETURNING expires_at > timezone('UTC', clock_timestamp())"
                   )

          Repo.query!("SELECT pg_sleep(0.3)")
        end)
      end)

    assert_receive :locked

    waiter =
      Task.async(fn ->
        Multi.new()
        |> Multi.run(:started, fn repo, _ ->
          repo.query!("SELECT 1")
          send(parent, :waiter_started)
          {:ok, :started}
        end)
        |> Admission.renew_multi(:renew, a.token, 60_000)
        |> Repo.transaction()
      end)

    assert_receive :waiter_started
    send(locker.pid, :expire)
    assert {:ok, _} = Task.await(locker)
    assert {:error, :renew, :stale_lease, _} = Task.await(waiter)
  end

  test "lease timeout and cancellation retain occupancy until matching definitive termination" do
    assert {:ok, _} = configure()
    assert {:ok, _} = create()
    assert {:ok, %{claim: a}} = claim()
    {_started, ref} = start_claim(a)

    assert {:ok, %{build: cancelled}} =
             transition(a.token, 1, "cancel", %{type: :cancel, reason: "stop"})

    assert cancelled.build.state == :cancelling

    assert {:error, :release, :definitive_terminal_evidence_required, _} =
             release(a.token, "cancel")

    expire_lease()
    assert {:ok, %{claim: b}} = claim(scope(), "coordinator-b")
    assert b.build.state == :cancelling and b.reservation.held
    other = spec(%{build_id: "waiting"})
    assert {:ok, _} = create(other)
    assert {:error, :claim, :capacity_exhausted, _} = claim(scope(other))

    assert {:error, {:build, :admission}, :stale_lease, _} =
             transition(a.token, 2, "stopped", %{
               type: :stopped,
               ref: ref,
               diagnostic_sha256: String.duplicate("e", 64)
             })

    assert {:ok, %{build: stopped}} =
             transition(b.token, 2, "stopped", %{
               type: :stopped,
               ref: ref,
               diagnostic_sha256: String.duplicate("e", 64)
             })

    assert stopped.build.state == :cancelled
    assert {:ok, %{release: released}} = release(b.token, "stopped")
    refute released.reservation.held
    assert {:ok, _} = claim(scope(other))
  end

  test "lifecycle deadline expiry stays reconciling and consumes its slot" do
    assert {:ok, _} = configure()
    assert {:ok, _} = create(spec(), %{policy() | timeout_ms: 1})
    assert {:ok, %{claim: a}} = claim()
    {_started, ref} = start_claim(a)
    Repo.query!("SELECT pg_sleep(0.01)")
    assert {:ok, %{build: expired}} = transition(a.token, 1, "expire", %{type: :expire, ref: ref})
    assert expired.build.state == :reconciling

    assert {:error, :release, :definitive_terminal_evidence_required, _} =
             release(a.token, "expire")

    assert Repo.one!(Reservation).held
    assert {:ok, _} = transition(a.token, 2, "complete", failed(ref))
    assert {:ok, _} = release(a.token, "complete")
  end

  test "claim, guarded start and Oban insert roll back as one transaction on a bad job" do
    assert {:ok, _} = configure()
    assert {:ok, %{created: original}} = create()

    multi =
      Admission.claim_multi(Multi.new(), :claim, scope(), "owner", 60_000)
      |> Multi.merge(fn %{claim: a} ->
        {:ok, ref} = Lifecycle.worker_ref(a.build)

        Admission.transition_multi(
          Multi.new(),
          :build,
          a.token,
          0,
          "start",
          %{type: :start, ref: ref},
          fn _ -> :invalid end
        )
      end)

    assert {:error, {:build, :job_changeset}, :invalid_job_changeset, _} = Repo.transaction(multi)
    assert Repo.aggregate(Reservation, :count) == 0 and Repo.aggregate(Lease, :count) == 0
    assert {:ok, %{record: record}} = Storage.read(scope())
    assert record.journal == original.record.journal and Repo.aggregate(Oban.Job, :count) == 1
  end

  test "renewal plus guarded CAS, cancel, completion and later failures roll back atomically" do
    assert {:ok, _} = configure()
    assert {:ok, _} = create()
    assert {:ok, %{claim: a}} = claim()
    {started, ref} = start_claim(a)

    multi =
      Admission.renew_multi(Multi.new(), :renew, a.token, 300_000)
      |> Admission.transition_multi(
        :build,
        a.token,
        0,
        "cancel",
        %{type: :cancel, reason: "stop"},
        &job/1
      )

    assert {:error, :build, :stale_revision, _} = Repo.transaction(multi)
    assert Repo.one!(Lease).expires_at == a.lease.expires_at

    assert {:error, {:build, :job_changeset}, :invalid_job_changeset, _} =
             transition(a.token, 1, "cancel", %{type: :cancel, reason: "stop"}, fn _ ->
               :invalid
             end)

    assert {:error, {:build, :job_changeset}, :invalid_job_changeset, _} =
             transition(a.token, 1, "complete", failed(ref), fn _ -> :invalid end)

    assert {:ok, %{record: record}} = Storage.read(scope())
    assert record.journal == started.record.journal

    multi =
      Admission.transition_multi(Multi.new(), :build, a.token, 1, "complete", failed(ref), &job/1)
      |> Admission.release_multi(:release, a.token, "complete")
      |> Multi.run(:later, fn _, _ -> {:error, :forced} end)

    assert {:error, :later, :forced, _} = Repo.transaction(multi)
    assert Repo.one!(Reservation).held and Repo.one!(Lease).owner_id == "coordinator-a"
    assert {:ok, %{record: record}} = Storage.read(scope())
    assert record.journal == started.record.journal and Repo.aggregate(Oban.Job, :count) == 2
  end

  test "terminal held records can be reclaimed; release/retry never recycles an old lease epoch" do
    assert {:ok, _} = configure()
    assert {:ok, _} = create()
    assert {:ok, %{claim: a}} = claim()
    {_started, ref} = start_claim(a)
    assert {:ok, _} = transition(a.token, 1, "complete", failed(ref))

    assert {:error, {:build, :admission}, :invalid_guarded_event, _} =
             transition(a.token, 2, "retry", %{type: :retry})

    expire_lease()
    assert {:ok, %{claim: b}} = claim(scope(), "replacement")
    assert b.build.state == :failed and b.reservation.held

    assert {:error, :release, :definitive_terminal_evidence_required, _} =
             release(b.token, "start")

    assert {:ok, %{release: released}} = release(b.token, "complete")
    assert released.lease.epoch == b.lease.epoch and released.lease.owner_id == nil
    assert {:error, :claim, :not_queued, _} = claim()
    assert {:error, :renew, :stale_lease, _} = renew(b.token)

    assert {:ok, _} =
             Storage.transition_multi(
               Multi.new(),
               :retry,
               scope(),
               2,
               "retry",
               %{type: :retry},
               now_ms(),
               &job/1
             )
             |> Repo.transaction()

    assert {:ok, %{claim: c}} = claim()
    assert c.token.attempt == 2 and c.token.epoch == b.token.epoch + 1
    assert {:error, :renew, :stale_lease, _} = renew(a.token)
    assert {:error, :release, :stale_lease, _} = release(b.token, "complete")

    assert {:error, :release, :definitive_terminal_evidence_required, _} =
             release(c.token, "complete")
  end

  test "only a replayed never-started queued cancellation can free its admitted slot" do
    assert {:ok, _} = configure()
    assert {:ok, _} = create()
    assert {:ok, %{claim: a}} = claim()
    assert {:ok, _} = transition(a.token, 0, "cancel", %{type: :cancel, reason: "stop"})

    assert {:error, :release, :definitive_terminal_evidence_required, _} =
             release(a.token, "unknown")

    expire_lease()
    assert {:ok, %{claim: b}} = claim(scope(), "new-owner")
    assert b.build.state == :cancelled and b.reservation.held
    assert {:ok, %{release: released}} = release(b.token, "cancel")
    refute released.reservation.held
  end

  test "unknown and malformed scopes, policies and tokens fail closed" do
    assert {:ok, _} = configure()
    assert {:ok, _} = create()
    assert {:ok, %{claim: a}} = claim()

    for key <- [:organization_id, :project_id, :application_id, :build_id, :platform] do
      bad = Map.put(scope(), key, if(key == :platform, do: :android, else: "unknown"))
      assert {:error, :claim, :scope_not_found_or_unconfigured, _} = claim(bad)
      assert {:error, :renew, _, _} = renew(%{a.token | scope: bad})
    end

    for s <- [Map.put(scope(), :role, :owner), Map.put(scope(), :platform, "ios"), %{}, nil] do
      assert {:error, :claim, :invalid_scope, _} = claim(s)
    end

    for ttl <- [0, -1, 300_001, "1000", nil] do
      assert {:error, :claim, :invalid_lease_policy, _} = claim(scope(), "owner", ttl)
      assert {:error, :renew, :invalid_lease_policy, _} = renew(a.token, ttl)
    end

    for token <- [
          %{},
          Map.from_struct(a.token),
          %{a.token | record_id: "bad"},
          %{a.token | attempt: 6}
        ] do
      assert {:error, :renew, :invalid_lease_token, _} = renew(token)
    end

    assert {:error, :renew, :stale_lease, _} = renew(%{a.token | record_id: Ecto.UUID.generate()})
  end

  test "journal/index and reservation attempt/fence corruption cannot be admitted or renewed" do
    assert {:ok, _} = configure()
    assert {:ok, %{created: original}} = create()
    assert {:ok, %{claim: a}} = claim()
    journal = put_in(original.record.journal, ["creation", "spec", "project_id"], "different")
    Repo.update_all(Record, set: [journal: journal])
    assert {:error, :claim, :invalid_journal, _} = claim()
    assert {:error, :renew, :invalid_journal, _} = renew(a.token)
    Repo.update_all(Record, set: [journal: original.record.journal])
    Repo.update_all(Reservation, set: [attempt: 2])
    assert {:error, :claim, :invalid_admission, _} = claim()
    assert {:error, :renew, :invalid_admission, _} = renew(a.token)
    Repo.update_all(Reservation, set: [attempt: 1, worker_fence: 99])
    assert {:error, :claim, :invalid_admission, _} = claim()
  end

  test "a wrong worker reference cannot complete or release the held reservation" do
    assert {:ok, _} = configure()
    assert {:ok, _} = create()
    assert {:ok, %{claim: a}} = claim()
    {_started, ref} = start_claim(a)

    assert {:error, :build, :stale_worker_ref, _} =
             transition(a.token, 1, "wrong", failed(%{ref | fence: ref.fence + 1}))

    assert {:error, :release, :definitive_terminal_evidence_required, _} =
             release(a.token, "wrong")

    assert Repo.one!(Reservation).held
  end

  test "corrupt release evidence blocks readmission and exhausted epochs cannot wrap" do
    assert {:ok, _} = configure()
    assert {:ok, _} = create()
    assert {:ok, %{claim: a}} = claim()
    {_started, ref} = start_claim(a)
    assert {:ok, _} = transition(a.token, 1, "complete", failed(ref))
    assert {:ok, _} = release(a.token, "complete")

    assert {:ok, _} =
             Storage.transition_multi(
               Multi.new(),
               :retry,
               scope(),
               2,
               "retry",
               %{type: :retry},
               now_ms(),
               &job/1
             )
             |> Repo.transaction()

    Repo.update_all(Reservation, set: [terminal_event_id: "start"])
    assert {:error, :claim, :invalid_admission, _} = claim()
    Repo.update_all(Reservation, set: [terminal_event_id: "complete"])
    Repo.update_all(Lease, set: [epoch: 9_223_372_036_854_775_807])
    assert {:error, :claim, :lease_epoch_exhausted, _} = claim()
    refute Repo.one!(Reservation).held
    assert Repo.one!(Lease).epoch == 9_223_372_036_854_775_807
  end
end

3b232322e781c2b2b8f1eec921d32d1e56a9930f blob 30252
defmodule MixerHosted.Builds.AggregateAdmissionTest do
  use ExUnit.Case, async: false
  import Ecto.Query
  alias Ecto.Multi
  alias MixerHosted.{Repo, Test.BuildIntentWorker}
  alias MixerHosted.Builds.{Admission, Lifecycle, Record, Storage}

  alias Admission.{
    Capacity,
    FleetCapacity,
    FleetPlatformCapacity,
    OrganizationCapacity,
    Lease,
    Reservation
  }

  @moduletag :database
  @aggregate_migration 20_261_025_000_002
  @max_int 9_223_372_036_854_775_807

  setup_all do
    start_supervised!(
      {Repo,
       hostname: "127.0.0.1",
       port: String.to_integer(System.fetch_env!("MIXER_TEST_DATABASE_PORT")),
       database: "mixer_aggregate_admission_test",
       username: "mixer_fixture",
       pool_size: 10,
       ssl: false}
    )

    path = Application.app_dir(:mixer_hosted, "priv/repo/migrations")
    assert length(Ecto.Migrator.run(Repo, path, :up, all: true)) == 10
    assert [] == Ecto.Migrator.run(Repo, path, :up, all: true)
    start_supervised!({Oban, repo: Repo, queues: false, plugins: false, testing: :manual})
    :ok
  end

  setup do
    Repo.query!(
      "TRUNCATE mixer_build_coordinator_leases, mixer_build_reservations, mixer_build_capacities, mixer_build_organization_capacities, mixer_build_fleet_platform_capacities, mixer_build_fleet_capacity, mixer_builds, oban_jobs"
    )

    Repo.query!("INSERT INTO mixer_build_fleet_capacity (id) VALUES ('fleet')")

    Repo.query!(
      "INSERT INTO mixer_build_fleet_platform_capacities (platform) VALUES ('ios'), ('android')"
    )

    :ok
  end

  defp spec(overrides \\ %{}),
    do:
      Map.merge(
        %{
          organization_id: "org-a",
          project_id: "project-a",
          application_id: "app-a",
          build_id: "build-a",
          platform: :ios,
          source: %{kind: :revision, sha256: String.duplicate("a", 64), reference: "repo@commit"},
          toolchain_lock_sha256: String.duplicate("b", 64),
          build_definition_sha256: String.duplicate("c", 64)
        },
        overrides
      )

  defp scope(s),
    do: Map.take(s, [:organization_id, :project_id, :application_id, :build_id, :platform])

  defp job(intent), do: BuildIntentWorker.new(intent)
  defp transact(multi), do: Repo.transaction(multi)

  defp create(s) do
    Storage.create_multi(
      Multi.new(),
      :created,
      s,
      %{max_attempts: 3, timeout_ms: 100_000, retry_backoff_ms: 0},
      "request-#{s.build_id}",
      1,
      &job/1
    )
    |> transact()
  end

  defp fleet(limit, revision \\ :new),
    do: Admission.configure_fleet_multi(Multi.new(), :config, revision, limit) |> transact()

  defp platform(p, limit, revision \\ :new),
    do:
      Admission.configure_fleet_platform_multi(
        Multi.new(),
        :config,
        %{platform: p},
        revision,
        limit
      )
      |> transact()

  defp organization(id, limit, revision \\ :new),
    do:
      Admission.configure_organization_multi(
        Multi.new(),
        :config,
        %{organization_id: id},
        revision,
        limit
      )
      |> transact()

  defp pair(s, limit, revision \\ :new),
    do:
      Admission.configure_multi(
        Multi.new(),
        :config,
        Map.take(s, [:organization_id, :platform]),
        revision,
        limit
      )
      |> transact()

  defp configured_multi(specs, limits) do
    limits = Map.merge(%{fleet: 10, platform: 10, organization: 10, pair: 10}, limits)
    multi = Admission.configure_fleet_multi(Multi.new(), :fleet, :new, limits.fleet)

    multi =
      for p <- Enum.uniq(Enum.map(specs, & &1.platform)), reduce: multi do
        multi ->
          Admission.configure_fleet_platform_multi(
            multi,
            {:platform, p},
            %{platform: p},
            :new,
            limits.platform
          )
      end

    multi =
      for id <- Enum.uniq(Enum.map(specs, & &1.organization_id)), reduce: multi do
        multi ->
          Admission.configure_organization_multi(
            multi,
            {:organization, id},
            %{organization_id: id},
            :new,
            limits.organization
          )
      end

    for s <- Enum.uniq_by(specs, &{&1.organization_id, &1.platform}), reduce: multi do
      multi ->
        Admission.configure_multi(
          multi,
          {:pair, s.organization_id, s.platform},
          Map.take(s, [:organization_id, :platform]),
          :new,
          limits.pair
        )
    end
  end

  defp configure_all(specs, limits \\ %{}), do: configured_multi(specs, limits) |> transact()

  defp claim(s, owner \\ "owner"),
    do: Admission.claim_multi(Multi.new(), :claim, scope(s), owner, 60_000) |> transact()

  defp transition(c, revision, id, event),
    do:
      Admission.transition_multi(Multi.new(), :build, c.token, revision, id, event, &job/1)
      |> transact()

  defp release(c, id),
    do: Admission.release_multi(Multi.new(), :release, c.token, id) |> transact()

  defp expire_leases,
    do:
      Repo.query!(
        "UPDATE mixer_build_coordinator_leases SET expires_at = timezone('UTC', clock_timestamp()) - interval '1 second'"
      )

  defp held_count, do: Repo.aggregate(from(r in Reservation, where: r.held), :count)

  defp capacity_snapshot,
    do:
      Enum.map(
        [FleetCapacity, FleetPlatformCapacity, OrganizationCapacity, Capacity],
        &Repo.all/1
      )

  defp start(c) do
    {:ok, ref} = Lifecycle.worker_ref(c.build)
    assert {:ok, _} = transition(c, 0, "start", %{type: :start, ref: ref})
    ref
  end

  defp parallel_claims(specs) do
    parent = self()

    tasks =
      for s <- specs do
        Task.async(fn ->
          send(parent, {:ready, self()})

          receive do
            :go -> claim(s, "owner-#{s.build_id}")
          end
        end)
      end

    for _ <- specs, do: assert_receive({:ready, _}, 1_000)
    for task <- tasks, do: send(task.pid, :go)
    Enum.map(tasks, &Task.await(&1, 10_000))
  end

  test "all four explicit limits are mandatory and migration defaults close new claims" do
    assert %{limit: 0, revision: 0, configured: false} = Repo.one!(FleetCapacity)

    assert Enum.all?(Repo.all(FleetPlatformCapacity), fn c ->
             c.limit == 0 and c.revision == 0 and not c.configured
           end)

    s = spec()
    assert {:ok, _} = create(s)
    assert {:ok, _} = pair(s, 5)
    assert {:error, :claim, :fleet_capacity_unconfigured, _} = claim(s)
    assert {:error, :config, :capacity_unconfigured, _} = fleet(5, 0)
    assert {:ok, _} = fleet(5)
    assert {:error, :claim, :fleet_platform_capacity_unconfigured, _} = claim(s)
    assert {:ok, _} = platform(:ios, 5)
    assert {:error, :claim, :organization_capacity_unconfigured, _} = claim(s)
    assert {:ok, _} = organization(s.organization_id, 0)
    assert {:error, :claim, :organization_capacity_exhausted, _} = claim(s)
    assert held_count() == 0 and Repo.aggregate(Lease, :count) == 0
    assert {:ok, _} = organization(s.organization_id, 5, 0)
    assert {:ok, _} = claim(s)
    assert held_count() == 1
  end

  test "fleet total admits exactly the last slot across organizations and platform pools" do
    specs =
      for n <- 1..8,
          do:
            spec(%{
              organization_id: "org-#{n}",
              build_id: "fleet-#{n}",
              platform: if(rem(n, 2) == 0, do: :ios, else: :android)
            })

    assert {:ok, _} = configure_all(specs, %{fleet: 1})
    for s <- specs, do: assert({:ok, _} = create(s))
    results = parallel_claims(specs)
    assert Enum.count(results, &match?({:ok, _}, &1)) == 1
    assert Enum.count(results, &match?({:error, :claim, :fleet_capacity_exhausted, _}, &1)) == 7
    assert held_count() == 1 and Repo.aggregate(Lease, :count) == 1
  end

  test "organization total admits one cross-platform attempt while another organization proceeds" do
    specs =
      for n <- 1..6,
          do:
            spec(%{build_id: "org-#{n}", platform: if(rem(n, 2) == 0, do: :ios, else: :android)})

    other = spec(%{organization_id: "org-b", build_id: "other"})
    assert {:ok, _} = configure_all([other | specs], %{organization: 1})
    for s <- [other | specs], do: assert({:ok, _} = create(s))
    results = parallel_claims(specs)
    assert Enum.count(results, &match?({:ok, _}, &1)) == 1

    assert Enum.count(results, &match?({:error, :claim, :organization_capacity_exhausted, _}, &1)) ==
             5

    assert {:ok, _} = claim(other)
    assert held_count() == 2
  end

  test "fleet platform last slot spans organizations while the distinct Android pool proceeds" do
    ios =
      for n <- 1..6,
          do: spec(%{organization_id: "org-#{n}", build_id: "ios-#{n}"})

    android = spec(%{organization_id: "org-1", build_id: "android", platform: :android})
    assert {:ok, _} = configure_all([android | ios], %{platform: 1})
    for s <- [android | ios], do: assert({:ok, _} = create(s))
    results = parallel_claims(ios)
    assert Enum.count(results, &match?({:ok, _}, &1)) == 1

    assert Enum.count(
             results,
             &match?({:error, :claim, :fleet_platform_capacity_exhausted, _}, &1)
           ) == 5

    assert {:ok, _} = claim(android)
    assert held_count() == 2
  end

  test "zero at each aggregate level pauses new work without treating missing configuration as unlimited" do
    s = spec()
    assert {:ok, _} = configure_all([s])
    assert {:ok, _} = create(s)
    assert {:ok, _} = fleet(0, 0)
    assert {:error, :claim, :fleet_capacity_exhausted, _} = claim(s)
    assert {:ok, _} = fleet(10, 1)
    assert {:ok, _} = platform(:ios, 0, 0)
    assert {:error, :claim, :fleet_platform_capacity_exhausted, _} = claim(s)
    assert {:ok, _} = platform(:ios, 10, 1)
    assert {:ok, _} = organization(s.organization_id, 0, 0)
    assert {:error, :claim, :organization_capacity_exhausted, _} = claim(s)
    assert held_count() == 0
  end

  test "all policy APIs use bounded exact CAS and one-time activation" do
    s = spec()

    apis = [
      fn revision, limit -> fleet(limit, revision) end,
      fn revision, limit -> platform(:ios, limit, revision) end,
      fn revision, limit -> organization(s.organization_id, limit, revision) end,
      fn revision, limit -> pair(s, limit, revision) end
    ]

    for api <- apis do
      assert {:error, :config, :capacity_unconfigured, _} = api.(0, 5)
      assert {:ok, %{config: %{revision: 0, limit: 10_000}}} = api.(:new, 10_000)
      assert {:error, :config, :capacity_exists, _} = api.(:new, 1)
      assert {:ok, %{config: %{revision: 1, limit: 0}}} = api.(0, 0)
      assert {:error, :config, :stale_capacity_revision, _} = api.(0, 5)

      for invalid <- [-1, 10_001, 1.0, nil, "5"] do
        assert {:error, :config, :invalid_capacity_policy, _} = api.(1, invalid)
      end

      for invalid <- [-1, @max_int, 1.0, nil, "0", :initial] do
        assert {:error, :config, :invalid_capacity_policy, _} = api.(invalid, 5)
      end
    end

    before = capacity_snapshot()

    for bad <- [%{}, %{platform: "ios"}, %{platform: :other}, %{platform: :ios, extra: true}, nil] do
      assert {:error, :bad, :invalid_scope, _} =
               Admission.configure_fleet_platform_multi(Multi.new(), :bad, bad, :new, 1)
               |> transact()
    end

    for bad <- [%{}, %{organization_id: ""}, %{organization_id: "a", extra: true}, nil] do
      assert {:error, :bad, :invalid_scope, _} =
               Admission.configure_organization_multi(Multi.new(), :bad, bad, :new, 1)
               |> transact()
    end

    assert capacity_snapshot() == before
  end

  test "concurrent fleet configuration CAS has one winner" do
    assert {:ok, _} = fleet(1)
    parent = self()

    tasks =
      for limit <- 2..7 do
        Task.async(fn ->
          send(parent, {:ready, self()})

          receive do
            :go -> fleet(limit, 0)
          end
        end)
      end

    for _ <- tasks, do: assert_receive({:ready, _}, 1_000)
    for t <- tasks, do: send(t.pid, :go)
    results = Enum.map(tasks, &Task.await(&1, 10_000))
    assert Enum.count(results, &match?({:ok, _}, &1)) == 1
    assert Enum.count(results, &match?({:error, :config, :stale_capacity_revision, _}, &1)) == 5
    assert Repo.one!(FleetCapacity).revision == 1
  end

  test "unsupported transaction snapshots fail closed before configuration or held mutation" do
    s = spec()
    assert {:ok, _} = configure_all([s])
    assert {:ok, _} = create(s)
    assert {:ok, %{claim: c}} = claim(s)
    before = {capacity_snapshot(), Repo.one!(Reservation), Repo.one!(Lease)}

    for isolation <- ["REPEATABLE READ", "SERIALIZABLE", "READ UNCOMMITTED"] do
      prefix =
        Multi.run(Multi.new(), :isolation, fn repo, _ ->
          repo.query!("SET TRANSACTION ISOLATION LEVEL " <> isolation)
          {:ok, isolation}
        end)

      assert {:error, :claim, :unsupported_admission_isolation, _} =
               Admission.claim_multi(prefix, :claim, scope(s), "owner", 60_000) |> transact()

      assert {:error, :fleet, :unsupported_admission_isolation, _} =
               Admission.configure_fleet_multi(prefix, :fleet, 0, 0) |> transact()

      assert {:error, :pair, :unsupported_admission_isolation, _} =
               Admission.configure_multi(
                 prefix,
                 :pair,
                 Map.take(s, [:organization_id, :platform]),
                 0,
                 0
               )
               |> transact()

      assert {:error, :renew, :unsupported_admission_isolation, _} =
               Admission.renew_multi(prefix, :renew, c.token, 60_000) |> transact()
    end

    assert {capacity_snapshot(), Repo.one!(Reservation), Repo.one!(Lease)} == before
  end

  test "lowering all limits below held occupancy preserves uncertain workers and exact release" do
    s = spec()
    waiting = spec(%{build_id: "waiting", organization_id: "org-b", platform: :android})
    assert {:ok, _} = configure_all([s, waiting], %{fleet: 1})
    for value <- [s, waiting], do: assert({:ok, _} = create(value))
    assert {:ok, %{claim: a}} = claim(s)
    ref = start(a)
    assert {:ok, _} = transition(a, 1, "cancel", %{type: :cancel, reason: "stop"})
    assert {:ok, _} = fleet(0, 0)
    assert {:ok, _} = platform(:ios, 0, 0)
    assert {:ok, _} = organization(s.organization_id, 0, 0)
    assert {:ok, _} = pair(s, 0, 0)
    assert {:ok, %{claim: duplicate}} = claim(s)
    assert duplicate.token == a.token and duplicate.lease.expires_at == a.lease.expires_at
    assert {:ok, _} = Admission.renew_multi(Multi.new(), :renew, a.token, 60_000) |> transact()
    assert {:error, :release, :definitive_terminal_evidence_required, _} = release(a, "cancel")
    expire_leases()
    assert {:ok, %{claim: b}} = claim(s, "replacement")
    assert b.token.epoch == a.token.epoch + 1
    assert b.build.state == :cancelling and b.build.active_ref == ref and held_count() == 1
    assert {:error, :claim, :fleet_capacity_exhausted, _} = claim(waiting)
    assert {:error, :release, :stale_lease, _} = release(a, "stopped")

    assert {:ok, _} =
             transition(b, 2, "stopped", %{
               type: :stopped,
               ref: ref,
               diagnostic_sha256: String.duplicate("e", 64)
             })

    assert {:ok, _} = release(b, "stopped")
    assert held_count() == 0
    assert {:error, :claim, :fleet_capacity_exhausted, _} = claim(waiting)
    assert {:ok, _} = fleet(1, 1)
    assert {:ok, _} = claim(waiting)
    assert held_count() == 1
  end

  test "missing aggregate parent rows cannot prevent held reconciliation or manufacture another slot" do
    s = spec()
    waiting = spec(%{build_id: "waiting"})
    assert {:ok, _} = configure_all([s, waiting])
    for value <- [s, waiting], do: assert({:ok, _} = create(value))
    assert {:ok, %{claim: a}} = claim(s)
    ref = start(a)

    for schema <- [FleetCapacity, FleetPlatformCapacity, OrganizationCapacity],
        do: Repo.delete_all(schema)

    assert {:error, :claim, :fleet_capacity_unconfigured, _} = claim(waiting)
    assert {:ok, _} = Admission.renew_multi(Multi.new(), :renew, a.token, 60_000) |> transact()
    assert {:ok, _} = Admission.yield_multi(Multi.new(), :yield, a.token) |> transact()
    assert {:ok, %{claim: b}} = claim(s, "new-owner")
    assert b.token.epoch == a.token.epoch + 1 and held_count() == 1

    assert {:ok, _} =
             transition(b, 1, "complete", %{
               type: :completed,
               ref: ref,
               result: %{
                 outcome: :failed,
                 class: :infrastructure,
                 code: :worker_lost,
                 diagnostic_sha256: String.duplicate("d", 64)
               }
             })

    assert {:ok, _} = release(b, "complete")
    assert held_count() == 0

    assert {:ok, _} =
             Admission.retry_multi(Multi.new(), :retry, scope(s), 2, "retry", &job/1)
             |> transact()

    assert {:error, :claim, :fleet_capacity_unconfigured, _} = claim(s)
    assert Repo.one!(Reservation).attempt == 1
  end

  test "migration down and up preserves an existing held worker and closes only new admission" do
    s = spec()
    waiting = spec(%{build_id: "upgrade-waiting"})
    assert {:ok, _} = configure_all([s, waiting])
    for value <- [s, waiting], do: assert({:ok, _} = create(value))
    assert {:ok, %{claim: a}} = claim(s)
    ref = start(a)
    assert {:ok, _} = transition(a, 1, "cancel", %{type: :cancel, reason: "stop"})
    before = {Repo.one!(Reservation), Repo.one!(Lease), Repo.get!(Record, a.record.id)}
    path = Application.app_dir(:mixer_hosted, "priv/repo/migrations")

    assert [
             20_261_025_000_008,
             20_261_025_000_007,
             20_261_025_000_006,
             20_261_025_000_005,
             20_261_025_000_004,
             20_261_025_000_003,
             @aggregate_migration
           ] = Ecto.Migrator.run(Repo, path, :down, step: 7)

    assert %{rows: [[nil]]} =
             Repo.query!("SELECT to_regclass('public.mixer_build_fleet_capacity')::text")

    assert {Repo.one!(Reservation), Repo.one!(Lease), Repo.get!(Record, a.record.id)} == before

    assert [
             @aggregate_migration,
             20_261_025_000_003,
             20_261_025_000_004,
             20_261_025_000_005,
             20_261_025_000_006,
             20_261_025_000_007,
             20_261_025_000_008
           ] = Ecto.Migrator.run(Repo, path, :up, all: true)

    assert {Repo.one!(Reservation), Repo.one!(Lease), Repo.get!(Record, a.record.id)} == before
    assert %{configured: false, limit: 0, revision: 0} = Repo.one!(FleetCapacity)
    assert %{configured: false, limit: 0, revision: 0} = Repo.one!(OrganizationCapacity)
    assert {:error, :claim, :fleet_capacity_unconfigured, _} = claim(waiting)
    expire_leases()
    assert {:ok, %{claim: b}} = claim(s, "after-upgrade")
    assert b.build.active_ref == ref and held_count() == 1

    assert {:ok, _} =
             transition(b, 2, "stop-after-upgrade", %{
               type: :stopped,
               ref: ref,
               diagnostic_sha256: String.duplicate("e", 64)
             })

    assert {:ok, _} = release(b, "stop-after-upgrade")
    assert held_count() == 0
    assert {:ok, _} = fleet(1)
    assert {:ok, _} = platform(:ios, 1)
    assert {:ok, _} = organization(s.organization_id, 1)
    assert {:ok, _} = claim(waiting)
  end

  test "first configuration from completely missing parents serializes a waiting fresh claim" do
    s = spec()
    assert {:ok, _} = create(s)
    for schema <- [FleetCapacity, FleetPlatformCapacity], do: Repo.delete_all(schema)
    assert {:error, :claim, :scope_not_found_or_unconfigured, _} = claim(s)
    parent = self()

    configurator =
      Task.async(fn ->
        configured_multi([s], %{fleet: 1, platform: 1, organization: 1, pair: 1})
        |> Multi.run(:hold, fn _, _ ->
          send(parent, :configuration_locked)

          receive do
            :commit -> {:ok, :committed}
          end
        end)
        |> transact()
      end)

    assert_receive :configuration_locked

    waiter =
      Task.async(fn ->
        Multi.new()
        |> Multi.run(:began, fn repo, _ ->
          repo.query!("SELECT 1")
          send(parent, :claim_began)
          {:ok, :began}
        end)
        |> Admission.claim_multi(:claim, scope(s), "waiter", 60_000)
        |> Multi.run(:admitted, fn _, _ ->
          send(parent, :claim_admitted)
          {:ok, :admitted}
        end)
        |> transact()
      end)

    assert_receive :claim_began
    refute_receive :claim_admitted, 100
    send(configurator.pid, :commit)
    assert {:ok, _} = Task.await(configurator)
    assert {:ok, _} = Task.await(waiter)
    assert_receive :claim_admitted
    assert held_count() == 1
    assert Repo.one!(FleetCapacity).configured
  end

  test "recreating deleted parents counts existing workers before admitting a waiting organization" do
    a = spec()
    b = spec(%{organization_id: "org-b", build_id: "waiting", platform: :android})
    assert {:ok, _} = configure_all([a, b])
    for s <- [a, b], do: assert({:ok, _} = create(s))
    assert {:ok, %{claim: held}} = claim(a, "owner-#{a.build_id}")

    for schema <- [FleetCapacity, FleetPlatformCapacity, OrganizationCapacity],
        do: Repo.delete_all(schema)

    assert {:ok, _} =
             Multi.new()
             |> Admission.configure_fleet_multi(:fleet, :new, 1)
             |> Admission.configure_fleet_platform_multi(:ios, %{platform: :ios}, :new, 1)
             |> Admission.configure_fleet_platform_multi(:android, %{platform: :android}, :new, 1)
             |> Admission.configure_organization_multi(:a, %{organization_id: "org-a"}, :new, 1)
             |> Admission.configure_organization_multi(:b, %{organization_id: "org-b"}, :new, 1)
             |> transact()

    results = parallel_claims([a, b])
    assert [{:ok, %{claim: duplicate}}, {:error, :claim, :fleet_capacity_exhausted, _}] = results
    assert duplicate.token == held.token and held_count() == 1
  end

  test "configuration and claim in one Multi roll back every limit and occupancy on later failure" do
    s = spec()
    assert {:ok, _} = create(s)
    before = capacity_snapshot()

    assert {:error, :later, :forced, _} =
             configured_multi([s], %{fleet: 1, platform: 1, organization: 1, pair: 1})
             |> Admission.claim_multi(:claim, scope(s), "owner", 60_000)
             |> Multi.run(:later, fn _, _ -> {:error, :forced} end)
             |> transact()

    assert capacity_snapshot() == before
    assert held_count() == 0 and Repo.aggregate(Lease, :count) == 0
    assert {:ok, _} = configure_all([s], %{fleet: 1, platform: 1, organization: 1, pair: 1})
    assert {:ok, _} = claim(s)
  end

  test "configuration CAS failure rolls preceding aggregate changes back" do
    s = spec()
    assert {:ok, _} = configure_all([s])
    before = capacity_snapshot()

    assert {:error, :pair, :stale_capacity_revision, _} =
             Multi.new()
             |> Admission.configure_fleet_multi(:fleet, 0, 0)
             |> Admission.configure_fleet_platform_multi(:platform, %{platform: :ios}, 0, 0)
             |> Admission.configure_organization_multi(:org, %{organization_id: "org-a"}, 0, 0)
             |> Admission.configure_multi(:pair, Map.take(s, [:organization_id, :platform]), 1, 0)
             |> transact()

    assert capacity_snapshot() == before
  end

  test "claim and lifecycle insert failure returns the same last slot without changing limits" do
    s = spec()
    assert {:ok, _} = configure_all([s], %{fleet: 1, platform: 1, organization: 1, pair: 1})
    assert {:ok, %{created: original}} = create(s)
    before = capacity_snapshot()

    multi =
      Admission.claim_multi(Multi.new(), :claim, scope(s), "owner", 60_000)
      |> Multi.merge(fn %{claim: c} ->
        {:ok, ref} = Lifecycle.worker_ref(c.build)

        Admission.transition_multi(
          Multi.new(),
          :start,
          c.token,
          0,
          "start",
          %{type: :start, ref: ref},
          fn _ -> :invalid end
        )
      end)

    assert {:error, {:start, :job_changeset}, :invalid_job_changeset, _} = transact(multi)
    assert capacity_snapshot() == before
    assert Repo.get!(Record, original.record.id) == original.record
    assert held_count() == 0 and Repo.aggregate(Lease, :count) == 0
    assert Repo.aggregate(Oban.Job, :count) == 1
    assert {:ok, _} = claim(s)
  end

  test "guarded terminal release and all-limit shrink roll back together after a later failure" do
    s = spec()
    assert {:ok, _} = configure_all([s], %{fleet: 1, platform: 1, organization: 1, pair: 1})
    assert {:ok, _} = create(s)
    assert {:ok, %{claim: c}} = claim(s)
    before = {capacity_snapshot(), Repo.one!(Reservation), Repo.one!(Lease), Repo.one!(Record)}

    assert {:error, :later, :forced, _} =
             Multi.new()
             |> Admission.transition_multi(
               :cancel,
               c.token,
               0,
               "cancel",
               %{type: :cancel, reason: "stop"},
               &job/1
             )
             |> Admission.release_multi(:release, c.token, "cancel")
             |> Admission.configure_fleet_multi(:fleet, 0, 0)
             |> Admission.configure_fleet_platform_multi(:platform, %{platform: :ios}, 0, 0)
             |> Admission.configure_organization_multi(:org, %{organization_id: "org-a"}, 0, 0)
             |> Admission.configure_multi(:pair, Map.take(s, [:organization_id, :platform]), 0, 0)
             |> Multi.run(:later, fn _, _ -> {:error, :forced} end)
             |> transact()

    assert {capacity_snapshot(), Repo.one!(Reservation), Repo.one!(Lease), Repo.one!(Record)} ==
             before

    assert held_count() == 1 and Repo.aggregate(Oban.Job, :count) == 1
  end

  test "opposite configuration fragment orders after claims cannot deadlock" do
    a = spec()
    b = spec(%{organization_id: "org-b", build_id: "other", platform: :android})
    assert {:ok, _} = configure_all([a, b])
    for s <- [a, b], do: assert({:ok, _} = create(s))
    parent = self()

    tasks =
      for {s, other} <- [{a, b}, {b, a}] do
        Task.async(fn ->
          send(parent, {:ready, self()})

          receive do
            :go -> :ok
          end

          Admission.claim_multi(Multi.new(), :claim, scope(s), "owner", 60_000)
          |> Admission.configure_multi(
            :other_pair,
            Map.take(other, [:organization_id, :platform]),
            0,
            5
          )
          |> Admission.configure_organization_multi(
            :other_org,
            %{organization_id: other.organization_id},
            0,
            5
          )
          |> transact()
        end)
      end

    for _ <- tasks, do: assert_receive({:ready, _}, 1_000)
    for t <- tasks, do: send(t.pid, :go)
    for t <- tasks, do: assert({:ok, _} = Task.await(t, 10_000))
    assert held_count() == 2
  end

  test "database lease clock advances while waiting for the fleet row lock" do
    s = spec()
    assert {:ok, _} = configure_all([s])
    assert {:ok, _} = create(s)
    assert {:ok, %{claim: c}} = claim(s)
    parent = self()

    locker =
      Task.async(fn ->
        Repo.transaction(fn ->
          Repo.query!("SELECT * FROM mixer_build_fleet_capacity FOR UPDATE")
          send(parent, :locked)

          receive do
            :expire -> :ok
          end

          assert %{rows: [[true]]} =
                   Repo.query!(
                     "UPDATE mixer_build_coordinator_leases SET expires_at = timezone('UTC', clock_timestamp()) + interval '200 milliseconds' RETURNING expires_at > timezone('UTC', clock_timestamp())"
                   )

          Repo.query!("SELECT pg_sleep(0.3)")
        end)
      end)

    assert_receive :locked

    waiter =
      Task.async(fn ->
        Multi.new()
        |> Multi.run(:began, fn repo, _ ->
          repo.query!("SELECT 1")
          send(parent, :waiter_began)
          {:ok, :began}
        end)
        |> Admission.renew_multi(:renew, c.token, 60_000)
        |> transact()
      end)

    assert_receive :waiter_began
    send(locker.pid, :expire)
    assert {:ok, _} = Task.await(locker)
    assert {:error, :renew, :stale_lease, _} = Task.await(waiter)
    assert held_count() == 1
  end

  test "migration enforces aggregate identities, closed defaults, integer bounds and CAS exhaustion" do
    invalid = [
      "INSERT INTO mixer_build_fleet_capacity (id) VALUES ('other')",
      "INSERT INTO mixer_build_fleet_platform_capacities (platform) VALUES ('other')",
      "INSERT INTO mixer_build_organization_capacities (organization_id) VALUES ('')",
      "INSERT INTO mixer_build_organization_capacities (organization_id) VALUES (repeat('a', 129))",
      "UPDATE mixer_build_fleet_capacity SET \"limit\" = -1, configured = true",
      "UPDATE mixer_build_fleet_capacity SET \"limit\" = 10001, configured = true",
      "UPDATE mixer_build_fleet_capacity SET revision = -1",
      "UPDATE mixer_build_fleet_capacity SET \"limit\" = 1",
      "UPDATE mixer_build_fleet_capacity SET revision = 1",
      "UPDATE mixer_build_fleet_capacity SET configured = NULL",
      "UPDATE mixer_build_fleet_platform_capacities SET \"limit\" = 10001, configured = true",
      "INSERT INTO mixer_build_organization_capacities (organization_id, \"limit\", configured) VALUES ('bad', 10001, true)"
    ]

    for sql <- invalid do
      assert {:error, %Postgrex.Error{postgres: %{code: code}}} = Repo.query(sql)
      assert code in [:check_violation, :not_null_violation]
    end

    assert {:ok, _} = fleet(1)
    Repo.query!("UPDATE mixer_build_fleet_capacity SET revision = $1", [@max_int - 1])
    assert {:ok, %{config: %{revision: @max_int}}} = fleet(0, @max_int - 1)
    assert {:error, :config, :invalid_capacity_policy, _} = fleet(1, @max_int)
    assert Repo.one!(FleetCapacity).revision == @max_int

    assert {:error, %Postgrex.Error{postgres: %{code: :numeric_value_out_of_range}}} =
             Repo.query("UPDATE mixer_build_fleet_capacity SET revision = revision + 1")
  end
end

deca1839a03db6adad7088fa1656dd5e84559722 blob 21500
defmodule MixerHosted.Builds.CoordinatorTest do
  use ExUnit.Case, async: false
  import Ecto.Query
  alias Ecto.Multi
  alias MixerHosted.Repo
  alias MixerHosted.Builds.{Admission, Coordinator, Dispatch, Storage}
  alias MixerHosted.Test.BuildDispatchFixture, as: Fixture
  alias Admission.{Lease, Reservation}
  @moduletag :database

  setup_all do
    start_supervised!(
      {Repo,
       hostname: "127.0.0.1",
       port: String.to_integer(System.fetch_env!("MIXER_TEST_DATABASE_PORT")),
       database: "mixer_coordinator_test",
       username: "mixer_fixture",
       pool_size: 8,
       ssl: false}
    )

    path = Application.app_dir(:mixer_hosted, "priv/repo/migrations")
    assert length(Ecto.Migrator.run(Repo, path, :up, all: true)) == 10
    start_supervised!({Oban, repo: Repo, queues: false, plugins: false, testing: :manual})
    start_supervised!(Fixture)
    :ok
  end

  setup do
    Repo.query!(
      "TRUNCATE mixer_build_coordinator_leases, mixer_build_reservations, mixer_build_capacities, mixer_build_organization_capacities, mixer_build_fleet_platform_capacities, mixer_build_fleet_capacity, mixer_builds, oban_jobs"
    )

    assert {:ok, _} =
             Multi.new()
             |> Admission.configure_fleet_multi(:fleet, :new, 1)
             |> Admission.configure_fleet_platform_multi(
               :platform,
               %{platform: :android},
               :new,
               1
             )
             |> Admission.configure_organization_multi(:org, %{organization_id: "org-c"}, :new, 1)
             |> Repo.transaction()

    Fixture.reset()
    previous = Application.get_env(:mixer_hosted, :build_dispatch)

    Application.put_env(:mixer_hosted, :build_dispatch,
      adapter: Fixture,
      lease_ttl_ms: 3_000,
      call_timeout_ms: 100,
      poll_ms: 1
    )

    on_exit(fn ->
      if previous == nil,
        do: Application.delete_env(:mixer_hosted, :build_dispatch),
        else: Application.put_env(:mixer_hosted, :build_dispatch, previous)
    end)

    :ok
  end

  defp spec,
    do: %{
      organization_id: "org-c",
      project_id: "project-c",
      application_id: "app-c",
      build_id: "build-c",
      platform: :android,
      source: %{kind: :revision, sha256: String.duplicate("a", 64), reference: "repo@immutable"},
      toolchain_lock_sha256: String.duplicate("b", 64),
      build_definition_sha256: String.duplicate("c", 64)
    }

  defp scope,
    do: Map.take(spec(), [:organization_id, :project_id, :application_id, :build_id, :platform])

  defp create(policy \\ %{max_attempts: 2, timeout_ms: 100_000, retry_backoff_ms: 0}) do
    assert {:ok, _} =
             Admission.configure_multi(
               Multi.new(),
               :capacity,
               Map.take(scope(), [:organization_id, :platform]),
               :new,
               1
             )
             |> Repo.transaction()

    assert {:ok, changes} =
             Storage.create_multi(
               Multi.new(),
               :create,
               spec(),
               policy,
               "coordinator-request",
               1,
               &Coordinator.new/1
             )
             |> Repo.transaction()

    changes[{:create, :job}]
  end

  defp latest_job, do: Repo.one!(from(j in Oban.Job, order_by: [desc: j.id], limit: 1))

  defp current do
    {:ok, current} = Storage.read(scope())
    current
  end

  defp expire_lease,
    do:
      Repo.query!(
        "UPDATE mixer_build_coordinator_leases SET expires_at = timezone('UTC', clock_timestamp()) - interval '1 second'"
      )

  defp running do
    created = create()
    assert :ok = Coordinator.perform(created)
    started = latest_job()
    assert started.args["kind"] == "start"
    expire_lease()
    {created, started}
  end

  defp cancel do
    c = current()

    assert {:ok, _} =
             Storage.cancel_multi(
               Multi.new(),
               :cancel,
               scope(),
               c.record.revision,
               "cancel-request",
               "operator requested",
               now_ms(),
               &Coordinator.new/1
             )
             |> Repo.transaction()

    latest_job()
  end

  defp now_ms do
    %{rows: [[now]]} =
      Repo.query!("SELECT floor(extract(epoch FROM clock_timestamp()) * 1000)::bigint")

    now
  end

  defp failure(class \\ :infrastructure),
    do: %{
      outcome: :failed,
      class: class,
      code: if(class == :infrastructure, do: :worker_lost, else: :compiler_error),
      diagnostic_sha256: String.duplicate("f", 64)
    }

  defp held?, do: Repo.one!(Reservation).held
  defp operation, do: Fixture.snapshot().operations |> Map.keys() |> hd()

  test "strict closed arguments and unavailable default cannot reserve or dispatch" do
    created = create()

    for args <- [
          Map.put(created.args, "extra", true),
          Map.put(created.args, "revision", "0"),
          Map.put(created.args, "platform", "other"),
          Map.put(created.args, "kind", "shell")
        ] do
      assert {:cancel, :invalid_build_intent} = Coordinator.perform(%{created | args: args})
    end

    Application.delete_env(:mixer_hosted, :build_dispatch)
    assert {:error, :dispatch_unavailable} = Coordinator.perform(created)
    assert Repo.aggregate(Reservation, :count) == 0
    assert Fixture.snapshot().calls == []
  end

  test "exact job kind is bound to latest journal event and forged old scope cannot act" do
    created = create()

    for args <- [
          Map.put(created.args, "kind", "start"),
          Map.put(created.args, "build_record_id", Ecto.UUID.generate())
        ] do
      assert :ok = Coordinator.perform(%{created | args: args})
    end

    assert {:cancel, :build_not_found} =
             Coordinator.perform(%{
               created
               | args: Map.put(created.args, "project_id", "foreign")
             })

    assert Repo.aggregate(Reservation, :count) == 0
  end

  test "queued intent commits start and actual coordinator intent before external effects" do
    created = create()
    assert :ok = Coordinator.perform(created)
    assert current().build.state == :running
    assert latest_job().worker == "MixerHosted.Builds.Coordinator"
    assert Fixture.snapshot().calls == []
    assert held?()
    assert :ok = Coordinator.perform(created)
    assert Fixture.snapshot().calls == []
    assert {:snooze, 1} = Coordinator.perform(latest_job())
    assert Fixture.snapshot().creations == 1

    for call <- Fixture.snapshot().calls do
      assert call.visibility == %{state: :running, revision: 1, transaction?: false}
    end
  end

  test "yield expires coordination only, preserves capacity, fences old owner and rolls back atomically" do
    create()

    assert {:ok, %{claim: claimed}} =
             Admission.claim_multi(Multi.new(), :claim, scope(), "first", 30_000)
             |> Repo.transaction()

    before = Repo.one!(Lease)

    assert {:error, :later, :rollback, _} =
             Admission.yield_multi(Multi.new(), :yield, claimed.token)
             |> Multi.run(:later, fn _, _ -> {:error, :rollback} end)
             |> Repo.transaction()

    assert Repo.one!(Lease) == before and held?()

    assert {:ok, %{yield: yielded}} =
             Admission.yield_multi(Multi.new(), :yield, claimed.token) |> Repo.transaction()

    assert yielded.token == nil and yielded.reservation.held
    assert yielded.lease.owner_id == before.owner_id and yielded.lease.epoch == before.epoch
    assert DateTime.to_unix(yielded.lease.expires_at, :millisecond) == yielded.now_ms

    assert {:error, :yield, :stale_lease, _} =
             Admission.yield_multi(Multi.new(), :yield, claimed.token) |> Repo.transaction()

    assert {:ok, %{claim: taken}} =
             Admission.claim_multi(Multi.new(), :claim, scope(), "next", 30_000)
             |> Repo.transaction()

    assert taken.token.epoch == claimed.token.epoch + 1 and held?()

    assert {:error, :yield, :stale_lease, _} =
             Admission.yield_multi(Multi.new(), :yield, claimed.token) |> Repo.transaction()
  end

  test "crash after ensure and coordinator transfer query same operation without second execution" do
    {created, started} = running()
    Fixture.mode(:ensure_started, :raise_after)
    assert {:snooze, 1} = Coordinator.perform(started)
    first = Fixture.snapshot()
    request = List.last(first.calls).request
    lease = Repo.one!(Lease)
    assert first.creations == 1 and held?()
    assert :ok = Coordinator.perform(created)
    assert Fixture.snapshot().creations == 1
    expire_lease()
    assert {:snooze, 1} = Coordinator.perform(started)
    next = Fixture.snapshot()
    assert next.creations == 1 and map_size(next.operations) == 1
    assert Repo.one!(Lease).epoch == lease.epoch + 1
    assert List.last(next.calls).request.operation_id == request.operation_id
    assert List.last(next.calls).request.ref == request.ref
    assert {:error, :stale} = Fixture.ensure_started(request)
    assert held?()
  end

  test "callback timeout after external effect kills transport process and retains reservation" do
    {_, started} = running()
    Fixture.mode(:ensure_started, :timeout_after)
    before = System.monotonic_time(:millisecond)
    assert {:snooze, 1} = Coordinator.perform(started)
    assert System.monotonic_time(:millisecond) - before < 2_000
    assert held?() and Fixture.snapshot().creations == 1
    expire_lease()
    assert {:snooze, 1} = Coordinator.perform(started)
    assert Fixture.snapshot().creations == 1
  end

  test "abrupt coordinator death after modeled effect retains lease and redelivery cannot execute twice" do
    {_, started} = running()

    Application.put_env(:mixer_hosted, :build_dispatch,
      adapter: Fixture,
      lease_ttl_ms: 3_000,
      call_timeout_ms: 1_000,
      poll_ms: 1
    )

    Fixture.mode(:ensure_started, {:block_after, self()})
    {pid, monitor} = spawn_monitor(fn -> Coordinator.perform(started) end)
    assert_receive {:dispatch_blocked, transport}, 1_000
    transport_monitor = Process.monitor(transport)
    assert Fixture.snapshot().creations == 1 and held?()
    lease = Repo.one!(Lease)
    Process.exit(pid, :kill)
    assert_receive {:DOWN, ^monitor, :process, ^pid, :killed}, 1_000
    assert_receive {:DOWN, ^transport_monitor, :process, ^transport, :killed}, 1_000
    assert Repo.one!(Lease) == lease and held?()
    assert {:snooze, 1} = Coordinator.perform(started)
    assert Fixture.snapshot().creations == 1
    expire_lease()
    assert {:snooze, 1} = Coordinator.perform(started)
    assert Repo.one!(Lease).epoch == lease.epoch + 1
    assert Fixture.snapshot().creations == 1 and map_size(Fixture.snapshot().operations) == 1
  end

  test "unavailable and mismatched observations never release capacity" do
    {_, started} = running()

    for mode <- [:unavailable, :wrong_operation, :wrong_ref, :invalid_result] do
      Fixture.mode(:query, mode)
      assert {:snooze, 1} = Coordinator.perform(started)
      assert held?() and current().build.state == :running
      expire_lease()
    end

    assert Fixture.snapshot().creations == 0
  end

  test "cancellation stops absent operation with a durable tombstone and delayed ensure cannot reopen" do
    {_, started} = running()
    # Capture an earlier valid request before cancellation without starting work.
    Fixture.mode(:ensure_started, :unavailable)
    assert {:snooze, 1} = Coordinator.perform(started)
    old = List.last(Fixture.snapshot().calls).request
    cancelled = cancel()
    assert current().build.state == :cancelling and held?()
    assert :ok = Coordinator.perform(started)
    expire_lease()
    assert :ok = Coordinator.perform(cancelled)
    assert current().build.state == :cancelled and not held?()
    assert Fixture.snapshot().creations == 0
    assert {:error, :stale} = Fixture.ensure_started(old)
    newer = Enum.find(Fixture.snapshot().calls, &(&1.callback == :stop)).request

    newer = %{
      newer
      | guard: %{
          newer.guard
          | epoch: newer.guard.epoch + 1,
            expires_at: DateTime.add(DateTime.utc_now(), 3_000, :millisecond)
        }
    }

    assert {:ok, %Dispatch.Observation{status: {:stopped, _}}} = Fixture.ensure_started(newer)
    assert Fixture.snapshot().creations == 0
  end

  test "stop errors and lease expiry are uncertainty, not terminal evidence" do
    {_, started} = running()
    assert {:snooze, 1} = Coordinator.perform(started)
    cancelled = cancel()
    expire_lease()
    Fixture.mode(:stop, :unavailable)
    assert {:snooze, 1} = Coordinator.perform(cancelled)
    assert held?() and current().build.state == :cancelling
    expire_lease()
    assert held?()
    assert :ok = Coordinator.perform(cancelled)
    assert current().build.state == :cancelled and not held?()
    assert Fixture.snapshot().creations == 1
  end

  test "deadline is persisted as expiry before stop, while original worker fence is preserved" do
    created = create(%{max_attempts: 1, timeout_ms: 1, retry_backoff_ms: 0})
    assert :ok = Coordinator.perform(created)
    started = latest_job()
    ref = current().build.active_ref
    expire_lease()
    assert :ok = Coordinator.perform(started)
    assert current().build.state == :reconciling and held?()
    assert Fixture.snapshot().calls == []
    expired = latest_job()
    expire_lease()
    assert :ok = Coordinator.perform(expired)
    assert current().build.state == :timed_out and not held?()
    assert List.last(Fixture.snapshot().calls).request.ref == ref
    assert Fixture.snapshot().creations == 0
  end

  test "compiler failure releases definitively but cannot trigger automatic retry" do
    {_, started} = running()
    assert {:snooze, 1} = Coordinator.perform(started)
    Fixture.complete(operation(), failure(:compiler))
    expire_lease()
    assert :ok = Coordinator.perform(started)
    terminal = latest_job()
    assert current().build.state == :failed and not held?()
    assert :ok = Coordinator.perform(terminal)
    assert current().build.attempt == 1
    assert Fixture.snapshot().creations == 1
  end

  test "successful completion preserves complete artifact references and releases exactly once" do
    {_, started} = running()
    assert {:snooze, 1} = Coordinator.perform(started)

    artifacts =
      for kind <- [
            :unsigned_native_binary,
            :guest_artifact,
            :resource_inventory,
            :debug_symbols,
            :compatibility_report,
            :sbom,
            :provenance
          ] do
        %MixerHosted.Builds.Lifecycle.ArtifactRef{
          kind: kind,
          sha256: String.duplicate("e", 64),
          size_bytes: 128
        }
      end

    Fixture.complete(operation(), %{outcome: :succeeded, artifacts: artifacts})
    expire_lease()
    assert :ok = Coordinator.perform(started)
    assert current().build.state == :succeeded and not held?()
    assert current().build.artifacts == artifacts
    released = Repo.one!(Reservation)
    assert :ok = Coordinator.perform(started)
    assert :ok = Coordinator.perform(latest_job())
    assert Repo.one!(Reservation) == released
    assert current().build.attempt == 1 and Fixture.snapshot().creations == 1
  end

  test "bounded infrastructure retry follows release, rejects stale jobs and uses a new operation" do
    {created, started} = running()
    assert {:snooze, 1} = Coordinator.perform(started)
    Fixture.complete(operation(), failure())
    expire_lease()
    assert :ok = Coordinator.perform(started)
    assert not held?()
    assert :ok = Coordinator.perform(latest_job())
    assert current().build.state == :queued and current().build.attempt == 2
    assert :ok = Coordinator.perform(created)
    assert :ok = Coordinator.perform(started)
    assert Fixture.snapshot().creations == 1
    assert :ok = Coordinator.perform(latest_job())
    expire_lease()
    assert {:snooze, 1} = Coordinator.perform(latest_job())
    assert Fixture.snapshot().creations == 2
    Fixture.complete(operation_for_attempt(2), failure())
    expire_lease()
    assert :ok = Coordinator.perform(latest_job())
    assert :ok = Coordinator.perform(latest_job())
    assert current().build.attempt == 2 and current().build.state == :failed
  end

  defp operation_for_attempt(attempt) do
    {id, _} =
      Enum.find(Fixture.snapshot().operations, fn {_, op} -> op.ref.attempt == attempt end)

    id
  end

  test "released-attempt retry respects database backoff" do
    created = create(%{max_attempts: 2, timeout_ms: 100_000, retry_backoff_ms: 60_000})
    assert :ok = Coordinator.perform(created)
    expire_lease()
    started = latest_job()
    assert {:snooze, 1} = Coordinator.perform(started)
    Fixture.complete(operation(), failure())
    expire_lease()
    assert :ok = Coordinator.perform(started)
    c = current()
    assert not held?()
    assert {:snooze, 1} = Coordinator.perform(latest_job())

    assert {:error, :retry, :backoff_not_reached, _} =
             Admission.retry_multi(
               Multi.new(),
               :retry,
               scope(),
               c.record.revision,
               "retry-too-early",
               &Coordinator.new/1
             )
             |> Repo.transaction()

    assert current().record.revision == c.record.revision
    assert current().build.attempt == 1
  end

  test "released retry job insertion failure rolls back retry state and preserves release evidence" do
    {_, started} = running()
    assert {:snooze, 1} = Coordinator.perform(started)
    Fixture.complete(operation(), failure())
    expire_lease()
    assert :ok = Coordinator.perform(started)
    c = current()
    released = Repo.one!(Reservation)
    jobs = Repo.aggregate(Oban.Job, :count)

    Repo.query!(
      "ALTER TABLE oban_jobs ADD CONSTRAINT coordinator_reject_retry CHECK ((args->>'kind') <> 'retry')"
    )

    try do
      assert_raise Ecto.ConstraintError, fn -> Coordinator.perform(latest_job()) end
      assert current().record.revision == c.record.revision
      assert current().build.attempt == 1 and current().build.state == :failed
      assert Repo.one!(Reservation) == released and not held?()
      assert Repo.aggregate(Oban.Job, :count) == jobs
    after
      Repo.query!("ALTER TABLE oban_jobs DROP CONSTRAINT coordinator_reject_retry")
    end
  end

  test "later Multi failure rolls retry domain and job back together" do
    {_, started} = running()
    assert {:snooze, 1} = Coordinator.perform(started)
    Fixture.complete(operation(), failure())
    expire_lease()
    assert :ok = Coordinator.perform(started)
    c = current()
    jobs = Repo.aggregate(Oban.Job, :count)

    assert {:error, :later, :synthetic_failure, _} =
             Admission.retry_multi(
               Multi.new(),
               :retry,
               scope(),
               c.record.revision,
               "retry-then-rollback",
               &Coordinator.new/1
             )
             |> Multi.run(:later, fn _, _ -> {:error, :synthetic_failure} end)
             |> Repo.transaction()

    assert current().record.revision == c.record.revision
    assert current().build.attempt == 1 and not held?()
    assert Repo.aggregate(Oban.Job, :count) == jobs
  end

  test "guarded start and reservation roll back when atomic coordinator intent insertion fails" do
    created = create()

    Repo.query!(
      "ALTER TABLE oban_jobs ADD CONSTRAINT coordinator_reject_start CHECK ((args->>'kind') <> 'start')"
    )

    try do
      assert_raise Ecto.ConstraintError, fn -> Coordinator.perform(created) end
      assert current().record.revision == 0 and current().build.state == :queued
      assert Repo.aggregate(Reservation, :count) == 0
      assert Repo.aggregate(Lease, :count) == 0
      assert Repo.aggregate(Oban.Job, :count) == 1
      assert Fixture.snapshot().calls == []
    after
      Repo.query!("ALTER TABLE oban_jobs DROP CONSTRAINT coordinator_reject_start")
    end
  end

  test "released retry requires current revision and exact retained terminal evidence" do
    {_, started} = running()
    assert {:snooze, 1} = Coordinator.perform(started)
    c = current()

    assert {:error, {:retry, :admission}, :released_current_attempt_required, _} =
             Admission.retry_multi(
               Multi.new(),
               :retry,
               scope(),
               c.record.revision,
               "held-retry",
               &Coordinator.new/1
             )
             |> Repo.transaction()

    Fixture.complete(operation(), failure())
    expire_lease()
    assert :ok = Coordinator.perform(started)
    c = current()

    assert {:error, {:retry, :admission}, :released_current_attempt_required, _} =
             Admission.retry_multi(
               Multi.new(),
               :retry,
               scope(),
               c.record.revision - 1,
               "stale-retry",
               &Coordinator.new/1
             )
             |> Repo.transaction()

    Repo.query!("UPDATE mixer_build_reservations SET terminal_event_id = 'unproven'")

    assert {:error, {:retry, :admission}, :invalid_admission, _} =
             Admission.retry_multi(
               Multi.new(),
               :retry,
               scope(),
               c.record.revision,
               "unproven-retry",
               &Coordinator.new/1
             )
             |> Repo.transaction()

    assert current().build.attempt == 1
  end
end

36d11f8e3359abe15ace3c1a52cbeaf9e56bed06 blob 25263
defmodule MixerHosted.Builds.JournalTest do
  use ExUnit.Case, async: true

  alias MixerHosted.Builds.{Journal, Lifecycle}
  alias MixerHosted.Builds.Lifecycle.{ArtifactRef, Policy, Spec}

  @max_time 9_223_372_036_854_775_807
  @kinds [
    :unsigned_native_binary,
    :guest_artifact,
    :resource_inventory,
    :debug_symbols,
    :compatibility_report,
    :sbom,
    :provenance
  ]

  defp sha(n), do: n |> Integer.to_string(16) |> String.downcase() |> String.pad_leading(64, "0")

  defp spec do
    %{
      organization_id: "org-1",
      project_id: "project-1",
      application_id: "app-1",
      build_id: "build-1",
      platform: :ios,
      source: %{kind: :revision, sha256: sha(100), reference: "refs/heads/main"},
      toolchain_lock_sha256: sha(101),
      build_definition_sha256: sha(102)
    }
  end

  defp policy, do: %{max_attempts: 5, timeout_ms: 100, retry_backoff_ms: 10}

  defp new!(spec \\ spec(), policy \\ policy(), key \\ "request-1", now \\ 0) do
    assert {:ok, document, build} = Journal.new(spec, policy, key, now)
    assert {:ok, ^build} = Journal.restore(document)
    assert {:ok, ^build} = document |> Jason.encode!() |> Jason.decode!() |> Journal.restore()
    {document, build}
  end

  defp append!({document, build}, id, event, now) do
    assert {:ok, expected, :applied} = Lifecycle.transition(build, id, event, now)
    assert {:ok, document, ^expected, :applied} = Journal.append(document, id, event, now)
    assert {:ok, ^expected} = Journal.restore(document)
    assert {:ok, ^expected} = document |> Jason.encode!() |> Jason.decode!() |> Journal.restore()
    assert byte_size(Jason.encode!(document)) <= 131_072
    {document, expected}
  end

  defp start!(pair, now \\ 1) do
    {_document, build} = pair
    assert {:ok, ref} = Lifecycle.worker_ref(build)
    append!(pair, "start-#{build.attempt}", %{type: :start, ref: ref}, now)
  end

  defp artifacts do
    Enum.with_index(@kinds, 1)
    |> Enum.map(fn {kind, n} -> %ArtifactRef{kind: kind, sha256: sha(n), size_bytes: n * 10} end)
  end

  defp success(ref),
    do: %{type: :completed, ref: ref, result: %{outcome: :succeeded, artifacts: artifacts()}}

  defp failure(ref, class \\ :infrastructure, code \\ :worker_lost),
    do: %{
      type: :completed,
      ref: ref,
      result: %{outcome: :failed, class: class, code: code, diagnostic_sha256: sha(200)}
    }

  defp stopped(ref), do: %{type: :stopped, ref: ref, diagnostic_sha256: sha(201)}
  defp cancel(reason \\ "Customer cancelled"), do: %{type: :cancel, reason: reason}

  defp row_event(document, index, fun),
    do:
      Map.update!(
        document,
        "events",
        &List.update_at(&1, index, fn row -> Map.update!(row, "event", fun) end)
      )

  test "creation has an exact string-key schema and accepts only lifecycle creation inputs" do
    {document, build} = new!()
    assert Map.keys(document) |> Enum.sort() == ["creation", "events", "schema"]
    assert document["schema"] === 1
    assert document["events"] === []

    assert document["creation"] == %{
             "spec" => %{
               "organization_id" => "org-1",
               "project_id" => "project-1",
               "application_id" => "app-1",
               "build_id" => "build-1",
               "platform" => "ios",
               "source" => %{
                 "kind" => "revision",
                 "sha256" => sha(100),
                 "reference" => "refs/heads/main"
               },
               "toolchain_lock_sha256" => sha(101),
               "build_definition_sha256" => sha(102)
             },
             "policy" => %{"max_attempts" => 5, "timeout_ms" => 100, "retry_backoff_ms" => 10},
             "request_key" => "request-1",
             "now_ms" => 0
           }

    assert build.state == :queued
    new!(struct!(Spec, spec()), struct!(Policy, policy()))

    {upload, android} =
      new!(%{
        spec()
        | platform: :android,
          source: %{kind: :upload, sha256: sha(1), reference: "upload-1"}
      })

    assert upload["creation"]["spec"]["source"]["kind"] == "upload"
    assert android.spec.platform == :android

    for {input, expected} <- [
          {{Map.put(spec(), :extra, true), policy(), "r", 0}, :invalid_spec},
          {{%{}, policy(), "r", 0}, :invalid_spec},
          {{spec(), Map.put(policy(), :extra, true), "r", 0}, :invalid_policy},
          {{spec(), policy(), "", 0}, :invalid_request},
          {{spec(), policy(), "r", -1}, :invalid_request}
        ] do
      {spec, policy, key, now} = input
      assert {:error, ^expected} = Journal.new(spec, policy, key, now)
    end
  end

  test "success round trips every artifact kind, exact refs and the lifecycle history" do
    {document, build} = new!() |> start!()
    ref = build.active_ref
    {done_document, done} = append!({document, build}, "completed", success(ref), 2)
    assert done.state == :succeeded
    assert done.artifacts == artifacts()
    assert [%{state: :succeeded, worker_ref: ^ref}] = done.history

    assert Enum.at(done_document["events"], 0) == %{
             "id" => "start-1",
             "now_ms" => 1,
             "event" => %{
               "type" => "start",
               "ref" => %{
                 "organization_id" => "org-1",
                 "project_id" => "project-1",
                 "application_id" => "app-1",
                 "build_id" => "build-1",
                 "platform" => "ios",
                 "attempt" => 1,
                 "fence" => 1
               }
             }
           }

    persisted = Enum.at(done_document["events"], 1)["event"]["result"]["artifacts"]
    assert Enum.map(persisted, & &1["kind"]) == Enum.map(@kinds, &Atom.to_string/1)

    assert Enum.all?(
             persisted,
             &(Map.keys(&1) |> Enum.sort() == ["kind", "sha256", "size_bytes"])
           )

    assert {:ok, status} = Lifecycle.customer_status(done)
    assert status.artifacts == artifacts()
    assert status.worker_completion_pending == false
  end

  test "queued cancellation and every matching cancellation reconciliation outcome replay" do
    {_document, cancelled} = append!(new!(), "cancel", cancel(), 0)
    assert cancelled.state == :cancelled
    assert [%{worker_ref: nil}] = cancelled.history

    for expire? <- [false, true], terminal <- [:stopped, :succeeded, :failed] do
      {document, running} = new!() |> start!()
      ref = running.active_ref

      pair =
        if expire?,
          do: append!({document, running}, "expire", %{type: :expire, ref: ref}, 101),
          else: {document, running}

      pair = append!(pair, "cancel", cancel(), 102)
      {pending_document, pending} = pair
      assert pending.state == :cancelling
      assert pending.active_ref == ref
      assert pending.fence == if(expire?, do: 3, else: 2)
      assert {:ok, ^pending} = Journal.restore(pending_document)

      event =
        case terminal do
          :stopped -> stopped(ref)
          :succeeded -> success(ref)
          :failed -> failure(ref)
        end

      {_document, done} = append!(pair, "terminal", event, 103)

      assert {done.state, done.failure, done.artifacts, done.retry_after} ==
               {:cancelled, nil, nil, nil}
    end
  end

  test "timeout uncertainty, definitive completion, retry and late non-infrastructure failure survive replay" do
    {document, running} = new!() |> start!()
    ref = running.active_ref
    pair = append!({document, running}, "expire", %{type: :expire, ref: ref}, 101)
    {pending_document, pending} = pair
    assert pending.state == :reconciling
    assert pending.active_ref == ref

    assert {:error, :invalid_transition} =
             Journal.append(pending_document, "retry", %{type: :retry}, 102)

    for terminal <- [stopped(ref), success(ref), failure(ref)] do
      {done_document, done} = append!(pair, "terminal", terminal, 102)
      assert done.state == :timed_out
      assert done.failure.class == :infrastructure
      assert done.failure.code == :worker_timeout
      {retried_document, retried} = append!({done_document, done}, "retry", %{type: :retry}, 112)
      assert {retried.state, retried.attempt, retried.fence} == {:queued, 2, 4}

      assert {:error, :stale_worker_ref} =
               Journal.append(retried_document, "old-start", %{type: :start, ref: ref}, 113)

      {_next_document, next} = start!({retried_document, retried}, 113)
      assert next.active_ref.fence == 4
    end

    {_document, late} =
      append!({document, running}, "late-compiler", failure(ref, :compiler, :compiler_error), 101)

    assert late.state == :timed_out
    assert late.failure.class == :compiler
    assert late.retry_after == nil
    {_document, late_success} = append!({document, running}, "late-success", success(ref), 101)
    assert late_success.failure.diagnostic_sha256 == nil
    {_document, on_time} = append!({document, running}, "on-time", success(ref), 100)
    assert on_time.state == :succeeded
  end

  test "every declared failure code is converted and lifecycle semantics remain authoritative" do
    pairs = [
      {:infrastructure, :worker_unavailable},
      {:infrastructure, :worker_lost},
      {:infrastructure, :dependency_transport},
      {:infrastructure, :artifact_transport},
      {:infrastructure, :worker_timeout},
      {:compiler, :compiler_error},
      {:test, :test_failure},
      {:policy, :policy_rejection},
      {:policy, :invalid_input},
      {:unknown, :unknown_failure}
    ]

    for {class, code} <- pairs do
      {document, build} = new!() |> start!()

      {_done_document, done} =
        append!({document, build}, "failure", failure(build.active_ref, class, code), 2)

      assert done.state == :failed
      assert done.failure == %{class: class, code: code, diagnostic_sha256: sha(200)}
      assert {:ok, status} = Lifecycle.customer_status(done)
      assert status.retryable == (class == :infrastructure)
    end

    {document, build} = new!() |> start!()

    assert {:error, :invalid_event} =
             Journal.append(
               document,
               "mixed",
               failure(build.active_ref, :compiler, :worker_lost),
               2
             )

    assert {:error, :invalid_observation_time} =
             Journal.append(document, "backwards", stopped(build.active_ref), 0)

    assert {:error, :deadline_not_reached} =
             Journal.append(document, "early", %{type: :expire, ref: build.active_ref}, 100)
  end

  test "all five timeout attempts and backoff fences replay through the longest retry path" do
    pair =
      Enum.reduce(1..5, new!(), fn attempt, pair ->
        now = (attempt - 1) * 120 + 1
        {document, running} = start!(pair, now)

        pair =
          append!(
            {document, running},
            "expire-#{attempt}",
            %{type: :expire, ref: running.active_ref},
            now + 100
          )

        {document, timed_out} =
          append!(pair, "stop-#{attempt}", stopped(running.active_ref), now + 101)

        assert timed_out.attempt == attempt

        if attempt < 5 do
          assert {:error, :backoff_not_reached} =
                   Journal.append(document, "early-retry", %{type: :retry}, now + 110)

          append!({document, timed_out}, "retry-#{attempt}", %{type: :retry}, now + 111)
        else
          assert {:error, :attempt_limit} =
                   Journal.append(document, "retry-5", %{type: :retry}, now + 111)

          {document, timed_out}
        end
      end)

    {document, build} = pair
    assert length(document["events"]) == 19
    assert Enum.map(build.history, & &1.attempt) == [1, 2, 3, 4, 5]
    assert build.state == :timed_out
  end

  test "duplicate delivery preserves the original journal and current build despite delivery time" do
    {document, build} = new!() |> start!()
    event = failure(build.active_ref)
    pair = append!({document, build}, "failure", event, 2)
    pair = append!(pair, "retry", %{type: :retry}, 12) |> start!(13)
    {document, current} = pair
    {document, current} = append!({document, current}, "done", success(current.active_ref), 14)

    for now <- [99_999, -1, nil, @max_time + 1, {:not, :a_time}] do
      assert {:ok, ^document, ^current, :duplicate} =
               Journal.append(document, "failure", event, now)
    end

    assert current.events["failure"].first_observed_at == 2
    assert current.observed_at == 14

    assert {:error, :event_conflict} =
             Journal.append(document, "failure", stopped(build.active_ref), 15)

    assert {:error, :event_conflict} =
             Journal.append(document, "failure", Map.put(event, :extra, true), 15)

    assert {:error, :event_conflict} = Journal.append(document, "failure", {:opaque, event}, 15)
    assert {:error, :invalid_event_id} = Journal.append(document, "", event, 15)
  end

  test "restore rejects snapshots, missing and extra fields, every enum mismatch and malformed creation data" do
    {document, build} = new!()

    for bad <- [
          build,
          nil,
          [],
          {document},
          Map.put(document, "state", "succeeded"),
          Map.put(document, "schema", 2),
          Map.put(document, "schema", 1.0),
          Map.put(document, :schema, 1),
          Map.put(document, "creation", build),
          Map.put(document, "creation", Map.put(document["creation"], "snapshot", build))
        ] do
      assert {:error, :invalid_journal} = Journal.restore(bad)
    end

    for key <- Map.keys(document),
        do: assert({:error, :invalid_journal} = Journal.restore(Map.delete(document, key)))

    creation = document["creation"]

    for key <- Map.keys(creation),
        do:
          assert(
            {:error, :invalid_journal} =
              Journal.restore(put_in(document, ["creation"], Map.delete(creation, key)))
          )

    persisted_spec = creation["spec"]

    for key <- Map.keys(persisted_spec) do
      assert {:error, :invalid_journal} =
               Journal.restore(
                 put_in(document, ["creation", "spec"], Map.delete(persisted_spec, key))
               )
    end

    for {path, value} <- [
          {["spec", "platform"], "linux"},
          {["spec", "platform"], :ios},
          {["spec", "source", "kind"], "branch"},
          {["spec", "source", "kind"], :revision},
          {["spec", "source", "sha256"], String.upcase(sha(255))},
          {["spec", "toolchain_lock_sha256"], String.duplicate("0", 63)},
          {["spec", "source", "reference"], <<255>>},
          {["spec", "build_id"], "a\0b"},
          {["policy", "max_attempts"], 6},
          {["policy", "timeout_ms"], 0},
          {["policy", "retry_backoff_ms"], 3_600_001},
          {["policy", "max_attempts"], 1.0},
          {["request_key"], ""},
          {["now_ms"], -1},
          {["now_ms"], @max_time + 1},
          {["now_ms"], 0.0}
        ] do
      assert {:error, :invalid_journal} =
               Journal.restore(put_in(document, ["creation" | path], value)),
             inspect(path)
    end

    for {path, key} <- [
          {["creation", "spec"], "grant"},
          {["creation", "spec", "source"], "token"},
          {["creation", "policy"], "allow"}
        ] do
      assert {:error, :invalid_journal} =
               Journal.restore(update_in(document, path, &Map.put(&1, key, true)))
    end
  end

  test "persisted event order, identity, observation times and exact worker scopes fail closed" do
    {document, running} = new!() |> start!()
    {done_document, _done} = append!({document, running}, "done", success(running.active_ref), 2)

    for bad <- [
          Map.update!(done_document, "events", &Enum.reverse/1),
          Map.update!(done_document, "events", &(&1 ++ [hd(&1)])),
          Map.update!(
            done_document,
            "events",
            &List.update_at(&1, 1, fn row -> Map.put(row, "id", "start-1") end)
          ),
          Map.update!(
            done_document,
            "events",
            &List.update_at(&1, 1, fn row -> Map.put(row, "now_ms", 0) end)
          ),
          Map.update!(
            done_document,
            "events",
            &List.update_at(&1, 0, fn row -> Map.put(row, "extra", true) end)
          ),
          Map.update!(
            done_document,
            "events",
            &List.update_at(&1, 0, fn row -> Map.put(row, "id", "") end)
          ),
          Map.update!(
            done_document,
            "events",
            &List.update_at(&1, 0, fn row -> Map.delete(row, "now_ms") end)
          ),
          row_event(done_document, 0, &Map.put(&1, "type", "dispatch")),
          row_event(done_document, 0, &Map.put(&1, "extra", true)),
          row_event(done_document, 0, &put_in(&1, ["ref", "extra"], true)),
          row_event(done_document, 0, &Map.put(&1, "ref", running.active_ref)),
          row_event(done_document, 0, &Map.put(&1, "ref", Map.from_struct(running.active_ref)))
        ] do
      assert {:error, :invalid_journal} = Journal.restore(bad)
    end

    for {key, value} <- [
          {"organization_id", "other"},
          {"project_id", "other"},
          {"application_id", "other"},
          {"build_id", "other"},
          {"platform", "android"},
          {"attempt", 2},
          {"fence", 2},
          {"attempt", 0},
          {"fence", @max_time + 1},
          {"platform", "linux"}
        ] do
      assert {:error, :invalid_journal} =
               Journal.restore(row_event(done_document, 0, &put_in(&1, ["ref", key], value)))
    end

    {failed_document, _failed} =
      append!({document, running}, "failed", failure(running.active_ref), 2)

    for {key, value} <- [
          {"outcome", "maybe"},
          {"class", "other"},
          {"code", "other"},
          {"diagnostic_sha256", nil},
          {"class", "compiler"}
        ] do
      assert {:error, :invalid_journal} =
               Journal.restore(row_event(failed_document, 1, &put_in(&1, ["result", key], value)))
    end
  end

  test "artifact encoding rejects extra fields, missing kinds, invalid bytes and semantic content conflicts" do
    {document, running} = new!() |> start!()
    event = success(running.active_ref)
    [first | rest] = artifacts()

    for refs <- [
          [],
          rest,
          artifacts() ++ [first],
          List.duplicate(first, 7),
          [%{first | kind: :other} | rest],
          [%{first | size_bytes: 0} | rest],
          [%{first | size_bytes: @max_time + 1} | rest],
          [%{first | sha256: sha(1) <> "0"} | rest],
          [Map.put(first, :extra, true) | rest],
          [Map.from_struct(first) | rest],
          [%{first | sha256: sha(2), size_bytes: 1} | rest]
        ] do
      assert {:error, :invalid_event} =
               Journal.append(document, "bad", put_in(event, [:result, :artifacts], refs), 2)
    end

    {done_document, _done} = append!({document, running}, "done", event, 2)

    for {key, value} <- [
          {"kind", "native_binary"},
          {"kind", :provenance},
          {"sha256", "bad"},
          {"size_bytes", 0},
          {"size_bytes", 1.0},
          {"extra", true}
        ] do
      corrupted =
        row_event(done_document, 1, fn event ->
          update_in(
            event,
            ["result", "artifacts"],
            &List.update_at(&1, 0, fn artifact -> Map.put(artifact, key, value) end)
          )
        end)

      assert {:error, :invalid_journal} = Journal.restore(corrupted)
    end
  end

  test "shared artifact content and primitive maximum bounds preserve lifecycle acceptance" do
    policy = %{max_attempts: 1, timeout_ms: 86_400_000, retry_backoff_ms: 3_600_000}
    {document, build} = new!(spec(), policy)
    {document, running} = start!({document, build}, @max_time - 86_400_000)
    shared = Enum.map(artifacts(), &%{&1 | sha256: sha(1), size_bytes: @max_time})
    event = put_in(success(running.active_ref), [:result, :artifacts], shared)
    {_document, done} = append!({document, running}, "done", event, @max_time - 1)
    assert done.state == :succeeded
    assert done.artifacts == shared
    new!(spec(), %{max_attempts: 1, timeout_ms: 1, retry_backoff_ms: 0})
  end

  test "native input maps, refs, tuples and unsupported events cannot carry hidden fields or structs" do
    {document, running} = new!() |> start!()
    ref = running.active_ref

    for event <- [
          %{type: :retry, extra: true},
          %{type: "retry"},
          %{type: :unknown},
          %{type: :cancel},
          %{type: :cancel, reason: "ok", extra: true},
          %{type: :start, ref: Map.from_struct(ref)},
          %{type: :start, ref: Map.put(ref, :extra, true)},
          %{type: :start, ref: %{ref | platform: ["ios"]}},
          %{type: :start, ref: %{ref | attempt: 1.0}},
          %{type: :stopped, ref: ref, diagnostic_sha256: nil},
          put_in(success(ref), [:result, :outcome], "succeeded"),
          put_in(failure(ref), [:result, :class], ["infrastructure"]),
          put_in(failure(ref), [:result, :code], %{unknown: true}),
          Map.put(success(ref), :extra, true),
          {ref, :stop},
          running,
          nil,
          []
        ] do
      assert {:error, :invalid_event} = Journal.append(document, "bad", event, 2)
    end

    for key <- [:organization_id, :project_id, :application_id, :build_id] do
      assert {:error, :stale_worker_ref} =
               Journal.append(document, "scope", stopped(Map.put(ref, key, "other")), 2)
    end

    for now <- [-1, nil, 2.0, @max_time + 1] do
      assert {:error, :invalid_observation_time} =
               Journal.append(document, "stop", stopped(ref), now)
    end

    assert {:error, :invalid_journal} = Journal.append(%{}, "stop", stopped(ref), 2)
  end

  test "bounded UTF-8 byte lengths preserve Unicode and JSON escaping without normalization" do
    unicode = String.duplicate("é", 64)
    reference = String.duplicate("🧪", 256)

    spec = %{
      spec()
      | organization_id: unicode,
        build_id: unicode,
        source: %{kind: :upload, sha256: sha(1), reference: reference}
    }

    pair = new!(spec, policy(), unicode, @max_time)
    {document, build} = pair

    assert {:error, :time_overflow} =
             Journal.append(
               document,
               "start",
               %{type: :start, ref: elem(Lifecycle.worker_ref(build), 1)},
               @max_time
             )

    assert {:error, :invalid_spec} =
             Journal.new(%{spec | build_id: unicode <> "a"}, policy(), "r", 0)

    assert {:error, :invalid_spec} =
             Journal.new(put_in(spec, [:source, :reference], reference <> "a"), policy(), "r", 0)

    assert {:error, :invalid_request} = Journal.new(spec, policy(), unicode <> "a", 0)

    {document, build} =
      new!(%{spec | source: %{spec.source | reference: "line\n\t\"\\é🧪"}}, policy(), unicode)

    assert {:ok, ref} = Lifecycle.worker_ref(build)
    {document, running} = append!({document, build}, unicode, %{type: :start, ref: ref}, 1)
    assert {:error, :invalid_event_id} = Journal.append(document, unicode <> "a", cancel(), 2)
    reason = String.duplicate("é", 256)
    {document, pending} = append!({document, running}, "cancel", cancel(reason), 2)
    assert pending.state == :cancelling

    assert {:error, :invalid_event} =
             Journal.append(document, "big-reason", cancel(reason <> "a"), 3)

    assert Enum.at(document["events"], 1)["event"]["reason"] == reason
  end

  test "event list ceilings and deep or oversized inputs are rejected before unbounded traversal" do
    {document, _build} = new!()
    deep = Enum.reduce(1..50_000, "leaf", fn _, nested -> [nested] end)
    huge = String.duplicate("x", 131_073)
    row = %{"id" => "cancel", "event" => %{"type" => "cancel", "reason" => "stop"}, "now_ms" => 0}

    for count <- [31, 32, 33] do
      assert {:error, :invalid_journal} =
               Journal.restore(Map.put(document, "events", List.duplicate(row, count)))
    end

    for bad <- [
          deep,
          Map.put(document, "events", deep),
          Map.put(document, "events", [row | :improper]),
          Map.put(document, "events", List.duplicate(deep, 33)),
          put_in(document, ["creation", "spec", "source"], deep),
          put_in(document, ["creation", "spec", "source", "reference"], huge),
          put_in(document, ["creation", "request_key"], huge),
          put_in(document, ["creation", "spec", "platform"], deep),
          Map.put(document, huge, deep),
          Map.put(document, "events", [%{"id" => huge, "event" => deep, "now_ms" => 0}])
        ] do
      assert {:error, :invalid_journal} = Journal.restore(bad)
    end

    for event <- [
          deep,
          %{type: :cancel, reason: huge},
          %{type: :completed, ref: deep, result: deep},
          %{type: :retry, huge: deep}
        ] do
      assert {:error, :invalid_event} = Journal.append(document, "bad", event, 0)
    end

    assert {:error, :invalid_spec} = Journal.new(%{spec() | source: deep}, policy(), "r", 0)
    assert {:error, :invalid_event_id} = Journal.append(document, huge, cancel(), 0)
  end
end

11442b12e96f021766719a72a3c1b03af172846a blob 27848
defmodule MixerHosted.Builds.LifecycleTest do
  use ExUnit.Case, async: true
  alias MixerHosted.Builds.Lifecycle
  alias MixerHosted.Builds.Lifecycle.{ArtifactRef, Build, WorkerRef}

  @max_time 9_223_372_036_854_775_807
  @kinds [
    :unsigned_native_binary,
    :guest_artifact,
    :resource_inventory,
    :debug_symbols,
    :compatibility_report,
    :sbom,
    :provenance
  ]

  defp sha(number),
    do: number |> Integer.to_string(16) |> String.downcase() |> String.pad_leading(64, "0")

  defp spec do
    %{
      organization_id: "org-1",
      project_id: "project-1",
      application_id: "app-1",
      build_id: "build-1",
      platform: :ios,
      source: %{kind: :revision, sha256: sha(100), reference: "main@0123456789abcdef"},
      toolchain_lock_sha256: sha(101),
      build_definition_sha256: sha(102)
    }
  end

  defp policy, do: %{max_attempts: 3, timeout_ms: 100, retry_backoff_ms: 10}

  defp queued(spec \\ spec(), policy \\ policy(), now \\ 0) do
    assert {:ok, build} = Lifecycle.new(spec, policy, "request-1", now)
    build
  end

  defp apply!(build, id, event, now) do
    assert {:ok, updated, :applied} = Lifecycle.transition(build, id, event, now)
    updated
  end

  defp running(build \\ queued(), now \\ 1) do
    assert {:ok, ref} = Lifecycle.worker_ref(build)
    apply!(build, "start-#{build.attempt}", %{type: :start, ref: ref}, now)
  end

  defp artifacts do
    @kinds
    |> Enum.with_index(1)
    |> Enum.map(fn {kind, i} -> %ArtifactRef{kind: kind, sha256: sha(i), size_bytes: i * 10} end)
  end

  defp success(ref),
    do: %{type: :completed, ref: ref, result: %{outcome: :succeeded, artifacts: artifacts()}}

  defp failure(ref, class \\ :infrastructure, code \\ :worker_lost),
    do: %{
      type: :completed,
      ref: ref,
      result: %{outcome: :failed, class: class, code: code, diagnostic_sha256: sha(200)}
    }

  defp stop(ref), do: %{type: :stopped, ref: ref, diagnostic_sha256: sha(201)}
  defp cancel, do: %{type: :cancel, reason: "Customer cancelled the build"}

  test "immutable identity, exact scoped worker reference and successful output status" do
    initial = queued()
    assert initial.state == :queued
    assert {initial.attempt, initial.fence, initial.active_ref} == {1, 1, nil}
    assert {:ok, ref} = Lifecycle.worker_ref(initial)

    assert ref == %WorkerRef{
             organization_id: "org-1",
             project_id: "project-1",
             application_id: "app-1",
             build_id: "build-1",
             platform: :ios,
             attempt: 1,
             fence: 1
           }

    build = running(initial)
    assert build.deadline == 101
    assert {:ok, ^ref} = Lifecycle.worker_ref(build)
    done = apply!(build, "success", success(ref), 100)
    assert done.state == :succeeded
    assert done.fence == 2
    assert done.spec == initial.spec
    assert done.artifacts == artifacts()
    assert is_nil(done.active_ref)
    assert [%{state: :succeeded, worker_ref: ^ref, artifacts: refs}] = done.history
    assert refs == artifacts()
    assert {:ok, status} = Lifecycle.customer_status(done)

    assert status == %{
             build_id: "build-1",
             platform: :ios,
             state: :succeeded,
             attempt: 1,
             max_attempts: 3,
             worker_completion_pending: false,
             retryable: false,
             retry_after: nil,
             retry_blocked: :not_retryable_state,
             failure: nil,
             artifacts: artifacts()
           }

    assert {:error, :no_active_attempt} = Lifecycle.worker_ref(done)

    assert {:error, :invalid_transition} =
             Lifecycle.transition(done, "replace", success(ref), 100)

    assert {:error, :invalid_transition} =
             Lifecycle.transition(done, "cancel-late", cancel(), 100)

    assert {:error, :invalid_transition} =
             Lifecycle.transition(done, "retry-late", %{type: :retry}, 100)

    assert done.artifacts == refs
  end

  test "new input is closed, typed and bounded with no source or identity inference" do
    for key <- Map.keys(spec()) do
      assert {:error, :invalid_spec} = Lifecycle.new(Map.delete(spec(), key), policy(), "r", 0),
             inspect(key)

      assert {:error, :invalid_spec} = Lifecycle.new(Map.put(spec(), key, nil), policy(), "r", 0),
             inspect(key)
    end

    bad_specs = [
      Map.put(spec(), :unknown, true),
      Map.put(spec(), :platform, :linux),
      Map.put(spec(), :build_id, String.duplicate("x", 129)),
      Map.put(spec(), :build_id, ""),
      Map.put(spec(), :build_id, <<255>>),
      Map.put(spec(), :build_id, "a\0b"),
      Map.put(spec(), :toolchain_lock_sha256, String.upcase(sha(255))),
      Map.put(spec(), :build_definition_sha256, String.duplicate("0", 63)),
      put_in(spec(), [:source, :kind], :branch),
      put_in(spec(), [:source, :sha256], "main"),
      put_in(spec(), [:source, :reference], String.duplicate("x", 1025)),
      Map.update!(spec(), :source, &Map.put(&1, :token, "not accepted")),
      %{},
      nil,
      []
    ]

    for value <- bad_specs do
      assert {:error, :invalid_spec} = Lifecycle.new(value, policy(), "r", 0), inspect(value)
    end

    for key <- Map.keys(policy()) do
      assert {:error, :invalid_policy} = Lifecycle.new(spec(), Map.delete(policy(), key), "r", 0)

      assert {:error, :invalid_policy} =
               Lifecycle.new(spec(), Map.put(policy(), key, 1.0), "r", 0)
    end

    for value <- [
          Map.put(policy(), :max_attempts, 0),
          Map.put(policy(), :max_attempts, 6),
          Map.put(policy(), :timeout_ms, 0),
          Map.put(policy(), :timeout_ms, 86_400_001),
          Map.put(policy(), :retry_backoff_ms, -1),
          Map.put(policy(), :retry_backoff_ms, 3_600_001),
          Map.put(policy(), :unknown, 1),
          nil,
          %{}
        ] do
      assert {:error, :invalid_policy} = Lifecycle.new(spec(), value, "r", 0)
    end

    for request <- [nil, "", String.duplicate("x", 129), "a\0b"] do
      assert {:error, :invalid_request} = Lifecycle.new(spec(), policy(), request, 0)
    end

    for now <- [-1, @max_time + 1, 0.0, nil] do
      assert {:error, :invalid_request} = Lifecycle.new(spec(), policy(), "r", now)
    end

    upload = put_in(spec(), [:source, :kind], :upload)
    assert {:ok, %{spec: %{source: %{kind: :upload}}}} = Lifecycle.new(upload, policy(), "r", 0)

    assert {:ok, _} =
             Lifecycle.new(spec(), %{max_attempts: 1, timeout_ms: 1, retry_backoff_ms: 0}, "r", 0)
  end

  test "cancellation before dispatch is terminal without claiming any worker stopped" do
    build = apply!(queued(), "cancel", cancel(), 0)
    assert build.state == :cancelled
    assert build.fence == 2
    assert [%{worker_ref: nil, started_at: nil, state: :cancelled}] = build.history

    assert {:ok, %{state: :cancelled, worker_completion_pending: false}} =
             Lifecycle.customer_status(build)

    assert {:error, :invalid_transition} =
             Lifecycle.transition(build, "retry", %{type: :retry}, 10)
  end

  test "cancellation fences result authority while retaining uncertainty and exact stop identity" do
    build = running()
    ref = build.active_ref
    pending = apply!(build, "cancel", cancel(), 2)
    assert {pending.state, pending.fence, pending.active_ref} == {:cancelling, 2, ref}
    assert pending.history == []

    assert {:ok,
            %{
              state: :cancelling,
              worker_completion_pending: true,
              artifacts: nil,
              retryable: false
            }} = Lifecycle.customer_status(pending)

    assert {:error, :invalid_transition} =
             Lifecycle.transition(pending, "retry", %{type: :retry}, 3)

    assert {:error, :invalid_transition} =
             Lifecycle.transition(pending, "new-start", %{type: :start, ref: ref}, 3)

    assert {:error, :stale_worker_ref} =
             Lifecycle.transition(pending, "wrong-stop", stop(%{ref | fence: 2}), 3)

    done = apply!(pending, "late-success", success(ref), 3)
    assert done.state == :cancelled
    assert done.fence == 3
    assert done.active_ref == nil
    assert done.artifacts == nil
    assert {:ok, ^done, :duplicate} = Lifecycle.transition(done, "cancel", cancel(), 999)
    assert done.events["cancel"].first_observed_at == 2
  end

  test "expiry does not permit replacement until definitive matching worker completion" do
    build = running()
    ref = build.active_ref

    assert {:error, :deadline_not_reached} =
             Lifecycle.transition(build, "early", %{type: :expire, ref: ref}, 100)

    pending = apply!(build, "expire", %{type: :expire, ref: ref}, 101)

    assert {pending.state, pending.desired_terminal, pending.fence} ==
             {:reconciling, :timed_out, 2}

    assert pending.active_ref == ref

    assert {:ok, %{state: :reconciling, worker_completion_pending: true, retryable: false}} =
             Lifecycle.customer_status(pending)

    assert {:error, :invalid_transition} =
             Lifecycle.transition(pending, "retry", %{type: :retry}, 1_000)

    assert {:error, :invalid_transition} =
             Lifecycle.transition(pending, "start", %{type: :start, ref: ref}, 1_000)

    done = apply!(pending, "observed-stop", stop(ref), 102)
    assert done.state == :timed_out

    assert done.failure == %{
             class: :infrastructure,
             code: :worker_timeout,
             diagnostic_sha256: sha(201)
           }

    assert done.active_ref == nil
    assert done.retry_after == 112
    next = apply!(done, "retry", %{type: :retry}, 112)
    assert {next.state, next.attempt, next.fence} == {:queued, 2, 4}
    assert next.spec == build.spec
    assert next.policy == build.policy
    assert next.history == done.history

    assert {:error, :stale_worker_ref} =
             Lifecycle.transition(next, "old-start", %{type: :start, ref: ref}, 112)

    next = running(next, 113)

    assert {:error, :stale_worker_ref} =
             Lifecycle.transition(next, "old-result", success(ref), 114)

    assert {:error, :stale_worker_ref} =
             Lifecycle.transition(
               next,
               "future-result",
               success(%{next.active_ref | attempt: 3}),
               114
             )

    assert next.artifacts == nil
  end

  test "late definitive terminal report alone can establish timeout completion, discarding artifacts" do
    for now <- [101, 102] do
      build = running()
      done = apply!(build, "late", success(build.active_ref), now)
      assert {done.state, done.active_ref, done.artifacts} == {:timed_out, nil, nil}

      assert done.failure == %{
               class: :infrastructure,
               code: :worker_timeout,
               diagnostic_sha256: nil
             }

      assert {:ok, %{retryable: true, retry_after: after_time}} = Lifecycle.customer_status(done)
      assert after_time == now + 10
    end
  end

  test "cancel during timeout reconciliation preserves cancellation priority until definite stop" do
    build = running()
    pending = apply!(build, "expire", %{type: :expire, ref: build.active_ref}, 101)
    pending = apply!(pending, "cancel", cancel(), 102)

    assert {pending.state, pending.fence, pending.active_ref} ==
             {:cancelling, 3, build.active_ref}

    for event <- [stop(build.active_ref), failure(build.active_ref), success(build.active_ref)] do
      done = apply!(pending, "terminal", event, 103)

      assert {done.state, done.fence, done.failure, done.artifacts, done.retry_after} ==
               {:cancelled, 4, nil, nil, nil}
    end
  end

  test "exact worker scope rejects numerically equal references from all other scopes" do
    build = running()

    for {key, value} <- [
          organization_id: "org-2",
          project_id: "project-2",
          application_id: "app-2",
          build_id: "build-2",
          platform: :android,
          attempt: 2,
          fence: 2
        ] do
      ref = Map.put(build.active_ref, key, value)

      assert {:error, :stale_worker_ref} =
               Lifecycle.transition(build, "wrong-#{key}", success(ref), 2),
             inspect(key)

      assert {:error, :stale_worker_ref} =
               Lifecycle.transition(build, "stop-#{key}", stop(ref), 2),
             inspect(key)
    end
  end

  test "duplicates ignore delivery time, preserve first observation, and never revert newer attempts" do
    build = running()
    event = failure(build.active_ref)
    failed = apply!(build, "outcome", event, 2)
    next = apply!(failed, "retry", %{type: :retry}, 12)
    next = running(next, 13)
    done = apply!(next, "success", success(next.active_ref), 14)
    assert {:ok, ^done, :duplicate} = Lifecycle.transition(done, "outcome", event, 99_999)
    assert {:ok, ^done, :duplicate} = Lifecycle.transition(done, "outcome", event, -1)
    assert done.events["outcome"].first_observed_at == 2
    assert done.observed_at == 14

    assert {:error, :event_conflict} =
             Lifecycle.transition(done, "outcome", success(build.active_ref), 15)

    assert {:error, :event_conflict} =
             Lifecycle.transition(
               done,
               "success",
               Map.put(success(next.active_ref), :extra, true),
               15
             )

    assert {:error, :invalid_transition} = Lifecycle.transition(done, "new-outcome", event, 15)
  end

  test "infrastructure allowlist retries with backoff and stops at finite attempt cap" do
    for code <- [
          :worker_unavailable,
          :worker_lost,
          :dependency_transport,
          :artifact_transport,
          :worker_timeout
        ] do
      final =
        Enum.reduce(1..3, queued(), fn attempt, queued_build ->
          now = (attempt - 1) * 20 + 1
          running_build = running(queued_build, now)

          failed =
            apply!(
              running_build,
              "failed-#{attempt}",
              failure(running_build.active_ref, :infrastructure, code),
              now + 1
            )

          assert failed.state == :failed

          if attempt < 3 do
            assert {:error, :backoff_not_reached} =
                     Lifecycle.transition(failed, "too-soon", %{type: :retry}, now + 10)

            apply!(failed, "retry-#{attempt}", %{type: :retry}, now + 11)
          else
            assert {:error, :attempt_limit} =
                     Lifecycle.transition(failed, "retry-final", %{type: :retry}, now + 11)

            assert {:ok, %{retryable: false, retry_blocked: :attempt_limit}} =
                     Lifecycle.customer_status(failed)

            failed
          end
        end)

      assert Enum.map(final.history, & &1.attempt) == [1, 2, 3]
      assert length(final.history) == 3
      assert final.spec == queued().spec
    end
  end

  test "compiler, test, policy and unknown failures never blindly retry" do
    for {class, code} <- [
          compiler: :compiler_error,
          test: :test_failure,
          policy: :policy_rejection,
          policy: :invalid_input,
          unknown: :unknown_failure
        ] do
      build = running()
      done = apply!(build, "failed", failure(build.active_ref, class, code), 2)
      assert done.state == :failed
      assert done.failure.diagnostic_sha256 == sha(200)
      assert done.retry_after == nil

      assert {:error, :non_retryable_failure} =
               Lifecycle.transition(done, "retry", %{type: :retry}, 20)

      assert {:ok, %{retryable: false, retry_blocked: :non_retryable_failure}} =
               Lifecycle.customer_status(done)
    end
  end

  test "a deadline cannot turn known nonretryable failure reports into infrastructure retries" do
    for {class, code} <- [
          compiler: :compiler_error,
          test: :test_failure,
          policy: :policy_rejection,
          unknown: :unknown_failure
        ] do
      running_build = running()
      ref = running_build.active_ref
      reconciling = apply!(running_build, "expire", %{type: :expire, ref: ref}, 101)

      for build <- [running_build, reconciling] do
        done = apply!(build, "late-failure", failure(ref, class, code), 102)
        assert done.state == :timed_out
        assert done.failure == %{class: class, code: code, diagnostic_sha256: sha(200)}
        assert done.retry_after == nil

        assert {:error, :non_retryable_failure} =
                 Lifecycle.transition(done, "retry", %{type: :retry}, 112)
      end
    end
  end

  test "closed event, failure and artifact input rejects unsupported or mutable result contracts" do
    build = running()
    ref = build.active_ref
    success_event = success(ref)
    refs = artifacts()

    bad_refs = [
      tl(refs),
      refs ++ [hd(refs)],
      [nil | tl(refs)],
      [%{hd(refs) | kind: :signed_release} | tl(refs)],
      [%{hd(refs) | size_bytes: 0} | tl(refs)],
      [%{hd(refs) | size_bytes: @max_time + 1} | tl(refs)],
      [%{hd(refs) | sha256: sha(2)} | tl(refs)],
      [Map.put(hd(refs), :url, "https://mutable.invalid/latest") | tl(refs)],
      Enum.map(refs, &Map.from_struct/1),
      [hd(refs) | :bad_tail]
    ]

    for bad <- bad_refs do
      event = put_in(success_event, [:result, :artifacts], bad)
      assert {:error, :invalid_event} = Lifecycle.transition(build, "bad", event, 2), inspect(bad)
    end

    invalid = [
      nil,
      [],
      %{},
      %{type: :unknown},
      %{type: :retry, extra: true},
      Map.put(success_event, :unknown, true),
      Map.delete(success_event, :ref),
      %{type: :cancel, reason: ""},
      %{type: :cancel, reason: String.duplicate("x", 513)},
      %{type: :start, ref: Map.from_struct(ref)},
      %{type: :start, ref: Map.put(ref, :extra, true)},
      %{type: :start, ref: Map.delete(ref, :fence)},
      %{type: :stopped, ref: ref, diagnostic_sha256: "url"},
      put_in(failure(ref), [:result, :class], :new_class),
      put_in(failure(ref), [:result, :code], :compiler_error),
      put_in(failure(ref), [:result, :diagnostic_sha256], nil),
      put_in(success_event, [:result, :outcome], :uploaded)
    ]

    for event <- invalid do
      assert {:error, :invalid_event} = Lifecycle.transition(build, "bad", event, 2),
             inspect(event)
    end

    for id <- [nil, "", String.duplicate("x", 129)] do
      assert {:error, :invalid_event_id} = Lifecycle.transition(build, id, success_event, 2)
    end
  end

  test "distinct output roles may content-address identical bytes with the same recorded size" do
    build = running()
    [first, second | rest] = artifacts()
    shared = %{first | sha256: second.sha256, size_bytes: second.size_bytes}
    event = put_in(success(build.active_ref), [:result, :artifacts], [shared, second | rest])
    done = apply!(build, "success", event, 2)
    assert done.state == :succeeded
    assert done.artifacts == [shared, second | rest]
  end

  test "new events require bounded monotonic time and safe deadline, backoff and fence arithmetic" do
    build = running()

    for now <- [0, -1, @max_time + 1, 1.0, nil] do
      assert {:error, :invalid_observation_time} =
               Lifecycle.transition(build, "event", success(build.active_ref), now)
    end

    queued_build = queued(spec(), policy(), @max_time - 1)
    {:ok, ref} = Lifecycle.worker_ref(queued_build)

    assert {:error, :time_overflow} =
             Lifecycle.transition(queued_build, "start", %{type: :start, ref: ref}, @max_time - 1)

    edge_policy = %{max_attempts: 2, timeout_ms: 1, retry_backoff_ms: 10}
    edge = queued(spec(), edge_policy, @max_time - 2) |> running(@max_time - 2)
    done = apply!(edge, "observed", failure(edge.active_ref), @max_time - 2)
    assert done.state == :failed
    assert done.retry_after == nil

    assert {:ok, %{retryable: false, retry_blocked: :time_overflow}} =
             Lifecycle.customer_status(done)

    assert {:error, :time_overflow} =
             Lifecycle.transition(done, "retry", %{type: :retry}, @max_time)

    max_fence = %{build | fence: @max_time, active_ref: %{build.active_ref | fence: @max_time}}
    assert {:error, :time_overflow} = Lifecycle.transition(max_fence, "cancel", cancel(), 2)

    assert {:error, :time_overflow} =
             Lifecycle.transition(max_fence, "success", success(max_fence.active_ref), 2)
  end

  test "explicit event ceiling rejects without mutation while recorded exact duplicates remain readable" do
    build = running()
    payload = %{type: :cancel, reason: "Recorded synthetic boundary event"}

    events =
      for i <- 1..32, into: %{}, do: {"event-#{i}", %{payload: payload, first_observed_at: 1}}

    full = %{build | events: events}
    assert {:error, :event_limit} = Lifecycle.transition(full, "new", success(full.active_ref), 2)
    assert {:ok, ^full, :duplicate} = Lifecycle.transition(full, "event-1", payload, 999)
    assert {:error, :event_conflict} = Lifecycle.transition(full, "event-1", cancel(), 999)
    assert map_size(full.events) == 32
  end

  test "per-platform customer projection preserves a failure and never invents measured queue data" do
    ios = running() |> then(&apply!(&1, "ok", success(&1.active_ref), 2))
    android_spec = Map.merge(spec(), %{platform: :android, build_id: "build-android"})

    android =
      queued(android_spec)
      |> running()
      |> then(&apply!(&1, "fail", failure(&1.active_ref, :compiler, :compiler_error), 2))

    assert {:ok, %{platform: :ios, state: :succeeded}} = Lifecycle.customer_status(ios)

    assert {:ok, %{platform: :android, state: :failed, artifacts: nil} = status} =
             Lifecycle.customer_status(android)

    for key <- [
          :queue_position,
          :estimated_wait,
          :release_status,
          :signed,
          :charge,
          :aggregate_success
        ] do
      refute Map.has_key?(status, key)
    end
  end

  test "every state accepts only its explicit event set" do
    queued_build = queued()
    running_build = running(queued_build)
    ref = running_build.active_ref
    cancelling = apply!(running_build, "cancel", cancel(), 2)
    reconciling = apply!(running_build, "expire", %{type: :expire, ref: ref}, 101)
    succeeded = apply!(running_build, "done", success(ref), 2)
    failed = apply!(running_build, "failed", failure(ref), 2)
    cancelled = apply!(cancelling, "stopped", stop(ref), 3)
    timed_out = apply!(reconciling, "stopped", stop(ref), 102)

    allowed = %{
      queued: [:start, :cancel],
      running: [:cancel, :expire, :success, :failure, :stopped],
      cancelling: [:success, :failure, :stopped],
      reconciling: [:cancel, :success, :failure, :stopped],
      succeeded: [],
      failed: [:retry],
      cancelled: [],
      timed_out: [:retry]
    }

    events = %{
      start: %{type: :start, ref: ref},
      cancel: cancel(),
      expire: %{type: :expire, ref: ref},
      success: success(ref),
      failure: failure(ref),
      stopped: stop(ref),
      retry: %{type: :retry}
    }

    for build <- [
          queued_build,
          running_build,
          cancelling,
          reconciling,
          succeeded,
          failed,
          cancelled,
          timed_out
        ],
        {name, event} <- events do
      result = Lifecycle.transition(build, "matrix-#{name}", event, 112)

      if name in allowed[build.state] do
        assert match?({:ok, _, :applied}, result), inspect({build.state, name, result})
      else
        assert result == {:error, :invalid_transition}, inspect({build.state, name, result})
      end
    end
  end

  test "five attempts require at most twenty accepted transitions, below the hard ledger ceiling" do
    initial = queued(spec(), %{policy() | max_attempts: 5})

    last =
      Enum.reduce(1..4, initial, fn attempt, build ->
        now = (attempt - 1) * 200 + 1
        build = running(build, now)
        ref = build.active_ref
        build = apply!(build, "expire-#{attempt}", %{type: :expire, ref: ref}, now + 100)
        build = apply!(build, "stopped-#{attempt}", stop(ref), now + 101)
        apply!(build, "retry-#{attempt}", %{type: :retry}, now + 111)
      end)

    last = running(last, 801)
    ref = last.active_ref
    last = apply!(last, "expire-5", %{type: :expire, ref: ref}, 901)
    last = apply!(last, "cancel-5", cancel(), 902)
    last = apply!(last, "stopped-5", stop(ref), 903)

    assert {last.attempt, last.state, length(last.history), map_size(last.events)} ==
             {5, :cancelled, 5, 20}

    assert Enum.map(last.history, & &1.attempt) == [1, 2, 3, 4, 5]
  end

  test "invalid outer state returns errors rather than starting or reconstructing application services" do
    for build <- [
          nil,
          %{},
          %Build{spec: nil, policy: nil, request_key: "r", queued_at: 0, observed_at: 0},
          %{queued() | history: [:bad]},
          %{queued() | events: nil},
          %{queued() | state: :unknown}
        ] do
      assert {:error, :invalid_build} = Lifecycle.transition(build, "event", %{type: :retry}, 0)
      assert {:error, :invalid_build} = Lifecycle.worker_ref(build)
      assert {:error, :invalid_build} = Lifecycle.customer_status(build)
    end
  end

  test "bounded generated event sequences maintain state, fencing, output and no-overlap invariants" do
    # Fixed enumeration, no random seed or external property-test dependency.
    for seed <- 0..63 do
      final =
        Enum.reduce(1..40, queued(spec(), %{policy() | max_attempts: 5}), fn step, build ->
          now = step * 25
          event = generated_event(build, rem(seed * 11 + step * 7, 10))

          case Lifecycle.transition(build, "generated-#{step}", event, now) do
            {:ok, updated, :applied} ->
              assert updated.spec == build.spec
              assert updated.policy == build.policy
              assert updated.attempt >= build.attempt
              assert updated.attempt <= 5
              assert updated.fence >= build.fence
              assert map_size(updated.events) <= 32
              assert length(updated.history) <= 5

              if updated.attempt > build.attempt do
                assert build.state in [:failed, :timed_out]
                assert build.active_ref == nil
                assert updated.attempt == build.attempt + 1
                assert updated.fence > build.fence
              end

              if build.state in [:cancelling, :reconciling] and
                   updated.state in [:cancelling, :reconciling] do
                assert updated.active_ref == build.active_ref
              end

              if build.artifacts != nil, do: assert(updated.artifacts == build.artifacts)
              assert {:ok, status} = Lifecycle.customer_status(updated)

              assert status.worker_completion_pending ==
                       updated.state in [:running, :cancelling, :reconciling]

              assert {:ok, ^updated, :duplicate} =
                       Lifecycle.transition(updated, "generated-#{step}", event, now + 1_000)

              updated

            {:error, _reason} ->
              assert {:ok, _} = Lifecycle.customer_status(build)
              build
          end
        end)

      assert final.attempt <= 5
    end
  end

  defp generated_event(build, choice) do
    {:ok, ref} =
      Lifecycle.worker_ref(
        (build.state in [:queued, :running, :cancelling, :reconciling] && build) || queued()
      )

    case choice do
      0 -> %{type: :start, ref: ref}
      1 -> %{type: :expire, ref: ref}
      2 -> cancel()
      3 -> stop(ref)
      4 -> success(ref)
      5 -> failure(ref)
      6 -> failure(ref, :compiler, :compiler_error)
      7 -> %{type: :retry}
      8 -> success(%{ref | build_id: "other-build"})
      9 -> %{type: :unknown}
    end
  end
end

1e429e8b93c3ea28e65ec24d07f13aa965c20ac0 blob 13131
defmodule MixerHosted.Builds.StorageTest do
  use ExUnit.Case, async: false
  alias Ecto.Multi
  alias MixerHosted.{Repo, Test.BuildIntentWorker}
  alias MixerHosted.Builds.{Lifecycle, Record, Storage}
  @moduletag :database

  setup_all do
    repo =
      start_supervised!(
        {Repo,
         [
           hostname: "127.0.0.1",
           port: String.to_integer(System.fetch_env!("MIXER_TEST_DATABASE_PORT")),
           database: "mixer_builds_test",
           username: "mixer_fixture",
           pool_size: 6,
           ssl: false
         ]}
      )

    assert is_pid(repo)
    path = Application.app_dir(:mixer_hosted, "priv/repo/migrations")

    assert [
             20_261_024_000_000,
             20_261_025_000_000,
             20_261_025_000_001,
             20_261_025_000_002,
             20_261_025_000_003,
             20_261_025_000_004,
             20_261_025_000_005,
             20_261_025_000_006,
             20_261_025_000_007,
             20_261_025_000_008
           ] =
             Ecto.Migrator.run(Repo, path, :up, all: true)

    assert [] = Ecto.Migrator.run(Repo, path, :up, all: true)

    Repo.query!(
      "CREATE TABLE build_intent_probe (build_record_id uuid NOT NULL, revision bigint NOT NULL)"
    )

    start_supervised!({Oban, repo: Repo, queues: false, plugins: false, testing: :manual})
    :ok
  end

  setup do
    Repo.query!(
      "TRUNCATE mixer_build_coordinator_leases, mixer_build_reservations, mixer_build_capacities, mixer_builds, oban_jobs, build_intent_probe"
    )

    :ok
  end

  defp spec(overrides \\ %{}) do
    Map.merge(
      %{
        organization_id: "org-a",
        project_id: "project-a",
        application_id: "app-a",
        build_id: "build-a",
        platform: :ios,
        source: %{
          kind: :revision,
          sha256: String.duplicate("a", 64),
          reference: "repository@commit"
        },
        toolchain_lock_sha256: String.duplicate("b", 64),
        build_definition_sha256: String.duplicate("c", 64)
      },
      overrides
    )
  end

  defp policy, do: %{max_attempts: 3, timeout_ms: 100, retry_backoff_ms: 10}

  defp scope(s \\ spec()),
    do: Map.take(s, [:organization_id, :project_id, :application_id, :build_id, :platform])

  defp job(intent), do: BuildIntentWorker.new(intent)

  defp create(s \\ spec(), key \\ "request-a", now \\ 1) do
    Multi.new()
    |> Storage.create_multi(:build, s, policy(), key, now, &job/1)
    |> Repo.transaction()
  end

  defp apply_event(revision, id, event, now, s \\ scope()) do
    Multi.new()
    |> Storage.transition_multi(:build, s, revision, id, event, now, &job/1)
    |> Repo.transaction()
  end

  defp count_jobs, do: Repo.aggregate(Oban.Job, :count)

  test "actual domain and Oban rows commit together, and the test-only consumer sees the intent" do
    assert {:ok, %{{:build, :job} => persisted, build: result}} = create()
    assert result.record.revision == 0
    assert result.build.state == :queued
    assert persisted.args == result.intent
    assert persisted.queue == "builds"
    assert result.intent["attempt"] == 1 and result.intent["fence"] == 1
    assert {:ok, %{build: build}} = Storage.read(scope())
    assert build == result.build
    assert %{success: 1, failure: 0} = Oban.drain_queue(queue: :builds)
    assert %{rows: [[1]]} = Repo.query!("SELECT count(*) FROM build_intent_probe")
    assert Repo.get!(Oban.Job, persisted.id).state == "completed"
  end

  test "every scope dimension is applied to reads and transitions" do
    assert {:ok, _} = create()

    for key <- [:organization_id, :project_id, :application_id, :build_id, :platform] do
      other = Map.put(scope(), key, if(key == :platform, do: :android, else: "other"))
      assert {:error, :not_found} = Storage.read(other)

      assert {:error, :build, :not_found, _} =
               apply_event(0, "cancel", %{type: :cancel, reason: "stop"}, 2, other)
    end

    assert {:error, :invalid_scope} = Storage.read(Map.put(scope(), :role, :owner))
    assert {:error, :invalid_scope} = Storage.read(Map.put(scope(), :platform, "ios"))
    assert count_jobs() == 1
  end

  test "duplicate creation preserves first time and returns current state without invoking the job factory" do
    assert {:ok, _} = create()
    assert {:ok, _} = apply_event(0, "cancel", %{type: :cancel, reason: "stop"}, 2)

    multi =
      Storage.create_multi(Multi.new(), :build, spec(), policy(), "request-a", 999, fn _ ->
        flunk("duplicate job")
      end)

    assert {:ok, %{{:build, :job} => nil, build: result}} = Repo.transaction(multi)
    assert result.outcome == :duplicate and result.build.state == :cancelled
    assert result.record.journal["creation"]["now_ms"] == 1
    assert result.record.revision == 1 and count_jobs() == 2
  end

  test "request identity conflicts and build identity conflicts never append jobs" do
    assert {:ok, _} = create()

    assert {:error, :build, :idempotency_conflict, _} =
             create(spec(%{build_definition_sha256: String.duplicate("d", 64)}))

    assert {:error, :build, :build_conflict, _} = create(spec(), "different-request")
    assert count_jobs() == 1
    assert {:ok, _} = create(spec(%{organization_id: "other-org"}))
    assert {:ok, _} = create(spec(%{platform: :android}))
  end

  test "concurrent duplicate creates converge on one record and one job" do
    tasks = for _ <- 1..4, do: Task.async(fn -> create() end)
    results = Enum.map(tasks, &Task.await(&1, 5_000))
    assert Enum.all?(results, &match?({:ok, _}, &1))
    assert Enum.count(results, fn {:ok, %{build: b}} -> b.outcome == :applied end) == 1
    assert Repo.aggregate(Record, :count) == 1 and count_jobs() == 1
  end

  test "new events require revision CAS, while exact redelivery is idempotent at an old revision" do
    assert {:ok, %{build: created}} = create()
    {:ok, ref} = Lifecycle.worker_ref(created.build)
    event = %{type: :start, ref: ref}
    assert {:ok, %{build: started}} = apply_event(0, "start", event, 2)
    assert started.record.revision == 1

    assert {:error, :build, :stale_revision, _} =
             apply_event(0, "different", %{type: :cancel, reason: "stop"}, 3)

    assert {:ok, %{build: duplicate}} = apply_event(0, "start", event, 0)
    assert duplicate.outcome == :duplicate and duplicate.build == started.build

    assert {:error, :build, :event_conflict, _} =
             apply_event(0, "start", %{type: :cancel, reason: "stop"}, 3)

    assert count_jobs() == 2
  end

  test "concurrent start and cancellation cannot both win one revision" do
    assert {:ok, %{build: created}} = create()
    {:ok, ref} = Lifecycle.worker_ref(created.build)
    a = Task.async(fn -> apply_event(0, "start", %{type: :start, ref: ref}, 2) end)
    b = Task.async(fn -> apply_event(0, "cancel", %{type: :cancel, reason: "stop"}, 2) end)
    results = [Task.await(a), Task.await(b)]
    assert Enum.count(results, &match?({:ok, _}, &1)) == 1
    assert Enum.count(results, &match?({:error, :build, :stale_revision, _}, &1)) == 1
    assert {:ok, %{record: %{revision: 1}}} = Storage.read(scope())
    assert count_jobs() == 2
  end

  test "running cancellation keeps execution uncertain and the old active reference" do
    assert {:ok, %{build: created}} = create()
    {:ok, ref} = Lifecycle.worker_ref(created.build)
    assert {:ok, _} = apply_event(0, "start", %{type: :start, ref: ref}, 2)
    multi = Storage.cancel_multi(Multi.new(), :build, scope(), 1, "cancel", "stop", 3, &job/1)
    assert {:ok, %{build: result}} = Repo.transaction(multi)
    assert result.build.state == :cancelling and result.build.active_ref == ref
    assert result.build.fence > ref.fence
    assert {:ok, %{worker_completion_pending: true}} = Lifecycle.customer_status(result.build)

    assert {:ok, %{build: stopped}} =
             apply_event(
               2,
               "stopped",
               %{type: :stopped, ref: ref, diagnostic_sha256: String.duplicate("d", 64)},
               4
             )

    assert stopped.build.state == :cancelled and stopped.build.active_ref == nil
  end

  test "job validation failure and wrong scope binding roll back creation" do
    for factory <- [
          fn _ -> :invalid end,
          fn args -> job(Map.put(args, "project_id", "other")) end,
          fn args -> BuildIntentWorker.new(args, queue: :signing) end
        ] do
      multi = Storage.create_multi(Multi.new(), :build, spec(), policy(), "request-a", 1, factory)
      assert {:error, {:build, :job_changeset}, _, _} = Repo.transaction(multi)
      assert {:error, :not_found} = Storage.read(scope())
      assert count_jobs() == 0
    end
  end

  test "unique, replacement, historical jobs and insert callbacks cannot suppress or redirect intents" do
    factories = [
      fn args -> BuildIntentWorker.new(args, unique: [fields: [:worker]]) end,
      fn args -> BuildIntentWorker.new(args, replace: [:args]) end,
      fn args -> BuildIntentWorker.new(args, state: "completed") end,
      fn args -> BuildIntentWorker.new(args, attempt: 1) end,
      fn args -> job(args) |> Ecto.Changeset.put_change(:id, 42) end,
      fn args ->
        job(args)
        |> Ecto.Changeset.prepare_changes(fn cs -> Ecto.Changeset.put_change(cs, :args, %{}) end)
      end,
      fn args -> %{job(args) | repo_opts: [on_conflict: :nothing]} end,
      fn args ->
        cs = job(args)
        %{cs | data: Ecto.put_meta(cs.data, source: "other_jobs")}
      end
    ]

    for factory <- factories do
      multi = Storage.create_multi(Multi.new(), :build, spec(), policy(), "request-a", 1, factory)
      assert {:error, {:build, :job_changeset}, _, _} = Repo.transaction(multi)
      assert Repo.aggregate(Record, :count) == 0 and count_jobs() == 0
    end
  end

  test "job factory exception and later transaction failure roll back all earlier writes" do
    multi =
      Storage.create_multi(Multi.new(), :build, spec(), policy(), "request-a", 1, fn _ ->
        raise "factory failed"
      end)

    assert_raise RuntimeError, "factory failed", fn -> Repo.transaction(multi) end
    assert Repo.aggregate(Record, :count) == 0 and count_jobs() == 0

    multi =
      Storage.create_multi(Multi.new(), :build, spec(), policy(), "request-a", 1, &job/1)
      |> Multi.run(:later, fn _, _ -> {:error, :forced} end)

    assert {:error, :later, :forced, _} = Repo.transaction(multi)
    assert Repo.aggregate(Record, :count) == 0 and count_jobs() == 0
  end

  test "an earlier Oban insertion rolls back when a later build operation conflicts" do
    assert {:ok, _} = create()

    multi =
      Multi.new()
      |> Oban.insert(:earlier, job(%{"synthetic" => "earlier"}))
      |> Storage.create_multi(:build, spec(), policy(), "different-key", 1, &job/1)

    assert {:error, :build, :build_conflict, _} = Repo.transaction(multi)
    assert count_jobs() == 1
  end

  test "failed transition job insertion preserves prior journal, revision and job count" do
    assert {:ok, %{build: before}} = create()

    multi =
      Storage.cancel_multi(Multi.new(), :build, scope(), 0, "cancel", "stop", 2, fn _ -> :bad end)

    assert {:error, {:build, :job_changeset}, :invalid_job_changeset, _} = Repo.transaction(multi)
    assert {:ok, %{record: record, build: build}} = Storage.read(scope())
    assert record.journal == before.record.journal and record.revision == 0
    assert build == before.build and count_jobs() == 1
  end

  test "corrupt persisted journal or indexed scope disagreement fails closed" do
    assert {:ok, %{build: created}} = create()
    original = created.record.journal

    for corrupt <- [
          Map.put(original, "surprise", true),
          put_in(original, ["creation", "spec", "project_id"], "other")
        ] do
      Repo.update_all(Record, set: [journal: corrupt])
      assert {:error, :invalid_journal} = Storage.read(scope())

      assert {:error, :build, :invalid_journal, _} =
               apply_event(0, "cancel", %{type: :cancel, reason: "stop"}, 2)

      assert count_jobs() == 1
    end

    Repo.update_all(Record, set: [journal: original, revision: 1])
    assert {:error, :invalid_journal} = Storage.read(scope())
  end

  test "database round trip replays retry history and original source without process-local state" do
    assert {:ok, %{build: created}} = create()
    {:ok, ref} = Lifecycle.worker_ref(created.build)
    assert {:ok, _} = apply_event(0, "start", %{type: :start, ref: ref}, 2)

    failure = %{
      outcome: :failed,
      class: :infrastructure,
      code: :worker_lost,
      diagnostic_sha256: String.duplicate("d", 64)
    }

    assert {:ok, _} =
             apply_event(1, "complete", %{type: :completed, ref: ref, result: failure}, 3)

    assert {:ok, %{build: retry}} = apply_event(2, "retry", %{type: :retry}, 13)
    assert {:ok, loaded} = Task.async(fn -> Storage.read(scope()) end) |> Task.await()
    assert loaded.build == retry.build and loaded.build.attempt == 2
    assert loaded.build.spec == created.build.spec
    assert loaded.record.revision == 3 and count_jobs() == 4
  end
end

68f17a9048a36209d1325feac61808e383e33ae9 blob 39864
defmodule MixerHosted.CustomerArtifacts.StorageFixture.Admin do
  use Ecto.Repo, otp_app: :mixer_artifact_storage_fixture, adapter: Ecto.Adapters.Postgres
end

defmodule MixerHosted.CustomerArtifacts.StorageFixture.Migration do
  use Ecto.Repo, otp_app: :mixer_artifact_storage_fixture, adapter: Ecto.Adapters.Postgres
end

defmodule MixerHosted.CustomerArtifacts.StorageFixture.Runtime do
  use Ecto.Repo, otp_app: :mixer_artifact_storage_fixture, adapter: Ecto.Adapters.Postgres
end

defmodule MixerHosted.CustomerArtifacts.StorageFixture do
  alias MixerHosted.CustomerArtifacts.StorageFixture.{Admin, Runtime}
  alias MixerHosted.CustomerArtifacts.PostgresStorage, as: Store
  alias MixerHosted.Authorization
  alias MixerHosted.Authorization.Scope
  alias MixerHosted.Identity.VerifiedIdentity
  alias MixerHosted.Protocol.ArtifactAdmission
  def sql(sql, params \\ []), do: Ecto.Adapters.SQL.query!(Admin, sql, params, log: false)

  def runtime_sql(sql, params \\ []),
    do: Ecto.Adapters.SQL.query!(Runtime, sql, params, log: false)

  def now, do: System.system_time(:second)

  def identity(changes \\ %{}),
    do:
      struct!(
        VerifiedIdentity,
        Map.merge(
          %{
            profile_id: "profile",
            profile_version: 1,
            issuer: "https: //issuer.example",
            subject: "subject",
            client_id: "client",
            credential_ref: "token",
            issued_at: now() - 20,
            expires_at: now() + 600,
            identity_class: :human,
            scopes: ~w(mixer.artifact.upload mixer.artifact.read mixer.audit.read)
          },
          changes
        )
      )

  def target,
    do: %Scope{
      organization_id: "org-a",
      project_id: "project-a",
      application_id: "fieldlog",
      environment_id: "development"
    }

  def project, do: %{target() | application_id: nil, environment_id: nil}

  def data do
    f =
      Path.expand("../../../../services/protocol/testdata/signed-release-v3.json", __DIR__)
      |> File.read!()
      |> Jason.decode!()

    roots = Enum.map(f["roots"], &Map.update!(&1, "public_key", fn v -> Base.decode64!(v) end))
    bytes = Jason.encode!(Map.take(f, ~w(signed_manifest payload)))
    config = %{repo: Runtime, host: f["host"], roots: roots}
    {:ok, checked} = ArtifactAdmission.admit(bytes, config.host, config.roots, now())
    {checked, config}
  end

  def command(key \\ "first", reason \\ "test"),
    do: %{key: key, reason: reason, source_ip: "127.0.0.1"}

  def run(callback, i \\ identity(), a \\ "artifact.upload", t \\ target()),
    do: Authorization.with_authorized_transaction(i, a, t, callback, Runtime)

  def upload(key \\ "first", reason \\ "test", i \\ identity()) do
    {c, config} = data()
    run(fn ctx -> Store.upload(ctx, c, command(key, reason), config) end, i)
  end

  def seed! do
    sql(
      "TRUNCATE public.mixer_customer_idempotency,public.mixer_customer_audit_events,public.mixer_customer_artifacts,public.mixer_customer_artifact_heads,public.mixer_authz_profiles,public.mixer_authz_principals,public.mixer_authz_organizations CASCADE"
    )

    for query <- [
          "INSERT INTO public.mixer_authz_profiles(id,version,issuer,client_id,identity_class,active) VALUES ('profile',1,'https: //issuer.example','client','human',true)",
          "INSERT INTO public.mixer_authz_principals VALUES ('person','human',true,0,2),('other','human',true,0,2)",
          "INSERT INTO public.mixer_authz_bindings(profile_id,profile_version,subject,identity_class,principal_id,active) VALUES ('profile',1,'subject','human','person',true),('profile',1,'other-subject','human','other',true)",
          "INSERT INTO public.mixer_authz_families VALUES ('family','profile',1,'person',true,0,NULL,3),('other-family','profile',1,'other',true,0,NULL,3)",
          "INSERT INTO public.mixer_authz_credentials VALUES ('profile',1,'token','person','family',true,0,NULL,4),('profile',1,'other-token','other','other-family',true,0,NULL,4)",
          "INSERT INTO public.mixer_authz_organizations VALUES ('org-a',true)",
          "INSERT INTO public.mixer_authz_projects VALUES ('org-a','project-a',true)",
          "INSERT INTO public.mixer_authz_applications VALUES ('org-a','project-a','fieldlog',true)",
          "INSERT INTO public.mixer_authz_environments VALUES ('org-a','project-a','fieldlog','development',true)",
          "INSERT INTO public.mixer_authz_organization_heads VALUES ('org-a',5)",
          "INSERT INTO public.mixer_authz_project_heads VALUES ('org-a','project-a',6)",
          "INSERT INTO public.mixer_authz_memberships VALUES ('member','person','org-a','project-a','exact_project','developer',true,0,NULL,7),('other-member','other','org-a','project-a','exact_project','developer',true,0,NULL,7)"
        ],
        do: sql(query)

    {:ok, genesis} = MixerHosted.Audit.CustomerArtifactEvent.genesis("org-a", "project-a")

    sql("INSERT INTO public.mixer_customer_artifact_heads VALUES ('org-a','project-a',0,'',$1)", [
      genesis
    ])

    :ok
  end

  def raw(mode) do
    {checked, _} = data()

    run(fn ctx ->
      [[sequence, previous_event, previous_state]] =
        runtime_sql(
          "SELECT sequence,event_sha256,state_sha256 FROM public.mixer_customer_artifact_heads FOR UPDATE"
        ).rows

      fresh =
        MixerHosted.Authorization.Transaction.Context.checkpoint!(
          ctx,
          Runtime,
          "artifact.upload",
          target()
        )

      artifact = %{
        organization_id: "org-a",
        project_id: "project-a",
        application_id: "fieldlog",
        environment_id: "development",
        platform: checked.target["platform"],
        runtime_sha256: checked.target["runtime"],
        manifest_sha256: checked.manifest_sha256,
        payload_sha256: checked.payload_sha256,
        envelope_sha256: sha(checked.envelope_bytes)
      }

      {:ok, event} =
        MixerHosted.Audit.CustomerArtifactEvent.build(
          ctx.identity,
          ctx.snapshot,
          fresh,
          artifact,
          %{
            sequence: sequence + 1,
            previous_state_sha256: previous_state,
            previous_event_sha256: previous_event,
            outcome: "created",
            reason: "raw",
            source_ip: nil
          }
        )

      display =
        case mode do
          :string_schema ->
            Map.put(event.display, "audit_schema", "2")

          :wrong_actor ->
            put_in(event.display, ["actor", Access.at(5)], String.duplicate("a", 64))

          :wrong_authorization ->
            put_in(event.display, ["authorization", Access.at(2), Access.at(0)], 99)

          _ ->
            event.display
        end

      fields =
        ~w(audit_schema sequence tenant actor authorization target action outcome reason request_id source_ip recorded_at previous_state_sha256 current_state_sha256 previous_event_sha256 request_sha256 envelope_sha256)

      {:ok, cbor} =
        MixerHosted.Protocol.ArtifactCBOR.encode(Enum.map(fields, &Map.fetch!(display, &1)))

      event_hash = sha("mixer.hosted.customer.audit.v2\0" <> cbor)
      display = Map.put(display, "event_sha256", event_hash)

      values = [
        "org-a",
        "project-a",
        "fieldlog",
        "development",
        artifact.platform,
        artifact.runtime_sha256,
        artifact.manifest_sha256,
        artifact.payload_sha256,
        artifact.envelope_sha256,
        checked.envelope_bytes,
        checked.signed_manifest_bytes,
        checked.canonical_manifest_cbor,
        checked.signature,
        checked.payload,
        sequence + 1
      ]

      values =
        case mode do
          :wrong_payload -> List.replace_at(values, 13, checked.payload <> "x")
          :wrong_signature -> List.replace_at(values, 12, <<0::512>>)
          :wrong_canonical -> List.replace_at(values, 11, checked.canonical_manifest_cbor <> "x")
          :wrong_signed_bytes -> List.replace_at(values, 10, checked.signed_manifest_bytes <> " ")
          :wrong_envelope -> List.replace_at(values, 9, checked.envelope_bytes <> " ")
          :wrong_manifest_hash -> List.replace_at(values, 6, String.duplicate("a", 64))
          :cross_tenant -> List.replace_at(values, 0, "foreign")
          _ -> values
        end

      unless mode in [:event_only, :dedup_only, :no_artifact] do
        insert(
          "mixer_customer_artifacts",
          ~w(organization_id project_id application_id environment_id platform runtime_sha256 manifest_sha256 payload_sha256 envelope_sha256 envelope_bytes signed_manifest_bytes canonical_manifest_cbor signature payload creating_sequence),
          values
        )
      end

      unless mode in [:artifact_only, :dedup_only, :no_event] do
        insert(
          "mixer_customer_audit_events",
          ~w(organization_id project_id sequence manifest_sha256 audit_schema event_cbor event_sha256 previous_event_sha256 previous_state_sha256 current_state_sha256 display),
          [
            "org-a",
            "project-a",
            sequence + 1,
            artifact.manifest_sha256,
            2,
            if(mode == :wrong_event_cbor, do: <<128>>, else: cbor),
            event_hash,
            if(mode == :broken_predecessor, do: String.duplicate("a", 64), else: previous_event),
            previous_state,
            display["current_state_sha256"],
            if(mode == :wrong_projection,
              do: Map.put(display, "reason", "changed"),
              else: display
            )
          ]
        )
      end

      unless mode in [:artifact_only, :event_only, :no_dedup] do
        insert(
          "mixer_customer_idempotency",
          ~w(organization_id project_id key principal_id action application_id environment_id manifest_sha256 request_sha256 event_sequence status payload_sha256),
          [
            "org-a",
            "project-a",
            "raw",
            fresh.principal.id,
            "artifact.upload",
            "fieldlog",
            "development",
            artifact.manifest_sha256,
            display["request_sha256"],
            sequence + 1,
            201,
            artifact.payload_sha256
          ]
        )
      end

      unless mode in [:artifact_only, :event_only, :dedup_only, :no_head] do
        runtime_sql(
          "UPDATE public.mixer_customer_artifact_heads SET sequence=$1,event_sha256=$2,state_sha256=$3",
          [
            if(mode == :sequence_gap, do: sequence + 2, else: sequence + 1),
            event_hash,
            display["current_state_sha256"]
          ]
        )
      end

      {:ok, :raw}
    end)
  end

  defp insert(table, columns, values),
    do:
      runtime_sql(
        "INSERT INTO public.#{table} (#{Enum.join(columns, ",")}) VALUES (#{Enum.map_join(1..length(columns), ",", &"$#{&1}")})",
        values
      )

  defp sha(b), do: Base.encode16(:crypto.hash(:sha256, b), case: :lower)

  def counts,
    do:
      sql(
        "SELECT (SELECT count(*) FROM public.mixer_customer_artifacts),(SELECT count(*) FROM public.mixer_customer_audit_events),(SELECT count(*) FROM public.mixer_customer_idempotency),(SELECT sequence FROM public.mixer_customer_artifact_heads)"
      ).rows
end

defmodule MixerHosted.CustomerArtifacts.PostgresStorageTest do
  use ExUnit.Case, async: false
  @moduletag :customer_artifact_storage_db
  alias MixerHosted.Authorization.Transaction.Context
  alias MixerHosted.CustomerArtifacts.{PostgresStorage, Schema, Topology}
  alias MixerHosted.CustomerArtifacts.StorageFixture, as: F
  alias MixerHosted.CustomerArtifacts.StorageFixture.{Admin, Migration, Runtime}
  alias MixerHosted.Protocol.{ArtifactAdmission, ArtifactCBOR}

  setup_all do
    settings = [
      hostname: "127.0.0.1",
      port: String.to_integer(System.fetch_env!("MIXER_ARTIFACT_STORAGE_TEST_PORT")),
      database: "mixer_customer_artifact_storage",
      ssl: false,
      log: false
    ]

    start_supervised!({Admin, settings ++ [username: "storage_fixture_admin", pool_size: 4]})

    start_supervised!(
      {Migration,
       settings ++
         [
           username: "storage_fixture_admin",
           pool_size: 2,
           after_connect: fn c -> Postgrex.query!(c, "SET ROLE storage_owner", []) end
         ]}
    )

    start_supervised!({Runtime, settings ++ [username: "storage_runtime", pool_size: 4]})

    for file <-
          ~w(20261025000003_add_customer_authorization.exs 20261025000004_add_authorization_state_revisions.exs 20261025000005_add_customer_artifact_storage.exs) do
      module =
        case file do
          "20261025000003_add_customer_authorization.exs" ->
            MixerHosted.Repo.Migrations.AddCustomerAuthorization

          "20261025000004_add_authorization_state_revisions.exs" ->
            MixerHosted.Repo.Migrations.AddAuthorizationStateRevisions

          _ ->
            MixerHosted.Repo.Migrations.AddCustomerArtifactStorage
        end

      unless Code.ensure_loaded?(module),
        do: Code.require_file(Path.expand("../../../priv/repo/migrations/" <> file, __DIR__))
    end

    for {version, module} <- [
          {20_261_025_000_003, MixerHosted.Repo.Migrations.AddCustomerAuthorization},
          {20_261_025_000_004, MixerHosted.Repo.Migrations.AddAuthorizationStateRevisions},
          {20_261_025_000_005, MixerHosted.Repo.Migrations.AddCustomerArtifactStorage}
        ] do
      assert :ok = Ecto.Migrator.up(Migration, version, module, log: false)
    end

    # A real down/reapply exercise catches policy dependencies that an up-only
    # fixture or successful domain operations cannot reveal.
    assert :ok =
             Ecto.Migrator.down(
               Migration,
               20_261_025_000_005,
               MixerHosted.Repo.Migrations.AddCustomerArtifactStorage,
               log: false
             )

    assert [[0]] =
             F.sql(
               "SELECT count(*) FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relname=ANY($1::text[])",
               [Schema.tables()]
             ).rows

    assert [[0]] =
             F.sql(
               "SELECT count(*) FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='public' AND p.proname=ANY($1::text[])",
               [Schema.functions()]
             ).rows

    assert :ok =
             Ecto.Migrator.up(
               Migration,
               20_261_025_000_005,
               MixerHosted.Repo.Migrations.AddCustomerArtifactStorage,
               log: false
             )

    IO.puts("STORAGE MIGRATION 005 APPLY/DOWN/REAPPLY PASSED")

    for table <-
          ~w(profiles principals bindings families credentials organizations projects applications environments organization_heads project_heads memberships),
        do: F.sql("GRANT SELECT ON public.mixer_authz_#{table} TO storage_runtime")

    for table <- ~w(profiles principals families credentials organization_heads project_heads),
        do:
          F.sql("GRANT EXECUTE ON FUNCTION public.mixer_authz_lock_#{table}() TO storage_runtime")

    for table <- ~w(artifacts audit_events idempotency),
        do: F.sql("GRANT SELECT,INSERT ON public.mixer_customer_#{table} TO storage_runtime")

    F.sql(
      "GRANT SELECT,UPDATE(sequence,event_sha256,state_sha256) ON public.mixer_customer_artifact_heads TO storage_runtime"
    )

    for name <-
          ~w(mixer_customer_allowed mixer_customer_artifact_metadata mixer_customer_key_exists),
        do:
          F.sql(
            "GRANT EXECUTE ON FUNCTION public.#{name}(#{Schema.signatures()[name]}) TO storage_runtime"
          )

    IO.puts("STORAGE CATALOG SHA256 " <> Topology.catalog_hash(Admin))
    :ok
  end

  setup do
    F.seed!()
    :ok
  end

  test "create, fresh private read, immutable audit, own retry and new-key unchanged" do
    {c, config} = F.data()
    assert {:ok, %{status: 201, event_sequence: 1}} = F.upload()
    assert [[1, 1, 1, 1]] = F.counts()
    original = F.sql("SELECT * FROM public.mixer_customer_artifacts").rows
    assert {:ok, %{status: 201, event_sequence: 1}} = F.upload()
    assert [[1, 1, 1, 1]] = F.counts()

    {:ok, changed} =
      ArtifactAdmission.admit(c.envelope_bytes <> " ", config.host, config.roots, F.now())

    assert {:ok, %{status: 200, event_sequence: 2}} =
             F.run(fn ctx ->
               PostgresStorage.upload(ctx, changed, F.command("second"), config)
             end)

    assert original == F.sql("SELECT * FROM public.mixer_customer_artifacts").rows
    assert [[1, 2, 2, 2]] = F.counts()

    assert {:ok, %{envelope_bytes: bytes}} =
             F.run(
               fn ctx -> PostgresStorage.read(ctx, c.manifest_sha256, config) end,
               F.identity(),
               "artifact.read"
             )

    assert bytes == c.envelope_bytes

    assert {:ok, %{events: [created, unchanged], next_after_sequence: 2}} =
             F.run(
               fn ctx -> PostgresStorage.audit(ctx, 0, 100, config) end,
               F.identity(),
               "audit.read",
               F.project()
             )

    assert created["outcome"] == "created" and unchanged["outcome"] == "unchanged"
    assert unchanged["current_state_sha256"] == created["current_state_sha256"]

    assert {:ok, %{events: [^unchanged], next_after_sequence: 2}} =
             F.run(
               fn ctx -> PostgresStorage.audit(ctx, 1, 1, config) end,
               F.identity(),
               "audit.read",
               F.project()
             )
  end

  test "current principal exact request identity and revocation fence cached successes" do
    assert {:ok, _} = F.upload()
    assert {:error, :idempotency_conflict} = F.upload("first", "changed")
    other = F.identity(%{subject: "other-subject", credential_ref: "other-token"})
    assert {:error, :idempotency_conflict} = F.upload("first", "test", other)
    assert [[1, 1, 1, 1]] = F.counts()

    F.sql(
      "UPDATE public.mixer_authz_credentials SET active=false,revision=revision+1 WHERE reference='token'"
    )

    assert {:error, :unauthenticated} = F.upload()
    assert [[1, 1, 1, 1]] = F.counts()
  end

  test "pure lookalike changed context expiry and every forged Checked field reject" do
    {c, config} = F.data()
    assert_raise Context.Invalid, fn -> PostgresStorage.upload(%{}, c, F.command(), config) end

    for field <- Map.keys(Map.from_struct(c)) do
      assert {:error, _} =
               F.run(fn ctx ->
                 PostgresStorage.upload(ctx, Map.put(c, field, nil), F.command(), config)
               end)

      assert [[0, 0, 0, 0]] = F.counts()
    end

    assert {:error, _} =
             F.run(fn ctx ->
               PostgresStorage.upload(%{ctx | action: "artifact.read"}, c, F.command(), config)
             end)

    assert {:error, :unauthenticated} =
             F.upload("first", "test", F.identity(%{expires_at: F.now()}))
  end

  test "SQL CBOR independently matches Elixir bytes and enforces every bound" do
    {c, _} = F.data()

    values = [
      c.manifest,
      [2, "org-a", "project-a"],
      [
        true,
        false,
        23,
        24,
        255,
        256,
        65535,
        65536,
        4_294_967_295,
        4_294_967_296,
        18_446_744_073_709_551_615,
        "é",
        []
      ],
      %{"aa" => true, "b" => [1, 2]}
    ]

    for v <- values do
      {:ok, expected} = ArtifactCBOR.encode(v)
      assert [[^expected]] = F.sql("SELECT public.mixer_customer_cbor($1::jsonb)", [v]).rows
    end

    for v <- [
          List.duplicate(1, 257),
          List.duplicate(List.duplicate(1, 256), 17),
          String.duplicate("x", 65536),
          Enum.reduce(1..17, 0, fn _, x -> [x] end),
          nil,
          -1,
          1.0,
          2.0,
          1.5
        ] do
      assert_raise Postgrex.Error, fn ->
        F.sql("SELECT public.mixer_customer_cbor($1::jsonb)", [v])
      end
    end

    assert {:ok, _} = F.upload()

    [[display, cbor]] =
      F.sql("SELECT display,event_cbor FROM public.mixer_customer_audit_events").rows

    fields =
      ~w(audit_schema sequence tenant actor authorization target action outcome reason request_id source_ip recorded_at previous_state_sha256 current_state_sha256 previous_event_sha256 request_sha256 envelope_sha256)

    assert [[^cbor]] =
             F.sql("SELECT public.mixer_customer_cbor($1::jsonb)", [
               Enum.map(fields, &Map.fetch!(display, &1))
             ]).rows
  end

  test "runtime cannot mutate immutable rows provision heads mutate authz execute codec or become owner" do
    assert {:ok, _} = F.upload()

    for sql <- [
          "UPDATE public.mixer_customer_artifacts SET payload=payload",
          "DELETE FROM public.mixer_customer_audit_events",
          "TRUNCATE public.mixer_customer_idempotency",
          "INSERT INTO public.mixer_customer_artifact_heads VALUES ('org-a','project-a',0,'','x')",
          "UPDATE public.mixer_authz_memberships SET role='owner'",
          "SELECT public.mixer_customer_cbor('[]'::jsonb)",
          "SET ROLE storage_owner",
          "CREATE TABLE public.injected(id int)"
        ] do
      assert_raise Postgrex.Error, fn -> F.runtime_sql(sql) end
    end

    for table <- ~w(artifacts audit_events idempotency),
        do: assert(F.runtime_sql("SELECT * FROM public.mixer_customer_#{table}").rows == [])
  end

  test "head-only advancement and callback error exception roll back all storage" do
    {c, config} = F.data()

    assert {:error, _} =
             F.run(fn _ ->
               F.runtime_sql(
                 "UPDATE public.mixer_customer_artifact_heads SET sequence=1,event_sha256=repeat('a',64)"
               )

               {:ok, :attempted}
             end)

    assert [[0, 0, 0, 0]] = F.counts()

    assert {:error, :storage_unavailable} =
             F.run(fn ctx ->
               assert {:ok, _} = PostgresStorage.upload(ctx, c, F.command(), config)
               {:error, :storage_unavailable}
             end)

    assert [[0, 0, 0, 0]] = F.counts()

    assert {:error, _} =
             F.run(fn ctx ->
               assert {:ok, _} = PostgresStorage.upload(ctx, c, F.command(), config)
               raise "after write"
             end)

    assert [[0, 0, 0, 0]] = F.counts()
  end

  test "concurrent same key consumes one sequence and new-key unchanged operations serialize" do
    tasks = for _ <- 1..3, do: Task.async(fn -> F.upload() end)

    for task <- tasks,
        do: assert({:ok, %{status: 201, event_sequence: 1}} = Task.await(task, 10000))

    assert [[1, 1, 1, 1]] = F.counts()
    tasks = for n <- 1..3, do: Task.async(fn -> F.upload("next-#{n}") end)
    assert Enum.all?(Enum.map(tasks, &Task.await(&1, 10000)), &match?({:ok, %{status: 200}}, &1))
    assert [[1, 4, 4, 4]] = F.counts()
  end

