          head_row!(
            repo,
            "SELECT sequence,event_sha256,state_sha256 FROM public.mixer_customer_artifact_heads WHERE organization_id=$1 AND project_id=$2 FOR UPDATE",
            tenant(target),
            :storage_unavailable
          )

        fresh = Context.checkpoint!(context, repo, "artifact.upload", target)

        with {:ok, ^checked} <-
               ArtifactAdmission.recheck(checked, config.host, config.roots, fresh.checked_at) do
          artifact = artifact(checked)

          with {:ok, request_hash} <-
                 Event.request_hash(
                   Enum.map(
                     ~w(organization_id project_id application_id environment_id platform runtime_sha256 manifest_sha256 payload_sha256)a,
                     &Map.fetch!(artifact, &1)
                   ),
                   artifact.envelope_sha256,
                   command.reason
                 ) do
            own =
              query(
                repo,
                "SELECT principal_id,action,application_id,environment_id,manifest_sha256,request_sha256,event_sequence,status,payload_sha256 FROM public.mixer_customer_idempotency WHERE organization_id=$1 AND project_id=$2 AND key=$3",
                tenant(target) ++ [command.key]
              ).rows

            case own do
              [
                [
                  principal,
                  "artifact.upload",
                  app,
                  env,
                  digest,
                  ^request_hash,
                  seq,
                  status,
                  payload
                ]
              ]
              when principal == fresh.principal.id and app == target.application_id and
                     env == target.environment_id and digest == checked.manifest_sha256 ->
                effect!(context, repo, "artifact.upload", target, fn effect ->
                  with {:ok, ^checked} <-
                         ArtifactAdmission.recheck(
                           checked,
                           config.host,
                           config.roots,
                           effect.checked_at
                         ) do
                    {:ok, result(status, digest, payload, seq)}
                  else
                    _ -> {:error, :storage_unavailable}
                  end
                end)

              [] ->
                case query(repo, "SELECT public.mixer_customer_key_exists($1)", [command.key]).rows do
                  [[false]] ->
                    write_new(
                      context,
                      checked,
                      command,
                      config,
                      artifact,
                      sequence,
                      previous_event,
                      previous_state
                    )

                  _ ->
                    {:error, :idempotency_conflict}
                end

              _ ->
                {:error, :idempotency_conflict}
            end
          else
            _ -> {:error, :storage_unavailable}
          end
        else
          _ -> {:error, :storage_unavailable}
        end
      else
        _ -> {:error, :invalid_request}
      end
    end)
  end

  def read(context, digest, config) do
    protect(context, "artifact.read", config, fn repo, target, _ ->
      if ArtifactV3Policy.digest?(digest) do
        check_topology!(repo)

        case query(
               repo,
               "SELECT #{Enum.join(@artifact_columns, ",")} FROM public.mixer_customer_artifacts WHERE organization_id=$1 AND project_id=$2 AND manifest_sha256=$3",
               tenant(target) ++ [digest]
             ).rows do
          [row] ->
            retained = Map.new(Enum.zip(@artifact_columns, row))

            effect!(context, repo, "artifact.read", target, fn fresh ->
              with true <-
                     retained["application_id"] == target.application_id and
                       retained["environment_id"] == target.environment_id,
                   {:ok, checked} <-
                     ArtifactAdmission.admit(
                       retained["envelope_bytes"],
                       config.host,
                       config.roots,
                       fresh.checked_at
                     ),
                   true <- matches?(retained, checked),
                   [^row] <-
                     query(
                       repo,
                       "SELECT #{Enum.join(@artifact_columns, ",")} FROM public.mixer_customer_artifacts WHERE organization_id=$1 AND project_id=$2 AND manifest_sha256=$3",
                       tenant(target) ++ [digest]
                     ).rows do
                {:ok,
                 %{
                   envelope_bytes: checked.envelope_bytes,
                   manifest_sha256: checked.manifest_sha256,
                   payload_sha256: checked.payload_sha256
                 }}
              else
                _ -> {:error, :storage_unavailable}
              end
            end)

          [] ->
            {:error, :not_found}

          _ ->
            {:error, :storage_unavailable}
        end
      else
        {:error, :invalid_request}
      end
    end)
  end

  def audit(context, after_sequence, limit, config) do
    protect(context, "audit.read", config, fn repo, target, _ ->
      if Scope.project_only?(target) and is_integer(after_sequence) and
           after_sequence in 0..@maximum and is_integer(limit) and limit in 1..100 do
        check_topology!(repo)

        records =
          query(
            repo,
            "SELECT #{Enum.join(@event_columns, ",")} FROM public.mixer_customer_audit_events WHERE organization_id=$1 AND project_id=$2 AND sequence>$3 ORDER BY sequence LIMIT $4",
            tenant(target) ++ [after_sequence, limit]
          ).rows

        predecessor =
          if records == [] or after_sequence == 0,
            do: nil,
            else: predecessor(repo, target, after_sequence)

        effect!(context, repo, "audit.read", target, fn _ ->
          with {:ok, result} <- validate_page(records, predecessor, after_sequence) do
            {:ok,
             %{
               events: result,
               next_after_sequence:
                 if(result == [], do: after_sequence, else: List.last(result)["sequence"])
             }}
          end
        end)
      else
        {:error, :invalid_request}
      end
    end)
  end

  defp write_new(_, _, _, _, _, sequence, _, _) when sequence >= @maximum,
    do: {:error, :storage_unavailable}

  defp write_new(
         context,
         checked,
         command,
         config,
         artifact,
         sequence,
         previous_event,
         previous_state
       ) do
    repo = config.repo
    target = context.target

    existing =
      query(
        repo,
        "SELECT #{Enum.join(@artifact_columns, ",")} FROM public.mixer_customer_artifacts WHERE organization_id=$1 AND project_id=$2 AND manifest_sha256=$3",
        tenant(target) ++ [checked.manifest_sha256]
      ).rows

    outcome =
      case existing do
        [] ->
          "created"

        [row] ->
          retained = Map.new(Enum.zip(@artifact_columns, row))

          cond do
            not matches_current?(retained, config, context) ->
              :invalid

            retained["canonical_manifest_cbor"] === checked.canonical_manifest_cbor and
              retained["signature"] === checked.signature and
                retained["payload"] === checked.payload ->
              "unchanged"

            true ->
              :conflict
          end

        _ ->
          :invalid
      end

    case outcome do
      :conflict ->
        {:error, :immutable_conflict}

      :invalid ->
        {:error, :storage_unavailable}

      _ ->
        effect!(context, repo, "artifact.upload", target, fn fresh ->
          with {:ok, ^checked} <-
                 ArtifactAdmission.recheck(checked, config.host, config.roots, fresh.checked_at),
               {:ok, event} <-
                 Event.build(context.identity, context.snapshot, fresh, artifact, %{
                   sequence: sequence + 1,
                   previous_state_sha256: previous_state,
                   previous_event_sha256: previous_event,
                   outcome: outcome,
                   reason: command.reason,
                   source_ip: command.source_ip
                 }) do
            if outcome == "created" do
              values = [
                artifact.organization_id,
                artifact.project_id,
                artifact.application_id,
                artifact.environment_id,
                artifact.platform,
                artifact.runtime_sha256,
                artifact.manifest_sha256,
                artifact.payload_sha256,
                artifact.envelope_sha256,
                checked.envelope_bytes,
                checked.signed_manifest_bytes,
                checked.canonical_manifest_cbor,
                checked.signature,
                checked.payload,
                sequence + 1
              ]

              insert(repo, "mixer_customer_artifacts", @artifact_columns, values)
            end

            display = event.display

            insert(
              repo,
              "mixer_customer_audit_events",
              ~w(organization_id project_id sequence manifest_sha256 audit_schema event_cbor event_sha256 previous_event_sha256 previous_state_sha256 current_state_sha256 display),
              tenant(target) ++
                [
                  sequence + 1,
                  checked.manifest_sha256,
                  2,
                  event.event_cbor,
                  event.event_sha256,
                  previous_event,
                  previous_state,
                  display["current_state_sha256"],
                  display
                ]
            )

            status = if outcome == "created", do: 201, else: 200

            insert(
              repo,
              "mixer_customer_idempotency",
              ~w(organization_id project_id key principal_id action application_id environment_id manifest_sha256 request_sha256 event_sequence status payload_sha256),
              tenant(target) ++
                [
                  command.key,
                  fresh.principal.id,
                  "artifact.upload",
                  target.application_id,
                  target.environment_id,
                  checked.manifest_sha256,
                  display["request_sha256"],
                  sequence + 1,
                  status,
                  checked.payload_sha256
                ]
            )

            case query(
                   repo,
                   "UPDATE public.mixer_customer_artifact_heads SET sequence=$3,event_sha256=$4,state_sha256=$5 WHERE organization_id=$1 AND project_id=$2 AND sequence=$6",
                   tenant(target) ++
                     [sequence + 1, event.event_sha256, display["current_state_sha256"], sequence]
                 ).num_rows do
              1 ->
                # Force all deferred checks inside the protected effect, so a
                # constraint failure is a latched storage error before commit.
                query(repo, "SET CONSTRAINTS ALL IMMEDIATE")
                query(repo, "SET CONSTRAINTS ALL DEFERRED")

                {:ok,
                 result(status, checked.manifest_sha256, checked.payload_sha256, sequence + 1)}

              _ ->
                {:error, :storage_unavailable}
            end
          else
            _ -> {:error, :storage_unavailable}
          end
        end)
    end
  end

  defp protect(context, action, config, callback) do
    repo = if is_map(config), do: Map.get(config, :repo), else: nil
    target = if is_map(context), do: Map.get(context, :target), else: nil
    snapshot = Context.checkpoint!(context, repo, action, target)

    result =
      try do
        if valid_config?(config),
          do: callback.(repo, target, snapshot),
          else: {:error, :invalid_request}
      rescue
        error in Context.Invalid -> reraise error, __STACKTRACE__
        _ -> {:error, :storage_unavailable}
      end

    case result do
      {:error, _} -> effect!(context, repo, action, target, fn _ -> result end)
      value -> value
    end
  end

  defp effect!(context, repo, action, target, callback) do
    Context.effect!(context, repo, action, target, fn snapshot ->
      try do
        callback.(snapshot)
      rescue
        error in Context.Invalid -> reraise error, __STACKTRACE__
        _ -> {:error, :storage_unavailable}
      end
    end)
  end

  defp valid_config?(c),
    do:
      strict?(c, [:repo, :host, :roots]) and is_atom(c.repo) and ArtifactV3Policy.host?(c.host) and
        ArtifactV3Policy.roots?(c.roots)

  defp valid_command?(c),
    do:
      strict?(c, [:key, :reason, :source_ip]) and is_binary(c.key) and byte_size(c.key) in 1..128 and
        Enum.all?(
          :binary.bin_to_list(c.key),
          &(&1 in ?A..?Z or &1 in ?a..?z or &1 in ?0..?9 or &1 in [?_, ?., ?:, ?-])
        ) and is_binary(c.reason) and byte_size(c.reason) <= 512 and String.valid?(c.reason) and
        (is_nil(c.source_ip) or is_binary(c.source_ip))

  defp strict?(c, keys),
    do:
      is_map(c) and not is_struct(c) and map_size(c) == length(keys) and
        Enum.all?(keys, &Map.has_key?(c, &1))

  defp scope(c),
    do: %Scope{
      organization_id: c.target["organization"],
      project_id: c.target["project"],
      application_id: c.target["app"],
      environment_id: c.target["environment"]
    }

  defp artifact(c),
    do: %{
      organization_id: c.target["organization"],
      project_id: c.target["project"],
      application_id: c.target["app"],
      environment_id: c.target["environment"],
      platform: c.target["platform"],
      runtime_sha256: c.target["runtime"],
      manifest_sha256: c.manifest_sha256,
      payload_sha256: c.payload_sha256,
      envelope_sha256: hash(c.envelope_bytes)
    }

  defp tenant(t), do: [t.organization_id, t.project_id]
  defp hash(b), do: Base.encode16(:crypto.hash(:sha256, b), case: :lower)

  defp result(status, m, p, s),
    do: %{status: status, manifest_sha256: m, payload_sha256: p, event_sequence: s}

  defp head_row!(repo, sql, args, _reason) do
    case query(repo, sql, args).rows do
      [row] -> row
      _ -> raise "missing protected artifact head"
    end
  end

  defp query(repo, sql, args \\ []), do: Session.query!(repo, sql, args)

  defp insert(repo, table, columns, values),
    do:
      query(
        repo,
        "INSERT INTO public.#{table} (#{Enum.join(columns, ",")}) VALUES (#{Enum.map_join(1..length(columns), ",", &"$#{&1}")})",
        values
      )

  defp matches?(r, c),
    do:
      r["envelope_bytes"] === c.envelope_bytes and
        r["signed_manifest_bytes"] === c.signed_manifest_bytes and
        r["canonical_manifest_cbor"] === c.canonical_manifest_cbor and
        r["signature"] === c.signature and r["payload"] === c.payload and
        Enum.all?(artifact(c), fn {k, v} -> r[Atom.to_string(k)] === v end)

  defp matches_current?(r, config, context) do
    fresh = Context.checkpoint!(context, config.repo, "artifact.upload", context.target)

    case ArtifactAdmission.admit(r["envelope_bytes"], config.host, config.roots, fresh.checked_at) do
      {:ok, c} -> matches?(r, c)
      _ -> false
    end
  end

  defp predecessor(repo, target, n) do
    case query(
           repo,
           "SELECT #{Enum.join(@event_columns, ",")} FROM public.mixer_customer_audit_events WHERE organization_id=$1 AND project_id=$2 AND sequence=$3",
           tenant(target) ++ [n]
         ).rows do
      [r] -> record(r)
      _ -> :missing
    end
  end

  defp record([cbor, hash, display]),
    do: %{event_cbor: cbor, event_sha256: hash, display: display}

  defp validate_page(rows, predecessor, after_sequence) do
    Enum.reduce_while(rows, {:ok, [], predecessor, after_sequence}, fn row, {:ok, acc, prev, n} ->
      e = record(row)

      if e.display["sequence"] == n + 1 and Event.validate_row(e) == :ok and
           Event.validate_edge(e, prev) == :ok,
         do: {:cont, {:ok, [e.display | acc], e, n + 1}},
         else: {:halt, {:error, :storage_unavailable}}
    end)
    |> case do
      {:ok, values, _, _} -> {:ok, Enum.reverse(values)}
      _ -> {:error, :storage_unavailable}
    end
  end
end

74c1c93e4667b25d8e2e699b4a17cc807ffd43f5 blob 36518
defmodule MixerHosted.CustomerArtifacts.Schema do
  @moduledoc false
  @tables ~w(artifact_heads artifacts audit_events idempotency)
  def tables, do: Enum.map(@tables, &("mixer_customer_" <> &1))
  def functions, do: Map.keys(functions_sql()) |> Enum.sort()
  def statements, do: table_statements() ++ function_statements() ++ policies() ++ triggers()

  defp table_statements do
    [
      """
      CREATE TABLE public.mixer_customer_artifact_heads (
        organization_id text NOT NULL, project_id text NOT NULL,
        sequence bigint NOT NULL CHECK (sequence BETWEEN 0 AND 9007199254740991),
        event_sha256 text NOT NULL CHECK (event_sha256 ~ '^[0-9a-f]{64}$' OR (sequence=0 AND event_sha256='')),
        state_sha256 text NOT NULL CHECK (state_sha256 ~ '^[0-9a-f]{64}$'),
        PRIMARY KEY (organization_id,project_id),
        FOREIGN KEY (organization_id,project_id) REFERENCES public.mixer_authz_projects(organization_id,id)
      )
      """,
      """
      CREATE TABLE public.mixer_customer_artifacts (
        organization_id text NOT NULL, project_id text NOT NULL,
        application_id text NOT NULL, environment_id text NOT NULL,
        platform text NOT NULL CHECK (platform IN ('ios','android')),
        runtime_sha256 text NOT NULL CHECK (runtime_sha256 ~ '^[0-9a-f]{64}$'),
        manifest_sha256 text NOT NULL CHECK (manifest_sha256 ~ '^[0-9a-f]{64}$'),
        payload_sha256 text NOT NULL CHECK (payload_sha256 ~ '^[0-9a-f]{64}$'),
        envelope_sha256 text NOT NULL CHECK (envelope_sha256 ~ '^[0-9a-f]{64}$'),
        envelope_bytes bytea NOT NULL CHECK (octet_length(envelope_bytes) BETWEEN 1 AND 6291456),
        signed_manifest_bytes bytea NOT NULL CHECK (octet_length(signed_manifest_bytes) BETWEEN 1 AND 65536),
        canonical_manifest_cbor bytea NOT NULL CHECK (octet_length(canonical_manifest_cbor) BETWEEN 1 AND 65536),
        signature bytea NOT NULL CHECK (octet_length(signature)=64),
        payload bytea NOT NULL CHECK (octet_length(payload) BETWEEN 1 AND 4194304),
        creating_sequence bigint NOT NULL CHECK (creating_sequence BETWEEN 1 AND 9007199254740991),
        PRIMARY KEY (organization_id,project_id,manifest_sha256),
        FOREIGN KEY (organization_id,project_id,application_id,environment_id)
          REFERENCES public.mixer_authz_environments(organization_id,project_id,application_id,id),
        FOREIGN KEY (organization_id,project_id) REFERENCES public.mixer_customer_artifact_heads(organization_id,project_id)
      )
      """,
      """
      CREATE TABLE public.mixer_customer_audit_events (
        organization_id text NOT NULL, project_id text NOT NULL,
        sequence bigint NOT NULL CHECK (sequence BETWEEN 1 AND 9007199254740991),
        manifest_sha256 text NOT NULL CHECK (manifest_sha256 ~ '^[0-9a-f]{64}$'),
        audit_schema smallint NOT NULL CHECK (audit_schema=2),
        event_cbor bytea NOT NULL CHECK (octet_length(event_cbor) BETWEEN 1 AND 65536),
        event_sha256 text NOT NULL CHECK (event_sha256 ~ '^[0-9a-f]{64}$'),
        previous_event_sha256 text NOT NULL CHECK (previous_event_sha256 ~ '^[0-9a-f]{64}$' OR (sequence=1 AND previous_event_sha256='')),
        previous_state_sha256 text NOT NULL CHECK (previous_state_sha256 ~ '^[0-9a-f]{64}$'),
        current_state_sha256 text NOT NULL CHECK (current_state_sha256 ~ '^[0-9a-f]{64}$'),
        display jsonb NOT NULL CHECK (jsonb_typeof(display)='object' AND octet_length(display::text)<=131072),
        PRIMARY KEY (organization_id,project_id,sequence),
        FOREIGN KEY (organization_id,project_id,manifest_sha256)
          REFERENCES public.mixer_customer_artifacts(organization_id,project_id,manifest_sha256) DEFERRABLE INITIALLY DEFERRED
      )
      """,
      """
      ALTER TABLE public.mixer_customer_artifacts ADD CONSTRAINT mixer_customer_artifacts_creating_event
        FOREIGN KEY (organization_id,project_id,creating_sequence)
        REFERENCES public.mixer_customer_audit_events(organization_id,project_id,sequence) DEFERRABLE INITIALLY DEFERRED
      """,
      """
      CREATE TABLE public.mixer_customer_idempotency (
        organization_id text NOT NULL, project_id text NOT NULL,
        key text NOT NULL CHECK (octet_length(key) BETWEEN 1 AND 128 AND key ~ '^[A-Za-z0-9_.:-]+$'),
        principal_id text NOT NULL REFERENCES public.mixer_authz_principals(id),
        action text NOT NULL CHECK (action='artifact.upload'),
        application_id text NOT NULL, environment_id text NOT NULL,
        manifest_sha256 text NOT NULL CHECK (manifest_sha256 ~ '^[0-9a-f]{64}$'),
        request_sha256 text NOT NULL CHECK (request_sha256 ~ '^[0-9a-f]{64}$'),
        event_sequence bigint NOT NULL CHECK (event_sequence BETWEEN 1 AND 9007199254740991),
        status integer NOT NULL CHECK (status IN (200,201)),
        payload_sha256 text NOT NULL CHECK (payload_sha256 ~ '^[0-9a-f]{64}$'),
        PRIMARY KEY (organization_id,project_id,key),
        UNIQUE (organization_id,project_id,event_sequence),
        FOREIGN KEY (organization_id,project_id,event_sequence)
          REFERENCES public.mixer_customer_audit_events(organization_id,project_id,sequence) DEFERRABLE INITIALLY DEFERRED,
        FOREIGN KEY (organization_id,project_id,manifest_sha256)
          REFERENCES public.mixer_customer_artifacts(organization_id,project_id,manifest_sha256) DEFERRABLE INITIALLY DEFERRED,
        FOREIGN KEY (organization_id,project_id,application_id,environment_id)
          REFERENCES public.mixer_authz_environments(organization_id,project_id,application_id,id)
      )
      """
    ]
  end

  def functions_sql do
    %{
      "mixer_customer_cbor_head" =>
        {"major integer, n numeric", "bytea", "IMMUTABLE", false,
         """
         DECLARE r bytea; b integer; width integer; x numeric := n;
         BEGIN
           IF n < 0 OR n > 18446744073709551615 OR n <> trunc(n) OR major NOT IN (0,3,4,5) THEN RAISE EXCEPTION 'invalid cbor'; END IF;
           IF n < 24 THEN RETURN set_byte(decode('00','hex'),0,major*32+n::integer); END IF;
           IF n<=255 THEN width:=1; b:=24; ELSIF n<=65535 THEN width:=2; b:=25; ELSIF n<=4294967295 THEN width:=4; b:=26; ELSE width:=8; b:=27; END IF;
           r:=set_byte(decode(repeat('00',width+1),'hex'),0,major*32+b);
           FOR i IN REVERSE width..1 LOOP r:=set_byte(r,i,mod(x,256)::integer); x:=div(x,256); END LOOP;
           RETURN r;
         END
         """},
      "mixer_customer_cbor_part" =>
        {"v jsonb, depth integer, remaining integer", "TABLE(encoded bytea, items integer)",
         "IMMUTABLE", false,
         """
         DECLARE kind text := jsonb_typeof(v); result bytea; count integer:=1; n integer; part record; pair record; val jsonb;
         BEGIN
           IF depth>16 OR remaining<1 THEN RAISE EXCEPTION 'cbor limit'; END IF;
           IF kind='string' THEN result:=convert_to(v#>>'{}','UTF8'); result:=public.mixer_customer_cbor_head(3,octet_length(result))||result;
           ELSIF kind='number' THEN
             IF v::text !~ '^(0|[1-9][0-9]*)$' THEN RAISE EXCEPTION 'non-integer cbor number'; END IF;
             result:=public.mixer_customer_cbor_head(0,(v#>>'{}')::numeric);
           ELSIF kind='boolean' THEN result:=CASE WHEN v='true'::jsonb THEN decode('f5','hex') ELSE decode('f4','hex') END;
           ELSIF kind='array' THEN
             n:=jsonb_array_length(v); IF n>256 THEN RAISE EXCEPTION 'cbor container'; END IF;
             result:=public.mixer_customer_cbor_head(4,n);
             FOR val IN SELECT value FROM jsonb_array_elements(v) LOOP
               SELECT * INTO STRICT part FROM public.mixer_customer_cbor_part(val,depth+1,remaining-count);
               count:=count+part.items; result:=result||part.encoded;
               IF octet_length(result)>65536 THEN RAISE EXCEPTION 'cbor output'; END IF;
             END LOOP;
           ELSIF kind='object' THEN
             SELECT count(*) INTO n FROM jsonb_each(v); IF n>256 THEN RAISE EXCEPTION 'cbor container'; END IF;
             result:=public.mixer_customer_cbor_head(5,n);
             FOR pair IN SELECT key,value, public.mixer_customer_cbor_head(3,octet_length(convert_to(key,'UTF8')))||convert_to(key,'UTF8') AS k FROM jsonb_each(v) ORDER BY k LOOP
               IF depth+1>16 OR count+1>=remaining THEN RAISE EXCEPTION 'cbor items'; END IF;
               count:=count+1; result:=result||pair.k;
               SELECT * INTO STRICT part FROM public.mixer_customer_cbor_part(pair.value,depth+1,remaining-count);
               count:=count+part.items; result:=result||part.encoded;
               IF octet_length(result)>65536 THEN RAISE EXCEPTION 'cbor output'; END IF;
             END LOOP;
           ELSE RAISE EXCEPTION 'invalid cbor value'; END IF;
           IF count>remaining OR octet_length(result)>65536 THEN RAISE EXCEPTION 'cbor limit'; END IF;
           RETURN QUERY SELECT result,count;
         END
         """},
      "mixer_customer_cbor" =>
        {"v jsonb", "bytea", "IMMUTABLE", false,
         """
         DECLARE b bytea;
         BEGIN SELECT encoded INTO STRICT b FROM public.mixer_customer_cbor_part(v,0,4096); RETURN b; END
         """},
      "mixer_customer_hash" =>
        {"domain text, v jsonb", "text", "IMMUTABLE", false,
         """
         BEGIN RETURN encode(sha256(convert_to(domain,'UTF8')||decode('00','hex')||public.mixer_customer_cbor(v)),'hex'); END
         """},
      "mixer_customer_allowed" =>
        {"org text, proj text, app text, env text, requested text, metadata boolean", "boolean",
         "STABLE", false, allowed_body()},
      "mixer_customer_artifact_metadata" =>
        {"digest text",
         "TABLE(organization_id text,project_id text,application_id text,environment_id text,platform text,runtime_sha256 text,manifest_sha256 text,signed_manifest_bytes bytea)",
         "STABLE", true,
         """
         BEGIN
           IF digest IS NULL OR digest !~ '^[0-9a-f]{64}$' OR current_setting('mixer.authz.phase',true) IS DISTINCT FROM 'metadata'
             OR coalesce(current_setting('mixer.authz.application_id',true),'')<>'' OR coalesce(current_setting('mixer.authz.environment_id',true),'')<>'' THEN RETURN; END IF;
           RETURN QUERY SELECT a.organization_id,a.project_id,a.application_id,a.environment_id,a.platform,a.runtime_sha256,a.manifest_sha256,a.signed_manifest_bytes
             FROM public.mixer_customer_artifacts a WHERE a.manifest_sha256=digest
             AND public.mixer_customer_allowed(a.organization_id,a.project_id,'','', 'artifact.read',true);
         END
         """},
      "mixer_customer_key_exists" =>
        {"candidate text", "boolean", "STABLE", true,
         """
         BEGIN
           IF candidate IS NULL OR octet_length(candidate) NOT BETWEEN 1 AND 128 OR candidate !~ '^[A-Za-z0-9_.:-]+$'
             OR NOT public.mixer_customer_allowed(current_setting('mixer.authz.organization_id',true),current_setting('mixer.authz.project_id',true),current_setting('mixer.authz.application_id',true),current_setting('mixer.authz.environment_id',true),'artifact.upload',false)
             THEN RETURN false; END IF;
           RETURN EXISTS (SELECT 1 FROM public.mixer_customer_idempotency d WHERE d.organization_id=current_setting('mixer.authz.organization_id',true) AND d.project_id=current_setting('mixer.authz.project_id',true) AND d.key=candidate);
         END
         """},
      "mixer_customer_json_shape" =>
        {"v json, depth integer, remaining integer", "integer", "IMMUTABLE", false,
         """
         DECLARE kind text:=json_typeof(v); val json; pair record; count integer:=1; n integer;
         BEGIN
           IF depth>16 OR remaining<1 THEN RAISE EXCEPTION 'json limit'; END IF;
           IF kind='object' THEN
             SELECT count(*),count(DISTINCT key) INTO n,count FROM json_each(v);
             IF n<>count OR n>256 THEN RAISE EXCEPTION 'json keys'; END IF; count:=1;
             FOR pair IN SELECT key,value FROM json_each(v) LOOP
               IF depth+1>16 OR octet_length(convert_to(pair.key,'UTF8'))>65536 THEN RAISE EXCEPTION 'json key'; END IF;
               count:=count+1+public.mixer_customer_json_shape(pair.value,depth+1,remaining-count-1);
             END LOOP;
           ELSIF kind='array' THEN
             n:=json_array_length(v); IF n>256 THEN RAISE EXCEPTION 'json container'; END IF;
             FOR val IN SELECT value FROM json_array_elements(v) LOOP count:=count+public.mixer_customer_json_shape(val,depth+1,remaining-count); END LOOP;
           ELSIF kind='string' THEN IF octet_length(convert_to(v#>>'{}','UTF8'))>65536 THEN RAISE EXCEPTION 'json string'; END IF;
           ELSIF kind='number' THEN IF v::text !~ '^(0|[1-9][0-9]*)$' OR length(v::text)>20 OR v::text::numeric>18446744073709551615 THEN RAISE EXCEPTION 'json numeric'; END IF;
           ELSIF kind<>'boolean' THEN RAISE EXCEPTION 'json kind'; END IF;
           IF count>remaining THEN RAISE EXCEPTION 'json items'; END IF; RETURN count;
         END
         """},
      "mixer_customer_event_identity" =>
        {"v jsonb", "boolean", "STABLE", false,
         """
         DECLARE actor jsonb; authority jsonb; members jsonb; t bigint; locked bigint; r record; ip text;
         BEGIN
           IF jsonb_typeof(v->'recorded_at')<>'number' OR jsonb_typeof(v->'authorization'->0)<>'number' OR jsonb_typeof(v->'reason')<>'string'
             OR jsonb_typeof(v->'source_ip')<>'array' OR jsonb_array_length(v->'source_ip')>1 THEN RETURN false; END IF;
           t:=(v->>'recorded_at')::bigint; locked:=(v->'authorization'->>0)::bigint;
           IF t<0 OR t>9007199254740991 OR locked<0 OR locked>t OR t>locked+5 OR t>extract(epoch FROM statement_timestamp()) OR t<extract(epoch FROM statement_timestamp())-5 THEN RETURN false; END IF;
           IF jsonb_array_length(v->'source_ip')=1 THEN
             IF jsonb_typeof(v->'source_ip'->0)<>'string' THEN RETURN false; END IF;
             ip:=v->'source_ip'->>0;
             IF octet_length(ip)>45 OR position('/' IN ip)>0 OR host(ip::inet)<>ip THEN RETURN false; END IF;
           END IF;
           IF NOT public.mixer_customer_allowed(v->'tenant'->>0,v->'tenant'->>1,v->'target'->>2,v->'target'->>3,'artifact.upload',false) THEN RETURN false; END IF;
           SELECT pf.id AS profile,pf.version,pf.issuer,pf.client_id,pf.state_revision,b.subject,b.revision AS binding_revision,
             pr.id AS principal,pr.revision AS principal_revision,pr.not_before AS principal_start,
             c.reference,c.revision AS credential_revision,c.not_before AS credential_start,c.expires_at AS credential_end,
             f.id AS family,f.revision AS family_revision,f.not_before AS family_start,f.expires_at AS family_end,
             oh.revision AS organization_revision,ph.revision AS project_revision
             INTO STRICT r
             FROM public.mixer_authz_profiles pf
             JOIN public.mixer_authz_bindings b ON b.profile_id=pf.id AND b.profile_version=pf.version AND b.subject=current_setting('mixer.authz.subject',true)
             JOIN public.mixer_authz_principals pr ON pr.id=b.principal_id
             JOIN public.mixer_authz_credentials c ON c.profile_id=pf.id AND c.profile_version=pf.version AND c.reference=current_setting('mixer.authz.credential_ref',true)
             JOIN public.mixer_authz_families f ON f.id=c.family_id
             JOIN public.mixer_authz_organization_heads oh ON oh.organization_id=v->'tenant'->>0
             JOIN public.mixer_authz_project_heads ph ON ph.organization_id=oh.organization_id AND ph.project_id=v->'tenant'->>1;
           actor:=jsonb_build_array(r.principal,'human',r.profile,r.version,
             public.mixer_customer_hash('mixer.hosted.customer.binding_key.v2',jsonb_build_array(r.profile,r.version,r.subject)),
             encode(sha256(convert_to('mixer.hosted.customer.issuer.v2','UTF8')||decode('00','hex')||convert_to(r.issuer,'UTF8')),'hex'),
             encode(sha256(convert_to('mixer.hosted.customer.subject.v2','UTF8')||decode('00','hex')||convert_to(r.subject,'UTF8')),'hex'),
             encode(sha256(convert_to('mixer.hosted.customer.client.v2','UTF8')||decode('00','hex')||convert_to(r.client_id,'UTF8')),'hex'),
             encode(sha256(convert_to('mixer.hosted.customer.credential_ref.v2','UTF8')||decode('00','hex')||convert_to(r.reference,'UTF8')),'hex'),
             r.family,current_setting('mixer.authz.token_issued_at',true)::bigint,current_setting('mixer.authz.token_expires_at',true)::bigint);
           SELECT jsonb_agg(jsonb_build_array(m.id,m.role,m.revision,m.organization_id,CASE WHEN m.project_id IS NULL THEN '[]'::jsonb ELSE jsonb_build_array(m.project_id) END,m.project_binding,true,m.not_before,CASE WHEN m.expires_at IS NULL THEN '[]'::jsonb ELSE jsonb_build_array(m.expires_at) END) ORDER BY convert_to(m.id,'UTF8')) INTO members
             FROM public.mixer_authz_memberships m WHERE m.principal_id=r.principal AND m.organization_id=v->'tenant'->>0 AND m.active
             AND m.not_before<=t AND (m.expires_at IS NULL OR t<m.expires_at) AND m.role IN ('owner','administrator','developer')
             AND ((m.project_binding='all_projects' AND m.project_id IS NULL) OR (m.project_binding='exact_project' AND m.project_id=v->'tenant'->>1));
           IF members IS NULL OR jsonb_array_length(members) NOT BETWEEN 1 AND 64 THEN RETURN false; END IF;
           authority:=jsonb_build_array(locked,t,jsonb_build_array(r.state_revision,true),jsonb_build_array(r.binding_revision,true),
             jsonb_build_array(r.principal_revision,true,r.principal_start),jsonb_build_array(r.credential_revision,true,r.credential_start,CASE WHEN r.credential_end IS NULL THEN '[]'::jsonb ELSE jsonb_build_array(r.credential_end) END),
             jsonb_build_array(r.family_revision,true,r.family_start,CASE WHEN r.family_end IS NULL THEN '[]'::jsonb ELSE jsonb_build_array(r.family_end) END),r.organization_revision,r.project_revision,'mixer.artifact.upload',members);
           RETURN v->'actor'=actor AND v->'authorization'=authority;
         END
         """},
      "mixer_customer_immutable" =>
        {"", "trigger", "VOLATILE", false,
         "BEGIN RAISE EXCEPTION 'immutable customer ledger'; END"},
      "mixer_customer_integrity" => {"", "trigger", "VOLATILE", true, integrity_body()}
    }
  end

  def signatures do
    %{
      "mixer_customer_cbor_head" => "integer,numeric",
      "mixer_customer_cbor_part" => "jsonb,integer,integer",
      "mixer_customer_cbor" => "jsonb",
      "mixer_customer_hash" => "text,jsonb",
      "mixer_customer_allowed" => "text,text,text,text,text,boolean",
      "mixer_customer_artifact_metadata" => "text",
      "mixer_customer_key_exists" => "text",
      "mixer_customer_json_shape" => "json,integer,integer",
      "mixer_customer_event_identity" => "jsonb",
      "mixer_customer_immutable" => "",
      "mixer_customer_integrity" => ""
    }
  end

  defp function_statements do
    Enum.flat_map(functions_sql(), fn {name, {args, returns, volatility, definer, body}} ->
      [
        "CREATE FUNCTION public.#{name}(#{args}) RETURNS #{returns} LANGUAGE plpgsql #{volatility} #{if definer, do: "SECURITY DEFINER", else: "SECURITY INVOKER"} SET search_path=pg_catalog AS $mixer$\n#{body}$mixer$",
        "REVOKE ALL ON FUNCTION public.#{name}(#{signatures()[name]}) FROM PUBLIC"
      ]
    end)
  end

  defp allowed_body do
    """
    DECLARE issued numeric; expiry numeric; now numeric:=extract(epoch FROM statement_timestamp());
    BEGIN
      IF current_setting('mixer.authz.identity_class',true) IS DISTINCT FROM 'human'
        OR org IS DISTINCT FROM current_setting('mixer.authz.organization_id',true)
        OR proj IS DISTINCT FROM current_setting('mixer.authz.project_id',true)
        OR requested IS DISTINCT FROM current_setting('mixer.authz.action',true)
        OR requested NOT IN ('artifact.upload','artifact.read','audit.read')
        OR current_setting('mixer.authz.required_scope',true) IS DISTINCT FROM
           (CASE requested WHEN 'artifact.upload' THEN 'mixer.artifact.upload' WHEN 'artifact.read' THEN 'mixer.artifact.read' ELSE 'mixer.audit.read' END)
        OR current_setting('mixer.authz.phase',true) IS DISTINCT FROM (CASE WHEN metadata THEN 'metadata' ELSE 'effect' END)
        OR coalesce(current_setting('mixer.authz.token_issued_at',true),'') !~ '^(0|[1-9][0-9]{0,15})$'
        OR coalesce(current_setting('mixer.authz.token_expires_at',true),'') !~ '^(0|[1-9][0-9]{0,15})$'
        THEN RETURN false; END IF;
      issued:=current_setting('mixer.authz.token_issued_at',true)::numeric;
      expiry:=current_setting('mixer.authz.token_expires_at',true)::numeric;
      IF issued>9007199254740991 OR expiry>9007199254740991 OR issued>now+30 OR expiry<=now OR issued>=expiry THEN RETURN false; END IF;
      IF NOT metadata AND requested<>'audit.read' AND
        (app IS DISTINCT FROM current_setting('mixer.authz.application_id',true) OR env IS DISTINCT FROM current_setting('mixer.authz.environment_id',true)) THEN RETURN false; END IF;
      IF requested='audit.read' AND
        (coalesce(current_setting('mixer.authz.application_id',true),'')<>'' OR coalesce(current_setting('mixer.authz.environment_id',true),'')<>'') THEN RETURN false; END IF;
      RETURN EXISTS (
        SELECT 1 FROM public.mixer_authz_profiles pf
        JOIN public.mixer_authz_bindings b ON b.profile_id=pf.id AND b.profile_version=pf.version AND b.subject=current_setting('mixer.authz.subject',true)
        JOIN public.mixer_authz_principals pr ON pr.id=b.principal_id AND pr.identity_class='human'
        JOIN public.mixer_authz_credentials c ON c.profile_id=pf.id AND c.profile_version=pf.version AND c.reference=current_setting('mixer.authz.credential_ref',true) AND c.principal_id=pr.id
        JOIN public.mixer_authz_families f ON f.id=c.family_id AND f.principal_id=pr.id AND f.profile_id=pf.id AND f.profile_version=pf.version
        JOIN public.mixer_authz_organizations o ON o.id=org
        JOIN public.mixer_authz_projects p ON p.organization_id=org AND p.id=proj
        JOIN public.mixer_authz_memberships m ON m.principal_id=pr.id AND m.organization_id=org
        WHERE pf.active AND b.active AND pr.active AND c.active AND f.active AND o.active AND p.active
          AND pf.identity_class='human' AND b.identity_class='human'
          AND pf.id=current_setting('mixer.authz.profile_id',true) AND pf.version::text=current_setting('mixer.authz.profile_version',true)
          AND pf.issuer=current_setting('mixer.authz.issuer',true) AND pf.client_id=current_setting('mixer.authz.client_id',true)
          AND pr.id=current_setting('mixer.authz.principal_id',true) AND f.id=current_setting('mixer.authz.family_id',true)
          AND pr.not_before<=now AND pr.not_before<=issued AND c.not_before<=issued AND f.not_before<=issued
          AND c.not_before<=now AND f.not_before<=now AND (c.expires_at IS NULL OR now<c.expires_at) AND (f.expires_at IS NULL OR now<f.expires_at)
          AND m.active AND m.not_before<=now AND (m.expires_at IS NULL OR now<m.expires_at)
          AND ((m.project_binding='all_projects' AND m.project_id IS NULL) OR (m.project_binding='exact_project' AND m.project_id=proj))
          AND m.role=ANY(CASE WHEN requested='artifact.upload' THEN ARRAY['owner','administrator','developer'] ELSE ARRAY['owner','administrator','developer','release_manager','viewer'] END)
          AND (metadata OR requested='audit.read' OR EXISTS (SELECT 1 FROM public.mixer_authz_applications a JOIN public.mixer_authz_environments e
            ON e.organization_id=a.organization_id AND e.project_id=a.project_id AND e.application_id=a.id
            WHERE a.organization_id=org AND a.project_id=proj AND a.id=app AND a.active AND e.id=env AND e.active))
      );
    END
    """
  end

  defp policies do
    tables = [
      "mixer_customer_artifact_heads",
      "mixer_customer_artifacts",
      "mixer_customer_audit_events",
      "mixer_customer_idempotency"
    ]

    base =
      Enum.flat_map(tables, fn table ->
        [
          "ALTER TABLE public.#{table} ENABLE ROW LEVEL SECURITY",
          "ALTER TABLE public.#{table} FORCE ROW LEVEL SECURITY",
          "REVOKE ALL ON public.#{table} FROM PUBLIC"
        ]
      end)

    owner =
      "current_user::text = (SELECT r.rolname FROM pg_catalog.pg_class c JOIN pg_catalog.pg_roles r ON r.oid=c.relowner WHERE c.oid='public.mixer_customer_artifacts'::regclass)"

    allowed =
      "public.mixer_customer_allowed(organization_id,project_id,application_id,environment_id,current_setting('mixer.authz.action',true),false)"

    base ++
      [
        "CREATE POLICY customer_integrity_owner ON public.mixer_customer_artifact_heads FOR SELECT USING (#{owner})",
        "CREATE POLICY customer_read ON public.mixer_customer_artifacts FOR SELECT USING (current_setting('mixer.authz.action',true) IN ('artifact.upload','artifact.read') AND #{allowed})",
        "CREATE POLICY customer_insert ON public.mixer_customer_artifacts FOR INSERT WITH CHECK (current_setting('mixer.authz.action',true)='artifact.upload' AND #{allowed})",
        "CREATE POLICY customer_metadata_owner ON public.mixer_customer_artifacts FOR SELECT USING (#{owner} AND current_setting('mixer.authz.phase',true)='metadata' AND public.mixer_customer_allowed(organization_id,project_id,'','','artifact.read',true))",
        "CREATE POLICY customer_integrity_owner ON public.mixer_customer_artifacts FOR SELECT USING (#{owner} AND current_setting('mixer.authz.phase',true)='effect' AND organization_id=current_setting('mixer.authz.organization_id',true) AND project_id=current_setting('mixer.authz.project_id',true))",
        "CREATE POLICY customer_read ON public.mixer_customer_artifact_heads FOR SELECT USING (public.mixer_customer_allowed(organization_id,project_id,current_setting('mixer.authz.application_id',true),current_setting('mixer.authz.environment_id',true),current_setting('mixer.authz.action',true),false))",
        "CREATE POLICY customer_transition ON public.mixer_customer_artifact_heads FOR UPDATE USING (public.mixer_customer_allowed(organization_id,project_id,current_setting('mixer.authz.application_id',true),current_setting('mixer.authz.environment_id',true),'artifact.upload',false)) WITH CHECK (public.mixer_customer_allowed(organization_id,project_id,current_setting('mixer.authz.application_id',true),current_setting('mixer.authz.environment_id',true),'artifact.upload',false))",
        "CREATE POLICY customer_read ON public.mixer_customer_audit_events FOR SELECT USING (public.mixer_customer_allowed(organization_id,project_id,'','','audit.read',false))",
        "CREATE POLICY customer_insert ON public.mixer_customer_audit_events FOR INSERT WITH CHECK (public.mixer_customer_allowed(organization_id,project_id,current_setting('mixer.authz.application_id',true),current_setting('mixer.authz.environment_id',true),'artifact.upload',false))",
        "CREATE POLICY customer_integrity_owner ON public.mixer_customer_audit_events FOR SELECT USING (#{owner} AND current_setting('mixer.authz.phase',true)='effect' AND organization_id=current_setting('mixer.authz.organization_id',true) AND project_id=current_setting('mixer.authz.project_id',true))",
        "CREATE POLICY customer_read ON public.mixer_customer_idempotency FOR SELECT USING (principal_id=current_setting('mixer.authz.principal_id',true) AND public.mixer_customer_allowed(organization_id,project_id,application_id,environment_id,'artifact.upload',false))",
        "CREATE POLICY customer_insert ON public.mixer_customer_idempotency FOR INSERT WITH CHECK (principal_id=current_setting('mixer.authz.principal_id',true) AND public.mixer_customer_allowed(organization_id,project_id,application_id,environment_id,'artifact.upload',false))",
        "CREATE POLICY customer_integrity_owner ON public.mixer_customer_idempotency FOR SELECT USING (#{owner} AND current_setting('mixer.authz.phase',true)='effect' AND organization_id=current_setting('mixer.authz.organization_id',true) AND project_id=current_setting('mixer.authz.project_id',true))"
      ]
  end

  defp triggers do
    Enum.flat_map(~w(artifacts audit_events idempotency), fn table ->
      [
        "CREATE TRIGGER customer_immutable BEFORE UPDATE OR DELETE ON public.mixer_customer_#{table} FOR EACH ROW EXECUTE FUNCTION public.mixer_customer_immutable()"
      ]
    end) ++
      Enum.map(["artifact_heads", "artifacts", "audit_events", "idempotency"], fn table ->
        "CREATE CONSTRAINT TRIGGER customer_integrity AFTER INSERT OR UPDATE ON public.mixer_customer_#{table} DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION public.mixer_customer_integrity()"
      end)
  end

  defp integrity_body do
    """
    DECLARE h record; a record; e record; d record; prev record; document jsonb; envelope json; value jsonb; expected text; expected_state text; n bigint; org text:=NEW.organization_id; proj text:=NEW.project_id;
    BEGIN
      SELECT * INTO STRICT h FROM public.mixer_customer_artifact_heads x WHERE x.organization_id=org AND x.project_id=proj;
      IF TG_TABLE_NAME='mixer_customer_artifact_heads' AND TG_OP='INSERT' AND h.sequence=0 THEN
        IF h.event_sha256<>'' OR h.state_sha256<>public.mixer_customer_hash('mixer.hosted.customer.state.v2',jsonb_build_array(2,org,proj)) THEN RAISE EXCEPTION 'invalid genesis'; END IF;
        RETURN NULL;
      END IF;
      IF TG_TABLE_NAME='mixer_customer_artifact_heads' THEN
        IF TG_OP<>'UPDATE' OR NEW.sequence<>OLD.sequence+1 THEN RAISE EXCEPTION 'invalid head transition'; END IF;
        n:=NEW.sequence;
      ELSIF TG_TABLE_NAME='mixer_customer_artifacts' THEN n:=NEW.creating_sequence;
      ELSIF TG_TABLE_NAME='mixer_customer_audit_events' THEN n:=NEW.sequence;
      ELSE n:=NEW.event_sequence; END IF;
      SELECT * INTO STRICT e FROM public.mixer_customer_audit_events x WHERE x.organization_id=org AND x.project_id=proj AND x.sequence=n;
      SELECT * INTO STRICT a FROM public.mixer_customer_artifacts x WHERE x.organization_id=org AND x.project_id=proj AND x.manifest_sha256=e.manifest_sha256;
      IF TG_TABLE_NAME='mixer_customer_artifacts' THEN
        IF NEW.manifest_sha256<>e.manifest_sha256 THEN RAISE EXCEPTION 'creating event belongs to another artifact'; END IF;
      END IF;
      SELECT * INTO STRICT d FROM public.mixer_customer_idempotency x WHERE x.organization_id=org AND x.project_id=proj AND x.event_sequence=n;
      IF h.sequence<n OR e.display->'audit_schema' IS DISTINCT FROM '2'::jsonb OR (SELECT count(*) FROM jsonb_object_keys(e.display))<>18
        OR NOT e.display ?& ARRAY['audit_schema','sequence','tenant','actor','authorization','target','action','outcome','reason','request_id','source_ip','recorded_at','previous_state_sha256','current_state_sha256','previous_event_sha256','request_sha256','envelope_sha256','event_sha256']
        THEN RAISE EXCEPTION 'invalid event projection'; END IF;
      value:=jsonb_build_array(e.display->'audit_schema',e.display->'sequence',e.display->'tenant',e.display->'actor',e.display->'authorization',e.display->'target',e.display->'action',e.display->'outcome',e.display->'reason',e.display->'request_id',e.display->'source_ip',e.display->'recorded_at',e.display->'previous_state_sha256',e.display->'current_state_sha256',e.display->'previous_event_sha256',e.display->'request_sha256',e.display->'envelope_sha256');
      IF NOT public.mixer_customer_event_identity(e.display) OR e.event_cbor<>public.mixer_customer_cbor(value)
        OR e.event_sha256<>encode(sha256(convert_to('mixer.hosted.customer.audit.v2','UTF8')||decode('00','hex')||e.event_cbor),'hex')
        OR e.display->>'event_sha256'<>e.event_sha256 OR e.display->'sequence'<>to_jsonb(n) OR e.display->'tenant'<>jsonb_build_array(org,proj)
        OR e.display->>'previous_event_sha256'<>e.previous_event_sha256 OR e.display->>'previous_state_sha256'<>e.previous_state_sha256 OR e.display->>'current_state_sha256'<>e.current_state_sha256
        OR e.display->>'action'<>'artifact.upload' OR e.display->>'outcome' NOT IN ('created','unchanged')
        OR e.display->>'request_id' !~ '^[0-9a-f]{32}$' OR octet_length(e.display->>'reason')>512
        OR jsonb_array_length(e.display->'actor')<>12 OR jsonb_array_length(e.display->'authorization')<>11 OR jsonb_array_length(e.display->'target')<>8
        OR e.display->'target'<>jsonb_build_array(org,proj,a.application_id,a.environment_id,a.platform,a.runtime_sha256,a.manifest_sha256,a.payload_sha256)
        OR e.display->'actor'->>0<>d.principal_id OR e.display->'actor'->>1<>'human'
        OR d.action<>'artifact.upload' OR d.application_id<>a.application_id OR d.environment_id<>a.environment_id OR d.manifest_sha256<>a.manifest_sha256 OR d.payload_sha256<>a.payload_sha256
        OR d.request_sha256<>e.display->>'request_sha256'
        OR d.request_sha256<>public.mixer_customer_hash('mixer.hosted.customer.upload.request.v2',jsonb_build_array(2,'artifact.upload',e.display->'target',e.display->'envelope_sha256',e.display->'reason'))
        THEN RAISE EXCEPTION 'inconsistent customer event'; END IF;
      IF n=1 THEN expected_state:=public.mixer_customer_hash('mixer.hosted.customer.state.v2',jsonb_build_array(2,org,proj)); expected:='';
      ELSE SELECT * INTO STRICT prev FROM public.mixer_customer_audit_events x WHERE x.organization_id=org AND x.project_id=proj AND x.sequence=n-1; expected_state:=prev.current_state_sha256; expected:=prev.event_sha256; END IF;
      IF e.previous_state_sha256<>expected_state OR e.previous_event_sha256<>expected THEN RAISE EXCEPTION 'broken chain'; END IF;
      IF e.display->>'outcome'='created' THEN
        expected_state:=public.mixer_customer_hash('mixer.hosted.customer.state.v2',jsonb_build_array(2,org,proj,expected_state,n,a.manifest_sha256,e.display->>'envelope_sha256',a.payload_sha256));
        IF a.creating_sequence<>n OR d.status<>201 OR e.display->>'envelope_sha256'<>a.envelope_sha256 THEN RAISE EXCEPTION 'invalid created'; END IF;
      ELSE IF a.creating_sequence>=n OR d.status<>200 THEN RAISE EXCEPTION 'invalid unchanged'; END IF; END IF;
      IF expected_state<>e.current_state_sha256 THEN RAISE EXCEPTION 'invalid state'; END IF;
      IF h.sequence=n AND (h.event_sha256<>e.event_sha256 OR h.state_sha256<>e.current_state_sha256) THEN RAISE EXCEPTION 'invalid head edge'; END IF;
      IF EXISTS (SELECT 1 FROM public.mixer_customer_audit_events x WHERE x.organization_id=org AND x.project_id=proj AND x.sequence>h.sequence) THEN RAISE EXCEPTION 'event beyond head'; END IF;
      IF TG_TABLE_NAME='mixer_customer_artifact_heads' THEN IF NEW.event_sha256<>e.event_sha256 OR NEW.state_sha256<>e.current_state_sha256 OR OLD.event_sha256<>e.previous_event_sha256 OR OLD.state_sha256<>e.previous_state_sha256 THEN RAISE EXCEPTION 'head transition mismatch'; END IF; END IF;
      envelope:=convert_from(a.envelope_bytes,'UTF8')::json; document:=convert_from(a.signed_manifest_bytes,'UTF8')::jsonb;
      PERFORM public.mixer_customer_json_shape(convert_from(a.signed_manifest_bytes,'UTF8')::json,0,4096);
      IF (SELECT count(*) FROM json_object_keys(envelope))<>2 OR NOT envelope::jsonb ?& ARRAY['signed_manifest','payload']
        OR convert_to((envelope->'signed_manifest')::text,'UTF8')<>a.signed_manifest_bytes
        OR (SELECT count(*) FROM jsonb_object_keys(document))<>2 OR NOT document ?& ARRAY['manifest','signature']
        OR decode(document->>'signature','base64')<>a.signature OR replace(encode(a.signature,'base64'),chr(10),'')<>document->>'signature'
        OR decode(envelope->>'payload','base64')<>a.payload OR replace(encode(a.payload,'base64'),chr(10),'')<>envelope->>'payload'
        OR public.mixer_customer_cbor(document->'manifest')<>a.canonical_manifest_cbor
        OR encode(sha256(a.canonical_manifest_cbor),'hex')<>a.manifest_sha256 OR encode(sha256(a.payload),'hex')<>a.payload_sha256 OR encode(sha256(a.envelope_bytes),'hex')<>a.envelope_sha256
        OR document->'manifest'->'scope'<>jsonb_build_object('organization',org,'project',proj,'app',a.application_id,'environment',a.environment_id,'platform',a.platform)
        OR document->'manifest'->>'runtime'<>a.runtime_sha256 OR document->'manifest'->>'payload_sha256'<>a.payload_sha256
        OR document->'manifest'->'compressed_bytes'<>to_jsonb(octet_length(a.payload))
        THEN RAISE EXCEPTION 'inconsistent retained artifact'; END IF;
      RETURN NULL;
    END
    """
  end
end

ca668a333306abb7a10978f669d5eef22e9ebba9 blob 8906
defmodule MixerHosted.CustomerArtifacts.Topology do
  @moduledoc false
  alias MixerHosted.Authorization.Postgres.Session
  alias MixerHosted.CustomerArtifacts.Schema
  @catalog_sha256 "ff576c90a10e0bc098f3c7b593640f508aa676a166b8e2123257501f50eb375e"

  def check!(repo) do
    [[role_safe]] =
      Session.query!(repo, """
      SELECT current_user=session_user
        AND NOT pg_catalog.has_schema_privilege(current_user,'public','CREATE')
        AND NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles r WHERE pg_catalog.pg_has_role(current_user,r.oid,'MEMBER')
          AND (r.rolsuper OR r.rolbypassrls OR r.rolcreaterole OR r.rolcreatedb OR r.rolreplication OR pg_catalog.substr(r.rolname::text,1,3)='pg_'))
        AND NOT EXISTS (SELECT 1 FROM pg_catalog.pg_namespace n, LATERAL pg_catalog.aclexplode(coalesce(n.nspacl,pg_catalog.acldefault('n',n.nspowner))) a WHERE n.nspname='public' AND a.grantee=0 AND a.privilege_type='CREATE')
      """).rows

    [[4, tables_safe]] =
      Session.query!(
        repo,
        """
        SELECT count(*),bool_and(c.relkind='r' AND c.relrowsecurity AND c.relforcerowsecurity
          AND c.relowner=(SELECT relowner FROM pg_catalog.pg_class WHERE oid='public.mixer_customer_artifacts'::regclass)
          AND NOT o.rolcanlogin AND NOT o.rolsuper AND NOT o.rolbypassrls
          AND NOT pg_catalog.pg_has_role(current_user,o.oid,'MEMBER')
          AND pg_catalog.has_table_privilege(current_user,c.oid,'SELECT')
          AND NOT pg_catalog.has_table_privilege(current_user,c.oid,'DELETE,TRUNCATE,REFERENCES,TRIGGER')
          AND NOT pg_catalog.has_any_column_privilege(current_user,c.oid,'REFERENCES')
          AND NOT EXISTS (SELECT 1 FROM pg_catalog.aclexplode(coalesce(c.relacl,pg_catalog.acldefault('r',c.relowner))) a WHERE a.grantee=0)
        AND NOT EXISTS (SELECT 1 FROM pg_catalog.pg_attribute att,LATERAL pg_catalog.aclexplode(att.attacl) acl WHERE att.attrelid=c.oid AND acl.grantee=0)
          AND CASE WHEN c.relname='mixer_customer_artifact_heads' THEN
            NOT pg_catalog.has_table_privilege(current_user,c.oid,'INSERT,UPDATE')
            AND NOT pg_catalog.has_any_column_privilege(current_user,c.oid,'INSERT')
            AND (SELECT count(*)=3 AND bool_and(a.attname IN ('sequence','event_sha256','state_sha256')) FROM pg_catalog.pg_attribute a
              WHERE a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped AND pg_catalog.has_column_privilege(current_user,c.oid,a.attnum,'UPDATE'))
          ELSE pg_catalog.has_table_privilege(current_user,c.oid,'INSERT') AND NOT pg_catalog.has_any_column_privilege(current_user,c.oid,'UPDATE') END)
        FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace JOIN pg_catalog.pg_roles o ON o.oid=c.relowner
        WHERE n.nspname='public' AND c.relname=ANY($1::text[])
        """,
        [Schema.tables()]
      ).rows

    functions_safe =
      Enum.all?(Schema.functions_sql(), fn {name, {_args, returns, volatility, definer, body}} ->
        case Session.query!(
               repo,
               """
               SELECT count(*),bool_and(p.prosrc=$2 AND p.prosecdef=$3 AND p.proconfig=ARRAY['search_path=pg_catalog']::text[]
                 AND p.provolatile=$4::"char" AND p.proowner=c.relowner
               AND p.prolang=(SELECT oid FROM pg_catalog.pg_language WHERE lanname='plpgsql') AND NOT p.proleakproof AND NOT p.proisstrict
               AND p.proparallel='u' AND p.prokind='f' AND p.provariadic=0 AND p.pronargdefaults=0 AND p.prosupport=0
               AND pg_catalog.regexp_replace(pg_catalog.pg_get_function_result(p.oid),'[[:space:]]','','g')=pg_catalog.regexp_replace($7,'[[:space:]]','','g')
                 AND NOT o.rolcanlogin AND NOT o.rolsuper AND NOT o.rolbypassrls AND NOT pg_catalog.pg_has_role(current_user,o.oid,'MEMBER')
                 AND pg_catalog.pg_get_function_identity_arguments(p.oid)=$5
                 AND pg_catalog.has_function_privilege(current_user,p.oid,'EXECUTE')=$6
                 AND NOT EXISTS (SELECT 1 FROM pg_catalog.aclexplode(coalesce(p.proacl,pg_catalog.acldefault('f',p.proowner))) a WHERE a.grantee=0))
               FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace JOIN pg_catalog.pg_roles o ON o.oid=p.proowner
                 CROSS JOIN pg_catalog.pg_class c
               WHERE n.nspname='public' AND p.proname=$1 AND c.oid='public.mixer_customer_artifacts'::regclass
               """,
               [
                 name,
                 "\n" <> body,
                 definer,
                 String.downcase(String.first(volatility)),
                 identity_arguments(name),
                 name in ~w(mixer_customer_allowed mixer_customer_artifact_metadata mixer_customer_key_exists),
                 returns
               ]
             ).rows do
          [[1, true]] -> true
          _ -> false
        end
      end)

    [[no_bypass]] =
      Session.query!(
        repo,
        """
        SELECT NOT EXISTS (
          SELECT 1 FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace
          WHERE n.nspname NOT IN ('pg_catalog','information_schema') AND pg_catalog.substr(n.nspname,1,8)<>'pg_temp_'
            AND (p.prosecdef OR p.provolatile='v') AND pg_catalog.has_function_privilege(current_user,p.oid,'EXECUTE')
            AND NOT (n.nspname='public' AND p.proname=ANY($1::text[]))
        ) AND NOT EXISTS (
          SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
          WHERE n.nspname='public' AND c.relkind IN ('v','m','f') AND (pg_catalog.has_table_privilege(current_user,c.oid,'INSERT,UPDATE,DELETE,TRUNCATE,TRIGGER') OR pg_catalog.has_any_column_privilege(current_user,c.oid,'INSERT,UPDATE'))
        )
        """,
        [
          ~w(mixer_authz_lock_profiles mixer_authz_lock_principals mixer_authz_lock_families mixer_authz_lock_credentials mixer_authz_lock_organization_heads mixer_authz_lock_project_heads mixer_customer_artifact_metadata mixer_customer_key_exists)
        ]
      ).rows

    if role_safe and tables_safe and functions_safe and no_bypass and
         catalog_hash(repo) == @catalog_sha256,
       do: :ok,
       else: reject!(repo)
  end

  defp reject!(repo) do
    if MixerHosted.Authorization.Transaction.Context.active?() do
      # A deliberately invalid checkpoint uses Context's owner-process failure
      # latch. Catching the rollback cannot rescue prior callback writes.
      MixerHosted.Authorization.Transaction.Context.checkpoint!(nil, repo, "", nil)
    else
      repo.rollback(:authorization_unavailable)
    end
  end

  @doc false
  def catalog_hash(repo) do
    [[digest]] =
      Session.query!(
        repo,
        """
        SELECT encode(sha256(convert_to(jsonb_build_object(
          'columns',(SELECT jsonb_agg(jsonb_build_array(c.relname,a.attname,pg_catalog.format_type(a.atttypid,a.atttypmod),a.attnotnull,pg_catalog.pg_get_expr(d.adbin,d.adrelid)) ORDER BY c.relname,a.attnum)
            FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace JOIN pg_catalog.pg_attribute a ON a.attrelid=c.oid
            LEFT JOIN pg_catalog.pg_attrdef d ON d.adrelid=c.oid AND d.adnum=a.attnum WHERE n.nspname='public' AND c.relname=ANY($1::text[]) AND a.attnum>0 AND NOT a.attisdropped),
          'constraints',(SELECT jsonb_agg(jsonb_build_array(c.relname,k.conname,k.contype,k.condeferrable,k.condeferred,k.convalidated,pg_catalog.pg_get_constraintdef(k.oid)) ORDER BY c.relname,k.conname)
            FROM pg_catalog.pg_constraint k JOIN pg_catalog.pg_class c ON c.oid=k.conrelid JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relname=ANY($1::text[])),
          'policies',(SELECT jsonb_agg(jsonb_build_array(c.relname,p.polname,p.polcmd,p.polpermissive,p.polroles,pg_catalog.pg_get_expr(p.polqual,p.polrelid),pg_catalog.pg_get_expr(p.polwithcheck,p.polrelid)) ORDER BY c.relname,p.polname)
            FROM pg_catalog.pg_policy p JOIN pg_catalog.pg_class c ON c.oid=p.polrelid JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relname=ANY($1::text[])),
          'triggers',(SELECT jsonb_agg(jsonb_build_array(c.relname,t.tgname,t.tgenabled,t.tgdeferrable,t.tginitdeferred,pg_catalog.pg_get_triggerdef(t.oid)) ORDER BY c.relname,t.tgname)
            FROM pg_catalog.pg_trigger t JOIN pg_catalog.pg_class c ON c.oid=t.tgrelid JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relname=ANY($1::text[]) AND NOT t.tgisinternal)
        )::text,'UTF8')),'hex')
        """,
        [Schema.tables()]
      ).rows

    digest
  end

  defp identity_arguments(name) do
    {args, _, _, _, _} = Schema.functions_sql()[name]
    args |> String.split(",", trim: true) |> Enum.map(&String.trim/1) |> Enum.join(", ")
  end
end

d6e5fb2e27846fe7e860d1a10a8148b71c5436f6 blob 1108
defmodule MixerHosted.CustomerWorkspace do
  @moduledoc """
  Fresh, read-only discovery of a human customer's own workspaces.

  Each call owns its PostgreSQL transaction. Returned descriptive roles are not
  artifact authority. The optional repository is a trusted server/test seam;
  request data never selects it, and no caller callback runs inside this API.
  """

  alias MixerHosted.CustomerWorkspace.{Input, Storage}

  def organizations(identity, page, repo \\ MixerHosted.Repo) do
    with :ok <- Input.identity(identity),
         {:ok, page} <- Input.page(page, "organizations", nil) do
      Storage.read(identity, "organizations", nil, page, repo)
    end
  end

  def projects(identity, organization_id, page, repo \\ MixerHosted.Repo) do
    with :ok <- Input.identity(identity),
         true <- MixerHosted.Authorization.Scope.identifier?(organization_id),
         {:ok, page} <- Input.page(page, "projects", organization_id) do
      Storage.read(identity, "projects", organization_id, page, repo)
    else
      false -> {:error, :invalid_request}
      error -> error
    end
  end
end

29da810ddc9dae41876ec2c8e8d6f298d9ca5717 blob 3780
defmodule MixerHosted.CustomerWorkspace.Input do
  @moduledoc false
  alias MixerHosted.Authorization.Scope
  alias MixerHosted.Identity.{BoundedJSON, Encoding, VerifiedIdentity}

  @fields ~w(profile_id profile_version issuer subject client_id credential_ref issued_at expires_at identity_class scopes)a

  def identity(%VerifiedIdentity{} = i) when map_size(i) == 11 do
    now = System.system_time(:second)

    cond do
      Enum.sort(Map.keys(Map.from_struct(i))) != Enum.sort(@fields) or
        not Encoding.bounded_string?(i.profile_id, 128) or
        not (is_integer(i.profile_version) and i.profile_version in 1..2_147_483_647) or
        not Encoding.bounded_string?(i.issuer, 2048) or
        not Encoding.bounded_string?(i.subject, 256) or
        not Encoding.bounded_string?(i.client_id, 256) or
        not Encoding.bounded_string?(i.credential_ref, 256) or
        not Encoding.numeric_date?(i.issued_at) or
        not Encoding.numeric_date?(i.expires_at) or i.issued_at >= i.expires_at or
        i.expires_at <= now or i.issued_at > now + 30 or
        i.identity_class not in [:human, :service] or not scopes?(i.scopes, 32, MapSet.new()) ->
        {:error, :unauthenticated}

      i.identity_class != :human or "mixer.workspace.read" not in i.scopes ->
        {:error, :permission_denied}

      true ->
        :ok
    end
  end

  def identity(_), do: {:error, :unauthenticated}

  def page(%{limit: limit, cursor: cursor} = page, kind, organization)
      when not is_struct(page) and map_size(page) == 2 and is_integer(limit) and limit in 1..100 do
    case decode(cursor, kind, organization) do
      {:ok, after_id} -> {:ok, %{limit: limit, after: after_id}}
      _ -> {:error, :invalid_request}
    end
  end

  def page(_, _, _), do: {:error, :invalid_request}

  def cursor(kind, organization, after_id) do
    pairs =
      if kind == "organizations",
        do: [{"v", 1}, {"kind", kind}, {"after", after_id}],
        else: [{"v", 1}, {"kind", kind}, {"organization_id", organization}, {"after", after_id}]

    %Jason.OrderedObject{values: pairs}
    |> Jason.encode!()
    |> Base.url_encode64(padding: false)
  end

  def display_name?(nil), do: true

  def display_name?(name),
    do:
      is_binary(name) and byte_size(name) in 1..256 and String.valid?(name) and
        String.printable?(name) and
        Enum.all?(String.to_charlist(name), &(&1 >= 32 and &1 not in 127..159))

  defp decode(nil, _, _), do: {:ok, nil}

  defp decode(encoded, kind, organization)
       when is_binary(encoded) and byte_size(encoded) in 1..1400 do
    with {:ok, raw} <- Base.url_decode64(encoded, padding: false),
         true <- byte_size(raw) <= 1024,
         {:ok, object} <- BoundedJSON.object(raw, 1024),
         true <- valid_cursor?(object, kind, organization),
         ^encoded <- cursor(kind, organization, object["after"]) do
      {:ok, object["after"]}
    else
      _ -> :error
    end
  end

  defp decode(_, _, _), do: :error

  defp valid_cursor?(
         %{"v" => 1, "kind" => "organizations", "after" => after_id} = value,
         "organizations",
         nil
       ),
       do: map_size(value) == 3 and Scope.identifier?(after_id)

  defp valid_cursor?(
         %{"v" => 1, "kind" => "projects", "organization_id" => org, "after" => after_id} = value,
         "projects",
         organization
       ),
       do: map_size(value) == 4 and org == organization and Scope.identifier?(after_id)

  defp valid_cursor?(_, _, _), do: false

  defp scopes?([], _, _), do: true

  defp scopes?([value | rest], left, seen) when left > 0,
    do:
      Encoding.bounded_string?(value, 256) and not MapSet.member?(seen, value) and
        scopes?(rest, left - 1, MapSet.put(seen, value))

  defp scopes?(_, _, _), do: false
end

9f475bea0f582ecb3e18404ac305eb619321fe4b blob 16295
defmodule MixerHosted.CustomerWorkspace.Storage do
  @moduledoc false
  alias MixerHosted.Authorization.{Policy, Scope}
  alias MixerHosted.Authorization.Postgres.Session
  alias MixerHosted.Authorization.Transaction.Context
  alias MixerHosted.CustomerWorkspace.Input

  @key {__MODULE__, :active}
  @roles ~w(owner administrator developer release_manager billing_manager viewer)
  @settings ~w(profile_id profile_version issuer subject client_id identity_class credential_ref organization_id project_id application_id environment_id principal_id family_id action transaction_marker token_issued_at token_expires_at required_scope phase directory_mode)

  def read(identity, kind, organization, page, repo) do
    if not is_nil(Process.get(@key)) or Context.active?() or repo.in_transaction?() do
      {:error, :authorization_unavailable}
    else
      owned_read(identity, kind, organization, page, repo)
    end
  rescue
    _ -> {:error, :authorization_unavailable}
  catch
    _, _ -> {:error, :authorization_unavailable}
  end

  defp owned_read(identity, kind, organization, page, repo) do
    state = %{
      owner: self(),
      repo: repo,
      dynamic_repo: repo.get_dynamic_repo(),
      deadline: System.monotonic_time(:millisecond) + 5_000,
      admitted_at: System.system_time(:second)
    }

    Process.put(@key, state)

    case repo.transaction(fn -> run!(identity, kind, organization, page, state) end,
           timeout: 5_000,
           queue: false
         ) do
      {:ok, result} -> {:ok, result}
      {:error, reason} when reason in [:unauthenticated, :not_found] -> {:error, reason}
      _ -> {:error, :authorization_unavailable}
    end
  rescue
    _ -> {:error, :authorization_unavailable}
  catch
    _, _ -> {:error, :authorization_unavailable}
  after
    Process.delete(@key)
  end

  defp run!(identity, kind, organization, page, state) do
    repo = state.repo
    linkage = Session.prepare_identity!(repo, Policy.identity_key(identity))

    intended = [
      directory_mode: kind,
      organization_id: organization,
      project_id: nil,
      application_id: nil,
      environment_id: nil,
      action: "workspace.read",
      required_scope: "mixer.workspace.read",
      phase: "directory",
      transaction_marker: Base.encode16(:crypto.strong_rand_bytes(32), case: :lower),
      token_issued_at: Integer.to_string(identity.issued_at),
      token_expires_at: Integer.to_string(identity.expires_at)
    ]

    Session.context!(repo, intended)
    binding = connection!(repo)
    initial_identity = identity!(repo, identity, linkage, fresh_time!(state, state.admitted_at))

    organization_row = if kind == "projects", do: requested_organization!(repo, organization)
    candidates = candidates!(repo, kind, organization, page)
    selected = if organization_row, do: [organization_row | candidates], else: candidates
    ids = selected |> Enum.flat_map(& &1.witnesses) |> Enum.uniq() |> Enum.sort()
    witnesses = witnesses!(repo, ids, linkage.principal_id, fresh_time!(state, state.admitted_at))
    lock_selected!(repo, selected, witnesses, intended)
    check_binding!(state, binding)

    # All resource and witness queries below are new READ COMMITTED statements
    # after the final bounded lock wait. Freeze witnesses; never substitute an
    # unlocked newly granted membership or retry a changed selection.
    now = fresh_time!(state, state.admitted_at)
    if identity!(repo, identity, linkage, now) !== initial_identity, do: unavailable!(repo)
    current = reread!(repo, kind, organization, selected)
    fresh_witnesses = witnesses!(repo, ids, linkage.principal_id, now)
    if fresh_witnesses !== witnesses, do: unavailable!(repo)
    check_resources!(repo, current, fresh_witnesses, kind, organization)

    final_time = fresh_time!(state, now)
    if identity!(repo, identity, linkage, final_time) !== initial_identity, do: unavailable!(repo)
    final_witnesses = witnesses!(repo, ids, linkage.principal_id, final_time)
    if final_witnesses !== witnesses, do: unavailable!(repo)
    check_resources!(repo, current, final_witnesses, kind, organization)
    result = result(kind, organization, candidates, current, final_witnesses, page.limit)
    Session.finish!(repo)
    check_binding!(state, binding)
    # Re-evaluate the locked snapshots against actual time after all SQL. One
    # boundary change permits a second local check; a second change fails closed.
    final_time!(state, identity, linkage, initial_identity, final_witnesses, final_time, 2)
    result
  end

  defp requested_organization!(repo, organization) do
    case organization_candidates(repo, "o.id = $1", [organization], 1) do
      [row] -> row
      _ -> repo.rollback(:not_found)
    end
  end

  defp candidates!(repo, "organizations", _, page) do
    organization_candidates(
      repo,
      "($1::text IS NULL OR o.id COLLATE \"C\" > $1 COLLATE \"C\")",
      [page.after],
      page.limit + 1
    )
  end

  defp candidates!(repo, "projects", organization, page) do
    Session.query!(
      repo,
      """
      SELECT p.id, p.display_name, ARRAY(
        SELECT w.id FROM (
          SELECT DISTINCT ON (m.role COLLATE "C") m.id, m.role
          FROM public.mixer_authz_memberships m
          WHERE m.organization_id = p.organization_id
            AND ((m.project_binding = 'all_projects' AND m.project_id IS NULL)
              OR (m.project_binding = 'exact_project' AND m.project_id = p.id))
          ORDER BY m.role COLLATE "C", m.id COLLATE "C") w ORDER BY w.role COLLATE "C")
      FROM public.mixer_authz_projects p
      WHERE p.organization_id = $1 AND p.active
        AND ($2::text IS NULL OR p.id COLLATE "C" > $2 COLLATE "C")
      ORDER BY p.id COLLATE "C" LIMIT $3
      """,
      [organization, page.after, page.limit + 1]
    ).rows
    |> Enum.map(fn [id, name, ids] -> row(organization, id, name, ids, :project) end)
  end

  defp organization_candidates(repo, condition, params, limit) do
    Session.query!(
      repo,
      """
      SELECT o.id, o.display_name, COALESCE(NULLIF(ARRAY(
        SELECT w.id FROM (
          SELECT DISTINCT ON (m.role COLLATE "C") m.id, m.role
          FROM public.mixer_authz_memberships m
          WHERE m.organization_id = o.id AND m.project_id IS NULL
          ORDER BY m.role COLLATE "C", m.id COLLATE "C") w ORDER BY w.role COLLATE "C"), '{}'::text[]),
        ARRAY(SELECT m.id FROM public.mixer_authz_memberships m WHERE m.organization_id = o.id
          ORDER BY m.id COLLATE "C" LIMIT 1))
      FROM public.mixer_authz_organizations o WHERE o.active AND (#{condition})
      ORDER BY o.id COLLATE "C" LIMIT $#{length(params) + 1}
      """,
      params ++ [limit]
    ).rows
    |> Enum.map(fn [id, name, ids] -> row(id, id, name, ids, :organization) end)
  end

  defp row(organization, id, name, ids, kind),
    do: %{organization_id: organization, id: id, display_name: name, witnesses: ids, kind: kind}

  defp lock_selected!(repo, rows, witnesses, intended) do
    organizations = rows |> Enum.map(& &1.organization_id) |> Enum.uniq() |> Enum.sort()

    projects =
      for(row <- rows, row.kind == :project, do: {row.organization_id, row.id}) ++
        for {_id, m} <- witnesses, m.project_id, do: {m.organization_id, m.project_id}

    for org <- organizations do
      Session.context!(repo,
        directory_mode: nil,
        phase: "directory_lock",
        organization_id: org,
        project_id: nil,
        application_id: nil,
        environment_id: nil
      )

      lock!(repo, "organization_heads")
    end

    for {org, project} <- projects |> Enum.uniq() |> Enum.sort() do
      Session.context!(repo,
        directory_mode: nil,
        phase: "directory_lock",
        organization_id: org,
        project_id: project,
        application_id: nil,
        environment_id: nil
      )

      lock!(repo, "project_heads")
    end

    Session.context!(repo, intended)
  end

  defp lock!(repo, table) do
    if Session.query!(repo, "SELECT public.mixer_authz_lock_#{table}()").rows != [[true]],
      do: unavailable!(repo)
  end

  defp witnesses!(_repo, [], _, _), do: %{}

  defp witnesses!(repo, ids, principal, now) do
    result =
      Session.query!(
        repo,
        """
        SELECT id, principal_id, organization_id, project_id, project_binding, role,
          active, not_before, expires_at, revision
        FROM public.mixer_authz_memberships WHERE id = ANY($1::text[]) ORDER BY id COLLATE "C"
        """,
        [ids]
      ).rows
      |> Map.new(fn [id, actor, org, project, binding, role, active, start, finish, revision] ->
        valid =
          Scope.identifier?(id) and Scope.identifier?(actor) and Scope.identifier?(org) and
            actor == principal and role in @roles and active and start <= now and
            (is_nil(finish) or finish > now) and
            ((is_nil(project) and binding in ["organization_only", "all_projects"]) or
               (Scope.identifier?(project) and binding == "exact_project"))

        if not valid, do: unavailable!(repo)

        {id,
         %{
           id: id,
           principal_id: actor,
           organization_id: org,
           project_id: project,
           project_binding: binding,
           role: role,
           active: active,
           not_before: start,
           expires_at: finish,
           revision: revision
         }}
      end)

    if Enum.sort(Map.keys(result)) != ids, do: unavailable!(repo)
    result
  end

  defp reread!(repo, kind, organization, selected) do
    orgs = selected |> Enum.filter(&(&1.kind == :organization))
    projects = selected |> Enum.filter(&(&1.kind == :project))

    org_rows =
      Session.query!(
        repo,
        "SELECT id, display_name FROM public.mixer_authz_organizations WHERE active AND id = ANY($1::text[])",
        [Enum.map(orgs, & &1.id)]
      ).rows

    project_rows =
      if kind == "projects",
        do:
          Session.query!(
            repo,
            "SELECT id, display_name FROM public.mixer_authz_projects WHERE active AND organization_id = $1 AND id = ANY($2::text[])",
            [organization, Enum.map(projects, & &1.id)]
          ).rows,
        else: []

    names =
      Map.new(
        Enum.map(org_rows, fn [id, name] -> {{:organization, id}, name} end) ++
          Enum.map(project_rows, fn [id, name] -> {{:project, id}, name} end)
      )

    if map_size(names) != length(selected), do: unavailable!(repo)
    Enum.map(selected, fn row -> %{row | display_name: Map.fetch!(names, {row.kind, row.id})} end)
  end

  defp check_resources!(repo, rows, witnesses, _kind, _organization) do
    Enum.each(rows, fn row ->
      if not Scope.identifier?(row.id) or not Scope.identifier?(row.organization_id) or
           not Input.display_name?(row.display_name) or row.witnesses == [],
         do: unavailable!(repo)

      Enum.each(row.witnesses, fn id ->
        m = Map.fetch!(witnesses, id)

        if m.organization_id != row.organization_id or
             (row.kind == :project and
                not (m.project_binding == "all_projects" or
                       (m.project_binding == "exact_project" and m.project_id == row.id))),
           do: unavailable!(repo)
      end)
    end)
  end

  defp result(kind, organization, candidates, current, witnesses, limit) do
    lookup = Map.new(current, &{{&1.kind, &1.id}, &1})

    items =
      candidates
      |> Enum.take(limit)
      |> Enum.map(fn original ->
        row = Map.fetch!(lookup, {original.kind, original.id})
        members = Enum.map(row.witnesses, &Map.fetch!(witnesses, &1))

        roles =
          members
          |> Enum.filter(&(kind == "projects" or is_nil(&1.project_id)))
          |> Enum.map(& &1.role)
          |> Enum.uniq()
          |> Enum.sort()

        if kind == "organizations",
          do: %{id: row.id, display_name: row.display_name, organization_roles: roles},
          else: %{
            organization_id: organization,
            id: row.id,
            display_name: row.display_name,
            roles: roles
          }
      end)

    cursor =
      if length(candidates) > limit,
        do: Input.cursor(kind, organization, List.last(items).id),
        else: nil

    if kind == "organizations",
      do: %{organizations: items, next_cursor: cursor},
      else: %{projects: items, next_cursor: cursor}
  end

  defp identity!(repo, i, linkage, now) do
    sql = """
    SELECT p.id, p.version, p.issuer, p.client_id, p.identity_class, p.active, p.state_revision,
      b.subject, b.principal_id, b.identity_class, b.active, b.revision,
      a.id, a.identity_class, a.active, a.not_before, a.revision,
      c.reference, c.principal_id, c.family_id, c.active, c.not_before, c.expires_at, c.revision,
      f.id, f.principal_id, f.active, f.not_before, f.expires_at, f.revision
    FROM public.mixer_authz_profiles p CROSS JOIN public.mixer_authz_bindings b
    CROSS JOIN public.mixer_authz_principals a CROSS JOIN public.mixer_authz_credentials c
    CROSS JOIN public.mixer_authz_families f
    """

    evidence = Session.one!(repo, sql, [], :unauthenticated)
    validate_identity!(repo, i, linkage, evidence, now)
  end

  defp validate_identity!(repo, i, linkage, evidence, now) do
    [
      profile,
      version,
      issuer,
      client,
      "human",
      true,
      _profile_revision,
      subject,
      principal,
      "human",
      true,
      _binding_revision,
      principal_id,
      "human",
      true,
      principal_start,
      _principal_revision,
      reference,
      credential_principal,
      family,
      true,
      credential_start,
      credential_end,
      _credential_revision,
      family_id,
      family_principal,
      true,
      family_start,
      family_end,
      _family_revision
    ] = evidence

    if profile != i.profile_id or version != i.profile_version or issuer != i.issuer or
         client != i.client_id or subject != i.subject or reference != i.credential_ref or
         Enum.any?(
           [principal, principal_id, credential_principal, family_principal],
           &(&1 != linkage.principal_id)
         ) or
         family != linkage.family_id or family_id != linkage.family_id or
         i.issued_at < max(principal_start, max(credential_start, family_start)) or
         Enum.any?([principal_start, credential_start, family_start], &(&1 > now)) or
         Enum.any?([credential_end, family_end], &(not is_nil(&1) and &1 <= now)) or
         i.expires_at <= now or i.issued_at > now + 30,
       do: repo.rollback(:unauthenticated)

    evidence
  rescue
    MatchError -> repo.rollback(:unauthenticated)
  end

  defp final_time!(state, identity, linkage, evidence, witnesses, previous, remaining) do
    now = fresh_time!(state, previous)
    validate_identity!(state.repo, identity, linkage, evidence, now)

    Enum.each(witnesses, fn {_id, m} ->
      if m.not_before > now or (not is_nil(m.expires_at) and m.expires_at <= now),
        do: unavailable!(state.repo)
    end)

    final = fresh_time!(state, now)

    cond do
      final == now ->
        :ok

      remaining > 1 ->
        final_time!(state, identity, linkage, evidence, witnesses, now, remaining - 1)

      true ->
        unavailable!(state.repo)
    end
  end

  defp fresh_time!(state, previous) do
    now = System.system_time(:second)

    if now < previous or now < state.admitted_at or
         System.monotonic_time(:millisecond) >= state.deadline,
       do: unavailable!(state.repo)

    now
  end

  defp connection!(repo) do
    fields = Enum.map_join(@settings, ",", &"current_setting('mixer.authz.#{&1}', true)")

    Session.one!(
      repo,
      "SELECT pg_backend_pid(), pg_current_xact_id()::text, current_user::text, session_user::text, " <>
        fields,
      [],
      :authorization_unavailable
    )
  end

  defp check_binding!(state, binding) do
    if Process.get(@key) !== state or self() != state.owner or Context.active?() or
         state.repo.get_dynamic_repo() != state.dynamic_repo or not state.repo.in_transaction?() or
         connection!(state.repo) !== binding,
       do: unavailable!(state.repo)
  end

  defp unavailable!(repo), do: repo.rollback(:authorization_unavailable)
end

168646e15a7f9596e46ed9e04c6fe7789ef9629e blob 5090
defmodule MixerHosted.Identity.AccessTokenVerifier do
  @moduledoc """
  Pure RFC 9068 / RS256 access-token verification using one validated snapshot.

  The input is a compact JWS without an HTTP `Bearer ` prefix, at most 4089
  bytes. No token field selects configuration, a URL, a network request or a
  broader algorithm. A future HTTP adapter must enforce a single authorization
  header and the 4096-byte bound including the prefix.

  This helper owns no active trust pointer, refresh, cache or provider lifecycle.
  It cannot enforce a later disable/revision if a caller deliberately supplies
  an older snapshot. A configured adapter must supply current trust on every
  request and implement the `Verifier.authenticate/2` behavior separately.
  """

  alias MixerHosted.Identity.{BoundedJSON, Encoding, TrustSnapshot, VerifiedIdentity}

  @scopes [
    "mixer.artifact.read",
    "mixer.artifact.upload",
    "mixer.audit.read",
    "mixer.workspace.read"
  ]

  @spec verify(binary(), integer(), TrustSnapshot.t() | nil) ::
          {:ok, VerifiedIdentity.t()} | {:error, :unauthenticated | :identity_unavailable}
  def verify(compact_token, now, snapshot) do
    case TrustSnapshot.status(snapshot, now) do
      :fresh -> verify_fresh(compact_token, now, snapshot)
      :disabled -> {:error, :unauthenticated}
      :unavailable -> {:error, :identity_unavailable}
    end
  end

  defp verify_fresh(compact_token, now, snapshot) do
    with true <- is_binary(compact_token) and byte_size(compact_token) <= 4_089,
         [header_segment, payload_segment, signature_segment] <-
           :binary.split(compact_token, ".", [:global]),
         {:ok, header_bytes} <- Encoding.decode64(header_segment, 2_048),
         {:ok, payload_bytes} <- Encoding.decode64(payload_segment, 3_072),
         {:ok, signature} <- Encoding.decode64(signature_segment, 512),
         {:ok, header} <- BoundedJSON.object(header_bytes, 2_048),
         true <- valid_header?(header),
         {:ok, claims} <- BoundedJSON.object(payload_bytes, 3_072),
         {:ok, {key, signature_size}} <- TrustSnapshot.key(snapshot, header["kid"]),
         true <- byte_size(signature) == signature_size,
         {true, ^payload_bytes, _jws} <-
           JOSE.JWS.verify_strict(key, ["RS256"], compact_token),
         profile = TrustSnapshot.profile(snapshot),
         true <- valid_claims?(claims, profile, now),
         {:ok, scopes} <- scopes(claims) do
      {:ok,
       %VerifiedIdentity{
         profile_id: profile.profile_id,
         profile_version: profile.profile_version,
         issuer: profile.issuer,
         subject: claims["sub"],
         client_id: profile.client_id,
         credential_ref: claims["jti"],
         issued_at: claims["iat"],
         expires_at: claims["exp"],
         identity_class: profile.identity_class,
         scopes: scopes
       }}
    else
      _ -> {:error, :unauthenticated}
    end
  rescue
    _ -> {:error, :unauthenticated}
  catch
    _, _ -> {:error, :unauthenticated}
  end

  defp valid_header?(header) do
    map_size(header) == 3 and header["alg"] == "RS256" and
      header["typ"] in ["at+jwt", "application/at+jwt"] and
      Encoding.bounded_string?(header["kid"], 128)
  end

  defp valid_claims?(claims, profile, now) do
    issued = claims["iat"]
    expiry = claims["exp"]
    maximum_lifetime = if profile.identity_class == :human, do: 900, else: 300

    claims["iss"] == profile.issuer and claims["client_id"] == profile.client_id and
      Encoding.bounded_string?(claims["sub"], 256) and
      Encoding.bounded_string?(claims["jti"], 256) and
      valid_audience?(claims["aud"], profile.audience) and
      Encoding.numeric_date?(issued) and Encoding.numeric_date?(expiry) and
      issued < expiry and expiry - issued <= maximum_lifetime and expiry > now and
      issued <= now + 30 and valid_not_before?(claims, expiry, now)
  end

  defp valid_audience?(audience, expected) when is_binary(audience), do: audience == expected

  defp valid_audience?(audiences, expected) when is_list(audiences) do
    length(audiences) in 1..8 and expected in audiences and
      Enum.all?(audiences, &Encoding.bounded_string?(&1, 256)) and
      Enum.uniq(audiences) == audiences
  end

  defp valid_audience?(_, _), do: false

  defp valid_not_before?(%{"nbf" => not_before}, expiry, now) do
    Encoding.numeric_date?(not_before) and not_before < expiry and not_before <= now + 30
  end

  defp valid_not_before?(_, _, _), do: true

  defp scopes(%{"scope" => value}) when is_binary(value) and byte_size(value) in 1..1_024 do
    words = :binary.split(value, " ", [:global])

    if length(words) <= 32 and Enum.all?(words, &scope_word?/1) and
         Enum.uniq(words) == words do
      {:ok, Enum.filter(@scopes, &(&1 in words))}
    else
      :error
    end
  end

  defp scopes(claims) do
    if Map.has_key?(claims, "scope"), do: :error, else: {:ok, []}
  end

  defp scope_word?(<<>>), do: false

  defp scope_word?(word) do
    Enum.all?(:binary.bin_to_list(word), &(&1 == 33 or &1 in 35..91 or &1 in 93..126))
  end
end

f69e7f0988da51c8a848f61dd724ba9bbe14ffdf blob 2723
defmodule MixerHosted.Identity.Admission do
  @moduledoc false
  # Reservations occur in ETS before the first message to the owner. Fixed slots
  # bound both a profile and this owner/process; no spawn occurs on overflow.
  def new(owner, entries, binding) do
    table = :ets.new(__MODULE__, [:set, :public, read_concurrency: true, write_concurrency: true])
    :ets.insert(table, {:configuration, Enum.uniq([binding | Map.keys(entries)]), binding})
    :persistent_term.put({__MODULE__, owner}, table)
    table
  end

  def configure(table, entries, binding),
    do: :ets.insert(table, {:configuration, Enum.uniq([binding | Map.keys(entries)]), binding})

  def acquire(owner, profile) do
    table = :persistent_term.get({__MODULE__, owner}, nil)
    admitted = System.monotonic_time(:millisecond)
    nonce = make_ref()

    with true <- table != nil,
         [{:configuration, ids, binding}] <- :ets.lookup(table, :configuration),
         id = if(profile == :configured, do: binding, else: profile),
         true <- id in ids,
         {:ok, g} <- reserve(table, :global, 128, nonce) do
      case reserve(table, id, 16, nonce) do
        {:ok, p} ->
          {:ok, {table, g, p, id, self(), admitted, nonce}}

        :error ->
          :ets.delete(table, g)
          {:error, :identity_unavailable}
      end
    else
      _ -> {:error, :identity_unavailable}
    end
  rescue
    ArgumentError -> {:error, :identity_unavailable}
  end

  defp reserve(table, id, n, nonce) do
    Enum.reduce_while(1..n, :error, fn i, _ ->
      k = {:slot, id, i}
      if :ets.insert_new(table, {k, self(), nonce}), do: {:halt, {:ok, k}}, else: {:cont, :error}
    end)
  end

  def valid?({t, g, p, id, pid, _admitted, nonce}, t, caller) do
    pid == caller and :ets.lookup(t, g) == [{g, pid, nonce}] and
      :ets.lookup(t, p) == [{p, pid, nonce}] and
      elem(p, 1) == id
  end

  def valid?(_, _, _), do: false

  def release({t, g, p, _, pid, _, nonce}) do
    for key <- [g, p] do
      :ets.delete_object(t, {key, pid, nonce})
    end

    :ok
  rescue
    ArgumentError -> :ok
  end

  def reap(table) do
    for {k, pid, nonce} <- :ets.tab2list(table),
        is_tuple(k),
        elem(k, 0) == :slot,
        not Process.alive?(pid),
        do: :ets.delete_object(table, {k, pid, nonce})
  end

  # Publication and close are serialized by the registered owner's lifecycle.
  # This ownership check is not an atomic compare-and-erase operation.
  def close(owner, table) do
    if :ets.info(table, :owner) == self() and
         :persistent_term.get({__MODULE__, owner}, nil) == table,
       do: :persistent_term.erase({__MODULE__, owner}),
       else: false
  rescue
    ArgumentError -> false
  end
end

7097c1dbf5ab104ccf5a44d0e20888c2f150b26a blob 1662
defmodule MixerHosted.Identity.BoundedJSON do
  @moduledoc false

  # The byte limit is enforced before Jason allocates a decoded tree. Ordered
  # objects preserve decoded member names, including escaped-equivalent names.
  @spec object(binary(), pos_integer()) :: {:ok, map()} | :error
  def object(raw, limit) when is_binary(raw) and byte_size(raw) <= limit do
    with {:ok, %Jason.OrderedObject{} = object} <-
           Jason.decode(raw, objects: :ordered_objects, keys: :strings, strings: :copy),
         {:ok, value} <- unique(object, 0) do
      {:ok, value}
    else
      _ -> :error
    end
  rescue
    _ -> :error
  end

  def object(_, _), do: :error

  defp unique(_, depth) when depth > 16, do: :error

  defp unique(%Jason.OrderedObject{values: pairs}, depth) when length(pairs) <= 64 do
    Enum.reduce_while(pairs, {:ok, %{}}, fn {name, value}, {:ok, result} ->
      with false <- Map.has_key?(result, name),
           {:ok, value} <- unique(value, depth + 1) do
        {:cont, {:ok, Map.put(result, name, value)}}
      else
        _ -> {:halt, :error}
      end
    end)
  end

  defp unique(%Jason.OrderedObject{}, _), do: :error

  defp unique(values, depth) when is_list(values) and length(values) <= 64 do
    Enum.reduce_while(values, {:ok, []}, fn value, {:ok, result} ->
      case unique(value, depth + 1) do
        {:ok, value} -> {:cont, {:ok, [value | result]}}
        :error -> {:halt, :error}
      end
    end)
    |> case do
      {:ok, result} -> {:ok, Enum.reverse(result)}
      :error -> :error
    end
  end

  defp unique(values, _) when is_list(values), do: :error
  defp unique(value, _), do: {:ok, value}
end

