+ let debt=report.live_unreconciled;
+ let completion=phase.complete(FrameOperationStorage{preparation:prep,..storage()});
+ if debt { assert!(matches!(completion,FrameCompletion::Retained(_))); let mut own=Some(owned); assert!(SwiftReactorInstance::cleanup_owned(&mut own).is_err()); assert!(own.is_some()); drop(own); }
