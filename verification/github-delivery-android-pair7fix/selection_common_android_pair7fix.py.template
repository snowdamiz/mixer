def safe(value):
    assert type(value) is str and value and '\0' not in value
    p = PurePosixPath(value)
    assert not p.is_absolute() and str(p) == value.rstrip('/')
    assert all(part not in ('', '.', '..', '.git') for part in p.parts)
    assert not value.startswith(('-', ':')) and not any(c in value for c in '*?[]\\')
    return value

def absent(value):
    p = ROOT / safe(value)
    try: p.lstat()
    except FileNotFoundError: return
    raise AssertionError('Required absent path exists: ' + value)

def selected_row(value):
    safe(value['path'])
    p = ROOT / value['path']
    actual = row(p)
    mode = stat.S_IMODE(p.lstat().st_mode)
    actual['mode'] = '100755' if mode & 0o111 else '100644'
    payload = p.read_bytes()
    actual['oid'] = hashlib.sha1(b'blob ' + str(len(payload)).encode() + b'\0' + payload).hexdigest()
    assert actual == value, value['path']
    return actual

def fingerprint(value):
    p = ROOT / value.rstrip('/')
    try: st = p.lstat()
    except FileNotFoundError: return {'path': value, 'missing': True}
    result = {'path': value, 'mode': stat.S_IMODE(st.st_mode), 'type': stat.S_IFMT(st.st_mode)}
    if stat.S_ISREG(st.st_mode):
        h = hashlib.sha256()
        with p.open('rb') as handle:
            for block in iter(lambda: handle.read(1024 * 1024), b''): h.update(block)
        result.update(bytes=st.st_size, sha256=h.hexdigest())
    elif stat.S_ISLNK(st.st_mode): result['target'] = os.readlink(p)
    else: result.update(inode=st.st_ino, device=st.st_dev)
    return result

def preserved_entry(value):
    st = (ROOT / value.rstrip('/')).lstat()
    return {'path': value, 'mode': stat.S_IMODE(st.st_mode), 'type': stat.S_IFMT(st.st_mode),
            'inode': st.st_ino, 'device': st.st_dev}

def raw_rows(raw):
    parts = raw.split(b'\0')
    assert len(parts) % 2 == 1
    result = []
    for i in range(0, len(parts) - 1, 2):
        meta, value = parts[i].decode(), parts[i + 1].decode()
        fields = meta.split()
        assert len(fields) == 5 and fields[-1] in ('M', 'D', 'T', 'A')
        safe(value)
        result.append({'path': value, 'gitRaw': meta})
    return result

def collapsed(raw):
    result = []
    for value in raw.split(b'\0'):
        if not value: continue
        decoded = value.decode()
        assert len(decoded) > 3 and decoded[2] == ' ' and not any(c in decoded[:2] for c in 'RC')
        safe(decoded[3:])
        result.append({'status': decoded[:2], 'path': decoded[3:]})
    return result

def compare_collapsed(before, after):
    def selected_projection(value):
        value = value.rstrip('/')
        return any(p == value or p.startswith(value + '/') for p in SELECTED)
    def covered(value, prior): return value == prior or prior.endswith('/') and value.startswith(prior)
    def outside(rows): return [r for r in rows if r['status'] != '??' and r['path'] not in SELECTED]
    assert outside(after) == outside(before), 'Outside-selected tracked status changed'
    prior = [r['path'] for r in before if r['status'] == '??']
    current = [r['path'] for r in after if r['status'] == '??']
    for value in current:
        assert selected_projection(value) or any(covered(value, old) for old in prior), ('New unrelated collapsed entry', value)
    for old in prior:
        assert selected_projection(old) or any(covered(value, old) or covered(old, value) for value in current), ('Missing unrelated collapsed entry', old)
    return {'outsideTrackedStatusUnchanged': True, 'untrackedTransitionsConfinedToPriorScopesOrSelectedProjections': True,
            'recursiveUntrackedContentProof': False}

