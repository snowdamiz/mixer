RAW = ['--raw', '--no-abbrev', '--no-renames', '-z']
def phase_vectors(phase):
    g = lambda *v: ['git', *v]
    if phase == 'pair7fix-preflight':
        return [('git-version', g('--version')), ('gh-version', ['gh', '--version']),
                ('head', g('rev-parse', 'HEAD', 'HEAD^{tree}')), ('branch', g('branch', '--show-current')),
                ('origin', g('remote', 'get-url', 'origin')), ('push-url', list(PUSH_URL_READ_EXCEPTION)),
                ('remote-main', g('ls-remote', 'origin', 'refs/heads/main')),
                ('index-raw', g('diff', '--cached', *RAW)),
                ('collapsed-status', g('status', '--porcelain=v1', '-z', '--untracked-files=normal')),
                ('complete-raw-diff', g('diff', *RAW))]
    if phase == 'pair7fix-delivery':
        return [('head', g('rev-parse', 'HEAD', 'HEAD^{tree}')), ('branch', g('branch', '--show-current')),
                ('origin', g('remote', 'get-url', 'origin')), ('push-url-before-stage', list(PUSH_URL_READ_EXCEPTION)),
                ('remote-before', g('ls-remote', 'origin', 'refs/heads/main')), ('index-before', g('diff', '--cached', *RAW)),
                ('before-diff', g('diff', *RAW)),
                ('stage', g('add', '--force', '--pathspec-from-file=' + str(OUT / 'paths-pair7fix.nul'), '--pathspec-file-nul')),
                ('index-selected', g('ls-files', '--stage', '-z', '--', *AUTHORED)),
                ('staged-objects', g('diff', '--cached', *RAW)), ('authored-check', g('diff', '--cached', '--check', '--', *FORMATTING)),
                ('staged-diff', g('diff', *RAW)),
                ('commit', g('-c', 'core.hooksPath=/dev/null', '-c', 'commit.gpgsign=false', 'commit', '-m', S['commitMessage'])),
                ('committed-head', g('rev-parse', 'HEAD', 'HEAD^{tree}', 'HEAD^@')),
                ('committed-objects', g('diff-tree', '--no-commit-id', *RAW[:-1], '-r', '-z', BASE, '{COMMITTED_SHA}')),
                ('remote-prepush', g('ls-remote', 'origin', 'refs/heads/main')), ('push-url-prepush', list(PUSH_URL_READ_EXCEPTION)),
                ('push', g('-c', 'core.hooksPath=/dev/null', 'push', '--signed=false', '--no-follow-tags', '--recurse-submodules=no', 'origin', '{COMMITTED_SHA}:refs/heads/main')),
                ('remote-postpush', g('ls-remote', 'origin', 'refs/heads/main')), ('push-url-postpush', list(PUSH_URL_READ_EXCEPTION)),
                ('index-after', g('diff', '--cached', *RAW)), ('after-diff', g('diff', *RAW)),
                ('collapsed-status-after', g('status', '--porcelain=v1', '-z', '--untracked-files=normal'))]
    assert phase == 'pair7fix-engine-ci-binding'
    api = lambda endpoint, query: ['gh', 'api', 'repos/snowdamiz/mixer/' + endpoint, '--hostname', 'github.com', '--jq', query]
    return [('head', g('rev-parse', 'HEAD', 'HEAD^{tree}')), ('remote-main', g('ls-remote', 'origin', 'refs/heads/main')),
            ('engine-workflow-content', api('contents/.github/workflows/verify.yml?ref={DELIVERED_SHA}', '{sha,size,path,type}')),
            ('engine-workflow-registration', api('actions/workflows/verify.yml', '{id,path,state,name}')),
            ('engine-run', api('actions/workflows/verify.yml/runs?event=push&head_sha={DELIVERED_SHA}&per_page=5',
             '[.workflow_runs[]|{id,name,head_sha,event,run_attempt,status,conclusion,workflow_id,path,html_url}]'))]

def command_rows(phase):
    return [{'name': name, 'argv': argv, 'effectiveArgv': ['git', '-c', 'gc.auto=0', '-c', 'maintenance.auto=false', *argv[1:]] if argv[0] == 'git' else argv,
             'kind': 'mutation' if name in ('stage', 'commit', 'push') else 'read'} for name, argv in phase_vectors(phase)]

def accepted_preflight(authority):
    binding = authority['acceptedPreflight']
    assert type(binding) is dict and set(binding) == {'seal', 'rows'}
    for expected in [binding['seal'], *binding['rows']]: assert row(ROOT / expected['path']) == expected
    assert [v['path'] for v in binding['rows']] == [str((OUT / n).relative_to(ROOT)) for n in ('preflight-pair7fix.json', 'preservation-pair7fix-local.json', 'manifest-pair7fix.json')]
    seal = json.loads((ROOT / binding['seal']['path']).read_bytes())
    assert seal['decision'] == 'accept-exact-fresh-pair7fix-preflight' and seal['rows'] == binding['rows']
    pre, preservation, manifest = [json.loads((ROOT / v['path']).read_bytes()) for v in binding['rows']]
    assert pre['head'] == BASE and pre['tree'] == TREE and pre['indexEmpty'] is True
    assert pre['selection'] == row(ROOT / SELECTION) and manifest['members'] == ROWS
    assert pre['allCommandsAdmittedDirectlyReapedOwnedGroupsAbsentSeparatePipesEOF'] is True
    return pre, preservation

class StrictCommands:
    def __init__(self, phase, context=None):
        assert phase in PHASES
        check_sources()
        self.phase, self.context = phase, dict(context or {})
        assert set(self.context) == ({'DELIVERED_SHA'} if phase == 'pair7fix-engine-ci-binding' else set())
        for value in self.context.values(): assert re.fullmatch('[0-9a-f]{40}', value)
        self.manifest_name = 'argv-' + phase + '.json'
        self.manifest_row = row(OUT / self.manifest_name)
        self.manifest = json.loads((OUT / self.manifest_name).read_bytes())
        assert self.manifest['schema'] == 1 and self.manifest['phase'] == phase
        assert self.manifest['selection'] == row(ROOT / SELECTION)
        assert self.manifest['commands'] == command_rows(phase)
        seconds, count = PHASES[phase]
        assert self.manifest['session'] == {'seconds': seconds, 'count': count, 'prefix': phase + '-'}
        self.raw_authority = (OUT / 'authority.json').read_bytes()
        self.authority = json.loads(self.raw_authority)
        a = self.authority
        assert a['schema'] == 1 and a['authorized'] is True and a['phase'] == phase and a['phaseLimit'] == 1
        assert a['repository'] == 'snowdamiz/mixer' and a['branch'] == 'main'
        assert a['baseline'] == {'head': BASE, 'tree': TREE} and a['selection'] == row(ROOT / SELECTION)
        assert a['selectedPathsIncludingSelf'] == SELECTED_COUNT and a['helper'] == row(OUT / 'owned.py')
        assert a['argvApproval'] == self.manifest_row and a['manualWorkflowDispatchLimit'] == 0
        assert a['stageLimit'] == a['commitLimit'] == a['nonforcePushLimit'] == int(phase == 'pair7fix-delivery')
        assert a['retryRerunFallbackAllowed'] is False and a['oldDriverReplayAllowed'] is False
        assert a['admissionAdapter'] == {'exactReadOnlyException': list(PUSH_URL_READ_EXCEPTION), 'allOtherVectorsUseUnchangedHelperValidation': True,
                                       'strictManifestEqualityBeforeAdapter': True, 'custodyStartupKernelWaitEOFSignalLogicChanged': False}
        self.check_bindings()
        if phase != 'pair7fix-preflight': accepted_preflight(a)
        if phase == 'pair7fix-engine-ci-binding':
            assert a['acceptedDelivery'] == row(OUT / 'delivery-pair7fix-receipt.json')
        else: assert a['acceptedDelivery'] is None
        snapshot = OUT / ('authority-snapshot-' + phase + '.json')
        with snapshot.open('xb') as h:
            h.write(self.raw_authority); h.flush(); os.fsync(h.fileno())
        fd = os.open(OUT, os.O_RDONLY | getattr(os, 'O_DIRECTORY', 0))
        try: os.fsync(fd)
        finally: os.close(fd)
        self.authority_row = row(snapshot)
        assert self.authority_row['sha256'] == owned.authority()
        self.expected = {v['name']: v for v in self.manifest['commands']}
        self.used = []
        self.commands = owned.Commands(seconds, count, phase + '-')
    def check_bindings(self):
        a = self.authority
        assert a['sourceReview']['path'] not in SELECTED and self.manifest_row['path'] not in SELECTED
        assert all(value['path'] not in SELECTED for value in a['driverSources'])
        assert {v['path'] for v in a['driverSources']} == {str((OUT / n).relative_to(ROOT)) for n in DRIVERS}
        for expected in a['driverSources']: assert row(ROOT / expected['path']) == expected
        assert row(ROOT / a['sourceReview']['path']) == a['sourceReview']
        review = json.loads((ROOT / a['sourceReview']['path']).read_bytes())
        assert review['decision'] == 'accept-exact-android-pair7fix-delivery-source-and-argv'
        assert review['driverSources'] == a['driverSources'] and review['argvApprovals'][self.phase] == self.manifest_row
        assert review['helper'] == row(OUT / 'owned.py') and review['selection'] == row(ROOT / SELECTION)
    @property
    def records(self): return self.commands.records
    def bind_committed_sha(self, value):
        assert self.phase == 'pair7fix-delivery' and not self.context and re.fullmatch('[0-9a-f]{40}', value)
        self.context['COMMITTED_SHA'] = value
    def run(self, name, argv=None, seconds=25):
        assert list(self.expected)[len(self.used)] == name
        assert row(OUT / self.manifest_name) == self.manifest_row
        assert (OUT / 'authority.json').read_bytes() == self.raw_authority
        self.check_bindings(); check_sources()
        if self.phase != 'pair7fix-preflight': accepted_preflight(self.authority)
        expected = [token.replace('{COMMITTED_SHA}', self.context.get('COMMITTED_SHA', '{COMMITTED_SHA}')).replace('{DELIVERED_SHA}', self.context.get('DELIVERED_SHA', '{DELIVERED_SHA}')) for token in self.expected[name]['argv']]
        assert not any('{COMMITTED_SHA}' in token or '{DELIVERED_SHA}' in token for token in expected)
        if argv is not None: assert argv == expected, 'Unapproved command vector'
        assert expected[:2] != ['gh', 'workflow']
        if name == 'stage':
            pathspec = b''.join(value.encode() + b'\0' for value in AUTHORED)
            assert (OUT / 'paths-pair7fix.nul').read_bytes() == pathspec
            save('pair7fix-pathspec-admission.json', {'selection': row(ROOT / SELECTION), 'pathspec': row(OUT / 'paths-pair7fix.nul'), 'paths': SELECTED_COUNT, 'fixedNULAllowlistOnly': True, 'forceAddOnly': True})
        self.used.append(name)
        return self.commands.run(name, expected, seconds)
    def complete(self):
        assert self.used == list(self.expected) and len(self.records) == len(self.expected)
