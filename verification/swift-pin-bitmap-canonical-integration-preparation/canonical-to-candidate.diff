+            returned.unwrap()
+        }
+        .unwrap();
+        let valid = inspection::dense_pin_mask(&cache);
+        let corrupt = if occupied {
+            valid ^ 1 ^ 2
+        } else {
+            valid | (1 << 63)
+        };
+        inspection::dense_set_pin_mask(&mut cache, corrupt);
+        let records = inspection::dense_pin_records(&cache);
