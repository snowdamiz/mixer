	        AND pg_catalog.has_type_privilege(w.oid,t.oid,'USAGE') AND pg_catalog.has_type_privilege(l.oid,t.oid,'USAGE'))<>3
	    OR (SELECT count(*) FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace
	      WHERE n.nspname='public' AND pg_catalog.left(p.proname::text,14)='mixer_browser_' AND p.proname<>'mixer_browser_prepare_activation' AND p.proowner=w.oid)<>18
	    OR (SELECT count(*) FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace
	      WHERE n.nspname='public' AND pg_catalog.left(p.proname::text,14)='mixer_browser_' AND p.proname<>'mixer_browser_prepare_activation'
	        AND pg_catalog.has_function_privilege(l.oid,p.oid,'EXECUTE'))<>9
	    OR (SELECT typowner FROM pg_catalog.pg_type WHERE oid='public.mixer_browser_access_evidence'::pg_catalog.regtype)<>o.oid
	    OR (SELECT proowner FROM pg_catalog.pg_proc WHERE oid='public.mixer_browser_prepare_activation(bytea,bytea,bytea,bytea,bigint,public.mixer_browser_access_evidence)'::pg_catalog.regprocedure)<>o.oid
	  THEN RAISE EXCEPTION 'browser preparation provisioning denied' USING ERRCODE='42501'; END IF;
	END $upgrade$;
	
