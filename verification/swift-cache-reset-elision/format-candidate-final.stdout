+fn mm09_held_pin_cleanup() {
+    let _b = Bounds::new();
+    for case in 0..10 {
+        FIXTURES.with(|n| n.set(n.get() + 2));
+        let mut foreign = owner();
+        install_foreign(&mut foreign);
