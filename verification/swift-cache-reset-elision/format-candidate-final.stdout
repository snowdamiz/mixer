+    (work $s:ident,$amount:expr $(,)?) => {{
+        let credits = $amount;
+        $s.phase.work(credits)
+    }};
+    (pop32 $s:ident) => {
+        $s.phase.memory_pop32()
+    };
+    (pages $s:ident) => {
+        $s.phase
+            .phase
+            .operation
+            .control
+            .usage(Some($s.phase.phase.operation.wasi.usage()))
+            .live
+            .memory_pages
+            .current as u32
+    };
+    (maximum $s:ident) => {
+        $s.maximum()?
+    };
+    (push $s:ident, $value:expr) => {
+        $s.phase.memory_push_value($value)
+    };
+    (invariant $s:ident) => {
+        $s.invariant()
+    };
+    (memory $s:ident) => {
+        $s.phase.phase.parts.memory
+    };
+    (allocation $s:ident, $bytes:expr) => {
+        $s.allocate($bytes)
+    };
+    (check $s:ident) => {
+        $s.check()
+    };
+    (zero_check $s:ident,$memory:ident) => {
+        $s.checked_memory(&$memory, 1)
+    };
+    (copy_check $s:ident,$memory:ident) => {
+        $s.checked_memory(&$memory, 2)
+    };
+    (final_check $s:ident,$memory:ident) => {
+        $s.checked_memory(&$memory, 3)
+    };
+    (rollback $s:ident, $memory:ident, $bytes:ident) => {
+        drop($memory);
+        $s.release_pending()?;
+    };
+    (commit $s:ident, $memory:ident, $old_bytes:ident, $next:ident) => {
+        $s.commit($memory, $old_bytes, $next)?;
+    };
 }
