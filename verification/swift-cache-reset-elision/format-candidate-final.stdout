+        p.enter(34).unwrap();
+        p.enter(36).unwrap();
+        p.enter(34).unwrap();
+        let pins = pin_ids(&p);
+        let store = case >= 4 && case <= 7;
+        push(
+            &mut p,
+            if store {
+                &[Value::I32(0), Value::I32(9)]
+            } else {
+                &[Value::I32(-1)]
+            },
+        );
+        let old = if (1..=7).contains(&case) {
+            let base = observed(&p).execution_work;
+            Some(p.phase.operation.control.test_replace_execution_work_limit(
+                base + match case {
+                    1 | 4 => 0,
+                    2 | 5 => 1,
+                    3 => 5,
+                    _ => 2,
+                },
+            ))
+        } else {
+            None
+        };
+        if case == 8 {
+            p.phase.operation.control.cancellation().cancel();
+        }
+        let operation = if case == 9 {
+            Operation::Nop
+        } else if store {
+            STORE
+        } else {
+            LOAD
+        };
+        let failure = op(&mut p, operation).unwrap_err();
+        if let Some(old) = old {
+            p.phase
+                .operation
+                .control
+                .test_replace_execution_work_limit(old);
+        }
+        assert_eq!(pin_ids(&p), pins);
+        hooks(Hooks {
+            release_mask: 7,
+            ..Hooks::default()
+        });
+        let report = p.drain();
+        assert_eq!(report.retained_frames, 3);
+        assert_eq!(pin_ids(&p), pins);
+        assert_eq!(p.phase.parts.cache.usage().active_pins, 3);
+        assert_eq!(report.first_failure.unwrap().code, failure.code);
+        hooks(Hooks::default());
+        assert_eq!(p.drain().retained_frames, 3);
+        assert!(matches!(
+            p.complete(FrameOperationStorage {
+                preparation: prep,
+                ..storage()
+            }),
+            FrameCompletion::Retained(_)
+        ));
+        let mut resumed = Some(own.resume_frame_cleanup());
+        let mut p = resumed.take().unwrap().unwrap();
+        let r = p.drain();
+        assert_eq!(r.retained_frames, 0);
+        assert!(!r.live_unreconciled);
+        assert_eq!(r.first_failure.unwrap().code, failure.code);
+        assert!(matches!(
+            p.complete(FrameOperationStorage {
+                preparation: resumed,
+                ..storage()
+            }),
+            FrameCompletion::Completed
+        ));
+        restore_foreign(&mut foreign);
+        retire(foreign);
+        retire(own);
+    }
 }
