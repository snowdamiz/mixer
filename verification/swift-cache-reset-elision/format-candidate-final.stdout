+fn mm05_load_store_work_prefix() {
+    let _b = Bounds::new();
+    for store in [false, true] {
+        for allowed in 0..=6 {
+            fixture(true, None, |p| {
+                push(
+                    p,
+                    if store {
+                        &[Value::I32(3), Value::I32(0x12345678)]
+                    } else {
+                        &[Value::I32(3)]
+                    },
+                );
+                let before = observed(p);
+                let old = p
+                    .phase
+                    .operation
+                    .control
+                    .test_replace_execution_work_limit(before.execution_work + allowed);
+                let r = op(p, if store { STORE } else { LOAD });
+                p.phase
+                    .operation
+                    .control
+                    .test_replace_execution_work_limit(old);
+                let lengths = if store {
+                    [2, 1, 0, 0, 0, 0, 0]
+                } else {
+                    [1, 0, 0, 0, 0, 0, 1]
+                };
+                assert_eq!(p.phase.parts.values.len(), lengths[allowed as usize]);
+                assert_eq!(r.is_ok(), allowed >= 6);
+                let spent = if store {
+                    if allowed == 0 {
+                        0
+                    } else if allowed == 1 {
+                        1
+                    } else if allowed < 6 {
+                        2
+                    } else {
+                        6
+                    }
+                } else if allowed == 0 {
+                    0
+                } else if allowed < 5 {
+                    1
+                } else if allowed == 5 {
+                    5
+                } else {
+                    6
+                };
+                assert_eq!(observed(p).execution_work - before.execution_work, spent);
+                assert_eq!(
+                    &p.phase.parts.memory[3..7],
+                    if store && allowed >= 6 {
+                        &[0x78, 0x56, 0x34, 0x12]
+                    } else {
+                        &[0; 4]
+                    }
+                );
+            });
+        }
+    }
 }
