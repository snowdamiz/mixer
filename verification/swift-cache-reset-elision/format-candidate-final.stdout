+#[test]
+fn mm03_memory_bounds_overflow() {
+    let _b = Bounds::new();
+    for (address, offset, pass) in [
+        (584 * 65536 - 4, 0, true),
+        (584 * 65536 - 3, 0, false),
+        (-1, u32::MAX, false),
+    ] {
+        fixture(true, None, |p| {
+            push(p, &[Value::I32(address)]);
+            let r = op(
+                p,
+                Operation::Load {
+                    opcode: 0x28,
+                    offset,
+                },
+            );
+            assert_eq!(r.is_ok(), pass);
+            if let Err(e) = r {
+                assert_eq!(e.code, "memory_out_of_bounds");
+                assert!(p.phase.parts.values.is_empty());
+            }
+        });
+    }
+    fixture(true, None, |p| {
+        assert_eq!(
+            p.memory_range(usize::MAX, 1).unwrap_err().code,
+            "memory_out_of_bounds"
+        );
+    });
 }
