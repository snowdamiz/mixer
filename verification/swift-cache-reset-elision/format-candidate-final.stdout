+fn mm08_post_pop_live_fault() {
+    let _b = Bounds::new();
+    fixture(true, None, |p| {
+        p.phase
+            .operation
+            .wasi
+            .dispatch(
+                p.phase.operation.control,
+                crate::experimental_wasi::WasiFunction::ArgsSizesGet,
+                &[Value::I32(0), Value::I32(4)],
