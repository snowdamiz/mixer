+#[test]
+fn mm01_all_load_store_shapes() {
+    let _b = Bounds::new();
+    let expected = [
+        Value::I32(0xf654b381u32 as i32),
+        Value::I64(0xfedcba98f654b381u64 as i64),
+        Value::F32(0xf654b381),
+        Value::F64(0xfedcba98f654b381),
+        Value::I32(-127),
+        Value::I32(129),
+        Value::I32(-19583),
+        Value::I32(45953),
+        Value::I64(-127),
+        Value::I64(129),
+        Value::I64(-19583),
+        Value::I64(45953),
+        Value::I64(-162221183),
+        Value::I64(4132746113),
+    ];
+    for (i, value) in expected.iter().enumerate() {
+        fixture(true, None, |p| {
+            p.phase.parts.memory[3..11].copy_from_slice(&0xfedcba98f654b381u64.to_le_bytes());
+            push(p, &[Value::I32(3)]);
+            let before = observed(p);
+            op(
+                p,
+                Operation::Load {
+                    opcode: 0x28 + i as u8,
+                    offset: 0,
+                },
+            )
+            .unwrap();
+            assert_eq!(p.phase.parts.values.as_slice(), &[*value]);
+            assert_eq!(observed(p).live.values.current, before.live.values.current);
+            assert_eq!(
+                observed(p).execution_work - before.execution_work,
+                2 + width(0x28 + i as u8) as u64
+            );
+        });
+    }
+    for opcode in 0x36..=0x3e {
+        fixture(true, None, |p| {
+            let value = match opcode {
+                0x37 | 0x3c..=0x3e => Value::I64(0xfedcba98f654b381u64 as i64),
+                0x38 => Value::F32(0xf654b381),
+                0x39 => Value::F64(0xfedcba98f654b381),
+                _ => Value::I32(0xf654b381u32 as i32),
+            };
+            push(p, &[Value::I32(3), value]);
+            let before = observed(p);
+            op(p, Operation::Store { opcode, offset: 0 }).unwrap();
+            assert!(p.phase.parts.values.is_empty());
+            let w = width(opcode);
+            assert_eq!(
+                &p.phase.parts.memory[3..3 + w],
+                &0xfedcba98f654b381u64.to_le_bytes()[..w]
+            );
+            assert_eq!(
+                observed(p).execution_work - before.execution_work,
+                2 + w as u64
+            );
+        });
+    }
 }
