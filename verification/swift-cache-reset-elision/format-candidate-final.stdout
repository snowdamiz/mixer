+#[test]
+fn mm02_little_endian_nan_unaligned() {
+    let _b = Bounds::new();
+    for offset in [1, 3, 7] {
+        for value in [
+            Value::F32(0),
+            Value::F32(0x80000000),
+            Value::F32(0x7f800000),
+            Value::F32(0x7fc12345),
+            Value::F32(0x7f812345),
+            Value::F32(0x12345678),
+            Value::F64(0),
+            Value::F64(0x8000000000000000),
+            Value::F64(0x7ff0000000000000),
+            Value::F64(0x7ff8123456789abc),
+            Value::F64(0x7ff0123456789abc),
+            Value::F64(0x123456789abcdef0),
+        ] {
+            fixture(true, None, |p| {
+                let (store, load, bits) = match value {
+                    Value::F32(x) => (0x38, 0x2a, x as u64),
+                    Value::F64(x) => (0x39, 0x2b, x),
+                    _ => unreachable!(),
+                };
+                push(p, &[Value::I32(10), value]);
+                op(
+                    p,
+                    Operation::Store {
+                        opcode: store,
+                        offset,
+                    },
+                )
+                .unwrap();
+                let w = width(store);
+                assert_eq!(
+                    &p.phase.parts.memory[10 + offset as usize..10 + offset as usize + w],
+                    &bits.to_le_bytes()[..w]
+                );
+                push(p, &[Value::I32(10)]);
+                op(
+                    p,
+                    Operation::Load {
+                        opcode: load,
+                        offset,
+                    },
+                )
+                .unwrap();
+                assert_eq!(p.phase.parts.values.as_slice(), &[value]);
+            });
+        }
+    }
 }
