 fn fixture(enter: bool, body: Option<&[u8]>, action: impl FnOnce(&mut FrameOperationPhase<'_>)) {
- FIXTURES.with(|n|n.set(n.get()+1));
- let mut owned=if let Some(b)=body { body_owner(b,false,&[],SwiftRunBudget::default()) } else {owner()};
- let before=owned.control.as_ref().unwrap().usage(None).reservations.construction.current;
- let mut prep=Some(owned.prepare_frames(cursor())); let mut phase=prep.take().unwrap().unwrap();
- if enter {phase.enter(34).unwrap();}
- assert_eq!(phase.phase.parts.memory.len(),584*65536);
- assert!(phase.phase.parts.frames.len()<=3);
- let start=STEPS.with(Cell::get);
- action(&mut phase);
- assert!(STEPS.with(Cell::get)-start<=64);
- hooks(Hooks::default()); PC_OVERFLOW.with(|v|v.set(false)); CHECK_CANCEL.with(|v|v.set(None)); CHECKS.with(|v|v.set(0));
- let report=phase.drain(); assert_eq!(report.retained_frames,0);
- let debt=report.live_unreconciled;
- let completion=phase.complete(FrameOperationStorage{preparation:prep,..storage()});
- if debt { assert!(matches!(completion,FrameCompletion::Retained(_))); let mut own=Some(owned); assert!(SwiftReactorInstance::cleanup_owned(&mut own).is_err()); assert!(own.is_some()); drop(own); }
