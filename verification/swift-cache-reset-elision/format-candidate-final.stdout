+                assert_eq!(&p.phase.parts.memory[..4 * CHUNK], expected.as_slice());
+                assert_eq!(
+                    observed(p).execution_work - before.execution_work,
+                    3 + len as u64
+                );
+                assert_eq!(
+                    observed(p).instruction_fuel - before.instruction_fuel,
+                    len.div_ceil(64) as u64
