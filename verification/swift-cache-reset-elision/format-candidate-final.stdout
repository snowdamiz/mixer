+#[test]
+fn mm11_slot_vacancy() {
+    let _b = Bounds::new();
+    for direct in [false, true] {
+        for failed in [false, true] {
+            fixture(true, Some(BODY), |p| {
+                push(p, &[Value::I32(0)]);
+                p.phase.parts.frames[0].pc = 1;
+                let saved = if failed {
+                    Err(p.invariant("first_failure"))
+                } else {
+                    Ok(())
+                };
+                let mut s = storage();
+                s.entry = Some(saved);
+                let before = observed(p);
+                let pins = pin_ids(p);
+                assert!(if direct {
+                    p.memory_operation(LOAD, &mut s.entry)
+                } else {
+                    pinned(p, &mut s)
+                }
+                .is_err());
+                assert_eq!(s.entry, Some(saved));
+                assert_eq!(p.phase.parts.frames[0].pc, 1);
+                assert_eq!(pin_ids(p), pins);
+                assert_eq!(p.phase.parts.values.len(), 1);
+                assert_eq!(
+                    (observed(p).instructions, observed(p).execution_work),
+                    (before.instructions, before.execution_work)
+                );
+                if failed {
+                    assert_eq!(p.invariant("later").code, "first_failure");
+                }
+            });
+        }
+    }
+}
+#[test]
+fn mm12_outcome_completion() {
+    let _b = Bounds::new();
+    fixture(true, Some(BODY), |p| {
+        push(p, &[Value::I32(-1)]);
+        p.phase.parts.frames[0].pc = 1;
+        let mut s = storage();
+        assert_eq!(pinned(p, &mut s), Ok(()));
+        let e = s.entry.unwrap().unwrap_err();
+        let before = observed(p);
+        assert!(pinned(p, &mut s).is_err());
+        assert_eq!(s.entry, Some(Err(e)));
+        assert_eq!(observed(p).instructions, before.instructions);
+    });
+    fixture(true, Some(BODY), |p| {
+        push(p, &[Value::I32(0)]);
+        p.phase.parts.frames[0].pc = 1;
+        let mut s = storage();
+        pinned(p, &mut s).unwrap();
+        assert_eq!(s.entry.take(), Some(Ok(())));
+        p.phase.parts.frames[0].pc = 1;
+        pinned(p, &mut s).unwrap();
+        assert_eq!(s.entry, Some(Ok(())));
+        assert_eq!(p.phase.parts.frames[0].pc, 2);
+    });
+    // Feed the actual occupied failure slot through original fixed completion.
+    FIXTURES.with(|n| n.set(n.get() + 1));
+    let mut own = owner();
+    let mut s = storage();
+    s.preparation = Some(own.prepare_frames(cursor()));
+    let mut p = s.preparation.take().unwrap().unwrap();
+    p.enter(34).unwrap();
+    push(&mut p, &[Value::I32(-1)]);
+    p.memory_operation(LOAD, &mut s.entry).unwrap();
+    let e = s.entry.unwrap().unwrap_err();
+    s.drained = Some(p.drain());
+    assert_eq!(
+        s.drained.as_ref().unwrap().first_failure.unwrap().code,
+        e.code
+    );
+    assert!(matches!(p.complete(s), FrameCompletion::Completed));
+    retire(own);
+}
+#[test]
+fn mm13_no_alloc_warm() {
+    let _b = Bounds::new();
+    for opcode in 0x28..=0x3e {
+        for trap in [false, true] {
+            fixture(true, None, |p| {
+                let address = Value::I32(if trap { -1 } else { 0 });
+                let store = opcode >= 0x36;
+                let value = match opcode {
+                    0x37 | 0x3c..=0x3e => Value::I64(-1),
+                    0x38 => Value::F32(0x7fc12345),
+                    0x39 => Value::F64(0x7ff0123456789abc),
+                    _ => Value::I32(-1),
+                };
+                if store {
+                    push(p, &[address, value]);
+                } else {
+                    push(p, &[address]);
+                }
+                let operation = if store {
+                    Operation::Store { opcode, offset: 0 }
+                } else {
+                    Operation::Load { opcode, offset: 0 }
+                };
+                let ((outer, slot), stats) = measure_extended(Some(0), || {
+                    let mut s = None;
+                    let r = p.memory_operation(operation, &mut s);
+                    (r, s)
+                });
+                assert_eq!(stats.attempts, 0);
+                assert_eq!(stats.injected_failures, 0);
+                outer.unwrap();
+                assert_eq!(slot.unwrap().is_ok(), !trap);
+            });
+        }
+    }
+    for store in [false, true] {
+        for cancel in [false, true] {
+            for checkpoint in 0..3 {
+                fixture(true, None, |p| {
+                    if store {
+                        push(p, &[Value::I32(0), Value::I32(9)]);
+                    } else {
+                        push(p, &[Value::I32(0)]);
+                    }
+                    if cancel {
+                        hooks(Hooks {
+                            push_fault: 6,
+                            cancel_local: Some(checkpoint),
+                            ..Hooks::default()
+                        });
+                    } else {
+                        let base = observed(p).execution_work;
+                        p.phase.operation.control.test_replace_execution_work_limit(
+                            base + if checkpoint == 2 && !store {
+                                5
+                            } else {
+                                checkpoint as u64
+                            },
+                        );
+                    }
+                    let ((outer, slot), stats) = measure_extended(Some(0), || {
+                        let mut s = None;
+                        let r = p.memory_operation(if store { STORE } else { LOAD }, &mut s);
+                        (r, s)
+                    });
+                    assert_eq!(stats.attempts, 0);
+                    assert_eq!(stats.injected_failures, 0);
+                    outer.unwrap();
+                    assert!(slot.unwrap().is_err());
+                });
+            }
+        }
+    }
+}
+#[test]
+fn mm14_frozen_parity() {
+    let _b = Bounds::new();
+    fixture(true, None, |p| {
+        push(p, &[Value::I32(0), Value::I32(0x12345678)]);
+        op(p, STORE).unwrap();
+        push(p, &[Value::I32(0)]);
+        op(p, LOAD).unwrap();
+        assert_eq!(p.phase.parts.values.as_slice(), &[Value::I32(0x12345678)]);
+        assert_eq!(&p.phase.parts.memory[..4], &[0x78, 0x56, 0x34, 0x12]);
+    });
+    #[cfg(feature = "experimental-span-execution")]
+    {
+        use crate::experimental::{
+            cache::{CacheBudget, FunctionCache},
+            execution::{ExecutionBudget, SpanInstance},
+            validate_spans, ValidationBudget,
+        };
+        FIXTURES.with(|n| n.set(n.get() + 1));
+        // Original bounded Wasm binary fixture: ()->i32, one-page memory, run export.
+        let bytes: Vec<u8> = [
+            b"\0asm\x01\0\0\0".as_slice(),
+            &[
+                1, 5, 1, 0x60, 0, 1, 0x7f, 3, 2, 1, 0, 5, 4, 1, 1, 1, 1, 7, 7, 1, 3, b'r', b'u',
+                b'n', 0, 0, 10, 16, 1, 14, 0, 0x41, 0, 0x41, 0x78, 0x36, 2, 0, 0x41, 0, 0x28, 2, 0,
+                0x0b,
+            ],
+        ]
+        .concat();
+        let limits = crate::Limits {
+            profile: crate::Profile::TableMemoryV3,
+            ..crate::Limits::default()
+        };
+        let cancel = crate::Cancellation::default();
+        let spans = validate_spans(&bytes, limits, ValidationBudget::default(), &cancel).unwrap();
+        let cache = FunctionCache::new(spans, CacheBudget::default(), &cancel).unwrap();
+        let mut frozen = SpanInstance::new(cache, ExecutionBudget::default(), cancel).unwrap();
+        assert_eq!(frozen.invoke("run", &[]).unwrap(), Some(Value::I32(-8)));
+        assert_eq!(&frozen.memory()[..4], &[0xf8, 0xff, 0xff, 0xff]);
+        assert_eq!(frozen.usage().active_pins, 0);
+        println!("MM_FROZEN executed original public SpanInstance load/store; baseline/candidate oracle suite separately bound");
+    }
+    #[cfg(not(feature = "experimental-span-execution"))]
+    println!("MM_FROZEN feature absent in Swift-only build; baseline/candidate execution oracle is separate all-feature receipt");
+}
+#[test]
+fn mm15_deferred_fail_closed() {
+    let _b = Bounds::new();
+    for operation in [
+        Operation::MemoryCopy,
+        Operation::MemoryFill,
+        Operation::MemoryGrow,
+        Operation::MemorySize,
+        Operation::Return,
+        Operation::Const(Value::I32(0)),
+        Operation::Nop,
+    ] {
+        fixture(true, None, |p| {
+            push(p, &[Value::I32(0), Value::I32(1)]);
+            let cap = p.phase.parts.memory.capacity();
+            let before = observed(p);
+            assert_eq!(
+                op(p, operation).unwrap_err().kind,
+                SwiftRunFailureKind::UnsupportedEnvironment
+            );
+            assert_eq!(p.phase.parts.memory.capacity(), cap);
+            assert_eq!(p.phase.parts.values.len(), 2);
+            assert_eq!(observed(p).reservations, before.reservations);
+            assert_eq!(observed(p).execution_work, before.execution_work);
+        });
+    }
+}
+#[test]
+fn mm16_accounting_restore() {
+    let _b = Bounds::new();
+    fixture(true, None, |p| {
+        let before = observed(p);
+        push(p, &[Value::I32(0)]);
+        op(p, LOAD).unwrap();
+        assert_eq!(observed(p).reservations, before.reservations);
+        assert_eq!(
+            FRAME_OPERATION_BYTES.unwrap(),
+            super::super::ACTIVE_BYTES
+                + value_operations::VALUE_OPERATION_BYTES.unwrap()
+                + control_operations::ACTIVE_BYTES
+                + ACTIVE_BYTES
+                + super::super::bulk_memory_operations::ACTIVE_BYTES
+                + super::super::memory_growth_operations::ACTIVE_BYTES
+                + super::super::host_runtime_import::ACTIVE_BYTES
+                + super::super::call_dispatch::ACTIVE_BYTES.unwrap()
+        );
+        assert_eq!(SwiftRunBudget::default().state_bytes, 128 * 1024 * 1024);
+        assert_eq!(SwiftRunBudget::default().combined_bytes, 256 * 1024 * 1024);
+        println!("MM_EXTERNAL exact MIR inventory and eight actual layouts are bound outside runtime fixture");
+    });
+}
 
