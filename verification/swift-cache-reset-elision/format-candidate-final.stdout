+#[test]
+fn mm06_cancel_prefix() {
+    let _b = Bounds::new();
+    for store in [false, true] {
+        for checkpoint in 0..=3 {
+            fixture(true, None, |p| {
+                push(
+                    p,
+                    if store {
+                        &[Value::I32(3), Value::I32(9)]
+                    } else {
+                        &[Value::I32(3)]
+                    },
+                );
+                hooks(Hooks {
+                    push_fault: 6,
+                    cancel_local: Some(checkpoint),
+                    ..Hooks::default()
+                });
+                let r = op(p, if store { STORE } else { LOAD });
+                assert_eq!(r.is_ok(), checkpoint >= 3);
+                let expected = if store { [2, 1, 0, 0] } else { [1, 0, 0, 1] };
+                assert_eq!(p.phase.parts.values.len(), expected[checkpoint]);
+                assert_eq!(
+                    p.phase.parts.memory[3],
+                    if store && checkpoint >= 3 { 9 } else { 0 }
+                );
+                if let Err(e) = r {
+                    assert_eq!(e.kind, SwiftRunFailureKind::Cancelled);
+                }
+            });
+        }
+    }
+    fixture(true, Some(BODY), |p| {
+        p.phase.parts.frames[0].pc = 1;
+        push(p, &[Value::I32(0)]);
+        hooks(Hooks {
+            push_fault: 6,
+            cancel_local: Some(0),
+            ..Hooks::default()
+        });
+        let before = observed(p);
+        let pins = pin_ids(p);
+        let memory = p.phase.parts.memory[..8].to_vec();
+        let mut s = storage();
+        assert_eq!(pinned(p, &mut s), Ok(()));
+        assert_eq!(
+            s.entry.unwrap().unwrap_err().kind,
+            SwiftRunFailureKind::Cancelled
+        );
+        assert_eq!(observed(p).instructions, before.instructions + 1);
+        assert_eq!(observed(p).instruction_fuel, before.instruction_fuel + 1);
+        assert_eq!(observed(p).execution_work, before.execution_work);
+        assert_eq!(p.phase.parts.frames[0].pc, 1);
+        assert_eq!(p.phase.parts.values.as_slice(), &[Value::I32(0)]);
+        assert_eq!(pin_ids(p), pins);
+        assert_eq!(&p.phase.parts.memory[..8], memory.as_slice());
+        assert!(matches!(p.lifecycle, Lifecycle::Terminal));
+        assert!(matches!(p.cleanup.disposition, FrameDisposition::Draining));
+        println!("MM06_CALLER_CANCEL afterInstruction=true instructionDelta=1 fuelDelta=1 workDelta=0 pcDelta=0 valueDelta=0 memoryChanged=false pinsChanged=false outerPublication=Ok stored=Cancelled terminal=true draining=true");
+    });
 }
