+#[test]
+fn mm04_opcode_type_floor_closed() {
+    let _b = Bounds::new();
+    for operation in [
+        Operation::Nop,
+        Operation::Load {
+            opcode: 0x36,
+            offset: 0,
+        },
+        Operation::Store {
+            opcode: 0x35,
+            offset: 0,
+        },
+    ] {
+        fixture(true, None, |p| {
+            push(p, &[Value::I32(1), Value::I32(2)]);
+            let before = observed(p);
+            assert_eq!(
+                op(p, operation).unwrap_err().kind,
+                SwiftRunFailureKind::UnsupportedEnvironment
+            );
+            assert_eq!(p.phase.parts.values.len(), 2);
+            assert_eq!(observed(p).execution_work, before.execution_work);
+        });
+    }
+    fixture(false, None, |p| {
+        assert_eq!(op(p, LOAD).unwrap_err().code, "swift_memory_frame_missing");
+    });
+    for fault in 0..7 {
+        fixture(true, None, |p| {
+            push(p, &[Value::I32(0), Value::I32(7)]);
+            let f = &mut p.phase.parts.frames[0];
+            let original = (f.base, f.operands, f.controls);
+            match fault {
+                0 => f.base = 1,
+                1 => f.operands = 3,
+                2 => f.operands = 2,
+                3 => f.operands = 1,
+                4 => f.controls = 99,
+                5 => p.phase.parts.values[0] = Value::I64(0),
+                _ => p.phase.parts.values[1] = Value::F64(0),
+            };
+            let before = observed(p);
