            value = .object(["kind": .string("rejected"), "code": .string(rejection.rawValue)])
        }
        return try CapabilityCodec.encodeObject(["abi": .uint(1), "capability": .string(metadata.capability),
            "schemaHash": .string(metadata.schemaHash), "operation": .string(metadata.operation), "outcome": value])
    }
}

