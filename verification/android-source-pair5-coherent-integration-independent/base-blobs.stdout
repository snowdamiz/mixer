                if count < 0, errno == EINTR { continue }
                guard count > 0 else { throw Self.ioError("write private store") }
                offset += count
            }
        }
    }

    private static func ioError(_ operation: String) -> UpdateError {
        UpdateError("store.io", "\(operation) failed (errno \(errno))")
    }
}

