package android.view;import java.util.ArrayList;import java.util.List;import dev.mixer.android.ConcreteHostProbe;public class ViewTreeObserver {public interface OnWindowFocusChangeListener {void onWindowFocusChanged(boolean focused);}public boolean alive=true;public final List<OnWindowFocusChangeListener> listeners=new ArrayList<>();public int addCalls,removeCalls;public boolean isAlive(){ConcreteHostProbe.hit("ViewTreeObserver.isAlive","entry",this);boolean value=alive;ConcreteHostProbe.hit("ViewTreeObserver.isAlive","beforeReturn",this);return value;}public void addOnWindowFocusChangeListener(OnWindowFocusChangeListener listener){ConcreteHostProbe.hit("ViewTreeObserver.addOnWindowFocusChangeListener","entry",this);addCalls++;listeners.add(listener);ConcreteHostProbe.hit("ViewTreeObserver.addOnWindowFocusChangeListener","beforeReturn",this);}public void removeOnWindowFocusChangeListener(OnWindowFocusChangeListener listener){ConcreteHostProbe.hit("ViewTreeObserver.removeOnWindowFocusChangeListener","entry",this);removeCalls++;listeners.removeIf(item->item==listener);ConcreteHostProbe.hit("ViewTreeObserver.removeOnWindowFocusChangeListener","beforeReturn",this);}public void hostWindowFocus(boolean focused){for(OnWindowFocusChangeListener listener:List.copyOf(listeners))listener.onWindowFocusChanged(focused);}}

