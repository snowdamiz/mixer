    private static void validate(Environment environment) {
        admit(environment != null && environment.scheme() != null && environment.direction() != null &&
            environment.profile() != null && environment.viewport() != null && environment.safeArea64() != null &&
            environment.accessibility() != null, Error.shape);
        admit(environment.density1024() >= 128 && environment.density1024() <= 16384, Error.geometry);
        Viewport viewport = environment.viewport(); SafeArea safe = environment.safeArea64();
        admit(viewport.width64() > 0 && viewport.width64() <= AppearanceGeometryV2.MAXIMUM_EXTENT64 &&
            viewport.height64() > 0 && viewport.height64() <= AppearanceGeometryV2.MAXIMUM_EXTENT64 &&
            inset(safe.top()) && inset(safe.leading()) && inset(safe.bottom()) && inset(safe.trailing()), Error.geometry);
        // Each operand is <= Int32.max, so these sums cannot overflow long.
        admit(safe.leading() + safe.trailing() <= viewport.width64() &&
            safe.top() + safe.bottom() <= viewport.height64(), Error.geometry);
        String locale = environment.localeIdentifier();
        admit(locale != null && !locale.isEmpty() && locale.length() <= 128, Error.shape);
        for (int i = 0; i < locale.length(); i++) {
            char c = locale.charAt(i);
            if (Character.isHighSurrogate(c)) {
                admit(i + 1 < locale.length() && Character.isLowSurrogate(locale.charAt(i + 1)), Error.shape);
                i++;
            } else admit(!Character.isLowSurrogate(c), Error.shape);
        }
        admit(locale.getBytes(StandardCharsets.UTF_8).length <= 128, Error.shape);
        for (int i = 0; i < locale.length();) {
            int codepoint = locale.codePointAt(i); int category = Character.getType(codepoint);
            admit(category != Character.CONTROL && category != Character.FORMAT, Error.shape);
            i += Character.charCount(codepoint);
        }
        admit(unsigned(environment.generation()), Error.shape);
        admit(!environment.accessibility().boldText() && !environment.accessibility().increasedContrast(),
            Error.unsupportedNativeOperation);
    }
    private static boolean inset(long value) { return value >= 0 && value <= AppearanceGeometryV2.MAXIMUM_EXTENT64; }
    private static boolean unsigned(String value) {
        if (value == null || value.isEmpty() || value.length() > 20 || value.length() > 1 && value.charAt(0) == '0') return false;
        for (int i = 0; i < value.length(); i++) if (value.charAt(i) < '0' || value.charAt(i) > '9') return false;
        return new BigInteger(value).bitLength() <= 64;
    }
    private record Pending(UiPacket.Node node, Identity listAncestor, boolean disabled, boolean root) {}
    private static void preflight(UiPacket packet) {
        int visited = 0, children = 0, groups = 0, rows = 0, gaps = 0;
        ArrayDeque<Pending> pending = new ArrayDeque<>(); pending.push(new Pending(packet.root, null, false, true));
        while (!pending.isEmpty()) {
            Pending item = pending.pop(); UiPacket.Node node = item.node();
            admit(visited < MAXIMUM_NODES && packet.nodes.get(node.id) == node, Error.shape);
            admit(!(node.kind.equals("list") && item.listAncestor() != null) &&
                !(node.kind.equals("navigation") && !item.root()), Error.unsupportedNativeOperation);
            visited++; children += node.children.size();
            if (node.kind.equals("vStack") || node.kind.equals("hStack") || node.kind.equals("section"))
                gaps += Math.max(0, node.children.size() - 1);
            if (node.kind.equals("list")) {
                boolean run = false;
                for (UiPacket.Node child : node.children) {
                    if (child.kind.equals("section")) { groups++; rows += child.children.size(); run = false; }
                    else { if (!run) groups++; rows++; run = true; }
                }
            }
            admit(children < MAXIMUM_NODES && groups <= MAXIMUM_NODES && rows < MAXIMUM_NODES && gaps < MAXIMUM_NODES &&
                node.children.size() <= MAXIMUM_NODES - visited - pending.size(), Error.valueLimit);
            Identity list = node.kind.equals("list") ? identity(node) : item.listAncestor();
            for (int i = node.children.size() - 1; i >= 0; i--)
                pending.push(new Pending(node.children.get(i), list, false, false));
        }
        long references = (long)visited + children + groups + 2L * rows;
        admit(visited == packet.nodes.size() && references <= 5L * MAXIMUM_NODES, Error.valueLimit);
    }

    private static final class Resolver {
        private final UiPacket packet;
        private final Theme theme;
        private final Profile profile;
        private final Roles roles;
        private final Map<String, List<Group>> groups = new HashMap<>();
        private final Map<String, SectionContext> sections = new HashMap<>();
        private final Map<String, RowPlacement> rows = new HashMap<>();
        Resolver(UiPacket packet, Theme theme, Profile profile) {
            this.packet = packet; this.theme = theme; this.profile = profile;
            Profiles p = theme.typography().profiles();
            roles = switch (profile) {
                case xs -> p.xs(); case s -> p.s(); case m -> p.m(); case l -> p.l();
                case xl -> p.xl(); case xxl -> p.xxl(); case xxxl -> p.xxxl();
                case a1 -> p.a1(); case a2 -> p.a2(); case a3 -> p.a3(); case a4 -> p.a4(); case a5 -> p.a5();
            };
        }
        Text text(String value, Role role) { return text(value, role, false, null); }
        Text text(String value, Role role, boolean selectable, Integer maximumLines) {
            Metric metric = switch (role) {
                case body -> roles.body(); case headline -> roles.headline(); case title -> roles.title();
                case caption -> roles.caption(); case sectionHeader -> roles.sectionHeader();
                case navigationExpanded -> roles.navigationExpanded();
            };
            return new Text(value, role, metric, selectable, maximumLines);
        }
        Text header(UiPacket.Node node) {
            String title = node.text("title", ""); return title.isEmpty() ? null : text(title, Role.sectionHeader);
        }
        void placements() {
            for (UiPacket.Node node : packet.nodes.values()) {
                if (!node.kind.equals("list")) continue;
                List<Group> list = new ArrayList<>(); List<UiPacket.Node> run = new ArrayList<>();
                for (UiPacket.Node child : node.children) {
                    if (child.kind.equals("section")) {
                        if (!run.isEmpty()) { append(list, run, null, node); run.clear(); }
                        append(list, child.children, child, node);
                    } else run.add(child);
                }
                if (!run.isEmpty()) append(list, run, null, node);
                groups.put(node.id, List.copyOf(list));
            }
        }
        void append(List<Group> list, List<UiPacket.Node> children, UiPacket.Node section, UiPacket.Node owner) {
            Identity source = identity(section == null ? children.get(0) : section), listID = identity(owner);
            Text title = section == null ? null : header(section);
            boolean visible = title != null || !children.isEmpty(), previous = false;
            for (Group group : list) previous |= group.visible();
            GroupedList metrics = theme.groupedList();
            int gap = !visible ? 0 : !previous ? metrics.topPadding64() :
                title == null ? metrics.groupWithoutHeaderGap64() : metrics.groupToNextHeader64();
            int index = list.size();
            if (section != null) sections.put(section.id, new ListGroup(listID, index));
            List<Identity> identities = new ArrayList<>(children.size());
            for (int i = 0; i < children.size(); i++) {
                UiPacket.Node child = children.get(i); identities.add(identity(child));
                rows.put(child.id, new RowPlacement(listID, index, i, i + 1 < children.size()));
            }
            list.add(new Group(section == null ? new DirectRunSource(source) : new SectionSource(source), title, identities,
                visible, gap, title != null && !children.isEmpty() ? metrics.headerToGroup64() : 0));
        }
        Recipe recipe(UiPacket.Node node, Identity listAncestor) {
            String label = node.text("label", "");
            return switch (node.kind) {
                case "text" -> new TextRecipe(text(node.text("text", ""), Role.valueOf(node.text("style", "body")),
                    node.flag("selectable", false), node.properties.containsKey("maxLines") ? (int)node.number("maxLines", 0) : null));
                case "button" -> new ButtonRecipe(ButtonRole.valueOf(node.text("role", "normal")), text(label, Role.body), theme.button());
                case "textField" -> new FieldRecipe(label, node.text("value", ""), text(node.text("value", ""), Role.body), theme.field());
                case "toggle" -> new ToggleRecipe(text(label, Role.body), node.flag("value", false), theme.toggle());
                case "vStack" -> {
                    List<Integer> gaps = new ArrayList<>();
                    for (int i = 0; i + 1 < node.children.size(); i++) {
                        UiPacket.Node first = node.children.get(i), second = node.children.get(i + 1);
                        boolean pair = first.kind.equals("text") && second.kind.equals("text") &&
                            first.text("style", "body").equals("body") && second.text("style", "").equals("caption");
                        gaps.add(node.properties.containsKey("spacing") ? AppearanceGeometryV2.spacing64(node.number("spacing", 0)) :
                            pair ? theme.stacks().bodyCaptionGap64() : theme.stacks().defaultGap64());
                    }
                    yield new VStackRecipe(gaps, HorizontalAlignment.valueOf(node.text("alignment", theme.stacks().vStackAlignment().name())));
                }
                case "hStack" -> new HStackRecipe(gaps(node), VerticalAlignment.valueOf(node.text("alignment", theme.stacks().hStackAlignment().name())));
                case "zStack" -> new ZStackRecipe(OverlayAlignment.valueOf(node.text("alignment", theme.stacks().zStackAlignment().name())));
                case "list" -> {
                    Floors f = theme.groupedList().profileFloors64();
                    int floor = switch (profile) {
                        case xs -> f.xs(); case s -> f.s(); case m -> f.m(); case l -> f.l(); case xl -> f.xl();
                        case xxl -> f.xxl(); case xxxl -> f.xxxl(); case a1 -> f.a1(); case a2 -> f.a2();
                        case a3 -> f.a3(); case a4 -> f.a4(); case a5 -> f.a5();
                    };
                    List<Group> list = groups.get(node.id); boolean visible = false;
                    for (Group group : list) visible |= group.visible();
                    yield new ListRecipe(theme.groupedList(), floor, list, visible ? theme.groupedList().bottomPadding64() : 0);
                }
                case "section" -> {
                    Text title = header(node); SectionContext context = sections.get(node.id);
                    if (context == null) context = listAncestor == null ? new OutsideList() : new WithinListRow(listAncestor);
                    boolean grouped = context instanceof ListGroup;
                    yield new SectionRecipe(title, context, !grouped && title != null && !node.children.isEmpty() ? theme.groupedList().headerToGroup64() : 0,
                        grouped ? List.of() : repeated(theme.stacks().defaultGap64(), node.children.size()), HorizontalAlignment.leading);
                }
                case "navigation" -> {
                    String title = node.text("title", "");
                    yield new NavigationRecipe(title.isEmpty() ? null : text(title, Role.navigationExpanded),
                        title.isEmpty() ? null : text(title, Role.headline, false, 1), theme.navigation());
                }
                default -> throw new Failure(Error.unsupportedNativeOperation);
            };
        }
        List<Integer> gaps(UiPacket.Node node) {
            int gap = node.properties.containsKey("spacing") ? AppearanceGeometryV2.spacing64(node.number("spacing", 0)) : theme.stacks().defaultGap64();
            return repeated(gap, node.children.size());
        }
    }
    private static List<Integer> repeated(int value, int childCount) {
        List<Integer> result = new ArrayList<>(Math.max(0, childCount - 1));
        for (int i = 1; i < childCount; i++) result.add(value);
        return result;
    }
    private static Identity identity(UiPacket.Node node) { return new Identity(node.id, node.generation); }
    private static Color rolePaint(RolePaints paints, Role role) {
        return switch (role) {
            case body -> paints.body(); case headline -> paints.headline(); case title -> paints.title();
            case caption -> paints.caption(); case sectionHeader -> paints.sectionHeader(); case navigationExpanded -> paints.navigationExpanded();
        };
    }
    private static void admit(boolean condition, Error error) { if (!condition) throw new Failure(error); }
}

2c0bbc4064b3103c0b8aba531fbd764998b70b6b blob 10674
public struct UIValidationLimits: Equatable, Sendable {
    public static let standard = UIValidationLimits()
    public let maximumMessageBytes: Int
    public let maximumNodes: Int
    public let maximumDepth: Int
    public let maximumChildrenPerNode: Int
    public let maximumStringBytes: Int

    public init(maximumMessageBytes: Int = 1_048_576, maximumNodes: Int = 4096,
                maximumDepth: Int = 64, maximumChildrenPerNode: Int = 1000,
                maximumStringBytes: Int = 16_384) {
        self.maximumMessageBytes = maximumMessageBytes
        self.maximumNodes = maximumNodes
        self.maximumDepth = maximumDepth
        self.maximumChildrenPerNode = maximumChildrenPerNode
        self.maximumStringBytes = maximumStringBytes
    }

    var isValid: Bool {
        (1...16_777_216).contains(maximumMessageBytes) && (1...65_536).contains(maximumNodes)
            && (1...128).contains(maximumDepth) && (1...10_000).contains(maximumChildrenPerNode)
            && (1...262_144).contains(maximumStringBytes)
    }
}

public enum UIValidationError: Error, Equatable, Sendable {
    case unguardedDecoder
    case invalidLimits
    case unsupportedSchema(Int)
    case limitExceeded(String)
    case invalidIdentifier(String)
    case duplicateIdentity(String)
    case unsupportedNode(NodeKind)
    case unsupportedField(String)
    case invalidProperty(node: String, key: String)
    case invalidChildren(String)
    case invalidAction(node: String, event: UIEventKind)
}

public struct ValidatedUIDocument: Sendable {
    public let document: UIDocument
    public let nodeCount: Int
    // Only a validator can establish this type's invariant.
    init(document: UIDocument, nodeCount: Int) { self.document = document; self.nodeCount = nodeCount }
}

public struct UIValidator: Sendable {
    public let limits: UIValidationLimits
    public let supportedKinds: Set<NodeKind>

    public init(limits: UIValidationLimits = .standard, supportedKinds: Set<NodeKind> = Set(NodeKind.allCases)) {
        self.limits = limits; self.supportedKinds = supportedKinds
    }

    public func validate(_ document: UIDocument) throws -> ValidatedUIDocument {
        guard limits.isValid else { throw UIValidationError.invalidLimits }
        guard document.schemaVersion == UIDocument.currentSchemaVersion else {
            throw UIValidationError.unsupportedSchema(document.schemaVersion)
        }
        var pending = [(document.root, 1)]
        var identities: Set<String> = []
        var bytes = 0
        while let (node, depth) = pending.popLast() {
            guard depth <= limits.maximumDepth else { throw UIValidationError.limitExceeded("depth") }
            guard identities.count < limits.maximumNodes else { throw UIValidationError.limitExceeded("nodes") }
            guard validIdentifier(node.id) else { throw UIValidationError.invalidIdentifier(node.id) }
            guard identities.insert(node.id).inserted else { throw UIValidationError.duplicateIdentity(node.id) }
            guard supportedKinds.contains(node.kind) else { throw UIValidationError.unsupportedNode(node.kind) }
            guard node.children.count <= limits.maximumChildrenPerNode else { throw UIValidationError.limitExceeded("children") }
            guard node.properties.count <= 16 else { throw UIValidationError.limitExceeded("properties") }
            guard node.actions.count <= 4 else { throw UIValidationError.limitExceeded("actions") }
            bytes += node.id.utf8.count + node.kind.rawValue.utf8.count
            for (key, value) in node.properties {
                bytes += key.utf8.count
                switch value {
                case let .string(string):
                    guard string.utf8.count <= limits.maximumStringBytes else { throw UIValidationError.limitExceeded("stringBytes") }
                    bytes += string.utf8.count
                case let .number(number):
                    guard number.isFinite else { throw UIValidationError.invalidProperty(node: node.id, key: key) }
                    bytes += 8
                case .bool: bytes += 1
                case .null: break
                }
            }
            try validateProperties(of: node)
            try validateStructure(of: node)
            var events: Set<UIEventKind> = []
            for action in node.actions {
                guard validIdentifier(action.id) else { throw UIValidationError.invalidIdentifier(action.id) }
                guard events.insert(action.event).inserted, permittedEvents(for: node.kind).contains(action.event) else {
                    throw UIValidationError.invalidAction(node: node.id, event: action.event)
                }
                bytes += action.id.utf8.count + action.event.rawValue.utf8.count
            }
            for required in requiredEvents(for: node.kind) where !events.contains(required) {
                throw UIValidationError.invalidAction(node: node.id, event: required)
            }
            // This aggregate bound also protects in-memory trees before encoding. The exact
            // serialized byte bound is checked by encode/decode on the wire.
            guard bytes <= limits.maximumMessageBytes else { throw UIValidationError.limitExceeded("contentBytes") }
            // Admit the entire next frontier before retaining any child. Counting
            // only visited identities lets a wide/deep tree grow pending storage
            // beyond the node limit before it reaches the eventual rejection.
            guard node.children.isEmpty || depth < limits.maximumDepth else {
                throw UIValidationError.limitExceeded("depth")
            }
            let availableNodes = limits.maximumNodes - identities.count - pending.count
            guard node.children.count <= availableNodes else {
                throw UIValidationError.limitExceeded("nodes")
            }
            for child in node.children.reversed() { pending.append((child, depth + 1)) }
        }
        return ValidatedUIDocument(document: document, nodeCount: identities.count)
    }

    private func validateProperties(of node: UINode) throws {
        let strings = ["accessibilityLabel", "accessibilityHint", "accessibilityValue", "accessibilityIdentifier"]
        var allowed = Set(strings + ["disabled"])
        for (key, value) in node.properties {
            if strings.contains(key), value.string == nil { throw UIValidationError.invalidProperty(node: node.id, key: key) }
            if key == "disabled", value.bool == nil { throw UIValidationError.invalidProperty(node: node.id, key: key) }
        }
        func requireString(_ key: String) throws {
            guard node.properties[key]?.string != nil else { throw UIValidationError.invalidProperty(node: node.id, key: key) }
        }
        func optionalString(_ key: String, values: Set<String>? = nil) throws {
            if let value = node.properties[key] {
                guard let string = value.string, values == nil || values!.contains(string) else {
                    throw UIValidationError.invalidProperty(node: node.id, key: key)
                }
            }
        }
        switch node.kind {
        case .text:
            allowed.formUnion(["text", "style", "selectable", "maxLines"])
            try requireString("text")
            try optionalString("style", values: ["body", "headline", "title", "caption"])
            if let value = node.properties["selectable"], value.bool == nil {
                throw UIValidationError.invalidProperty(node: node.id, key: "selectable")
            }
            if let value = node.properties["maxLines"] {
                guard let number = value.number, number.rounded() == number, (1...100).contains(number) else {
                    throw UIValidationError.invalidProperty(node: node.id, key: "maxLines")
                }
            }
        case .button:
            allowed.formUnion(["label", "role"])
            try requireString("label")
            try optionalString("role", values: ["normal", "destructive", "cancel"])
        case .textField:
            allowed.formUnion(["label", "value"])
            try requireString("label"); try requireString("value")
        case .toggle:
            allowed.formUnion(["label", "value"])
            try requireString("label")
            guard node.properties["value"]?.bool != nil else { throw UIValidationError.invalidProperty(node: node.id, key: "value") }
        case .vStack, .hStack, .zStack:
            allowed.formUnion(["spacing", "alignment"])
            if let value = node.properties["spacing"] {
                guard node.kind != .zStack, let number = value.number, (0...256).contains(number) else {
                    throw UIValidationError.invalidProperty(node: node.id, key: "spacing")
                }
            }
            let alignments: Set<String> = switch node.kind {
            case .vStack: ["leading", "center", "trailing"]
            case .hStack: ["top", "center", "bottom", "firstTextBaseline", "lastTextBaseline"]
            default: ["center", "leading", "trailing", "top", "bottom", "topLeading", "topTrailing", "bottomLeading", "bottomTrailing"]
            }
            try optionalString("alignment", values: alignments)
        case .section, .navigation:
            allowed.insert("title"); try optionalString("title")
        case .list: break
        }
        if let key = node.properties.keys.first(where: { !allowed.contains($0) }) {
            throw UIValidationError.invalidProperty(node: node.id, key: key)
        }
    }

    private func validateStructure(of node: UINode) throws {
        switch node.kind {
        case .text, .button, .textField, .toggle:
            guard node.children.isEmpty else { throw UIValidationError.invalidChildren(node.id) }
        case .navigation:
            guard node.children.count == 1 else { throw UIValidationError.invalidChildren(node.id) }
        default: break
        }
    }

    private func permittedEvents(for kind: NodeKind) -> Set<UIEventKind> {
        switch kind {
        case .button: [.activate]
        case .textField: [.textChange, .submit]
        case .toggle: [.valueChange]
        default: []
        }
    }

    private func requiredEvents(for kind: NodeKind) -> Set<UIEventKind> {
        switch kind {
        case .button: [.activate]
        case .textField: [.textChange]
        case .toggle: [.valueChange]
        default: []
        }
    }
}

func validIdentifier(_ value: String) -> Bool {
    !value.isEmpty && value.utf8.count <= 128
        && !value.unicodeScalars.contains { $0.value < 0x20 || $0.value == 0x7f }
}

2e3652c8d58d6adbe4bc71a65abe95c166f9b1ea blob 12248
# MixerUpdates native verification and cold-start recovery

This independent Swift module consumes the same release-v1 canonical CBOR contract
as `services/protocol`. It verifies Ed25519 signatures through Apple Swift Crypto
5.0.3 (CryptoKit on Apple; vetted BoringSSL implementation on supported other hosts).
It does not implement cryptographic primitives.

`ReleaseVerifier` is initialized from the **installed** runtime contract and pinned
public roots. These must never be taken from an untrusted update. It checks signed
app/environment/platform/runtime identity, schema versions, exact capability hashes,
state compatibility, resource limits, payload size/hash, signing-key scope/role/
revocation/validity, and distinct artifact/assignment domains. Assignment verification
checks channel, deterministic cohort, and a strictly increasing durable sequence.
`VerifiedArtifact` retains private signing evidence. A new assignment reauthorizes
that artifact signature under the receiving verifier's current roots, roles, scope,
revocation state and verification time. Tokens from an earlier or different verifier
cannot bypass a removed, replaced, expired or revoked artifact key. This check applies
to new assignment acceptance. The cold-start store below separately defines retained
healthy offline authority.

JSON is an inspection/transport form. Duplicate/unknown fields, excessive nesting,
invalid types and unsupported profile fields fail closed. Canonical CBOR bytes are
reconstructed exactly for signing; the shared static Go vector verifies both canonical
byte strings, signatures, artifact identity and cohort bucket independently in Swift.
Installed runtime, scope, resource-limit and trust-root objects also reject unknown
or missing fields. CLI inputs use bounded reads of regular files; size metadata is
only an early rejection and cannot authorize an unbounded allocation if a file grows.

```sh
swift test --package-path updates
swift run --package-path updates mixer-update verify \
  --manifest manifest.json --payload module.wasm --host installed-host.json \
  --roots pinned-roots.json --assignment assignment.json --channel beta \
  --installation APP_PRIVATE_RANDOM_ID --last-sequence 6 --now 1792627300
```

A successful verifier result is **protocol verification only**. It does not validate
the VM executable profile, approve product/store policy, stage/activate a candidate,
or persist the assignment sequence. `ColdStartUpdater` provides the optional durable
store. Its executable validator must be installed host policy and must actually
validate the owned VM profile; there is no accepting default. Selection is not execution.

V1 accepts an uncompressed single payload, at most16MiB, with no separate assets.
Direct pinned roots only: delegation/revocation distribution and key-rotation device
qualification are pending. No physical-device OTA or GA acceptance is claimed.

`ColdStartUpdater.open(configuration:verifier:executableValidator:)` opens an actor
owning one private recovery directory. Supply a stable installed channel and an
app-private random installation identity. Its parent directory must already exist;
the store creates the last component with mode0700, locks it exclusively across
processes, and uses descriptor-relative regular files with no symlink/hard-link
following. Close the old actor before reopening. Extensions must coordinate ownership.

The host-facing lifecycle is:

1. `beginDownload(signedManifest:signedAssignment:now:)` validates signed headers and
   rollout, reserves disk, and atomically records the higher sequence **before** bytes
   are accepted. A cancellation, interruption or failed payload never lowers it.
2. `downloadOffset()` and `appendDownload(_:atOffset:now:)` support exact-offset resume
   with chunks at most1MiB. File contents and directory entries are synced. `finishDownload`
   verifies the complete hash, signatures, compatibility and installed executable policy,
   then renames and stages it. A rename completed before a journal interruption can be
   finished after reopening. `cancelDownload()` preserves the sequence high-water.
3. `selectAtColdStart(now:)` is called once per opened process session. It persists the
   attempt before returning `.provisional`. `.healthy` returns an earned retained
   candidate; `.nativeFallback` carries no bytes. Selection contains immutable `Data`,
   SHA-256 identities and a provisional launch ID, never an external mutable path.
   The host executes only that exact snapshot through its installed engine.
4. `markHealthy(launchID:now:completedMilestones:)` requires the matching process attempt,
   all configured milestones, and an elapsed process-local monotonic observation
   (default10seconds). Wall time changes cannot earn observation. A restart cannot
   resume observation. Current signatures, cache bytes and executable policy are checked
   again before the healthy pointer is written.
5. `reportFailure(launchID:reason:)` accepts a trusted host classification. Only
   `.deterministicTrap` counts toward quarantine (default2). Native crashes, user quit
   and unknown interruption do not count. An unclassified attempt on reopening is
   cleared as unknown and falls back for that session; the next session may retry.

Wall `now` is used for signing authority and stored audit time only. Durable replay
authority is the signed assignment sequence for this installed runtime/channel, not
wall time. A rollback requires a fresh greater signed sequence even for older content.
An already healthy offline candidate deliberately ignores later key expiry/revocation
flags, matching the Go reference's availability policy. Every launch still verifies
its retained artifact **and assignment signatures** using the current installed key
bytes, scopes and roles, plus runtime/capability/state compatibility and executable
policy. Removing/replacing a key or its role invalidates that cache; this is distinct
from merely marking the same key expired/revoked. Staged candidates and new downloads
always need current signing authority. This policy is explicit, not revocation bypass
for a new assignment.

Metadata writes use a private temporary file, file `fsync`, atomic `renameat`, and
directory `fsync`. An uncertain journal/rename/cleanup failure poisons the actor;
operations fail until close/reopen. `snapshot().requiresReopen` identifies diagnostics
that may reflect newer in-memory state than durable state. Injected faults cover
write/file-sync/rename/directory-sync boundaries. These tests are process-interruption
models, not proof of physical power-loss behavior on every device/filesystem.

Two healthy generations plus a staged candidate and pending download are retained.
Unknown private files are preserved; recognized orphan payload/transaction files are
pruned. Missing/corrupt candidates fall back; invalid staged bytes are quarantined.
History is bounded to256 quarantine/failure entries and fails closed at capacity
until native maintenance. Metadata is bounded to1MiB and exact fields, duplicate-key,
UTF-8, nesting and type checks apply when reopening. Missing replay metadata in an
existing directory fails closed. An incompatible installed host contract also needs
explicit native maintenance; automatic journal migration is not implemented.

The app-private metadata and all configuration, monotonic clock, fault hooks,
milestone reports, trap classifications and validator callbacks are trusted host
inputs. The guest must have no write access to the directory or these APIs. The
store resists untrusted signed/unsigned update bytes and process interruption; it
does not authenticate local metadata against a compromised host, malicious backup
rollback or deletion of the entire directory. Native install/backup/migration policy
must preserve the sequence/installation relationship. It does not implement network
downloads, secure hardware counters, background transfer, app-data migrations,
live replacement, actual owned Swift/Wasm activation, or product/store approval.

`Tests/.../Fixtures/signed-release-v1.json` is an independently authored public test
vector from the owned Go service. Its ephemeral private keys were discarded. Its
payload is a test string, not executable code. Never pin fixture keys in an app.

`verification/independent-review.json` records a separate agent review of the original
verifier, reproductions, exact source digest and post-fix host/cross-build receipts.
The review covers token authority, pinned configuration, signature domains, transport
ambiguity, canonical limits and file-read bounds. It is not an external cryptographic
audit, a formal proof, continuous fuzzing, or mobile durable activation qualification.

`verification/cold-start-store.json` records the implementer's host fault/integrity
tests and iOS/Android compilation evidence for the store. These fixture-policy tests
do not substitute for actual engine validation, independent review, physical cold
starts/power-loss recovery, published packages, or FieldLog release qualification.

For a separate Android test runner, the installed SDK supplies dynamic `Testing`.
Build with dynamic Swift libraries and enable testability explicitly for release:

```sh
DEVELOPER_DIR=/Applications/Xcode_26.6.app/Contents/Developer \
  /Users/andreyyurlov/Library/Developer/Toolchains/swift-6.3.3-RELEASE.xctoolchain/usr/bin/swift \
  build --package-path updates --swift-sdks-path /Users/andreyyurlov/.swiftpm/swift-sdks \
  --swift-sdk aarch64-unknown-linux-android28 -c release --build-tests \
  -Xswiftc -enable-testing --scratch-path updates/.build/android-tests
```

This produces `updates/.build/android-tests/aarch64-unknown-linux-android28/release/`
`MixerUpdatesPackageTests.xctest`. Copy that executable and its sibling
`MixerUpdates_MixerUpdatesTests.resources` directory together to a disposable test
directory. Supply the matching official SDK's `swift-aarch64/android` dynamic
libraries and their platform dependencies through `LD_LIBRARY_PATH`, and point
`TMPDIR` at an existing writable test directory. Invoke the runner with
`--testing-library swift-testing`; the default XCTest route has zero of these tests.
The production `mixer-update` CLI has no new self-test command or activation behavior.
The receipt proves runner compilation only; a device run needs its own exit/output,
executable/library/resource hashes and device identity evidence.

## Explicit release-v3 verification

`ReleaseVerifierV3(host:roots:)` is a separate synchronous verifier for the frozen
protocol3/guestABI2/UI1 contract. It requires known exact capability schema maps
with zero to two entries, signed documents at most64KiB, payload and linear-memory
ceilings at most4MiB, fuel at most1M and startup at most60000ms, all narrowed by the
installed host. The original `ReleaseVerifier` remains strict protocol1/2 + ABI1.
No existing updater, activation, CLI, service or recovery route selects v3.

Successful verification returns distinct `VerifiedArtifactV3`,
`VerifiedAssignmentV3` and readable v3 grant values. They have no public constructor
or decoder. Verifier value copies share one immutable private context; an
independently initialized verifier must verify signed bytes again. Assignment
verification rechecks artifact signing authority at the supplied current time.
`revalidateArtifact(_:payload:now:)` also checks the exact supplied payload and
current authority. Root key bytes are privately captured. A proof is not serialized
replay state, executable validation, installed adapter authority, durable selection,
effects enablement or health. A later factory must consume a private verified
selection, rebind the whole artifact/payload and intersect installed/signed grants;
a standalone grant array or caller-created host/policy object is insufficient.

The initial v3 slice has no retained-health authority exception, asynchronous
updater validator, v3 durable store/coordinator, hosted delivery or device proof.
Those remain separate reviewed work. The API design is
`docs/release-v3-swift-api-design.md`; source-bound host tests, shared Go/Swift
vectors and public-client opacity checks are recorded under
`verification/release-v3-swift/`. Fixture keys and payloads are test-only.

312b3c3b277eb44b1b8a1508d2c9b33b336d60c9 blob 33140
#if canImport(UIKit)
import UIKit
import MixerUI

/// Bounded concrete UIKit layout for the closed V2 recipes. This is not an app
/// extensible layout language. Every measurement happens on detached controls.
@MainActor final class AppearanceNativeLayoutV2 {
    typealias Placement = AppearanceNativeGeometryV2.Placement
    let plan: UIResolvedAppearancePlanV2
    var records: [String: AppearanceNodeViewV2] = [:]
    var decorations: [String: UIView] = [:]
    var placements: [Placement] = []
    private(set) var attachmentPlacements: [Placement] = []
    private struct CoverGroup { let key: String; let path: CGPath; let rowIDs: [String] }
    private var coverGroups: [CoverGroup] = []
    var navigation: (key: String, expanded: CGFloat, compact: CGFloat, expandedLabel: CGRect, compactLabel: CGRect)?
    private let rtl: Bool
    init(plan: UIResolvedAppearancePlanV2) {
        self.plan = plan; rtl = plan.environment.direction == .rightToLeft
        for node in plan.nodes {
            let view = AppearanceNodeViewV2(node: node, plan: plan)
            view.density = plan.environment.density1024
            view.semanticContentAttribute = rtl ? .forceRightToLeft : .forceLeftToRight
            records[node.identity.id] = view
        }
    }
    private func p(_ x: UInt32) -> CGFloat { AppearanceNativeMathV2.points(x) }
    private func q(_ x: CGFloat) throws -> CGFloat { try AppearanceNativeMathV2.extent(x) }
    private func checked(_ value: CGFloat) throws -> CGFloat {
        guard value.isFinite, value >= 0, value <= CGFloat(UIAppearanceGeometryV2.maximumExtent64)/64 else { throw UIAppearanceErrorV2.layout }
        return try q(value)
    }
    private func horizontal(_ align: UIHorizontalAlignmentV1, _ width: CGFloat, _ child: CGFloat) -> CGFloat {
        switch align { case .center: return (width-child)/2; case .leading: return rtl ? width-child : 0; case .trailing: return rtl ? 0 : width-child }
    }
    private func add(_ key: String, parent: String, frame: CGRect) {
        let index = placements.filter { $0.parent == parent }.count
        placements.append(Placement(key: key, parent: parent, frame: frame, index: index))
    }
    private func configureLabel(_ label: UILabel, _ text: UIResolvedTextV2, width: CGFloat) throws -> (CGSize, CGFloat?, CGFloat?) {
        label.font = AppearanceNativeMathV2.font(text); label.text = text.value
        label.numberOfLines = text.maximumLines ?? 0
        label.textAlignment = rtl ? .right : .left
        return try measure(text, width: width)
    }
    private func measure(_ text: UIResolvedTextV2, width: CGFloat) throws -> (CGSize, CGFloat?, CGFloat?) {
        guard width.isFinite, width >= 0 else { throw UIAppearanceErrorV2.layout }
        guard !text.value.isEmpty else { return (.zero, nil, nil) }
        guard width > 0 else { throw UIAppearanceErrorV2.layout }
        let style = NSMutableParagraphStyle(); style.lineBreakMode = .byWordWrapping
        style.baseWritingDirection = rtl ? .rightToLeft : .leftToRight
        let storage = NSTextStorage(string: text.value, attributes: [.font: AppearanceNativeMathV2.font(text), .paragraphStyle: style])
        let manager = NSLayoutManager(); let container = NSTextContainer(size: CGSize(width: width, height: CGFloat.greatestFiniteMagnitude))
        container.lineFragmentPadding = 0; container.maximumNumberOfLines = text.maximumLines ?? 0
        container.lineBreakMode = .byTruncatingTail
        manager.addTextContainer(container); storage.addLayoutManager(manager)
        let glyphs = manager.glyphRange(for: container)
        let used = manager.usedRect(for: container)
        var first: CGFloat?, last: CGFloat?
        manager.enumerateLineFragments(forGlyphRange: glyphs) { line, _, _, range, _ in
            guard range.length > 0 else { return }
            let baseline = line.minY + manager.location(forGlyphAt: range.location).y
            if first == nil { first = baseline }; last = baseline
        }
        let size = CGSize(width: try checked(min(width, max(used.width, 0))), height: try checked(max(used.maxY, 0)))
        guard size.height > 0, first != nil else { throw UIAppearanceErrorV2.layout }
        return (size, first, last)
    }
    private func text(_ record: AppearanceNodeViewV2, _ value: UIResolvedTextV2, width: CGFloat) throws -> CGSize {
        let (size, first, last) = try configureLabel(record.label, value, width: width)
        record.label.frame = CGRect(origin: .zero, size: size)
        if let view = record.selectable {
            view.text = value.value; view.font = AppearanceNativeMathV2.font(value)
            view.textAlignment = rtl ? .right : .left
            view.textContainer.maximumNumberOfLines = value.maximumLines ?? 0
            view.textContainer.lineBreakMode = .byTruncatingTail; view.frame = CGRect(origin: .zero, size: size)
        }
        record.firstBaseline = first; record.lastBaseline = last
        return size
    }

    func prepare(rootID: String, editing: [String: String], scrollOffsets: [String:CGPoint]) throws {
        let env = plan.environment
        let inset = AppearanceNativeMathV2.insets(env.safeArea64, rtl: rtl)
        let width = p(env.viewport.width64)-inset.left-inset.right
        let height = p(env.viewport.height64)-inset.top-inset.bottom
        guard width > 0, height > 0 else { throw UIAppearanceErrorV2.layout }
        _ = try layout(rootID, width: width, height: height, editing: editing)
        guard let root = records[rootID] else { throw UIAppearanceErrorV2.shape }
        let rootHeight = root.kind == .list || root.kind == .navigation ? height : root.frame.height
        guard rootHeight <= height else { throw UIAppearanceErrorV2.layout }
        add(rootID, parent: "$root", frame: CGRect(x: inset.left, y: inset.top, width: root.frame.width, height: rootHeight))
        if let navigation, let offset = scrollOffsets.values.first {
            let overflow = navigation.expanded-navigation.compact
            if overflow <= 0 || offset.y >= overflow, let record = records[navigation.key],
               case let .navigation(recipe) = record.node.recipe, let child = record.node.childIDs.first {
                record.label.font = recipe.compactTitle.map(AppearanceNativeMathV2.font)
                record.label.text = recipe.compactTitle?.value; record.label.numberOfLines = 1
                record.label.frame = navigation.compactLabel
                for index in placements.indices where placements[index].key == child && placements[index].parent == navigation.key {
                    placements[index].frame.origin.y = navigation.compact
                    placements[index].frame.size.height = record.frame.height-navigation.compact
                }
                records[child]?.scroll?.frame.size.height = record.frame.height-navigation.compact
            }
        }
        // Snap once. The detached proof and commit consume these same local
        // frames, including every row/group/nested-child rounding phase.
        attachmentPlacements = try AppearanceNativeGeometryV2.prepare(placements,density1024:env.density1024)
        for placement in attachmentPlacements {
            let child = view(placement.key), parent = view(placement.parent)
            child.frame = placement.frame; parent.addSubview(child)
        }
        try validateFinalCoverGeometry()
        for view in records.values { try view.repaint() }
    }
    static func supportsPreparedGeometry(records: [String:AppearanceNodeViewV2], decorations: [String:UIView]) -> Bool {
        for record in records.values {
            guard record.bounds.origin == .zero, CATransform3DIsIdentity(record.layer.sublayerTransform) else { return false }
            for view in [record as UIView?,record.label,record.button,record.field,record.toggle,record.selectable,record.scroll,record.toggleCover].compactMap({ $0 }) {
                guard view.transform.isIdentity, CATransform3DIsIdentity(view.layer.transform) else { return false }
            }
            if let scroll = record.scroll, scroll.zoomScale != 1 || scroll.bounds.origin != scroll.contentOffset { return false }
        }
        return decorations.values.allSatisfy { $0.transform.isIdentity && CATransform3DIsIdentity($0.layer.transform) && CATransform3DIsIdentity($0.layer.sublayerTransform) && $0.bounds.origin == .zero }
    }
    private func validateFinalCoverGeometry() throws {
        guard Self.supportsPreparedGeometry(records:records,decorations:decorations) else { throw UIAppearanceErrorV2.unsupportedNativeOperation }
        for group in coverGroups {
            let plane = view(group.key)
            for id in group.rowIDs {
                guard let row = records[id] else { throw UIAppearanceErrorV2.shape }
                for input in [row.button as UIView?,row.field as UIView?,row.toggle as UIView?].compactMap({ $0 }) {
                    try AppearanceNativeGeometryV2.validateCarrier(input.convert(input.bounds,to:row),rowBounds:row.bounds)
                }
            }
            for id in group.rowIDs {
                guard let owner = records[id], owner.toggle != nil else { continue }
                var foreground: [CGRect] = []
                if !owner.label.isHidden, owner.label.text?.isEmpty == false { foreground.append(owner.label.convert(owner.label.bounds,to:plane)) }
                for otherID in group.rowIDs where otherID != id {
                    var pending = [otherID]
                    while let next = pending.popLast() {
                        guard let record = records[next] else { throw UIAppearanceErrorV2.shape }
                        pending.append(contentsOf:record.node.childIDs)
                        if !record.label.isHidden, record.label.text?.isEmpty == false { foreground.append(record.label.convert(record.label.bounds,to:plane)) }
                        for input in [record.button as UIView?,record.field as UIView?,record.toggle as UIView?,record.selectable as UIView?].compactMap({ $0 }) { foreground.append(input.convert(input.bounds,to:plane)) }
                        guard let paints = plan.style(nodeID:record.identity.id)?.paints else { throw UIAppearanceErrorV2.shape }
                        switch paints {
                        case let .text(_,background),let .container(background),let .section(_,background),let .navigation(_,_,background):
                            if background.alpha > 0 { foreground.append(record.convert(record.bounds,to:plane)) }
                        case .button,.field,.toggle:
                            foreground.append(record.convert(record.visualRect,to:plane))
                        case .list: throw UIAppearanceErrorV2.unsupportedNativeOperation
                        }
                    }
                }
                try AppearanceNativeGeometryV2.validateCover(owner.convert(owner.toggleCoverRect,to:plane),foreground:foreground,groupBounds:plane.bounds,groupPath:group.path,density1024:plan.environment.density1024)
            }
        }
    }
    let detachedRoot = UIView()
    func view(_ key: String) -> UIView {
        if key == "$root" { return detachedRoot }
        if key.hasPrefix("$scroll:") { return records[String(key.dropFirst(8))]!.scroll! }
        return records[key] ?? decorations[key]!
    }

    private func layout(_ id: String, width: CGFloat, height: CGFloat, editing: [String: String], row: Bool = false) throws -> CGSize {
        guard let record = records[id], width >= 0 else { throw UIAppearanceErrorV2.shape }
        let node = record.node
        record.semanticSize = .zero; record.contentRect = .zero; record.firstBaseline = nil; record.lastBaseline = nil
        var size = CGSize.zero
        switch node.recipe {
        case let .text(value): size = try text(record, value, width: width)
        case let .button(_, value, metrics):
            let inset = AppearanceNativeMathV2.insets(metrics.labelInsets64, rtl: rtl)
            let measured = try measure(value, width: width-inset.left-inset.right)
            let semantic = CGSize(width: measured.0.width+inset.left+inset.right, height: measured.0.height+inset.top+inset.bottom)
            guard width >= p(metrics.minimumHitWidth64) else { throw UIAppearanceErrorV2.layout }
            size = CGSize(width: min(width, max(semantic.width, p(metrics.minimumHitWidth64))), height: row ? semantic.height : max(semantic.height, p(metrics.minimumHitHeight64)))
            record.semanticSize = semantic
            let button = record.button!; button.titleLabel?.font = AppearanceNativeMathV2.font(value); button.setTitle(value.value, for: .normal)
            button.contentEdgeInsets = inset; button.frame = CGRect(origin: .zero, size: CGSize(width: size.width, height: max(size.height, p(metrics.minimumHitHeight64))))
            button.frame.origin.y = (size.height-button.frame.height)/2
            record.visualRect = CGRect(x: 0, y: (size.height-semantic.height)/2, width: size.width, height: semantic.height)
            // Native interactive baseline offsets are not qualified. A required
            // baseline rejects; ordinary center/top/bottom layout remains valid.
            record.firstBaseline = nil; record.lastBaseline = nil
        case let .textField(label, value, valueText, metrics):
            let inset = AppearanceNativeMathV2.insets(metrics.insets64, rtl: rtl)
            guard width > inset.left+inset.right else { throw UIAppearanceErrorV2.layout }
            let font = AppearanceNativeMathV2.font(valueText)
            let display = editing[id] ?? value
            // UITextField is natively single line; measure native script fallback
            // using the exact font instead of a fixed Latin line box.
            let storage = NSAttributedString(string: display.isEmpty ? label : display, attributes: [.font: font])
            let bounds = storage.boundingRect(with: CGSize(width: CGFloat.greatestFiniteMagnitude, height: CGFloat.greatestFiniteMagnitude), options: [.usesLineFragmentOrigin, .usesFontLeading], context: nil)
            let contentHeight = max(try checked(bounds.height), p(metrics.minimumContentHeight64))
            let semantic = CGSize(width: width, height: contentHeight+inset.top+inset.bottom)
            size = CGSize(width: width, height: row ? semantic.height : max(semantic.height, p(metrics.minimumHitHeight64)))
            record.semanticSize = semantic; record.visualRect = CGRect(x: 0, y: (size.height-semantic.height)/2, width: width, height: semantic.height)
