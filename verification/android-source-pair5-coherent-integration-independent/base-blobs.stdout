            .cubic(control1: p(b, h), control2: p(c, h), end: p(d, h - e)),
            .cubic(control1: p(g, h - f), control2: p(f, h - g), end: p(e, h - d)),
            .cubic(control1: p(0, h - c), control2: p(0, h - b), end: p(0, h - a)),
            .line(p(0, a)),
            .cubic(control1: p(0, b), control2: p(0, c), end: p(e, d)),
