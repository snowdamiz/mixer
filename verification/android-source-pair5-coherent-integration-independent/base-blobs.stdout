package android.app;import java.util.ArrayList;import java.util.List;import java.util.concurrent.Executor;import dev.mixer.android.ConcreteHostProbe;public class UiModeManager {public interface ContrastChangeListener {void onContrastChanged(float contrast);}public float contrast;public final List<ContrastChangeListener> listeners=new ArrayList<>();public int addCalls,removeCalls;public void addContrastChangeListener(Executor executor,ContrastChangeListener listener){ConcreteHostProbe.hit("UiModeManager.addContrastChangeListener","entry",this);addCalls++;listeners.add(listener);ConcreteHostProbe.hit("UiModeManager.addContrastChangeListener","beforeReturn",this);}public void removeContrastChangeListener(ContrastChangeListener listener){ConcreteHostProbe.hit("UiModeManager.removeContrastChangeListener","entry",this);removeCalls++;listeners.removeIf(item->item==listener);ConcreteHostProbe.hit("UiModeManager.removeContrastChangeListener","beforeReturn",this);}public float getContrast(){ConcreteHostProbe.hit("UiModeManager.getContrast","entry",this);float value=contrast;ConcreteHostProbe.hit("UiModeManager.getContrast","beforeReturn",this);return value;}public void hostContrast(float value){contrast=value;for(ContrastChangeListener listener:List.copyOf(listeners))listener.onContrastChanged(value);}}

