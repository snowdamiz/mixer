bb9082eafb84de174ca6cf3982fc706981906f53 blob 3644
/// The measured iOS size hierarchy used by the next shared appearance recipe.
/// These values are data only: they do not select a font, change a renderer,
/// install resources, or modify the existing appearance-v1 wire/default recipe.
public enum UISharedTextProfileV1: String, CaseIterable, Sendable {
    case xs, s, m, l, xl, xxl, xxxl, a1, a2, a3, a4, a5

    public func metrics(for role: UISharedTextRoleV1) -> UISharedTextMetricsV1 {
        let row: (body: UInt32, title: UInt32, caption: UInt32, expanded: UInt32)
        switch self {
        case .xs: row = (14, 25, 11, 31)
        case .s: row = (15, 26, 11, 32)
        case .m: row = (16, 27, 11, 33)
        case .l: row = (17, 28, 12, 34)
        case .xl: row = (19, 30, 14, 36)
        case .xxl: row = (21, 32, 16, 38)
        case .xxxl: row = (23, 34, 18, 40)
        case .a1: row = (28, 38, 22, 44)
        case .a2: row = (33, 43, 26, 48)
        case .a3: row = (40, 48, 32, 52)
        case .a4: row = (47, 53, 37, 56)
        case .a5: row = (53, 58, 43, 60)
        }
        switch role {
        case .body: return UISharedTextMetricsV1(size64: row.body * 64, weight: .w400)
        case .headline, .sectionHeader:
            return UISharedTextMetricsV1(size64: row.body * 64, weight: .w600)
        case .title: return UISharedTextMetricsV1(size64: row.title * 64, weight: .w400)
        case .caption: return UISharedTextMetricsV1(size64: row.caption * 64, weight: .w400)
        case .navigationExpanded:
            return UISharedTextMetricsV1(size64: row.expanded * 64, weight: .w700)
        }
    }
}

public enum UISharedTextRoleV1: String, CaseIterable, Sendable {
    case body, headline, title, caption, sectionHeader, navigationExpanded
}

public struct UISharedTextMetricsV1: Sendable, Equatable {
    /// Logical 1/64 point/dp size, already selected for the requested profile.
    /// Native consumers must not apply a second semantic/sp scale multiplier.
    public let size64: UInt32
    public let weight: UIFontWeightV1
    // Deliberately no fixed text height or clipping box. Native shaping, script
    // fallback, wrapping and accessibility may need a larger layout rectangle.
}

public enum UISharedTextProfileErrorV1: Error, Sendable, Equatable {
    case unsupportedBodySize
}

public enum UISharedTextProfileSelectionV1 {
    /// App policy for a previously converted native body-size preference, in
    /// logical 64ths. Select the nearest measured body anchor; ties select the
    /// larger profile. Outside the supported range is an explicit error, never
    /// a silent accessibility cap or extrapolation. Conversion from a native
    /// preference remains the adapter's responsibility and needs native evidence.
    public static func nearest(preferredBodySize64: UInt32) throws -> UISharedTextProfileV1 {
        let profiles = UISharedTextProfileV1.allCases
        guard preferredBodySize64 >= profiles[0].metrics(for: .body).size64,
              preferredBodySize64 <= profiles[profiles.count - 1].metrics(for: .body).size64 else {
            throw UISharedTextProfileErrorV1.unsupportedBodySize
        }
        for index in 1..<profiles.count {
            let lower = profiles[index - 1].metrics(for: .body).size64
            let upper = profiles[index].metrics(for: .body).size64
            // The checked domain is 896...3392. UInt64 makes the comparison
            // exact without division, floating point or midpoint truncation.
            if UInt64(preferredBodySize64) * 2 < UInt64(lower) + UInt64(upper) {
                return profiles[index - 1]
            }
        }
        return .a5
    }
}

bbbbb4a9b7570864fa8d41abbfb8f344f5cfedc3 blob 5171
import CoreGraphics
import Testing
import MixerUI
@testable import MixerApple

private struct NativeElement: Equatable {
    let type: CGPathElementType
    let points: [CGPoint]
}

private func elements(_ path: CGPath) -> [NativeElement] {
    var result: [NativeElement] = []
    path.applyWithBlock { pointer in
        let element = pointer.pointee
        let count: Int
        switch element.type {
        case .moveToPoint, .addLineToPoint: count = 1
        case .addQuadCurveToPoint: count = 2
        case .addCurveToPoint: count = 3
        case .closeSubpath: count = 0
        @unknown default: count = 0
        }
        result.append(NativeElement(type: element.type,
            points: Array(UnsafeBufferPointer(start: element.points, count: count))))
    }
    return result
}

@Test func nativeSharedPathsPreserveClosedCommandsAndFractionalCoordinates() throws {
    let densities: [UInt16] = [128, 1024, 1537, 3072, 16384]
    let paths = [UIAppearanceGeometryV2.track(), UIAppearanceGeometryV2.thumb(),
        try UIAppearanceGeometryV2.group(width64: 1, height64: 1, radius64: 1664),
        try UIAppearanceGeometryV2.group(width64: 24749, height64: 3329, radius64: 1664),
        try UIAppearanceGeometryV2.group(width64: 2147483647, height64: 2147483647, radius64: 65536)]
    for density in densities {
        for path in paths {
            let native = try AppearanceNativePathsV2.make(path, density1024: density)
            let actual = elements(native)
            #expect(actual.count == path.commands.count)
            func point(_ p: UIAppearanceGeometryV2.Point) -> CGPoint {
                CGPoint(x: Double(UInt64(p.x64) * UInt64(density)) / 65536,
                        y: Double(UInt64(p.y64) * UInt64(density)) / 65536)
            }
            let expected = path.commands.map { command -> NativeElement in
                switch command {
                case let .move(p): NativeElement(type: .moveToPoint, points: [point(p)])
                case let .line(p): NativeElement(type: .addLineToPoint, points: [point(p)])
                case let .cubic(a, b, c): NativeElement(type: .addCurveToPoint, points: [point(a), point(b), point(c)])
                case .close: NativeElement(type: .closeSubpath, points: [])
                }
            }
            #expect(actual == expected)
            #expect(actual.last?.type == .closeSubpath)
        }
    }
}

@Test func nativeSharedPathsEmptyGeometryStillValidatesDensity() throws {
    for extent: (UInt32, UInt32) in [(0, 0), (0, 100), (100, 0)] {
        let empty = try UIAppearanceGeometryV2.group(width64: extent.0, height64: extent.1, radius64: 1664)
        #expect(try AppearanceNativePathsV2.make(empty, density1024: 1024).isEmpty)
        for density: UInt16 in [0, 127, 16385, 65535] {
            #expect(throws: UIAppearanceGeometryErrorV2.density) {
                try AppearanceNativePathsV2.make(empty, density1024: density)
            }
        }
    }
}

@Test func nativeSharedPathsOwnIndependentImmutableCopies() throws {
    let geometry = UIAppearanceGeometryV2.track()
    let first = try AppearanceNativePathsV2.make(geometry, density1024: 1024)
    let second = try AppearanceNativePathsV2.make(geometry, density1024: 1024)
    let before = elements(first)
    let mutable = try #require(first.mutableCopy())
    mutable.addRect(CGRect(x: 200, y: 200, width: 10, height: 10))
    #expect(elements(first) == before)
    #expect(elements(second) == before)
    #expect(elements(mutable) != before)
}

@Test func nativeSharedPathsFillAndClipInPixelCoordinates() throws {
    let path = try AppearanceNativePathsV2.make(UIAppearanceGeometryV2.track(), density1024: 2048)
    #expect(path.boundingBoxOfPath == CGRect(x: 0, y: 0, width: 126, height: 56))
    #expect(path.contains(CGPoint(x: 63, y: 28), using: .winding))
    #expect(!path.contains(CGPoint(x: 1, y: 1), using: .winding))
    let width = 140, height = 70
    var pixels = [UInt8](repeating: 0, count: width * height * 4)
    try pixels.withUnsafeMutableBytes { bytes in
        let context = try #require(CGContext(data: bytes.baseAddress, width: width, height: height,
            bitsPerComponent: 8, bytesPerRow: width * 4, space: CGColorSpaceCreateDeviceRGB(),
            bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue | CGBitmapInfo.byteOrder32Big.rawValue))
        context.setShouldAntialias(false)
        // Bitmap memory rows run top-to-bottom; establish that same top-left
        // coordinate convention without applying another density transform.
        context.translateBy(x: 0, y: CGFloat(height))
        context.scaleBy(x: 1, y: -1)
        context.addPath(path)
        context.clip(using: .winding)
        context.setFillColor(red: 1, green: 0, blue: 0, alpha: 1)
        context.fill(CGRect(x: 0, y: 0, width: width, height: height))
    }
    func pixel(_ x: Int, _ y: Int) -> [UInt8] {
        Array(pixels[((y * width + x) * 4)..<((y * width + x) * 4 + 4)])
    }
    #expect(pixel(63, 28) == [255, 0, 0, 255])
    #expect(pixel(1, 1) == [0, 0, 0, 0])
    #expect(pixel(130, 28) == [0, 0, 0, 0])
    #expect(pixel(63, 60) == [0, 0, 0, 0])
}

