 private static void disposalPriority(){
  for(String variant:List.of("successful","ordinary-only","fatal-only","ordinary-then-fatal","earlier-primary","earlier-primary-and-fatal")){
   RuntimeException ordinary=new IllegalStateException("disposal ordinary A"),earlierPrimary=new IllegalStateException("earlier owner primary P");
   Fatal fatal=new Fatal("disposal fatal E"),earlierFatal=new Fatal("earlier owner fatal F");
   boolean rendererFails=!variant.equals("successful")&&!variant.equals("fatal-only"),engineFails=!variant.equals("successful")&&!variant.equals("ordinary-only"),earlier=variant.startsWith("earlier-"),hasEarlierFatal=variant.equals("earlier-primary-and-fatal");
   Fixture f=new Fixture(true);
   try{
    f.ready();NativeCoordinatorV2 coordinator=f.coordinator();
    if(earlier){check(caught(()->f.renderer().terminal(NativeEnvironmentV2.RendererCause.CAPTURE_FAILED,earlierPrimary,hasEarlierFatal?earlierFatal:null))==(hasEarlierFatal?earlierFatal:null),"earlier report escape identity");check(f.queue.queued()==1&&NativeBridge.destroyCalls==0,"earlier report did not defer exact disposal");}
    if(engineFails)NativeBridge.destroyFailure=fatal;
    OwnerHostProbe.hook=(method,phase)->{if(rendererFails&&method.equals("Renderer.dispose")&&phase.equals("entry"))throw ordinary;};
    Throwable escaped=caught(earlier?()->f.queue.drainAll(4):f.owner::close);OwnerHostProbe.hook=null;
    Throwable componentPrimary=rendererFails?ordinary:engineFails?fatal:null;Error expectedFatal=hasEarlierFatal?earlierFatal:engineFails?fatal:null;
    check(escaped==expectedFatal,"disposal priority escaping first fatal "+variant);
    check(coordinator.cleanupLedger().primary()==componentPrimary&&coordinator.cleanupLedger().firstFatal()==(engineFails?fatal:null),"component retained identities "+variant);
    check(f.owner.cleanupLedger().primary()==(earlier?earlierPrimary:componentPrimary)&&f.owner.cleanupLedger().firstFatal()==expectedFatal,"outer retained identities/precedence "+variant);
    check(f.owner.cleanupLedger().coordinator()==(rendererFails||engineFails?NativeOwnerV2.Outcome.FAILED_UNCERTAIN:NativeOwnerV2.Outcome.RETURNED)&&f.owner.cleanupLedger().coordinatorFailure()==(engineFails?fatal:rendererFails?ordinary:null),"disposal outcome identity "+variant);
    check(f.fence().terminal&&!f.fence().drawAllowed&&!f.fence().inputAllowed&&coordinator.isRetired()&&f.core().snapshot().phase()==OwnerLifecycleV2.Phase.RETIRED&&!f.core().snapshot().closePending(),"disposal did not retire actual core/close gates "+variant);
    check(f.renderer().disposals==1&&NativeBridge.destroyCalls==1,"disposal skipped owned release "+variant);
    for(int i=0;i<2;i++)check(caught(f.owner::close)==expectedFatal,"repeated close lost first fatal "+variant);
    check(f.renderer().disposals==1&&NativeBridge.destroyCalls==1&&f.queue.queued()==0,"repeated close repeated consumed disposition "+variant);
    check(f.owner.cleanupLedger().primary()==(earlier?earlierPrimary:componentPrimary)&&f.owner.cleanupLedger().firstFatal()==expectedFatal,"repeated close replaced diagnostics "+variant);
   }finally{OwnerHostProbe.hook=null;caught(f::close);}cases++;
  }
 }
