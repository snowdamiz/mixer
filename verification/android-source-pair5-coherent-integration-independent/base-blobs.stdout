package android.graphics;import java.util.ArrayList;import java.util.List;import dev.mixer.android.ConcreteHostProbe;public class Canvas {public record Draw(String method,Object shape,int color,float strokeWidth,Paint.Style style){}public final List<Draw> draws=new ArrayList<>();public int saves=1;public float translationX,translationY;private final List<float[]> transforms=new ArrayList<>();public int save(){ConcreteHostProbe.hit("Canvas.save");transforms.add(new float[]{translationX,translationY});int result=saves++;ConcreteHostProbe.hit("Canvas.save","beforeReturn");return result;}public void restoreToCount(int count){ConcreteHostProbe.hit("Canvas.restoreToCount");if(count<1||count>saves)throw new IllegalArgumentException("canvas save count");while(saves>count){float[] value=transforms.remove(transforms.size()-1);translationX=value[0];translationY=value[1];saves--;}ConcreteHostProbe.hit("Canvas.restoreToCount","beforeReturn");}public void translate(float x,float y){ConcreteHostProbe.hit("Canvas.translate");translationX+=x;translationY+=y;ConcreteHostProbe.hit("Canvas.translate","beforeReturn");}public boolean clipPath(Path path){ConcreteHostProbe.hit("Canvas.clipPath");draws.add(new Draw("clipPath",path,0,0,Paint.Style.FILL));ConcreteHostProbe.hit("Canvas.clipPath","beforeReturn");return true;}private void draw(String method,Object shape,Paint paint){ConcreteHostProbe.hit("Canvas."+method);draws.add(new Draw(method,shape,paint==null?0:paint.color,paint==null?0:paint.strokeWidth,paint==null?Paint.Style.FILL:paint.style));ConcreteHostProbe.hit("Canvas."+method,"beforeReturn");}public void drawPath(Path path,Paint paint){draw("drawPath",path,paint);}public void drawColor(int color){Paint paint=new Paint();paint.setColor(color);draw("drawColor",null,paint);}public void drawRect(RectF rect,Paint paint){draw("drawRect",new RectF(rect),paint);}public void drawRect(Rect rect,Paint paint){draw("drawRect",new Rect(rect),paint);}public void drawRect(float left,float top,float right,float bottom,Paint paint){drawRect(new RectF(left,top,right,bottom),paint);}public void drawRoundRect(RectF rect,float rx,float ry,Paint paint){draw("drawRoundRect",new Object[]{new RectF(rect),rx,ry},paint);}public void drawOval(RectF rect,Paint paint){draw("drawOval",new RectF(rect),paint);}public void drawLine(float x,float y,float xx,float yy,Paint paint){draw("drawLine",new float[]{x,y,xx,yy},paint);}}

