        new ImeFamily("sendKeyEvent","sendKeyEvent",c->c.sendKeyEvent(new KeyEvent(KeyEvent.ACTION_DOWN,KeyEvent.KEYCODE_SPACE))),
        new ImeFamily("setImeConsumesInput","setImeConsumesInput",c->c.setImeConsumesInput(true)),
