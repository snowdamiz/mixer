        for corner in [CGPoint(x:cover.minX,y:cover.minY),CGPoint(x:cover.maxX,y:cover.minY),CGPoint(x:cover.minX,y:cover.maxY),CGPoint(x:cover.maxX,y:cover.maxY)] {
