        namespace = try WireRules.string(wire, "namespace", rule: "identifier", maximum: 64)
        key = try WireRules.string(wire, "key", rule: "identifier", maximum: 128)
    }
    var wire: [String: WireValue] { ["namespace": .string(namespace), "key": .string(key)] }
}

public struct KVPutArguments: Equatable, Sendable {
    public let namespace: String
    public let key: String
    public let valueBase64: String
    public init(namespace: String, key: String, valueBase64: String) { self.namespace = namespace; self.key = key; self.valueBase64 = valueBase64 }
    init(wire: [String: WireValue]) throws {
        try WireRules.exact(wire, ["namespace", "key", "valueBase64"])
        namespace = try WireRules.string(wire, "namespace", rule: "identifier", maximum: 64)
        key = try WireRules.string(wire, "key", rule: "identifier", maximum: 128)
        valueBase64 = try WireRules.string(wire, "valueBase64", rule: "base64", maximum: 65536)
    }
    var wire: [String: WireValue] { ["namespace": .string(namespace), "key": .string(key), "valueBase64": .string(valueBase64)] }
}

public struct KVDeleteArguments: Equatable, Sendable {
    public let namespace: String
    public let key: String
    public init(namespace: String, key: String) { self.namespace = namespace; self.key = key }
    init(wire: [String: WireValue]) throws {
        try WireRules.exact(wire, ["namespace", "key"])
        namespace = try WireRules.string(wire, "namespace", rule: "identifier", maximum: 64)
        key = try WireRules.string(wire, "key", rule: "identifier", maximum: 128)
    }
    var wire: [String: WireValue] { ["namespace": .string(namespace), "key": .string(key)] }
}

public struct KVGetResponse: Equatable, Sendable {
    public let found: Bool
    public let valueBase64: String
    public init(found: Bool, valueBase64: String) { self.found = found; self.valueBase64 = valueBase64 }
    init(wire: [String: WireValue]) throws {
        try WireRules.exact(wire, ["found", "valueBase64"])
        found = try WireRules.bool(wire, "found")
        valueBase64 = try WireRules.string(wire, "valueBase64", rule: "base64", maximum: 65536)
    }
    var wire: [String: WireValue] { ["found": .bool(found), "valueBase64": .string(valueBase64)] }
}

public struct KVMutationResponse: Equatable, Sendable {
    public let committed: Bool
    public init(committed: Bool) { self.committed = committed }
    init(wire: [String: WireValue]) throws {
        try WireRules.exact(wire, ["committed"])
        committed = try WireRules.bool(wire, "committed")
    }
    var wire: [String: WireValue] { ["committed": .bool(committed)] }
}

public enum CapabilityOperation: Equatable, Sendable {
    case http(HTTPRequestArguments)
    case get(KVGetArguments)
    case put(KVPutArguments)
    case delete(KVDeleteArguments)
    public var capabilityID: String { switch self {
    case .http: "network.http.v1"
    case .get: "storage.keyValue.v1"
    case .put: "storage.keyValue.v1"
    case .delete: "storage.keyValue.v1"
    } }
    public var schemaSHA256: String { switch self {
    case .http: "fa1549c0a1e2e6b3bf4a83af1a6d37730bbefc8cddc3ffbe3c807d5e7af503f3"
    case .get: "4a311222c978ddd0982e8dfbcf3d4864b856a80bcc1efb3b725adede7f8e22fd"
    case .put: "4a311222c978ddd0982e8dfbcf3d4864b856a80bcc1efb3b725adede7f8e22fd"
    case .delete: "4a311222c978ddd0982e8dfbcf3d4864b856a80bcc1efb3b725adede7f8e22fd"
    } }
    public var operationID: String { switch self {
    case .http: "request"
    case .get: "get"
    case .put: "put"
    case .delete: "delete"
    } }
    var wire: [String: WireValue] { switch self {
    case .http(let value): value.wire
    case .get(let value): value.wire
    case .put(let value): value.wire
    case .delete(let value): value.wire
    } }
    static func decode(capability: String, operation: String, wire: [String: WireValue]) throws -> CapabilityOperation {
        switch (capability, operation) {
        case ("network.http.v1", "request"): return .http(try HTTPRequestArguments(wire: wire))
        case ("storage.keyValue.v1", "get"): return .get(try KVGetArguments(wire: wire))
        case ("storage.keyValue.v1", "put"): return .put(try KVPutArguments(wire: wire))
        case ("storage.keyValue.v1", "delete"): return .delete(try KVDeleteArguments(wire: wire))
        default: throw CapabilityWireError.invalid("unknown operation")
        }
    }
}

public enum CapabilityResult: Equatable, Sendable {
    case http(HTTPResponse)
    case get(KVGetResponse)
    case put(KVMutationResponse)
    case delete(KVMutationResponse)
    public var capabilityID: String { switch self {
    case .http: "network.http.v1"
    case .get: "storage.keyValue.v1"
    case .put: "storage.keyValue.v1"
    case .delete: "storage.keyValue.v1"
    } }
    public var schemaSHA256: String { switch self {
    case .http: "fa1549c0a1e2e6b3bf4a83af1a6d37730bbefc8cddc3ffbe3c807d5e7af503f3"
    case .get: "4a311222c978ddd0982e8dfbcf3d4864b856a80bcc1efb3b725adede7f8e22fd"
    case .put: "4a311222c978ddd0982e8dfbcf3d4864b856a80bcc1efb3b725adede7f8e22fd"
    case .delete: "4a311222c978ddd0982e8dfbcf3d4864b856a80bcc1efb3b725adede7f8e22fd"
    } }
    public var operationID: String { switch self {
    case .http: "request"
    case .get: "get"
    case .put: "put"
    case .delete: "delete"
    } }
    var wire: [String: WireValue] { switch self {
    case .http(let value): value.wire
    case .get(let value): value.wire
    case .put(let value): value.wire
    case .delete(let value): value.wire
    } }
    static func decode(capability: String, operation: String, wire: [String: WireValue]) throws -> CapabilityResult {
        switch (capability, operation) {
        case ("network.http.v1", "request"): return .http(try HTTPResponse(wire: wire))
        case ("storage.keyValue.v1", "get"): return .get(try KVGetResponse(wire: wire))
        case ("storage.keyValue.v1", "put"): return .put(try KVMutationResponse(wire: wire))
        case ("storage.keyValue.v1", "delete"): return .delete(try KVMutationResponse(wire: wire))
        default: throw CapabilityWireError.invalid("unknown operation")
        }
    }
}

