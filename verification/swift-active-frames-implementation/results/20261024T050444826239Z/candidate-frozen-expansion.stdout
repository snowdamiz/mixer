            type Failure = SwiftRunFailure;
            type Operation<'a> = CacheControl<'a>;
            type Meter<'a, 'op> = SwiftMeter<'a, 'op> where 'op: 'a;
            type Scratch<'a> = &'a mut [decode::Patch];
            fn meter<'a,
                'op>(usage: &'a mut SwiftCacheUsage,
                operation: &'a mut CacheControl<'op>, function: u32)
                -> SwiftMeter<'a, 'op> where 'op: 'a {
