    fn valid_limits(limits: &Limits) -> bool {
        let d = Limits::default();
        limits.table_elements <= d.table_elements && limits.module_bytes != 0
                                                                            && limits.module_bytes <= d.module_bytes &&
                                                                        limits.functions != 0 && limits.functions <= d.functions &&
                                                                limits.types != 0 && limits.types <= d.types &&
                                                        limits.instructions != 0 &&
                                                    limits.instructions <= d.instructions &&
                                                limits.locals <= d.locals && limits.operand_stack != 0 &&
                                        limits.operand_stack <= d.operand_stack &&
                                    limits.call_depth != 0 && limits.call_depth <= d.call_depth
                            && limits.control_depth != 0 &&
                        limits.control_depth <= d.control_depth &&
                    limits.memory_pages <= d.memory_pages &&
                limits.fuel <= d.fuel && limits.host_calls <= d.host_calls
    }
    impl Failure {
        fn resource(mut self, resource: Resource, attempted: u64, limit: u64)
            -> Self {
            self.resource = Some(resource);
            self.attempted = attempted;
            self.limit = limit;
            self
        }
    }
}
