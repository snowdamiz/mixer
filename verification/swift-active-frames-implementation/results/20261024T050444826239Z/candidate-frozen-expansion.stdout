                        if self.phase.parts.controls.len().saturating_sub(caller.controls)
                                >
                                self.phase.parts.cache.proof().decode_policy().control_depth()
                            {
                            return Err(self.limit(SwiftRunFailureKind::ControlLimit,
                                        SwiftRunResource::Controls, "swift_frame_control_depth",
                                        self.phase.parts.controls.len().saturating_sub(caller.controls),
