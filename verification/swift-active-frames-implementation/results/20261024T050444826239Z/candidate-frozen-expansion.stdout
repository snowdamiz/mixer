        fn fmt(&self, f: &mut ::core::fmt::Formatter) -> ::core::fmt::Result {
            let names: &'static _ =
                &["outstanding_requests", "native_leases", "reserved_bytes",
                            "argument_bytes", "completion_bytes", "retired_slots",
                            "closed", "enabled", "turn_active"];
            let values: &[&dyn ::core::fmt::Debug] =
                &[&self.outstanding_requests, &self.native_leases,
                            &self.reserved_bytes, &self.argument_bytes,
                            &self.completion_bytes, &self.retired_slots, &self.closed,
                            &self.enabled, &&self.turn_active];
            ::core::fmt::Formatter::debug_struct_fields_finish(f, "Usage",
                names, values)
