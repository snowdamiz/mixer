                attempted: u64, limit: u64) -> SwiftRunFailure {
                let mut fault =
                    Fault::new(SwiftRunFailureKind::ResourceExhausted, code);
                fault.attempted = attempted;
                fault.limit = limit;
                fault.resource =
                    Some(if kind == CacheFailureKind::EntryOversize {
                            SwiftRunResource::CacheEntryBytes
