        fn exact_abi(source: &[u8], m: &SwiftMetadata,
            meter: &mut Meter<'_, account::SwiftControl>)
            -> Result<[WasiFunction; 34], Failure> {
            let cursor = Cursor::default();
            meter.work(1, cursor)?;
            if m.imports.len() != 34 {
                return Err(meter.error(FailureKind::Validation,
                            "swift_import_count", cursor));
            }
            let mut resolved = WasiFunction::ALL;
            for (index, expected) in WasiFunction::ALL.into_iter().enumerate()
                {
                let import = m.imports.get(index).unwrap();
                let cursor =
                    Cursor {
                        function: Some(index as u32),
                        offset: import.module.offset as usize,
                    };
                let signature =
                    *m.signatures.get(import.type_index as usize).unwrap();
                let result = signature.result;
                let results = result.as_slice();
                meter.work((import.module.bytes + import.name.bytes +
                                        signature.count + 34) as u64, cursor)?;
                let actual =
                    WasiFunction::resolve(import.module.slice(source),
                                import.name.slice(source), m.params(signature),
                                results).map_err(|_|
                                meter.error(FailureKind::Validation, "swift_import_abi",
                                    cursor))?;
                if actual != expected {
                    return Err(meter.error(FailureKind::Validation,
                                "swift_import_order", cursor));
                }
                resolved[index] = actual;
            }
            if m.memory != Some((584, 768)) ||
                    m.declarations.memory_maximum.is_some() {
                return Err(meter.error(FailureKind::Validation,
                            "swift_memory_shape",
                            Cursor { offset: m.declarations.memory_offset, ..cursor }));
            }
            if m.table != Some((46_713, 46_713)) ||
                    m.declarations.table_maximum != Some(46_713) {
                return Err(meter.error(FailureKind::Validation,
                            "swift_table_shape",
                            Cursor { offset: m.declarations.table_offset, ..cursor }));
            }
            if m.exports.len() != 3 {
                return Err(meter.error(FailureKind::Validation,
                            "swift_export_count", cursor));
            }
            for (name, kind, index, result) in
                [(b"memory".as_slice(), 2, 0, None),
                        (b"_initialize".as_slice(), 0, 35, None),
                        (b"mixer_fieldlog_corpus_v1".as_slice(), 0, 62,
                            Some(Type::I32))] {
                let mut found = false;
                for export in m.exports.as_slice() {
                    let cursor =
                        Cursor {
                            function: None,
                            offset: export.name.offset as usize,
                        };
                    meter.work(export.name.bytes as u64 + 1, cursor)?;
                    if export.name.slice(source) != name { continue; }
                    found = true;
                    if export.kind != kind || export.index != index ||
                            (kind == 0 &&
                                    !m.signature(index).is_some_and(|s|
                                                s.count == 0 && s.result == result)) {
                        return Err(meter.error(FailureKind::Validation,
                                    "swift_export_abi", cursor));
                    }
                }
                if !found {
                    return Err(meter.error(FailureKind::Validation,
                                "swift_export_abi", cursor));
                }
            }
            Ok(resolved)
        }
        fn segments_fit(m: &SwiftMetadata,
            meter: &mut Meter<'_, account::SwiftControl>)
            -> Result<(), Failure> {
            let memory_bytes =
                u64::from(m.memory.unwrap().0).checked_mul(65_536).unwrap();
            let table_elements = u64::from(m.table.unwrap().0);
            for (segments, extent, code) in
                [(&m.data, memory_bytes, "swift_data_segment_fit"),
                        (&m.elements, table_elements, "swift_element_segment_fit")]
                {
                for segment in segments.as_slice() {
                    let cursor =
                        Cursor {
                            function: None,
                            offset: segment.payload.offset as usize,
                        };
                    meter.work(1, cursor)?;
                    if u64::from(segment.destination).checked_add(u64::from(segment.count)).is_none_or(|end|
                                end > extent) {
                        return Err(meter.error(FailureKind::Validation, code,
                                    cursor));
                    }
                }
            }
