        const CACHE_CLEANUP_TEMPORARY_BYTES: Option<usize> =
            compute_cache_cleanup_temporary_bytes();
        pub(crate) fn cache_cleanup_temporary_bytes() -> Option<usize> {
            CACHE_CLEANUP_TEMPORARY_BYTES
        }
        const CACHE_HEADER_BYTES: Option<usize> =
            compute_cache_header_bytes();
        pub(crate) fn cache_header_bytes() -> Option<usize> {
            CACHE_HEADER_BYTES
        }
        const CACHE_CONSTRUCTION_BYTES: Option<usize> =
            compute_cache_construction_bytes();
        pub(crate) fn cache_construction_bytes() -> Option<usize> {
            CACHE_CONSTRUCTION_BYTES
        }
