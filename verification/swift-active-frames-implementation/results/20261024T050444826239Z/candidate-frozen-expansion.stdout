                }
                fn finish_inner(&mut self)
                    -> Result<FrameReturn, SwiftRunFailure> {
                    self.active()?;
                    let result =
                        match self.phase.parts.frames.last() {
                            Some(frame) => frame.result,
                            None =>
                                return Err(self.invariant("swift_frame_finish_empty")),
                        };
                    let saved =
                        if result { Some(self.phase.pop_value()?) } else { None };
                    let frame = self.phase.parts.frames.last().unwrap();
                    let base = frame.base;
                    let controls = frame.controls;
                    let values_removed =
                        match self.phase.parts.values.len().checked_sub(base) {
                            Some(n) => n,
                            None =>
                                return Err(self.invariant("swift_frame_finish_values")),
                        };
                    let controls_removed =
                        match self.phase.parts.controls.len().checked_sub(controls)
                            {
                            Some(n) => n,
                            None =>
                                return Err(self.invariant("swift_frame_finish_controls")),
                        };
