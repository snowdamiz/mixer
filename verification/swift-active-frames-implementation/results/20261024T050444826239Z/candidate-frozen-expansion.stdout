        impl AlgorithmMeter for SwiftMeter<'_, '_> {
            type Usage = SwiftCacheUsage;
            fn usage(&self) -> &SwiftCacheUsage { self.usage }
            fn usage_mut(&mut self) -> &mut SwiftCacheUsage { self.usage }
