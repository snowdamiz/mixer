                fn rollback_entry(&mut self, pre_values_len: usize,
                    pre_controls_len: usize) {
                    if self.cleanup.entry.is_none() { return; }
                    let values =
                        self.phase.parts.values.len().checked_sub(pre_values_len);
                    let controls =
                        self.phase.parts.controls.len().checked_sub(pre_controls_len);
                    if values !=
                                Some(self.cleanup.entry.as_ref().unwrap().values_debited) ||
                            controls !=
                                Some(self.cleanup.entry.as_ref().unwrap().controls_debited)
                        {
                        self.cleanup.live_unreconciled = true;
                        self.invariant("swift_frame_rollback_mismatch");
                    }
                    if let Some(values) = values {
                        let acquired =
                            values.min(self.cleanup.entry.as_ref().unwrap().values_debited);
                        self.phase.parts.values.truncate(pre_values_len);
                        if self.remove_live(Live::Values, acquired) {
                            self.cleanup.entry.as_mut().unwrap().values_debited =
                                self.cleanup.entry.as_ref().unwrap().values_debited.saturating_sub(acquired);
                        }
                    }
                    if let Some(controls) = controls {
                        let acquired =
                            controls.min(self.cleanup.entry.as_ref().unwrap().controls_debited);
                        self.phase.parts.controls.truncate(pre_controls_len);
                        if self.remove_live(Live::Controls, acquired) {
                            self.cleanup.entry.as_mut().unwrap().controls_debited =
                                self.cleanup.entry.as_ref().unwrap().controls_debited.saturating_sub(acquired);
                        }
                    }
                    if self.cleanup.entry.as_ref().unwrap().frame_debited &&
                            self.remove_live(Live::Frames, 1) {
                        self.cleanup.entry.as_mut().unwrap().frame_debited = false;
                    }
