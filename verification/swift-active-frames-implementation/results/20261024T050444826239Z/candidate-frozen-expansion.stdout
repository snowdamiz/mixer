            }
            /// Carry the earliest deadline into the actual unchanged WASI context. This
            /// method does not construct a context or reset/admit any WASI counters.
            pub(crate) fn carry_wasi_deadline(&mut self, started: Instant,
                budget: WasiBudget, cursor: Cursor)
                -> Result<Instant, SwiftRunFailure> {
                self.check(cursor)?;
                if let Err(error) = budget.check() {
                    let mut fault =
                        Fault::new(SwiftRunFailureKind::InvalidBudget,
                            "swift_run_wasi_budget");
                    fault.wasi_failure = Some(error);
                    return Err(self.fail(cursor, fault, None));
                }
                let deadline =
                    started.checked_add(Duration::from_millis(budget.deadline_ms)).ok_or_else(||
                                {
                                    self.fail(cursor,
                                        Fault::new(SwiftRunFailureKind::InvalidBudget,
                                            "swift_run_wasi_deadline_overflow"), None)
                                })?;
                if deadline < self.deadline {
                    self.deadline = deadline;
                    self.deadline_origin = SwiftDeadlineOrigin::Wasi;
                }
                self.check(cursor)?;
                Ok(self.deadline)
            }
            pub(crate) fn usage(&self, wasi: Option<WasiUsage>)
