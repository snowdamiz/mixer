            impl<'a> FrameOperationPhase<'a> {
                #[allow(clippy::drop_non_drop)]
                pub(crate) fn complete(self,
                    storage: FrameOperationStorage<'a>) -> FrameCompletion {
                    let FrameOperationPhase { phase, cleanup, lifecycle } =
                        self;
                    let ExecutionOperationPhase { parts, operation, .. } =
                        phase;
                    let SwiftExecutionOperation { control, wasi, .. } =
                        operation;
                    let live = control.usage(Some(wasi.usage())).live;
                    let clean =
                        parts.frames.is_empty() && parts.values.is_empty() &&
                                                                    parts.controls.is_empty() && cleanup.entry.is_none() &&
                                                            cleanup.unvisited == 0 && !cleanup.entry_attempted &&
                                                    !cleanup.live_unreconciled &&
                                                cleanup.nested_restore.is_none() &&
                                            parts.cache.usage().active_pins == 0 &&
                                        live.values.current == 0 && live.controls.current == 0 &&
                                live.frames.current == 0 && live.active_pins.current == 0;
                    let mut report =
                        FrameDrainReport {
                            retained_frames: parts.frames.len(),
                            retained_entry: cleanup.entry.is_some(),
                            live_unreconciled: cleanup.live_unreconciled,
                            live,
                            cache: parts.cache.usage(),
                            usage: control.usage(Some(wasi.usage())),
                            bound: cleanup.bound,
                            nested_restore: cleanup.nested_restore,
                            first_failure: control.record_cleanup(Some(wasi.usage())),
                        };
                    if !clean {
                        drop((parts, storage));
                        *lifecycle = Lifecycle::Terminal;
                        cleanup.disposition = FrameDisposition::Retained;
                        return FrameCompletion::Retained(report);
                    }
                    let bound =
                        match cleanup.bound {
                            Some(bound) => bound,
                            None => {
                                drop((parts, storage));
                                *lifecycle = Lifecycle::Terminal;
                                cleanup.disposition = FrameDisposition::Retained;
                                return FrameCompletion::Retained(report);
                            }
                        };
                    let previous = bound.previous;
                    let restored =
                        control.end_construction_phase_with_wasi((parts, storage),
                            previous, Some(wasi.usage()));
                    if restored.is_err() {
                        *lifecycle = Lifecycle::Terminal;
                        cleanup.disposition = FrameDisposition::RestorePending;
                        report.usage = control.usage(Some(wasi.usage()));
                        report.first_failure =
                            control.record_cleanup(Some(wasi.usage()));
                        return FrameCompletion::RestoreRejected(report);
                    }
                    *cleanup = FrameCleanupState::empty();
                    FrameCompletion::Completed
                }
