    pub struct Mailbox {
        owner: u64,
        limits: Limits,
        state: Mutex<State>,
    }
    struct State {
        enabled: bool,
        closed: bool,
        active_turn: Option<u64>,
        last_turn: u64,
        reserved_bytes: usize,
        slots: [Slot; MAX_REQUESTS],
    }
    struct Slot {
        generation: u32,
        retired: bool,
        request: Option<Request>,
    }
    struct Request {
        operation: Operation,
        turn: u64,
        ready: bool,
        enqueued: Instant,
        deadline: Instant,
        arguments: Vec<u8>,
        reservation: usize,
        dispatched: bool,
        native_done: bool,
        cancel_pending: bool,
        terminal: Option<Terminal>,
        consumed: bool,
    }
    enum Terminal { Payload(Vec<u8>), Failure(FailureCode), }
    static NEXT_OWNER: AtomicU64 = AtomicU64::new(1);
    fn issue_owner(counter: &AtomicU64) -> Result<u64, Error> {
        let mut current = counter.load(Ordering::Relaxed);
        loop {
            let next =
                current.checked_add(1).ok_or(Error::IdentifierExhausted)?;
            match counter.compare_exchange_weak(current, next,
                    Ordering::Relaxed, Ordering::Relaxed) {
                Ok(_) => return Ok(current),
                Err(observed) => current = observed,
            }
        }
    }
    fn snapshot(bytes: &[u8]) -> Result<Vec<u8>, Error> {
        let mut result = Vec::new();
        result.try_reserve_exact(bytes.len()).map_err(|_|
                    Error::AllocationFailure)?;
        if result.capacity() != bytes.len() {
            return Err(Error::AllocationFailure);
        }
        result.extend_from_slice(bytes);
        Ok(result)
    }
    fn remaining(deadline: Instant, now: Instant) -> u32 {
        deadline.saturating_duration_since(now).as_millis().min(u32::MAX as
                    u128) as u32
    }
    impl Request {
        fn fail(&mut self, failure: FailureCode) {
            if self.terminal.is_none() && !self.consumed {
                self.terminal = Some(Terminal::Failure(failure));
                self.cancel_pending = self.dispatched && !self.native_done;
            }
        }
        fn expire(&mut self, now: Instant) {
            if now >= self.deadline {
                self.fail(FailureCode::DeadlineExceeded);
            }
        }
    }
    impl State {
        fn new() -> Self {
            Self {
                enabled: false,
                closed: false,
                active_turn: None,
                last_turn: 0,
                reserved_bytes: 0,
                slots: std::array::from_fn(|_|
                        Slot { generation: 1, retired: false, request: None }),
            }
        }
        fn live(&self) -> Result<(), Error> {
            if self.closed { Err(Error::SessionClosed) } else { Ok(()) }
        }
        fn expire(&mut self, now: Instant) {
            for slot in &mut self.slots {
                if let Some(request) = &mut slot.request {
                    request.expire(now);
                }
            }
        }
        fn index(&self, owner: u64, id: RequestId, delivery: bool)
            -> Result<usize, Error> {
            if id.owner != owner || (id.bits >> 32) == 0 {
                return Err(Error::StaleRequest);
            }
            let index =
                (id.bits as u32).checked_sub(1).ok_or(Error::StaleRequest)? as
                    usize;
            let slot = self.slots.get(index).ok_or(Error::StaleRequest)?;
            let request = slot.request.as_ref().ok_or(Error::StaleRequest)?;
            if slot.generation != (id.bits >> 32) as u32 ||
                    (delivery && request.consumed) {
                return Err(Error::StaleRequest);
            }
            Ok(index)
        }
        fn lease_index(&self, owner: u64, lease: &NativeLease)
            -> Result<usize, Error> {
            let index = self.index(owner, lease.request, false)?;
            let request = self.slots[index].request.as_ref().unwrap();
            if !request.dispatched || request.operation != lease.operation {
                return Err(Error::StaleRequest);
            }
            Ok(index)
        }
        fn release(&mut self, index: usize) {
            let request = self.slots[index].request.take().unwrap();
            let reservation = request.reservation;
            drop(request);
            self.reserved_bytes -= reservation;
            let slot = &mut self.slots[index];
            if let Some(next) = slot.generation.checked_add(1) {
                slot.generation = next;
            } else { slot.retired = true; }
        }
        fn close(&mut self, owner: u64) -> CloseReport {
            self.closed = true;
            self.active_turn = None;
            let mut report =
                CloseReport { cancellations: [None; MAX_REQUESTS] };
            for index in 0..MAX_REQUESTS {
                let slot = &mut self.slots[index];
                let Some(request) = &mut slot.request else { continue; };
                if request.dispatched && !request.native_done {
                    request.terminal = None;
                    request.consumed = true;
                    request.cancel_pending = false;
                    report.cancellations[index] =
                        Some(NativeLease {
                                request: RequestId {
                                    owner,
                                    bits: ((slot.generation as u64) << 32) | (index as u64 + 1),
                                },
                                operation: request.operation,
                            });
                } else { self.release(index); }
            }
            report
        }
    }
    impl Mailbox {
        /// Construction has fixed inline state and does not allocate. The process
        /// owner-ID counter is an identity mechanism, not a process mailbox quota.
        pub fn new(limits: Limits) -> Result<Self, Error> {
            if limits.maximum_requests == 0 ||
                                    limits.maximum_requests > MAX_REQUESTS ||
                                limits.reservation_bytes == 0 ||
                            limits.reservation_bytes > MAX_RESERVATION_BYTES ||
                        limits.timeout_milliseconds == 0 ||
                    limits.timeout_milliseconds > MAX_TIMEOUT_MILLISECONDS {
                return Err(Error::InvalidLimits);
            }
            Ok(Self {
                    owner: issue_owner(&NEXT_OWNER)?,
                    limits,
                    state: Mutex::new(State::new()),
                })
        }
        fn lock(&self) -> Result<MutexGuard<'_, State>, Error> {
            self.state.lock().map_err(|_| Error::Poisoned)
        }
        /// One-way opening after startup. Previously unavailable calls remain so.
        pub fn enable(&self) -> Result<(), Error> {
            let mut state = self.lock()?;
            state.live()?;
            state.enabled = true;
            Ok(())
        }
        pub fn begin_turn(&self) -> Result<TurnId, Error> {
            let mut state = self.lock()?;
            state.live()?;
            if state.active_turn.is_some() { return Err(Error::TurnActive); }
            let sequence =
                state.last_turn.checked_add(1).ok_or(Error::IdentifierExhausted)?;
            state.last_turn = sequence;
            state.active_turn = Some(sequence);
            Ok(TurnId { owner: self.owner, sequence })
        }
        /// A stale/foreign finish, including a trap, cannot affect a newer turn.
        /// A real trap closes all ownership; returned leases must be cancelled by
        /// the future coordinator outside this mailbox, then acknowledged on exit.
        pub fn finish_turn(&self, turn: TurnId, outcome: TurnOutcome)
            -> Result<Option<CloseReport>, Error> {
            let mut state = self.lock()?;
            state.live()?;
            if turn.owner != self.owner ||
                    state.active_turn != Some(turn.sequence) {
                return Err(Error::InvalidTurn);
            }
            if outcome == TurnOutcome::Trap {
                return Ok(Some(state.close(self.owner)));
            }
            state.expire(Instant::now());
            for slot in &mut state.slots {
                if let Some(request) = &mut slot.request {
                    if request.turn == turn.sequence { request.ready = true; }
                }
            }
            state.active_turn = None;
            Ok(None)
        }
        /// Budget/slot/range checks precede the only fallible payload allocation.
        /// Failure publishes no token or reservation and changes no turn state.
        pub fn enqueue(&self, turn: TurnId, operation: Operation,
            arguments: &[u8]) -> Result<RequestId, Error> {
            if arguments.is_empty() || arguments.len() > MAX_PAYLOAD_BYTES {
                return Err(Error::InvalidArguments);
            }
            let mut state = self.lock()?;
            state.live()?;
            if turn.owner != self.owner ||
                    state.active_turn != Some(turn.sequence) {
                return Err(Error::InvalidTurn);
            }
            let reservation =
                arguments.len().checked_add(MAX_PAYLOAD_BYTES).ok_or(Error::QuotaExceeded)?;
            let reserved =
                state.reserved_bytes.checked_add(reservation).ok_or(Error::QuotaExceeded)?;
            if reserved > self.limits.reservation_bytes {
                return Err(Error::QuotaExceeded);
            }
            let index =
                state.slots[..self.limits.maximum_requests].iter().position(|s|
                                !s.retired &&
                                    s.request.is_none()).ok_or(Error::QuotaExceeded)?;
            let arguments = snapshot(arguments)?;
            let enqueued = Instant::now();
            let deadline =
                enqueued.checked_add(Duration::from_millis(self.limits.timeout_milliseconds
                                    as u64)).ok_or(Error::InvalidLimits)?;
            let terminal =
                if state.enabled {
                    None
                } else { Some(Terminal::Failure(FailureCode::Unavailable)) };
            state.slots[index].request =
                Some(Request {
                        operation,
                        turn: turn.sequence,
                        ready: false,
                        enqueued,
                        deadline,
                        arguments,
                        reservation,
                        dispatched: false,
                        native_done: false,
                        cancel_pending: false,
                        terminal,
                        consumed: false,
                    });
            state.reserved_bytes = reserved;
            Ok(RequestId {
                    owner: self.owner,
                    bits: ((state.slots[index].generation as u64) << 32) |
                        (index as u64 + 1),
                })
        }
        /// Cancellation controls have priority and may drain during an active turn.
        /// Calls cannot drain during any turn, nor before their successful finish.
        /// Too-small outputs leave every byte unchanged and retain the entire call.
        pub fn take(&self, output: &mut [u8]) -> Result<Take, Error> {
            if output.len() > MAX_PAYLOAD_BYTES {
                return Err(Error::InvalidArguments);
            }
            let mut state = self.lock()?;
            state.live()?;
            let now = Instant::now();
            state.expire(now);
            for index in 0..MAX_REQUESTS {
                let slot = &mut state.slots[index];
                let Some(request) = &mut slot.request else { continue; };
                if request.cancel_pending {
                    request.cancel_pending = false;
                    return Ok(Take::Cancel {
                                lease: NativeLease {
                                    request: RequestId {
                                        owner: self.owner,
                                        bits: ((slot.generation as u64) << 32) | (index as u64 + 1),
                                    },
                                    operation: request.operation,
                                },
                            });
                }
            }
            if state.active_turn.is_some() { return Ok(Take::None); }
            for index in 0..MAX_REQUESTS {
                let slot = &mut state.slots[index];
                let Some(request) = &mut slot.request else { continue; };
                if request.ready && !request.dispatched &&
                            request.terminal.is_none() && !request.consumed {
                    let remaining_milliseconds =
                        remaining(request.deadline, Instant::now());
                    if remaining_milliseconds == 0 {
                        request.fail(FailureCode::DeadlineExceeded);
                        continue;
                    }
                    let length = request.arguments.len();
                    if output.len() < length {
                        return Ok(Take::BufferTooSmall { required: length });
                    }
                    request.dispatched = true;
                    output[..length].copy_from_slice(&request.arguments);
                    return Ok(Take::Call {
                                lease: NativeLease {
                                    request: RequestId {
                                        owner: self.owner,
                                        bits: ((slot.generation as u64) << 32) | (index as u64 + 1),
                                    },
                                    operation: request.operation,
                                },
                                length,
                                remaining_milliseconds,
                            });
                }
            }
            Ok(Take::None)
        }
        /// Copies one opaque completion. Strict payload validation is a separate
        /// bridge obligation. Terminal success is not proof of adapter exit.
        /// Late/duplicate post cannot replace a cancellation/deadline/other result.
        pub fn post(&self, lease: &NativeLease, completion: &[u8])
            -> Result<(), Error> {
            if completion.is_empty() || completion.len() > MAX_PAYLOAD_BYTES {
                return Err(Error::InvalidArguments);
            }
            let mut state = self.lock()?;
            state.live()?;
            let index = state.lease_index(self.owner, lease)?;
            let request = state.slots[index].request.as_mut().unwrap();
            request.expire(Instant::now());
            if request.consumed { return Err(Error::StaleRequest); }
            if request.terminal.is_some() {
                return Err(Error::AlreadyTerminal);
            }
            if request.native_done { return Err(Error::AlreadyAcknowledged); }
            let bytes = snapshot(completion)?;
            request.expire(Instant::now());
            if request.terminal.is_some() {
                return Err(Error::AlreadyTerminal);
            }
            request.terminal = Some(Terminal::Payload(bytes));
            Ok(())
        }
        /// Actual adapter exit is independent of completion. An early ack is
        /// accepted, blocks future post, and retains pending delivery until its
        /// deadline/cancellation. It never reclaims a pending or unconsumed result.
        pub fn ack_exit(&self, lease: &NativeLease) -> Result<(), Error> {
            let mut state = self.lock()?;
            let index = state.lease_index(self.owner, lease)?;
            let closed = state.closed;
            let request = state.slots[index].request.as_mut().unwrap();
            if request.native_done { return Err(Error::AlreadyAcknowledged); }
            request.native_done = true;
            request.cancel_pending = false;
            if !closed { request.expire(Instant::now()); }
            if closed || request.consumed { state.release(index); }
            Ok(())
        }
        /// Applies min(previous deadline, original enqueue + timeout), never now +
        /// timeout. Floored zero remaining installs expiry before future I/O.
        pub fn limit_deadline(&self, lease: &NativeLease,
            timeout_milliseconds: u32) -> Result<u32, Error> {
            if timeout_milliseconds == 0 ||
                    timeout_milliseconds > MAX_TIMEOUT_MILLISECONDS {
                return Err(Error::InvalidArguments);
            }
            let mut state = self.lock()?;
            state.live()?;
            let index = state.lease_index(self.owner, lease)?;
            let request = state.slots[index].request.as_mut().unwrap();
            request.expire(Instant::now());
            if request.consumed { return Err(Error::StaleRequest); }
            if request.terminal.is_some() {
                return Err(Error::AlreadyTerminal);
            }
            if request.native_done { return Err(Error::AlreadyAcknowledged); }
            let proposed =
                request.enqueued.checked_add(Duration::from_millis(timeout_milliseconds
                                    as u64)).ok_or(Error::InvalidArguments)?;
            request.deadline = request.deadline.min(proposed);
            let remaining = remaining(request.deadline, Instant::now());
            if remaining == 0 { request.fail(FailureCode::DeadlineExceeded); }
            Ok(remaining)
        }
        pub fn cancel(&self, id: RequestId) -> Result<(), Error> {
            let mut state = self.lock()?;
            state.live()?;
            let index = state.index(self.owner, id, true)?;
            let request = state.slots[index].request.as_mut().unwrap();
            request.expire(Instant::now());
            if request.terminal.is_some() {
                return Err(Error::AlreadyTerminal);
            }
            request.fail(FailureCode::Cancelled);
            Ok(())
        }
        /// Slice capacities include zero and are bounded even for pending/failure.
        /// Pending/too-small/error writes nothing; Ready copies in full and consumes
        /// once. Delivery consumption alone does not release a running native lease.
        pub fn poll(&self, id: RequestId, output: &mut [u8])
            -> Result<Poll, Error> {
            if output.len() > MAX_PAYLOAD_BYTES {
                return Err(Error::InvalidArguments);
            }
            let mut state = self.lock()?;
            state.live()?;
            let index = state.index(self.owner, id, true)?;
            let request = state.slots[index].request.as_mut().unwrap();
            request.expire(Instant::now());
            let Some(terminal) =
                &request.terminal else { return Ok(Poll::Pending); };
            let result =
                match terminal {
                    Terminal::Payload(bytes) => {
                        if output.len() < bytes.len() {
                            return Ok(Poll::BufferTooSmall { required: bytes.len() });
                        }
                        output[..bytes.len()].copy_from_slice(bytes);
                        Poll::Ready { length: bytes.len() }
                    }
                    Terminal::Failure(failure) => Poll::Failure(*failure),
                };
            request.consumed = true;
            request.terminal = None;
            if !request.dispatched || request.native_done {
                state.release(index);
            }
            Ok(result)
        }
        /// Bounded scan; runs no native work or guest code. Expiry does not release
        /// guest delivery or native exit obligations.
        pub fn expire(&self) -> Result<(), Error> {
            let mut state = self.lock()?;
            state.live()?;
            state.expire(Instant::now());
            Ok(())
        }
        pub fn close(&self) -> Result<CloseReport, Error> {
            Ok(self.lock()?.close(self.owner))
        }
        /// Observation does not advance deadlines. Closed state remains observable.
        pub fn usage(&self) -> Result<Usage, Error> {
            let state = self.lock()?;
            let mut usage =
                Usage {
                    reserved_bytes: state.reserved_bytes,
                    closed: state.closed,
                    enabled: state.enabled,
                    turn_active: state.active_turn.is_some(),
                    ..Usage::default()
                };
            for slot in &state.slots {
                if slot.retired { usage.retired_slots += 1; }
                if let Some(request) = &slot.request {
                    usage.outstanding_requests += 1;
                    usage.native_leases +=
                        usize::from(request.dispatched && !request.native_done);
                    usage.argument_bytes += request.arguments.capacity();
                    if let Some(Terminal::Payload(bytes)) = &request.terminal {
                        usage.completion_bytes += bytes.capacity();
                    }
                }
            }
            Ok(usage)
        }
    }
    mod guest {
        //! Private transactional guest boundary; no external callbacks under mailbox lock.
        use super::*;
        use crate::experimental_capability_guest::{
            fixed_terminal, GuestBudget,
        };
        impl Mailbox {
            pub(crate) fn guest_enqueue(&self, turn: TurnId,
                operation: Operation, arguments: &[u8],
                token_output: &mut [u8], budget: &mut GuestBudget<'_>)
                -> Result<u32, crate::Error> {
                let mut state = self.lock().map_err(|e| budget.trap(e))?;
                if let Err(e) = state.live() { return budget.status(e); }
                if turn.owner != self.owner ||
                        state.active_turn != Some(turn.sequence) {
                    return Err(budget.trap(Error::InvalidTurn));
                }
                let reservation =
                    arguments.len().checked_add(MAX_PAYLOAD_BYTES).ok_or_else(||
                                budget.trap(Error::QuotaExceeded))?;
                let Some(reserved) =
                    state.reserved_bytes.checked_add(reservation).filter(|n|
                            *n <= self.limits.reservation_bytes) else { return Ok(5); };
                let Some(index) =
                    state.slots[..self.limits.maximum_requests].iter().position(|s|
                            !s.retired && s.request.is_none()) else { return Ok(5); };
                budget.charge(arguments.len().checked_add(8).ok_or_else(||
                                    budget.trap(Error::InvalidArguments))?)?;
                let arguments =
                    snapshot(arguments).map_err(|e| budget.trap(e))?;
                let enqueued = Instant::now();
                let deadline =
                    enqueued.checked_add(Duration::from_millis(self.limits.timeout_milliseconds
                                        as u64)).ok_or_else(|| budget.trap(Error::InvalidLimits))?;
                let terminal =
                    if state.enabled {
                        None
                    } else {
                        Some(Terminal::Failure(FailureCode::Unavailable))
                    };
                let bits =
                    ((state.slots[index].generation as u64) << 32) |
                        (index as u64 + 1);
                state.slots[index].request =
                    Some(Request {
                            operation,
                            turn: turn.sequence,
                            ready: false,
                            enqueued,
                            deadline,
                            arguments,
                            reservation,
                            dispatched: false,
                            native_done: false,
                            cancel_pending: false,
                            terminal,
                            consumed: false,
                        });
                state.reserved_bytes = reserved;
                token_output.copy_from_slice(&bits.to_le_bytes());
                Ok(0)
            }
            pub(crate) fn guest_poll(&self, bits: u64, memory: &mut [u8],
                output: std::ops::Range<usize>,
                length: std::ops::Range<usize>, budget: &mut GuestBudget<'_>)
                -> Result<u32, crate::Error> {
                let mut state = self.lock().map_err(|e| budget.trap(e))?;
                if let Err(e) = state.live() { return budget.status(e); }
                let index =
                    match state.index(self.owner,
                            RequestId { owner: self.owner, bits }, true) {
                        Ok(n) => n,
                        Err(e) => return budget.status(e),
                    };
                let request = state.slots[index].request.as_mut().unwrap();
                request.expire(Instant::now());
                let payload =
                    match &request.terminal {
                        None => None,
                        Some(Terminal::Payload(bytes)) => Some(bytes.as_slice()),
                        Some(Terminal::Failure(code)) =>
                            Some(fixed_terminal(request.operation, *code)),
                    };
                let Some(bytes) =
                    payload else {
                        budget.charge(4)?;
                        memory[length].copy_from_slice(&0u32.to_le_bytes());
                        return Ok(1);
                    };
                let required = bytes.len();
                if output.len() < required {
                    budget.charge(4)?;
                    memory[length].copy_from_slice(&(required as
                                        u32).to_le_bytes());
                    return Ok(2);
                }
                budget.charge(required.checked_add(4).ok_or_else(||
                                    budget.trap(Error::InvalidArguments))?)?;
                memory[output.start..output.start +
                                required].copy_from_slice(bytes);
                memory[length].copy_from_slice(&(required as
                                    u32).to_le_bytes());
                request.consumed = true;
                request.terminal = None;
                if !request.dispatched || request.native_done {
                    state.release(index);
                }
                Ok(0)
            }
            pub(crate) fn guest_cancel(&self, bits: u64)
                -> Result<(), Error> {
                self.cancel(RequestId { owner: self.owner, bits })
            }
            /// One bounded coalesced readiness predicate, not a callback/event queue.
            pub(crate) fn guest_ready(&self) -> Result<bool, Error> {
                let mut state = self.lock()?;
                state.live()?;
                state.expire(Instant::now());
                Ok(state.active_turn.is_none() &&
                        state.slots.iter().any(|s|
                                {
                                    s.request.as_ref().is_some_and(|r|
                                            r.ready && !r.consumed && r.terminal.is_some())
                                }))
            }
        }
    }
}
pub mod experimental_capability_guest {
    //! Opt-in actual-Wasm composition experiment. No public profile4, C ABI, registry,
    //! native I/O, strict dynamic payload codec, scheduler or release route is added.
    //! Shared Arc/standard mutex/core interpreter allocations can abort on OOM.
    mod fixed {
        use crate::experimental_capability::{FailureCode, Operation};
        #[rustfmt::skip]
        pub(super) fn terminal(operation: Operation, failure: FailureCode)
            -> &'static [u8] {
            match (operation, failure) {
                (Operation::HttpRequest, FailureCode::Unavailable) =>
                    b"{\"abi\":1,\"capability\":\"network.http.v1\",\"operation\":\"request\",\"outcome\":{\"code\":\"unavailable\",\"kind\":\"failure\"},\"schemaHash\":\"fa1549c0a1e2e6b3bf4a83af1a6d37730bbefc8cddc3ffbe3c807d5e7af503f3\"}",
                (Operation::HttpRequest, FailureCode::Cancelled) =>
                    b"{\"abi\":1,\"capability\":\"network.http.v1\",\"operation\":\"request\",\"outcome\":{\"code\":\"cancelled\",\"kind\":\"failure\"},\"schemaHash\":\"fa1549c0a1e2e6b3bf4a83af1a6d37730bbefc8cddc3ffbe3c807d5e7af503f3\"}",
                (Operation::HttpRequest, FailureCode::DeadlineExceeded) =>
                    b"{\"abi\":1,\"capability\":\"network.http.v1\",\"operation\":\"request\",\"outcome\":{\"code\":\"deadlineExceeded\",\"kind\":\"failure\"},\"schemaHash\":\"fa1549c0a1e2e6b3bf4a83af1a6d37730bbefc8cddc3ffbe3c807d5e7af503f3\"}",
                (Operation::Get, FailureCode::Unavailable) =>
                    b"{\"abi\":1,\"capability\":\"storage.keyValue.v1\",\"operation\":\"get\",\"outcome\":{\"code\":\"unavailable\",\"kind\":\"failure\"},\"schemaHash\":\"4a311222c978ddd0982e8dfbcf3d4864b856a80bcc1efb3b725adede7f8e22fd\"}",
                (Operation::Get, FailureCode::Cancelled) =>
                    b"{\"abi\":1,\"capability\":\"storage.keyValue.v1\",\"operation\":\"get\",\"outcome\":{\"code\":\"cancelled\",\"kind\":\"failure\"},\"schemaHash\":\"4a311222c978ddd0982e8dfbcf3d4864b856a80bcc1efb3b725adede7f8e22fd\"}",
                (Operation::Get, FailureCode::DeadlineExceeded) =>
                    b"{\"abi\":1,\"capability\":\"storage.keyValue.v1\",\"operation\":\"get\",\"outcome\":{\"code\":\"deadlineExceeded\",\"kind\":\"failure\"},\"schemaHash\":\"4a311222c978ddd0982e8dfbcf3d4864b856a80bcc1efb3b725adede7f8e22fd\"}",
                (Operation::Put, FailureCode::Unavailable) =>
                    b"{\"abi\":1,\"capability\":\"storage.keyValue.v1\",\"operation\":\"put\",\"outcome\":{\"code\":\"unavailable\",\"kind\":\"failure\"},\"schemaHash\":\"4a311222c978ddd0982e8dfbcf3d4864b856a80bcc1efb3b725adede7f8e22fd\"}",
                (Operation::Put, FailureCode::Cancelled) =>
                    b"{\"abi\":1,\"capability\":\"storage.keyValue.v1\",\"operation\":\"put\",\"outcome\":{\"code\":\"cancelled\",\"kind\":\"failure\"},\"schemaHash\":\"4a311222c978ddd0982e8dfbcf3d4864b856a80bcc1efb3b725adede7f8e22fd\"}",
                (Operation::Put, FailureCode::DeadlineExceeded) =>
                    b"{\"abi\":1,\"capability\":\"storage.keyValue.v1\",\"operation\":\"put\",\"outcome\":{\"code\":\"deadlineExceeded\",\"kind\":\"failure\"},\"schemaHash\":\"4a311222c978ddd0982e8dfbcf3d4864b856a80bcc1efb3b725adede7f8e22fd\"}",
                (Operation::Delete, FailureCode::Unavailable) =>
                    b"{\"abi\":1,\"capability\":\"storage.keyValue.v1\",\"operation\":\"delete\",\"outcome\":{\"code\":\"unavailable\",\"kind\":\"failure\"},\"schemaHash\":\"4a311222c978ddd0982e8dfbcf3d4864b856a80bcc1efb3b725adede7f8e22fd\"}",
                (Operation::Delete, FailureCode::Cancelled) =>
                    b"{\"abi\":1,\"capability\":\"storage.keyValue.v1\",\"operation\":\"delete\",\"outcome\":{\"code\":\"cancelled\",\"kind\":\"failure\"},\"schemaHash\":\"4a311222c978ddd0982e8dfbcf3d4864b856a80bcc1efb3b725adede7f8e22fd\"}",
                (Operation::Delete, FailureCode::DeadlineExceeded) =>
                    b"{\"abi\":1,\"capability\":\"storage.keyValue.v1\",\"operation\":\"delete\",\"outcome\":{\"code\":\"deadlineExceeded\",\"kind\":\"failure\"},\"schemaHash\":\"4a311222c978ddd0982e8dfbcf3d4864b856a80bcc1efb3b725adede7f8e22fd\"}",
            }
        }
    }
    use crate::experimental_capability as mb;
    use crate::{
        Cancellation, Error, Import, Instance, Limits, Module, Profile,
        Signature, Type, Value,
    };
    use std::sync::{
        atomic::{AtomicBool, Ordering},
        Arc,
    };
    use std::time::{Duration, Instant};
    pub const IMPORT_MODULE: &str = "mixer.capability.v1";
    pub const WAKE_EXPORT: &str = "mixer_guest_capability_ready_v1";
    pub struct GuestLimits {
        pub turn_milliseconds: u32,
    }
    #[automatically_derived]
    #[doc(hidden)]
    unsafe impl ::core::clone::TrivialClone for GuestLimits { }
    #[automatically_derived]
    impl ::core::clone::Clone for GuestLimits {
        #[inline]
        fn clone(&self) -> GuestLimits {
            let _: ::core::clone::AssertParamIsClone<u32>;
            *self
        }
    }
    #[automatically_derived]
    impl ::core::marker::Copy for GuestLimits { }
    #[automatically_derived]
    impl ::core::fmt::Debug for GuestLimits {
        #[inline]
        fn fmt(&self, f: &mut ::core::fmt::Formatter) -> ::core::fmt::Result {
            ::core::fmt::Formatter::debug_struct_field1_finish(f,
                "GuestLimits", "turn_milliseconds", &&self.turn_milliseconds)
        }
    }
    impl Default for GuestLimits {
        fn default() -> Self { Self { turn_milliseconds: 50 } }
    }
    struct Shared {
        mailbox: mb::Mailbox,
        cancellation: Cancellation,
        closed: AtomicBool,
    }
    impl Shared {
        fn live(&self) -> Result<(), mb::Error> {
            if self.closed.load(Ordering::Acquire) ||
                    self.cancellation.is_cancelled() {
                self.close_without_unwind();
                Err(mb::Error::SessionClosed)
            } else { Ok(()) }
        }
        fn close(&self) -> Result<mb::CloseReport, mb::Error> {
            self.closed.store(true, Ordering::Release);
            self.cancellation.cancel();
            self.mailbox.close()
        }
        fn close_without_unwind(&self) {
            if let Err(payload) =
                    std::panic::catch_unwind(std::panic::AssertUnwindSafe(||
                                { let _ = self.close(); })) {
                std::mem::forget(payload);
            }
        }
    }
    /// Native callers retain this owner and every outstanding ticket through cleanup.
    /// Drop is not proof of adapter exit; no counted process registry exists here.
    pub struct CapabilityPort {
        shared: Arc<Shared>,
    }
    #[automatically_derived]
    impl ::core::clone::Clone for CapabilityPort {
        #[inline]
        fn clone(&self) -> CapabilityPort {
            CapabilityPort {
                shared: ::core::clone::Clone::clone(&self.shared),
            }
        }
    }
    pub struct DispatchLease {
        shared: Arc<Shared>,
        lease: mb::NativeLease,
    }
    impl DispatchLease {
        /// Acknowledges only actual native cleanup; also usable after every port drops.
        pub fn ack_exit(&self) -> Result<(), mb::Error> {
            self.shared.mailbox.ack_exit(&self.lease)
        }
        pub fn operation(&self) -> mb::Operation { self.lease.operation() }
        pub fn token_bits(&self) -> u64 { self.lease.request().token_bits() }
    }
    pub enum NativeTake {
        None,
        BufferTooSmall {
            required: usize,
        },
        Call {
            lease: DispatchLease,
            length: usize,
            remaining_milliseconds: u32,
        },
        Cancel {
            lease: DispatchLease,
        },
    }
    impl CapabilityPort {
        fn check(&self, lease: &DispatchLease) -> Result<(), mb::Error> {
            if Arc::ptr_eq(&self.shared, &lease.shared) {
                Ok(())
            } else { Err(mb::Error::StaleRequest) }
        }
        pub fn take(&self, output: &mut [u8])
            -> Result<NativeTake, mb::Error> {
            self.shared.live()?;
            Ok(match self.shared.mailbox.take(output)? {
                    mb::Take::None => NativeTake::None,
                    mb::Take::BufferTooSmall { required } =>
                        NativeTake::BufferTooSmall { required },
                    mb::Take::Call { lease, length, remaining_milliseconds } =>
                        NativeTake::Call {
                            lease: DispatchLease {
                                shared: Arc::clone(&self.shared),
                                lease,
                            },
                            length,
                            remaining_milliseconds,
                        },
                    mb::Take::Cancel { lease } =>
                        NativeTake::Cancel {
                            lease: DispatchLease {
                                shared: Arc::clone(&self.shared),
                                lease,
                            },
                        },
                })
        }
        /// Trusted opaque bytes. Caller must validate/bind the dynamic wire payload.
        pub fn post_trusted(&self, lease: &DispatchLease, completion: &[u8])
            -> Result<(), mb::Error> {
            self.shared.live()?;
            self.check(lease)?;
            self.shared.mailbox.post(&lease.lease, completion)
        }
        pub fn ack_exit(&self, lease: &DispatchLease)
            -> Result<(), mb::Error> {
            self.check(lease)?;
            self.shared.mailbox.ack_exit(&lease.lease)
        }
        pub fn limit_deadline(&self, lease: &DispatchLease,
            timeout_milliseconds: u32) -> Result<u32, mb::Error> {
            self.shared.live()?;
            self.check(lease)?;
            self.shared.mailbox.limit_deadline(&lease.lease,
                timeout_milliseconds)
        }
        pub fn expire(&self) -> Result<(), mb::Error> {
            self.shared.live()?;
            self.shared.mailbox.expire()
        }
        pub fn usage(&self) -> Result<mb::Usage, mb::Error> {
            self.shared.mailbox.usage()
        }
        pub fn close(&self) -> Result<mb::CloseReport, mb::Error> {
            self.shared.close()
        }
    }
    /// Non-Clone private engine owner; never exposes its privileged Module/Instance.
    pub struct CapabilityGuest {
        instance: Instance,
        shared: Arc<Shared>,
        startup_index: u32,
        wake_index: u32,
        startup_complete: bool,
        limits: GuestLimits,
    }
    fn error(code: &'static str, message: &'static str) -> Error {
        Error::new(code, message, None, 0)
    }
    fn exported(module: &Module, name: &str, void: bool)
        -> Result<u32, Error> {
        let (kind, index) =
            module.exports.get(name).copied().ok_or_else(||
                        {
                            error("capability_export",
                                "required capability guest export is missing")
                        })?;
        let signature =
            module.signature(index).ok_or_else(||
                        error("capability_export",
                            "required export signature is missing"))?;
        if kind != 0 || (index as usize) < module.imports.len() ||
                    !signature.params.is_empty() ||
                (void && signature.result.is_some()) {
            return Err(error("capability_export",
                        "required export must be a defined no-argument function with the exact result"));
        }
        Ok(index)
    }
    impl CapabilityGuest {
        pub fn new(wasm: &[u8], vm: Limits, mailbox: mb::Limits,
            guest: GuestLimits, installed_startup_export: &str)
            -> Result<Self, Error> {
            let (module, startup_index, wake_index) =
                Self::validated(wasm, &vm, &mailbox, guest,
                        installed_startup_export)?;
            let instance = Instance::new_capability(module, vm)?;
            let shared =
                Arc::new(Shared {
                        mailbox: mb::Mailbox::new(mailbox).map_err(|e|
                                    {
                                        if e == mb::Error::InvalidLimits {
                                            error("invalid_limits", "invalid capability mailbox limits")
                                        } else { mailbox_trap(e, None, 0) }
                                    })?,
                        cancellation: instance.cancellation(),
                        closed: AtomicBool::new(false),
                    });
            Ok(Self {
                    instance,
                    shared,
                    startup_index,
                    wake_index,
                    startup_complete: false,
                    limits: guest,
                })
        }
        fn validated(wasm: &[u8], vm: &Limits, mailbox: &mb::Limits,
            guest: GuestLimits, installed_startup_export: &str)
            -> Result<(Module, u32, u32), Error> {
            if vm.profile != Profile::TableMemoryV3 ||
                        guest.turn_milliseconds == 0 || guest.turn_milliseconds > 50
                {
                return Err(error("invalid_limits",
                            "capability guest requires v3 grammar and a1..50ms turn ceiling"));
            }
            if mailbox.maximum_requests == 0 ||
                                    mailbox.maximum_requests > mb::MAX_REQUESTS ||
                                mailbox.reservation_bytes == 0 ||
                            mailbox.reservation_bytes > mb::MAX_RESERVATION_BYTES ||
                        mailbox.timeout_milliseconds == 0 ||
                    mailbox.timeout_milliseconds > mb::MAX_TIMEOUT_MILLISECONDS
                {
                return Err(error("invalid_limits",
                            "invalid capability mailbox limits"));
            }
            if installed_startup_export.is_empty() ||
                    installed_startup_export.len() > 4096 {
                return Err(error("capability_export",
                            "invalid installed startup export"));
            }
            let module = Module::decode_capability(wasm, vm)?;
            let startup_index =
                exported(&module, installed_startup_export, false)?;
            let wake_index = exported(&module, WAKE_EXPORT, true)?;
            Ok((module, startup_index, wake_index))
        }
        /// Exact constructor validation, with no instance linear memory/owner/startup.
        pub(crate) fn validate_only(wasm: &[u8], vm: &Limits,
            mailbox: &mb::Limits, guest: GuestLimits, startup: &str)
            -> Result<(), Error> {
            Self::validated(wasm, vm, mailbox, guest, startup).map(|_| ())
        }
        /// Complete capability validation followed by the fixed guest-UI signatures.
        /// The returned validated module is inspected directly, never instantiated or
        /// decoded a second time. This path has no mailbox or registry interaction.
        pub(crate) fn validate_guest_ui_only(wasm: &[u8], vm: &Limits,
            mailbox: &mb::Limits, guest: GuestLimits) -> Result<(), Error> {
            const START: &str = "mixer_guest_ui_start_v1";
            const EVENT: &str = "mixer_guest_ui_event_v1";
            let (module, _, _) =
                Self::validated(wasm, vm, mailbox, guest, START)?;
            for (name, params, result) in
                [(START, &[][..], Some(Type::I32)),
                        (EVENT, &[Type::I32][..], Some(Type::I32)),
                        (WAKE_EXPORT, &[][..], None)] {
                let valid =
                    module.exports.get(name).is_some_and(|&(kind, index)|
                            {
                                kind == 0 && index as usize >= module.imports.len() &&
                                    module.signature(index).is_some_and(|signature|
                                            {
                                                signature.params == params && signature.result == result
                                            })
                            });
                if !valid {
                    return Err(error("capability_export",
                                "required guest UI export must be a defined function with the exact signature"));
                }
            }
            Ok(())
        }
        pub(crate) fn write_memory(&mut self, offset: u32, source: &[u8])
            -> Result<(), Error> {
            self.live()?;
            self.instance.write_memory(offset, source)
        }
        pub fn native_port(&self) -> CapabilityPort {
            CapabilityPort { shared: Arc::clone(&self.shared) }
        }
        pub fn cancellation(&self) -> Cancellation {
            self.instance.cancellation()
        }
        pub fn memory(&self) -> &[u8] { self.instance.memory() }
        pub fn fuel_remaining(&self) -> u64 { self.instance.fuel_remaining }
        pub fn host_calls_used(&self) -> u64 { self.instance.host_calls_used }
        fn live(&self) -> Result<(), Error> {
            if self.shared.closed.load(Ordering::Acquire) ||
                    self.shared.cancellation.is_cancelled() {
                self.shared.close_without_unwind();
                return Err(error("capability_closed",
                            "capability guest is permanently closed"));
            }
            Ok(())
        }
        pub fn startup(&mut self) -> Result<Option<Value>, Error> {
            self.live()?;
            if self.startup_complete {
                return Err(error("capability_state",
                            "startup already completed"));
            }
            let result = self.run(Some(self.startup_index), None, &[])?;
            self.startup_complete = true;
            Ok(result)
        }
        pub fn enable_effects(&mut self) -> Result<(), Error> {
            self.live()?;
            if !self.startup_complete {
                return Err(error("capability_state",
                            "startup must finish before enabling effects"));
            }
            if let Err(e) = self.shared.mailbox.enable() {
                self.shared.close_without_unwind();
                return Err(mailbox_trap(e, None, 0));
            }
            Ok(())
        }
        pub fn invoke(&mut self, export: &str, args: &[Value])
            -> Result<Option<Value>, Error> {
            self.live()?;
            if !self.startup_complete {
                return Err(error("capability_state",
                            "startup must finish before ordinary turns"));
            }
            self.run(None, Some(export), args)
        }
        pub fn wake_once(&mut self) -> Result<bool, Error> {
            self.live()?;
            if !self.startup_complete {
                return Err(error("capability_state",
                            "startup must finish before wake"));
            }
            match self.shared.mailbox.guest_ready() {
                Ok(false) => Ok(false),
                Ok(true) => {
                    self.run(Some(self.wake_index), None, &[])?;
                    Ok(true)
                }
                Err(e) => {
                    self.shared.close_without_unwind();
                    Err(mailbox_trap(e, None, 0))
                }
            }
        }
        pub fn close(&mut self) -> Result<mb::CloseReport, Error> {
            self.shared.close().map_err(|e| mailbox_trap(e, None, 0))
        }
        fn run(&mut self, index: Option<u32>, export: Option<&str>,
            args: &[Value]) -> Result<Option<Value>, Error> {
            let shared = Arc::clone(&self.shared);
            let turn =
                match shared.mailbox.begin_turn() {
                    Ok(turn) => turn,
                    Err(e) => {
                        shared.close_without_unwind();
                        return Err(mailbox_trap(e, None, 0));
                    }
                };
            let mut guard = TurnGuard { shared: &shared, finished: false };
            let deadline =
                Instant::now().checked_add(Duration::from_millis(self.limits.turn_milliseconds
                                    as
                                    u64)).ok_or_else(||
                            error("invalid_limits", "turn deadline overflow"))?;
            let imports = GuestImports { shared: &shared, turn, deadline };
            let result =
                match index {
                    Some(index) =>
                        self.instance.invoke_capability(index, args, &imports),
                    None =>
                        self.instance.invoke_capability_export(export.expect("private entry selection"),
                            args, &imports),
                };
            let result =
                result.and_then(|value|
                        {
                            imports.check_boundary(None, 0)?;
                            shared.mailbox.finish_turn(turn,
                                        mb::TurnOutcome::Success).map_err(|e|
                                        mailbox_trap(e, None, 0))?;
                            Ok(value)
                        });
            if result.is_ok() { guard.finished = true; }
            result
        }
    }
    impl Drop for CapabilityGuest {
        fn drop(&mut self) { self.shared.close_without_unwind(); }
    }
    struct TurnGuard<'a> {
        shared: &'a Shared,
        finished: bool,
    }
    impl Drop for TurnGuard<'_> {
        fn drop(&mut self) {
            if !self.finished { self.shared.close_without_unwind(); }
        }
    }
    pub(crate) fn allowed_import(import: &Import, sig: &Signature) -> bool {
        if import.module != IMPORT_MODULE || sig.result != Some(Type::I32) {
            return false;
        }
        match import.name.as_str() {
            "http_request" | "storage_get" | "storage_put" | "storage_delete"
                => {
                sig.params == [Type::I32, Type::I32, Type::I32]
            }
            "cancel" => sig.params == [Type::I64],
            "poll" =>
                sig.params == [Type::I64, Type::I32, Type::I32, Type::I32],
            _ => false,
        }
    }
    pub(crate) fn fixed_terminal(operation: mb::Operation,
        failure: mb::FailureCode) -> &'static [u8] {
        fixed::terminal(operation, failure)
    }
    fn mailbox_trap(e: mb::Error, function: Option<u32>, offset: usize)
        -> Error {
        let (code, message) =
            match e {
                mb::Error::AllocationFailure =>
                    ("capability_allocation",
                        "capability payload allocation failed"),
                mb::Error::IdentifierExhausted =>
                    ("capability_identifier_exhausted",
                        "capability identity exhausted"),
                mb::Error::Poisoned =>
                    ("capability_poisoned", "capability mailbox is poisoned"),
                _ =>
                    ("capability_protocol",
                        "capability mailbox transition failed"),
            };
        Error::new(code, message, function, offset)
    }
    pub(crate) struct GuestImports<'a> {
        shared: &'a Shared,
        turn: mb::TurnId,
        deadline: Instant,
    }
    impl GuestImports<'_> {
        pub(crate) fn check(&self, function: u32, offset: usize)
            -> Result<(), Error> {
            self.check_boundary(Some(function), offset)
        }
        fn check_boundary(&self, function: Option<u32>, offset: usize)
            -> Result<(), Error> {
            if self.shared.closed.load(Ordering::Acquire) ||
                    self.shared.cancellation.is_cancelled() {
                return Err(Error::new("cancelled",
                            "capability guest execution cancelled", function, offset));
            }
            if Instant::now() >= self.deadline {
                return Err(Error::new("capability_turn_timeout",
                            "cooperative capability guest turn deadline exceeded",
                            function, offset));
            }
            Ok(())
        }
        pub(crate) fn import(&self, name: &str, args: &[Value],
            memory: &mut [u8], fuel: &mut u64, caller: u32, offset: usize)
            -> Result<Option<Value>, Error> {
            let mut budget =
                GuestBudget { fuel, imports: self, caller, offset };
            let status =
                match name {
                    "http_request" | "storage_get" | "storage_put" |
                        "storage_delete" => {
                        let start = i32arg(args, 0);
                        let len = i32arg(args, 1) as usize;
                        let token = i32arg(args, 2);
                        let Some(input) =
                            range(start, len,
                                    memory.len()).filter(|_|
                                    (1..=mb::MAX_PAYLOAD_BYTES).contains(&len)) else {
                                return Ok(Some(Value::I32(3)));
                            };
                        let Some(output) =
                            range(token, 8,
                                memory.len()) else { return Ok(Some(Value::I32(3))); };
                        if overlap(&input, &output) {
                            return Ok(Some(Value::I32(3)));
                        }
                        let operation =
                            match name {
                                "http_request" => mb::Operation::HttpRequest,
                                "storage_get" => mb::Operation::Get,
                                "storage_put" => mb::Operation::Put,
                                _ => mb::Operation::Delete,
                            };
                        let (arguments, token_output) =
                            if input.end <= output.start {
                                let (a, b) = memory.split_at_mut(output.start);
                                (&a[input], &mut b[..8])
                            } else {
                                let (a, b) = memory.split_at_mut(input.start);
                                (&b[..len], &mut a[output])
                            };
                        self.shared.mailbox.guest_enqueue(self.turn, operation,
                                arguments, token_output, &mut budget)?
                    }
                    "cancel" =>
                        match self.shared.mailbox.guest_cancel(i64arg(args, 0)) {
                            Ok(()) => 0,
                            Err(e) => budget.status(e)?,
                        },
                    "poll" => {
                        let capacity = i32arg(args, 2) as usize;
                        let Some(output) =
                            range(i32arg(args, 1), capacity,
                                    memory.len()).filter(|_|
                                    capacity <=
                                        mb::MAX_PAYLOAD_BYTES) else {
                                return Ok(Some(Value::I32(3)));
                            };
                        let Some(length) =
                            range(i32arg(args, 3), 4,
                                memory.len()) else { return Ok(Some(Value::I32(3))); };
                        if overlap(&output, &length) {
                            return Ok(Some(Value::I32(3)));
                        }
                        self.shared.mailbox.guest_poll(i64arg(args, 0), memory,
                                output, length, &mut budget)?
                    }
                    _ => {
                        return Err(Error::new("unsupported",
                                    "unknown capability import", Some(caller), offset))
                    }
                };
            Ok(Some(Value::I32(status as i32)))
        }
    }
    fn i32arg(args: &[Value], index: usize) -> u32 {
        match args[index] {
            Value::I32(n) => n as u32,
            _ => {
                ::core::panicking::panic_fmt(format_args!("internal error: entered unreachable code: {0}",
                        format_args!("validated capability i32")));
            }
        }
    }
    fn i64arg(args: &[Value], index: usize) -> u64 {
        match args[index] {
            Value::I64(n) => n as u64,
            _ => {
                ::core::panicking::panic_fmt(format_args!("internal error: entered unreachable code: {0}",
                        format_args!("validated capability i64")));
            }
        }
    }
    fn range(start: u32, len: usize, total: usize)
        -> Option<std::ops::Range<usize>> {
        let start = start as usize;
        let end = start.checked_add(len).filter(|n| *n <= total)?;
        Some(start..end)
    }
    fn overlap(a: &std::ops::Range<usize>, b: &std::ops::Range<usize>)
        -> bool {
        !a.is_empty() && !b.is_empty() && a.start < b.end && b.start < a.end
    }
    pub(crate) struct GuestBudget<'a> {
        fuel: &'a mut u64,
        imports: &'a GuestImports<'a>,
        caller: u32,
        offset: usize,
    }
    impl GuestBudget<'_> {
        pub(crate) fn charge(&mut self, bytes: usize) -> Result<(), Error> {
            self.imports.check(self.caller, self.offset)?;
            let extra = bytes.div_ceil(64) as u64;
            if *self.fuel < extra {
                *self.fuel = 0;
                return Err(Error::new("fuel_exhausted",
                            "capability byte fuel exhausted before mutation",
                            Some(self.caller), self.offset));
            }
            *self.fuel -= extra;
            Ok(())
        }
        pub(crate) fn trap(&self, e: mb::Error) -> Error {
            mailbox_trap(e, Some(self.caller), self.offset)
        }
        pub(crate) fn status(&self, e: mb::Error) -> Result<u32, Error> {
            Ok(match e {
                    mb::Error::InvalidArguments => 3,
                    mb::Error::StaleRequest => 4,
                    mb::Error::QuotaExceeded => 5,
                    mb::Error::SessionClosed => 6,
                    mb::Error::AlreadyTerminal => 7,
                    _ => return Err(self.trap(e)),
                })
        }
    }
}
