                start: ::core::default::Default::default(),
                end: ::core::default::Default::default(),
            }
        }
    }
    #[automatically_derived]
    impl ::core::marker::StructuralPartialEq for Span { }
    #[automatically_derived]
    impl ::core::cmp::PartialEq for Span {
        #[inline]
        fn eq(&self, other: &Span) -> bool {
            self.start == other.start && self.end == other.end
        }
    }
    #[automatically_derived]
    impl ::core::cmp::Eq for Span {
        #[inline]
        #[doc(hidden)]
        #[coverage(off)]
        fn assert_fields_are_eq(&self) {
            let _: ::core::cmp::AssertParamIsEq<usize>;
        }
    }
    impl Span {
        fn len(self) -> usize { self.end - self.start }
        fn overlaps(self, other: Self) -> bool {
            self.start < other.end && other.start < self.end &&
                    self.len() != 0 && other.len() != 0
        }
    }
    enum Fault { Errno(Errno), Terminal(WasiFailure), }
    impl From<Errno> for Fault {
        fn from(e: Errno) -> Self { Self::Errno(e) }
    }
    impl From<WasiFailure> for Fault {
        fn from(e: WasiFailure) -> Self { Self::Terminal(e) }
    }
    type CallResult = Result<(), Fault>;
    pub struct WasiContext {
        grants: WasiGrants,
        budget: WasiBudget,
        cancellation: Cancellation,
        deadline: Instant,
        terminal: Option<WasiOutcome>,
        usage: WasiUsage,
        scratch: Vec<u8>,
        rollback: Vec<u8>,
        stdout: Vec<u8>,
        stderr: Vec<u8>,
        stdout_len: usize,
        stderr_len: usize,
        stdout_open: bool,
        stderr_open: bool,
        iovec_scratch: [Span; 64],
    }
    impl WasiContext {
        pub fn new(grants: WasiGrants, budget: WasiBudget,
            cancellation: Cancellation) -> Result<Self, WasiFailure> {
            budget.check()?;
            let deadline =
                Instant::now().checked_add(Duration::from_millis(budget.deadline_ms)).ok_or(WasiFailure::InvalidBudget)?;
            fn buffer(len: usize) -> Result<Vec<u8>, WasiFailure> {
                let mut bytes = Vec::new();
                bytes.try_reserve_exact(len).map_err(|_|
                            WasiFailure::Allocation)?;
                Ok(bytes)
            }
            let scratch = buffer(budget.one_transfer_bytes as usize)?;
            let rollback = buffer(budget.one_transfer_bytes as usize)?;
            let stdout = buffer(budget.log_bytes as usize)?;
            let stderr = buffer(budget.log_bytes as usize)?;
            let mut reservations =
                WasiReservations {
                    fixed_state_bytes: std::mem::size_of::<Self>() as u64,
                    staging_bytes: scratch.capacity() as u64,
                    rollback_bytes: rollback.capacity() as u64,
                    stdout_bytes: stdout.capacity() as u64,
                    stderr_bytes: stderr.capacity() as u64,
                    ..WasiReservations::default()
                };
            reservations.current_bytes =
                reservations.fixed_state_bytes.checked_add(reservations.staging_bytes).and_then(|n|
                                        n.checked_add(reservations.rollback_bytes)).and_then(|n|
                                    n.checked_add(reservations.stdout_bytes)).and_then(|n|
                                n.checked_add(reservations.stderr_bytes)).ok_or(WasiFailure::Invariant)?;
            reservations.peak_bytes = reservations.current_bytes;
            Ok(Self {
                    grants,
                    budget,
                    cancellation,
                    deadline,
                    terminal: None,
                    usage: WasiUsage { reservations, ..WasiUsage::default() },
                    scratch,
                    rollback,
                    stdout,
                    stderr,
                    stdout_len: 0,
                    stderr_len: 0,
                    stdout_open: grants.stdout,
                    stderr_open: grants.stderr,
                    iovec_scratch: [Span::default(); 64],
                })
        }
        pub fn usage(&self) -> WasiUsage { self.usage }
        pub fn stdout(&self) -> &[u8] { &self.stdout[..self.stdout_len] }
        pub fn stderr(&self) -> &[u8] { &self.stderr[..self.stderr_len] }
        pub fn terminal(&self) -> Option<WasiOutcome> { self.terminal }
        fn check(&self) -> Result<(), WasiFailure> {
            if self.cancellation.is_cancelled() {
                return Err(WasiFailure::Cancelled);
            }
            if Instant::now() >= self.deadline {
                return Err(WasiFailure::Deadline);
            }
            Ok(())
        }
        fn work(&mut self, amount: u64) -> CallResult {
            let next =
                self.usage.work.checked_add(amount).ok_or(WasiFailure::Invariant)?;
            if next > self.budget.work {
                return Err(WasiFailure::Budget(Resource::Work).into());
            }
            self.usage.work = next;
            Ok(())
        }
        fn transfer(&mut self, amount: usize) -> CallResult {
            if amount > self.budget.one_transfer_bytes as usize {
                return Err(WasiFailure::Budget(Resource::TransferSize).into());
            }
            let next =
                self.usage.transfer_bytes.checked_add(amount as
                                u64).ok_or(WasiFailure::Invariant)?;
            if next > self.budget.transfer_bytes {
                return Err(WasiFailure::Budget(Resource::Transfer).into());
            }
            self.work((amount as
                                        u64).checked_mul(8).ok_or(WasiFailure::Invariant)?)?;
            self.usage.transfer_bytes = next;
            while self.scratch.len() < amount || self.rollback.len() < amount
                {
                self.check()?;
                if self.scratch.len() < amount {
                    self.scratch.resize((self.scratch.len() +
                                    CHUNK).min(amount), 0);
                }
                if self.rollback.len() < amount {
                    self.rollback.resize((self.rollback.len() +
                                    CHUNK).min(amount), 0);
                }
            }
            Ok(())
        }
        fn span(&mut self, memory: &[u8], pointer: u32, length: u32)
            -> Result<Span, Fault> {
            self.work(1)?;
            let end =
                (pointer as
                                    u64).checked_add(length as u64).ok_or(Errno::Fault)?;
            if end > 1u64 << 32 || end > memory.len() as u64 {
                return Err(Errno::Fault.into());
            }
            Ok(Span { start: pointer as usize, end: end as usize })
        }
        fn fd(&self, fd: u32) -> Result<(), Fault> {
            if (fd == 1 && self.stdout_open) || (fd == 2 && self.stderr_open)
                {
                Ok(())
            } else { Err(Errno::Badf.into()) }
        }
        /// Copies staged bytes to up to two disjoint output spans. Backup occurs before
        /// mutation. Bounded commit checks can fail; rollback requires no remaining budget.
        fn commit(&mut self, memory: &mut [u8], outputs: &[Span])
            -> CallResult {
            let mut offset = 0;
            for span in outputs {
                for chunk in (0..span.len()).step_by(CHUNK) {
                    self.check()?;
                    let end = (chunk + CHUNK).min(span.len());
                    self.rollback[offset +
                                    chunk..offset +
                                    end].copy_from_slice(&memory[span.start +
                                        chunk..span.start + end]);
                }
                offset += span.len();
            }
            let mut failure = None;
            offset = 0;
            'write:
                for span in outputs {
                for chunk in (0..span.len()).step_by(CHUNK) {
                    if let Err(error) = self.check() {
                        failure = Some(error);
                        break 'write;
                    }
                    let end = (chunk + CHUNK).min(span.len());
                    memory[span.start +
                                    chunk..span.start +
                                    end].copy_from_slice(&self.scratch[offset +
                                        chunk..offset + end]);
                }
                offset += span.len();
            }
            if failure.is_none() { failure = self.check().err(); }
            if let Some(error) = failure {
                offset = 0;
                for span in outputs {
                    memory[span.start..span.end].copy_from_slice(&self.rollback[offset..offset
                                        + span.len()]);
                    offset += span.len();
                }
                return Err(error.into());
            }
            Ok(())
        }
        pub fn dispatch(&mut self, function: WasiFunction,
            arguments: &[Value], memory: &mut [u8]) -> WasiOutcome {
            if let Some(outcome) = self.terminal { return outcome; }
            let result = self.invoke(function, arguments, memory);
            let outcome =
                match result {
                    Ok(()) => WasiOutcome::Errno(Errno::Success),
                    Err(Fault::Errno(errno)) => WasiOutcome::Errno(errno),
                    Err(Fault::Terminal(error)) => WasiOutcome::Failure(error),
                };
            if #[allow(non_exhaustive_omitted_patterns)] match outcome {
                    WasiOutcome::Failure(_) => true,
                    _ => false,
                } {
                self.terminal = Some(outcome);
            }
            if outcome != WasiOutcome::Errno(Errno::Success) {
                self.usage.failures += 1;
            }
            self.terminal.unwrap_or(outcome)
        }
        fn invoke(&mut self, function: WasiFunction, args: &[Value],
            memory: &mut [u8]) -> CallResult {
            if args.len() != function.parameters().len() ||
                    args.iter().zip(function.parameters()).any(|(v, t)|
                            v.ty() != *t) {
                return Err(WasiFailure::InvalidArguments.into());
            }
            if self.usage.calls == self.budget.calls {
                return Err(WasiFailure::Budget(Resource::Calls).into());
            }
            self.usage.calls += 1;
            self.work(args.len() as u64 + 1)?;
            self.check()?;
            if memory.len() as u64 > 1u64 << 32 {
                return Err(WasiFailure::InvalidMemory.into());
            }
            let u =
                |i: usize|
                    match args[i] { Value::I32(n) => n as u32, _ => 0, };
            use WasiFunction::*;
            match function {
                ArgsGet => {
                    let pointers = self.span(memory, u(0), 4)?;
                    let text = self.span(memory, u(1), 6)?;
                    if pointers.overlaps(text) {
                        return Err(Errno::Inval.into());
                    }
                    self.transfer(10)?;
                    self.scratch[..4].copy_from_slice(&u(1).to_le_bytes());
                    self.scratch[4..10].copy_from_slice(b"mixer\0");
                    self.commit(memory, &[pointers, text])
                }
                ArgsSizesGet | EnvironSizesGet => {
                    let count = self.span(memory, u(0), 4)?;
                    let bytes = self.span(memory, u(1), 4)?;
                    if count.overlaps(bytes) {
                        return Err(Errno::Inval.into());
                    }
                    self.transfer(8)?;
                    let (n, b) =
                        if function == ArgsSizesGet {
                            (1u32, 6u32)
                        } else { (0, 0) };
                    self.scratch[..4].copy_from_slice(&n.to_le_bytes());
                    self.scratch[4..8].copy_from_slice(&b.to_le_bytes());
                    self.commit(memory, &[count, bytes])
                }
                EnvironGet => {
                    self.span(memory, u(0), 0)?;
                    self.span(memory, u(1), 0)?;
                    self.check()?;
                    Ok(())
                }
                RandomGet => self.random(memory, u(0), u(1)),
                ClockResGet | ClockTimeGet =>
                    self.clock(memory, u(0),
                        u(if function == ClockResGet { 1 } else { 2 }),
                        function == ClockResGet),
                FdClose => {
                    self.fd(u(0))?;
                    self.check()?;
                    if u(0) == 1 {
                        self.stdout_open = false;
                    } else { self.stderr_open = false; }
                    Ok(())
                }
                FdFdstatGet => {
                    self.fd(u(0))?;
                    let output = self.span(memory, u(1), 24)?;
                    self.transfer(24)?;
                    self.scratch[..24].fill(0);
                    self.scratch[8..16].copy_from_slice(&64u64.to_le_bytes());
                    self.commit(memory, &[output])
                }
                FdWrite => self.write(memory, u(0), u(1), u(2), u(3)),
                FdFdstatSetFlags | FdFilestatGet | FdFilestatSetSize |
                    FdFilestatSetTimes | FdPread | FdRead | FdReaddir | FdSeek |
                    FdSync | FdTell => {
                    self.fd(u(0))?;
                    Err(Errno::Notcapable.into())
                }
                FdPrestatGet | FdPrestatDirName | PathCreateDirectory |
                    PathFilestatGet | PathFilestatSetTimes | PathLink | PathOpen
                    | PathReadlink | PathRemoveDirectory | PathRename |
                    PathSymlink | PathUnlinkFile => Err(Errno::Badf.into()),
                PollOneoff => Err(Errno::Notsup.into()),
                ProcExit => {
                    self.terminal = Some(WasiOutcome::Exit(u(0)));
                    self.usage.failures += 1;
                    Ok(())
                }
            }
        }
        fn random(&mut self, memory: &mut [u8], pointer: u32, length: u32)
            -> CallResult {
            if !self.grants.secure_random {
                return Err(Errno::Notcapable.into());
            }
            let output = self.span(memory, pointer, length)?;
            self.transfer(output.len())?;
            for start in (0..output.len()).step_by(CHUNK) {
                self.check()?;
                let end = (start + CHUNK).min(output.len());
                let result = platform::random(&mut self.scratch[start..end]);
                result?;
                self.usage.random_bytes += (end - start) as u64;
                self.check()?;
            }
            self.check()?;
            self.commit(memory, &[output])
        }
        fn clock(&mut self, memory: &mut [u8], id: u32, pointer: u32,
            resolution: bool) -> CallResult {
            let clock =
                match id {
                    0 if self.grants.realtime => platform::Clock::Realtime,
                    1 if self.grants.monotonic => platform::Clock::Monotonic,
                    0..=3 => return Err(Errno::Notcapable.into()),
                    _ => return Err(Errno::Inval.into()),
                };
            let output = self.span(memory, pointer, 8)?;
            self.transfer(8)?;
            self.check()?;
            let result = platform::clock(clock, resolution);
            let value = result?;
            self.check()?;
            self.scratch[..8].copy_from_slice(&value.to_le_bytes());
            self.commit(memory, &[output])
        }
        fn write(&mut self, memory: &mut [u8], fd: u32, pointer: u32,
            count: u32, written: u32) -> CallResult {
            self.fd(fd)?;
            if count > self.budget.iovecs {
                return Err(WasiFailure::Budget(Resource::Iovecs).into());
            }
            let metadata =
                self.span(memory, pointer,
                        count.checked_mul(8).ok_or(Errno::Fault)?)?;
            let output = self.span(memory, written, 4)?;
            if output.overlaps(metadata) { return Err(Errno::Inval.into()); }
            self.work(count as u64 * 8)?;
            let mut total = 0usize;
            for index in 0..count as usize {
                self.check()?;
                let position = metadata.start + index * 8;
                let p =
                    u32::from_le_bytes(memory[position..position +
                                                4].try_into().map_err(|_| WasiFailure::Invariant)?);
                let n =
                    u32::from_le_bytes(memory[position +
                                                4..position +
                                                8].try_into().map_err(|_| WasiFailure::Invariant)?);
                let span = self.span(memory, p, n)?;
                if output.overlaps(span) { return Err(Errno::Inval.into()); }
                total = total.checked_add(span.len()).ok_or(Errno::Overflow)?;
                self.iovec_scratch[index] = span;
            }
            self.transfer(total)?;
            self.transfer(4)?;
            let combined =
                self.stdout_len.checked_add(self.stderr_len).and_then(|n|
                                n.checked_add(total)).ok_or(WasiFailure::Invariant)?;
            if combined > self.budget.log_bytes as usize {
                return Err(Errno::Nospc.into());
            }
            let mut offset = 0;
            for index in 0..count as usize {
                let span = self.iovec_scratch[index];
                for start in (0..span.len()).step_by(CHUNK) {
                    self.check()?;
                    let end = (start + CHUNK).min(span.len());
                    self.scratch[offset +
                                    start..offset +
                                    end].copy_from_slice(&memory[span.start +
                                        start..span.start + end]);
                }
                offset += span.len();
            }
            let old_len =
                if fd == 1 { self.stdout_len } else { self.stderr_len };
            for start in (0..total).step_by(CHUNK) {
                self.check()?;
                let end = (start + CHUNK).min(total);
                let sink =
                    if fd == 1 { &mut self.stdout } else { &mut self.stderr };
                if sink.len() < old_len + end {
                    sink.resize(old_len + end, 0);
                }
                sink[old_len +
                                start..old_len +
                                end].copy_from_slice(&self.scratch[start..end]);
            }
            self.check()?;
            memory[output.start..output.end].copy_from_slice(&(total as
                                u32).to_le_bytes());
            if fd == 1 {
                self.stdout_len += total;
            } else { self.stderr_len += total; }
            self.usage.log_bytes += total as u64;
            Ok(())
        }
    }
}
mod ffi {
    //! C ABI safety boundary. Callers own input buffers for the duration of each call.
    //! Only pointer-to-slice conversion and unaligned fixed-struct transfers are unsafe.
    use crate::*;
    use std::{
        panic::{catch_unwind, AssertUnwindSafe},
        slice,
    };
    pub const MIXER_VM_ABI_VERSION: u32 = 1;
    #[repr(C)]
    pub struct MixerVmLimits {
        pub struct_size: u32,
        pub abi_version: u32,
        pub fuel: u64,
        pub memory_pages: u32,
        pub operand_stack: u32,
        pub call_depth: u32,
        pub host_calls: u32,
    }
    #[automatically_derived]
    #[doc(hidden)]
    unsafe impl ::core::clone::TrivialClone for MixerVmLimits { }
    #[automatically_derived]
    impl ::core::clone::Clone for MixerVmLimits {
        #[inline]
        fn clone(&self) -> MixerVmLimits {
            let _: ::core::clone::AssertParamIsClone<u32>;
            let _: ::core::clone::AssertParamIsClone<u64>;
            *self
        }
    }
    #[automatically_derived]
    impl ::core::marker::Copy for MixerVmLimits { }
    #[repr(C)]
    pub struct MixerVmValue {
        pub value_type: u32,
        pub reserved: u32,
        pub value: i64,
    }
    #[automatically_derived]
    #[doc(hidden)]
    unsafe impl ::core::clone::TrivialClone for MixerVmValue { }
    #[automatically_derived]
    impl ::core::clone::Clone for MixerVmValue {
        #[inline]
        fn clone(&self) -> MixerVmValue {
            let _: ::core::clone::AssertParamIsClone<u32>;
            let _: ::core::clone::AssertParamIsClone<i64>;
            *self
        }
    }
    #[automatically_derived]
    impl ::core::marker::Copy for MixerVmValue { }
    #[repr(C)]
    pub struct MixerVmReport {
        pub abi_version: u32,
        pub status: u32,
        pub value_type: u32,
        pub reserved: u32,
        pub value: i64,
        pub fuel_used: u64,
        pub host_calls_used: u64,
        pub function: u32,
        pub offset: u32,
        pub code: [u8; 48],
        pub message: [u8; 256],
    }
    #[automatically_derived]
    #[doc(hidden)]
    unsafe impl ::core::clone::TrivialClone for MixerVmReport { }
    #[automatically_derived]
    impl ::core::clone::Clone for MixerVmReport {
        #[inline]
        fn clone(&self) -> MixerVmReport {
            let _: ::core::clone::AssertParamIsClone<u32>;
            let _: ::core::clone::AssertParamIsClone<i64>;
            let _: ::core::clone::AssertParamIsClone<u64>;
            let _: ::core::clone::AssertParamIsClone<[u8; 48]>;
            let _: ::core::clone::AssertParamIsClone<[u8; 256]>;
            *self
        }
    }
    #[automatically_derived]
    impl ::core::marker::Copy for MixerVmReport { }
    impl Default for MixerVmReport {
        fn default() -> Self {
            Self {
                abi_version: 1,
                status: 0,
                value_type: 0,
                reserved: 0,
                value: 0,
                fuel_used: 0,
                host_calls_used: 0,
                function: u32::MAX,
                offset: 0,
                code: [0; 48],
                message: [0; 256],
            }
        }
    }
    fn copy_text<const N : usize>(out: &mut [u8; N], text: &str) {
        let n = text.len().min(N - 1);
        out[..n].copy_from_slice(&text.as_bytes()[..n]);
    }
    pub(crate) fn report_error(e: Error, status: u32) -> MixerVmReport {
        let mut r =
            MixerVmReport {
                status,
                function: e.function.unwrap_or(u32::MAX),
                offset: e.offset.min(u32::MAX as usize) as u32,
                ..Default::default()
            };
        copy_text(&mut r.code, e.code);
        copy_text(&mut r.message, &e.message);
        r
    }
    pub(crate) fn arg(m: &str) -> Error {
        Error::new("invalid_arguments", m, None, 0)
    }
    pub(crate) unsafe fn limits_from(p: *const MixerVmLimits)
        -> Result<Limits, Error> {
        let mut l = Limits::default();
        if !p.is_null() {
            let c = unsafe { p.read_unaligned() };
            if c.struct_size as usize != std::mem::size_of::<MixerVmLimits>()
                    || c.abi_version != 1 {
                return Err(arg("invalid limits struct size or ABI version"));
            }
            l.fuel = c.fuel;
            l.memory_pages = c.memory_pages;
            l.operand_stack = c.operand_stack as usize;
            l.call_depth = c.call_depth as usize;
            l.host_calls = c.host_calls as u64;
        }
        l.check()?;
        Ok(l)
    }
    pub(crate) unsafe fn bytes<'a>(p: *const u8, n: usize, max: usize)
        -> Result<&'a [u8], Error> {
        if n > max || n > isize::MAX as usize {
            return Err(arg("input length exceeds profile"));
        }
        if n == 0 { return Ok(&[]); }
        if p.is_null() {
            return Err(arg("null pointer with nonzero input length"));
        }
        Ok(unsafe { slice::from_raw_parts(p, n) })
    }
    pub(crate) unsafe fn boundary<F: FnOnce()
        ->
            Result<MixerVmReport,
            (Error, u32)>>(out: *mut MixerVmReport, body: F) -> u32 {
        if out.is_null() { return 3; }
        let report =
            match catch_unwind(AssertUnwindSafe(body)) {
                Ok(Ok(r)) => r,
                Ok(Err((e, s))) => report_error(e, s),
                Err(_) =>
                    report_error(Error::new("internal_panic",
                            "VM panic contained at C ABI boundary", None, 0), 4),
            };
        let status = report.status;
        unsafe { out.write_unaligned(report) };
        status
    }
    pub(crate) unsafe fn arguments(profile: Profile, max: usize,
        args: *const MixerVmValue, args_len: usize)
        -> Result<Vec<Value>, Error> {
        if args_len > max || args_len > 0 && args.is_null() {
            return Err(arg("invalid argument buffer"));
        }
        let mut values = ::alloc::vec::Vec::new();
        for i in 0..args_len {
            let a = unsafe { args.add(i).read_unaligned() };
            if a.reserved != 0 {
                return Err(arg("argument reserved field must be zero"));
            }
            values.push(match a.value_type {
                    1 if i32::try_from(a.value).is_ok() =>
                        Value::I32(a.value as i32),
                    2 => Value::I64(a.value),
                    3 if profile.floats() && u32::try_from(a.value).is_ok() =>
                        Value::F32(a.value as u32),
                    4 if profile.floats() => Value::F64(a.value as u64),
                    _ => return Err(arg("invalid argument type or i32 range")),
                });
        }
        Ok(values)
    }
    /// Validate without instantiating or executing. See include/mixer_vm.h for pointer contract.
    ///
    /// # Safety
    /// All non-null pointers must reference valid readable/writable buffers of the documented size.
    unsafe fn validate_profile(profile: Profile, data: *const u8, len: usize,
        limits: *const MixerVmLimits, out: *mut MixerVmReport) -> u32 {
        unsafe {
            boundary(out,
                ||
                    {
                        let mut l = limits_from(limits).map_err(|e| (e, 3))?;
                        l.profile = profile;
                        let b =
                            bytes(data, len, l.module_bytes).map_err(|e| (e, 3))?;
                        Module::decode(b, &l).map_err(|e| (e, 1))?;
                        Ok(MixerVmReport::default())
                    })
        }
    }
    /// Decode, validate, instantiate, and invoke one export. Instances do not persist across C calls.
    ///
    /// # Safety
    /// All non-null pointers must reference valid readable/writable buffers of the documented size.
    #[allow(clippy::too_many_arguments)]
    unsafe fn invoke_profile(profile: Profile, data: *const u8, len: usize,
        export: *const u8, export_len: usize, args: *const MixerVmValue,
        args_len: usize, limits: *const MixerVmLimits,
        out: *mut MixerVmReport) -> u32 {
        unsafe {
            boundary(out,
                ||
                    {
                        let mut l = limits_from(limits).map_err(|e| (e, 3))?;
                        l.profile = profile;
                        let b =
                            bytes(data, len, l.module_bytes).map_err(|e| (e, 3))?;
                        let n =
                            bytes(export, export_len, 4096).map_err(|e| (e, 3))?;
                        let name =
                            std::str::from_utf8(n).map_err(|_|
                                        (arg("export name is not UTF-8"), 3))?;
                        let values =
                            arguments(profile, l.locals, args,
                                        args_len).map_err(|e| (e, 3))?;
                        let module = Module::decode(b, &l).map_err(|e| (e, 1))?;
                        let mut instance =
                            Instance::new(module, l.clone()).map_err(|e| (e, 2))?;
                        match instance.invoke(name, &values) {
                            Ok(value) => {
                                let mut r =
                                    MixerVmReport {
                                        fuel_used: l.fuel - instance.fuel_remaining,
                                        host_calls_used: instance.host_calls_used,
                                        ..Default::default()
                                    };
                                if let Some(value) = value {
                                    match value {
                                        Value::I32(v) => { r.value_type = 1; r.value = v as i64; }
                                        Value::I64(v) => { r.value_type = 2; r.value = v; }
                                        Value::F32(v) => { r.value_type = 3; r.value = v as i64; }
                                        Value::F64(v) => { r.value_type = 4; r.value = v as i64; }
                                    }
                                }
                                Ok(r)
                            }
                            Err(e) => {
                                let mut r = report_error(e, 2);
                                r.fuel_used = l.fuel - instance.fuel_remaining;
                                r.host_calls_used = instance.host_calls_used;
                                Ok(r)
                            }
                        }
                    })
        }
    }
    /// Validate the stable integer-v1 profile.
    /// # Safety
    /// All pointers obey the buffer contract in mixer_vm.h.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_validate(data: *const u8, len: usize,
        limits: *const MixerVmLimits, out: *mut MixerVmReport) -> u32 {
        unsafe {
            validate_profile(Profile::IntegerV1, data, len, limits, out)
        }
    }
    /// Validate the opt-in numeric-v2 profile.
    /// # Safety
    /// All pointers obey the buffer contract in mixer_vm.h.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_validate_numeric_v2(data: *const u8,
        len: usize, limits: *const MixerVmLimits, out: *mut MixerVmReport)
        -> u32 {
        unsafe {
            validate_profile(Profile::NumericV2, data, len, limits, out)
        }
    }
    /// Invoke with the stable integer-v1 profile.
    /// # Safety
    /// All pointers obey the buffer contract in mixer_vm.h.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_invoke(data: *const u8, len: usize,
        export: *const u8, export_len: usize, args: *const MixerVmValue,
        args_len: usize, limits: *const MixerVmLimits,
        out: *mut MixerVmReport) -> u32 {
        unsafe {
            invoke_profile(Profile::IntegerV1, data, len, export, export_len,
                args, args_len, limits, out)
        }
    }
    /// Invoke with the opt-in numeric-v2 profile; type3/4 values carry IEEE bits.
    /// # Safety
    /// All pointers obey the buffer contract in mixer_vm.h.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_invoke_numeric_v2(data: *const u8,
        len: usize, export: *const u8, export_len: usize,
        args: *const MixerVmValue, args_len: usize,
        limits: *const MixerVmLimits, out: *mut MixerVmReport) -> u32 {
        unsafe {
            invoke_profile(Profile::NumericV2, data, len, export, export_len,
                args, args_len, limits, out)
        }
    }
    /// Validate the explicit table-memory-v3 profile with its fixed table ceiling.
    /// # Safety
    /// All pointers obey the unchanged buffer/layout contract in mixer_vm.h.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_validate_table_memory_v3(data:
            *const u8, len: usize, limits: *const MixerVmLimits,
        out: *mut MixerVmReport) -> u32 {
        unsafe {
            validate_profile(Profile::TableMemoryV3, data, len, limits, out)
        }
    }
    /// Invoke table-memory-v3. The legacy limits struct/layout remains unchanged.
    /// # Safety
    /// All pointers obey the unchanged buffer/layout contract in mixer_vm.h.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_invoke_table_memory_v3(data: *const u8,
        len: usize, export: *const u8, export_len: usize,
        args: *const MixerVmValue, args_len: usize,
        limits: *const MixerVmLimits, out: *mut MixerVmReport) -> u32 {
        unsafe {
            invoke_profile(Profile::TableMemoryV3, data, len, export,
                export_len, args, args_len, limits, out)
        }
    }
}
mod float {
    //! Owned numeric-v2 semantics, derived from the WebAssembly numeric definitions.
    //! Values carry IEEE bits; bitwise float instructions never canonicalize NaNs.
    //! Arithmetic, rounding, square root and float-width conversions choose positive
    //! canonical NaNs from the spec's permitted set, independently of host behavior.
    use crate::{Error, Type, Value};
    fn arithmetic_nan32(bits: u32) -> u32 {
        if bits & 0x7fff_ffff > 0x7f80_0000 { 0x7fc0_0000 } else { bits }
    }
    fn arithmetic_nan64(bits: u64) -> u64 {
        if bits & 0x7fff_ffff_ffff_ffff > 0x7ff0_0000_0000_0000 {
            0x7ff8_0000_0000_0000
        } else { bits }
    }
    pub(crate) fn shape(op: u8) -> Option<(Type, usize, Type)> {
        use Type::*;
        Some(match op {
                0x5b..=0x60 => (F32, 2, I32),
                0x61..=0x66 => (F64, 2, I32),
                0x8b..=0x91 => (F32, 1, F32),
                0x92..=0x98 => (F32, 2, F32),
                0x99..=0x9f => (F64, 1, F64),
                0xa0..=0xa6 => (F64, 2, F64),
                0xa8 | 0xa9 => (F32, 1, I32),
                0xaa | 0xab => (F64, 1, I32),
                0xae | 0xaf => (F32, 1, I64),
                0xb0 | 0xb1 => (F64, 1, I64),
                0xb2 | 0xb3 => (I32, 1, F32),
                0xb4 | 0xb5 => (I64, 1, F32),
                0xb6 => (F64, 1, F32),
                0xb7 | 0xb8 => (I32, 1, F64),
                0xb9 | 0xba => (I64, 1, F64),
                0xbb => (F32, 1, F64),
                0xbc => (F32, 1, I32),
                0xbd => (F64, 1, I64),
                0xbe => (I32, 1, F32),
                0xbf => (I64, 1, F64),
                _ => return None,
            })
    }
    pub(crate) fn saturating_shape(sub: u8) -> (Type, Type) {
        (if sub % 4 < 2 { Type::F32 } else { Type::F64 },
            if sub < 4 { Type::I32 } else { Type::I64 })
    }
    fn pop32(s: &mut Vec<Value>) -> u32 {
        match s.pop().unwrap() {
            Value::F32(b) => b,
            _ => {
                ::core::panicking::panic_fmt(format_args!("internal error: entered unreachable code: {0}",
                        format_args!("validated f32")));
            }
        }
    }
    fn pop64(s: &mut Vec<Value>) -> u64 {
        match s.pop().unwrap() {
            Value::F64(b) => b,
            _ => {
                ::core::panicking::panic_fmt(format_args!("internal error: entered unreachable code: {0}",
                        format_args!("validated f64")));
            }
        }
    }
    fn integer(s: &mut Vec<Value>) -> Value { s.pop().unwrap() }
    fn truncated(x: f64, bits: u32, signed: bool, saturating: bool)
        -> Result<Value, &'static str> {
        if x.is_nan() {
            return if saturating {
                    Ok(if bits == 32 { Value::I32(0) } else { Value::I64(0) })
                } else { Err("invalid_conversion_to_integer") };
        }
        let n = x.trunc();
        let value =
            match (bits, signed) {
                (32, true) => {
                    if !saturating &&
                            (!(-2147483648.0..2147483648.0).contains(&n)) {
                        return Err("integer_overflow");
                    }
                    Value::I32(n as i32)
                }
                (32, false) => {
                    if !saturating && (!(0.0..4294967296.0).contains(&n)) {
                        return Err("integer_overflow");
                    }
                    Value::I32(n as u32 as i32)
                }
                (64, true) => {
                    if !saturating &&
                            (!(-9223372036854775808.0..9223372036854775808.0).contains(&n))
                        {
                        return Err("integer_overflow");
                    }
                    Value::I64(n as i64)
                }
                (64, false) => {
                    if !saturating &&
                            (!(0.0..18446744073709551616.0).contains(&n)) {
                        return Err("integer_overflow");
                    }
                    Value::I64(n as u64 as i64)
                }
                _ =>
                    ::core::panicking::panic("internal error: entered unreachable code"),
            };
        Ok(value)
    }
    pub(crate) fn saturating(sub: u8, s: &mut Vec<Value>) {
        let (input, output) = saturating_shape(sub);
        let x =
            if input == Type::F32 {
                f32::from_bits(pop32(s)) as f64
            } else { f64::from_bits(pop64(s)) };
        s.push(truncated(x, if output == Type::I32 { 32 } else { 64 },
                    sub.is_multiple_of(2), true).unwrap());
    }
    pub(crate) fn numeric(op: u8, s: &mut Vec<Value>)
        -> Result<(), &'static str> {
        use Value::*;
        match op {
            0x5b..=0x60 => {
                let b = f32::from_bits(pop32(s));
                let a = f32::from_bits(pop32(s));
                s.push(I32(match op {
                                0x5b => a == b,
                                0x5c => a != b,
                                0x5d => a < b,
                                0x5e => a > b,
                                0x5f => a <= b,
                                _ => a >= b,
                            } as i32));
            }
            0x61..=0x66 => {
                let b = f64::from_bits(pop64(s));
                let a = f64::from_bits(pop64(s));
                s.push(I32(match op {
                                0x61 => a == b,
                                0x62 => a != b,
                                0x63 => a < b,
                                0x64 => a > b,
                                0x65 => a <= b,
                                _ => a >= b,
                            } as i32));
            }
            0x8b..=0x98 => {
                let b = if op >= 0x92 { pop32(s) } else { 0 };
                let a = pop32(s);
                let x = f32::from_bits(a);
                let y = f32::from_bits(b);
                let bits =
                    match op {
                        0x8b => a & 0x7fff_ffff,
                        0x8c => a ^ 0x8000_0000,
                        0x8d => x.ceil().to_bits(),
                        0x8e => x.floor().to_bits(),
                        0x8f => x.trunc().to_bits(),
                        0x90 => x.round_ties_even().to_bits(),
                        0x91 => x.sqrt().to_bits(),
                        0x92 => (x + y).to_bits(),
                        0x93 => (x - y).to_bits(),
                        0x94 => (x * y).to_bits(),
                        0x95 => (x / y).to_bits(),
                        0x96 => {
                            if x.is_nan() || y.is_nan() {
                                f32::NAN.to_bits()
                            } else if x == 0.0 && y == 0.0 {
                                a | b
                            } else { if x < y { x } else { y }.to_bits() }
                        }
                        0x97 => {
                            if x.is_nan() || y.is_nan() {
                                f32::NAN.to_bits()
                            } else if x == 0.0 && y == 0.0 {
                                a & b
                            } else { if x > y { x } else { y }.to_bits() }
                        }
                        0x98 => (a & 0x7fff_ffff) | (b & 0x8000_0000),
                        _ =>
                            ::core::panicking::panic("internal error: entered unreachable code"),
                    };
                s.push(F32(if (0x8d..=0x97).contains(&op) {
                            arithmetic_nan32(bits)
                        } else { bits }));
            }
            0x99..=0xa6 => {
                let b = if op >= 0xa0 { pop64(s) } else { 0 };
                let a = pop64(s);
                let x = f64::from_bits(a);
                let y = f64::from_bits(b);
                let bits =
                    match op {
                        0x99 => a & 0x7fff_ffff_ffff_ffff,
                        0x9a => a ^ 0x8000_0000_0000_0000,
                        0x9b => x.ceil().to_bits(),
                        0x9c => x.floor().to_bits(),
                        0x9d => x.trunc().to_bits(),
                        0x9e => x.round_ties_even().to_bits(),
                        0x9f => x.sqrt().to_bits(),
                        0xa0 => (x + y).to_bits(),
                        0xa1 => (x - y).to_bits(),
                        0xa2 => (x * y).to_bits(),
                        0xa3 => (x / y).to_bits(),
                        0xa4 => {
                            if x.is_nan() || y.is_nan() {
                                f64::NAN.to_bits()
                            } else if x == 0.0 && y == 0.0 {
                                a | b
                            } else { if x < y { x } else { y }.to_bits() }
                        }
                        0xa5 => {
                            if x.is_nan() || y.is_nan() {
                                f64::NAN.to_bits()
                            } else if x == 0.0 && y == 0.0 {
                                a & b
                            } else { if x > y { x } else { y }.to_bits() }
                        }
                        0xa6 =>
                            (a & 0x7fff_ffff_ffff_ffff) | (b & 0x8000_0000_0000_0000),
                        _ =>
                            ::core::panicking::panic("internal error: entered unreachable code"),
                    };
                s.push(F64(if (0x9b..=0xa5).contains(&op) {
                            arithmetic_nan64(bits)
                        } else { bits }));
            }
            0xa8..=0xab | 0xae..=0xb1 => {
                let (input, _, output) = shape(op).unwrap();
                let x =
                    if input == Type::F32 {
                        f32::from_bits(pop32(s)) as f64
                    } else { f64::from_bits(pop64(s)) };
                s.push(truncated(x, if output == Type::I32 { 32 } else { 64 },
                            op.is_multiple_of(2), false)?);
            }
            0xb2..=0xb5 => {
                let x =
                    match (op, integer(s)) {
                        (0xb2, I32(x)) => x as f32,
                        (0xb3, I32(x)) => x as u32 as f32,
                        (0xb4, I64(x)) => x as f32,
                        (0xb5, I64(x)) => x as u64 as f32,
                        _ =>
                            ::core::panicking::panic("internal error: entered unreachable code"),
                    };
                s.push(F32(x.to_bits()));
            }
            0xb6 => {
                let x = f64::from_bits(pop64(s));
                s.push(F32(arithmetic_nan32((x as f32).to_bits())));
            }
            0xb7..=0xba => {
                let x =
                    match (op, integer(s)) {
                        (0xb7, I32(x)) => x as f64,
                        (0xb8, I32(x)) => x as u32 as f64,
                        (0xb9, I64(x)) => x as f64,
                        (0xba, I64(x)) => x as u64 as f64,
                        _ =>
                            ::core::panicking::panic("internal error: entered unreachable code"),
                    };
                s.push(F64(x.to_bits()));
            }
            0xbb => {
                let x = f32::from_bits(pop32(s));
                s.push(F64(arithmetic_nan64((x as f64).to_bits())));
            }
            0xbc => { let x = pop32(s); s.push(I32(x as i32)); }
            0xbd => { let x = pop64(s); s.push(I64(x as i64)); }
            0xbe => {
                let I32(x) =
                    integer(s) else {
                        ::core::panicking::panic("internal error: entered unreachable code")
                    };
                s.push(F32(x as u32));
            }
            0xbf => {
                let I64(x) =
                    integer(s) else {
                        ::core::panicking::panic("internal error: entered unreachable code")
                    };
                s.push(F64(x as u64));
            }
            _ => {
                ::core::panicking::panic_fmt(format_args!("internal error: entered unreachable code: {0}",
                        format_args!("validated numeric-v2 opcode")));
            }
        }
        Ok(())
    }
    fn control_state_supported() -> bool {
        {
            let control: u64;
            unsafe {
                asm!("mrs {0}, fpcr",
                    out(reg)
                    control,
                    options(nomem, preserves_flags, nostack));
            }
            return control & !0x0200_0000 == 0;
        }

        #[allow(unreachable_code)]
        false
    }
    /// Numeric-v2 requires the platform's default nearest-even IEEE environment.
    /// Reject a changed rounding mode/flush-to-zero environment instead of silently
    /// running Wasm with different arithmetic. No host FP control state is modified; arithmetic probes may set normal
    /// sticky exception flags.
    pub(crate) fn environment() -> Result<(), Error> {
        environment_check().map_err(|message|
                Error::new("unsupported_float_environment", message, None, 0))
    }
    /// Same qualified-host check without allocating a diagnostic String. The owned
    /// span executor can report terminal resource failures without another allocation.
    pub(crate) fn environment_check() -> Result<(), &'static str> {
        {
            unsafe extern "C" {
                fn fegetround()
                -> std::ffi::c_int;
            }
            let nearest = unsafe { fegetround() } == 0;
            if !nearest || !control_state_supported() {
                return Err("numeric-v2 requires masked FP exceptions, nearest-even rounding and gradual underflow");
            }
            let tiny32 =
                std::hint::black_box(f32::from_bits(1)) *
                    std::hint::black_box(1.0f32);
            let tiny64 =
                std::hint::black_box(f64::from_bits(1)) *
                    std::hint::black_box(1.0f64);
            if tiny32.to_bits() == 1 && tiny64.to_bits() == 1 {
                return Ok(());
            }
        }
        Err("numeric-v2 requires nearest-even rounding and gradual underflow on a qualified host")
    }
}
mod inspect {
    //! Non-authorizing structural inventory; accepting an immediate shape here does
    //! not add that opcode to the executable profile. Strict validation is separate.
    use crate::{
        decode::Reader, validation_inventory, Error, Inventory, Limits,
    };
    pub const INVENTORY_BYTES: usize = 128 * 1024 * 1024;
    pub fn inventory(bytes: &[u8], limits: &Limits) -> Inventory {
        let validation = validation_inventory(bytes, limits);
        let mut inv =
            Inventory {
                profile: limits.profile,
                error: validation.error,
                ..Default::default()
            };
        if let Err(e) = scan(bytes, &mut inv) {
            inv.inventory_error = Some(e);
        } else { inv.complete = true; }
        inv
    }
    fn scan(bytes: &[u8], inv: &mut Inventory) -> Result<(), Error> {
        if bytes.len() > INVENTORY_BYTES {
            return Err(Error::new("limit",
                        "inspection byte ceiling is 128MiB", None, 0));
        }
        let mut r = Reader::at(bytes, 0);
        if r.take(8)? != b"\0asm\x01\0\0\0" {
            return Err(r.err("malformed", "expected Wasm version 1"));
        }
        let mut imports = 0u32;
        let mut total = 0usize;
        while r.pos < r.bytes.len() {
            let id = r.byte()?;
            let size = r.u32()? as usize;
            let base = r.offset();
            let data = r.take(size)?;
            let mut s = Reader::at(data, base);
            match id {
                2 => {
                    for _ in 0..s.count(100_000)? {
                        let module = s.name()?;
                        let name = s.name()?;
                        let kind = s.byte()?;
                        if kind != 0 {
                            return Err(s.err("inventory_unsupported",
                                        "inventory only describes function imports"));
                        }
                        let index = s.u32()?;
                        inv.imports.push((module, name, index));
                        imports += 1;
                    }
                    s.end()?;
                }
                7 => {
                    for _ in 0..s.count(100_000)? {
                        let name = s.name()?;
                        let kind = s.byte()?;
                        let index = s.u32()?;
                        inv.exports.push((name, kind, index));
                    }
                    s.end()?;
                }
                10 => {
                    for function in 0..s.count(100_000)? {
                        let size = s.u32()? as usize;
                        let base = s.offset();
                        let data = s.take(size)?;
                        let mut b = Reader::at(data, base);
                        b.function = Some(imports + function as u32);
                        for _ in 0..b.count(100_000)? {
                            b.u32()?;
                            match b.byte()? {
                                0x7f | 0x7e | 0x7d | 0x7c | 0x7b | 0x70 | 0x6f => {}
                                _ => {
                                    return Err(b.err("inventory_unsupported",
                                                "unknown local type encoding"))
                                }
                            }
                        }
                        while b.pos < b.bytes.len() {
                            total += 1;
                            if total > 16_000_000 {
                                return Err(b.err("limit",
                                            "inspection instruction ceiling exceeded"));
                            }
                            let offset = b.offset();
                            let op = b.byte()?;
                            *inv.opcodes.entry(op).or_default() += 1;
                            match op {
                                0x00 | 0x01 | 0x05 | 0x0b | 0x0f | 0x1a | 0x1b | 0x45..=0xc4
                                    | 0xd1 | 0xd3 | 0xd4 => {}
                                0x02..=0x04 => { b.signed(33)?; }
                                0x0c | 0x0d | 0x10 | 0x12 | 0x14 | 0x15 | 0x20..=0x26 | 0xd2
                                    | 0xd5 | 0xd6 => {
                                    b.u32()?;
                                }
                                0x0e => {
                                    for _ in 0..b.count(1_000_000)? { b.u32()?; }
                                    b.u32()?;
                                }
                                0x11 | 0x13 => { b.u32()?; b.u32()?; }
                                0x1c => { for _ in 0..b.count(4096)? { b.byte()?; } }
                                0x28..=0x3e => { b.u32()?; b.u32()?; }
                                0x3f | 0x40 => { b.u32()?; }
                                0x41 => { b.signed(32)?; }
                                0x42 => { b.signed(64)?; }
                                0x43 => { b.take(4)?; }
                                0x44 => { b.take(8)?; }
                                0xd0 => { b.signed(33)?; }
                                0xfc => {
                                    let sub = b.u32()?;
                                    *inv.extended_opcodes.entry(::alloc::__export::must_use({
                                                            ::alloc::fmt::format(format_args!("0xfc:{0}", sub))
                                                        })).or_default() += 1;
                                    match sub {
                                        0..=7 => {}
                                        8 | 10 | 12 | 14 => { b.u32()?; b.u32()?; }
                                        9 | 11 | 13 | 15..=17 => { b.u32()?; }
                                        _ =>
                                            return Err(b.err("inventory_unsupported",
                                                        "unknown 0xfc immediate shape")),
                                    }
                                }
                                _ =>
                                    return Err(Error::new("inventory_unsupported",
                                                ::alloc::__export::must_use({
                                                        ::alloc::fmt::format(format_args!("unknown immediate shape for opcode 0x{0:02x}; inventory is partial",
                                                                op))
                                                    }), b.function, offset)),
                            }
                        }
                    }
                    s.end()?;
                }
                _ => {}
            }
        }
        Ok(())
    }
}
mod session {
    //! Bounded persistent native sessions. Handles carry slot generations, never pointers.
    use crate::{
        ffi::{arg, arguments, boundary, bytes, limits_from, report_error},
        *,
    };
    use std::sync::{
        atomic::{AtomicBool, Ordering},
        Arc, Mutex, MutexGuard, OnceLock, TryLockError,
    };
    const SESSION_CAP: usize = 16;
    const TRANSFER_CAP: usize = 1024 * 1024;
    type Failure = (Error, u32);
    fn failure(code: &'static str, message: &str, status: u32) -> Failure {
        (Error::new(code, message, None, 0), status)
    }
    struct Session {
        instance: Mutex<Instance>,
        limits: Limits,
        cancellation: Cancellation,
        terminal: AtomicBool,
    }
    impl Session {
        fn stop(&self) {
            self.terminal.store(true, Ordering::Release);
