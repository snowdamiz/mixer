            pub(crate) fn allocate<M: DecodeMeter,
                T>(capacity: usize, meter: &mut M)
                -> Result<Vec<T>, M::Failure> {
                meter.check()?;
                let mut values = Vec::new();
                values.try_reserve_exact(capacity).map_err(|_|
                            meter.error(CacheFailureKind::AllocationFailure,
                                "cache_allocation"))?;
                meter.exact_capacity(capacity, values.capacity())?;
                meter.check()?;
