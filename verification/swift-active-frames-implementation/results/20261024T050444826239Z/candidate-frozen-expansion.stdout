                        resource: fault.resource,
                        attempted: fault.attempted,
                        limit: fault.limit,
                        observed_capacity: fault.observed_capacity,
                        deadline_origin: self.deadline_origin,
                        wasi_failure: fault.wasi_failure,
                        guest_exit: fault.guest_exit,
                        at_failure: self.usage(wasi),
                        after_cleanup: None,
                    };
                self.first_failure = Some(failure);
                failure
            }
            fn category_limit(&self, category: SwiftReservationCategory)
                -> usize {
                match category {
                    SwiftReservationCategory::RetainedSource =>
                        self.budget.source_bytes,
                    SwiftReservationCategory::RetainedMetadata =>
                        self.budget.metadata_bytes,
                    SwiftReservationCategory::Cache => self.budget.cache_bytes,
                    SwiftReservationCategory::State => self.budget.state_bytes,
                    SwiftReservationCategory::Wasi |
                        SwiftReservationCategory::Shared |
                        SwiftReservationCategory::Construction =>
                        self.budget.combined_bytes,
                }
            }
            fn preflight_bytes(&mut self, category: SwiftReservationCategory,
                bytes: usize, cursor: Cursor, wasi: Option<WasiUsage>)
                -> Result<(usize, usize), SwiftRunFailure> {
                let category_next =
                    self.reservations.category(category).current.checked_add(bytes);
                let limit = self.category_limit(category);
                if category_next.is_none_or(|n| n > limit) {
                    let kind =
                        if #[allow(non_exhaustive_omitted_patterns)] match category
                                {
                                SwiftReservationCategory::RetainedSource |
                                    SwiftReservationCategory::RetainedMetadata => true,
                                _ => false,
                            } {
                            SwiftRunFailureKind::Adoption
                        } else { SwiftRunFailureKind::CategoryExhausted };
                    return Err(self.fail(cursor,
                                Fault::new(kind,
                                        "swift_run_category_capacity").limit(SwiftRunResource::Reservation(category),
                                    category_next.map_or(u64::MAX, |n| n as u64), limit as u64),
                                wasi));
                }
                let combined_next =
                    self.reservations.combined.current.checked_add(bytes);
                if combined_next.is_none_or(|n|
                            n > self.budget.combined_bytes) {
                    return Err(self.fail(cursor,
                                Fault::new(SwiftRunFailureKind::CombinedExhausted,
                                        "swift_run_combined_capacity").limit(SwiftRunResource::Combined,
                                    combined_next.map_or(u64::MAX, |n| n as u64),
                                    self.budget.combined_bytes as u64), wasi));
                }
                Ok((category_next.unwrap(), combined_next.unwrap()))
            }
            fn commit_bytes(&mut self, category: SwiftReservationCategory,
                category_next: usize, combined_next: usize) {
                let usage = self.reservations.category_mut(category);
                usage.current = category_next;
                usage.peak = usage.peak.max(category_next);
                self.reservations.combined.current = combined_next;
                self.reservations.combined.peak =
                    self.reservations.combined.peak.max(combined_next);
            }
            pub(crate) fn admit(&mut self, category: SwiftReservationCategory,
                bytes: usize, cursor: Cursor)
                -> Result<ReservationTicket, SwiftRunFailure> {
                self.admit_with_wasi(category, bytes, cursor, None)
            }
            pub(crate) fn admit_with_wasi(&mut self,
                category: SwiftReservationCategory, bytes: usize,
                cursor: Cursor, wasi: Option<WasiUsage>)
                -> Result<ReservationTicket, SwiftRunFailure> {
                self.check_with_wasi(cursor, wasi)?;
                if self.reservations.live_tickets >= MAX_RESERVATION_TICKETS {
                    return Err(self.fail(cursor,
                                Fault::new(SwiftRunFailureKind::ResourceExhausted,
                                        "swift_run_ticket_inventory").limit(SwiftRunResource::TicketInventory,
                                    self.reservations.live_tickets as u64 + 1,
                                    MAX_RESERVATION_TICKETS as u64), wasi));
                }
                let (category_next, combined_next) =
                    self.preflight_bytes(category, bytes, cursor, wasi)?;
                self.commit_bytes(category, category_next, combined_next);
                self.reservations.live_tickets += 1;
                self.reservations.peak_tickets =
                    self.reservations.peak_tickets.max(self.reservations.live_tickets);
                Ok(ReservationTicket { owner: self.owner, category, bytes })
            }
            /// Aggregate locals/instructions/targets before allocating the first vector.
            /// This only admits payload bytes; fixed cache/header/scratch are additional.
            pub(crate) fn admit_cache_entry(&mut self, bytes: usize,
                cursor: Cursor)
                -> Result<ReservationTicket, SwiftRunFailure> {
                self.admit_cache_entry_with_wasi(bytes, cursor, None)
            }
            pub(crate) fn admit_cache_entry_with_wasi(&mut self, bytes: usize,
                cursor: Cursor, wasi: Option<WasiUsage>)
                -> Result<ReservationTicket, SwiftRunFailure> {
                self.check_with_wasi(cursor, wasi)?;
                if bytes > self.budget.cache_entry_bytes {
                    return Err(self.fail(cursor,
                                Fault::new(SwiftRunFailureKind::ResourceExhausted,
                                        "swift_run_cache_entry_capacity").limit(SwiftRunResource::CacheEntryBytes,
                                    bytes as u64, self.budget.cache_entry_bytes as u64), wasi));
                }
                self.admit_with_wasi(SwiftReservationCategory::Cache, bytes,
                    cursor, wasi)
            }
            /// Grow the one construction ticket BEFORE entering a larger phase. It is
            /// never replaced by another authoritative construction reservation.
            pub(crate) fn enlarge_construction(&mut self, bytes: usize,
                cursor: Cursor) -> Result<(), SwiftRunFailure> {
                self.enlarge_construction_with_wasi(bytes, cursor, None)
            }
            pub(crate) fn enlarge_construction_with_wasi(&mut self,
                bytes: usize, cursor: Cursor, wasi: Option<WasiUsage>)
                -> Result<(), SwiftRunFailure> {
                self.check_with_wasi(cursor, wasi)?;
                let old =
                    self.construction.as_ref().map(|ticket|
                                    ticket.bytes).ok_or_else(||
                                {
                                    self.fail(cursor,
                                        Fault::new(SwiftRunFailureKind::Invariant,
                                            "swift_run_missing_construction"), wasi)
                                })?;
                if bytes < old {
                    return Err(self.fail(cursor,
                                Fault::new(SwiftRunFailureKind::Invariant,
                                    "swift_run_construction_shrink_before_drop"), wasi));
                }
                let (category_next, combined_next) =
                    self.preflight_bytes(SwiftReservationCategory::Construction,
                            bytes - old, cursor, wasi)?;
                self.commit_bytes(SwiftReservationCategory::Construction,
                    category_next, combined_next);
                self.construction.as_mut().unwrap().bytes = bytes;
                Ok(())
            }
            /// Drop phase-owned temporaries before narrowing their shared scratch bound.
            /// The named foundation envelope remains reserved through closure teardown.
            pub(crate) fn end_construction_phase<T>(&mut self, storage: T,
                bytes: usize) -> Result<(), SwiftRunFailure> {
                self.end_construction_phase_with_wasi(storage, bytes, None)
            }
            pub(crate) fn end_construction_phase_with_wasi<T>(&mut self,
                storage: T, bytes: usize, wasi: Option<WasiUsage>)
                -> Result<(), SwiftRunFailure> {
                drop(storage);
                let Some(ticket) =
                    self.construction.as_ref() else {
                        return Err(self.cleanup_fault_with_wasi(SwiftCleanupInvariant::MissingConstruction,
                                    "swift_run_missing_construction", wasi));
                    };
                if ticket.owner != self.owner ||
                        ticket.category != SwiftReservationCategory::Construction {
                    return Err(self.cleanup_fault_with_wasi(SwiftCleanupInvariant::ReservationOwner,
                                "swift_run_construction_owner", wasi));
                }
                let floor =
                    foundation_construction_bytes().unwrap_or(usize::MAX);
                if bytes < floor || bytes > ticket.bytes {
                    return Err(self.cleanup_fault_with_wasi(SwiftCleanupInvariant::ConstructionBound,
                                "swift_run_construction_phase_bound", wasi));
                }
                let difference = ticket.bytes - bytes;
                let category =
                    self.reservations.construction.current.checked_sub(difference);
                let combined =
                    self.reservations.combined.current.checked_sub(difference);
                let (Some(category), Some(combined)) =
                    (category,
                        combined) else {
                        return Err(self.cleanup_fault_with_wasi(SwiftCleanupInvariant::ReservationUnderflow,
                                    "swift_run_release_underflow", wasi));
                    };
                self.reservations.construction.current = category;
                self.reservations.combined.current = combined;
                self.construction.as_mut().unwrap().bytes = bytes;
                Ok(())
            }
            /// Caller passes the actual storage, including every allocation covered by
            /// an aggregate ticket. Cleanup is cancellation/deadline/work independent.
            pub(crate) fn drop_reserved<T>(&mut self, storage: T,
                ticket: ReservationTicket) -> Result<(), SwiftRunFailure> {
                self.drop_reserved_with_wasi(storage, ticket, None)
            }
            /// The caller captures the actual context observation before destroying
            /// its owned storage. Cleanup may itself originate the first invariant fault.
            pub(crate) fn drop_reserved_with_wasi<T>(&mut self, storage: T,
                ticket: ReservationTicket, wasi: Option<WasiUsage>)
                -> Result<(), SwiftRunFailure> {
                drop(storage);
                self.refund_with_wasi(ticket, wasi)
            }
            pub(crate) fn drop_proof(&mut self, adopted: AdoptedProof)
                -> Result<(), SwiftRunFailure> {
                self.drop_proof_with_wasi(adopted, None)
            }
            pub(crate) fn drop_proof_with_wasi(&mut self,
                adopted: AdoptedProof, wasi: Option<WasiUsage>)
                -> Result<(), SwiftRunFailure> {
                let AdoptedProof { proof, source, metadata } = adopted;
                drop(proof);
                let source_result = self.refund_with_wasi(source, wasi);
                let metadata_result = self.refund_with_wasi(metadata, wasi);
                source_result.and(metadata_result)
            }
            /// Check an internal component/control pairing before it can perform work.
            /// This borrows its sealed ticket and neither admits nor refunds storage.
            pub(crate) fn check_adopted_owner(&mut self,
                adopted: &AdoptedProof, cursor: Cursor,
                wasi: Option<WasiUsage>) -> Result<(), SwiftRunFailure> {
                self.check_reservation_owner(&adopted.source, cursor, wasi)?;
                self.check_reservation_owner(&adopted.metadata, cursor, wasi)
            }
            /// Identity alone lets a component attribute its diagnostic observation.
            /// It does not establish live accounting or authorize any effect/refund.
            pub(crate) fn reservation_owner_matches(&self,
                ticket: &ReservationTicket) -> bool {
                ticket.owner != 0 && ticket.owner == self.owner
            }
            pub(crate) fn check_reservation_owner(&mut self,
                ticket: &ReservationTicket, cursor: Cursor,
                wasi: Option<WasiUsage>) -> Result<(), SwiftRunFailure> {
                let violation =
                    if ticket.owner != self.owner || ticket.owner == 0 {
                        Some((SwiftCleanupInvariant::ReservationOwner,
                                "swift_run_reservation_owner"))
                    } else if self.reservations.live_tickets == 0 ||
                                self.reservations.category(ticket.category).current <
                                    ticket.bytes ||
                            self.reservations.combined.current < ticket.bytes {
                        Some((SwiftCleanupInvariant::ReservationUnderflow,
                                "swift_run_reservation_underflow"))
                    } else { None };
                if let Some((invariant, code)) = violation {
                    self.cleanup_invariant.get_or_insert(invariant);
                    return Err(self.fail(cursor,
                                Fault::new(SwiftRunFailureKind::Invariant, code), wasi));
                }
                Ok(())
            }
            /// Cleanup-independent validation of the actual retained construction
            /// authority. This borrows its original ticket and records no live change,
            /// checkpoint, admission, refund or ledger repair.
            pub(crate) fn check_construction_owner(&mut self, cursor: Cursor,
                wasi: Option<WasiUsage>) -> Result<(), SwiftRunFailure> {
                let violation =
                    match self.construction.as_ref() {
                        None =>
                            Some((SwiftCleanupInvariant::MissingConstruction,
                                    "swift_run_missing_construction")),
                        Some(ticket) if
                            ticket.owner == 0 || ticket.owner != self.owner =>
                            Some((SwiftCleanupInvariant::ReservationOwner,
                                    "swift_run_construction_owner")),
                        Some(ticket) if
                            self.reservations.live_tickets == 0 ||
                                    self.reservations.category(ticket.category).current <
                                        ticket.bytes ||
                                self.reservations.combined.current < ticket.bytes => {
                            Some((SwiftCleanupInvariant::ReservationUnderflow,
                                    "swift_run_construction_underflow"))
                        }
                        Some(ticket) if
                            !ticket.matches_layout(SwiftReservationCategory::Construction,
                                    self.reservations.construction.current) => {
                            Some((SwiftCleanupInvariant::ConstructionBound,
                                    "swift_run_construction_layout"))
                        }
                        Some(_) => None,
                    };
                if let Some((invariant, code)) = violation {
                    self.cleanup_invariant.get_or_insert(invariant);
                    return Err(self.fail(cursor,
                                Fault::new(SwiftRunFailureKind::Invariant, code), wasi));
                }
                Ok(())
            }
            fn refund(&mut self, ticket: ReservationTicket)
                -> Result<(), SwiftRunFailure> {
                self.refund_with_wasi(ticket, None)
            }
            fn refund_with_wasi(&mut self, ticket: ReservationTicket,
                wasi: Option<WasiUsage>) -> Result<(), SwiftRunFailure> {
                if ticket.owner != self.owner || ticket.owner == 0 {
                    return Err(self.cleanup_fault_with_wasi(SwiftCleanupInvariant::ReservationOwner,
                                "swift_run_release_owner", wasi));
                }
                let category =
                    self.reservations.category(ticket.category).current.checked_sub(ticket.bytes);
                let combined =
                    self.reservations.combined.current.checked_sub(ticket.bytes);
                let count = self.reservations.live_tickets.checked_sub(1);
                let (Some(category), Some(combined), Some(count)) =
                    (category, combined,
                        count) else {
                        return Err(self.cleanup_fault_with_wasi(SwiftCleanupInvariant::ReservationUnderflow,
                                    "swift_run_release_underflow", wasi));
                    };
                self.reservations.category_mut(ticket.category).current =
                    category;
                self.reservations.combined.current = combined;
                self.reservations.live_tickets = count;
                Ok(())
            }
            pub(crate) fn exact_capacity(&mut self, requested: usize,
                observed: usize, cursor: Cursor)
                -> Result<(), SwiftRunFailure> {
                self.exact_capacity_with_wasi(requested, observed, cursor,
                    None)
            }
            pub(crate) fn exact_capacity_with_wasi(&mut self,
                requested: usize, observed: usize, cursor: Cursor,
                wasi: Option<WasiUsage>) -> Result<(), SwiftRunFailure> {
                self.check_with_wasi(cursor, wasi)?;
                if requested != observed {
                    let mut fault =
                        Fault::new(SwiftRunFailureKind::Allocation,
                                "swift_run_unexpected_capacity").limit(SwiftRunResource::ExactCapacity,
                            requested as u64, requested as u64);
                    fault.observed_capacity = Some(observed);
                    return Err(self.fail(cursor, fault, wasi));
                }
                Ok(())
            }
            pub(crate) fn work(&mut self, component: Work, credits: u64,
                cursor: Cursor) -> Result<(), SwiftRunFailure> {
                self.work_with_wasi(component, credits, cursor, None)
            }
            pub(crate) fn work_with_wasi(&mut self, component: Work,
                credits: u64, cursor: Cursor, wasi: Option<WasiUsage>)
                -> Result<(), SwiftRunFailure> {
                self.check_with_wasi(cursor, wasi)?;
                let (used, limit, resource) =
                    match component {
                        Work::Cache =>
                            (self.cache_work, self.budget.cache_work,
                                SwiftRunResource::CacheWork),
                        Work::Execution =>
                            (self.execution_work, self.budget.execution_work,
                                SwiftRunResource::ExecutionWork),
                    };
                let Some(next) =
                    used.checked_add(credits).filter(|next|
                            *next <=
                                limit) else {
                        return Err(self.fail(cursor,
                                    Fault::new(SwiftRunFailureKind::WorkExhausted,
                                            "swift_run_work").limit(resource,
                                        used.saturating_add(credits), limit), wasi));
                    };
                match component {
                    Work::Cache => self.cache_work = next,
                    Work::Execution => self.execution_work = next,
                }
                Ok(())
            }
            /// Charge once before dispatch; bulk extra fuel uses charge_fuel separately.
            pub(crate) fn instruction(&mut self, cursor: Cursor)
                -> Result<(), SwiftRunFailure> {
                self.instruction_with_wasi(cursor, None)
            }
            pub(crate) fn instruction_with_wasi(&mut self, cursor: Cursor,
                wasi: Option<WasiUsage>) -> Result<(), SwiftRunFailure> {
                self.charge_fuel_with_wasi(1, cursor, wasi)?;
                self.instructions =
                    self.instructions.checked_add(1).ok_or_else(||
                                {
                                    self.fail(cursor,
                                        Fault::new(SwiftRunFailureKind::Invariant,
                                            "swift_run_instruction_overflow"), wasi)
                                })?;
                Ok(())
            }
            pub(crate) fn charge_fuel(&mut self, credits: u64, cursor: Cursor)
                -> Result<(), SwiftRunFailure> {
                self.charge_fuel_with_wasi(credits, cursor, None)
            }
            pub(crate) fn charge_fuel_with_wasi(&mut self, credits: u64,
                cursor: Cursor, wasi: Option<WasiUsage>)
                -> Result<(), SwiftRunFailure> {
                self.check_with_wasi(cursor, wasi)?;
                let next = self.instruction_fuel.checked_add(credits);
                let Some(next) =
                    next.filter(|next|
                            *next <=
                                self.budget.instruction_fuel) else {
                        return Err(self.fail(cursor,
                                    Fault::new(SwiftRunFailureKind::FuelExhausted,
                                            "swift_run_fuel").limit(SwiftRunResource::InstructionFuel,
                                        next.unwrap_or(u64::MAX), self.budget.instruction_fuel),
                                    wasi));
                    };
                self.instruction_fuel = next;
                Ok(())
            }
            pub(crate) fn enter_host(&mut self, cursor: Cursor)
                -> Result<(), SwiftRunFailure> {
                self.enter_host_with_wasi(cursor, None)
            }
            pub(crate) fn enter_host_with_wasi(&mut self, cursor: Cursor,
                wasi: Option<WasiUsage>) -> Result<(), SwiftRunFailure> {
                self.check_with_wasi(cursor, wasi)?;
                let next = self.host_calls.checked_add(1);
                let Some(next) =
                    next.filter(|next|
                            *next <=
                                self.budget.host_calls) else {
                        return Err(self.fail(cursor,
                                    Fault::new(SwiftRunFailureKind::HostCallLimit,
                                            "swift_run_host_calls").limit(SwiftRunResource::HostCalls,
                                        next.unwrap_or(u64::MAX), self.budget.host_calls), wasi));
                    };
                self.host_calls = next;
                Ok(())
            }
            fn live_parts(&self, resource: Live)
                ->
                    (SwiftReservationUsage, usize, SwiftRunResource,
                    SwiftRunFailureKind) {
                match resource {
                    Live::CacheEntries =>
                        (self.live.cache_entries, self.budget.cache_entries,
                            SwiftRunResource::CacheEntries,
                            SwiftRunFailureKind::ResourceExhausted),
                    Live::ActivePins =>
                        (self.live.active_pins, self.budget.active_pins,
                            SwiftRunResource::ActivePins,
                            SwiftRunFailureKind::PinLimit),
                    Live::Frames =>
                        (self.live.frames, self.budget.frames,
                            SwiftRunResource::Frames, SwiftRunFailureKind::FrameLimit),
                    Live::Values =>
                        (self.live.values, self.budget.values,
                            SwiftRunResource::Values, SwiftRunFailureKind::ValueLimit),
                    Live::Controls =>
                        (self.live.controls, self.budget.controls,
                            SwiftRunResource::Controls,
                            SwiftRunFailureKind::ControlLimit),
                    Live::MemoryPages =>
                        (self.live.memory_pages, self.budget.memory_pages as usize,
                            SwiftRunResource::MemoryPages,
                            SwiftRunFailureKind::ResourceExhausted),
                }
            }
            fn live_mut(&mut self, resource: Live)
                -> &mut SwiftReservationUsage {
                match resource {
                    Live::CacheEntries => &mut self.live.cache_entries,
                    Live::ActivePins => &mut self.live.active_pins,
                    Live::Frames => &mut self.live.frames,
                    Live::Values => &mut self.live.values,
                    Live::Controls => &mut self.live.controls,
                    Live::MemoryPages => &mut self.live.memory_pages,
                }
            }
            pub(crate) fn add_live(&mut self, resource: Live, amount: usize,
                cursor: Cursor) -> Result<(), SwiftRunFailure> {
                self.add_live_with_wasi(resource, amount, cursor, None)
            }
            pub(crate) fn add_live_with_wasi(&mut self, resource: Live,
                amount: usize, cursor: Cursor, wasi: Option<WasiUsage>)
                -> Result<(), SwiftRunFailure> {
                self.check_with_wasi(cursor, wasi)?;
                let (usage, limit, diagnostic, kind) =
                    self.live_parts(resource);
                let next = usage.current.checked_add(amount);
                let Some(next) =
                    next.filter(|next|
                            *next <=
                                limit) else {
                        return Err(self.fail(cursor,
                                    Fault::new(kind,
                                            "swift_run_live_limit").limit(diagnostic,
                                        next.map_or(u64::MAX, |n| n as u64), limit as u64), wasi));
                    };
                let usage = self.live_mut(resource);
                usage.current = next;
                usage.peak = usage.peak.max(next);
                Ok(())
            }
            /// Counts are removed only after corresponding owner/frame/arena cleanup.
            pub(crate) fn remove_live(&mut self, resource: Live,
                amount: usize) -> Result<(), SwiftRunFailure> {
                self.remove_live_with_wasi(resource, amount, None)
            }
            pub(crate) fn remove_live_with_wasi(&mut self, resource: Live,
                amount: usize, wasi: Option<WasiUsage>)
                -> Result<(), SwiftRunFailure> {
                let (usage, _, _, _) = self.live_parts(resource);
                let Some(next) =
                    usage.current.checked_sub(amount) else {
                        return Err(self.cleanup_fault_with_wasi(SwiftCleanupInvariant::LiveUnderflow,
                                    "swift_run_live_underflow", wasi));
                    };
                self.live_mut(resource).current = next;
                Ok(())
            }
            fn cleanup_fault(&mut self, invariant: SwiftCleanupInvariant,
                code: &'static str) -> SwiftRunFailure {
                self.cleanup_fault_with_wasi(invariant, code, None)
            }
            fn cleanup_fault_with_wasi(&mut self,
                invariant: SwiftCleanupInvariant, code: &'static str,
                wasi: Option<WasiUsage>) -> SwiftRunFailure {
                self.cleanup_invariant.get_or_insert(invariant);
                self.fail(Cursor {
                        stage: SwiftRunStage::Cleanup,
                        function: None,
                        offset: None,
                    }, Fault::new(SwiftRunFailureKind::Invariant, code), wasi)
            }
            pub(crate) fn record_cleanup(&mut self, wasi: Option<WasiUsage>)
                -> Option<SwiftRunFailure> {
                let usage = self.usage(wasi);
                if let Some(failure) = &mut self.first_failure {
                    failure.after_cleanup = Some(usage);
                }
                self.first_failure
            }
            /// Consume and actually drop this foundation closure, then return a copied
            /// observation. Only its inline-owned header/backing/construction tickets are
            /// removed from the observation. An enlarged construction phase must first
            /// pass its actual storage through end_construction_phase; otherwise the
            /// entire construction charge remains. Missing external tickets/storage are
            /// conservatively charged. This is not an arbitrary ledger-zeroing method.
            pub(crate) fn finish_owned_cleanup(mut self,
                wasi: Option<WasiUsage>) -> SwiftRunUsage {
                let started = self.started;
                let deadline = self.deadline;
                let mut observation = self.usage(wasi);
                for ticket in
                    [self.control_header.take(),
                                    self.cancellation_backing.take(),
                                    self.construction.take()].into_iter().flatten() {
                    if ticket.owner != self.owner || ticket.owner == 0 {
                        observation.cleanup_invariant.get_or_insert(SwiftCleanupInvariant::ReservationOwner);
                        continue;
                    }
                    if ticket.category == SwiftReservationCategory::Construction
                            && Some(ticket.bytes) != foundation_construction_bytes() {
                        observation.cleanup_invariant.get_or_insert(SwiftCleanupInvariant::ConstructionBound);
                        continue;
                    }
                    let category =
                        observation.reservations.category(ticket.category).current.checked_sub(ticket.bytes);
                    let combined =
                        observation.reservations.combined.current.checked_sub(ticket.bytes);
                    let count =
                        observation.reservations.live_tickets.checked_sub(1);
                    if let (Some(category), Some(combined), Some(count)) =
                            (category, combined, count) {
                        observation.reservations.category_mut(ticket.category).current
                            = category;
                        observation.reservations.combined.current = combined;
                        observation.reservations.live_tickets = count;
                    } else {
                        observation.cleanup_invariant.get_or_insert(SwiftCleanupInvariant::ReservationUnderflow);
                    }
                }
                drop(self);
                let now = Instant::now();
                observation.elapsed_micros =
                    micros(now.saturating_duration_since(started));
                observation.deadline_overshoot_micros =
                    micros(now.saturating_duration_since(deadline));
                observation
            }
        }
        fn micros(duration: Duration) -> u64 {
            u64::try_from(duration.as_micros()).unwrap_or(u64::MAX)
        }
    }
    pub use crate::experimental::swift::{
        validate_swift_reactor, SwiftReactorObservations,
        SwiftValidationBudget, SwiftValidationFailure,
        SwiftValidationFailureKind, SwiftValidationResource,
        SwiftValidationUsage, ValidatedSwiftReactor,
    };
    mod execution {
        //! Private bounded construction of an uninitialized Swift reactor owner.
        //! Private accounted zero-frame value operations are also implemented.
        //! No initialize, invoke, or interpreter loop is provided.
        #![allow(dead_code)]
