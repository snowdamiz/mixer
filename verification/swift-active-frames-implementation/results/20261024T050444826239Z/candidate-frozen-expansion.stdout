                    if locals >
                            value_capacity.saturating_sub(self.phase.parts.values.len())
                        {
                        return Err(self.limit(SwiftRunFailureKind::ValueLimit,
                                    SwiftRunResource::Values, "swift_frame_value_capacity",
                                    self.phase.parts.values.len().saturating_add(locals),
                                    value_capacity));
                    }
                    let control_capacity = self.phase.parts.controls.capacity();
                    if self.phase.parts.controls.len() >= control_capacity {
                        return Err(self.limit(SwiftRunFailureKind::ControlLimit,
