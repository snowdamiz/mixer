                fn add_live(&mut self, resource: Live)
                    -> Result<(), SwiftRunFailure> {
                    let result =
                        self.phase.operation.control.add_live_with_wasi(resource, 1,
                            self.phase.operation.cursor,
                            Some(self.phase.operation.wasi.usage()));
                    result
