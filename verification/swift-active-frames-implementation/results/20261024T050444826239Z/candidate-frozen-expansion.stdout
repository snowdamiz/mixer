    #[allow(clippy::large_enum_variant)]
    enum ManagedSession {
        Legacy(Session),
        Capability(crate::capability_ffi::session::CapabilitySession),
    }
    impl ManagedSession {
        fn reclaim_ready(&self) -> bool {
            match self {
                Self::Legacy(_) =>
                    true,Self::Capability(session) => session.reclaim_ready(),
            }
        }
    }
    enum State {
        Empty,
        Reserved,
        Live(Arc<ManagedSession>),
        Closing(Arc<ManagedSession>),
        Reclaiming,
        Retired,
    }
    struct Slot {
        generation: u32,
        state: State,
    }
    impl Slot {
        fn release(&mut self) {
            if let Some(next) = self.generation.checked_add(1) {
                self.generation = next;
                self.state = State::Empty;
            } else { self.state = State::Retired; }
