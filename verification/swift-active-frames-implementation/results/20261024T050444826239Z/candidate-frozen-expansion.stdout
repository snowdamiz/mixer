            /// This helper performs cleanup-independent provenance and layout checks only.
            /// Neither resumed cleanup nor ticket validation checks fuel/cancellation/work.
            #[allow(clippy::manual_is_multiple_of)]
            pub(super) fn original_owners(control: &mut RuntimeControl,
                cache: &SwiftFunctionCache, wasi: &AccountedWasi,
                state: &SwiftExecutionState, cursor: Cursor)
                -> Result<(), SwiftRunFailure> {
                wasi.checked_usage(control, cursor)?;
                cache.check_owner(control, Some(wasi), cursor)?;
                control.check_construction_owner(cursor, Some(wasi.usage()))?;
                let header =
                    match state.execution_header.as_ref() {
                        Some(header) => header,
                        None => return Err(layout_failure(control, wasi, cursor)),
                    };
                control.check_reservation_owner(header, cursor,
                        Some(wasi.usage()))?;
                if !header.matches_layout(SwiftReservationCategory::State,
                            execution_header_bytes().unwrap_or(usize::MAX)) {
                    return Err(layout_failure(control, wasi, cursor));
                }
                let requests =
                    match arena_bytes(state.values.capacity(),
                            state.controls.capacity(), state.frames.capacity(),
                            state.memory.capacity() / PAGE, state.table.capacity(),
                            state.globals.capacity()) {
                        Some(requests) => requests,
                        None => return Err(layout_failure(control, wasi, cursor)),
                    };
                let budget = control.budget();
                if state.values.capacity() != budget.values ||
                                                state.controls.capacity() != budget.controls ||
                                            state.frames.capacity() != budget.frames ||
                                        state.memory.len() != state.memory.capacity() ||
                                    state.memory.len() % PAGE != 0 ||
                                state.table.len() != state.table.capacity() ||
                            state.globals.len() != state.globals.capacity() ||
                        control.usage(Some(wasi.usage())).live.memory_pages.current
                            != state.memory.len() / PAGE {
                    return Err(layout_failure(control, wasi, cursor));
                }
                for (index, ticket) in state.buffers.iter().enumerate() {
                    let ticket =
                        match ticket.as_ref() {
                            Some(ticket) => ticket,
                            None => return Err(layout_failure(control, wasi, cursor)),
                        };
                    control.check_reservation_owner(ticket, cursor,
                            Some(wasi.usage()))?;
                    if !ticket.matches_layout(SwiftReservationCategory::State,
                                requests[index]) {
                        return Err(layout_failure(control, wasi, cursor));
                    }
                }
                Ok(())
            }
            impl SwiftReactorInstance {
                pub(crate) fn prepare_frames(&mut self, cursor: Cursor)
                    -> Result<FrameOperationPhase<'_>, SwiftRunFailure> {
                    let Self { control, cache, wasi, state, lifecycle } = self;
                    let control =
                        control.as_mut().expect("constructed control");
                    let cache = cache.as_mut().expect("constructed cache");
                    let wasi = wasi.as_mut().expect("constructed WASI");
                    let state = state.as_mut().expect("constructed State");
                    original_owners(control, cache, wasi, state, cursor)?;
                    let live = control.usage(Some(wasi.usage())).live;
                    if #[allow(non_exhaustive_omitted_patterns)] match lifecycle
                                                                {
                                                                Lifecycle::Terminal => true,
                                                                _ => false,
                                                            } || !state.frame_cleanup.is_empty() ||
                                                        !state.frames.is_empty() || !state.controls.is_empty() ||
                                                !state.values.is_empty() || cache.usage().active_pins != 0
                                        || live.values.current != 0 || live.controls.current != 0 ||
                                live.frames.current != 0 || live.active_pins.current != 0 {
                        return Err(construction_failure(control, wasi, cursor,
                                    SwiftRunFailureKind::Invariant,
                                    "swift_frame_prepare_nonempty"));
                    }
                    let previous =
                        control.usage(Some(wasi.usage())).reservations.construction.current;
                    let admitted =
                        match FRAME_OPERATION_BYTES.and_then(|bytes|
                                    previous.checked_add(bytes)) {
                            Some(admitted) => admitted,
                            None => return Err(layout_failure(control, wasi, cursor)),
                        };
                    control.enlarge_construction_with_wasi(admitted, cursor,
                            Some(wasi.usage()))?;
                    state.frame_cleanup.bound =
                        Some(FrameBound { previous, admitted });
                    state.frame_cleanup.disposition = FrameDisposition::Active;
                    Ok(FrameOperationPhase {
                            phase: ExecutionOperationPhase {
                                parts: ExecutionParts {
                                    cache,
                                    memory: &mut state.memory,
                                    table: &mut state.table,
                                    globals: &mut state.globals,
                                    values: &mut state.values,
                                    controls: &mut state.controls,
                                    frames: &mut state.frames,
                                },
                                operation: SwiftExecutionOperation {
                                    control,
                                    wasi,
                                    cursor,
                                },
                                previous_bound: previous,
                            },
                            cleanup: &mut state.frame_cleanup,
                            lifecycle,
                        })
                }
                pub(crate) fn resume_frame_cleanup(&mut self)
                    -> Result<FrameOperationPhase<'_>, SwiftRunFailure> {
                    let cursor = cleanup_cursor();
                    let Self { control, cache, wasi, state, lifecycle } = self;
                    let control =
                        control.as_mut().expect("constructed control");
                    let cache = cache.as_mut().expect("constructed cache");
                    let wasi = wasi.as_mut().expect("constructed WASI");
                    let state = state.as_mut().expect("constructed State");
                    original_owners(control, cache, wasi, state, cursor)?;
                    let bound =
                        match state.frame_cleanup.bound {
                            Some(bound) => bound,
                            None => return Err(layout_failure(control, wasi, cursor)),
                        };
                    if state.frame_cleanup.disposition == FrameDisposition::Idle
                                ||
                                FRAME_OPERATION_BYTES.and_then(|bytes|
                                            bound.previous.checked_add(bytes)) != Some(bound.admitted)
                            ||
                            control.usage(Some(wasi.usage())).reservations.construction.current
                                < bound.admitted {
                        return Err(layout_failure(control, wasi, cursor));
                    }
                    *lifecycle = Lifecycle::Terminal;
                    state.frame_cleanup.disposition =
                        FrameDisposition::Draining;
                    state.frame_cleanup.unvisited = state.frames.len();
                    state.frame_cleanup.entry_attempted = false;
                    Ok(FrameOperationPhase {
                            phase: ExecutionOperationPhase {
                                parts: ExecutionParts {
                                    cache,
                                    memory: &mut state.memory,
                                    table: &mut state.table,
                                    globals: &mut state.globals,
                                    values: &mut state.values,
                                    controls: &mut state.controls,
                                    frames: &mut state.frames,
                                },
                                operation: SwiftExecutionOperation {
                                    control,
                                    wasi,
                                    cursor,
                                },
                                previous_bound: bound.previous,
                            },
                            cleanup: &mut state.frame_cleanup,
                            lifecycle,
                        })
                }
            }
            impl FrameOperationPhase<'_> {
                fn invariant(&mut self, code: &'static str)
                    -> SwiftRunFailure {
                    self.phase.operation.control.fail(self.phase.operation.cursor,
                        Fault::new(SwiftRunFailureKind::Invariant, code),
                        Some(self.phase.operation.wasi.usage()))
                }
                fn limit(&mut self, kind: SwiftRunFailureKind,
                    resource: SwiftRunResource, code: &'static str,
                    attempted: usize, limit: usize) -> SwiftRunFailure {
                    let mut fault = Fault::new(kind, code);
                    fault.resource = Some(resource);
                    fault.attempted = attempted as u64;
                    fault.limit = limit as u64;
                    self.phase.operation.control.fail(self.phase.operation.cursor,
                        fault, Some(self.phase.operation.wasi.usage()))
                }
                fn terminal(&mut self) {
                    *self.lifecycle = Lifecycle::Terminal;
                    if self.cleanup.disposition == FrameDisposition::Active {
                        self.cleanup.disposition = FrameDisposition::Draining;
                        self.cleanup.unvisited = self.phase.parts.frames.len();
                    }
                }
                fn active(&mut self) -> Result<(), SwiftRunFailure> {
                    if self.cleanup.disposition != FrameDisposition::Active ||
                                        #[allow(non_exhaustive_omitted_patterns)] match self.lifecycle
                                            {
                                            Lifecycle::Terminal => true,
                                            _ => false,
                                        } || self.cleanup.entry.is_some() ||
                                self.cleanup.nested_restore.is_some() ||
                            self.cleanup.live_unreconciled {
                        return Err(self.invariant("swift_frame_inactive"));
                    }
                    self.agreement()
                }
                fn agreement(&mut self) -> Result<(), SwiftRunFailure> {
                    let live =
                        self.phase.operation.control.usage(Some(self.phase.operation.wasi.usage())).live;
                    if live.values.current != self.phase.parts.values.len() ||
                                        live.controls.current != self.phase.parts.controls.len() ||
                                    live.frames.current != self.phase.parts.frames.len() ||
                                live.active_pins.current !=
                                    self.phase.parts.cache.usage().active_pins ||
                            live.active_pins.current != self.phase.parts.frames.len() {
                        self.cleanup.live_unreconciled = true;
                        return Err(self.invariant("swift_frame_live_mismatch"));
                    }
                    Ok(())
                }
                fn work(&mut self, amount: usize)
                    -> Result<(), SwiftRunFailure> {
                    self.phase.operation.control.work_with_wasi(Work::Execution,
                        amount as u64, self.phase.operation.cursor,
                        Some(self.phase.operation.wasi.usage()))
                }
                fn acquire_pin(&mut self, function: u32) -> PinAttempt {
                    let frame_bound =
                        self.phase.operation.control.usage(Some(self.phase.operation.wasi.usage())).reservations.construction.current;
                    let mut preparation =
                        Some(self.phase.parts.cache.prepare_operation(self.phase.operation.control,
                                Some(&*self.phase.operation.wasi),
                                self.phase.operation.cursor));
                    match preparation.take().expect("occupied cache preparation slot")
                        {
                        Err(failure) =>
                            PinAttempt {
                                pin: None,
                                failure: Some(failure),
                                nested_restore: None,
                            },
                        Ok(mut phase) => {
                            let mut returned =
                                Some(phase.pin(self.phase.parts.cache, function));
                            let (pin, mut failure) =
                                match returned.take().expect("occupied cache pin slot") {
                                    Ok(pin) => (Some(pin), None),
                                    Err(failure) => (None, Some(failure)),
                                };
                            let completion = phase.complete((preparation, returned));
                            let nested_restore =
                                if completion.is_err() { Some(frame_bound) } else { None };
                            if let Err(completion_failure) = completion {
                                failure = failure.or(Some(completion_failure));
                            }
                            PinAttempt { pin, failure, nested_restore }
                        }
                    }
                }
                pub(crate) fn enter(&mut self, function: u32)
                    -> Result<(), SwiftRunFailure> {
                    if let Err(failure) = self.active() {
                        self.terminal();
                        return Err(failure);
                    }
                    let pre_values_len = self.phase.parts.values.len();
                    let pre_controls_len = self.phase.parts.controls.len();
                    let result = self.enter_inner(function);
                    if result.is_err() {
                        self.terminal();
                        self.rollback_entry(pre_values_len, pre_controls_len);
                    }
                    result
                }
                #[allow(clippy::drop_non_drop)]
                fn enter_inner(&mut self, function: u32)
                    -> Result<(), SwiftRunFailure> {
                    let frame_limit =
                        self.phase.operation.control.budget().frames.min(64);
                    if self.phase.parts.frames.len() >= frame_limit ||
                            self.phase.parts.frames.len() ==
                                self.phase.parts.frames.capacity() {
                        return Err(self.limit(SwiftRunFailureKind::FrameLimit,
                                    SwiftRunResource::Frames, "swift_frame_depth",
                                    self.phase.parts.frames.len().saturating_add(1),
                                    frame_limit));
                    }
                    self.work(1)?;
                    let (params, result) =
                        {
                            let signature =
                                match self.phase.parts.cache.proof().execution_signature(function)
                                    {
                                    Some(signature) => signature,
                                    None => return Err(self.invariant("swift_frame_signature")),
                                };
                            (signature.params.len(), signature.result.is_some())
                        };
                    let base =
                        match self.phase.parts.values.len().checked_sub(params) {
                            Some(base) => base,
                            None =>
                                return Err(self.invariant("swift_frame_parameters")),
                        };
                    let operands =
                        self.phase.parts.frames.last().map_or(0,
                            |frame| frame.operands);
                    if base < operands {
                        return Err(self.invariant("swift_frame_parameter_boundary"));
                    }
                    for index in 0..params {
                        let ty =
                            self.phase.parts.cache.proof().execution_signature(function).and_then(|signature|
                                    signature.params.get(index).copied());
                        if ty !=
                                self.phase.parts.values.get(base +
                                            index).map(|value| value.ty()) {
                            return Err(self.invariant("swift_frame_parameter_type"));
                        }
                    }
                    let PinAttempt { pin, failure, nested_restore } =
                        self.acquire_pin(function);
                    self.cleanup.nested_restore = nested_restore;
                    if pin.is_some() {
                        self.cleanup.entry =
                            Some(EntryGuard {
                                    pin,
                                    values_debited: 0,
                                    controls_debited: 0,
                                    frame_debited: false,
                                });
                        self.cleanup.entry_attempted = false;
                    }
                    if let Some(failure) = failure { return Err(failure); }
                    let (locals, end) =
                        {
                            let guard =
                                self.cleanup.entry.as_ref().expect("successful real pin acquisition");
                            let view =
                                self.phase.parts.cache.view(guard.pin.as_ref().unwrap(),
                                        self.phase.operation.control,
                                        Some(&*self.phase.operation.wasi))?;
                            let end =
                                match view.instructions.len().checked_sub(1) {
                                    Some(end) => end,
                                    None =>
                                        return Err(self.invariant("swift_frame_empty_function")),
                                };
                            (view.locals.len(), end)
                        };
                    let total_locals =
