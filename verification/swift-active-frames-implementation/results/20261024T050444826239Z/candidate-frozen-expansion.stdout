            }
            fn scan(snapshot: &ValidatedSwiftReactor,
                body: FunctionSpanView<'_>,
                scratch: &mut &mut [decode::Patch],
                meter: &mut SwiftMeter<'_, '_>)
                -> Result<decode::Counts, SwiftRunFailure> {
                let policy = policy(snapshot, body, meter)?;
                meter.step(CacheStep::ScanReset);
                reset(scratch, meter)?;
                meter.step(CacheStep::Scan);
                let mut depth = 0;
                let mut counts = decode::Counts::default();
                decode::scan_borrowed(body.body, body.body_offset, &policy,
                    meter,
                    decode::PassParts {
                        controls: scratch,
                        depth: &mut depth,
                        counts: &mut counts,
                    }, None)
            }
            fn build(snapshot: &ValidatedSwiftReactor,
                body: FunctionSpanView<'_>, counts: decode::Counts,
                scratch: &mut &mut [decode::Patch],
                meter: &mut SwiftMeter<'_, '_>)
                -> Result<SwiftResident, SwiftRunFailure> {
                let bytes = counts.bytes(meter)?;
                checkpoint(meter.operation.control, meter.operation.cursor);
                let ticket =
                    meter.operation.control.admit_cache_entry_with_wasi(bytes,
                            meter.operation.cursor, meter.operation.observation())?;
