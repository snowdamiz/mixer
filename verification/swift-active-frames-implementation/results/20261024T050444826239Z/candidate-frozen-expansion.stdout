        impl CacheConstructionPhase<'_> {
            pub(crate) fn construct(&mut self, adopted: AdoptedProof)
                -> Result<SwiftFunctionCache, CacheConstructionFailure> {
                let check =
                    pairing(self.control.control, self.control.wasi,
                            self.control.cursor).and_then(|observation|
                            {
                                self.control.control.check_adopted_owner(&adopted,
                                    self.control.cursor, observation)
                            });
                if let Err(failure) = check {
                    self.constructed = true;
                    return Err(CacheConstructionFailure {
                                failure,
                                rejected_adopted: Some(adopted),
                            });
                }
                let repeated = std::mem::replace(&mut self.constructed, true);
                if repeated {
                    let failure =
                        self.control.error(CacheFailureKind::InvalidPin,
                            "swift_cache_construct_once");
                    return Err(CacheConstructionFailure {
                                failure,
                                rejected_adopted: Some(adopted),
                            });
                }
                let mut partial = Partial::new(adopted);
                let result = self.construct_partial(&mut partial);
                match result {
                    Ok((owner, usage)) =>
                        Ok(SwiftFunctionCache {
                                adopted: partial.adopted.take().expect("whole adopted owner"),
                                usage,
                                owner,
                                next_nonce: 1,
                                slots: take(&mut partial.slots),
                                pins: take(&mut partial.pins),
                                patches: take(&mut partial.patches),
                                buffers: std::mem::replace(&mut partial.buffers,
                                    std::array::from_fn(|_| None)),
                                header: partial.header.take(),
                            }),
                    Err(failure) => {
                        partial.cleanup(&mut self.control);
                        Err(CacheConstructionFailure {
                                failure,
                                rejected_adopted: None,
                            })
                    }
                }
            }
            fn construct_partial(&mut self, partial: &mut Partial)
                -> Result<(u64, SwiftCacheUsage), SwiftRunFailure> {
                self.control.check()?;
                let header =
                    cache_header_bytes().ok_or_else(||
                                {
                                    self.control.error(CacheFailureKind::Capacity,
                                        "swift_cache_layout_overflow")
                                })?;
                partial.header = Some(self.control.admit(header)?);
                let budget = self.control.control.budget();
                let entries =
                    budget.cache_entries.min(partial.adopted.as_ref().expect("proof").proof().defined_function_count());
                let buffer_bytes =
                    entries.checked_mul(size_of::<SwiftSlot>()).ok_or_else(||
                                {
                                    self.control.error(CacheFailureKind::Capacity,
                                        "swift_cache_layout_overflow")
                                })?;
                partial.buffers[0] = Some(self.control.admit(buffer_bytes)?);
                reserve(&mut partial.slots, entries, &mut self.control)?;
                for _ in 0..entries {
                    self.control.work(1)?;
                    partial.slots.push(SwiftSlot {
                            resident: None,
                            pins: 0,
                            last_used: 0,
                        });
                }
                let buffer_bytes =
                    budget.active_pins.checked_mul(size_of::<PinRecord>()).ok_or_else(||
                                {
                                    self.control.error(CacheFailureKind::Capacity,
                                        "swift_cache_layout_overflow")
                                })?;
                partial.buffers[1] = Some(self.control.admit(buffer_bytes)?);
                reserve(&mut partial.pins, budget.active_pins,
                        &mut self.control)?;
                for _ in 0..budget.active_pins {
                    self.control.work(1)?;
                    partial.pins.push(PinRecord::default());
                }
                let buffer_bytes =
                    PATCH_CAPACITY.checked_mul(size_of::<decode::Patch>()).ok_or_else(||
                                {
                                    self.control.error(CacheFailureKind::Capacity,
                                        "swift_cache_layout_overflow")
                                })?;
                partial.buffers[2] = Some(self.control.admit(buffer_bytes)?);
                reserve(&mut partial.patches, PATCH_CAPACITY,
                        &mut self.control)?;
                for _ in 0..PATCH_CAPACITY {
                    self.control.work(1)?;
                    partial.patches.push(decode::EMPTY_PATCH);
                }
                self.control.check()?;
                let owner =
                    next_owner().map_err(|_|
                                {
                                    self.control.error(CacheFailureKind::IdentityExhausted,
                                        "swift_cache_owner_exhausted")
                                })?;
                let fixed_reserved =
                    header + entries * size_of::<SwiftSlot>() +
                            budget.active_pins * size_of::<PinRecord>() +
                        PATCH_CAPACITY * size_of::<decode::Patch>();
                Ok((owner,
                        SwiftCacheUsage {
                            fixed_reserved,
                            ..SwiftCacheUsage::default()
                        }))
            }
            pub(crate) fn complete<T>(self, returned_phase_storage: T)
                -> Result<(), SwiftRunFailure> {
                let Self {
                        control: CacheControl { control, wasi, .. }, previous_bound,
                        .. } = self;
                control.end_construction_phase_with_wasi(returned_phase_storage,
                    previous_bound, wasi.map(AccountedWasi::usage))
            }
        }
        fn reserve<T>(values: &mut Vec<T>, requested: usize,
            control: &mut CacheControl<'_>) -> Result<(), SwiftRunFailure> {
            control.check()?;
            values.try_reserve_exact(requested).map_err(|_|
                        {
                            control.error(CacheFailureKind::AllocationFailure,
                                "swift_cache_allocation")
                        })?;
            control.exact(requested, values.capacity())?;
            control.check()
        }
