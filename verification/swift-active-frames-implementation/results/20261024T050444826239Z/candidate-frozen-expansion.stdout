            pub(crate) fn complete<T>(self, storage: T,
                outcome: &mut Option<SwiftRunFailure>,
                usage: &mut Option<SwiftRunUsage>) {
                let (HeaderCompletionParts {
                        mut control, mut header, final_wasi }, previous_bound) =
                    drop_construction_return_storage(self, storage);
                let _ =
                    control.end_construction_phase_with_wasi((), previous_bound,
                        final_wasi);
