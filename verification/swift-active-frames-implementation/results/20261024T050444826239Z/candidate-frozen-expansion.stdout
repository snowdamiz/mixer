        }
        impl RuntimeControl {
            /// Consume the actual sealed proof before any new runtime allocation. No
            /// caller-supplied usage or raw-byte constructor can mint adopted authority.
            /// On failure the proof and this entire private closure actually drop before
            /// the returned cleanup snapshot can report their reservations as zero.
            pub(crate) fn adopt(proof: ValidatedSwiftReactor,
                budget: SwiftRunBudget, started: Instant,
                cancellation: Cancellation)
                -> Result<(Self, AdoptedProof), SwiftRunFailure> {
                let validation = proof.usage();
                let mut control =
                    Self {
                        owner: 0,
                        budget,
                        started,
                        deadline: started,
                        deadline_origin: SwiftDeadlineOrigin::Run,
                        cancellation,
                        validation,
                        reservations: SwiftReservations::default(),
                        live: SwiftLiveUsage::default(),
                        cache_work: 0,
                        execution_work: 0,
                        instruction_fuel: 0,
                        instructions: 0,
                        host_calls: 0,
                        cleanup_invariant: None,
                        first_failure: None,
                        control_header: None,
                        cancellation_backing: None,
                        construction: None,
                    };
                let cursor = Cursor::adoption();
                let mut source = None;
                let mut metadata = None;
                let result =
                    (||
                                {
                                    control.check_budget(cursor)?;
                                    control.deadline =
                                        started.checked_add(Duration::from_millis(budget.deadline_ms)).ok_or_else(||
                                                    {
                                                        control.fail(cursor,
                                                            Fault::new(SwiftRunFailureKind::InvalidBudget,
                                                                "swift_run_deadline_overflow"), None)
                                                    })?;
                                    control.check(cursor)?;
                                    control.owner =
                                        NEXT_OWNER.try_update(Ordering::Relaxed, Ordering::Relaxed,
                                                    |n|
                                                        n.checked_add(1)).map_err(|_|
                                                    {
                                                        control.fail(cursor,
                                                            Fault::new(SwiftRunFailureKind::Invariant,
                                                                    "swift_run_owner_exhausted").limit(SwiftRunResource::OwnerIdentity,
                                                                u64::MAX, u64::MAX - 1), None)
                                                    })?;
                                    source =
                                        Some(control.admit(SwiftReservationCategory::RetainedSource,
                                                    validation.source_bytes, cursor)?);
                                    metadata =
                                        Some(control.admit(SwiftReservationCategory::RetainedMetadata,
                                                    validation.metadata_reserved, cursor)?);
                                    control.control_header =
                                        Some(control.admit(SwiftReservationCategory::Shared,
                                                    size_of::<Self>(), cursor)?);
                                    control.cancellation_backing =
                                        Some(control.admit(SwiftReservationCategory::Shared,
                                                    Cancellation::requested_backing_layout().size(), cursor)?);
                                    let construction =
                                        foundation_construction_bytes().ok_or_else(||
                                                    {
                                                        control.fail(cursor,
                                                            Fault::new(SwiftRunFailureKind::Invariant,
                                                                "swift_run_layout_overflow"), None)
                                                    })?;
                                    control.construction =
                                        Some(control.admit(SwiftReservationCategory::Construction,
                                                    construction, cursor)?);
                                    control.check(cursor)
                                })();
                if let Err(mut failure) = result {
                    drop(proof);
                    if let Some(ticket) = source {
                        let _ = control.refund(ticket);
                    }
                    if let Some(ticket) = metadata {
                        let _ = control.refund(ticket);
                    }
                    failure.after_cleanup =
                        Some(control.finish_owned_cleanup(None));
                    return Err(failure);
                }
                Ok((control,
                        AdoptedProof {
                            proof,
                            source: source.expect("successful sealed adoption owns source ticket"),
                            metadata: metadata.expect("successful sealed adoption owns metadata ticket"),
                        }))
            }
            fn check_budget(&mut self, cursor: Cursor)
                -> Result<(), SwiftRunFailure> {
                let max = SwiftRunBudget::default();
                let fields =
                    [(SwiftRunResource::Reservation(SwiftReservationCategory::RetainedSource),
                                self.budget.source_bytes as u64, max.source_bytes as u64),
                            (SwiftRunResource::Reservation(SwiftReservationCategory::RetainedMetadata),
                                self.budget.metadata_bytes as u64,
                                max.metadata_bytes as u64),
                            (SwiftRunResource::Reservation(SwiftReservationCategory::Cache),
                                self.budget.cache_bytes as u64, max.cache_bytes as u64),
                            (SwiftRunResource::CacheEntryBytes,
                                self.budget.cache_entry_bytes as u64,
                                max.cache_entry_bytes as u64),
                            (SwiftRunResource::CacheEntries,
                                self.budget.cache_entries as u64, max.cache_entries as u64),
                            (SwiftRunResource::ActivePins,
                                self.budget.active_pins as u64, max.active_pins as u64),
                            (SwiftRunResource::CacheWork, self.budget.cache_work,
                                max.cache_work),
                            (SwiftRunResource::Frames, self.budget.frames as u64,
                                max.frames as u64),
                            (SwiftRunResource::Values, self.budget.values as u64,
                                max.values as u64),
                            (SwiftRunResource::Controls, self.budget.controls as u64,
                                max.controls as u64),
                            (SwiftRunResource::MemoryPages,
                                self.budget.memory_pages as u64, max.memory_pages as u64),
                            (SwiftRunResource::Reservation(SwiftReservationCategory::State),
                                self.budget.state_bytes as u64, max.state_bytes as u64),
                            (SwiftRunResource::Combined,
                                self.budget.combined_bytes as u64,
                                max.combined_bytes as u64),
                            (SwiftRunResource::InstructionFuel,
                                self.budget.instruction_fuel, max.instruction_fuel),
                            (SwiftRunResource::ExecutionWork,
                                self.budget.execution_work, max.execution_work),
                            (SwiftRunResource::HostCalls, self.budget.host_calls,
                                max.host_calls),
                            (SwiftRunResource::Deadline, self.budget.deadline_ms,
                                max.deadline_ms)];
                for (resource, attempted, limit) in fields {
                    if attempted > limit {
                        return Err(self.fail(cursor,
                                    Fault::new(SwiftRunFailureKind::InvalidBudget,
                                            "swift_run_invalid_budget").limit(resource, attempted,
                                        limit), None));
                    }
                }
                Ok(())
            }
