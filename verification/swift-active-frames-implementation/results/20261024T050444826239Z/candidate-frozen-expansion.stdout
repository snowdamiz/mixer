        }
        fn pairing(control: &mut RuntimeControl, wasi: Option<&AccountedWasi>,
            cursor: Cursor) -> Result<Option<WasiUsage>, SwiftRunFailure> {
            wasi.map(|w| w.checked_usage(control, cursor)).transpose()
        }
        fn layout_failure(control: &mut RuntimeControl,
            wasi: Option<WasiUsage>, cursor: Cursor) -> SwiftRunFailure {
            control.fail(cursor,
                Fault::new(SwiftRunFailureKind::Invariant,
                    "swift_cache_layout_overflow"), wasi)
        }
        impl CacheControl<'_> {
            fn observation(&self) -> Option<WasiUsage> {
                self.wasi.map(AccountedWasi::usage)
            }
            fn error(&mut self, kind: CacheFailureKind, code: &'static str)
                -> SwiftRunFailure {
                let kind =
                    match kind {
                        CacheFailureKind::AllocationFailure =>
                            SwiftRunFailureKind::Allocation,
                        CacheFailureKind::DecoderMismatch =>
                            SwiftRunFailureKind::DecoderMismatch,
                        CacheFailureKind::WorkExhausted =>
                            SwiftRunFailureKind::WorkExhausted,
                        CacheFailureKind::InvalidFunction |
                            CacheFailureKind::InvalidPin |
                            CacheFailureKind::NonceExhausted |
                            CacheFailureKind::IdentityExhausted =>
                            SwiftRunFailureKind::Invariant,
                        CacheFailureKind::PinExhausted =>
                            SwiftRunFailureKind::PinLimit,
                        _ => SwiftRunFailureKind::ResourceExhausted,
                    };
                self.control.fail(self.cursor, Fault::new(kind, code),
                    self.observation())
            }
            fn check(&mut self) -> Result<(), SwiftRunFailure> {
                checkpoint(self.control, self.cursor);
                self.control.check_with_wasi(self.cursor, self.observation())
            }
            fn work(&mut self, n: u64) -> Result<(), SwiftRunFailure> {
                checkpoint(self.control, self.cursor);
                self.control.work_with_wasi(Work::Cache, n, self.cursor,
                    self.observation())
            }
            fn admit(&mut self, bytes: usize)
                -> Result<ReservationTicket, SwiftRunFailure> {
                checkpoint(self.control, self.cursor);
                self.control.admit_with_wasi(SwiftReservationCategory::Cache,
                    bytes, self.cursor, self.observation())
            }
            fn exact(&mut self, requested: usize, observed: usize)
                -> Result<(), SwiftRunFailure> {
                checkpoint(self.control, self.cursor);
                self.control.exact_capacity_with_wasi(requested,
                    capacity_observation(observed), self.cursor,
                    self.observation())
            }
            fn drop_reserved<T>(&mut self, storage: T,
                ticket: ReservationTicket) -> Result<(), SwiftRunFailure> {
                self.control.drop_reserved_with_wasi(storage, ticket,
                    self.observation())
            }
            fn remove_live(&mut self, kind: Live)
                -> Result<(), SwiftRunFailure> {
                self.control.remove_live_with_wasi(kind, 1,
                    self.observation())
            }
            fn check_header(&mut self, cache: &SwiftFunctionCache)
                -> Result<(), SwiftRunFailure> {
                pairing(self.control, self.wasi, self.cursor)?;
                let Some(header) =
                    cache.header.as_ref() else {
                        return Err(self.error(CacheFailureKind::InvalidPin,
                                    "swift_cache_missing_header"));
                    };
                self.control.check_reservation_owner(header, self.cursor,
                    self.observation())
            }
        }
        impl PinDiagnostic<SwiftRunFailure> for CacheControl<'_> {
            fn invalid(&mut self, code: &'static str) -> SwiftRunFailure {
                self.error(CacheFailureKind::InvalidPin, code)
            }
        }
        impl ReleaseControl<SwiftRunFailure> for CacheControl<'_> {
            fn release_pin(&mut self) -> Result<(), SwiftRunFailure> {
                self.remove_live(Live::ActivePins)
            }
        }
        fn construction_preflight(control: &mut RuntimeControl,
            wasi: Option<&AccountedWasi>, adopted: &AdoptedProof,
            cursor: Cursor) -> Result<PreparedBounds, SwiftRunFailure> {
            let observation = pairing(control, wasi, cursor)?;
            control.check_adopted_owner(adopted, cursor, observation)?;
            let previous_bound =
                control.usage(observation).reservations.construction.current;
            let enlarged =
                cache_construction_bytes().and_then(|n|
                                previous_bound.checked_add(n)).ok_or_else(||
                            layout_failure(control, observation, cursor))?;
            Ok(PreparedBounds { previous: previous_bound, enlarged })
        }
        fn operation_preflight(cache: &SwiftFunctionCache,
            control: &mut RuntimeControl, wasi: Option<&AccountedWasi>,
            cursor: Cursor) -> Result<PreparedBounds, SwiftRunFailure> {
            let observation = pairing(control, wasi, cursor)?;
            let header =
                cache.header.as_ref().ok_or_else(||
                            layout_failure(control, observation, cursor))?;
            control.check_reservation_owner(header, cursor, observation)?;
            let previous =
                control.usage(observation).reservations.construction.current;
            let enlarged =
                cache_operation_bytes().and_then(|n|
                                previous.checked_add(n)).ok_or_else(||
                            layout_failure(control, observation, cursor))?;
            Ok(PreparedBounds { previous, enlarged })
        }
        impl SwiftFunctionCache {
            pub(crate) const DECODER_REVISION: u32 = 1;
            pub(crate) fn prepare<'a>(control: &'a mut RuntimeControl,
                wasi: Option<&'a AccountedWasi>, adopted: &AdoptedProof,
                cursor: Cursor)
                -> Result<CacheConstructionPhase<'a>, SwiftRunFailure> {
                test_step(CacheStep::Constructor);
                let PreparedBounds { previous: previous_bound, enlarged: bound
                        } = construction_preflight(control, wasi, adopted, cursor)?;
                let observation = wasi.map(AccountedWasi::usage);
                checkpoint(control, cursor);
                control.enlarge_construction_with_wasi(bound, cursor,
                        observation)?;
                Ok(CacheConstructionPhase {
                        control: CacheControl { control, wasi, cursor },
                        previous_bound,
                        constructed: false,
                    })
            }
            pub(crate) fn proof(&self) -> &ValidatedSwiftReactor {
                self.adopted.proof()
            }
            /// Borrow-only provenance preflight for composed construction and cleanup.
            /// Deliberately performs no ordinary checkpoint, admission, or work debit.
            /// The caller accounts for these temporary borrows before invoking it.
            #[allow(dead_code)]
            pub(crate) fn check_owner(&self, control: &mut RuntimeControl,
                wasi: Option<&AccountedWasi>, cursor: Cursor)
                -> Result<(), SwiftRunFailure> {
                CacheControl { control, wasi, cursor }.check_header(self)
            }
            pub(crate) fn usage(&self) -> SwiftCacheUsage { self.usage }
            pub(crate) fn identity(&self) -> SwiftCacheIdentity {
                SwiftCacheIdentity {
                    owner: self.owner,
                    validator_revision: ValidatedSwiftReactor::VALIDATOR_REVISION,
                    decoder_revision: Self::DECODER_REVISION,
                    policy: self.proof().policy_identity(),
                }
            }
            pub(crate) fn prepare_operation<'a>(&self,
                control: &'a mut RuntimeControl,
                wasi: Option<&'a AccountedWasi>, cursor: Cursor)
                -> Result<CacheOperationPhase<'a>, SwiftRunFailure> {
                test_step(CacheStep::Lookup);
                let PreparedBounds { previous: previous_bound, enlarged: bound
                        } = operation_preflight(self, control, wasi, cursor)?;
                let observation = wasi.map(AccountedWasi::usage);
                checkpoint(control, cursor);
                control.enlarge_construction_with_wasi(bound, cursor,
                        observation)?;
                Ok(CacheOperationPhase {
                        control: CacheControl { control, wasi, cursor },
                        previous_bound,
                    })
            }
            pub(crate) fn view<'a>(&'a self, pin: &SwiftFunctionPin,
                control: &mut RuntimeControl, wasi: Option<&AccountedWasi>)
                -> Result<FunctionView<'a>, SwiftRunFailure> {
                let mut operation =
                    CacheControl { control, wasi, cursor: cache_cursor() };
                operation.check_header(self)?;
                view::<SwiftMode>(CacheViewParts {
                        slots: &self.slots,
                        pins: &self.pins,
                        owner: self.owner,
                    }, pin, &mut operation)
            }
            pub(crate) fn release(&mut self, pin: SwiftFunctionPin,
                control: &mut RuntimeControl, wasi: Option<&AccountedWasi>)
                -> Result<(), SwiftReleaseFailure> {
                let mut operation =
                    CacheControl { control, wasi, cursor: cache_cursor() };
                if let Err(failure) = operation.check_header(self) {
                    return Err(SwiftReleaseFailure { failure, pin });
                }
                release::<SwiftMode>(CacheParts {
                            snapshot: self.adopted.proof(),
                            slots: &mut self.slots,
                            pins: &mut self.pins,
                            owner: self.owner,
                            next_nonce: &mut self.next_nonce,
                            usage: &mut self.usage,
                            scratch: &mut self.patches,
                        }, pin,
                        &mut operation).map_err(|(failure, pin)|
                        SwiftReleaseFailure { failure, pin })
            }
            pub(crate) fn cleanup<'a>(owned: &mut Option<Self>,
                control: &'a mut RuntimeControl,
                wasi: Option<&'a AccountedWasi>)
                -> Result<CacheCleanupTail<'a>, SwiftRunFailure> {
                let cursor =
                    Cursor {
                        stage: SwiftRunStage::Cleanup,
                        function: None,
                        offset: None,
                    };
                let observation = pairing(control, wasi, cursor)?;
                let cache =
                    owned.as_ref().ok_or_else(||
                                layout_failure(control, observation, cursor))?;
                let header =
                    cache.header.as_ref().ok_or_else(||
                                layout_failure(control, observation, cursor))?;
                control.check_reservation_owner(header, cursor, observation)?;
                let mut cache =
                    owned.take().expect("preflight retained owner");
                let mut failure = None;
                for record in &mut cache.pins {
                    if record.nonce != 0 {
                        *record = PinRecord::default();
                        capture(&mut failure,
                            control.remove_live_with_wasi(Live::ActivePins, 1,
                                wasi.map(AccountedWasi::usage)));
                    }
                }
                for slot in &mut cache.slots {
                    slot.pins = 0;
                    if let Some(resident) = slot.resident.take() {
                        capture(&mut failure,
                            control.drop_reserved_with_wasi(resident.decoded,
                                resident.ticket, wasi.map(AccountedWasi::usage)));
                        capture(&mut failure,
                            control.remove_live_with_wasi(Live::CacheEntries, 1,
                                wasi.map(AccountedWasi::usage)));
                    }
                }
                if let Some(ticket) = cache.buffers[0].take() {
                    capture(&mut failure,
                        control.drop_reserved_with_wasi(take(&mut cache.slots),
                            ticket, wasi.map(AccountedWasi::usage)));
                }
                if let Some(ticket) = cache.buffers[1].take() {
                    capture(&mut failure,
                        control.drop_reserved_with_wasi(take(&mut cache.pins),
                            ticket, wasi.map(AccountedWasi::usage)));
                }
                if let Some(ticket) = cache.buffers[2].take() {
                    capture(&mut failure,
                        control.drop_reserved_with_wasi(take(&mut cache.patches),
                            ticket, wasi.map(AccountedWasi::usage)));
                }
                let SwiftFunctionCache { adopted, header, .. } = cache;
                capture(&mut failure,
                    control.drop_proof_with_wasi(adopted,
                        wasi.map(AccountedWasi::usage)));
                if failure.is_none() {
                    failure =
                        control.record_cleanup(wasi.map(AccountedWasi::usage));
                }
                Ok(CacheCleanupTail { control, wasi, header, failure })
            }
        }
        fn capture(first: &mut Option<SwiftRunFailure>,
            result: Result<(), SwiftRunFailure>) {
            if let Err(failure) = result {
                if first.is_none() { *first = Some(failure); }
            }
        }
        type CleanupCompletionParts<'a> =
            (&'a mut RuntimeControl, Option<&'a AccountedWasi>,
            Option<ReservationTicket>);
        /// This helper frame (including the original tail and its failure) has ended
        /// before complete begins the observed refund. It returns only small borrows
        /// and the same ticket; no possible-cache owner or failure wrapper survives.
        fn drop_cleanup_return_storage<'a,
            T>(tail: CacheCleanupTail<'a>, storage: T)
            -> CleanupCompletionParts<'a> {
            let CacheCleanupTail { control, wasi, header, failure } = tail;
            drop((storage, failure));
            (control, wasi, header)
        }
        impl CacheCleanupTail<'_> {
            pub(crate) fn complete<T>(self, returned_phase_storage: T,
                outcome: &mut Option<SwiftRunFailure>) {
