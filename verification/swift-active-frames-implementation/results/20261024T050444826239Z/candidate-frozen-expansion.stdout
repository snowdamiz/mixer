                fn remove_live(&mut self, resource: Live, amount: usize)
                    -> bool {
                    if self.phase.operation.control.remove_live_with_wasi(resource,
                                amount, Some(self.phase.operation.wasi.usage())).is_err() {
                        self.cleanup.live_unreconciled = true;
                        false
                    } else { true }
                }
                fn release(&mut self, pin: SwiftFunctionPin, function: u32)
                    -> Result<(), SwiftReleaseFailure> {
                    let _ = function;
                    let result =
                        self.phase.parts.cache.release(pin,
                            self.phase.operation.control,
                            Some(&*self.phase.operation.wasi));
                    result
