                        snapshot: cache.adopted.proof(),
                        slots: &mut cache.slots,
                        pins: &mut cache.pins,
                        owner: cache.owner,
                        next_nonce: &mut cache.next_nonce,
                        usage: &mut cache.usage,
                        scratch: &mut cache.patches,
                    }, function, &mut self.control)
