                outstanding_requests: ::core::default::Default::default(),
                native_leases: ::core::default::Default::default(),
                reserved_bytes: ::core::default::Default::default(),
                argument_bytes: ::core::default::Default::default(),
                completion_bytes: ::core::default::Default::default(),
                retired_slots: ::core::default::Default::default(),
                closed: ::core::default::Default::default(),
                enabled: ::core::default::Default::default(),
                turn_active: ::core::default::Default::default(),
            }
        }
