+            2,
+            Function::scalar(
+                &[
+                    0x23, 0, 0x41, 1, 0x6a, 0x24, 0, 0x41, 0xc0, 0, 0x23, 0, 0x36, 2, 0, 0x23, 0,
+                    0x0b,
+                ],
+                Type::I32,
+            ),
+        ),
+        (
+            28,
+            Function::scalar(&[0x41, 0, 0x11, 35, 0, 0x0b], Type::I32),
+        ),
+    ]
+}
