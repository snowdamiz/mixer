# Preserve receipts, source snapshots and logs; exclude derived compiler outputs.
**/swift-cache/
**/*.dSYM/
/builds/*/*.o
/builds/*/*.dylib
/builds/*/*.swiftmodule
/builds/*/*.swiftdoc
/builds/*/*.swiftsourceinfo
/builds/*/*.abi.json
/builds/*/*.dSYM/
/builds/*/Stage4HostTests
/delta-final-2/*/DeltaProbes
/delta-candidate-3/*/DeltaProbes
