    {
      "argv": [
        "RUSTC_LAUNCHER",
        "--print",
        "sysroot"
      ],
      "cwd": "REPOSITORY",
      "environment": {
        "RUSTUP_AUTO_INSTALL": "0"
      },
      "name": "compiler-sysroot-selection",
      "timeout_seconds": 15
    },
    {
      "argv": [
        "SELECTED_RUSTC",
        "--version",
        "--verbose"
      ],
      "name": "rustc-verbose",
      "timeout_seconds": 15
    },
    {
      "argv": [
        "PYTHON",
        "--version"
      ],
      "name": "python-version",
      "timeout_seconds": 15
    },
    {
      "argv": [
        "git",
        "rev-parse",
        "HEAD"
      ],
      "cwd": "REPOSITORY",
      "name": "revision-before",
      "timeout_seconds": 15
    },
    {
      "argv": [
        "SELECTED_RUSTC",
        "--edition=2024",
        "--crate-name",
        "mixer_absence",
        "--crate-type=rlib",
        "-Dwarnings",
        "source/library/analyzer.rs",
        "-o",
        "scratch/libmixer_absence.rlib"
      ],
      "name": "library-compile",
      "timeout_seconds": 60
    },
    {
      "argv": [
        "SELECTED_RUSTC",
        "--edition=2024",
        "--test",
        "-Dwarnings",
