        "scratch/producer-tests"
      ],
      "name": "producer-compile",
      "timeout_seconds": 60
    },
    {
      "argv": [
        "SELECTED_RUSTC",
        "--edition=2024",
        "--test",
        "-Dwarnings",
        "source/independent/source/analyzer.rs",
        "-o",
        "scratch/independent-tests"
      ],
      "name": "independent-compile",
      "timeout_seconds": 60
    },
    {
      "argv": [
        "scratch/producer-tests",
        "--list"
      ],
      "expected_count": 78,
      "expected_exact_inventory": "producer",
      "name": "producer-list",
      "timeout_seconds": 15
    },
    {
      "argv": [
        "scratch/producer-tests",
        "--test-threads=1",
        "--nocapture"
      ],
      "environment": {
        "MIXER_ANALYZER_LIBRARY_HISTORICAL": "OUTPUT/inputs/historical",
        "MIXER_ANALYZER_LIBRARY_TEST_SCRATCH": "OUTPUT/scratch/producer-framing",
        "MIXER_ENVELOPE_SCRATCH": "OUTPUT/scratch/producer-envelope",
        "MIXER_REVIEW_SCRATCH": "OUTPUT/scratch/producer-review"
      },
      "expected_count": 78,
      "expected_failed_ignored_measured_filtered": [
        0,
        0,
        0,
        0
      ],
      "name": "producer-execute",
      "timeout_seconds": 120
    },
    {
      "argv": [
        "scratch/independent-tests",
        "--list"
      ],
      "expected_count": 14,
      "expected_exact_inventory": "independent",
