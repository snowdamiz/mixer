+def base_file_tar(data, soname, maximum=MAX_FILE_BYTES):
+    """Base-library-only docker cp -L basename compatibility; strict graph stays shared."""
+    base_path(soname)  # Requested identity must remain an ASCII SONAME leaf.
+    require(0 < len(data) <= maximum+1048576, "base export envelope bound")
+    with tarfile.open(fileobj=io.BytesIO(data), mode="r|") as archive:
+        member = archive.next()
+        require(member is not None, "base export file absent")
+        require(not member.pax_headers and member.sparse is None, "unsupported base tar metadata")
+        observed = member.name
+        require(re.fullmatch(re.escape(soname)+r"(?:\.[0-9]+(?:\.[0-9]+)*)?", observed, flags=re.ASCII),
+                "base export versioned member name")
+    # Keep the existing one-file/type/PAX/sparse/link/size/tail validation exact.
+    # Product, notice and header consumers never call this compatibility wrapper.
+    return one_file_tar(data, observed, maximum=maximum), observed
 
 
