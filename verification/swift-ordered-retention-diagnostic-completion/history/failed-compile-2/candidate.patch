+// Every loop body executes at most 32 times, including Interrupted/short writes.
+pub fn bounded_write<W:Write>(sink:&mut W,bytes:&[u8],attempts:&mut u64)->bool {
+    let mut offset=0usize;
+    for _ in 0..32 {
