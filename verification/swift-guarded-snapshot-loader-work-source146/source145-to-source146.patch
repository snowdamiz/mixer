+            let make = |expected| Resource { account: &a, sequence: &sequence, expected, bytes_live: 70 };
+            // Pure fake owners; these exercise retention, not genuine ingress.
+            (make(0), Err::<Resource<'_>, _>(make(1)), make(2), make(3))
