+        let mut once = Some(a.reserve_whole_v1(quote(7, 11)).unwrap());
+        assert_eq!(a.usage_v1(), UsageV1 { work: 7, storage: 11, peak_storage: 11 });
+        let retained = once.take().unwrap().dispatch_v1(|| {
