{"name":"Phoenix foundation checks","true":{"push":{"paths":["hosted/**","services/protocol/testdata/signed-release-v3.json","services/protocol/testdata/release-v3-cases.json",".github/workflows/hosted.yml","console/src/api/**","console/src/domain/workspace-directory.ts","console/package.json","console/package-lock.json","verification/hosted-customer-workspace-http-integration/node-client-driver.mjs","verification/hosted-browser-auth-protocol/run.py","verification/hosted-browser-callback-ci/selected-methods.json","verification/hosted-browser-callback-storage/*.exs","verification/hosted-browser-preauth-store/live.exs","verification/hosted-browser-begin-login/*.exs"]},"pull_request":{"paths":["hosted/**","services/protocol/testdata/signed-release-v3.json","services/protocol/testdata/release-v3-cases.json",".github/workflows/hosted.yml","console/src/api/**","console/src/domain/workspace-directory.ts","console/package.json","console/package-lock.json","verification/hosted-customer-workspace-http-integration/node-client-driver.mjs","verification/hosted-browser-auth-protocol/run.py","verification/hosted-browser-callback-ci/selected-methods.json","verification/hosted-browser-callback-storage/*.exs","verification/hosted-browser-preauth-store/live.exs","verification/hosted-browser-begin-login/*.exs"]}},"permissions":{"contents":"read"},"jobs":{"phoenix":{"runs-on":"ubuntu-24.04","timeout-minutes":15,"steps":[{"uses":"actions/checkout@v4"},{"uses":"actions/setup-node@v4","with":{"node-version":"22.23.3"}},{"uses":"erlef/setup-beam@54075bcc5e249e4758d363f27d099f55d843f124","with":{"version-file":"hosted/.tool-versions","version-type":"strict"}},{"name":"Resolve locked dependencies","working-directory":"hosted","run":"mix deps.get --check-locked"},{"name":"Browser auth protocol host checks","working-directory":"hosted","env":{"MIX_ENV":"test"},"run":"mix deps.compile jason\npython3 ../verification/hosted-browser-auth-protocol/run.py\n"},{"name":"Compile workspace client for real HTTP integration","working-directory":"console","run":"node --version\nnpm --version\nnpm ci --ignore-scripts --no-audit --no-fund\nnode node_modules/typescript/bin/tsc --version\nnode node_modules/typescript/bin/tsc src/api/workspace-client.ts \\\n  --target ES2022 --module ES2022 --moduleResolution bundler \\\n  --strict --skipLibCheck --lib ES2022,DOM \\\n  --outDir \"$RUNNER_TEMP/workspace-client\"\ncp ../verification/hosted-customer-workspace-http-integration/node-client-driver.mjs \\\n  \"$RUNNER_TEMP/workspace-client/driver.mjs\"\nprintf '%s\\n' '{\"type\":\"module\"}' > \"$RUNNER_TEMP/workspace-client/package.json\"\nprintf 'MIXER_WORKSPACE_HTTP_NODE_DRIVER=%s/driver.mjs\\n' \"$RUNNER_TEMP/workspace-client\" >> \"$GITHUB_ENV\"\n"},{"name":"Browser session storage and migration checks","working-directory":"hosted","env":{"MIX_ENV":"test"},"run":"mix deps.compile\npython3 test/mixer_hosted/browser_auth/run_storage_fixture.py \\\n  --pg-bin /usr/lib/postgresql/16/bin\npython3 test/mixer_hosted/browser_auth/run_migration_fixture.py \\\n  --pg-bin /usr/lib/postgresql/16/bin \\\n  --output \"$RUNNER_TEMP/browser-migrations\"\n"},{"name":"Selected browser callback, preauth and begin checks","working-directory":"hosted","env":{"MIX_ENV":"test"},"run":"python3 -B test/mixer_hosted/browser_auth/run_callback_fixture.py \\\n  --pg-bin /usr/lib/postgresql/16/bin \\\n  --output \"$RUNNER_TEMP/browser-callback\"\n"},{"name":"Phoenix and disposable PostgreSQL host checks","working-directory":"hosted","run":"python3 scripts/test-local.py \\\n  --pg-bin /usr/lib/postgresql/16/bin \\\n  --output \"$RUNNER_TEMP/phoenix-foundation\"\n"},{"name":"Preserve host evidence","if":"always()","uses":"actions/upload-artifact@v4","with":{"name":"phoenix-foundation-${{ github.sha }}","retention-days":14,"if-no-files-found":"ignore","path":"${{ runner.temp }}/phoenix-foundation/\nverification/hosted-browser-auth-protocol/attempts/\nverification/hosted-browser-session-storage/attempts/\n${{ runner.temp }}/browser-migrations/\n${{ runner.temp }}/browser-callback/\n"}}]}}}
