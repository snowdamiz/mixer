 #[test]fn independent_paid_latched_skip_and_poison_call_counter(){let v=seq(vec![ev(1),ev(10),ev(12),ev(13)]);let mut x=mem(&v,false);let o=run(&mut x,STEP_LIMIT).unwrap();assert_eq!(o.envelope().reason(),&FixtureEnvelopeReasonV1::Stage);assert_eq!(o.envelope().observed_records(),1);assert_eq!(o.envelope().envelope_debit(),2281);let a=Arena{bytes:vec![0;ARENA_BYTES]};let mut p=FixtureEnvelopeProgressV1{reply_valid:1,debit:581,reply:FixtureEnvelopeReplyV1{words:[1,15,99,999,99,99,99,99,99,99,99,99,99,425,0,0]}};let mut calls=0;for _ in 0..3{p.debit+=425;if leaf_pending(&p){calls+=1;}}assert_eq!(calls,0);assert_eq!(p.debit,1856);for limited in[false,true]{for cap in[0,1]{let mut s=Framing::new(3);s.complete=!limited;s.limited=limited;s.flags=cap;let o=finalize(&p,&s,&Ok(!limited),&a);zero(&o);assert_eq!(o.reason(),&FixtureEnvelopeReasonV1::InternalPoisoned);for code in[BINDING,BUDGET,IO_ERROR]{let o=finalize(&p,&s,&Err(error(code,FOOTER_STAGE,0,0)),&a);zero(&o);assert_eq!(o.boundary(),&FixtureEnvelopeBoundaryV1::Unavailable);assert_eq!(o.envelope_debit(),1856);}}}}
