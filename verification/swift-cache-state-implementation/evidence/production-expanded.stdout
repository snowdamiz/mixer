        #[repr(C)]
        struct Progress {
            calls: u64,
            latch: u64,
            q: [u64; 16],
        }
        impl Progress {
            fn terminal(&self) -> u64 { self.latch & 255 }
            fn first_pin(&self) -> u64 {
                let n = self.latch >> 8;
                if n == 0 { ABSENT } else { n - 1 }
            }
            fn latch_terminal(&mut self, n: u64) {
                self.latch = (self.latch & !255) | n;
            }
            fn remember_pin(&mut self, n: u64) {
                self.latch =
                    (self.latch & 255) |
                        if n == ABSENT { 0 } else { (n + 1) << 8 };
            }
        }
        #[repr(C)]
        struct Paid {
            setup: u64,
            finish: u64,
            records: u64,
        }
        #[repr(C)]
        struct SemanticReply {
            status: u64,
            reason: u64,
            debit: u64,
        }
        struct Loan<'a> {
            record: &'a FixtureDecodedRecordV1<'a>,
            config: &'a Fixture,
        }
        fn ld(b: &[u8], at: usize) -> u64 {
            u64::from_le_bytes(*b[at..at +
                                        8].first_chunk::<8>().expect("proved eight-byte range"))
        }
        fn st(b: &mut [u8], at: usize, n: u64) {
            b[at..at + 8].copy_from_slice(&n.to_le_bytes());
        }
        fn cq(c: &Candidate2048, i: usize) -> u64 { ld(c, SC + 8 * i) }
        fn sq(c: &mut Candidate2048, i: usize, n: u64) {
            st(c, SC + 8 * i, n);
        }
        fn rr(b: &[u8], row: usize, field: usize) -> u64 {
            ld(b, RESIDENT.base + 64 * row + 8 * field)
        }
        fn pr(b: &[u8], row: usize, field: usize) -> u64 {
            ld(b, PIN.base + 48 * row + 8 * field)
        }
        fn pl(b: &[u8], row: usize, field: usize) -> u64 {
            ld(b, PLAN.base + 40 * row + 8 * field)
        }
        fn reject(reason: u64) -> SemanticReply {
            SemanticReply { status: 2, reason, debit: SEMANTIC_RECORD }
        }
        fn poison(debit: u64) -> SemanticReply {
            SemanticReply { status: 3, reason: 16, debit }
        }
        fn selected_mask(slots: u64) -> u64 {
            if slots == 64 { ABSENT } else { (1u64 << slots) - 1 }
        }
        fn shape_q(q: &[u64; 16], calls: u64, latch: u64, n: u64, f: &Fixture)
            -> bool {
            if q[0] > n || calls > n || q[3] > 10 || q[6] > f.slots ||
                                q[8] > f.pins || q[9] == 0 || (q[6] == 0) != (q[7] == 0) ||
                    (q[8] > 0 && q[6] == 0) {
                return false;
            }
            if q[3] != 0 && (q[4] == 0 || q[5] >= 80000) { return false; }
            if (q[10] | q[11] | q[12]) & !selected_mask(f.slots) != 0 ||
                        q[11] & !q[10] != 0 || q[12] & !q[11] != 0 {
                return false;
            }
            if (q[3] == 7 || q[3] == 8) &&
                    (q[13] >= f.slots || q[10] & (1 << q[13]) == 0) {
                return false;
            }
            if (6..=10).contains(&q[3]) &&
                    (q[15] > 1 || (q[15] == 1 && q[14] >= f.slots)) {
                return false;
            }
            if q[0] == 0 &&
                    (q[1] != 0 || q[2] != 0 || q[3] != 0 || q[6] != 0 ||
                                    q[7] != 0 || q[8] != 0 || q[9] != 1) {
                return false;
            }
            if latch == 0 {
                calls == q[0] && q[0] == n && calls > 0
            } else {
                (latch == 1 || (6..=14).contains(&latch)) && calls == q[0] + 1
                    && calls <= n
            }
        }
        fn merge(c: &mut Candidate2048) {
            let mut src = 512;
            let mut dst = 1024;
            let mut width = 1;
            while width < 64 {
                let mut base = 0;
                while base < 64 {
                    let mut left = base;
                    let mid = base + width;
                    let end = base + 2 * width;
                    let mut right = mid;
                    for out in base..end {
                        let take_left =
                            if left == mid {
                                false
                            } else if right == end {
                                true
                            } else {
                                let a = ld(c, src + left * 8);
                                let b = ld(c, src + right * 8);
                                b == ABSENT ||
                                    (a != ABSENT &&
                                            ld(c, a as usize * 8) <= ld(c, b as usize * 8))
                            };
                        let index_at =
                            if take_left {
                                let at = src + left * 8;
                                left += 1;
                                at
                            } else { let at = src + right * 8; right += 1; at };
                        c.copy_within(index_at..index_at + 8, dst + out * 8);
                    }
                    base = end;
                }
                std::mem::swap(&mut src, &mut dst);
                width *= 2;
            }
        }
        fn commit_succeeded() -> bool { { true } }
        fn semantic(b: &mut [u8], c: &mut Candidate2048, loan: &Loan<'_>,
            p: &Progress, steps: &mut StepBudget) -> SemanticReply {
            if b.len() != ARENA_BYTES || steps.spent != 0 {
                return poison(0);
            }
            if steps.remaining < SEMANTIC_RECORD {
                return SemanticReply { status: 2, reason: 1, debit: 0 };
            }
            steps.remaining -= SEMANTIC_RECORD;
            steps.spent = SEMANTIC_RECORD;
            let w = loan.record.words;
            let f = loan.config;
            if f.slots == 0 || f.slots > 64 || f.pins == 0 || f.pins > 64 ||
                            p.terminal() != 0 || p.latch >> 8 > f.pins || p.q[3] > 10 {
                return poison(SEMANTIC_RECORD);
            }
            if w[1] == 14 { return reject(14); }
            for i in 0..16 { sq(c, i, p.q[i]); }
            sq(c, 16, p.first_pin());
            for i in 0..2 {
                sq(c, 17 + i, ld(b, SCALAR.base + EXTRA_CELLS[i] * 8));
            }
            let mut resident_delta = ABSENT;
            let mut pin_delta = ABSENT;
            let mut plan_delta = ABSENT;
            let mut total = 0u64;
            let mut count = 0u64;
            let mut found = ABSENT;
            let mut first_empty = ABSENT;
            let mut first_pin = ABSENT;
            let mut resident_pins = 0u64;
            let mut live_tokens = 0u64;
            let mut release_nonce_matches = 0u64;
            for slot in 0..f.slots as usize {
                let occupied = rr(b, slot, 0);
                let function = rr(b, slot, 1);
                let bytes = rr(b, slot, 2);
                let pins = rr(b, slot, 3);
                if occupied > 1 || pins > f.pins || rr(b, slot, 6) != 0 ||
                        rr(b, slot, 7) != 0 {
                    return reject(13);
                }
                if occupied == 1 {
                    resident_pins += pins;
                    if function >= 80000 || bytes == 0 || bytes > f.entry {
                        return reject(13);
                    }
                    let Some(sum) =
                        total.checked_add(bytes) else { return reject(10); };
                    total = sum;
                    count += 1;
                    if function == w[6] {
                        if found != ABSENT { return reject(7); }
                        found = slot as u64;
                    }
                } else if function != ABSENT || bytes != 0 || pins != 0 {
                    return reject(13);
                } else if first_empty == ABSENT { first_empty = slot as u64; }
                st(c, slot * 8, rr(b, slot, 4));
                st(c, 512 + slot * 8,
                    if occupied == 1 && pins == 0 {
                        slot as u64
                    } else { ABSENT });
            }
            for slot in f.slots as usize..64 {
                st(c, slot * 8, 0);
                st(c, 512 + slot * 8, ABSENT);
            }
            for pin in 0..f.pins as usize {
                let entry = pr(b, pin, 0);
                let nonce = pr(b, pin, 1);
                if entry == ABSENT {
                    if nonce != 0 { return reject(13); }
                    if first_pin == ABSENT { first_pin = pin as u64; }
                } else {
                    if entry >= f.slots || nonce == 0 || nonce >= p.q[9] ||
                                rr(b, entry as usize, 0) != 1 ||
                            rr(b, entry as usize, 3) == 0 {
                        return reject(13);
                    }
                    live_tokens += 1;
                    if w[1] == 12 && nonce == w[12] {
                        release_nonce_matches += 1;
                    }
                }
            }
            if release_nonce_matches > 1 { return reject(11); }
            if resident_pins != p.q[8] || live_tokens != p.q[8] {
                return reject(13);
            }
            if count != p.q[6] || total != p.q[7] || p.q[8] > f.pins ||
                    p.q[9] == 0 {
                return reject(13);
            }
            let body = w[6] as usize;
            if !#[allow(non_exhaustive_omitted_patterns)] match w[1] {
                            1 | 13 => true,
                            _ => false,
                        } &&
                    (body >= 80000 ||
                            u32::from_le_bytes(*b[FUNCTION.base + body * 96 +
                                                            20..FUNCTION.base + body * 96 +
                                                            24].first_chunk::<4>().unwrap()) != 1) {
                return reject(6);
            }
            match w[1] {
                1 => {
                    sq(c, 16, ABSENT);
                    sq(c, 17, ABSENT);
                    sq(c, 18, 0);
                    sq(c, 10, 0);
                    sq(c, 11, 0);
                    sq(c, 12, 0);
                    sq(c, 13, ABSENT);
                    sq(c, 14, ABSENT);
                    sq(c, 15, 0);
                }
                2 => {
                    if p.q[9] == ABSENT { return reject(12); }
                    if first_pin == ABSENT { return reject(11); }
                    if (w[13] == 0 && found != ABSENT) ||
                            (w[13] == 1 && found != w[10]) {
                        return reject(7);
                    }
                    sq(c, 16, first_pin);
                    sq(c, 17, found);
                }
                3 | 4 => {
                    let cell = (w[6] & 511) as usize;
                    let prior = pl(b, cell, 0);
                    let outcome =
                        if prior == ABSENT {
                            0
                        } else if prior == w[6] { 2 } else { 1 };
                    if outcome == 2 &&
                            (pl(b, cell, 1) != w[7] || pl(b, cell, 2) != w[8] ||
                                    pl(b, cell, 3) != w[9]) {
                        return reject(8);
                    }
                    if w[1] == 4 {
                        if w[13] != outcome ||
                                w[14] != (if outcome == 1 { prior } else { ABSENT }) {
                            return reject(8);
                        }
                        if outcome != 2 {
                            for i in 0..5 {
                                st(c, 1648 + i * 8,
                                    if i == 0 { w[6] } else if i < 4 { w[6 + i] } else { 0 });
                            }
                            plan_delta = cell as u64;
                        }
                    }
                }
                5 => {
                    let cell = (w[6] & 511) as usize;
                    if pl(b, cell, 0) != w[6] || pl(b, cell, 1) != w[7] ||
                                pl(b, cell, 2) != w[8] || pl(b, cell, 3) != w[9] {
                        return reject(8);
                    }
                    if pl(b, cell, 4) != 0 && pl(b, cell, 4) != w[13] {
                        return reject(10);
                    }
                    if w[13] == 0 || w[13] > f.entry || w[14] != f.base ||
                                w[15] != f.capacity ||
                            f.base.checked_add(w[13]).is_none_or(|v| v > f.capacity) {
                        return reject(10);
                    }
                    c[1648..1688].copy_from_slice(&b[PLAN.base +
                                        40 * cell..PLAN.base + 40 * cell + 40]);
                    st(c, 1680, w[13]);
                    plan_delta = cell as u64;
                    sq(c, 18, w[13]);
                    merge(c);
                    let headroom = f.capacity - f.base - w[13];
                    let mut remaining = total;
                    let mut mask = 0;
                    let mut destination = first_empty;
                    for i in 0..64 {
                        if remaining <= headroom && destination != ABSENT { break; }
                        let slot = ld(c, 512 + i * 8);
                        if slot == ABSENT { break; }
                        let Some(next) =
                            remaining.checked_sub(rr(b, slot as usize,
                                    2)) else { return reject(13); };
                        remaining = next;
                        mask |= 1 << slot;
                        destination = slot;
                    }
                    let feasible =
                        destination != ABSENT && remaining <= headroom;
                    sq(c, 10, mask);
                    sq(c, 11, 0);
                    sq(c, 12, 0);
                    sq(c, 13, ABSENT);
                    sq(c, 14, if feasible { destination } else { ABSENT });
                    sq(c, 15, u64::from(feasible));
                }
                6..=8 => {
                    if p.q[15] != 1 { return reject(9); }
                    let outstanding = p.q[10] & !p.q[12];
                    let expected =
                        if outstanding == 0 {
                            ABSENT
                        } else { outstanding.trailing_zeros() as u64 };
                    if w[10] != expected || expected >= f.slots {
                        return reject(9);
                    }
                    let slot = expected as usize;
                    if w[1] == 6 {
                        if rr(b, slot, 0) != 1 || rr(b, slot, 3) != 0 ||
                                rr(b, slot, 2) != w[13] {
                            return reject(9);
                        }
                        sq(c, 13, expected);
                    } else if w[1] == 7 {
                        if p.q[13] != expected || rr(b, slot, 0) != 1 ||
                                    rr(b, slot, 3) != 0 || rr(b, slot, 2) != w[13] {
                            return reject(9);
                        }
                        c.copy_within(1944..2008, 1536);
                        st(c, 1544, ABSENT);
                        resident_delta = expected;
                        sq(c, 6, count - 1);
                        sq(c, 7, total - w[13]);
                        sq(c, 11, p.q[11] | (1 << expected));
                    } else {
                        if p.q[13] != expected || p.q[11] & (1 << expected) == 0 ||
                                rr(b, slot, 0) != 0 {
                            return reject(9);
                        }
                        if w[13] != ld(b, SCALAR.base + 138 * 8) {
                            return reject(9);
                        }
                        sq(c, 12, p.q[12] | (1 << expected));
                        sq(c, 13, ABSENT);
                    }
                }
                9 | 10 => {
                    if p.q[15] != 1 || p.q[12] != p.q[10] || w[13] != cq(c, 18)
                        {
                        return reject(if w[13] != cq(c, 18) { 10 } else { 9 });
                    }
                }
                11 => {
                    if w[12] != p.q[9] || p.q[9] == ABSENT {
                        return reject(12);
                    }
                    if first_pin != cq(c, 16) || w[11] != first_pin ||
                            first_pin >= f.pins {
                        return reject(11);
                    }
                    let slot = if w[13] == 0 { cq(c, 17) } else { p.q[14] };
                    if slot >= f.slots || w[10] != slot { return reject(7); }
                    let slot = slot as usize;
                    if w[13] == 0 {
                        if rr(b, slot, 0) != 1 || rr(b, slot, 1) != w[6] ||
                                rr(b, slot, 2) != w[14] {
                            return reject(7);
                        }
                        c[1536..1600].copy_from_slice(&b[RESIDENT.base +
                                            slot * 64..RESIDENT.base + slot * 64 + 64]);
                    } else {
                        if p.q[15] != 1 || p.q[10] != p.q[12] || rr(b, slot, 0) != 0
                                || w[14] != cq(c, 18) {
                            return reject(9);
                        }
                        c.copy_within(1944..2008, 1536);
                        st(c, 1536, 1);
                        st(c, 1544, w[6]);
                        st(c, 1552, w[14]);
                        st(c, 1576, w[3]);
                        sq(c, 6, count + 1);
                        let Some(sum) =
                            total.checked_add(w[14]) else { return reject(10); };
                        sq(c, 7, sum);
                    }
                    let prior_pins = ld(c, 1560);
                    let Some(pins) =
                        prior_pins.checked_add(1) else { return reject(11); };
                    if w[15] != pins || pins > f.pins || p.q[8] == f.pins {
                        return reject(11);
                    }
                    st(c, 1560, pins);
                    st(c, 1568, w[4]);
                    st(c, 1600, slot as u64);
                    st(c, 1608, w[12]);
                    st(c, 1616, w[3]);
                    st(c, 1624, w[3]);
                    st(c, 1632, w[4]);
                    st(c, 1640, w[5]);
                    resident_delta = slot as u64;
                    pin_delta = first_pin;
                    sq(c, 8, p.q[8] + 1);
                    sq(c, 9, p.q[9] + 1);
                }
                12 => {
                    let slot = w[10] as usize;
                    let pin = w[11] as usize;
                    if slot >= f.slots as usize || pin >= f.pins as usize ||
                                pr(b, pin, 0) != w[10] || pr(b, pin, 1) != w[12] {
                        return reject(11);
                    }
                    if rr(b, slot, 0) != 1 || rr(b, slot, 1) != w[6] ||
                                        rr(b, slot, 2) != w[13] || rr(b, slot, 3) == 0 ||
                                p.q[8] == 0 || w[15] != rr(b, slot, 3) - 1 {
                        return reject(11);
                    }
                    c[1536..1600].copy_from_slice(&b[RESIDENT.base +
                                        slot * 64..RESIDENT.base + slot * 64 + 64]);
                    st(c, 1560, w[15]);
                    for i in 0..6 {
                        st(c, 1600 + i * 8, if i == 0 { ABSENT } else { 0 });
                    }
                    resident_delta = w[10];
                    pin_delta = w[11];
                    sq(c, 8, p.q[8] - 1);
                }
                13 => {}
                _ => return poison(SEMANTIC_RECORD),
            }
            sq(c, 0, w[0]);
            sq(c, 1, w[4]);
            sq(c, 2, w[5]);
            let stage =
                match w[1] {
                    1 => 1,
                    2 => { if w[13] == 1 { 2 } else { 3 } }
                    3 => 4,
                    4 => 5,
                    5 | 8 => 6,
                    6 => 7,
                    7 => 8,
                    9 => 9,
                    10 => 10,
                    _ => 0,
                };
            sq(c, 3, stage);
            sq(c, 4, if stage == 0 { 0 } else { w[3] });
            sq(c, 5, if stage == 0 { ABSENT } else { w[6] });
            if resident_delta != ABSENT {
                let at = RESIDENT.base + resident_delta as usize * 64;
                b[at..at + 64].copy_from_slice(&c[1536..1600]);
                if !commit_succeeded() {
                    return SemanticReply {
                            status: 3,
                            reason: 16,
                            debit: SEMANTIC_RECORD,
                        };
                }
            }
            if pin_delta != ABSENT {
                let at = PIN.base + pin_delta as usize * 48;
                b[at..at + 48].copy_from_slice(&c[1600..1648]);
            }
            if plan_delta != ABSENT {
                let at = PLAN.base + plan_delta as usize * 40;
                b[at..at + 40].copy_from_slice(&c[1648..1688]);
            }
            for i in 0..10 {
                let source = SC + (6 + i) * 8;
                let destination = SCALAR.base + ROW_CELLS[i] * 8;
                b[destination..destination +
                                8].copy_from_slice(&c[source..source + 8]);
            }
            for i in 0..2 {
                let source = SC + (17 + i) * 8;
                let destination = SCALAR.base + EXTRA_CELLS[i] * 8;
                b[destination..destination +
                                8].copy_from_slice(&c[source..source + 8]);
            }
            if w[1] == 6 { st(b, SCALAR.base + 138 * 8, w[13]); }
            SemanticReply { status: 1, reason: 0, debit: SEMANTIC_RECORD }
        }
        fn cleanup(b: &[u8], c: &mut Candidate2048) -> bool {
            if b.len() != ARENA_BYTES { return false; }
            let zero = [0u8; 8];
            for i in 0..256 {
                let at = i * 8;
                c[at..at + 8].copy_from_slice(&zero);
            }
            for i in 0..12 {
                let source = SCALAR.base + CELLS[i] * 8;
                let destination = 888 + i * 8;
                c[destination..destination +
                                8].copy_from_slice(&b[source..source + 8]);
            }
            true
        }
        impl FixtureCacheStateObservationV1 {
            pub fn observed_records(&self) -> u64 { self.extent[0] }
            pub fn cache_state_records(&self) -> u64 { self.extent[1] }
            pub fn stop_record(&self) -> u64 { self.extent[2] }
            pub fn last_sequence(&self) -> u64 { self.extent[3] }
            pub fn last_work(&self) -> u64 { self.extent[4] }
            pub fn last_instructions(&self) -> u64 { self.extent[5] }
            pub fn active_operation(&self) -> u64 { self.extent[6] }
            pub fn requested_function(&self) -> u64 { self.extent[7] }
            pub fn resident_count(&self) -> u64 { self.extent[8] }
            pub fn resident_bytes(&self) -> u64 { self.extent[9] }
            pub fn held_pins(&self) -> u64 { self.extent[10] }
            pub fn next_nonce(&self) -> u64 { self.extent[11] }
            pub fn active_plan_cell(&self) -> u64 { self.extent[12] }
            pub fn selected_mask(&self) -> u64 { self.extent[13] }
            pub fn taken_mask(&self) -> u64 { self.extent[14] }
            pub fn committed_mask(&self) -> u64 { self.extent[15] }
            pub fn pending_victim(&self) -> u64 { self.extent[16] }
            pub fn destination(&self) -> u64 { self.extent[17] }
            pub fn failure_coordinate(&self) -> u64 { self.extent[18] }
            pub fn semantic_debit(&self) -> u64 { self.extent[19] }
            pub fn semantic_setup_paid(&self) -> u64 { self.extent[20] }
            pub fn semantic_finish_paid(&self) -> u64 { self.extent[21] }
            pub fn fixture_state_observed(&self) -> u64 { self.extent[22] }
            pub fn tail_unknown(&self) -> u64 { self.extent[23] }
            pub fn reserved0(&self) -> u64 { self.extent[28] }
            pub fn reserved1(&self) -> u64 { self.extent[29] }
        }
        fn why(n: u64) -> FixtureCacheStateReasonV1 {
            use FixtureCacheStateReasonV1::*;
            match n {
                0 => Observed,
                1 => Steps,
                2 => FramingUnavailable,
                3 => FramingInvalid,
                4 => EnvelopeRefused,
                5 => EnvelopeUnavailable,
                6 => Identity,
                7 => Resident,
                8 => Plan,
                9 => Victim,
                10 => Bytes,
                11 => Token,
                12 => Nonce,
                13 => Invariant,
                14 => FailureApplicability,
                15 => IncompleteBoundary,
                16 => InternalPoison,
                _ => OutputUnavailable,
            }
        }
        fn projection(p: &Progress, paid: &Paid, s: &Framing,
            input: &Result<bool, AnalyzerError>,
            env: &FixtureEnvelopeObservationV1, f: Option<&Fixture>)
            -> FixtureCacheStateObservationV1 {
            use FixtureCacheStateBoundaryV1 as B;
            let mut z =
                FixtureCacheStateObservationV1 {
                    boundary: B::Unavailable,
                    reason: why(5),
                    extent: [0; 30],
                };
            z.extent[19] =
                512 * paid.setup + 256 * paid.finish + 7680 * paid.records;
            z.extent[20] = paid.setup;
            z.extent[21] = paid.finish;
            if let Err(e) = input {
                z.boundary =
                    if e.code == BUDGET {
                        B::AnalysisLimited
                    } else { B::Unavailable };
                z.reason =
                    why(if e.code == BINDING {
                            2
                        } else if e.code == BUDGET { 1 } else { 3 });
                return z;
            }
            if #[allow(non_exhaustive_omitted_patterns)] match env.reason() {
                        FixtureEnvelopeReasonV1::InternalPoisoned => true,
                        _ => false,
                    } || p.terminal() == 16 {
                z.boundary = B::InternalPoisoned;
                z.reason = why(16);
                return z;
            }
            if p.latch >> 8 > 64 || f.is_some_and(|v| p.latch >> 8 > v.pins)
                            || p.calls > paid.records ||
                        (p.calls == 0 && p.terminal() != 0) ||
                    (p.terminal() != 0 && p.terminal() != 1 &&
                            !(6..=14).contains(&p.terminal())) {
                z.boundary = B::InternalPoisoned;
                z.reason = why(16);
                return z;
            }
            let child =
                match (env.boundary(), env.reason()) {
                    (FixtureEnvelopeBoundaryV1::Unavailable,
                        FixtureEnvelopeReasonV1::EnvelopeUnavailable |
                        FixtureEnvelopeReasonV1::UnavailableState) => 0,
                    (FixtureEnvelopeBoundaryV1::Refused, _) => 1,
                    (FixtureEnvelopeBoundaryV1::AnalysisLimited,
                        FixtureEnvelopeReasonV1::Steps |
                        FixtureEnvelopeReasonV1::Shape |
                        FixtureEnvelopeReasonV1::Coordinate |
                        FixtureEnvelopeReasonV1::TerminalPhase |
                        FixtureEnvelopeReasonV1::Phase |
                        FixtureEnvelopeReasonV1::ReleaseOpen |
                        FixtureEnvelopeReasonV1::TerminalFailure |
                        FixtureEnvelopeReasonV1::PinFailure |
                        FixtureEnvelopeReasonV1::ForbiddenResume |
                        FixtureEnvelopeReasonV1::Acquire |
                        FixtureEnvelopeReasonV1::Identity |
                        FixtureEnvelopeReasonV1::Stage |
                        FixtureEnvelopeReasonV1::PublicationForm |
                        FixtureEnvelopeReasonV1::CheckedAccess) => 1,
                    (FixtureEnvelopeBoundaryV1::AnalysisLimited,
                        FixtureEnvelopeReasonV1::FramingLimited) if
                        #[allow(non_exhaustive_omitted_patterns)] match input {
                                    Ok(false) => true,
                                    _ => false,
                                } && s.limited && !s.complete => 2,
                    (FixtureEnvelopeBoundaryV1::CapCutUnknownTail,
                        FixtureEnvelopeReasonV1::Observed) if
                        #[allow(non_exhaustive_omitted_patterns)] match input {
                                        Ok(true) => true,
                                        _ => false,
                                    } && s.complete && !s.limited && s.flags == 1 => {
                        3
                    }
                    (FixtureEnvelopeBoundaryV1::ClosedEnvelopeObserved,
                        FixtureEnvelopeReasonV1::Observed) if
                        #[allow(non_exhaustive_omitted_patterns)] match input {
                                        Ok(true) => true,
                                        _ => false,
                                    } && s.complete && !s.limited && s.flags == 0 => 4,
                    _ => 0,
                };
            if child == 0 { return z; }
            if child == 1 {
                z.boundary = B::Refused;
                z.reason = why(4);
                return z;
            }
            if p.calls == 0 && p.terminal() == 0 { return z; }
            let Some(f) =
                f else {
                    z.boundary = B::InternalPoisoned;
                    z.reason = why(16);
                    return z;
                };
            if p.calls > paid.records || s.framed > paid.records ||
                        !shape_q(&p.q, p.calls, p.terminal(), s.framed, f) ||
                    (p.terminal() == 0 && child == 4 && p.q[3] != 0) {
                z.boundary = B::InternalPoisoned;
                z.reason = why(16);
                return z;
            }
            let q = &p.q;
            let stage = q[3];
            let active = stage != 0;
            let planned = (6..=10).contains(&stage);
            let pending = stage == 7 || stage == 8;
            z.boundary =
                if p.terminal() == 14 {
                    B::ApplicabilityUnavailable
                } else if p.terminal() == 1 {
                    B::AnalysisLimited
                } else if p.terminal() != 0 {
                    B::Refused
                } else if child == 2 {
                    B::AnalysisLimited
                } else if child == 3 {
                    B::CapCutUnknownTail
                } else { B::ClosedFixtureObserved };
            z.reason =
                why(if p.terminal() != 0 {
                        p.terminal()
                    } else if child == 2 { 1 } else { 0 });
            z.extent[0] = s.framed;
            z.extent[1] = q[0];
            z.extent[2] =
                if p.terminal() != 0 {
                    q[0] + 1
                } else if child == 2 { s.framed + 1 } else { 0 };
            z.extent[3] = q[0];
            z.extent[4] = q[1];
            z.extent[5] = q[2];
            z.extent[6] = if active { q[4] } else { 0 };
            z.extent[7] = if active { q[5] } else { ABSENT };
            z.extent[8] = q[6];
            z.extent[9] = q[7];
            z.extent[10] = q[8];
            z.extent[11] = q[9];
            z.extent[12] =
                if (3..=10).contains(&stage) { q[5] & 511 } else { ABSENT };
            z.extent[13] = if planned { q[10] } else { 0 };
            z.extent[14] = if planned { q[11] } else { 0 };
            z.extent[15] = if planned { q[12] } else { 0 };
            z.extent[16] = if pending { q[13] } else { ABSENT };
            z.extent[17] = if planned && q[15] == 1 { q[14] } else { ABSENT };
            z.extent[18] = if p.terminal() == 14 { q[0] + 1 } else { 0 };
            z.extent[22] = 1;
            z.extent[23] = u64::from(p.terminal() != 0 || child != 4);
            z
        }
        fn cache_walk<T: InputFile>(input: &mut T, arena: &mut Arena,
            budget: &mut Budget, f: &Fixture, length: u64, s: &mut Framing,
            e: &mut FixtureEnvelopeProgressV1, p: &mut Progress,
            paid: &mut Paid) -> Result<(), AnalyzerError> {
            let mut reader = Reader::new(length, HEADER_STAGE);
            let mut h = [0; 64];
            reader.words(input, arena, budget, &mut h)?;
            header(arena, &h, *f, budget)?;
            budget.setup(SETUP_ENVELOPE)?;
            e.debit += SETUP_ENVELOPE;
            budget.report(FINISH_ENVELOPE)?;
            e.debit += FINISH_ENVELOPE;
            budget.report(UNDERFUNDED_GUARD)?;
            budget.report(SEMANTIC_GUARD)?;
            if arena.bytes.len() != ARENA_BYTES {
                return Err(error(INTERNAL, ARENA_STAGE, 0, 0));
            }
            let mut candidate: Candidate2048 = [0; 2048];
            for i in 0..12 {
                let at = SCALAR.base + CELLS[i] * 8;
                st(&mut arena.bytes, at,
                    if i == 5 { 1 } else if i == 6 { f.mask } else { 0 });
            }
            p.q[5] = ABSENT;
            p.q[9] = 1;
            p.q[13] = ABSENT;
            p.q[14] = ABSENT;
            st(&mut arena.bytes, SCALAR.base + 17 * 8, 1);
            st(&mut arena.bytes, SCALAR.base + 24 * 8, f.slots);
            st(&mut arena.bytes, SCALAR.base + 25 * 8, f.pins);
            st(&mut arena.bytes, SCALAR.base + 26 * 8, f.base);
            st(&mut arena.bytes, SCALAR.base + 27 * 8, f.capacity);
            st(&mut arena.bytes, SCALAR.base + 28 * 8, f.entry);
            reader.stage = RECORD_STAGE;
            for index in 0..s.physical {
                if budget.replay_left < RECORD_PREFLIGHT {
                    s.limited = true;
                    break;
                }
                budget.replay(CACHE_COMBINED)?;
                e.debit += RECORD_ENVELOPE;
                paid.records += 1;
                let mut w = [0; 16];
                reader.words(input, arena, budget, &mut w)?;
                let offset = 512 + index * 128;
                if !record_fields(arena, &w, *f) {
                    return Err(error(SCHEMA, RECORD_STAGE, offset, index + 1));
                }
                if !s.coordinate(&w) {
                    return Err(error(COORDINATE, RECORD_STAGE, offset,
                                index + 1));
                }
                if p.terminal() != 16 && leaf_pending(e) {
                    let record = FixtureDecodedRecordV1 { words: &w };
                    let mut steps =
                        StepBudget { remaining: RECORD_ENVELOPE, spent: 0 };
                    let received =
                        observe_fixture_envelope_v1(&mut arena.bytes,
                            &mut candidate, &record, &mut steps);
                    e.reply = received;
                    e.reply_valid = 1;
                    if !reply_debit_valid(&e.reply, &steps) {
                        e.reply = poisoned(RECORD_ENVELOPE);
                        p.latch_terminal(16);
                    }
                    if e.reply.words[0] == 3 || e.reply.words[1] == 15 {
                        p.latch_terminal(16);
                    }
                    if p.terminal() == 0 && e.reply.words[0] == 1 &&
                            e.reply.words[1] == 0 {
                        if arena.bytes.len() != ARENA_BYTES {
                            p.latch_terminal(16);
                        } else {
                            let loan = Loan { record: &record, config: f };
                            let mut semantic_steps =
                                StepBudget { remaining: SEMANTIC_RECORD, spent: 0 };
                            let received =
                                semantic(&mut arena.bytes, &mut candidate, &loan, p,
                                    &mut semantic_steps);
                            p.calls += 1;
                            if received.status == 1 && received.reason == 0 &&
                                            received.debit == SEMANTIC_RECORD &&
                                        semantic_steps.spent == SEMANTIC_RECORD &&
                                    semantic_steps.remaining == 0 {
                                for i in 0..16 { p.q[i] = cq(&candidate, i); }
                                p.remember_pin(cq(&candidate, 16));
                            } else if received.status == 2 &&
                                        (received.reason == 1 ||
                                                (6..=14).contains(&received.reason)) &&
                                    ((received.debit == SEMANTIC_RECORD &&
                                                        semantic_steps.spent == SEMANTIC_RECORD &&
                                                    semantic_steps.remaining == 0) ||
                                            (received.reason == 1 && received.debit == 0 &&
                                                        semantic_steps.spent == 0 &&
                                                    semantic_steps.remaining < SEMANTIC_RECORD)) {
                                p.latch_terminal(received.reason);
                            } else { p.latch_terminal(16); }
                            if !cleanup(&arena.bytes, &mut candidate) {
                                p.latch_terminal(16);
                            }
                        }
                    }
                }
            }
            if s.limited {
                let target = length - 512;
                while reader.consumed < target {
                    budget.setup(1)?;
                    let available = (reader.used - reader.cursor) as u64;
                    let n = available.min(target - reader.consumed);
                    reader.cursor += n as usize;
                    reader.consumed += n;
                    if reader.consumed == target { break; }
                    if reader.cursor != reader.used {
                        return Err(error(INTERNAL, RECORD_STAGE, reader.consumed,
                                    0));
                    }
                    let count =
                        (reader.length - reader.loaded).min(65536) as usize;
                    bounded_read(input,
                            &mut arena.bytes[BLOCK.base..BLOCK.base + count], budget,
                            RECORD_STAGE, reader.loaded)?;
                    reader.loaded += count as u64;
                    reader.used = count;
                    reader.cursor = 0;
                }
            }
            reader.stage = FOOTER_STAGE;
            let mut foot = [0; 64];
            reader.words(input, arena, budget, &mut foot)?;
            footer(&h, &foot, length, s, budget)?;
            eof(input, budget, FOOTER_STAGE, length)?;
            s.complete = !s.limited;
            Ok(())
        }
        fn cache_inputs<S: InputFile, P: InputFile,
            C: InputFile>(stream: &mut S, profile_file: &mut P,
            context: &mut C, arena: &mut Arena, budget: &mut Budget,
            s: &mut Framing, e: &mut FixtureEnvelopeProgressV1,
            p: &mut Progress, paid: &mut Paid, config: &mut Option<Fixture>)
            -> Result<bool, AnalyzerError> {
            let before_s = initial(stream, budget)?;
            let before_p = initial(profile_file, budget)?;
            let before_c = initial(context, budget)?;
            if before_s.len() < 1024 || before_s.len() > STREAM_CAP ||
                            (before_s.len() - 1024) % 128 != 0 ||
                        before_p.len() != PROFILE_BYTES ||
                    before_c.len() != CONTEXT_BYTES {
                return Err(error(INPUT, ADMISSION_STAGE, 0, 0));
            }
            s.physical = (before_s.len() - 1024) / 128;
            let f = fixture_context(context, arena, budget)?;
            profile(profile_file, arena, budget, f)?;
            *config = Some(f);
            cache_walk(stream, arena, budget, &f, before_s.len(), s, e, p,
                    paid)?;
            stable(stream, before_s, budget)?;
            stable(profile_file, before_p, budget)?;
            stable(context, before_c, budget)?;
            Ok(s.complete)
        }
        macro_rules! cache_body {
            ($input_s:ident,$input_p:ident,$input_c:ident,$output_f:ident,$limit:expr)
            =>
            {{
                    let stream = $input_s; let profile_file = $input_p; let
                    context = $input_c; let output = $output_f; let limit =
                    $limit; let mut budget = Budget::new(limit)?;
                    budget.setup(SETUP_WRAPPER)?; budget.report(FINAL_WRAPPER)?;
                    budget.report(SEMANTIC_FINISH)?;
                    budget.setup(SEMANTIC_SETUP)?; let mut paid = Paid
                    { setup: 1, finish: 1, records: 0, }; let output_initial =
                    output_safety(stream, profile_file, context, output, &mut
                    budget)?; let mut arena = Arena::new(&mut budget)?; let mut
                    s = Framing::new(0); let mut e = FixtureEnvelopeProgressV1
                    {
                        reply_valid: 0, debit: 0, reply: FixtureEnvelopeReplyV1
                        { words: [0; 16] },
                    }; let mut p = Progress { calls: 0, latch: 0, q: [0; 16], };
                    let mut config = None; let result =
                    cache_inputs(stream, profile_file, context, &mut arena, &mut
                    budget, &mut s, &mut e, &mut p, &mut paid, &mut config,);
                    let mut observation = error(BINDING, CONTEXT_STAGE, 0, 0);
                    let mut decision = Decision::Unavailable; let mut framed =
                    false; if let Err(err) = result
                    {
                        observation = err; decision = if err.code == BINDING
                        { Decision::Unavailable } else if err.code == BUDGET
                        { Decision::AnalysisLimited } else { Decision::Invalid };
                    } else if s.limited
                    {
                        observation =
                        error(BUDGET, RECORD_STAGE, 512 + s.framed * 128, s.framed +
                        1); decision = Decision::AnalysisLimited;
                    } else { framed = result.unwrap_or(false); } let envelope =
                    finalize(&e, &s, &result, &arena); let cache_state =
                    projection(&p, &paid, &s, &result, &envelope,
                    config.as_ref()); let mut framing = ReplayOutcome
                    {
                        decision, framed_records: s.framed, physical_records:
                        s.physical, report_bytes: 0, steps_used: 0,
                        input_bytes_read: budget.read_bytes, input_attempts:
                        budget.io_spent, output_attempts: 0, observation,
                        fixture_framing: u64::from(framed),
                    };
                    write_report(output, output_initial, &mut arena, &mut
                    budget, &mut framing, s,)?; if budget.used() > budget.limit
                    { return Err(error(BUDGET, OUTPUT_STAGE, 0, 0)); }
                    Ok(FixtureCacheStateOutcomeV1
                    { framing, envelope, cache_state, })
                }};
        }
        /// Four distinct, quiescent regular Files at offset0; empty exclusive output.
        /// Only parsed synthetic MIXFIX01/MIXPRF01 identity is observed.
        pub fn analyze_fixture_cache_state_v1(stream: &mut File,
            profile_file: &mut File, context: &mut File, output: &mut File)
            -> Result<FixtureCacheStateOutcomeV1, AnalyzerError> {
            {
                let stream = stream;
                let profile_file = profile_file;
                let context = context;
                let output = output;
                let limit = STEP_LIMIT;
                let mut budget = Budget::new(limit)?;
                budget.setup(SETUP_WRAPPER)?;
                budget.report(FINAL_WRAPPER)?;
                budget.report(SEMANTIC_FINISH)?;
                budget.setup(SEMANTIC_SETUP)?;
                let mut paid = Paid { setup: 1, finish: 1, records: 0 };
                let output_initial =
                    output_safety(stream, profile_file, context, output,
                            &mut budget)?;
                let mut arena = Arena::new(&mut budget)?;
                let mut s = Framing::new(0);
                let mut e =
                    FixtureEnvelopeProgressV1 {
                        reply_valid: 0,
                        debit: 0,
                        reply: FixtureEnvelopeReplyV1 { words: [0; 16] },
                    };
                let mut p = Progress { calls: 0, latch: 0, q: [0; 16] };
                let mut config = None;
                let result =
                    cache_inputs(stream, profile_file, context, &mut arena,
                        &mut budget, &mut s, &mut e, &mut p, &mut paid,
                        &mut config);
                let mut observation = error(BINDING, CONTEXT_STAGE, 0, 0);
                let mut decision = Decision::Unavailable;
                let mut framed = false;
                if let Err(err) = result {
                    observation = err;
                    decision =
                        if err.code == BINDING {
                            Decision::Unavailable
                        } else if err.code == BUDGET {
                            Decision::AnalysisLimited
                        } else { Decision::Invalid };
                } else if s.limited {
                    observation =
                        error(BUDGET, RECORD_STAGE, 512 + s.framed * 128,
                            s.framed + 1);
                    decision = Decision::AnalysisLimited;
                } else { framed = result.unwrap_or(false); }
                let envelope = finalize(&e, &s, &result, &arena);
                let cache_state =
                    projection(&p, &paid, &s, &result, &envelope,
                        config.as_ref());
                let mut framing =
                    ReplayOutcome {
                        decision,
                        framed_records: s.framed,
                        physical_records: s.physical,
                        report_bytes: 0,
                        steps_used: 0,
                        input_bytes_read: budget.read_bytes,
                        input_attempts: budget.io_spent,
                        output_attempts: 0,
                        observation,
                        fixture_framing: u64::from(framed),
                    };
                write_report(output, output_initial, &mut arena, &mut budget,
                        &mut framing, s)?;
                if budget.used() > budget.limit {
                    return Err(error(BUDGET, OUTPUT_STAGE, 0, 0));
                }
                Ok(FixtureCacheStateOutcomeV1 {
                        framing,
                        envelope,
                        cache_state,
                    })
            }
        }
    }
    pub use cache_state::{
        analyze_fixture_cache_state_v1, FixtureCacheStateBoundaryV1,
        FixtureCacheStateReasonV1, FixtureCacheStateObservationV1,
        FixtureCacheStateOutcomeV1,
    };
}
