const FUNCTION: Region = Region { base: 0, rows: 80_000, stride: 96 };
const RESIDENT: Region = Region { base: 7_680_000, rows: 64, stride: 64 };
const PIN: Region = Region { base: 7_684_096, rows: 64, stride: 48 };
const PLAN: Region = Region { base: 7_687_168, rows: 512, stride: 40 };
const RECENCY: Region = Region { base: 7_707_648, rows: 64, stride: 8 };
const WINDOW: Region = Region { base: 7_708_160, rows: 128, stride: 128 };
const HISTOGRAM: Region = Region { base: 7_724_544, rows: 396, stride: 8 };
const TOP: Region = Region { base: 7_727_712, rows: 32, stride: 64 };
const SCALAR: Region = Region { base: 7_729_760, rows: 512, stride: 8 };
const CONTEXT: Region = Region { base: 7_733_856, rows: 1024, stride: 8 };
const BLOCK: Region = Region { base: 7_742_048, rows: 1, stride: 65_536 };
const REPORT: Region = Region { base: 7_807_584, rows: 8192, stride: 8 };
const REGIONS: [Region; 12] =
    [FUNCTION, RESIDENT, PIN, PLAN, RECENCY, WINDOW, HISTOGRAM, TOP, SCALAR,
            CONTEXT, BLOCK, REPORT];

struct Arena {
    bytes: Vec<u8>,
}
impl Arena {
    fn new(budget: &mut Budget) -> Result<Self, AnalyzerError> {
        Self::new_with(budget, |v, n| v.try_reserve_exact(n))
    }
    fn new_with(budget: &mut Budget,
        reserve: fn(&mut Vec<u8>, usize) -> Result<(), TryReserveError>)
        -> Result<Self, AnalyzerError> {
        let mut bytes = Vec::new();
        reserve(&mut bytes,
                    ARENA_BYTES).map_err(|_|
                    error(ALLOCATION, ARENA_STAGE, 0, 0))?;
        if bytes.capacity() != ARENA_BYTES {
            return Err(error(CAPACITY, ARENA_STAGE, 0, 0));
        }
        let zero = [0u8; 8];
        for _ in 0..ARENA_BYTES / 8 {
            budget.replay(1)?;
            bytes.extend_from_slice(&zero);
        }
        let mut end = 0usize;
        for region in REGIONS {
            budget.setup(1)?;
            let next =
                region.rows.checked_mul(region.stride).and_then(|n|
                                region.base.checked_add(n)).ok_or(error(BOUNDS, ARENA_STAGE,
                            0, 0))?;
            if region.base != end || next > ARENA_BYTES {
                return Err(error(BOUNDS, ARENA_STAGE, 0, 0));
            }
            end = next;
        }
        let mut arena = Self { bytes };
        for i in 0..64 {
            budget.setup(1)?;
            arena.put64(RESIDENT, i, 8, ABSENT)?;
            arena.put64(PIN, i, 0, ABSENT)?;
            arena.put64(RECENCY, i, 0, ABSENT)?;
        }
        for i in 0..512 {
            budget.setup(1)?;
            arena.put64(PLAN, i, 0, ABSENT)?;
        }
        for i in 0..128 {
            budget.setup(1)?;
            arena.put64(WINDOW, i, 14 * 8, ABSENT)?;
        }
        for i in 0..32 { budget.setup(1)?; arena.put64(TOP, i, 0, ABSENT)?; }
        Ok(arena)
    }
    fn range(region: Region, index: usize, field: usize, width: usize)
        -> Result<std::ops::Range<usize>, AnalyzerError> {
        let fail = error(BOUNDS, ARENA_STAGE, 0, 0);
        if index >= region.rows ||
                field.checked_add(width).is_none_or(|n| n > region.stride) {
            return Err(fail);
        }
        let start =
            index.checked_mul(region.stride).and_then(|n|
                                region.base.checked_add(n)).and_then(|n|
                            n.checked_add(field)).ok_or(fail)?;
        let end = start.checked_add(width).ok_or(fail)?;
        let region_end =
            region.rows.checked_mul(region.stride).and_then(|n|
                            region.base.checked_add(n)).ok_or(fail)?;
        if end > region_end || region_end > ARENA_BYTES { return Err(fail); }
        Ok(start..end)
    }
    fn get64(&self, region: Region, row: usize, field: usize)
        -> Result<u64, AnalyzerError> {
        let bytes =
            self.bytes.get(Self::range(region, row, field,
                                8)?).ok_or(error(BOUNDS, ARENA_STAGE, 0, 0))?;
        let mut value = [0; 8];
        value.copy_from_slice(bytes);
        Ok(u64::from_le_bytes(value))
    }
    fn put64(&mut self, region: Region, row: usize, field: usize, value: u64)
        -> Result<(), AnalyzerError> {
        let bytes =
            self.bytes.get_mut(Self::range(region, row, field,
                                8)?).ok_or(error(BOUNDS, ARENA_STAGE, 0, 0))?;
        bytes.copy_from_slice(&value.to_le_bytes());
        Ok(())
    }
    fn get32(&self, region: Region, row: usize, field: usize)
        -> Result<u32, AnalyzerError> {
        let bytes =
            self.bytes.get(Self::range(region, row, field,
                                4)?).ok_or(error(BOUNDS, ARENA_STAGE, 0, 0))?;
        let mut value = [0; 4];
        value.copy_from_slice(bytes);
        Ok(u32::from_le_bytes(value))
    }
    fn put32(&mut self, region: Region, row: usize, field: usize, value: u32)
        -> Result<(), AnalyzerError> {
        let bytes =
            self.bytes.get_mut(Self::range(region, row, field,
                                4)?).ok_or(error(BOUNDS, ARENA_STAGE, 0, 0))?;
        bytes.copy_from_slice(&value.to_le_bytes());
        Ok(())
    }
}

struct Budget {
    limit: u64,
    replay_left: u64,
    replay_spent: u64,
    io_spent: u64,
    setup_spent: u64,
    report_spent: u64,
    read_bytes: u64,
}
#[automatically_derived]
#[doc(hidden)]
unsafe impl ::core::clone::TrivialClone for Budget { }
#[automatically_derived]
impl ::core::clone::Clone for Budget {
    #[inline]
    fn clone(&self) -> Budget {
        let _: ::core::clone::AssertParamIsClone<u64>;
        *self
    }
}
#[automatically_derived]
impl ::core::marker::Copy for Budget { }
#[automatically_derived]
impl ::core::fmt::Debug for Budget {
    #[inline]
    fn fmt(&self, f: &mut ::core::fmt::Formatter) -> ::core::fmt::Result {
        let names: &'static _ =
            &["limit", "replay_left", "replay_spent", "io_spent",
                        "setup_spent", "report_spent", "read_bytes"];
        let values: &[&dyn ::core::fmt::Debug] =
            &[&self.limit, &self.replay_left, &self.replay_spent,
                        &self.io_spent, &self.setup_spent, &self.report_spent,
                        &&self.read_bytes];
        ::core::fmt::Formatter::debug_struct_fields_finish(f, "Budget", names,
            values)
    }
}
impl Budget {
    fn new(limit: u64) -> Result<Self, AnalyzerError> {
        if limit > STEP_LIMIT {
            return Err(error(BUDGET, ARENA_STAGE, 0, 0));
        }
        let replay_left =
            limit.checked_sub(REPORT_RESERVE +
                            IO_RESERVE).ok_or(error(BUDGET, ARENA_STAGE, 0, 0))?;
        Ok(Self {
                limit,
                replay_left,
                replay_spent: 0,
                io_spent: 0,
                setup_spent: 0,
                report_spent: 0,
                read_bytes: 0,
            })
    }
    fn replay(&mut self, n: u64) -> Result<(), AnalyzerError> {
        self.replay_left =
            self.replay_left.checked_sub(n).ok_or(error(BUDGET, RECORD_STAGE,
                        0, 0))?;
        self.replay_spent += n;
        Ok(())
    }
    fn setup(&mut self, n: u64) -> Result<(), AnalyzerError> {
        if self.setup_spent.checked_add(n).is_none_or(|v| v > SETUP_CAP) {
            return Err(error(BUDGET, ADMISSION_STAGE, 0, 0));
        }
        self.replay(n)?;
        self.setup_spent += n;
        Ok(())
    }
    fn io(&mut self) -> Result<(), AnalyzerError> {
        if self.io_spent == IO_RESERVE {
            return Err(error(BUDGET, ADMISSION_STAGE, 0, 0));
        }
        self.io_spent += 1;
        Ok(())
    }
    fn report(&mut self, n: u64) -> Result<(), AnalyzerError> {
        if self.report_spent.checked_add(n).is_none_or(|v| v > REPORT_RESERVE)
            {
            return Err(error(BUDGET, OUTPUT_STAGE, 0, 0));
        }
        self.report_spent += n;
        Ok(())
    }
    fn used(&self) -> u64 {
        self.replay_spent + self.io_spent + self.report_spent
    }
}

