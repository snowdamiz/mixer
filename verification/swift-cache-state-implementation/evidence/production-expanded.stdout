        candidate[920..928].copy_from_slice(&next[4].to_le_bytes());
        candidate[928..936].copy_from_slice(&next[5].to_le_bytes());
        candidate[936..944].copy_from_slice(&next[6].to_le_bytes());
        candidate[944..952].copy_from_slice(&next[7].to_le_bytes());
        candidate[952..960].copy_from_slice(&next[8].to_le_bytes());
        candidate[960..968].copy_from_slice(&next[9].to_le_bytes());
        candidate[968..976].copy_from_slice(&next[10].to_le_bytes());
        candidate[976..984].copy_from_slice(&next[11].to_le_bytes());
        arena[7_729_816..7_729_824].copy_from_slice(&candidate[888..896]);
        arena[7_729_832..7_729_840].copy_from_slice(&candidate[896..904]);
        arena[7_729_840..7_729_848].copy_from_slice(&candidate[904..912]);
        arena[7_729_848..7_729_856].copy_from_slice(&candidate[912..920]);
        arena[7_729_856..7_729_864].copy_from_slice(&candidate[920..928]);
        arena[7_729_864..7_729_872].copy_from_slice(&candidate[928..936]);
        arena[7_729_872..7_729_880].copy_from_slice(&candidate[936..944]);
        arena[7_730_272..7_730_280].copy_from_slice(&candidate[944..952]);
        arena[7_730_280..7_730_288].copy_from_slice(&candidate[952..960]);
        arena[7_730_288..7_730_296].copy_from_slice(&candidate[960..968]);
        arena[7_731_040..7_731_048].copy_from_slice(&candidate[968..976]);
        arena[7_731_048..7_731_056].copy_from_slice(&candidate[976..984]);
        reply(1, 0, &next, RECORD_ENVELOPE)
    }
    fn reason_from_leaf(value: u64) -> FixtureEnvelopeReasonV1 {
        match value {
            0 => FixtureEnvelopeReasonV1::Observed,
            1 => FixtureEnvelopeReasonV1::Steps,
            2 => FixtureEnvelopeReasonV1::Shape,
            3 => FixtureEnvelopeReasonV1::Coordinate,
            4 => FixtureEnvelopeReasonV1::TerminalPhase,
            5 => FixtureEnvelopeReasonV1::Phase,
            6 => FixtureEnvelopeReasonV1::ReleaseOpen,
            7 => FixtureEnvelopeReasonV1::TerminalFailure,
            8 => FixtureEnvelopeReasonV1::PinFailure,
            9 => FixtureEnvelopeReasonV1::ForbiddenResume,
            10 => FixtureEnvelopeReasonV1::Acquire,
            11 => FixtureEnvelopeReasonV1::Identity,
            12 => FixtureEnvelopeReasonV1::Stage,
            13 => FixtureEnvelopeReasonV1::PublicationForm,
            14 => FixtureEnvelopeReasonV1::CheckedAccess,
            15 => FixtureEnvelopeReasonV1::InternalPoisoned,
            _ => FixtureEnvelopeReasonV1::UnavailableState,
        }
    }
    fn project(p: &FixtureEnvelopeProgressV1,
        boundary: FixtureEnvelopeBoundaryV1, reason: FixtureEnvelopeReasonV1,
        extent: bool) -> FixtureEnvelopeObservationV1 {
        let w = &p.reply.words;
        FixtureEnvelopeObservationV1 {
            boundary,
            reason,
            observed_records: if extent { w[2] } else { 0 },
            state: if extent { w[3] } else { 0 },
            phase: if extent { w[4] } else { 0 },
            mask: if extent { w[5] } else { 0 },
            last_operation: if extent { w[6] } else { 0 },
            active_operation: if extent { w[7] } else { 0 },
            requested_function: if extent { w[8] } else { 0 },
            pin_failure: if extent { w[9] } else { 0 },
            terminal_failure: if extent { w[10] } else { 0 },
            last_work: if extent { w[11] } else { 0 },
            last_instructions: if extent { w[12] } else { 0 },
            envelope_debit: p.debit,
            full_replay_accepted: 0,
            stored_prefix_validated: 0,
        }
    }
    fn finalize(p: &FixtureEnvelopeProgressV1, s: &Framing,
        input: &Result<bool, AnalyzerError>, arena: &Arena)
        -> FixtureEnvelopeObservationV1 {
        use FixtureEnvelopeBoundaryV1 as B;
        use FixtureEnvelopeReasonV1 as R;
        if let Err(e) = input {
            let reason =
                if e.code == BINDING {
                    R::FramingUnavailable
                } else if e.code == BUDGET {
                    R::FramingLimited
                } else { R::FramingInvalid };
            return project(p, B::Unavailable, reason, false);
        }
        if s.flags > 1 ||
                !((s.complete && !s.limited &&
                                    #[allow(non_exhaustive_omitted_patterns)] match input {
                                        Ok(true) => true,
                                        _ => false,
                                    }) ||
                            (s.limited && !s.complete &&
                                    #[allow(non_exhaustive_omitted_patterns)] match input {
                                        Ok(false) => true,
                                        _ => false,
                                    })) {
            return project(p, B::Unavailable, R::UnavailableState, false);
        }
        if p.reply_valid == 0 {
            return project(p, B::Unavailable, R::EnvelopeUnavailable, false);
        }
        if p.reply_valid != 1 {
            return project(p, B::Unavailable, R::UnavailableState, false);
        }
        if p.reply.words[0] == 3 || p.reply.words[1] == 15 {
            return project(p,
                    if s.limited {
                        B::AnalysisLimited
                    } else { B::InternalPoisoned }, R::InternalPoisoned, false);
        }
        if !(1..=2).contains(&p.reply.words[0]) || p.reply.words[1] > 14 ||
                                        (p.reply.words[0] == 1 && p.reply.words[1] != 0) ||
                                    (p.reply.words[0] == 2 && p.reply.words[1] == 0) ||
                                p.reply.words[3] > 10 || p.reply.words[4] > 5 ||
                        p.reply.words[5] >= 64 || p.reply.words[9] > 1 ||
                p.reply.words[10] > 1 {
            return project(p, B::Unavailable, R::UnavailableState, false);
        }
        if s.limited {
            return project(p, B::AnalysisLimited,
                    if p.reply.words[0] == 2 {
                        reason_from_leaf(p.reply.words[1])
                    } else { R::FramingLimited }, true);
        }
        if p.reply.words[0] == 2 {
            return project(p, B::Refused, reason_from_leaf(p.reply.words[1]),
                    true);
        }
        if s.flags == 1 {
            return project(p, B::CapCutUnknownTail, R::Observed, true);
        }
        let expected = word_at(&arena.bytes, SCALAR.base + 8 * CELLS[6]);
        if expected.status != 1 {
            return project(p, B::InternalPoisoned, R::InternalPoisoned,
                    false);
        }
        if p.reply.words[3] == 0 && p.reply.words[4] == 5 &&
                p.reply.words[5] == expected.value {
            project(p, B::ClosedEnvelopeObserved, R::Observed, true)
        } else { project(p, B::Refused, R::IncompleteBoundary, true) }
    }
    fn leaf_pending(p: &FixtureEnvelopeProgressV1) -> bool {
        if p.reply_valid == 0 { return true; }
        if p.reply_valid != 1 || p.reply.words[0] == 3 ||
                p.reply.words[1] == 15 {
            return false;
        }
        p.reply.words[0] == 1
    }
    fn reply_debit_valid(reply: &FixtureEnvelopeReplyV1, steps: &StepBudget)
        -> bool {
        if steps.spent == RECORD_ENVELOPE {
            return steps.remaining == 0 && reply.words[13] == RECORD_ENVELOPE;
        }
        if steps.spent != 0 || reply.words[13] != 0 { return false; }
        if reply.words[1] == 15 { return reply.words[0] == 3; }
        reply.words[1] == 1 && reply.words[0] == 2 &&
            steps.remaining < RECORD_ENVELOPE
    }
    fn walk_fixture_envelope_v1<T: InputFile>(input: &mut T,
        arena: &mut Arena, budget: &mut Budget, f: Fixture, length: u64,
        s: &mut Framing, p: &mut FixtureEnvelopeProgressV1)
        -> Result<(), AnalyzerError> {
        let mut reader = Reader::new(length, HEADER_STAGE);
        let mut h = [0; 64];
        reader.words(input, arena, budget, &mut h)?;
        header(arena, &h, f, budget)?;
        budget.setup(SETUP_ENVELOPE)?;
        p.debit += SETUP_ENVELOPE;
        budget.report(FINISH_ENVELOPE)?;
        p.debit += FINISH_ENVELOPE;
        budget.report(UNDERFUNDED_GUARD)?;
        let mut candidate: Candidate2048 = [0u8; 2048];
        if arena.bytes.len() != ARENA_BYTES {
            return Err(error(INTERNAL, ARENA_STAGE, 0, 0));
        }
        for i in 0..12 {
            let value = if i == 5 { 1 } else if i == 6 { f.mask } else { 0 };
            let at = SCALAR.base + CELLS[i] * 8;
            arena.bytes[at..at + 8].copy_from_slice(&value.to_le_bytes());
        }
        reader.stage = RECORD_STAGE;
        for index in 0..s.physical {
            if budget.replay_left < RECORD_PREFLIGHT {
                s.limited = true;
                break;
            }
            budget.replay(COMBINED_RECORD)?;
            p.debit += RECORD_ENVELOPE;
            let mut w = [0; 16];
            reader.words(input, arena, budget, &mut w)?;
            let offset = 512 + index * 128;
            if !record_fields(arena, &w, f) {
                return Err(error(SCHEMA, RECORD_STAGE, offset, index + 1));
            }
            if !s.coordinate(&w) {
                return Err(error(COORDINATE, RECORD_STAGE, offset,
                            index + 1));
            }
            if leaf_pending(p) {
                let record = FixtureDecodedRecordV1 { words: &w };
                let mut steps =
                    StepBudget { remaining: RECORD_ENVELOPE, spent: 0 };
                let received =
                    observe_fixture_envelope_v1(&mut arena.bytes,
                        &mut candidate, &record, &mut steps);
                p.reply = received;
                p.reply_valid = 1;
                if !reply_debit_valid(&p.reply, &steps) {
                    p.reply = poisoned(RECORD_ENVELOPE);
                }
            }
        }
        if s.limited {
            let target = length - 512;
            while reader.consumed < target {
                budget.setup(1)?;
                let available = (reader.used - reader.cursor) as u64;
                let n = available.min(target - reader.consumed);
                reader.cursor += n as usize;
                reader.consumed += n;
                if reader.consumed == target { break; }
                if reader.cursor != reader.used {
                    return Err(error(INTERNAL, RECORD_STAGE, reader.consumed,
                                0));
                }
                let count =
                    (reader.length - reader.loaded).min(65_536) as usize;
                bounded_read(input,
                        &mut arena.bytes[BLOCK.base..BLOCK.base + count], budget,
                        RECORD_STAGE, reader.loaded)?;
                reader.loaded += count as u64;
                reader.used = count;
                reader.cursor = 0;
            }
        }
        reader.stage = FOOTER_STAGE;
        let mut foot = [0; 64];
        reader.words(input, arena, budget, &mut foot)?;
        footer(&h, &foot, length, s, budget)?;
        eof(input, budget, FOOTER_STAGE, length)?;
        s.complete = !s.limited;
        Ok(())
    }
    fn observe_inputs_fixture_envelope_v1<S: InputFile, P: InputFile,
        C: InputFile>(stream: &mut S, profile_file: &mut P, context: &mut C,
        arena: &mut Arena, budget: &mut Budget, s: &mut Framing,
        p: &mut FixtureEnvelopeProgressV1) -> Result<bool, AnalyzerError> {
        let before_s = initial(stream, budget)?;
        let before_p = initial(profile_file, budget)?;
        let before_c = initial(context, budget)?;
        if before_s.len() < 1024 || before_s.len() > STREAM_CAP ||
                        (before_s.len() - 1024) % 128 != 0 ||
                    before_p.len() != PROFILE_BYTES ||
                before_c.len() != CONTEXT_BYTES {
            return Err(error(INPUT, ADMISSION_STAGE, 0, 0));
        }
        s.physical = (before_s.len() - 1024) / 128;
        let f = fixture_context(context, arena, budget)?;
        profile(profile_file, arena, budget, f)?;
        walk_fixture_envelope_v1(stream, arena, budget, f, before_s.len(), s,
                p)?;
        stable(stream, before_s, budget)?;
        stable(profile_file, before_p, budget)?;
        stable(context, before_c, budget)?;
        Ok(s.complete)
    }
    fn analyze_fixture_envelope_core<S: InputFile, P: InputFile, C: InputFile,
        O: OutputFile>(stream: &mut S, profile_file: &mut P, context: &mut C,
        output: &mut O, limit: u64)
        -> Result<FixtureEnvelopeOutcomeV1, AnalyzerError> {
        let mut budget = Budget::new(limit)?;
        budget.setup(SETUP_WRAPPER)?;
        budget.report(FINAL_WRAPPER)?;
        let output_initial =
            output_safety(stream, profile_file, context, output,
                    &mut budget)?;
        let mut arena = Arena::new(&mut budget)?;
        let mut s = Framing::new(0);
        let mut p =
            FixtureEnvelopeProgressV1 {
                reply_valid: 0,
                debit: 0,
                reply: FixtureEnvelopeReplyV1 { words: [0; 16] },
            };
        let result =
            observe_inputs_fixture_envelope_v1(stream, profile_file, context,
                &mut arena, &mut budget, &mut s, &mut p);
        let mut observation = error(BINDING, CONTEXT_STAGE, 0, 0);
        let mut decision = Decision::Unavailable;
        let mut framed = false;
        if let Err(e) = result {
            observation = e;
            decision =
                if e.code == BINDING {
                    Decision::Unavailable
                } else if e.code == BUDGET {
                    Decision::AnalysisLimited
                } else { Decision::Invalid };
        } else if s.limited {
            observation =
                error(BUDGET, RECORD_STAGE, 512 + s.framed * 128,
                    s.framed + 1);
            decision = Decision::AnalysisLimited;
        } else { framed = result.unwrap_or(false); }
        let envelope = finalize(&p, &s, &result, &arena);
        let mut framing =
            ReplayOutcome {
                decision,
                framed_records: s.framed,
                physical_records: s.physical,
                report_bytes: 0,
                steps_used: 0,
                input_bytes_read: budget.read_bytes,
                input_attempts: budget.io_spent,
                output_attempts: 0,
                observation,
                fixture_framing: u64::from(framed),
            };
        write_report(output, output_initial, &mut arena, &mut budget,
                &mut framing, s)?;
        if budget.used() > budget.limit {
            return Err(error(BUDGET, OUTPUT_STAGE, 0, 0));
        }
        Ok(FixtureEnvelopeOutcomeV1 { framing, envelope })
    }
    /// Separate fixture-only safe-File boundary. Caller owns distinct, quiescent
    /// regular Files at offset0 and empty exclusive output, as in analyze_fixture.
    pub fn analyze_fixture_envelope_v1(stream: &mut File,
        profile_file: &mut File, context: &mut File, output: &mut File)
        -> Result<FixtureEnvelopeOutcomeV1, AnalyzerError> {
        analyze_fixture_envelope_core(stream, profile_file, context, output,
            STEP_LIMIT)
    }
