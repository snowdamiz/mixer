raise SystemExit("UNBOUND SOURCE TEMPLATE: root must freeze the new selection and exact phase argv; no execution authority exists")
"""Five automatic Engine reads; axis registration is not a prerequisite."""
import sys
sys.dont_write_bytecode = True
assert sys.flags.isolated == 1 and sys.flags.no_site == 1 and sys.flags.optimize == 0
import importlib.util
from pathlib import Path
spec = importlib.util.spec_from_file_location('axis_binding_delivery_common', Path(__file__).with_name('selection_common_axis_binding.py'))
common = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = common
spec.loader.exec_module(common)
import hashlib
import json
for name in ('StrictCommands', 'S', 'SELECTION', 'ROOT', 'OUT', 'now', 'row', 'save', 'check_sources', 'bound_context', 'manual_binding', 'ORDINARY_NAME'):
    globals()[name] = getattr(common, name)
context = bound_context()
head = context['DELIVERED_SHA']
r = json.loads((OUT / 'delivery-followup-receipt.json').read_bytes())
c = StrictCommands('engine-ci-binding', context)
assert c.run('head').decode().splitlines() == [head, r['tree']]
assert c.run('remote-main').decode().split() == [head, 'refs/heads/main']
label, source = 'engine', S['ordinaryHost']
path = source['workflow']
payload = (ROOT / path).read_bytes()
assert hashlib.sha256(payload).hexdigest() == source['workflowSHA256']
oid = hashlib.sha1(b'blob ' + str(len(payload)).encode() + b'\0' + payload).hexdigest()
content = json.loads(c.run(label + '-workflow-content'))
assert content == {'sha': oid, 'size': len(payload), 'path': path, 'type': 'file'}
registration = json.loads(c.run(label + '-workflow-registration'))
assert type(registration['id']) is int and registration['id'] > 0
assert registration['state'] == 'active' and registration['path'] == path
assert registration['name'] == ORDINARY_NAME
runs = json.loads(c.run('engine-run'))
assert len(runs) == 1, 'Automatic Engine binding pending or ambiguous; never dispatch Engine'
engine = runs[0]
assert type(engine['id']) is int and engine['id'] > 0
assert engine['head_sha'] == head and engine['event'] == 'push' and engine['run_attempt'] == 1
assert engine['workflow_id'] == registration['id'] and engine['path'] == path
assert engine['name'] == ORDINARY_NAME and source['expectedJobs'] == 6
c.complete()
check_sources()
save('engine-ci-binding.json', {'schema': 1, 'at': now(), 'head': head, 'tree': r['tree'],
     'selection': row(ROOT / SELECTION), 'delivery': row(OUT / 'delivery-followup-receipt.json'),
     'manifest': row(OUT / c.manifest_name), 'content': content, 'registration': registration,
     'engine': engine, 'engineExpectedJobs': 6, 'manualDispatchesPerformed': 0,
     'axisRegistrationRequired': False, 'admissionAdapter': c.admission_adapter,
     'authoritySnapshot': c.authority_row, 'commands': c.records,
     'allCommandsAdmittedDirectlyReapedOwnedGroupsAbsentSeparatePipesEOF': True,
     'runtimeResultsAccepted': False, 'actualJobResultsRead': False, 'artifactDownloaded': False})
print(json.dumps({'head': head, 'engineRunID': engine['id'], 'closedCommands': len(c.records), 'runtimeResultsAccepted': False}))
