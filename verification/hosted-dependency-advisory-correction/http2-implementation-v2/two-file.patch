+defmodule MixerHosted.HTTP2WireFixture.ReadObserver do
+  @moduledoc false
+  # This is a two-call observer, not a complete Plug.Conn.Adapter implementation.
+  def get_http_protocol(s), do: s.module.get_http_protocol(s.adapter)
+
+  def read_req_body(s, opts) do
+    index = s.index + 1
+    if index > 64, do: raise("HTTP/2 fixture read-event limit")
+    started = System.monotonic_time(:millisecond)
+    if index == 1, do: send(s.owner, {s.ref, :reading, started})
+
+    case s.module.read_req_body(s.adapter, opts) do
+      {tag, bytes, adapter} when tag in [:ok, :more] and is_binary(bytes) ->
+        event = %{
+          index: index,
+          tag: tag,
+          bytes: byte_size(bytes),
+          started: started,
+          finished: System.monotonic_time(:millisecond),
+          length: Keyword.get(opts, :length),
+          read_length: Keyword.get(opts, :read_length),
+          read_timeout: Keyword.get(opts, :read_timeout)
+        }
+
+        send(s.owner, {s.ref, :read, event})
+
+        {tag, bytes, %{s | adapter: adapter, index: index}}
+
+      other ->
+        # Preserve unexpected public results and exceptions for framework handling.
+        other
+    end
+  end
+end
+
+defmodule MixerHosted.HTTP2WireFixture.ProbePlug do
+  @moduledoc false
+  @behaviour Plug
+  alias MixerHosted.HTTP2WireFixture.ReadObserver
+
+  def init(opts), do: opts
+
+  def call(conn, opts) do
+    owner = Keyword.fetch!(opts, :owner)
+    ref = Keyword.fetch!(opts, :ref)
+    deadline = Keyword.fetch!(opts, :deadline)
+    {module, adapter} = conn.adapter
+    protocol = Plug.Conn.get_http_protocol(conn)
+    content_lengths = Plug.Conn.get_req_header(conn, "content-length")
+    send(owner, {ref, :entered, self(), protocol, module, content_lengths})
+    gate(ref, deadline, :release)
+    observed = %{module: module, adapter: adapter, owner: owner, ref: ref, index: 0}
+    conn = %{conn | adapter: {ReadObserver, observed}}
+    started = System.monotonic_time(:millisecond)
+
+    case Keyword.fetch!(opts, :mode) do
+      :capture ->
+        case MixerHosted.Billing.RawWebhookCapture.capture(conn) do
+          {:ok, captured, latest} ->
+            result = %{
+              kind: :capture,
+              tag: :ok,
+              body: captured.raw_body,
+              signatures: captured.signature_header_values,
+              halted: latest.halted,
+              elapsed: System.monotonic_time(:millisecond) - started
+            }
+
+            {ReadObserver, observed} = latest.adapter
+            latest = %{latest | adapter: {observed.module, observed.adapter}}
+
+            latest =
+              latest
+              |> Plug.Conn.put_resp_header("date", "Wed, 28 Oct 2026 00:00:00 GMT")
+              |> Plug.Conn.send_resp(204, "")
+
+            send(owner, {ref, :result, result})
+            latest
+
+          {:error, reason, latest} ->
+            result = %{
+              kind: :capture,
+              tag: :error,
+              reason: reason,
+              halted: latest.halted,
+              elapsed: System.monotonic_time(:millisecond) - started
+            }
+
+            send(owner, {ref, :result, result})
+            gate(ref, deadline, :dispose)
+        end
+
+      :package_read ->
+        {tag, bytes, latest} = Plug.Conn.read_body(conn, length: 32_768, read_timeout: 1_000)
+
+        result = %{
+          kind: :package_read,
+          tag: tag,
+          bytes: byte_size(bytes),
+          halted: latest.halted,
+          elapsed: System.monotonic_time(:millisecond) - started
+        }
+
+        send(owner, {ref, :result, result})
+        gate(ref, deadline, :dispose)
+    end
+  end
+
+  defp gate(ref, deadline, expected) do
+    receive do
+      {^ref, ^expected} when expected == :release ->
+        :ok
+
+      {^ref, :dispose} ->
+        exit(:normal)
+    after
+      max(deadline - System.monotonic_time(:millisecond), 0) ->
+        raise("HTTP/2 fixture gate deadline")
+    end
+  end
+end
