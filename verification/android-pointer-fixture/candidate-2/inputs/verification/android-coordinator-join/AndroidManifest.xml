<?xml version="1.0" encoding="utf-8"?>
<!-- Private, disposable verification APK. The public MixerActivity is not declared. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.mixer.android.coordinatorjoin">
  <uses-sdk android:minSdkVersion="36" android:targetSdkVersion="37" />
  <application android:theme="@android:style/Theme.Material.Light.NoActionBar"
      android:label="Mixer private ordinary coordinator join"
      android:debuggable="true" android:allowBackup="false"
      android:extractNativeLibs="true" android:supportsRtl="true">
    <activity android:name="dev.mixer.android.CoordinatorJoinActivity"
        android:exported="false" android:windowSoftInputMode="adjustResize" />
  </application>
  <instrumentation android:name="dev.mixer.android.CoordinatorJoinInstrumentation"
      android:targetPackage="dev.mixer.android.coordinatorjoin" />
</manifest>
