  "domain_bytes": "UTF8 literal mixer.runtime.identity.v2 followed by exactly one NUL, not two literal backslash/zero bytes",
  "hash": "SHA256(domain bytes || restricted deterministic CBOR entire descriptor)",
  "canonicalization": "RFC8949 restricted data model reused from release-v1: unsigned integers, booleans, text, arrays and maps with encoded keys lexicographically sorted; preferred shortest integers/lengths; no null/floats/tags/indefinite lengths. Hash covers the entire descriptor.",
  "input": {
    "format": "strict JSON; closed field sets at every object; every listed field mandatory",
    "maximumBytes": 131072,
    "maximumCanonicalBytes": 131072,
    "duplicateKeys": "reject including equivalent escaped key spellings",
    "numbers": "unsigned base10 integer tokens only; uint64 range; no decimal/exponent/negative/bool coercion",
    "strings": "Identifiers ASCII [A-Za-z0-9_.-], 1..128 bytes; labels printable ASCII1..256 without boundary spaces; startup export exact UTF-8 1..4096 bytes with no U+0000..001F/U+007F; no Unicode normalization",
    "digests": "64 lowercase hex SHA256 of named immutable build input bytes; empty sets hash their explicit serialized representation, never omit a digest"
  },
