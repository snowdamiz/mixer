+        assert_eq!(pin_ids(&phase), ids);
+        let report = phase.drain();
+        assert_eq!(report.retained_frames, 0);
+        complete_ok(phase, preparation);
+        retire(owner);
+    }
+    for cap in [63, 64, 65, 127] {
