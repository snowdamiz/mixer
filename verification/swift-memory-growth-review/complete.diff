+                    memory,
+                    table,
+                    globals,
+                    values,
+                    controls,
+                    frames,
+                },
+                operation: SwiftExecutionOperation {
+                    control,
+                    wasi,
+                    cursor,
+                },
+                previous_bound: previous,
+            },
+            cleanup: frame_cleanup,
+            lifecycle,
+        }, SwiftGrowthContext {memory_ticket: &mut buffers[3]}))
