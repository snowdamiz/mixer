                    function,
                    pc: 0,
                    locals,
                    stack: ::alloc::vec::Vec::new(),
                    labels: ::alloc::boxed::box_assume_init_into_vec_unsafe(::alloc::intrinsics::write_box_via_move(::alloc::boxed::Box::new_uninit(),
