        fn scratch_bytes() -> usize {
            2 * std::mem::size_of::<decode::PassState>() +
                                2 * std::mem::size_of::<decode::Reader<'static>>() +
                            std::mem::size_of::<[bool; MAX_ENTRIES]>() +
                        std::mem::size_of::<Meter<'static>>() +
                    3 * std::mem::size_of::<CacheFailure>() + 256
        }
        fn update_peak(usage: &mut CacheUsage, budget: CacheBudget)
            -> Result<(), CacheFailure> {
            let bytes =
                usage.fixed_reserved.checked_add(usage.resident_bytes).and_then(|n|
                                    n.checked_add(usage.construction_bytes)).and_then(|n|
                                n.checked_add(usage.scratch_reserved)).ok_or_else(||
                            {
                                failure(*usage, CacheFailureKind::Capacity,
                                    "cache_capacity_overflow", None, 0, u64::MAX,
                                    budget.capacity_bytes as u64)
                            })?;
            if bytes > budget.capacity_bytes {
                return Err(failure(*usage, CacheFailureKind::Capacity,
                            "cache_capacity", None, 0, bytes as u64,
                            budget.capacity_bytes as u64));
            }
            let total =
                bytes.checked_add(usage.source_bytes).and_then(|n|
                                n.checked_add(usage.validation_metadata_bytes)).ok_or_else(||
                            {
                                failure(*usage, CacheFailureKind::Capacity,
                                    "total_capacity_overflow", None, 0, u64::MAX,
                                    usize::MAX as u64)
                            })?;
            usage.peak_construction_bytes =
                usage.peak_construction_bytes.max(usage.construction_bytes);
            usage.peak_cache_reserved = usage.peak_cache_reserved.max(bytes);
            usage.peak_total_reserved = usage.peak_total_reserved.max(total);
            Ok(())
        }
        impl FunctionCache {
            pub const DECODER_REVISION: u32 = 1;
            pub fn new(spans: ValidatedSpans, budget: CacheBudget,
                cancellation: &Cancellation) -> Result<Self, CacheFailure> {
                let defaults = CacheBudget::default();
                let mut usage =
                    CacheUsage {
                        source_bytes: spans.source().len(),
                        validation_metadata_bytes: spans.usage().metadata_reserved,
                        scratch_reserved: scratch_bytes(),
                        ..CacheUsage::default()
                    };
                if budget.capacity_bytes > defaults.capacity_bytes ||
                                            budget.entry_bytes > defaults.entry_bytes ||
                                        budget.max_entries == 0 ||
                                    budget.max_entries > defaults.max_entries ||
                                budget.max_pins == 0 || budget.max_pins > defaults.max_pins
                        || budget.work_credits > defaults.work_credits {
                    return Err(failure(usage, CacheFailureKind::InvalidBudget,
                                "invalid_cache_budget", None, 0, 0, 0));
                }
                let entries =
                    budget.max_entries.min(spans.defined_function_count());
                usage.fixed_reserved =
                    std::mem::size_of::<Self>() +
                            entries * std::mem::size_of::<Slot>() +
                        budget.max_pins * std::mem::size_of::<PinRecord>();
                update_peak(&mut usage, budget)?;
                let mut meter =
                    Meter {
                        budget,
                        usage: &mut usage,
                        cancellation,
                        function: None,
                        offset: 0,
                    };
                meter.check()?;
                let mut slots = allocate(entries, &mut meter)?;
                for _ in 0..entries {
                    meter.work(1)?;
                    slots.push(Slot { entry: None, pins: 0, last_used: 0 });
                }
                let mut pins = allocate(budget.max_pins, &mut meter)?;
                for _ in 0..budget.max_pins {
                    meter.work(1)?;
                    pins.push(PinRecord::default());
                }
                meter.check()?;
                let owner = issue_owner(&NEXT_OWNER, &meter)?;
                usage.scratch_reserved = 0;
                Ok(Self {
                        spans,
                        budget,
                        usage,
                        owner,
                        next_nonce: 1,
                        slots,
                        pins,
                    })
            }
            pub fn identity(&self) -> CacheIdentity {
                CacheIdentity {
                    owner: self.owner,
                    validator_revision: ValidatedSpans::VALIDATOR_REVISION,
                    decoder_revision: Self::DECODER_REVISION,
                    profile: self.spans.profile(),
                }
            }
            pub fn spans(&self) -> &ValidatedSpans { &self.spans }
            pub fn usage(&self) -> CacheUsage { self.usage }
            pub fn view(&self, pin: &FunctionPin)
                -> Result<FunctionView<'_>, CacheFailure> {
                borrowed::view::<borrowed::FrozenMode>(borrowed::CacheViewParts {
                        slots: &self.slots,
                        pins: &self.pins,
                        owner: self.owner,
                    }, pin,
                    &mut borrowed::FrozenDiagnostics { usage: &self.usage })
            }
            pub fn release(&mut self, pin: FunctionPin)
                -> Result<(), ReleaseFailure> {
                let mut operation =
                    borrowed::FrozenRelease { usage: self.usage };
                borrowed::release::<borrowed::FrozenMode>(borrowed::CacheParts {
                            snapshot: &self.spans,
                            slots: &mut self.slots,
                            pins: &mut self.pins,
                            owner: self.owner,
                            next_nonce: &mut self.next_nonce,
                            usage: &mut self.usage,
                            scratch: (),
                        }, pin,
                        &mut operation).map_err(|(failure, pin)|
                        ReleaseFailure { failure, pin })
            }
            pub fn pin(&mut self, function: u32, cancellation: &Cancellation)
                -> Result<FunctionPin, CacheFailure> {
                self.usage.scratch_reserved = scratch_bytes();
                let result =
                    update_peak(&mut self.usage,
                            self.budget).and_then(|()|
                            self.pin_inner(function, cancellation));
                self.usage.scratch_reserved = 0;
                match result {
                    Ok(pin) => Ok(pin),
                    Err(mut error) => { error.usage = self.usage; Err(error) }
                }
            }
            fn pin_inner(&mut self, function: u32,
                cancellation: &Cancellation)
                -> Result<FunctionPin, CacheFailure> {
                borrowed::pin::<borrowed::FrozenMode>(borrowed::CacheParts {
                        snapshot: &self.spans,
                        slots: &mut self.slots,
                        pins: &mut self.pins,
                        owner: self.owner,
                        next_nonce: &mut self.next_nonce,
                        usage: &mut self.usage,
                        scratch: (),
                    }, function,
                    &mut borrowed::FrozenOperation {
                            budget: &self.budget,
                            cancellation,
                        })
            }
        }
    }
