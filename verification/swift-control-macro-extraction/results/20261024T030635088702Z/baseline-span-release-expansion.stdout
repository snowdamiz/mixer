pub fn json_string(s: &str) -> String {
    let mut out = String::from("\"");
    for c in s.chars() {
        match c {
            '"' => out.push_str("\\\""),
            '\\' => out.push_str("\\\\"),
            '\n' => out.push_str("\\n"),
            '\r' => out.push_str("\\r"),
            '\t' => out.push_str("\\t"),
            c if c < ' ' =>
                out.push_str(&::alloc::__export::must_use({
                                ::alloc::fmt::format(format_args!("\\u{0:04x}", c as u32))
                            })),
            c => out.push(c),
        }
    }
    out.push('"');
    out
}
