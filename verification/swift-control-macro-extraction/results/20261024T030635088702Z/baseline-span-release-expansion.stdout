        impl<'a> Meter<'a> {
            pub fn new(budget: ValidationBudget,
                cancellation: &'a Cancellation) -> Result<Self, Failure> {
                let defaults = ValidationBudget::default();
                let meter =
                    Self {
                        budget,
                        usage: Usage::default(),
                        cancellation,
                        control: FrozenControl,
                    };
                if budget.metadata_bytes > defaults.metadata_bytes ||
                            budget.scratch_bytes > defaults.scratch_bytes ||
                        budget.work_credits > defaults.work_credits {
                    return Err(meter.error(FailureKind::InvalidBudget,
                                "invalid_validation_budget", Cursor::default()));
                }
                Ok(meter)
            }
        }
        impl<C: MeterControl> Meter<'_, C> {
            pub fn source_limit(&self) -> usize {
                self.control.source_limit()
            }
            pub fn usage(&self) -> Usage { self.usage }
            pub fn error(&self, kind: FailureKind, code: &'static str,
                cursor: Cursor) -> Failure {
                Failure {
                    kind,
                    code,
                    function: cursor.function,
                    offset: cursor.offset,
                    resource: None,
                    attempted: 0,
                    limit: 0,
                    usage: self.usage,
                }
            }
            pub fn check(&self, cursor: Cursor) -> Result<(), Failure> {
                if self.cancellation.is_cancelled() {
                    Err(self.error(FailureKind::Cancelled, "cancelled", cursor))
                } else {
                    if self.control.expired() {
                        return Err(self.error(FailureKind::Cancelled,
                                    "swift_deadline", cursor));
                    }
                    Ok(())
                }
            }
            pub fn work(&mut self, credits: u64, cursor: Cursor)
                -> Result<(), Failure> {
                self.check(cursor)?;
                let attempted =
                    self.usage.work_used.checked_add(credits).ok_or_else(||
                                {
                                    self.error(FailureKind::ResourceExhausted,
                                            "validation_work",
                                            cursor).resource(Resource::Work, u64::MAX,
                                        self.budget.work_credits)
                                })?;
                if attempted > self.budget.work_credits {
                    return Err(self.error(FailureKind::ResourceExhausted,
                                    "validation_work",
                                    cursor).resource(Resource::Work, attempted,
                                self.budget.work_credits));
                }
                self.usage.work_used = attempted;
                Ok(())
            }
            pub fn reserve(&mut self, category: Resource, bytes: usize,
                cursor: Cursor) -> Result<(), Failure> {
                self.check(cursor)?;
                let (current, limit) =
                    match category {
                        Resource::Source =>
                            (self.usage.source_bytes, self.source_limit()),
                        Resource::Metadata =>
                            (self.usage.metadata_reserved, self.budget.metadata_bytes),
                        Resource::Scratch =>
                            (self.usage.scratch_reserved, self.budget.scratch_bytes),
                        Resource::Work | Resource::Profile =>
                            ::core::panicking::panic("internal error: entered unreachable code"),
                    };
                let attempted =
                    current.checked_add(bytes).ok_or_else(||
                                {
