    fn control_state_supported() -> bool {
        {
            let control: u64;
            unsafe {
                asm!("mrs {0}, fpcr",
                    out(reg)
                    control,
                    options(nomem, preserves_flags, nostack));
            }
            return control & !0x0200_0000 == 0;
        }

        #[allow(unreachable_code)]
        false
    }
    /// Numeric-v2 requires the platform's default nearest-even IEEE environment.
    /// Reject a changed rounding mode/flush-to-zero environment instead of silently
    /// running Wasm with different arithmetic. No host FP control state is modified; arithmetic probes may set normal
    /// sticky exception flags.
    pub(crate) fn environment() -> Result<(), Error> {
        environment_check().map_err(|message|
                Error::new("unsupported_float_environment", message, None, 0))
    }
    /// Same qualified-host check without allocating a diagnostic String. The owned
    /// span executor can report terminal resource failures without another allocation.
    pub(crate) fn environment_check() -> Result<(), &'static str> {
        {
            unsafe extern "C" {
                fn fegetround()
                -> std::ffi::c_int;
            }
            let nearest = unsafe { fegetround() } == 0;
            if !nearest || !control_state_supported() {
                return Err("numeric-v2 requires masked FP exceptions, nearest-even rounding and gradual underflow");
            }
            let tiny32 =
                std::hint::black_box(f32::from_bits(1)) *
                    std::hint::black_box(1.0f32);
            let tiny64 =
                std::hint::black_box(f64::from_bits(1)) *
                    std::hint::black_box(1.0f64);
            if tiny32.to_bits() == 1 && tiny64.to_bits() == 1 {
                return Ok(());
            }
        }
        Err("numeric-v2 requires nearest-even rounding and gradual underflow on a qualified host")
    }
}
mod inspect {
    //! Non-authorizing structural inventory; accepting an immediate shape here does
    //! not add that opcode to the executable profile. Strict validation is separate.
    use crate::{
        decode::Reader, validation_inventory, Error, Inventory, Limits,
    };
    pub const INVENTORY_BYTES: usize = 128 * 1024 * 1024;
    pub fn inventory(bytes: &[u8], limits: &Limits) -> Inventory {
        let validation = validation_inventory(bytes, limits);
        let mut inv =
            Inventory {
                profile: limits.profile,
                error: validation.error,
                ..Default::default()
            };
        if let Err(e) = scan(bytes, &mut inv) {
            inv.inventory_error = Some(e);
        } else { inv.complete = true; }
        inv
    }
    fn scan(bytes: &[u8], inv: &mut Inventory) -> Result<(), Error> {
        if bytes.len() > INVENTORY_BYTES {
            return Err(Error::new("limit",
                        "inspection byte ceiling is 128MiB", None, 0));
        }
        let mut r = Reader::at(bytes, 0);
        if r.take(8)? != b"\0asm\x01\0\0\0" {
            return Err(r.err("malformed", "expected Wasm version 1"));
        }
        let mut imports = 0u32;
        let mut total = 0usize;
        while r.pos < r.bytes.len() {
            let id = r.byte()?;
            let size = r.u32()? as usize;
            let base = r.offset();
            let data = r.take(size)?;
            let mut s = Reader::at(data, base);
            match id {
                2 => {
                    for _ in 0..s.count(100_000)? {
                        let module = s.name()?;
                        let name = s.name()?;
                        let kind = s.byte()?;
                        if kind != 0 {
                            return Err(s.err("inventory_unsupported",
                                        "inventory only describes function imports"));
                        }
                        let index = s.u32()?;
                        inv.imports.push((module, name, index));
                        imports += 1;
                    }
                    s.end()?;
                }
                7 => {
                    for _ in 0..s.count(100_000)? {
                        let name = s.name()?;
                        let kind = s.byte()?;
                        let index = s.u32()?;
                        inv.exports.push((name, kind, index));
                    }
                    s.end()?;
                }
                10 => {
                    for function in 0..s.count(100_000)? {
                        let size = s.u32()? as usize;
                        let base = s.offset();
                        let data = s.take(size)?;
                        let mut b = Reader::at(data, base);
                        b.function = Some(imports + function as u32);
                        for _ in 0..b.count(100_000)? {
                            b.u32()?;
                            match b.byte()? {
                                0x7f | 0x7e | 0x7d | 0x7c | 0x7b | 0x70 | 0x6f => {}
                                _ => {
                                    return Err(b.err("inventory_unsupported",
                                                "unknown local type encoding"))
                                }
                            }
                        }
                        while b.pos < b.bytes.len() {
                            total += 1;
                            if total > 16_000_000 {
                                return Err(b.err("limit",
                                            "inspection instruction ceiling exceeded"));
                            }
                            let offset = b.offset();
                            let op = b.byte()?;
                            *inv.opcodes.entry(op).or_default() += 1;
                            match op {
                                0x00 | 0x01 | 0x05 | 0x0b | 0x0f | 0x1a | 0x1b | 0x45..=0xc4
                                    | 0xd1 | 0xd3 | 0xd4 => {}
                                0x02..=0x04 => { b.signed(33)?; }
                                0x0c | 0x0d | 0x10 | 0x12 | 0x14 | 0x15 | 0x20..=0x26 | 0xd2
                                    | 0xd5 | 0xd6 => {
                                    b.u32()?;
                                }
                                0x0e => {
                                    for _ in 0..b.count(1_000_000)? { b.u32()?; }
                                    b.u32()?;
                                }
                                0x11 | 0x13 => { b.u32()?; b.u32()?; }
                                0x1c => { for _ in 0..b.count(4096)? { b.byte()?; } }
                                0x28..=0x3e => { b.u32()?; b.u32()?; }
                                0x3f | 0x40 => { b.u32()?; }
                                0x41 => { b.signed(32)?; }
                                0x42 => { b.signed(64)?; }
                                0x43 => { b.take(4)?; }
                                0x44 => { b.take(8)?; }
                                0xd0 => { b.signed(33)?; }
                                0xfc => {
                                    let sub = b.u32()?;
                                    *inv.extended_opcodes.entry(::alloc::__export::must_use({
                                                            ::alloc::fmt::format(format_args!("0xfc:{0}", sub))
                                                        })).or_default() += 1;
                                    match sub {
                                        0..=7 => {}
                                        8 | 10 | 12 | 14 => { b.u32()?; b.u32()?; }
                                        9 | 11 | 13 | 15..=17 => { b.u32()?; }
                                        _ =>
                                            return Err(b.err("inventory_unsupported",
                                                        "unknown 0xfc immediate shape")),
                                    }
                                }
                                _ =>
                                    return Err(Error::new("inventory_unsupported",
                                                ::alloc::__export::must_use({
                                                        ::alloc::fmt::format(format_args!("unknown immediate shape for opcode 0x{0:02x}; inventory is partial",
                                                                op))
                                                    }), b.function, offset)),
                            }
                        }
                    }
                    s.end()?;
                }
                _ => {}
            }
        }
        Ok(())
    }
}
mod session {
    //! Bounded persistent native sessions. Handles carry slot generations, never pointers.
    use crate::{
        ffi::{arg, arguments, boundary, bytes, limits_from, report_error},
        *,
    };
    use std::sync::{
        atomic::{AtomicBool, Ordering},
        Arc, Mutex, MutexGuard, OnceLock, TryLockError,
    };
    const SESSION_CAP: usize = 16;
    const TRANSFER_CAP: usize = 1024 * 1024;
    type Failure = (Error, u32);
    fn failure(code: &'static str, message: &str, status: u32) -> Failure {
        (Error::new(code, message, None, 0), status)
    }
    struct Session {
        instance: Mutex<Instance>,
        limits: Limits,
        cancellation: Cancellation,
        terminal: AtomicBool,
    }
    impl Session {
        fn stop(&self) {
            self.terminal.store(true, Ordering::Release);
            self.cancellation.cancel();
        }
        fn lock(&self) -> Result<MutexGuard<'_, Instance>, Failure> {
            let guard =
                match self.instance.try_lock() {
                    Ok(g) => g,
                    Err(TryLockError::WouldBlock) => {
                        return Err(failure("session_busy",
                                    "another session operation is running", 3))
                    }
                    Err(TryLockError::Poisoned(_)) => {
                        self.stop();
                        return Err(failure("session_poisoned",
                                    "session is unusable after internal panic", 4));
                    }
                };
            if self.terminal.load(Ordering::Acquire) {
                return Err(failure("session_terminal",
                            "session was cancelled, closed or failed", 2));
            }
            Ok(guard)
        }
    }
    enum ManagedSession { Legacy(Session), }
    impl ManagedSession {
        fn reclaim_ready(&self) -> bool {
            match self { Self::Legacy(_) => true, }
        }
    }
    enum State {
        Empty,
        Reserved,
        Live(Arc<ManagedSession>),
        Closing(Arc<ManagedSession>),
        Reclaiming,
        Retired,
    }
    struct Slot {
        generation: u32,
        state: State,
    }
    impl Slot {
        fn release(&mut self) {
            if let Some(next) = self.generation.checked_add(1) {
                self.generation = next;
                self.state = State::Empty;
            } else { self.state = State::Retired; }
        }
    }
    struct Registry([Slot; SESSION_CAP]);
    impl Registry {
        fn new() -> Self {
            Self(std::array::from_fn(|_|
                        Slot { generation: 1, state: State::Empty }))
        }
        fn reserve(&mut self) -> Result<(usize, u32), Failure> {
            for (index, slot) in self.0.iter_mut().enumerate() {
                if #[allow(non_exhaustive_omitted_patterns)] match slot.state
                        {
                        State::Empty => true,
                        _ => false,
                    } {
                    slot.state = State::Reserved;
                    return Ok((index, slot.generation));
                }
            }
            Err(failure("session_limit", "persistent session ceiling reached",
                    3))
        }
        fn slot(&mut self, handle: u64) -> Result<&mut Slot, Failure> {
            let index =
                (handle as
                                u32).checked_sub(1).filter(|i| (*i as usize) < SESSION_CAP);
            let generation = (handle >> 32) as u32;
            if let Some(index) = index {
                let slot = &mut self.0[index as usize];
                if generation != 0 && generation == slot.generation &&
                        #[allow(non_exhaustive_omitted_patterns)] match slot.state {
                            State::Live(_) => true,
                            _ => false,
                        } {
                    return Ok(slot);
                }
            }
            Err(failure("invalid_session",
                    "unknown, closed or stale session handle", 3))
        }
        fn begin_reclaim(&mut self, handle: u64)
            -> Option<(usize, Arc<ManagedSession>)> {
            let index = (handle as u32).checked_sub(1)? as usize;
            let slot = self.0.get_mut(index)?;
            if slot.generation != (handle >> 32) as u32 { return None; }
            if #[allow(non_exhaustive_omitted_patterns)] match &slot.state {
                    State::Closing(session) if
                        Arc::strong_count(session) == 1 && session.reclaim_ready()
                        => true,
                    _ => false,
                } {
                let State::Closing(session) =
                    std::mem::replace(&mut slot.state,
                        State::Reclaiming) else {
                        ::core::panicking::panic("internal error: entered unreachable code")
                    };
                Some((index, session))
            } else { None }
        }
    }
    fn registry() -> &'static Mutex<Registry> {
        static REGISTRY: OnceLock<Mutex<Registry>> = OnceLock::new();
        REGISTRY.get_or_init(|| Mutex::new(Registry::new()))
    }
    fn registry_lock() -> Result<MutexGuard<'static, Registry>, Failure> {
        registry().lock().map_err(|_|
                failure("registry_poisoned",
                    "session registry is unavailable", 4))
    }
    fn get(handle: u64) -> Result<SessionLease, Failure> {
        match &registry_lock()?.slot(handle)?.state {
            State::Live(session) =>
                match session.as_ref() {
                    ManagedSession::Legacy(_) =>
                        Ok(SessionLease {
                                handle,
                                session: Some(Arc::clone(session)),
                            }),
                },
            _ => {
                ::core::panicking::panic_fmt(format_args!("internal error: entered unreachable code: {0}",
                        format_args!("slot checks live state")));
            }
        }
    }
    struct SessionLease {
        handle: u64,
        session: Option<Arc<ManagedSession>>,
    }
    impl std::ops::Deref for SessionLease {
        type Target = Session;
        fn deref(&self) -> &Session {
            match self.session.as_deref().expect("live operation lease") {
                ManagedSession::Legacy(session) => session,
            }
        }
    }
    impl Drop for SessionLease {
        fn drop(&mut self) {
            if let Some(session) = self.session.take() {
                release_lease(self.handle, session);
            }
        }
    }
    fn release_lease(handle: u64, session: Arc<ManagedSession>) {
        let pending =
            {
                let Ok(mut registry) =
                    registry().lock() else { drop(session); return; };
                let retained =
                    (handle as
                                            u32).checked_sub(1).and_then(|index|
                                    registry.0.get(index as
                                            usize)).filter(|slot|
                                slot.generation ==
                                    (handle >> 32) as
                                        u32).is_some_and(|slot|
                            match &slot.state {
                                State::Live(owner) | State::Closing(owner) =>
                                    Arc::ptr_eq(owner, &session),
                                _ => false,
                            });
                if !retained { drop(registry); drop(session); return; }
                drop(session);
                registry.begin_reclaim(handle)
            };
        finish_reclaim(handle, pending);
    }
    fn finish_reclaim(handle: u64,
        pending: Option<(usize, Arc<ManagedSession>)>) {
        if let Some((index, session)) = pending {
            drop(session);
            if let Ok(mut registry) = registry().lock() {
                let slot = &mut registry.0[index];
                if slot.generation == (handle >> 32) as u32 &&
                        #[allow(non_exhaustive_omitted_patterns)] match slot.state {
                            State::Reclaiming => true,
                            _ => false,
                        } {
                    slot.release();
                }
            }
        }
    }
    struct Reservation {
        index: usize,
        generation: u32,
        published: bool,
    }
    impl Reservation {
        fn new() -> Result<Self, Failure> {
            let (index, generation) = registry_lock()?.reserve()?;
            Ok(Self { index, generation, published: false })
        }
        fn publish(self, session: Session) -> Result<u64, Failure> {
            self.publish_managed(ManagedSession::Legacy(session))
        }
        fn publish_managed(mut self, session: ManagedSession)
            -> Result<u64, Failure> {
            let session = Arc::new(session);
            let mut registry = registry_lock()?;
            let slot = &mut registry.0[self.index];
            if false {
                if !#[allow(non_exhaustive_omitted_patterns)] match slot.state
                            {
                            State::Reserved => true,
                            _ => false,
                        } {
                    ::core::panicking::panic("assertion failed: matches!(slot.state, State::Reserved)")
                };
            };
            if false {
                {
                    match (&slot.generation, &self.generation) {
                        (left_val, right_val) => {
                            if !(*left_val == *right_val) {
                                let kind = ::core::panicking::AssertKind::Eq;
                                ::core::panicking::assert_failed(kind, &*left_val,
                                    &*right_val, ::core::option::Option::None);
                            }
                        }
                    }
                };
            };
            slot.state = State::Live(session);
            self.published = true;
            Ok(((self.generation as u64) << 32) | (self.index as u64 + 1))
        }
    }
    impl Drop for Reservation {
        fn drop(&mut self) {
            if !self.published {
                if let Ok(mut registry) = registry().lock() {
                    let slot = &mut registry.0[self.index];
                    if slot.generation == self.generation &&
                            #[allow(non_exhaustive_omitted_patterns)] match slot.state {
                                State::Reserved => true,
                                _ => false,
                            } {
                        slot.release();
                    }
                }
            }
        }
    }
    /// Validate and instantiate a persistent session. Profile IDs are 1, 2 and 3.
    /// # Safety
    /// Pointers obey mixer_vm.h. out_handle is writable and does not alias any buffer.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_session_create_v1(profile: u32,
        data: *const u8, len: usize, limits: *const MixerVmLimits,
        out_handle: *mut u64, out: *mut MixerVmReport) -> u32 {
        unsafe {
            boundary(out,
                ||
                    {
                        if out_handle.is_null() {
                            return Err((arg("null output handle"), 3));
                        }
                        out_handle.write_unaligned(0);
                        let profile =
                            match profile {
                                1 => Profile::IntegerV1,
                                2 => Profile::NumericV2,
                                3 => Profile::TableMemoryV3,
                                _ => return Err((arg("unknown session profile"), 3)),
                            };
                        let mut limits = limits_from(limits).map_err(|e| (e, 3))?;
                        limits.profile = profile;
                        let input =
                            bytes(data, len, limits.module_bytes).map_err(|e| (e, 3))?;
                        let reservation = Reservation::new()?;
                        let module =
                            Module::decode(input, &limits).map_err(|e| (e, 1))?;
                        let instance =
                            Instance::new(module, limits.clone()).map_err(|e| (e, 2))?;
                        let cancellation = instance.cancellation();
                        let handle =
                            reservation.publish(Session {
                                        instance: Mutex::new(instance),
                                        limits,
                                        cancellation,
                                        terminal: AtomicBool::new(false),
                                    })?;
                        out_handle.write_unaligned(handle);
                        Ok(MixerVmReport::default())
                    })
        }
    }
    /// Invoke once on retained state. Any interpreter error permanently terminates it.
    /// # Safety
    /// Pointers obey mixer_vm.h; all buffers remain valid for this complete call.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_session_invoke_v1(handle: u64,
        export: *const u8, export_len: usize, args: *const MixerVmValue,
        args_len: usize, out: *mut MixerVmReport) -> u32 {
        unsafe {
            boundary(out,
                ||
                    {
                        let session = get(handle)?;
                        let name =
                            bytes(export, export_len, 4096).map_err(|e| (e, 3))?;
                        let name =
                            std::str::from_utf8(name).map_err(|_|
                                        (arg("export name is not UTF-8"), 3))?;
                        let values =
                            arguments(session.limits.profile, session.limits.locals,
                                        args, args_len).map_err(|e| (e, 3))?;
                        let mut instance = session.lock()?;
                        let mut result = instance.invoke(name, &values);
                        if session.cancellation.is_cancelled() {
                            result =
                                Err(Error::new("cancelled", "session execution cancelled",
                                        None, 0));
                        }
                        let mut report =
                            match result {
                                Ok(value) => {
                                    let mut report = MixerVmReport::default();
                                    if let Some(value) = value {
                                        (report.value_type, report.value) =
                                            match value {
                                                Value::I32(v) => (1, v as i64),
                                                Value::I64(v) => (2, v),
                                                Value::F32(v) => (3, v as i64),
                                                Value::F64(v) => (4, v as i64),
                                            };
                                    }
                                    report
                                }
                                Err(error) => { session.stop(); report_error(error, 2) }
                            };
                        report.fuel_used =
                            session.limits.fuel - instance.fuel_remaining;
                        report.host_calls_used = instance.host_calls_used;
                        Ok(report)
                    })
        }
    }
    /// Copy guest memory to a host-owned buffer; never exposes a guest-memory pointer.
    /// # Safety
    /// destination holds len writable bytes (null only for zero length), disjoint from out.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_session_read_v1(handle: u64,
        offset: u32, destination: *mut u8, len: usize,
        out: *mut MixerVmReport) -> u32 {
        unsafe {
            boundary(out,
                ||
                    {
                        if len > TRANSFER_CAP || (len > 0 && destination.is_null())
                            {
                            return Err((arg("invalid destination buffer or transfer length"),
                                        3));
                        }
                        let session = get(handle)?;
                        let instance = session.lock()?;
                        let start = offset as usize;
                        let end =
                            start.checked_add(len).filter(|n|
                                            *n <=
                                                instance.memory().len()).ok_or_else(||
                                        {
                                            failure("memory_out_of_bounds",
                                                "host transfer exceeds memory", 3)
                                        })?;
                        if len > 0 {
                            std::ptr::copy_nonoverlapping(instance.memory()[start..end].as_ptr(),
                                destination, len);
                        }
                        Ok(MixerVmReport::default())
                    })
        }
    }
    /// Copy host bytes into bounded guest memory, with whole-range validation before mutation.
    /// # Safety
    /// source holds len readable bytes (null only for zero length), disjoint from out.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_session_write_v1(handle: u64,
        offset: u32, source: *const u8, len: usize, out: *mut MixerVmReport)
        -> u32 {
        unsafe {
            boundary(out,
                ||
                    {
                        let input =
                            bytes(source, len, TRANSFER_CAP).map_err(|e| (e, 3))?;
                        let session = get(handle)?;
                        let mut instance = session.lock()?;
                        instance.write_memory(offset, input).map_err(|e| (e, 3))?;
                        Ok(MixerVmReport::default())
                    })
        }
    }
    /// Permanent cooperative cancellation; does not wait for an active invocation.
    /// # Safety
    /// out points to writable non-aliasing MixerVmReport storage.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_session_cancel_v1(handle: u64,
        out: *mut MixerVmReport) -> u32 {
        unsafe {
            boundary(out,
                || { get(handle)?.stop(); Ok(MixerVmReport::default()) })
        }
    }
    /// Invalidate a handle and cancel execution. Storage survives until in-flight calls return.
    /// # Safety
    /// out points to writable non-aliasing MixerVmReport storage.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_session_close_v1(handle: u64,
        out: *mut MixerVmReport) -> u32 {
        unsafe {
            boundary(out,
                ||
                    {
                        let session =
                            {
                                let mut registry = registry_lock()?;
                                let slot = registry.slot(handle)?;
                                let State::Live(session) =
                                    &slot.state else {
                                        ::core::panicking::panic("internal error: entered unreachable code")
                                    };
                                let ManagedSession::Legacy(legacy) = session.as_ref();
                                legacy.stop();
                                let session = Arc::clone(session);
                                slot.state = State::Closing(Arc::clone(&session));
                                session
                            };
                        release_lease(handle, session);
                        Ok(MixerVmReport::default())
                    })
        }
    }
}
mod validate {
    use crate::*;
    struct Control {
        kind: BlockKind,
        height: usize,
        result: Option<Type>,
        unreachable: bool,
        has_else: bool,
    }
    struct Validator {
        stack: Vec<Option<Type>>,
        controls: Vec<Control>,
        function: u32,
        offset: usize,
        max: usize,
    }
    impl Validator {
        fn error(&self, m: impl Into<String>) -> Error {
            Error::new("validation", m, Some(self.function), self.offset)
        }
        fn pop_any(&mut self) -> Result<Option<Type>, Error> {
            let c =
                self.controls.last().ok_or_else(||
                            self.error("instruction follows function end"))?;
            if self.stack.len() == c.height && c.unreachable {
                return Ok(None);
            }
            if self.stack.len() <= c.height {
                return Err(self.error("operand stack underflow"));
            }
            Ok(self.stack.pop().unwrap())
        }
        fn pop(&mut self, t: Type) -> Result<(), Error> {
            if let Some(actual) = self.pop_any()? {
                if actual != t {
                    return Err(self.error(::alloc::__export::must_use({
                                        ::alloc::fmt::format(format_args!("expected {0}, found {1}",
                                                t.name(), actual.name()))
                                    })));
                }
            }
            Ok(())
        }
        fn push(&mut self, t: Option<Type>) -> Result<(), Error> {
            if self.stack.len() >= self.max {
                return Err(Error::new("limit",
                            "validated operand stack exceeds limit",
                            Some(self.function), self.offset));
            }
            self.stack.push(t);
            Ok(())
        }
        fn result(&mut self, t: Option<Type>) -> Result<(), Error> {
            if let Some(t) = t { self.pop(t)?; }
            Ok(())
        }
        fn unreachable(&mut self) {
            let c = self.controls.last_mut().unwrap();
            self.stack.truncate(c.height);
            c.unreachable = true;
        }
        fn label(&self, n: u32) -> Result<Option<Type>, Error> {
            let i =
                self.controls.len().checked_sub(n as usize +
                                1).ok_or_else(||
                            self.error("branch depth exceeds control stack"))?;
            let c = &self.controls[i];
            Ok(if c.kind == BlockKind::Loop { None } else { c.result })
        }
    }
    pub(crate) fn module(m: &Module, limits: &Limits) -> Result<(), Error> {
        module_with_admission(m, limits, ImportAdmission::Legacy)
    }
    pub(crate) fn module_with_admission(m: &Module, limits: &Limits,
        admission: ImportAdmission) -> Result<(), Error> {
        let _ = admission;
        if m.profile != limits.profile {
            return Err(Error::new("invalid_limits",
                        "module and instance profiles differ", None, 0));
        }
        if m.types.iter().any(|s| s.params.len() > limits.locals) {
            return Err(Error::new("limit",
                        "signature parameters exceed local limit", None, 0));
        }
        for import in &m.imports {
            let sig =
                m.types.get(import.type_index as
                                usize).ok_or_else(||
                            Error::new("validation", "import type index out of bounds",
                                None, 0))?;
            let allowed =
                import.module == "mixer" &&
                    match import.name.as_str() {
                        "checkpoint" =>
                            sig.params.is_empty() && sig.result.is_none(),
                        "abort" =>
                            sig.params == [Type::I32] && sig.result.is_none(),
                        _ => false,
                    };
            if !allowed {
                return Err(Error::new("unsupported",
