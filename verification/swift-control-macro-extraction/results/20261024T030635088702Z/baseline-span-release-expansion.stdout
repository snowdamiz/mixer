            pub(crate) fn checked_record<M: CacheMode>(parts:
                    CacheViewParts<'_, M>, pin: &M::Pin,
                meter: &mut impl PinDiagnostic<M::Failure>)
                -> Result<PinRecord, M::Failure> {
                if pin.owner() != parts.owner {
                    return Err(meter.invalid("wrong_cache_owner"));
                }
                let record =
                    parts.pins.get(pin.slot()).copied().filter(|r|
                                    r.nonce != 0 &&
                                        r.nonce ==
                                            pin.nonce()).ok_or_else(|| meter.invalid("stale_pin"))?;
                if parts.slots.get(record.entry).is_none_or(|s|
                            s.pins() == 0 || s.entry().is_none()) {
                    return Err(meter.invalid("stale_entry"));
                }
                Ok(record)
            }
            pub(crate) fn view<'a,
                M: CacheMode>(parts: CacheViewParts<'a, M>, pin: &M::Pin,
                meter: &mut impl PinDiagnostic<M::Failure>)
                -> Result<FunctionView<'a>, M::Failure> {
                let record =
                    checked_record::<M>(CacheViewParts {
                                slots: parts.slots,
                                pins: parts.pins,
                                owner: parts.owner,
                            }, pin, meter)?;
                let e =
                    parts.slots[record.entry].entry().ok_or_else(||
                                meter.invalid("stale_entry"))?;
                Ok(FunctionView {
                        function: e.function,
                        type_index: e.type_index,
                        body_offset: e.body_offset,
                        locals: &e.locals,
                        instructions: &e.instructions,
                        branch_targets: &e.branch_targets,
                    })
            }
            pub(crate) fn release<M: CacheMode>(parts: CacheParts<'_, M>,
                pin: M::Pin, operation: &mut impl ReleaseControl<M::Failure>)
                -> Result<(), (M::Failure, M::Pin)> {
                let record =
                    match checked_record::<M>(CacheViewParts {
                                slots: parts.slots,
                                pins: parts.pins,
                                owner: parts.owner,
                            }, &pin, operation) {
                        Ok(r) => r,
                        Err(e) => return Err((e, pin)),
                    };
                if let Err(e) = operation.release_pin() {
                    return Err((e, pin));
                }
                let slot = &mut parts.slots[record.entry];
                parts.usage.release(slot.entry().expect("checked entry").bytes,
                    slot.pins() == 1);
                slot.set_pins(slot.pins() - 1);
                parts.pins[pin.slot()] = PinRecord::default();
                Ok(())
            }
            pub(crate) fn pin<M: CacheMode>(parts: CacheParts<'_, M>,
                function: u32, operation: &mut M::Operation<'_>)
                -> Result<M::Pin, M::Failure> {
                let CacheParts {
                        snapshot, slots, pins, owner, next_nonce, usage, scratch } =
                    parts;
                let mut parts =
                    CacheFields::<M> {
                        snapshot,
                        slots,
                        pins,
                        owner,
                        next_nonce,
                        scratch,
                    };
                let mut meter = M::meter(usage, operation, function);
                meter.step(CacheStep::Lookup);
                meter.work(1)?;
                let defined =
                    parts.snapshot.function(function).ok_or_else(||
                                meter.error(CacheFailureKind::InvalidFunction,
                                    "not_defined_function"))?;
                meter.set_offset(defined.body_offset);
                let nonce =
                    parts.next_nonce.checked_add(1).ok_or_else(||
                                meter.error(CacheFailureKind::NonceExhausted,
                                    "pin_nonce_exhausted"))?;
                let mut pin_slot = None;
                for (index, record) in parts.pins.iter().enumerate() {
                    meter.work(1)?;
                    if record.nonce == 0 { pin_slot = Some(index); break; }
                }
                let pin_slot =
                    pin_slot.ok_or_else(||
                                meter.error(CacheFailureKind::PinExhausted,
                                    "pin_slots_exhausted"))?;
                meter.acquire_pin()?;
                let result =
                    pin_acquired::<M>(&mut parts, &mut meter, defined, pin_slot,
                        nonce);
                if result.is_err() { meter.abandon_pin(); }
                result
            }
            pub(crate) struct CacheFields<'a, M: CacheMode> {
                pub snapshot: &'a M::Snapshot,
                pub slots: &'a mut [M::Slot],
                pub pins: &'a mut [PinRecord],
                pub owner: u64,
                pub next_nonce: &'a mut u64,
                pub scratch: M::Scratch<'a>,
            }
            fn pin_acquired<M: CacheMode>(parts: &mut CacheFields<'_, M>,
                meter: &mut M::Meter<'_, '_>, defined: FunctionSpanView<'_>,
                pin_slot: usize, nonce: u64) -> Result<M::Pin, M::Failure> {
                let function = defined.absolute_index;
                let mut hit = None;
                for (index, slot) in parts.slots.iter().enumerate() {
                    meter.work(1)?;
                    if slot.entry().is_some_and(|e| e.function == function) {
                        hit = Some(index);
                        break;
                    }
                }
                let index =
                    if let Some(index) = hit {
                        meter.check()?;
                        let hits =
                            meter.usage().hits().checked_add(1).ok_or_else(||
                                        meter.error(CacheFailureKind::WorkExhausted,
                                            "hits_overflow"))?;
                        meter.usage_mut().hit(hits);
                        index
                    } else {
                        let misses =
                            meter.usage().misses().checked_add(1).ok_or_else(||
                                        meter.error(CacheFailureKind::WorkExhausted,
                                            "misses_overflow"))?;
                        meter.usage_mut().miss(misses);
                        let next_decodes =
                            meter.usage().decodes().checked_add(1).ok_or_else(||
                                        meter.error(CacheFailureKind::WorkExhausted,
                                            "decodes_overflow"))?;
                        let counts =
                            M::scan(parts.snapshot, defined, &mut parts.scratch,
                                    meter)?;
                        let bytes = counts.bytes(meter)?;
                        if bytes > meter.entry_capacity() {
                            return Err(meter.detailed(CacheFailureKind::EntryOversize,
                                        "entry_bytes", bytes as u64,
                                        meter.entry_capacity() as u64));
                        }
                        let base = meter.base();
                        let capacity = meter.capacity();
                        if base.checked_add(bytes).is_none_or(|n| n > capacity) {
                            return Err(meter.error(CacheFailureKind::Capacity,
                                        "entry_cannot_fit"));
                        }
                        meter.step(CacheStep::Planning);
                        let mut plan = [false; MAX_ENTRIES];
                        let mut remaining = meter.usage().resident();
                        meter.work(parts.slots.len() as u64)?;
                        let mut empty =
                            parts.slots.iter().position(|slot| slot.entry().is_none());
                        while empty.is_none() || base + remaining + bytes > capacity
                            {
                            let mut oldest: Option<usize> = None;
                            for (index, slot) in parts.slots.iter().enumerate() {
                                meter.work(1)?;
                                if !plan[index] && slot.pins() == 0 &&
                                            slot.entry().is_some() &&
                                        oldest.is_none_or(|p|
                                                slot.last_used() < parts.slots[p].last_used()) {
                                    oldest = Some(index);
                                }
                            }
                            let victim =
                                oldest.ok_or_else(||
                                            meter.error(CacheFailureKind::AllPinned,
                                                "all_entries_pinned"))?;
                            plan[victim] = true;
                            remaining -=
                                parts.slots[victim].entry().expect("selected entry").bytes;
                            empty = Some(victim);
                        }
                        meter.work(MAX_ENTRIES as u64)?;
                        let mut evictions = 0u64;
                        for selected in &plan { evictions += u64::from(*selected); }
                        meter.usage().evictions().checked_add(evictions).ok_or_else(||
                                    meter.error(CacheFailureKind::WorkExhausted,
                                        "evictions_overflow"))?;
                        meter.check()?;
                        for (index, selected) in
                            plan.iter().enumerate().take(parts.slots.len()) {
                            if *selected {
                                let bytes =
                                    parts.slots[index].entry().expect("planned entry").bytes;
                                let old = parts.slots[index].take().expect("planned entry");
                                M::drop_entry(old, meter)?;
                                meter.usage_mut().evicted(bytes);
                            }
                        }
                        let index =
                            empty.ok_or_else(||
                                        meter.error(CacheFailureKind::Capacity, "no_entry_slot"))?;
                        meter.construction(bytes)?;
                        let decoded =
                            M::build(parts.snapshot, defined, counts,
                                &mut parts.scratch, meter);
                        let entry =
                            match decoded {
                                Ok(entry) => entry,
                                Err(error) => {
                                    let _ = meter.construction(0);
                                    return Err(error);
                                }
                            };
                        meter.step(CacheStep::Publication);
                        if let Err(error) = meter.check() {
                            let _ = M::drop_entry(entry, meter);
                            let _ = meter.construction(0);
                            return Err(error);
                        }
                        meter.usage_mut().decoded(next_decodes, bytes);
                        parts.slots[index].set(entry);
                        index
                    };
                let slot = &mut parts.slots[index];
                meter.usage_mut().pin(slot.entry().expect("resident entry").bytes,
                    slot.pins() == 0);
                slot.set_pins(slot.pins() + 1);
                slot.set_last_used(meter.work_used());
                parts.pins[pin_slot] =
                    PinRecord { nonce: *parts.next_nonce, entry: index };
                let pin =
                    M::Pin::new(parts.owner, pin_slot, *parts.next_nonce);
