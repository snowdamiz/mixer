                fn build(snapshot: &ValidatedSpans,
                    body: FunctionSpanView<'_>, counts: decode::Counts,
                    _: &mut (), meter: &mut Meter<'_>)
                    -> Result<DecodedFunction, CacheFailure> {
                    decode::build(body.body, body.body_offset, body.type_index,
                        body.absolute_index, snapshot.policy(),
                        snapshot.source().len(), counts, meter)
