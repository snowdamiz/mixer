            impl CacheMode for FrozenMode {
                type Snapshot = ValidatedSpans;
                type Slot = Slot;
                type Resident = DecodedFunction;
                type Pin = FunctionPin;
                type Usage = CacheUsage;
                type Failure = CacheFailure;
                type Operation<'a> = FrozenOperation<'a>;
                type Meter<'a, 'op> = Meter<'a> where 'op: 'a;
                type Scratch<'a> = ();
                fn meter<'a,
                    'op>(usage: &'a mut CacheUsage,
                    operation: &'a mut FrozenOperation<'op>, function: u32)
                    -> Meter<'a> where 'op: 'a {
                    Meter {
                        usage,
                        budget: *operation.budget,
                        cancellation: operation.cancellation,
                        function: Some(function),
                        offset: 0,
                    }
                }
                fn scan(snapshot: &ValidatedSpans, body: FunctionSpanView<'_>,
                    _: &mut (), meter: &mut Meter<'_>)
                    -> Result<decode::Counts, CacheFailure> {
                    decode::scan(body.body, body.body_offset, snapshot.policy(),
                        snapshot.source().len(), meter, None)
