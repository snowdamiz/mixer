        fn clone(&self) -> MixerVmReport {
            let _: ::core::clone::AssertParamIsClone<u32>;
            let _: ::core::clone::AssertParamIsClone<i64>;
            let _: ::core::clone::AssertParamIsClone<u64>;
            let _: ::core::clone::AssertParamIsClone<[u8; 48]>;
            let _: ::core::clone::AssertParamIsClone<[u8; 256]>;
            *self
        }
    }
    #[automatically_derived]
    impl ::core::marker::Copy for MixerVmReport { }
    impl Default for MixerVmReport {
        fn default() -> Self {
            Self {
                abi_version: 1,
                status: 0,
                value_type: 0,
                reserved: 0,
                value: 0,
                fuel_used: 0,
                host_calls_used: 0,
                function: u32::MAX,
                offset: 0,
                code: [0; 48],
                message: [0; 256],
            }
        }
    }
    fn copy_text<const N : usize>(out: &mut [u8; N], text: &str) {
        let n = text.len().min(N - 1);
        out[..n].copy_from_slice(&text.as_bytes()[..n]);
    }
    pub(crate) fn report_error(e: Error, status: u32) -> MixerVmReport {
        let mut r =
            MixerVmReport {
                status,
                function: e.function.unwrap_or(u32::MAX),
                offset: e.offset.min(u32::MAX as usize) as u32,
                ..Default::default()
            };
        copy_text(&mut r.code, e.code);
        copy_text(&mut r.message, &e.message);
        r
    }
    pub(crate) fn arg(m: &str) -> Error {
        Error::new("invalid_arguments", m, None, 0)
    }
    pub(crate) unsafe fn limits_from(p: *const MixerVmLimits)
        -> Result<Limits, Error> {
        let mut l = Limits::default();
        if !p.is_null() {
            let c = unsafe { p.read_unaligned() };
            if c.struct_size as usize != std::mem::size_of::<MixerVmLimits>()
                    || c.abi_version != 1 {
                return Err(arg("invalid limits struct size or ABI version"));
            }
            l.fuel = c.fuel;
            l.memory_pages = c.memory_pages;
            l.operand_stack = c.operand_stack as usize;
            l.call_depth = c.call_depth as usize;
            l.host_calls = c.host_calls as u64;
        }
        l.check()?;
        Ok(l)
    }
    pub(crate) unsafe fn bytes<'a>(p: *const u8, n: usize, max: usize)
        -> Result<&'a [u8], Error> {
        if n > max || n > isize::MAX as usize {
            return Err(arg("input length exceeds profile"));
        }
        if n == 0 { return Ok(&[]); }
        if p.is_null() {
            return Err(arg("null pointer with nonzero input length"));
        }
        Ok(unsafe { slice::from_raw_parts(p, n) })
    }
    pub(crate) unsafe fn boundary<F: FnOnce()
        ->
            Result<MixerVmReport,
            (Error, u32)>>(out: *mut MixerVmReport, body: F) -> u32 {
        if out.is_null() { return 3; }
        let report =
            match catch_unwind(AssertUnwindSafe(body)) {
                Ok(Ok(r)) => r,
                Ok(Err((e, s))) => report_error(e, s),
                Err(_) =>
                    report_error(Error::new("internal_panic",
                            "VM panic contained at C ABI boundary", None, 0), 4),
            };
        let status = report.status;
        unsafe { out.write_unaligned(report) };
        status
    }
    pub(crate) unsafe fn arguments(profile: Profile, max: usize,
        args: *const MixerVmValue, args_len: usize)
        -> Result<Vec<Value>, Error> {
        if args_len > max || args_len > 0 && args.is_null() {
            return Err(arg("invalid argument buffer"));
        }
        let mut values = ::alloc::vec::Vec::new();
        for i in 0..args_len {
            let a = unsafe { args.add(i).read_unaligned() };
            if a.reserved != 0 {
                return Err(arg("argument reserved field must be zero"));
            }
            values.push(match a.value_type {
                    1 if i32::try_from(a.value).is_ok() =>
                        Value::I32(a.value as i32),
                    2 => Value::I64(a.value),
                    3 if profile.floats() && u32::try_from(a.value).is_ok() =>
                        Value::F32(a.value as u32),
                    4 if profile.floats() => Value::F64(a.value as u64),
                    _ => return Err(arg("invalid argument type or i32 range")),
                });
        }
        Ok(values)
    }
    /// Validate without instantiating or executing. See include/mixer_vm.h for pointer contract.
    ///
    /// # Safety
    /// All non-null pointers must reference valid readable/writable buffers of the documented size.
    unsafe fn validate_profile(profile: Profile, data: *const u8, len: usize,
        limits: *const MixerVmLimits, out: *mut MixerVmReport) -> u32 {
        unsafe {
            boundary(out,
                ||
                    {
                        let mut l = limits_from(limits).map_err(|e| (e, 3))?;
                        l.profile = profile;
                        let b =
                            bytes(data, len, l.module_bytes).map_err(|e| (e, 3))?;
                        Module::decode(b, &l).map_err(|e| (e, 1))?;
                        Ok(MixerVmReport::default())
                    })
        }
    }
    /// Decode, validate, instantiate, and invoke one export. Instances do not persist across C calls.
    ///
    /// # Safety
    /// All non-null pointers must reference valid readable/writable buffers of the documented size.
    #[allow(clippy::too_many_arguments)]
    unsafe fn invoke_profile(profile: Profile, data: *const u8, len: usize,
        export: *const u8, export_len: usize, args: *const MixerVmValue,
        args_len: usize, limits: *const MixerVmLimits,
        out: *mut MixerVmReport) -> u32 {
        unsafe {
            boundary(out,
                ||
                    {
                        let mut l = limits_from(limits).map_err(|e| (e, 3))?;
                        l.profile = profile;
                        let b =
                            bytes(data, len, l.module_bytes).map_err(|e| (e, 3))?;
                        let n =
                            bytes(export, export_len, 4096).map_err(|e| (e, 3))?;
                        let name =
                            std::str::from_utf8(n).map_err(|_|
                                        (arg("export name is not UTF-8"), 3))?;
                        let values =
                            arguments(profile, l.locals, args,
                                        args_len).map_err(|e| (e, 3))?;
                        let module = Module::decode(b, &l).map_err(|e| (e, 1))?;
                        let mut instance =
                            Instance::new(module, l.clone()).map_err(|e| (e, 2))?;
                        match instance.invoke(name, &values) {
                            Ok(value) => {
                                let mut r =
                                    MixerVmReport {
                                        fuel_used: l.fuel - instance.fuel_remaining,
                                        host_calls_used: instance.host_calls_used,
                                        ..Default::default()
                                    };
                                if let Some(value) = value {
                                    match value {
                                        Value::I32(v) => { r.value_type = 1; r.value = v as i64; }
                                        Value::I64(v) => { r.value_type = 2; r.value = v; }
                                        Value::F32(v) => { r.value_type = 3; r.value = v as i64; }
                                        Value::F64(v) => { r.value_type = 4; r.value = v as i64; }
                                    }
                                }
                                Ok(r)
                            }
                            Err(e) => {
                                let mut r = report_error(e, 2);
                                r.fuel_used = l.fuel - instance.fuel_remaining;
                                r.host_calls_used = instance.host_calls_used;
                                Ok(r)
                            }
                        }
                    })
        }
    }
    /// Validate the stable integer-v1 profile.
    /// # Safety
    /// All pointers obey the buffer contract in mixer_vm.h.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_validate(data: *const u8, len: usize,
        limits: *const MixerVmLimits, out: *mut MixerVmReport) -> u32 {
        unsafe {
            validate_profile(Profile::IntegerV1, data, len, limits, out)
        }
    }
    /// Validate the opt-in numeric-v2 profile.
    /// # Safety
    /// All pointers obey the buffer contract in mixer_vm.h.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_validate_numeric_v2(data: *const u8,
        len: usize, limits: *const MixerVmLimits, out: *mut MixerVmReport)
        -> u32 {
        unsafe {
            validate_profile(Profile::NumericV2, data, len, limits, out)
        }
    }
    /// Invoke with the stable integer-v1 profile.
    /// # Safety
    /// All pointers obey the buffer contract in mixer_vm.h.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_invoke(data: *const u8, len: usize,
        export: *const u8, export_len: usize, args: *const MixerVmValue,
        args_len: usize, limits: *const MixerVmLimits,
        out: *mut MixerVmReport) -> u32 {
        unsafe {
            invoke_profile(Profile::IntegerV1, data, len, export, export_len,
                args, args_len, limits, out)
        }
    }
    /// Invoke with the opt-in numeric-v2 profile; type3/4 values carry IEEE bits.
    /// # Safety
    /// All pointers obey the buffer contract in mixer_vm.h.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_invoke_numeric_v2(data: *const u8,
        len: usize, export: *const u8, export_len: usize,
        args: *const MixerVmValue, args_len: usize,
        limits: *const MixerVmLimits, out: *mut MixerVmReport) -> u32 {
        unsafe {
            invoke_profile(Profile::NumericV2, data, len, export, export_len,
                args, args_len, limits, out)
        }
    }
    /// Validate the explicit table-memory-v3 profile with its fixed table ceiling.
    /// # Safety
    /// All pointers obey the unchanged buffer/layout contract in mixer_vm.h.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_validate_table_memory_v3(data:
            *const u8, len: usize, limits: *const MixerVmLimits,
        out: *mut MixerVmReport) -> u32 {
        unsafe {
            validate_profile(Profile::TableMemoryV3, data, len, limits, out)
        }
    }
    /// Invoke table-memory-v3. The legacy limits struct/layout remains unchanged.
    /// # Safety
    /// All pointers obey the unchanged buffer/layout contract in mixer_vm.h.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_invoke_table_memory_v3(data: *const u8,
        len: usize, export: *const u8, export_len: usize,
        args: *const MixerVmValue, args_len: usize,
        limits: *const MixerVmLimits, out: *mut MixerVmReport) -> u32 {
        unsafe {
            invoke_profile(Profile::TableMemoryV3, data, len, export,
                export_len, args, args_len, limits, out)
        }
    }
}
mod float {
    //! Owned numeric-v2 semantics, derived from the WebAssembly numeric definitions.
    //! Values carry IEEE bits; bitwise float instructions never canonicalize NaNs.
    //! Arithmetic, rounding, square root and float-width conversions choose positive
    //! canonical NaNs from the spec's permitted set, independently of host behavior.
    use crate::{Error, Type, Value};
    fn arithmetic_nan32(bits: u32) -> u32 {
        if bits & 0x7fff_ffff > 0x7f80_0000 { 0x7fc0_0000 } else { bits }
    }
    fn arithmetic_nan64(bits: u64) -> u64 {
        if bits & 0x7fff_ffff_ffff_ffff > 0x7ff0_0000_0000_0000 {
            0x7ff8_0000_0000_0000
        } else { bits }
    }
    pub(crate) fn shape(op: u8) -> Option<(Type, usize, Type)> {
        use Type::*;
        Some(match op {
                0x5b..=0x60 => (F32, 2, I32),
                0x61..=0x66 => (F64, 2, I32),
                0x8b..=0x91 => (F32, 1, F32),
                0x92..=0x98 => (F32, 2, F32),
                0x99..=0x9f => (F64, 1, F64),
                0xa0..=0xa6 => (F64, 2, F64),
                0xa8 | 0xa9 => (F32, 1, I32),
                0xaa | 0xab => (F64, 1, I32),
                0xae | 0xaf => (F32, 1, I64),
                0xb0 | 0xb1 => (F64, 1, I64),
                0xb2 | 0xb3 => (I32, 1, F32),
                0xb4 | 0xb5 => (I64, 1, F32),
                0xb6 => (F64, 1, F32),
                0xb7 | 0xb8 => (I32, 1, F64),
                0xb9 | 0xba => (I64, 1, F64),
                0xbb => (F32, 1, F64),
                0xbc => (F32, 1, I32),
                0xbd => (F64, 1, I64),
                0xbe => (I32, 1, F32),
                0xbf => (I64, 1, F64),
                _ => return None,
            })
    }
    pub(crate) fn saturating_shape(sub: u8) -> (Type, Type) {
        (if sub % 4 < 2 { Type::F32 } else { Type::F64 },
            if sub < 4 { Type::I32 } else { Type::I64 })
    }
    fn pop32(s: &mut Vec<Value>) -> u32 {
        match s.pop().unwrap() {
            Value::F32(b) => b,
            _ => {
                ::core::panicking::panic_fmt(format_args!("internal error: entered unreachable code: {0}",
                        format_args!("validated f32")));
            }
        }
    }
    fn pop64(s: &mut Vec<Value>) -> u64 {
        match s.pop().unwrap() {
            Value::F64(b) => b,
            _ => {
                ::core::panicking::panic_fmt(format_args!("internal error: entered unreachable code: {0}",
                        format_args!("validated f64")));
            }
        }
    }
    fn integer(s: &mut Vec<Value>) -> Value { s.pop().unwrap() }
    fn truncated(x: f64, bits: u32, signed: bool, saturating: bool)
        -> Result<Value, &'static str> {
        if x.is_nan() {
            return if saturating {
                    Ok(if bits == 32 { Value::I32(0) } else { Value::I64(0) })
                } else { Err("invalid_conversion_to_integer") };
        }
        let n = x.trunc();
        let value =
            match (bits, signed) {
                (32, true) => {
                    if !saturating &&
                            (!(-2147483648.0..2147483648.0).contains(&n)) {
                        return Err("integer_overflow");
                    }
                    Value::I32(n as i32)
                }
                (32, false) => {
                    if !saturating && (!(0.0..4294967296.0).contains(&n)) {
                        return Err("integer_overflow");
                    }
                    Value::I32(n as u32 as i32)
                }
                (64, true) => {
                    if !saturating &&
                            (!(-9223372036854775808.0..9223372036854775808.0).contains(&n))
                        {
                        return Err("integer_overflow");
                    }
                    Value::I64(n as i64)
                }
                (64, false) => {
                    if !saturating &&
                            (!(0.0..18446744073709551616.0).contains(&n)) {
                        return Err("integer_overflow");
                    }
                    Value::I64(n as u64 as i64)
                }
                _ =>
                    ::core::panicking::panic("internal error: entered unreachable code"),
            };
        Ok(value)
    }
    pub(crate) fn saturating(sub: u8, s: &mut Vec<Value>) {
        let (input, output) = saturating_shape(sub);
        let x =
            if input == Type::F32 {
                f32::from_bits(pop32(s)) as f64
            } else { f64::from_bits(pop64(s)) };
        s.push(truncated(x, if output == Type::I32 { 32 } else { 64 },
                    sub.is_multiple_of(2), true).unwrap());
    }
    pub(crate) fn numeric(op: u8, s: &mut Vec<Value>)
        -> Result<(), &'static str> {
        use Value::*;
        match op {
            0x5b..=0x60 => {
                let b = f32::from_bits(pop32(s));
                let a = f32::from_bits(pop32(s));
                s.push(I32(match op {
                                0x5b => a == b,
                                0x5c => a != b,
                                0x5d => a < b,
                                0x5e => a > b,
                                0x5f => a <= b,
                                _ => a >= b,
                            } as i32));
            }
            0x61..=0x66 => {
                let b = f64::from_bits(pop64(s));
                let a = f64::from_bits(pop64(s));
                s.push(I32(match op {
                                0x61 => a == b,
                                0x62 => a != b,
                                0x63 => a < b,
                                0x64 => a > b,
                                0x65 => a <= b,
                                _ => a >= b,
                            } as i32));
            }
            0x8b..=0x98 => {
                let b = if op >= 0x92 { pop32(s) } else { 0 };
                let a = pop32(s);
                let x = f32::from_bits(a);
                let y = f32::from_bits(b);
                let bits =
                    match op {
                        0x8b => a & 0x7fff_ffff,
                        0x8c => a ^ 0x8000_0000,
                        0x8d => x.ceil().to_bits(),
                        0x8e => x.floor().to_bits(),
                        0x8f => x.trunc().to_bits(),
                        0x90 => x.round_ties_even().to_bits(),
                        0x91 => x.sqrt().to_bits(),
                        0x92 => (x + y).to_bits(),
                        0x93 => (x - y).to_bits(),
                        0x94 => (x * y).to_bits(),
                        0x95 => (x / y).to_bits(),
                        0x96 => {
                            if x.is_nan() || y.is_nan() {
                                f32::NAN.to_bits()
                            } else if x == 0.0 && y == 0.0 {
                                a | b
                            } else { if x < y { x } else { y }.to_bits() }
                        }
                        0x97 => {
                            if x.is_nan() || y.is_nan() {
                                f32::NAN.to_bits()
                            } else if x == 0.0 && y == 0.0 {
                                a & b
                            } else { if x > y { x } else { y }.to_bits() }
                        }
                        0x98 => (a & 0x7fff_ffff) | (b & 0x8000_0000),
                        _ =>
                            ::core::panicking::panic("internal error: entered unreachable code"),
                    };
                s.push(F32(if (0x8d..=0x97).contains(&op) {
                            arithmetic_nan32(bits)
                        } else { bits }));
            }
            0x99..=0xa6 => {
                let b = if op >= 0xa0 { pop64(s) } else { 0 };
                let a = pop64(s);
                let x = f64::from_bits(a);
                let y = f64::from_bits(b);
                let bits =
                    match op {
                        0x99 => a & 0x7fff_ffff_ffff_ffff,
                        0x9a => a ^ 0x8000_0000_0000_0000,
                        0x9b => x.ceil().to_bits(),
                        0x9c => x.floor().to_bits(),
                        0x9d => x.trunc().to_bits(),
                        0x9e => x.round_ties_even().to_bits(),
                        0x9f => x.sqrt().to_bits(),
                        0xa0 => (x + y).to_bits(),
                        0xa1 => (x - y).to_bits(),
                        0xa2 => (x * y).to_bits(),
                        0xa3 => (x / y).to_bits(),
                        0xa4 => {
                            if x.is_nan() || y.is_nan() {
                                f64::NAN.to_bits()
                            } else if x == 0.0 && y == 0.0 {
                                a | b
                            } else { if x < y { x } else { y }.to_bits() }
                        }
                        0xa5 => {
                            if x.is_nan() || y.is_nan() {
                                f64::NAN.to_bits()
                            } else if x == 0.0 && y == 0.0 {
                                a & b
                            } else { if x > y { x } else { y }.to_bits() }
                        }
                        0xa6 =>
                            (a & 0x7fff_ffff_ffff_ffff) | (b & 0x8000_0000_0000_0000),
                        _ =>
                            ::core::panicking::panic("internal error: entered unreachable code"),
                    };
                s.push(F64(if (0x9b..=0xa5).contains(&op) {
                            arithmetic_nan64(bits)
                        } else { bits }));
            }
            0xa8..=0xab | 0xae..=0xb1 => {
                let (input, _, output) = shape(op).unwrap();
                let x =
                    if input == Type::F32 {
                        f32::from_bits(pop32(s)) as f64
                    } else { f64::from_bits(pop64(s)) };
                s.push(truncated(x, if output == Type::I32 { 32 } else { 64 },
                            op.is_multiple_of(2), false)?);
            }
            0xb2..=0xb5 => {
                let x =
                    match (op, integer(s)) {
                        (0xb2, I32(x)) => x as f32,
                        (0xb3, I32(x)) => x as u32 as f32,
                        (0xb4, I64(x)) => x as f32,
                        (0xb5, I64(x)) => x as u64 as f32,
                        _ =>
                            ::core::panicking::panic("internal error: entered unreachable code"),
