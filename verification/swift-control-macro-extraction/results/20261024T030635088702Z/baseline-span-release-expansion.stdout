        }
        fn import(&mut self, index: u32, args: &[Value], caller: u32,
            offset: usize, imports: &ImportContext<'_>)
            -> Result<Option<Value>, Error> {
            imports.check(caller, offset)?;
            if self.cancellation.is_cancelled() {
                return Err(Error::new("cancelled", "execution cancelled",
                            Some(caller), offset));
            }
            if self.host_calls_used >= self.limits.host_calls {
                return Err(Error::new("host_call_limit",
                            "host call limit exceeded", Some(caller), offset));
            }
            self.host_calls_used += 1;
