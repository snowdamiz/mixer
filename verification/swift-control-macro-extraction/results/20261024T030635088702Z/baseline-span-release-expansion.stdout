                match self.pop()? {
                    Value::I32(value) => Ok(value),
                    _ => Err(self.invariant()),
                }
            }
            fn charge(&mut self, amount: u64, instruction: bool)
                -> Result<(), ExecutionFailure> {
                self.check()?;
                let limit = self.cache.spans().limits().fuel;
                let next =
                    self.usage.fuel_used.checked_add(amount).ok_or_else(||
                                self.invariant())?;
                if next > limit {
                    self.usage.fuel_used = limit;
                    return Err(self.error(ExecutionFailureKind::FuelExhausted,
                                "fuel_exhausted", next, limit));
                }
                self.usage.fuel_used = next;
                if instruction { self.usage.instructions += 1; }
                Ok(())
            }
            pub fn invoke(&mut self, name: &str, args: &[Value])
                -> Result<Option<Value>, ExecutionFailure> {
                if let Some(error) = self.failure { return Err(error); }
                self.function = None;
                self.offset = 0;
                match self.invoke_inner(name, args) {
                    Ok(value) => Ok(value),
                    Err(error) => Err(self.terminal(error)),
                }
            }
            fn invoke_inner(&mut self, name: &str, args: &[Value])
                -> Result<Option<Value>, ExecutionFailure> {
                self.check()?;
                let exports = self.cache.spans().execution_export_count();
                self.work(name.len().checked_mul(exports).and_then(|n|
                                        n.checked_add(exports)).ok_or_else(|| self.invariant())?)?;
                if self.cache.spans().profile().floats() {
                    crate::float::environment_check().map_err(|_|
                                {
                                    self.error(ExecutionFailureKind::UnsupportedEnvironment,
                                        "unsupported_float_environment", 0, 0)
                                })?;
                }
                let (kind, function) =
                    self.cache.spans().execution_export(name).ok_or_else(||
                                {
                                    self.error(ExecutionFailureKind::UnknownExport,
                                        "unknown_export", 0, 0)
                                })?;
                if kind != 0 {
                    return Err(self.error(ExecutionFailureKind::InvalidArguments,
                                "invalid_arguments", 0, 0));
                }
                self.function = Some(function);
                self.work(args.len())?;
                let sig =
                    self.cache.spans().execution_signature(function).ok_or_else(||
                                self.invariant())?;
                if args.len() != sig.params.len() ||
                        args.iter().zip(sig.params).any(|(a, t)| a.ty() != *t) {
                    return Err(self.error(ExecutionFailureKind::InvalidArguments,
                                "invalid_arguments", args.len() as u64,
                                sig.params.len() as u64));
                }
                if self.cache.spans().execution_import(function).is_some() {
                    self.charge(1, true)?;
                    return self.import(function);
                }
                self.room_values(args.len())?;
                self.values.extend_from_slice(args);
                self.observe();
                self.enter(function)?;
                self.run()
            }
            fn enter(&mut self, function: u32)
                -> Result<(), ExecutionFailure> {
                if self.frames.len() >= self.cache.spans().limits().call_depth
                    {
                    return Err(self.error(ExecutionFailureKind::CallDepthExceeded,
                                "call_depth_exceeded", self.frames.len() as u64 + 1,
                                self.cache.spans().limits().call_depth as u64));
                }
                self.work(1)?;
                let sig =
                    self.cache.spans().execution_signature(function).ok_or_else(||
                                self.invariant())?;
                let params = sig.params.len();
                let result = sig.result.is_some();
                let pin =
                    self.cache.pin(function,
                                &self.cancellation).map_err(|error|
                                self.cache_error(error))?;
                let build =
                    (||
                                {
                                    let view =
                                        self.cache.view(&pin).map_err(|error|
                                                    self.cache_error(error))?;
                                    let locals = view.locals.len();
                                    let end =
                                        view.instructions.len().checked_sub(1).ok_or_else(||
                                                    self.invariant())?;
                                    let base =
                                        self.values.len().checked_sub(params).ok_or_else(||
                                                    self.invariant())?;
                                    self.room_values(locals)?;
                                    self.room_control()?;
                                    self.work(locals.checked_add(1).ok_or_else(||
                                                        self.invariant())?)?;
                                    let view =
                                        self.cache.view(&pin).map_err(|error|
                                                    self.cache_error(error))?;
                                    for ty in view.locals {
                                        self.values.push(Value::zero(*ty));
                                    }
                                    let operands = self.values.len();
                                    let controls = self.controls.len();
                                    self.controls.push(Control {
                                            kind: Kind::Function,
                                            start: 0,
                                            end,
                                            height: operands,
                                            result,
                                        });
                                    Ok((base, operands, controls, result))
                                })();
                match build {
                    Ok((base, operands, controls, result)) => {
                        self.frames.push(Frame {
                                function,
                                pc: 0,
                                base,
                                operands,
                                controls,
                                result,
                                pin,
                            });
                        self.observe();
                        Ok(())
                    }
                    Err(error) => {
                        let _ = self.cache.release(pin);
                        Err(error)
                    }
                }
            }
            fn import(&mut self, function: u32)
                -> Result<Option<Value>, ExecutionFailure> {
                self.check()?;
                self.work(1)?;
                let limit = self.cache.spans().limits().host_calls;
                if self.usage.host_calls >= limit {
                    return Err(self.error(ExecutionFailureKind::HostCallLimit,
                                "host_call_limit", self.usage.host_calls + 1, limit));
                }
                self.usage.host_calls += 1;
                let import =
                    self.cache.spans().execution_import(function).ok_or_else(||
                                self.invariant())?;
                if import.module != b"mixer" { return Err(self.invariant()); }
                match import.name {
                    b"checkpoint" => Ok(None),
                    b"abort" => Err(self.trap("host_abort")),
                    _ => Err(self.invariant()),
                }
            }
            fn call(&mut self, function: u32)
                -> Result<(), ExecutionFailure> {
                let params =
                    self.cache.spans().execution_signature(function).ok_or_else(||
                                        self.invariant())?.params.len();
                self.work(params)?;
                let base =
                    self.values.len().checked_sub(params).ok_or_else(||
                                self.invariant())?;
                let frame =
                    self.frames.last().ok_or_else(|| self.invariant())?;
                if base < frame.operands { return Err(self.invariant()); }
                if self.cache.spans().execution_import(function).is_some() {
                    let value = self.import(function)?;
                    self.values.truncate(base);
                    self.observe();
                    if let Some(value) = value { self.push(value)?; }
                    Ok(())
                } else { self.enter(function) }
            }
            fn close_control(&mut self, control: Control)
                -> Result<(), ExecutionFailure> {
                let value =
                    if control.result { Some(self.pop()?) } else { None };
                if control.height > self.values.len() {
                    return Err(self.invariant());
                }
                self.work(self.values.len() - control.height + 1)?;
                self.values.truncate(control.height);
                self.observe();
                if let Some(value) = value { self.push(value)?; }
                Ok(())
            }
            fn branch(&mut self, depth: u32)
                -> Result<bool, ExecutionFailure> {
                let frame =
                    self.frames.last().ok_or_else(|| self.invariant())?;
                let index =
                    self.controls.len().checked_sub(depth as usize +
                                        1).filter(|i|
                                    *i >= frame.controls).ok_or_else(|| self.invariant())?;
                let mut control = self.controls[index];
                self.work(self.controls.len() - index)?;
                if control.kind == Kind::Loop { control.result = false; }
                self.close_control(control)?;
                self.controls.truncate(if control.kind == Kind::Loop {
                        index + 1
                    } else { index });
                let pc =
                    if control.kind == Kind::Loop {
                        control.start
                    } else { control.end + 1 };
                self.frames.last_mut().ok_or_else(unreachable_failure)?.pc =
                    pc;
                self.observe();
                Ok(control.kind == Kind::Function)
            }
            fn finish(&mut self) -> Result<Option<Value>, ExecutionFailure> {
                let result =
                    self.frames.last().ok_or_else(|| self.invariant())?.result;
                let value = if result { Some(self.pop()?) } else { None };
                let base =
                    self.frames.last().ok_or_else(|| self.invariant())?.base;
                let controls =
                    self.frames.last().ok_or_else(||
                                    self.invariant())?.controls;
                self.work(self.values.len() - base + self.controls.len() -
                                controls + 1)?;
                let frame =
                    self.frames.pop().ok_or_else(|| self.invariant())?;
                self.values.truncate(base);
                self.controls.truncate(controls);
                self.cache.release(frame.pin).map_err(|error|
                            self.cache_error(error.failure))?;
                self.observe();
                if !self.frames.is_empty() {
                    if let Some(value) = value { self.push(value)?; }
                }
                Ok(value)
            }
            fn run(&mut self) -> Result<Option<Value>, ExecutionFailure> {
                loop {
                    let frame =
                        self.frames.last().ok_or_else(|| self.invariant())?;
                    let view =
                        self.cache.view(&frame.pin).map_err(|error|
                                    self.cache_error(error))?;
                    let instruction =
                        *view.instructions.get(frame.pc).ok_or_else(||
                                        self.invariant())?;
                    let target =
                        if let Operation::BrTable { first, count, default } =
                                instruction.operation {
                            let selector =
                                match self.values.last() {
                                    Some(Value::I32(n)) => *n as u32 as usize,
                                    _ => return Err(self.invariant()),
                                };
                            Some(if selector < count {
                                    *view.branch_targets.get(first +
                                                        selector).ok_or_else(|| self.invariant())?
                                } else { default })
                        } else { None };
                    self.function = Some(frame.function);
                    self.offset = instruction.offset;
                    self.charge(1, true)?;
                    self.work(1)?;
                    self.frames.last_mut().ok_or_else(unreachable_failure)?.pc
                        += 1;
                    let mut finished = false;
                    match instruction.operation {
                        Operation::Unreachable =>
                            return Err(self.trap("unreachable")),
                        Operation::Nop => {}
                        Operation::Const(value) => self.push(value)?,
                        Operation::Drop => { self.pop()?; }
                        Operation::Select => {
                            let cond = self.pop32()?;
                            let b = self.pop()?;
                            let a = self.pop()?;
                            self.push(if cond != 0 { a } else { b })?;
                        }
                        Operation::LocalGet(index) => {
                            let frame =
                                self.frames.last().ok_or_else(|| self.invariant())?;
                            let value =
                                *self.values.get(frame.base +
                                                        index as
                                                            usize).filter(|_|
                                                    frame.base + (index as usize) <
                                                        frame.operands).ok_or_else(|| self.invariant())?;
                            self.push(value)?;
                        }
                        Operation::LocalSet(index) | Operation::LocalTee(index) => {
                            let value =
                                if #[allow(non_exhaustive_omitted_patterns)] match instruction.operation
                                        {
                                        Operation::LocalTee(_) => true,
                                        _ => false,
                                    } {
                                    self.work(1)?;
                                    *self.values.last().ok_or_else(|| self.invariant())?
                                } else { self.pop()? };
                            let frame =
                                self.frames.last().ok_or_else(|| self.invariant())?;
                            let slot = frame.base + index as usize;
                            if slot >= frame.operands { return Err(self.invariant()); }
                            self.values[slot] = value;
                        }
                        Operation::GlobalGet(index) => {
                            let value =
                                *self.globals.get(index as
                                                    usize).ok_or_else(|| self.invariant())?;
                            self.push(value)?;
                        }
                        Operation::GlobalSet(index) => {
                            let value = self.pop()?;
                            let desc =
                                self.cache.spans().execution_global(index as
                                                usize).ok_or_else(|| self.invariant())?;
                            if !desc.mutable || value.ty() != desc.ty {
                                return Err(self.invariant());
                            }
                            self.globals[index as usize] = value;
                        }
                        Operation::Block { kind, result, end, alternative } => {
                            let cond =
                                if kind == ControlKind::If {
                                    self.pop32()? != 0
                                } else { true };
                            self.room_control()?;
                            self.work(1)?;
                            let frame =
                                self.frames.last().ok_or_else(|| self.invariant())?;
                            if self.controls.len() - frame.controls >=
                                    self.cache.spans().limits().control_depth {
                                return Err(self.error(ExecutionFailureKind::ControlExhausted,
                                            "control_depth_exceeded",
                                            (self.controls.len() - frame.controls + 1) as u64,
                                            self.cache.spans().limits().control_depth as u64));
                            }
                            self.controls.push(Control {
                                    kind: match kind {
                                        ControlKind::Block => Kind::Block,
                                        ControlKind::Loop => Kind::Loop,
                                        ControlKind::If => Kind::If,
                                    },
                                    start: frame.pc,
                                    end,
                                    height: self.values.len(),
                                    result: result.is_some(),
                                });
                            if !cond {
                                self.frames.last_mut().ok_or_else(unreachable_failure)?.pc =
                                    alternative.map_or(end, |v| v + 1);
                            }
                            self.observe();
                        }
                        Operation::Else { end } => {
                            self.frames.last_mut().ok_or_else(unreachable_failure)?.pc =
                                end
                        }
                        Operation::End => {
                            self.work(1)?;
                            let control =
                                self.controls.pop().ok_or_else(|| self.invariant())?;
                            self.close_control(control)?;
                            finished = control.kind == Kind::Function;
                            self.observe();
                        }
                        Operation::Br(depth) => finished = self.branch(depth)?,
                        Operation::BrIf(depth) => {
                            if self.pop32()? != 0 { finished = self.branch(depth)?; }
                        }
                        Operation::BrTable { .. } => {
                            self.pop32()?;
                            finished =
                                self.branch(target.ok_or_else(|| self.invariant())?)?;
                        }
                        Operation::Return => finished = true,
                        Operation::Call(function) => self.call(function)?,
                        Operation::CallIndirect(index) => {
                            let selector = self.pop32()? as u32 as usize;
                            let function =
                                self.table.get(selector).ok_or_else(||
                                                    self.trap("table_out_of_bounds"))?.ok_or_else(||
                                            self.trap("indirect_call_null"))?;
                            let expected =
                                self.cache.spans().execution_type(index).ok_or_else(||
                                            self.invariant())?;
                            let actual =
                                self.cache.spans().execution_signature(function).ok_or_else(||
                                            self.invariant())?;
                            let scan =
                                expected.params.len().checked_add(actual.params.len()).ok_or_else(||
                                            self.invariant())?;
                            self.work(scan)?;
                            if self.cache.spans().execution_type(index) !=
                                    self.cache.spans().execution_signature(function) {
                                return Err(self.trap("indirect_call_type_mismatch"));
                            }
                            self.call(function)?;
                        }
                        Operation::MemorySize =>
                            self.push(Value::I32(self.usage.memory_pages as i32))?,
                        Operation::MemoryGrow => self.grow()?,
                        Operation::MemoryCopy => self.copy()?,
                        Operation::MemoryFill => self.fill()?,
                        Operation::Load { opcode, offset } =>
                            self.load(opcode, offset)?,
                        Operation::Store { opcode, offset } =>
                            self.store(opcode, offset)?,
                        Operation::Numeric(opcode) => self.numeric(opcode, false)?,
                        Operation::Saturating(opcode) =>
                            self.numeric(opcode, true)?,
                    }
                    if finished {
                        let result = self.finish()?;
                        if self.frames.is_empty() { return Ok(result); }
                    }
                }
            }
            fn numeric(&mut self, opcode: u8, saturating: bool)
                -> Result<(), ExecutionFailure> {
                let (ty, count, _) =
                    if saturating {
                        let (a, b) = crate::float::saturating_shape(opcode);
                        (a, 1, b)
                    } else {
                        crate::float::shape(opcode).unwrap_or_else(||
                                crate::validate::numeric_type(opcode))
                    };
                let frame =
                    self.frames.last().ok_or_else(|| self.invariant())?;
                if self.values.len() - frame.operands < count ||
                        self.values[self.values.len() -
                                            count..].iter().any(|v| v.ty() != ty) {
                    return Err(self.invariant());
                }
                self.work(count + 1)?;
                let result =
                    borrowed::numeric::<borrowed::FrozenMode>(self, opcode,
                        saturating);
                self.observe();
                result.map_err(|code| self.trap(code))
            }
            fn range(&self, address: usize, len: usize)
                -> Result<std::ops::Range<usize>, ExecutionFailure> {
                let end =
                    address.checked_add(len).filter(|end|
                                    *end <=
                                        self.memory.len()).ok_or_else(||
                                self.trap("memory_out_of_bounds"))?;
                Ok(address..end)
            }
            fn bulk(&mut self, len: usize) -> Result<(), ExecutionFailure> {
                self.charge(len.div_ceil(64) as u64, false)?;
                self.work(len)
            }
            fn copy(&mut self) -> Result<(), ExecutionFailure> {
                let len = self.pop32()? as u32 as usize;
                let src = self.pop32()? as u32 as usize;
                let dst = self.pop32()? as u32 as usize;
                self.range(src, len)?;
                self.range(dst, len)?;
                self.bulk(len)?;
                if dst > src {
                    let mut left = len;
                    while left != 0 {
                        self.check()?;
                        let n = left.min(CHUNK);
                        left -= n;
                        self.memory.copy_within(src + left..src + left + n,
                            dst + left);
                    }
                } else {
                    for at in (0..len).step_by(CHUNK) {
                        self.check()?;
                        let n = (len - at).min(CHUNK);
                        self.memory.copy_within(src + at..src + at + n, dst + at);
                    }
                }
                Ok(())
            }
            fn fill(&mut self) -> Result<(), ExecutionFailure> {
                let len = self.pop32()? as u32 as usize;
                let value = self.pop32()? as u8;
                let dst = self.pop32()? as u32 as usize;
                let range = self.range(dst, len)?;
                self.bulk(len)?;
                for start in (range.start..range.end).step_by(CHUNK) {
                    self.check()?;
                    let end = (start + CHUNK).min(range.end);
                    self.memory[start..end].fill(value);
                }
                Ok(())
            }
            fn grow(&mut self) -> Result<(), ExecutionFailure> {
                let delta = self.pop32()? as u32;
                let old = self.usage.memory_pages;
                let maximum =
                    self.cache.spans().execution_memory().ok_or_else(||
                                        self.invariant())?.1.min(self.cache.spans().limits().memory_pages);
                let Some(next) =
                    old.checked_add(delta).filter(|next|
                            *next <=
                                maximum) else { return self.push(Value::I32(-1)); };
                if delta == 0 { return self.push(Value::I32(old as i32)); }
                let bytes =
                    (next as
                                        usize).checked_mul(PAGE).ok_or_else(|| self.invariant())?;
                self.work(bytes.checked_add(self.memory.len()).ok_or_else(||
                                    self.invariant())?)?;
                let mut memory = self.allocation(bytes)?;
                let result =
                    (||
                                {
                                    for at in (0..bytes).step_by(CHUNK) {
                                        self.check()?;
                                        memory.resize((at + CHUNK).min(bytes), 0);
                                    }
                                    for at in (0..self.memory.len()).step_by(CHUNK) {
                                        self.check()?;
                                        let end = (at + CHUNK).min(self.memory.len());
                                        memory[at..end].copy_from_slice(&self.memory[at..end]);
                                    }
                                    self.check()
                                })();
                if let Err(error) = result {
                    drop(memory);
                    self.usage.state_reserved -= bytes;
                    return Err(error);
                }
                let old_bytes = self.memory.len();
                self.memory = memory;
                self.usage.state_reserved -= old_bytes;
                self.usage.memory_pages = next;
                self.push(Value::I32(old as i32))
            }
            fn load(&mut self, opcode: u8, offset: u32)
                -> Result<(), ExecutionFailure> {
                let address = self.pop32()? as u32 as usize;
                let width = width(opcode);
                let start =
                    address.checked_add(offset as
                                    usize).ok_or_else(|| self.trap("memory_out_of_bounds"))?;
                let range = self.range(start, width)?;
                self.work(width)?;
                let mut padded = [0; 8];
                padded[..width].copy_from_slice(&self.memory[range]);
                let x = u64::from_le_bytes(padded);
                let value =
                    match opcode {
                        0x28 => Value::I32(x as i32),
                        0x29 => Value::I64(x as i64),
                        0x2a => Value::F32(x as u32),
                        0x2b => Value::F64(x),
                        0x2c => Value::I32(x as i8 as i32),
                        0x2d => Value::I32(x as u8 as i32),
                        0x2e => Value::I32(x as i16 as i32),
                        0x2f => Value::I32(x as u16 as i32),
                        0x30 => Value::I64(x as i8 as i64),
                        0x31 => Value::I64(x as u8 as i64),
                        0x32 => Value::I64(x as i16 as i64),
                        0x33 => Value::I64(x as u16 as i64),
                        0x34 => Value::I64(x as i32 as i64),
                        0x35 => Value::I64(x as u32 as i64),
                        _ => return Err(self.invariant()),
                    };
                self.push(value)
            }
            fn store(&mut self, opcode: u8, offset: u32)
                -> Result<(), ExecutionFailure> {
                let value = self.pop()?;
                let address = self.pop32()? as u32 as usize;
                let width = width(opcode);
                let start =
                    address.checked_add(offset as
                                    usize).ok_or_else(|| self.trap("memory_out_of_bounds"))?;
                let range = self.range(start, width)?;
                self.work(width)?;
                let bits =
                    match value {
                        Value::I32(x) => x as u32 as u64,
                        Value::I64(x) => x as u64,
                        Value::F32(x) => x as u64,
                        Value::F64(x) => x,
                    };
                self.memory[range].copy_from_slice(&bits.to_le_bytes()[..width]);
                Ok(())
            }
        }
        impl Drop for SpanInstance {
            fn drop(&mut self) { self.cleanup(); }
        }
        fn width(op: u8) -> usize {
            match op {
                0x28 | 0x2a | 0x34 | 0x35 | 0x36 | 0x38 | 0x3e => 4,
                0x29 | 0x2b | 0x37 | 0x39 => 8,
                0x2e | 0x2f | 0x32 | 0x33 | 0x3b | 0x3d => 2,
                _ => 1,
            }
        }
        fn unreachable_failure() -> ExecutionFailure {
            ExecutionFailure {
                kind: ExecutionFailureKind::Invariant,
                code: "execution_invariant",
                function: None,
                offset: 0,
                attempted: 0,
                limit: 0,
                usage: ExecutionUsage::default(),
                cache_failure: None,
            }
        }
        struct ScalarReader<'a> {
            bytes: &'a [u8],
            at: usize,
        }
        impl ScalarReader<'_> {
            fn byte(&mut self) -> Option<u8> {
                let b = *self.bytes.get(self.at)?;
                self.at += 1;
                Some(b)
            }
            fn uint(&mut self) -> Option<u32> {
                let mut n = 0;
                for i in 0..5 {
                    let b = self.byte()?;
                    n |= (b as u32 & 127) << (7 * i);
                    if b & 128 == 0 { return Some(n); }
                }
                None
            }
            fn signed(&mut self) -> Option<i64> {
                let mut n = 0u64;
                for i in 0..10 {
                    let b = self.byte()?;
                    n |= (b as u64 & 127).wrapping_shl(7 * i);
                    if b & 128 == 0 {
                        let shift = 7 * (i + 1);
                        if shift < 64 && b & 64 != 0 { n |= u64::MAX << shift; }
                        return Some(n as i64);
                    }
                }
                None
            }
        }
