#![feature(prelude_import)]
//! Owned bounded WebAssembly profiles. No production runtime dependencies.
extern crate std;
#[prelude_import]
use std::prelude::rust_2021::*;
mod decode {







    use crate::*;
    use std::collections::{BTreeMap, BTreeSet};
    pub struct Inventory {
        pub profile: Profile,
        pub imports: Vec<(String, String, u32)>,
        pub exports: Vec<(String, u8, u32)>,
        pub opcodes: BTreeMap<u8, usize>,
        pub complete: bool,
        pub extended_opcodes: BTreeMap<String, usize>,
        pub inventory_error: Option<Error>,
        pub error: Option<Error>,
    }
    #[automatically_derived]
    impl ::core::clone::Clone for Inventory {
        #[inline]
        fn clone(&self) -> Inventory {
            Inventory {
                profile: ::core::clone::Clone::clone(&self.profile),
                imports: ::core::clone::Clone::clone(&self.imports),
                exports: ::core::clone::Clone::clone(&self.exports),
                opcodes: ::core::clone::Clone::clone(&self.opcodes),
                complete: ::core::clone::Clone::clone(&self.complete),
                extended_opcodes: ::core::clone::Clone::clone(&self.extended_opcodes),
                inventory_error: ::core::clone::Clone::clone(&self.inventory_error),
                error: ::core::clone::Clone::clone(&self.error),
            }
        }
    }
    #[automatically_derived]
    impl ::core::fmt::Debug for Inventory {
        #[inline]
        fn fmt(&self, f: &mut ::core::fmt::Formatter) -> ::core::fmt::Result {
            let names: &'static _ =
                &["profile", "imports", "exports", "opcodes", "complete",
                            "extended_opcodes", "inventory_error", "error"];
            let values: &[&dyn ::core::fmt::Debug] =
                &[&self.profile, &self.imports, &self.exports, &self.opcodes,
                            &self.complete, &self.extended_opcodes,
                            &self.inventory_error, &&self.error];
            ::core::fmt::Formatter::debug_struct_fields_finish(f, "Inventory",
                names, values)
        }
    }
    #[automatically_derived]
    impl ::core::default::Default for Inventory {
        #[inline]
        fn default() -> Inventory {
            Inventory {
                profile: ::core::default::Default::default(),
                imports: ::core::default::Default::default(),
                exports: ::core::default::Default::default(),
                opcodes: ::core::default::Default::default(),
                complete: ::core::default::Default::default(),
                extended_opcodes: ::core::default::Default::default(),
                inventory_error: ::core::default::Default::default(),
                error: ::core::default::Default::default(),
            }
        }
    }
    impl Inventory {
        pub fn json(&self) -> String {
            let imports =
                self.imports.iter().map(|(m, n, t)|
                                {
                                    ::alloc::__export::must_use({
                                            ::alloc::fmt::format(format_args!("{{\"module\":{0},\"name\":{1},\"type_index\":{2}}}",
                                                    json_string(m), json_string(n), t))
                                        })
                                }).collect::<Vec<_>>().join(",");
            let exports =
                self.exports.iter().map(|(n, k, i)|
                                ::alloc::__export::must_use({
                                        ::alloc::fmt::format(format_args!("{{\"name\":{0},\"kind\":{1},\"index\":{2}}}",
                                                json_string(n), k, i))
                                    })).collect::<Vec<_>>().join(",");
            let ops =
                self.opcodes.iter().map(|(o, c)|
                                ::alloc::__export::must_use({
                                        ::alloc::fmt::format(format_args!("{{\"opcode\":\"0x{0:02x}\",\"count\":{1}}}",
                                                o, c))
                                    })).collect::<Vec<_>>().join(",");
            let extended =
                self.extended_opcodes.iter().map(|(o, c)|
                                ::alloc::__export::must_use({
                                        ::alloc::fmt::format(format_args!("{{\"opcode\":{0},\"count\":{1}}}",
                                                json_string(o), c))
                                    })).collect::<Vec<_>>().join(",");
            ::alloc::__export::must_use({
                    ::alloc::fmt::format(format_args!("{{\"profile\":{0},\"valid\":{1},\"inventory_complete\":{2},\"imports\":[{5}],\"exports\":[{6}],\"opcodes\":[{7}],\"extended_opcodes\":[{8}],\"error\":{3},\"inventory_error\":{4}}}",
                            json_string(self.profile.name()), self.error.is_none(),
                            self.complete,
                            self.error.as_ref().map(Error::json).unwrap_or_else(||
                                    "null".into()),
                            self.inventory_error.as_ref().map(Error::json).unwrap_or_else(||
                                    "null".into()), imports, exports, ops, extended))
                })
        }
    }
    pub struct Module {
        pub(crate) source_bytes: usize,
        pub(crate) profile: Profile,
        pub(crate) types: Vec<Signature>,
        pub(crate) imports: Vec<Import>,
        pub(crate) functions: Vec<Function>,
        pub(crate) globals: Vec<Global>,
        pub(crate) exports: BTreeMap<String, (u8, u32)>,
        pub(crate) memory: Option<(u32, u32)>,
        pub(crate) table: Option<(u32, u32)>,
        pub(crate) elements: Vec<(u32, Vec<u32>)>,
        pub(crate) data: Vec<(u32, Vec<u8>)>,
        pub inventory: Inventory,
    }
    #[automatically_derived]
    impl ::core::clone::Clone for Module {
        #[inline]
        fn clone(&self) -> Module {
            Module {
                source_bytes: ::core::clone::Clone::clone(&self.source_bytes),
                profile: ::core::clone::Clone::clone(&self.profile),
                types: ::core::clone::Clone::clone(&self.types),
                imports: ::core::clone::Clone::clone(&self.imports),
                functions: ::core::clone::Clone::clone(&self.functions),
                globals: ::core::clone::Clone::clone(&self.globals),
                exports: ::core::clone::Clone::clone(&self.exports),
                memory: ::core::clone::Clone::clone(&self.memory),
                table: ::core::clone::Clone::clone(&self.table),
                elements: ::core::clone::Clone::clone(&self.elements),
                data: ::core::clone::Clone::clone(&self.data),
                inventory: ::core::clone::Clone::clone(&self.inventory),
            }
        }
    }
    #[automatically_derived]
    impl ::core::fmt::Debug for Module {
        #[inline]
        fn fmt(&self, f: &mut ::core::fmt::Formatter) -> ::core::fmt::Result {
            let names: &'static _ =
                &["source_bytes", "profile", "types", "imports", "functions",
                            "globals", "exports", "memory", "table", "elements", "data",
                            "inventory"];
            let values: &[&dyn ::core::fmt::Debug] =
                &[&self.source_bytes, &self.profile, &self.types,
                            &self.imports, &self.functions, &self.globals,
                            &self.exports, &self.memory, &self.table, &self.elements,
                            &self.data, &&self.inventory];
            ::core::fmt::Formatter::debug_struct_fields_finish(f, "Module",
                names, values)
        }
    }
    impl Module {
        pub fn decode(bytes: &[u8], limits: &Limits) -> Result<Self, Error> {
            let mut inv =
                Inventory { profile: limits.profile, ..Inventory::default() };
            parse(bytes, limits, &mut inv, ImportAdmission::Legacy)
        }
        pub fn function_count(&self) -> usize {
            self.imports.len() + self.functions.len()
        }
        pub fn exports(&self) -> Vec<String> {
            self.exports.keys().cloned().collect()
        }
        pub(crate) fn signature(&self, index: u32) -> Option<&Signature> {
            let ty =
                if (index as usize) < self.imports.len() {
                    self.imports[index as usize].type_index
                } else {
                    self.functions.get(index as usize -
                                    self.imports.len())?.type_index
                };
            self.types.get(ty as usize)
        }
    }
    pub fn validation_inventory(bytes: &[u8], limits: &Limits) -> Inventory {
        let mut inv =
            Inventory { profile: limits.profile, ..Inventory::default() };
        if let Err(e) =
                parse(bytes, limits, &mut inv, ImportAdmission::Legacy) {
            inv.error = Some(e);
        }
        inv
    }
    pub(crate) struct Reader<'a> {
        pub(crate) bytes: &'a [u8],
        pub(crate) pos: usize,
        base: usize,
        pub(crate) function: Option<u32>,
    }
    impl<'a> Reader<'a> {
        pub(crate) fn at(bytes: &'a [u8], base: usize) -> Self {
            Self { bytes, pos: 0, base, function: None }
        }
        pub(crate) fn offset(&self) -> usize { self.base + self.pos }
        pub(crate) fn err(&self, code: &'static str, m: impl Into<String>)
            -> Error {
            Error::new(code, m, self.function, self.offset())
        }
        pub(crate) fn byte(&mut self) -> Result<u8, Error> {
            let b =
                *self.bytes.get(self.pos).ok_or_else(||
                                self.err("malformed", "unexpected end of input"))?;
            self.pos += 1;
            Ok(b)
        }
        pub(crate) fn take(&mut self, n: usize) -> Result<&'a [u8], Error> {
            let end =
                self.pos.checked_add(n).filter(|v|
                                *v <=
                                    self.bytes.len()).ok_or_else(||
                            self.err("malformed", "declared length exceeds input"))?;
            let b = &self.bytes[self.pos..end];
            self.pos = end;
            Ok(b)
        }
        pub(crate) fn u32(&mut self) -> Result<u32, Error> {
            let mut value = 0u32;
            for i in 0..5 {
                let b = self.byte()?;
                if i == 4 && b & 0xf0 != 0 {
                    return Err(self.err("malformed", "u32 LEB128 overflow"));
                }
                value |= ((b & 0x7f) as u32) << (7 * i);
                if b & 0x80 == 0 { return Ok(value); }
            }
            Err(self.err("malformed", "unterminated u32 LEB128"))
        }
        pub(crate) fn signed(&mut self, bits: u32) -> Result<i64, Error> {
            let max = bits.div_ceil(7);
            let mut value = 0u64;
            for i in 0..max {
                let b = self.byte()?;
                let p = b & 0x7f;
                if i == max - 1 {
                    let used = bits - 7 * i;
                    let positive_max = (1u8 << (used - 1)) - 1;
                    let negative_min = 0x7f ^ positive_max;
                    if b & 0x80 != 0 || (p > positive_max && p < negative_min) {
                        return Err(self.err("malformed", "signed LEB128 overflow"));
                    }
                }
                value |= (p as u64).wrapping_shl(7 * i);
                if b & 0x80 == 0 {
                    let shift = 7 * (i + 1);
                    if shift < 64 && b & 0x40 != 0 {
                        value |= u64::MAX << shift;
                    }
                    return Ok(if bits == 32 {
                                value as i32 as i64
                            } else { value as i64 });
                }
            }
            Err(self.err("malformed", "unterminated signed LEB128"))
        }
        pub(crate) fn count(&mut self, max: usize) -> Result<usize, Error> {
            let n = self.u32()? as usize;
            if n > max {
                return Err(self.err("limit",
                            "vector count exceeds profile limit"));
            }
            Ok(n)
        }
        pub(crate) fn name(&mut self) -> Result<String, Error> {
            let n = self.count(4096)?;
            let b = self.take(n)?;
            std::str::from_utf8(b).map(str::to_owned).map_err(|_|
                    self.err("malformed", "name is not UTF-8"))
        }
        fn ty(&mut self, profile: Profile) -> Result<Type, Error> {
            match self.byte()? {
                0x7f => Ok(Type::I32),
                0x7e => Ok(Type::I64),
                0x7d if profile.floats() => Ok(Type::F32),
                0x7c if profile.floats() => Ok(Type::F64),
                _ =>
                    Err(self.err("unsupported",
                            "value type is outside the selected profile")),
            }
        }
        pub(crate) fn end(&self) -> Result<(), Error> {
            if self.pos != self.bytes.len() {
                Err(self.err("malformed",
                        "trailing bytes in section or body"))
            } else { Ok(()) }
        }
        fn constant(&mut self, profile: Profile) -> Result<Value, Error> {
            let v =
                match self.byte()? {
                    0x41 => Value::I32(self.signed(32)? as i32),
                    0x42 => Value::I64(self.signed(64)?),
                    0x43 if profile.floats() => {
                        Value::F32(u32::from_le_bytes(self.take(4)?.try_into().unwrap()))
                    }
                    0x44 if profile.floats() => {
                        Value::F64(u64::from_le_bytes(self.take(8)?.try_into().unwrap()))
                    }
                    _ => {
                        return Err(self.err("unsupported",
                                    "constant expressions require one supported numeric constant"))
                    }
                };
            if self.byte()? != 0x0b {
                return Err(self.err("unsupported",
                            "extended constant expression"));
            }
            Ok(v)
        }
    }
    fn parse(bytes: &[u8], limits: &Limits, inv: &mut Inventory,
        admission: ImportAdmission) -> Result<Module, Error> {
        limits.check()?;
        if bytes.len() > limits.module_bytes {
            return Err(Error::new("limit", "module byte limit exceeded", None,
                        0));
        }
        let mut r = Reader::at(bytes, 0);
        if r.take(8)? != b"\0asm\x01\0\0\0" {
            return Err(r.err("malformed",
                        "expected Wasm magic and version 1"));
        }
        let mut m =
            Module {
                source_bytes: bytes.len(),
                profile: limits.profile,
                types: ::alloc::vec::Vec::new(),
                imports: ::alloc::vec::Vec::new(),
                functions: ::alloc::vec::Vec::new(),
                globals: ::alloc::vec::Vec::new(),
                exports: BTreeMap::new(),
                memory: None,
                table: None,
                elements: ::alloc::vec::Vec::new(),
                data: ::alloc::vec::Vec::new(),
                inventory: Inventory::default(),
            };
        let mut defined = ::alloc::vec::Vec::new();
        let mut code_seen = false;
        let mut last = 0u8;
        let mut seen = BTreeSet::new();
        let mut instructions = 0;
        while r.pos < bytes.len() {
            let id = r.byte()?;
            let n = r.u32()? as usize;
            let base = r.offset();
            let data = r.take(n)?;
            let mut s = Reader::at(data, base);
            if id == 0 { s.name()?; continue; }
            if id > 11 {
                return Err(s.err("unsupported",
                            ::alloc::__export::must_use({
                                    ::alloc::fmt::format(format_args!("section {0} is outside this profile",
                                            id))
                                })));
            }
            if id < last || !seen.insert(id) {
                return Err(s.err("malformed",
                            "duplicate or out-of-order section"));
            }
            last = id;
            match id {
                1 => {
                    for _ in 0..s.count(limits.types)? {
                        if s.byte()? != 0x60 {
                            return Err(s.err("unsupported", "non-function type"));
                        }
                        let mut params = ::alloc::vec::Vec::new();
                        for _ in 0..s.count(limits.locals)? {
                            params.push(s.ty(limits.profile)?);
                        }
                        let results = s.count(1)?;
                        let result =
                            if results == 1 {
                                Some(s.ty(limits.profile)?)
                            } else { None };
                        m.types.push(Signature { params, result });
                    }
                }
                2 => {
                    for _ in 0..s.count(limits.functions)? {
                        let module = s.name()?;
                        let name = s.name()?;
                        let kind = s.byte()?;
                        if kind != 0 {
                            return Err(s.err("unsupported",
                                        "only explicit approved function imports are supported"));
                        }
                        let type_index = s.u32()?;
                        inv.imports.push((module.clone(), name.clone(),
                                type_index));
                        m.imports.push(Import { module, name, type_index });
                    }
                }
                3 => {
                    for _ in
                        0..s.count(limits.functions.saturating_sub(m.imports.len()))?
                        {
                        defined.push(s.u32()?);
                    }
                }
                4 if limits.profile == Profile::TableMemoryV3 => {
                    let count = s.count(1)?;
                    if count == 1 {
                        if s.byte()? != 0x70 {
                            return Err(s.err("unsupported",
                                        "only funcref tables are supported"));
                        }
                        let flags = s.byte()?;
                        if flags > 1 {
                            return Err(s.err("unsupported",
                                        "table64/shared/initialized table form unsupported"));
                        }
                        let min = s.u32()?;
                        let max =
                            if flags == 1 {
                                s.u32()?
                            } else { limits.table_elements as u32 };
                        if min > max || max as usize > limits.table_elements {
                            return Err(s.err("limit", "table bounds exceed profile"));
                        }
                        m.table = Some((min, max));
                    }
                }
                9 if limits.profile == Profile::TableMemoryV3 => {
                    let mut entries = 0;
                    for _ in 0..s.count(4096)? {
                        let flags = s.u32()?;
                        if !#[allow(non_exhaustive_omitted_patterns)] match flags {
                                    0 | 2 => true,
                                    _ => false,
                                } {
                            return Err(s.err("unsupported",
                                        "only active function-index element segments are supported"));
                        }
                        if flags == 2 && s.u32()? != 0 {
                            return Err(s.err("validation",
                                        "element table index must be zero"));
                        }
                        let offset =
                            match s.constant(limits.profile)? {
                                Value::I32(x) => x as u32,
                                _ =>
                                    return Err(s.err("validation",
                                                "element offset must be i32")),
                            };
                        if flags == 2 && s.byte()? != 0 {
                            return Err(s.err("unsupported",
                                        "element kind must be funcref"));
                        }
                        let count =
                            s.count(limits.table_elements.saturating_sub(entries))?;
                        entries += count;
                        let mut functions = Vec::with_capacity(count);
                        for _ in 0..count { functions.push(s.u32()?); }
                        m.elements.push((offset, functions));
                    }
                }
                4 | 8 | 9 => {
                    return Err(s.err("unsupported",
                                ::alloc::__export::must_use({
                                        ::alloc::fmt::format(format_args!("section {0} is outside selected profile",
                                                id))
                                    })))
                }
                5 => {
                    let n = s.count(1)?;
                    if n == 1 {
                        let flags = s.byte()?;
                        if flags > 1 {
                            return Err(s.err("unsupported",
                                        "shared/memory64 memory is unsupported"));
                        }
                        let min = s.u32()?;
                        let max =
                            if flags == 1 { s.u32()? } else { limits.memory_pages };
                        if min > max || max > limits.memory_pages {
                            return Err(s.err("limit", "memory bounds exceed profile"));
                        }
                        m.memory = Some((min, max));
                    }
                }
                6 => {
                    for _ in 0..s.count(1024)? {
                        let t = s.ty(limits.profile)?;
                        let mutable =
                            match s.byte()? {
                                0 => false,
                                1 => true,
                                _ =>
                                    return Err(s.err("malformed", "invalid global mutability")),
                            };
                        let value = s.constant(limits.profile)?;
                        if value.ty() != t {
                            return Err(s.err("validation",
                                        "global initializer type mismatch"));
                        }
                        m.globals.push(Global { value, mutable });
                    }
                }
                7 => {
                    for _ in 0..s.count(4096)? {
                        let name = s.name()?;
                        let kind = s.byte()?;
                        let index = s.u32()?;
                        if m.exports.insert(name.clone(), (kind, index)).is_some() {
                            return Err(s.err("validation", "duplicate export name"));
                        }
                        inv.exports.push((name, kind, index));
                    }
                }
                10 => {
                    code_seen = true;
                    let count = s.count(limits.functions)?;
                    if count != defined.len() {
                        return Err(s.err("validation",
                                    "function and code counts differ"));
                    }
                    for (i, type_index) in defined.iter().enumerate() {
                        let size = s.u32()? as usize;
                        let base = s.offset();
                        let body = s.take(size)?;
                        let mut b = Reader::at(body, base);
                        b.function = Some((m.imports.len() + i) as u32);
                        let mut locals = ::alloc::vec::Vec::new();
                        for _ in 0..b.count(limits.locals)? {
                            let n =
                                b.count(limits.locals.saturating_sub(locals.len()))?;
                            let t = b.ty(limits.profile)?;
                            locals.extend(std::iter::repeat_n(t, n));
                        }
                        let code =
                            decode_code(&mut b, limits, inv, &mut instructions)?;
                        b.end()?;
                        m.functions.push(Function {
                                type_index: *type_index,
                                locals,
                                code,
                                offset: base,
                            });
                    }
                }
                11 => {
                    for _ in 0..s.count(4096)? {
                        let flags = s.u32()?;
                        if flags != 0 && flags != 2 {
                            return Err(s.err("unsupported",
                                        "passive data segments unsupported"));
                        }
                        if flags == 2 && s.u32()? != 0 {
                            return Err(s.err("validation",
                                        "memory index must be zero"));
                        }
                        let offset =
                            match s.constant(limits.profile)? {
                                Value::I32(v) => v as u32,
                                _ =>
                                    return Err(s.err("validation", "data offset must be i32")),
                            };
                        let n = s.count(limits.module_bytes)?;
                        m.data.push((offset, s.take(n)?.to_vec()));
                    }
                }
                _ => return Err(s.err("malformed", "unknown section")),
            }
            s.end()?;
        }
        if !defined.is_empty() && !code_seen {
            return Err(r.err("validation", "functions have no code section"));
        }
        inv.complete = true;
        crate::validate::module_with_admission(&m, limits, admission)?;
        m.inventory = inv.clone();
        Ok(m)
    }
    fn decode_code(r: &mut Reader<'_>, limits: &Limits, inv: &mut Inventory,
        total: &mut usize) -> Result<Vec<Instruction>, Error> {
        let mut code: Vec<Instruction> = ::alloc::vec::Vec::new();
        let mut controls: Vec<(usize, Option<usize>)> =
            ::alloc::vec::Vec::new();
        loop {
            let offset = r.offset();
            let o = r.byte()?;
            *inv.opcodes.entry(o).or_default() += 1;
            *total += 1;
            if *total > limits.instructions {
                return Err(r.err("limit",
                            "instruction count exceeds profile"));
            }
            let op =
                match o {
                    0 => Op::Unreachable,
                    1 => Op::Nop,
                    2..=4 => {
                        if controls.len() + 1 >= limits.control_depth {
                            return Err(r.err("limit",
                                        "control nesting exceeds profile"));
                        }
                        let t = r.byte()?;
                        let result =
                            match t {
                                0x40 => None,
                                0x7f => Some(Type::I32),
                                0x7e => Some(Type::I64),
                                0x7d if limits.profile.floats() => Some(Type::F32),
                                0x7c if limits.profile.floats() => Some(Type::F64),
                                _ => {
                                    return Err(r.err("unsupported",
                                                "indexed/multivalue block types unsupported"))
                                }
                            };
                        controls.push((code.len(), None));
                        Op::Block {
                            kind: match o {
                                2 => BlockKind::Block,
                                3 => BlockKind::Loop,
                                _ => BlockKind::If,
                            },
                            result,
                            end: 0,
                            alternative: None,
                        }
                    }
                    5 => {
                        let (start, alternative) =
                            controls.last_mut().ok_or_else(||
                                        r.err("validation", "else without if"))?;
                        if alternative.is_some() ||
                                !#[allow(non_exhaustive_omitted_patterns)] match code[*start].op
                                        {
                                        Op::Block { kind: BlockKind::If, .. } => true,
                                        _ => false,
                                    } {
                            return Err(r.err("validation",
                                        "else without unmatched if"));
                        }
                        *alternative = Some(code.len());
                        Op::Else { end: 0 }
                    }
                    0x0b => {
                        if let Some((start, alternative)) = controls.pop() {
                            let end = code.len();
                            if let Op::Block { end: e, alternative: a, .. } =
                                    &mut code[start].op {
                                *e = end;
                                *a = alternative;
                            }
                            if let Some(i) = alternative {
                                code[i].op = Op::Else { end };
                            }
                            Op::End
                        } else {
                            code.push(Instruction { op: Op::End, offset });
                            return Ok(code);
                        }
                    }
                    0x0c => Op::Br(r.u32()?),
                    0x0d => Op::BrIf(r.u32()?),
                    0x0e => {
                        let n = r.count(limits.instructions)?;
                        let mut labels = ::alloc::vec::Vec::new();
                        for _ in 0..n { labels.push(r.u32()?); }
                        Op::BrTable(labels, r.u32()?)
                    }
                    0x0f => Op::Return,
                    0x10 => Op::Call(r.u32()?),
                    0x11 if limits.profile == Profile::TableMemoryV3 => {
                        let ty = r.u32()?;
                        if r.u32()? != 0 {
                            return Err(r.err("validation",
                                        "call_indirect table index must be zero"));
                        }
                        Op::CallIndirect(ty)
                    }
                    0x1a => Op::Drop,
                    0x1b => Op::Select,
                    0x20 => Op::LocalGet(r.u32()?),
                    0x21 => Op::LocalSet(r.u32()?),
                    0x22 => Op::LocalTee(r.u32()?),
                    0x23 => Op::GlobalGet(r.u32()?),
                    0x24 => Op::GlobalSet(r.u32()?),
                    0x28..=0x35 => {
                        if #[allow(non_exhaustive_omitted_patterns)] match o {
                                    0x2a | 0x2b => true,
                                    _ => false,
                                } && !limits.profile.floats() {
                            return Err(Error::new("unsupported",
                                        "float load outside integer profile", r.function, offset));
                        }
                        let align = r.u32()?;
                        let natural =
                            match o {
                                0x28 | 0x2a | 0x34 | 0x35 => 2,
                                0x29 | 0x2b => 3,
                                0x2e | 0x2f | 0x32 | 0x33 => 1,
                                _ => 0,
                            };
                        if align > natural {
                            return Err(r.err("validation",
                                        "load alignment exceeds natural width"));
                        }
                        Op::Load { opcode: o, offset: r.u32()? }
                    }
                    0x36..=0x3e => {
                        if #[allow(non_exhaustive_omitted_patterns)] match o {
                                    0x38 | 0x39 => true,
                                    _ => false,
                                } && !limits.profile.floats() {
                            return Err(Error::new("unsupported",
                                        "float store outside integer profile", r.function, offset));
                        }
                        let align = r.u32()?;
                        let natural =
                            match o {
                                0x36 | 0x38 | 0x3e => 2,
                                0x37 | 0x39 => 3,
                                0x3b | 0x3d => 1,
                                _ => 0,
                            };
                        if align > natural {
                            return Err(r.err("validation",
                                        "store alignment exceeds natural width"));
                        }
                        Op::Store { opcode: o, offset: r.u32()? }
                    }
                    0x3f | 0x40 => {
                        if r.byte()? != 0 {
                            return Err(r.err("unsupported",
                                        "memory index must be canonical zero"));
                        }
                        if o == 0x3f { Op::MemorySize } else { Op::MemoryGrow }
                    }
                    0x41 => Op::Const(Value::I32(r.signed(32)? as i32)),
                    0x42 => Op::Const(Value::I64(r.signed(64)?)),
                    0x43 if limits.profile.floats() =>
                        Op::Const(Value::F32(u32::from_le_bytes(r.take(4)?.try_into().unwrap()))),
                    0x44 if limits.profile.floats() =>
                        Op::Const(Value::F64(u64::from_le_bytes(r.take(8)?.try_into().unwrap()))),
                    0x5b..=0x66 | 0x8b..=0xa6 | 0xa8..=0xab | 0xae..=0xbf if
                        limits.profile.floats() => {
                        Op::Numeric(o)
                    }
                    0xfc if limits.profile.floats() => {
                        let sub = r.u32()?;
                        *inv.extended_opcodes.entry(::alloc::__export::must_use({
                                                ::alloc::fmt::format(format_args!("0xfc:{0}", sub))
                                            })).or_default() += 1;
                        match sub {
                            0..=7 => Op::Saturating(sub as u8),
                            10 if limits.profile == Profile::TableMemoryV3 => {
                                if r.u32()? != 0 || r.u32()? != 0 {
                                    return Err(r.err("validation",
                                                "memory.copy indices must be zero"));
                                }
                                Op::MemoryCopy
                            }
                            11 if limits.profile == Profile::TableMemoryV3 => {
                                if r.u32()? != 0 {
                                    return Err(r.err("validation",
                                                "memory.fill index must be zero"));
                                }
                                Op::MemoryFill
                            }
                            _ => {
                                return Err(Error::new("unsupported",
                                            ::alloc::__export::must_use({
                                                    ::alloc::fmt::format(format_args!("unsupported 0xfc subopcode {0}",
                                                            sub))
                                                }), r.function, offset))
                            }
                        }
                    }
                    0x45..=0x5a | 0x67..=0x8a | 0xa7 | 0xac | 0xad | 0xc0..=0xc4
                        => Op::Numeric(o),
                    _ => {
                        return Err(Error::new("unsupported",
                                    ::alloc::__export::must_use({
                                            ::alloc::fmt::format(format_args!("unsupported opcode 0x{0:02x}",
                                                    o))
                                        }), r.function, offset))
                    }
                };
            code.push(Instruction { op, offset });
        }
    }
}
mod execute {
    use crate::*;
    use std::sync::{
        atomic::{AtomicBool, Ordering},
        Arc,
    };
    /// Cloneable cooperative cancellation flag, checked before each instruction/import.
    pub struct Cancellation(Arc<AtomicBool>);
    #[automatically_derived]
    impl ::core::clone::Clone for Cancellation {
        #[inline]
        fn clone(&self) -> Cancellation {
            Cancellation(::core::clone::Clone::clone(&self.0))
        }
    }
    #[automatically_derived]
    impl ::core::default::Default for Cancellation {
        #[inline]
        fn default() -> Cancellation {
            Cancellation(::core::default::Default::default())
        }
    }
    impl Cancellation {
        pub fn cancel(&self) { self.0.store(true, Ordering::Relaxed); }
        pub fn is_cancelled(&self) -> bool { self.0.load(Ordering::Relaxed) }
    }
    pub struct Instance {
        module: Module,
        limits: Limits,
        memory: Vec<u8>,
        table: Vec<Option<u32>>,
        globals: Vec<Value>,
        cancellation: Cancellation,
        pub fuel_remaining: u64,
        pub host_calls_used: u64,
    }
    struct Label {
        kind: BlockKind,
        start: usize,
        end: usize,
        height: usize,
        result: bool,
    }
    struct Frame {
        function: u32,
        pc: usize,
        locals: Vec<Value>,
        stack: Vec<Value>,
        labels: Vec<Label>,
    }
    struct ImportContext<'a> {
        _lifetime: std::marker::PhantomData<&'a ()>,
    }
    impl ImportContext<'_> {
        fn legacy() -> Self { Self { _lifetime: std::marker::PhantomData } }
        fn check(&self, _function: u32, _offset: usize) -> Result<(), Error> {
            Ok(())
        }
    }
    enum Entry<'a> { Export(&'a str), }
    impl Instance {
        pub fn new(module: Module, limits: Limits) -> Result<Self, Error> {
            Self::new_with_admission(module, limits, ImportAdmission::Legacy)
        }
        fn new_with_admission(module: Module, limits: Limits,
            admission: ImportAdmission) -> Result<Self, Error> {
            limits.check()?;
            match admission {
                ImportAdmission::Legacy =>
                    crate::validate::module(&module, &limits)?,
            }
            if module.source_bytes > limits.module_bytes {
                return Err(Error::new("limit",
                            "instance module byte limit exceeded", None, 0));
            }
            if module.function_count() > limits.functions ||
                    module.types.len() > limits.types {
                return Err(Error::new("limit",
                            "instance limits narrower than module", None, 0));
            }
            if module.functions.iter().map(|f| f.code.len()).sum::<usize>() >
                    limits.instructions {
                return Err(Error::new("limit", "instruction limit exceeded",
                            None, 0));
            }
            let pages = module.memory.map(|m| m.0).unwrap_or(0);
            if module.memory.is_some_and(|(min, max)|
                        min > limits.memory_pages || max > limits.memory_pages) {
                return Err(Error::new("limit",
                            "instance memory limit exceeded", None, 0));
            }
            let bytes = pages as usize * 65536;
            let mut memory = ::alloc::vec::Vec::new();
            memory.try_reserve_exact(bytes).map_err(|_|
                        Error::new("allocation", "cannot allocate initial memory",
                            None, 0))?;
            memory.resize(bytes, 0);
            for (offset, data) in &module.data {
                let start = *offset as usize;
                let end =
                    start.checked_add(data.len()).filter(|v|
                                    *v <=
                                        memory.len()).ok_or_else(||
                                {
                                    Error::new("memory_out_of_bounds",
                                        "active data segment exceeds initial memory", None, 0)
                                })?;
                memory[start..end].copy_from_slice(data);
            }
            let count =
                module.table.map(|(min, _)| min as usize).unwrap_or(0);
            let mut table = Vec::new();
            table.try_reserve_exact(count).map_err(|_|
                        Error::new("allocation", "cannot allocate table", None,
                            0))?;
            table.resize(count, None);
            for (offset, functions) in &module.elements {
                let start = *offset as usize;
                let end =
                    start.checked_add(functions.len()).filter(|n|
                                    *n <=
                                        table.len()).ok_or_else(||
                                {
                                    Error::new("table_out_of_bounds",
                                        "active element segment exceeds initial table", None, 0)
                                })?;
                for (slot, function) in
                    table[start..end].iter_mut().zip(functions) {
                    *slot = Some(*function);
                }
            }
            let globals = module.globals.iter().map(|g| g.value).collect();
            let fuel = limits.fuel;
            Ok(Self {
                    module,
                    globals,
                    memory,
                    table,
                    limits,
                    cancellation: Cancellation::default(),
                    fuel_remaining: fuel,
                    host_calls_used: 0,
                })
        }
        pub fn cancellation(&self) -> Cancellation {
            self.cancellation.clone()
        }
        pub fn memory(&self) -> &[u8] { &self.memory }
        /// Host transfer only; callers must serialize access and bound transfer size.
        pub(crate) fn write_memory(&mut self, offset: u32, bytes: &[u8])
            -> Result<(), Error> {
            let start = offset as usize;
            let end =
                start.checked_add(bytes.len()).filter(|n|
                                *n <=
                                    self.memory.len()).ok_or_else(||
                            {
                                Error::new("memory_out_of_bounds",
                                    "host transfer exceeds memory", None, 0)
                            })?;
            self.memory[start..end].copy_from_slice(bytes);
            Ok(())
        }
        pub fn invoke(&mut self, name: &str, args: &[Value])
            -> Result<Option<Value>, Error> {
            self.invoke_inner(Entry::Export(name), args,
                ImportContext::legacy())
        }
        fn invoke_inner(&mut self, entry: Entry<'_>, args: &[Value],
            imports: ImportContext<'_>) -> Result<Option<Value>, Error> {
            self.fuel_remaining = self.limits.fuel;
            self.host_calls_used = 0;
            if self.limits.profile.floats() { crate::float::environment()?; }
            let index =
                match entry {
                    Entry::Export(name) => {
                        let (kind, index) =
                            *self.module.exports.get(name).ok_or_else(||
                                            {
                                                Error::new("unknown_export",
                                                    ::alloc::__export::must_use({
                                                            ::alloc::fmt::format(format_args!("unknown export {0}",
                                                                    name))
                                                        }), None, 0)
                                            })?;
                        if kind != 0 {
                            return Err(Error::new("invalid_arguments",
                                        "export is not a function", None, 0));
                        }
                        index
                    }
                };
            let sig =
                self.module.signature(index).expect("validated signature");
            if args.len() != sig.params.len() ||
                    args.iter().zip(&sig.params).any(|(a, t)| a.ty() != *t) {
                return Err(Error::new("invalid_arguments",
                            "arguments do not match exported function signature",
                            Some(index), 0));
            }
            if (index as usize) < self.module.imports.len() {
                self.charge(index, 0)?;
                return self.import(index, args, index, 0, &imports);
            }
            let mut frames =
                ::alloc::boxed::box_assume_init_into_vec_unsafe(::alloc::intrinsics::write_box_via_move(::alloc::boxed::Box::new_uninit(),
                        [self.frame(index, args.to_vec())?]));
            loop {
                let frame = frames.last_mut().expect("active frame");
                let func =
                    &self.module.functions[frame.function as usize -
                                self.module.imports.len()];
                let ins = &func.code[frame.pc];
                let function = frame.function;
                let offset = ins.offset;
                if self.cancellation.is_cancelled() {
                    return Err(Error::new("cancelled", "execution cancelled",
                                Some(function), offset));
                }
                imports.check(function, offset)?;
                if self.fuel_remaining == 0 {
                    return Err(Error::new("fuel_exhausted",
                                "instruction fuel exhausted", Some(function), offset));
                }
                self.fuel_remaining -= 1;
                frame.pc += 1;
                let trap =
                    |code, message|
                        Error::new(code, message, Some(function), offset);
                let mut finished = false;
                match &ins.op {
                    Op::Unreachable => {
                        return Err(trap("unreachable",
                                    "unreachable instruction executed"))
                    }
                    Op::Nop => {}
                    Op::Const(v) => frame.stack.push(*v),
                    Op::Drop => {
                        frame.stack.pop().expect("validated operand");
                    }
                    Op::Select => {
                        let c = pop32(&mut frame.stack);
                        let b = frame.stack.pop().unwrap();
                        let a = frame.stack.pop().unwrap();
                        frame.stack.push(if c != 0 { a } else { b });
                    }
                    Op::LocalGet(i) =>
                        frame.stack.push(frame.locals[*i as usize]),
                    Op::LocalSet(i) =>
                        frame.locals[*i as usize] = frame.stack.pop().unwrap(),
                    Op::LocalTee(i) =>
                        frame.locals[*i as usize] = *frame.stack.last().unwrap(),
                    Op::GlobalGet(i) =>
                        frame.stack.push(self.globals[*i as usize]),
                    Op::GlobalSet(i) =>
                        self.globals[*i as usize] = frame.stack.pop().unwrap(),
                    Op::Block { kind, result, end, alternative } => {
                        let cond =
                            if *kind == BlockKind::If {
                                pop32(&mut frame.stack) != 0
                            } else { true };
                        frame.labels.push(Label {
                                kind: *kind,
                                start: frame.pc,
                                end: *end,
                                height: frame.stack.len(),
                                result: result.is_some(),
                            });
                        if !cond {
                            frame.pc = alternative.map(|p| p + 1).unwrap_or(*end);
                        }
                    }
                    Op::Else { end } => frame.pc = *end,
                    Op::End => {
                        let label = frame.labels.pop().unwrap();
                        finish_label(frame, &label);
                        if label.kind == BlockKind::Function { finished = true; }
                    }
                    Op::Br(n) => finished = branch(frame, *n),
                    Op::BrIf(n) => {
                        if pop32(&mut frame.stack) != 0 {
                            finished = branch(frame, *n);
                        }
                    }
                    Op::BrTable(labels, default) => {
                        let n = pop32(&mut frame.stack) as u32 as usize;
                        finished =
                            branch(frame, labels.get(n).copied().unwrap_or(*default));
                    }
                    Op::Return => {
                        let result =
                            self.module.signature(function).unwrap().result.is_some();
                        let value = if result { frame.stack.pop() } else { None };
                        frame.stack.clear();
                        frame.stack.extend(value);
                        finished = true;
                    }
                    Op::Call(index) => {
                        let sig = self.module.signature(*index).unwrap();
                        let split = frame.stack.len() - sig.params.len();
                        let args = frame.stack.split_off(split);
                        if (*index as usize) < self.module.imports.len() {
                            let result =
                                self.import(*index, &args, function, offset, &imports)?;
                            frame.stack.extend(result);
                        } else {
                            if frames.len() >= self.limits.call_depth {
                                return Err(trap("call_depth_exceeded",
                                            "call depth limit exceeded"));
                            }
                            let f = self.frame(*index, args)?;
                            frames.push(f);
                        }
                        continue;
                    }
                    Op::CallIndirect(type_index) => {
                        let selector = pop32(&mut frame.stack) as u32 as usize;
                        let target =
                            self.table.get(selector).ok_or_else(||
                                                {
                                                    trap("table_out_of_bounds",
                                                        "indirect call index exceeds table")
                                                })?.ok_or_else(||
                                        {
                                            trap("indirect_call_null",
                                                "indirect call selected a null entry")
                                        })?;
                        let expected = &self.module.types[*type_index as usize];
                        let actual = self.module.signature(target).unwrap();
                        if actual != expected {
                            return Err(trap("indirect_call_type_mismatch",
                                        "indirect call signature mismatch"));
                        }
                        let args =
                            frame.stack.split_off(frame.stack.len() -
                                    expected.params.len());
                        if (target as usize) < self.module.imports.len() {
                            let result =
                                self.import(target, &args, function, offset, &imports)?;
                            frame.stack.extend(result);
                        } else {
                            if frames.len() >= self.limits.call_depth {
                                return Err(trap("call_depth_exceeded",
                                            "call depth limit exceeded"));
                            }
                            frames.push(self.frame(target, args)?);
                        }
                        continue;
                    }
                    Op::MemoryCopy => {
                        let len = pop32(&mut frame.stack) as u32 as usize;
                        let src = pop32(&mut frame.stack) as u32 as usize;
                        let dst = pop32(&mut frame.stack) as u32 as usize;
                        let src_end =
                            src.checked_add(len).filter(|end|
                                            *end <=
                                                self.memory.len()).ok_or_else(||
                                        {
                                            trap("memory_out_of_bounds",
                                                "memory.copy source exceeds memory")
                                        })?;
                        dst.checked_add(len).filter(|end|
                                        *end <=
                                            self.memory.len()).ok_or_else(||
                                    {
                                        trap("memory_out_of_bounds",
                                            "memory.copy destination exceeds memory")
                                    })?;
                        self.bulk_fuel(len, function, offset)?;
                        self.memory.copy_within(src..src_end, dst);
                    }
                    Op::MemoryFill => {
                        let len = pop32(&mut frame.stack) as u32 as usize;
                        let value = pop32(&mut frame.stack) as u8;
                        let dst = pop32(&mut frame.stack) as u32 as usize;
                        let end =
                            dst.checked_add(len).filter(|end|
                                            *end <=
                                                self.memory.len()).ok_or_else(||
                                        {
                                            trap("memory_out_of_bounds",
                                                "memory.fill destination exceeds memory")
                                        })?;
                        self.bulk_fuel(len, function, offset)?;
                        self.memory[dst..end].fill(value);
                    }
                    Op::MemorySize =>
                        frame.stack.push(Value::I32((self.memory.len() / 65536) as
                                    i32)),
                    Op::MemoryGrow => {
                        let delta = pop32(&mut frame.stack) as u32;
                        let old = (self.memory.len() / 65536) as u32;
                        let max = self.module.memory.unwrap().1;
                        let next =
                            old.checked_add(delta).filter(|n|
                                    *n <= max && *n <= self.limits.memory_pages);
                        let result =
                            if let Some(next) = next {
                                let bytes = next as usize * 65536;
                                if self.memory.try_reserve_exact(bytes -
                                                self.memory.len()).is_ok() {
                                    self.memory.resize(bytes, 0);
                                    old as i32
                                } else { -1 }
                            } else { -1 };
                        frame.stack.push(Value::I32(result));
                    }
                    Op::Load { opcode, offset: imm } => {
                        let address = pop32(&mut frame.stack) as u32;
                        let width = memory_width(*opcode);
                        let start =
                            (address as
                                                usize).checked_add(*imm as
                                            usize).ok_or_else(||
                                        {
                                            trap("memory_out_of_bounds",
                                                "load effective address exceeds host address space")
                                        })?;
                        let end =
                            start.checked_add(width).filter(|n|
                                            *n <=
                                                self.memory.len()).ok_or_else(||
                                        {
                                            trap("memory_out_of_bounds", "load exceeds linear memory")
                                        })?;
                        let b = &self.memory[start..end];
                        let mut padded = [0u8; 8];
                        padded[..width].copy_from_slice(b);
                        let x = u64::from_le_bytes(padded);
                        let value =
                            match opcode {
                                0x28 => Value::I32(x as i32),
                                0x29 => Value::I64(x as i64),
                                0x2a => Value::F32(x as u32),
                                0x2b => Value::F64(x),
                                0x2c => Value::I32(x as i8 as i32),
                                0x2d => Value::I32(x as u8 as i32),
                                0x2e => Value::I32(x as i16 as i32),
                                0x2f => Value::I32(x as u16 as i32),
                                0x30 => Value::I64(x as i8 as i64),
                                0x31 => Value::I64(x as u8 as i64),
                                0x32 => Value::I64(x as i16 as i64),
                                0x33 => Value::I64(x as u16 as i64),
                                0x34 => Value::I64(x as i32 as i64),
                                0x35 => Value::I64(x as u32 as i64),
                                _ =>
                                    ::core::panicking::panic("internal error: entered unreachable code"),
                            };
                        frame.stack.push(value);
                    }
                    Op::Store { opcode, offset: imm } => {
                        let value = frame.stack.pop().unwrap();
                        let address = pop32(&mut frame.stack) as u32;
                        let width = memory_width(*opcode);
                        let start =
                            (address as
                                                usize).checked_add(*imm as
                                            usize).ok_or_else(||
                                        {
                                            trap("memory_out_of_bounds",
                                                "store effective address exceeds host address space")
                                        })?;
                        let end =
                            start.checked_add(width).filter(|n|
                                            *n <=
                                                self.memory.len()).ok_or_else(||
                                        {
                                            trap("memory_out_of_bounds", "store exceeds linear memory")
                                        })?;
                        let x =
                            match value {
                                Value::I32(v) => v as u32 as u64,
                                Value::I64(v) => v as u64,
                                Value::F32(v) => v as u64,
                                Value::F64(v) => v,
                            };
                        self.memory[start..end].copy_from_slice(&x.to_le_bytes()[..width]);
                    }
                    Op::Saturating(sub) =>
                        crate::float::saturating(*sub, &mut frame.stack),
                    Op::Numeric(o) if crate::float::shape(*o).is_some() => {
                        crate::float::numeric(*o,
                                    &mut frame.stack).map_err(|code|
                                    {
                                        trap(code, "floating-point to integer conversion trapped")
                                    })?
                    }
                    Op::Numeric(o) =>
                        numeric(*o,
                                    &mut frame.stack).map_err(|code|
                                    {
                                        trap(code,
                                            if code == "integer_divide_by_zero" {
                                                "integer division by zero"
                                            } else { "signed integer division overflow" })
                                    })?,
                }
                if frame.stack.len() > self.limits.operand_stack {
                    return Err(trap("operand_stack_exceeded",
                                "operand stack limit exceeded"));
                }
                if finished {
                    let f = frames.pop().unwrap();
                    let value = f.stack.last().copied();
                    if let Some(caller) = frames.last_mut() {
                        caller.stack.extend(value);
                    } else { return Ok(value); }
                }
            }
        }
        fn bulk_fuel(&mut self, len: usize, function: u32, offset: usize)
            -> Result<(), Error> {
            if self.cancellation.is_cancelled() {
                return Err(Error::new("cancelled",
                            "bulk operation cancelled before mutation", Some(function),
                            offset));
            }
            let extra = len.div_ceil(64) as u64;
            if self.fuel_remaining < extra {
                self.fuel_remaining = 0;
                return Err(Error::new("fuel_exhausted",
                            "bulk byte fuel exhausted before mutation", Some(function),
                            offset));
            }
            self.fuel_remaining -= extra;
            Ok(())
        }
        fn charge(&mut self, function: u32, offset: usize)
            -> Result<(), Error> {
            if self.cancellation.is_cancelled() {
                return Err(Error::new("cancelled", "execution cancelled",
                            Some(function), offset));
            }
            if self.fuel_remaining == 0 {
                return Err(Error::new("fuel_exhausted",
                            "instruction fuel exhausted", Some(function), offset));
            }
            self.fuel_remaining -= 1;
