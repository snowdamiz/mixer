                fn misses(&self) -> u64 { self.misses }
                fn decodes(&self) -> u64 { self.decodes }
                fn evictions(&self) -> u64 { self.evictions }
                fn hit(&mut self, n: u64) { self.hits = n; }
                fn miss(&mut self, n: u64) { self.misses = n; }
                fn decoded(&mut self, n: u64, bytes: usize) {
                    self.decodes = n;
                    self.construction_bytes = 0;
                    self.resident_bytes += bytes;
                    self.peak_resident_bytes =
                        self.peak_resident_bytes.max(self.resident_bytes);
                }
                fn evicted(&mut self, bytes: usize) {
                    self.resident_bytes -= bytes;
                    self.evictions += 1;
                }
                fn pin(&mut self, bytes: usize, first: bool) {
                    if first { self.pinned_bytes += bytes; }
                    self.peak_pinned_bytes =
                        self.peak_pinned_bytes.max(self.pinned_bytes);
                    self.active_pins += 1;
                }
                fn release(&mut self, bytes: usize, last: bool) {
                    if last { self.pinned_bytes -= bytes; }
                    self.active_pins -= 1;
                }
            }
            pub(crate) trait AlgorithmMeter: DecodeMeter {
