        pub(crate) struct Meter<'a> {
            budget: CacheBudget,
            usage: &'a mut CacheUsage,
            cancellation: &'a Cancellation,
            function: Option<u32>,
            offset: usize,
        }
        impl Meter<'_> {
            fn error(&self, kind: CacheFailureKind, code: &'static str)
                -> CacheFailure {
                failure(*self.usage, kind, code, self.function, self.offset,
                    0, 0)
            }
            fn check(&self) -> Result<(), CacheFailure> {
                if self.cancellation.is_cancelled() {
                    Err(self.error(CacheFailureKind::Cancelled, "cancelled"))
                } else { Ok(()) }
            }
            fn work(&mut self, amount: u64) -> Result<(), CacheFailure> {
                self.check()?;
                let attempted =
                    self.usage.work_used.checked_add(amount).ok_or_else(||
                                self.error(CacheFailureKind::WorkExhausted,
                                    "work_overflow"))?;
                if attempted > self.budget.work_credits {
                    return Err(failure(*self.usage,
                                CacheFailureKind::WorkExhausted, "cache_work",
                                self.function, self.offset, attempted,
                                self.budget.work_credits));
                }
                self.usage.work_used = attempted;
                Ok(())
            }
        }
        fn allocate<T>(capacity: usize, meter: &mut Meter<'_>)
            -> Result<Vec<T>, CacheFailure> {
            meter.check()?;
            let mut values = Vec::new();
            values.try_reserve_exact(capacity).map_err(|_|
                        meter.error(CacheFailureKind::AllocationFailure,
                            "cache_allocation"))?;
            if values.capacity() != capacity {
                return Err(meter.error(CacheFailureKind::AllocationFailure,
                            "cache_capacity"));
            }
            meter.check()?;
            Ok(values)
