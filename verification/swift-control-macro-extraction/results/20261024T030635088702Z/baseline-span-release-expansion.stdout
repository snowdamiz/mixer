        impl ::core::marker::Copy for Segment { }
        pub(super) trait Declaration: Default {
            fn memory(&mut self, _: Option<u32>, _: usize) {}
            fn table(&mut self, _: Option<u32>, _: usize) {}
        }
        pub(super) struct FrozenDeclaration;
        #[automatically_derived]
        impl ::core::default::Default for FrozenDeclaration {
            #[inline]
            fn default() -> FrozenDeclaration { FrozenDeclaration {} }
        }
        impl Declaration for FrozenDeclaration {}
        pub(super) struct Metadata<D: Declaration = FrozenDeclaration> {
            pub signatures: Buffer<Signature>,
            pub parameters: Buffer<Type>,
            pub imports: Buffer<Import>,
            pub functions: Buffer<Function>,
            pub globals: Buffer<Global>,
            pub exports: Buffer<Export>,
            pub data: Buffer<Segment>,
            pub elements: Buffer<Segment>,
            pub memory: Option<(u32, u32)>,
            pub table: Option<(u32, u32)>,
            pub declarations: D,
            pub instructions: usize,
        }
        impl<D: Declaration> Metadata<D> {
            fn new() -> Self {
                Self {
                    signatures: Buffer::new(Resource::Metadata),
                    parameters: Buffer::new(Resource::Metadata),
                    imports: Buffer::new(Resource::Metadata),
                    functions: Buffer::new(Resource::Metadata),
                    globals: Buffer::new(Resource::Metadata),
                    exports: Buffer::new(Resource::Metadata),
                    data: Buffer::new(Resource::Metadata),
                    elements: Buffer::new(Resource::Metadata),
                    memory: None,
                    table: None,
                    declarations: D::default(),
                    instructions: 0,
                }
            }
            pub fn signature(&self, function: u32) -> Option<Signature> {
                let index = function as usize;
                let ty =
                    if index < self.imports.len() {
                        self.imports.get(index)?.type_index
                    } else {
                        self.functions.get(index - self.imports.len())?.type_index
                    };
                self.signatures.get(ty as usize).copied()
            }
            pub fn params(&self, signature: Signature) -> &[Type] {
                &self.parameters.as_slice()[signature.first as
                                usize..signature.first as usize + signature.count as usize]
            }
        }
        fn u32_offset(value: usize, meter: &Meter<'_, impl MeterControl>,
            cursor: Cursor) -> Result<u32, Failure> {
            u32::try_from(value).map_err(|_|
                    meter.error(FailureKind::ResourceExhausted,
                        "offset_overflow", cursor))
        }
        fn span(offset: usize, bytes: usize,
            meter: &Meter<'_, impl MeterControl>, cursor: Cursor)
            -> Result<Span, Failure> {
            offset.checked_add(bytes).filter(|end|
                            *end <=
                                meter.source_limit()).ok_or_else(||
                        meter.error(FailureKind::Malformed, "span_overflow",
                            cursor))?;
            Ok(Span {
                    offset: u32_offset(offset, meter, cursor)?,
                    bytes: u32_offset(bytes, meter, cursor)?,
                })
        }
        fn utf8(bytes: &[u8], base: usize,
            meter: &mut Meter<'_, impl MeterControl>) -> Result<(), Failure> {
            let mut i = 0;
            while i < bytes.len() {
                let cursor = Cursor { function: None, offset: base + i };
                meter.work(1, cursor)?;
                let lead = bytes[i];
                let (width, minimum, mut code) =
                    match lead {
                        0..=0x7f => (1, 0, lead as u32),
                        0xc2..=0xdf => (2, 0x80, (lead & 31) as u32),
                        0xe0..=0xef => (3, 0x800, (lead & 15) as u32),
                        0xf0..=0xf4 => (4, 0x10000, (lead & 7) as u32),
                        _ =>
                            return Err(meter.error(FailureKind::Malformed, "name_utf8",
                                        cursor)),
                    };
                for j in 1..width {
                    meter.work(1,
                            Cursor { function: None, offset: base + i + j })?;
                    let b =
                        *bytes.get(i +
                                            j).ok_or_else(||
                                        meter.error(FailureKind::Malformed, "name_utf8", cursor))?;
                    if b & 0xc0 != 0x80 {
                        return Err(meter.error(FailureKind::Malformed, "name_utf8",
                                    cursor));
                    }
                    code = (code << 6) | (b & 63) as u32;
                }
                if code < minimum || (0xd800..=0xdfff).contains(&code) ||
                        code > 0x10ffff {
                    return Err(meter.error(FailureKind::Malformed, "name_utf8",
                                cursor));
                }
                i += width;
            }
            Ok(())
        }
        fn name(r: &mut Reader<'_>, policy: &policy::Policy<'_>,
            meter: &mut Meter<'_, impl MeterControl>)
            -> Result<Span, Failure> {
            let n = r.count(policy.name_bytes(), meter)?;
            let base = r.cursor().offset;
            let bytes = r.take(n, meter)?;
            utf8(bytes, base, meter)?;
            span(base, n, meter, r.cursor())
        }
        fn constant(r: &mut Reader<'_>, floats: bool,
            meter: &mut Meter<'_, impl MeterControl>)
            -> Result<(Type, Option<u32>), Failure> {
            let result =
                match r.byte(meter)? {
                    0x41 => (Type::I32, Some(r.signed(32, meter)? as u32)),
                    0x42 => { r.signed(64, meter)?; (Type::I64, None) }
                    0x43 if floats => { r.take(4, meter)?; (Type::F32, None) }
                    0x44 if floats => { r.take(8, meter)?; (Type::F64, None) }
                    _ =>
                        return Err(r.error(meter, FailureKind::Unsupported,
                                    "constant_expression")),
                };
            if r.byte(meter)? != 0x0b {
                return Err(r.error(meter, FailureKind::Unsupported,
                            "extended_constant"));
            }
            Ok(result)
        }
        fn limits(r: &mut Reader<'_>, maximum: u32,
            meter: &mut Meter<'_, impl MeterControl>)
            -> Result<(u32, u32, Option<u32>), Failure> {
            let flags = r.byte(meter)?;
            if flags > 1 {
                return Err(r.error(meter, FailureKind::Unsupported,
                            "limits_form"));
            }
            let min = r.uint(meter)?;
            let max = if flags == 1 { r.uint(meter)? } else { maximum };
            if min > max {
                return Err(r.error(meter, FailureKind::Validation,
                            "limit_minimum_exceeds_maximum"));
            }
            if max > maximum {
                return Err(r.error(meter, FailureKind::ResourceExhausted,
                                "profile_memory_table_limit").resource(Resource::Profile,
                            max as u64, maximum as u64));
            }
            Ok((min, max, (flags == 1).then_some(max)))
        }
        pub(super) fn read<D: Declaration>(source: &[u8],
            policy: &policy::Policy<'_>,
            meter: &mut Meter<'_, impl MeterControl>)
            -> Result<Metadata<D>, Failure> {
            let mut r = Reader::new(source, 0);
            if r.take(8, meter)? != b"\0asm\x01\0\0\0" {
                return Err(r.error(meter, FailureKind::Malformed,
                            "wasm_header"));
            }
            let mut m = Metadata::<D>::new();
            let mut seen = [false; 12];
            let mut last = 0;
            let mut code_seen = false;
            while r.position < r.bytes.len() {
                let id = r.byte(meter)?;
                let size = r.uint(meter)? as usize;
                let base = r.cursor().offset;
                let data = r.take(size, meter)?;
                let mut s = Reader::new(data, base);
                if id == 0 { name(&mut s, policy, meter)?; continue; }
                if id > 11 {
                    return Err(s.error(meter, FailureKind::Unsupported,
                                "section"));
                }
                if seen[id as usize] || id < last {
                    return Err(s.error(meter, FailureKind::Malformed,
                                "section_order"));
                }
                seen[id as usize] = true;
                last = id;
                match id {
                    1 => {
                        let count = s.count(policy.types(), meter)?;
                        m.signatures.reserve(count, meter, s.cursor())?;
                        for _ in 0..count {
                            if s.byte(meter)? != 0x60 {
                                return Err(s.error(meter, FailureKind::Unsupported,
                                            "function_type"));
                            }
                            let count =
                                s.count(policy.parameters_per_signature(), meter)?;
                            let total =
                                m.parameters.len().checked_add(count).ok_or_else(||
                                            {
                                                s.error(meter, FailureKind::ResourceExhausted,
                                                    "type_parameter_count_overflow")
                                            })?;
                            if total > policy.type_parameters_total() {
                                return Err(s.error(meter, FailureKind::ResourceExhausted,
                                                "type_parameters_total").resource(Resource::Profile,
                                            total as u64, policy.type_parameters_total() as u64));
                            }
                            let first =
                                u32_offset(m.parameters.len(), meter, s.cursor())?;
                            for _ in 0..count {
                                let ty = s.ty(policy.floats(), meter)?;
                                m.parameters.push(ty, meter, s.cursor())?;
                            }
                            let result =
                                if s.count(1, meter)? == 1 {
                                    Some(s.ty(policy.floats(), meter)?)
                                } else { None };
                            m.signatures.push(Signature {
                                        first,
                                        count: count as u32,
                                        result,
                                    }, meter, s.cursor())?;
                        }
                    }
                    2 => {
                        let count = s.count(policy.functions(), meter)?;
                        m.imports.reserve(count, meter, s.cursor())?;
                        for _ in 0..count {
                            let module = name(&mut s, policy, meter)?;
                            let name = name(&mut s, policy, meter)?;
                            if s.byte(meter)? != 0 {
                                return Err(s.error(meter, FailureKind::Unsupported,
                                            "import_kind"));
                            }
                            let type_index = s.uint(meter)?;
                            m.imports.push(Import { module, name, type_index }, meter,
                                    s.cursor())?;
                        }
                    }
                    3 => {
                        let count =
                            s.count(policy.functions().saturating_sub(m.imports.len()),
                                    meter)?;
                        m.functions.reserve(count, meter, s.cursor())?;
                        for _ in 0..count {
                            let type_index = s.uint(meter)?;
                            m.functions.push(Function {
                                        type_index,
                                        body: Span::default(),
                                    }, meter, s.cursor())?;
                        }
                    }
                    4 if policy.tables() => {
                        if s.count(1, meter)? == 1 {
                            if s.byte(meter)? != 0x70 {
                                return Err(s.error(meter, FailureKind::Unsupported,
                                            "table_type"));
                            }
                            let offset = s.cursor().offset;
                            let (min, max, declared) =
                                limits(&mut s, policy.table_elements() as u32, meter)?;
                            m.table = Some((min, max));
                            m.declarations.table(declared, offset);
                        }
                    }
                    5 => {
                        if s.count(1, meter)? == 1 {
                            let offset = s.cursor().offset;
                            let (min, max, declared) =
                                limits(&mut s, policy.memory_pages(), meter)?;
                            m.memory = Some((min, max));
                            m.declarations.memory(declared, offset);
                        }
                    }
                    6 => {
                        let count = s.count(policy.globals(), meter)?;
                        m.globals.reserve(count, meter, s.cursor())?;
                        for _ in 0..count {
                            let ty = s.ty(policy.floats(), meter)?;
                            let mutable =
                                match s.byte(meter)? {
                                    0 => false,
                                    1 => true,
                                    _ => {
                                        return Err(s.error(meter, FailureKind::Malformed,
                                                    "global_mutability"))
                                    }
                                };
                            let offset = s.cursor().offset;
                            let (actual, _) = constant(&mut s, policy.floats(), meter)?;
                            if actual != ty {
                                return Err(s.error(meter, FailureKind::Validation,
                                            "global_initializer_type"));
                            }
                            let initializer =
                                span(offset, s.cursor().offset - offset, meter,
                                        s.cursor())?;
                            m.globals.push(Global { ty, mutable, initializer }, meter,
                                    s.cursor())?;
                        }
                    }
                    7 => {
                        let count = s.count(policy.exports(), meter)?;
                        m.exports.reserve(count, meter, s.cursor())?;
                        for _ in 0..count {
                            let name = name(&mut s, policy, meter)?;
                            let kind = s.byte(meter)?;
                            let index = s.uint(meter)?;
                            m.exports.push(Export { name, kind, index }, meter,
                                    s.cursor())?;
                        }
                    }
                    9 if policy.tables() => {
                        let mut total = 0;
                        let count = s.count(policy.element_segments(), meter)?;
                        m.elements.reserve(count, meter, s.cursor())?;
                        for _ in 0..count {
                            let flags = s.uint(meter)?;
                            if ![0, 2].contains(&flags) {
                                return Err(s.error(meter, FailureKind::Unsupported,
                                            "element_form"));
                            }
                            if flags == 2 && s.uint(meter)? != 0 {
                                return Err(s.error(meter, FailureKind::Validation,
                                            "element_table"));
                            }
                            let (_, destination) =
                                constant(&mut s, policy.floats(), meter)?;
                            let destination =
                                destination.ok_or_else(||
                                            s.error(meter, FailureKind::Validation, "element_offset"))?;
                            if flags == 2 && s.byte(meter)? != 0 {
                                return Err(s.error(meter, FailureKind::Unsupported,
                                            "element_type"));
                            }
                            let count =
                                s.count(policy.table_elements().saturating_sub(total),
                                        meter)?;
                            total =
                                total.checked_add(count).ok_or_else(||
                                            {
                                                s.error(meter, FailureKind::ResourceExhausted,
                                                    "element_count_overflow")
                                            })?;
                            let offset = s.cursor().offset;
                            for _ in 0..count {
                                let function = s.uint(meter)?;
                                if function as usize >= m.imports.len() + m.functions.len()
                                    {
                                    return Err(s.error(meter, FailureKind::Validation,
                                                "element_function"));
                                }
                            }
                            let payload =
                                span(offset, s.cursor().offset - offset, meter,
                                        s.cursor())?;
                            m.elements.push(Segment {
                                        payload,
                                        destination,
                                        count: count as u32,
                                    }, meter, s.cursor())?;
                        }
                    }
                    4 | 8 | 9 =>
                        return Err(s.error(meter, FailureKind::Unsupported,
                                    "profile_section")),
                    10 => {
                        code_seen = true;
                        let count = s.count(policy.functions(), meter)?;
                        if count != m.functions.len() {
                            return Err(s.error(meter, FailureKind::Validation,
                                        "function_code_count"));
                        }
                        for index in 0..count {
                            let size = s.uint(meter)? as usize;
                            let offset = s.cursor().offset;
                            s.take(size, meter)?;
                            m.functions.get_mut(index).unwrap().body =
                                span(offset, size, meter, s.cursor())?;
                        }
                    }
                    11 => {
                        let count = s.count(policy.data_segments(), meter)?;
                        m.data.reserve(count, meter, s.cursor())?;
                        for _ in 0..count {
                            let flags = s.uint(meter)?;
                            if ![0, 2].contains(&flags) {
                                return Err(s.error(meter, FailureKind::Unsupported,
                                            "data_form"));
                            }
                            if flags == 2 && s.uint(meter)? != 0 {
                                return Err(s.error(meter, FailureKind::Validation,
                                            "data_memory"));
                            }
                            let (_, destination) =
                                constant(&mut s, policy.floats(), meter)?;
                            let destination =
                                destination.ok_or_else(||
                                            s.error(meter, FailureKind::Validation, "data_offset"))?;
                            let size = s.count(policy.module_bytes(), meter)?;
                            let offset = s.cursor().offset;
                            s.take(size, meter)?;
                            let payload = span(offset, size, meter, s.cursor())?;
                            m.data.push(Segment {
                                        payload,
                                        destination,
                                        count: size as u32,
                                    }, meter, s.cursor())?;
                        }
                    }
                    _ =>
                        return Err(s.error(meter, FailureKind::Malformed,
                                    "unknown_section")),
                }
                s.end(meter)?;
            }
            if !m.functions.as_slice().is_empty() && !code_seen {
                return Err(r.error(meter, FailureKind::Validation,
                            "missing_code"));
            }
            for import in m.imports.as_slice() {
                meter.work(18, r.cursor())?;
                let sig =
                    m.signatures.get(import.type_index as
                                    usize).ok_or_else(||
                                r.error(meter, FailureKind::Validation, "import_type"))?;
                let allowed =
                    !policy.legacy_imports() ||
                        (import.module.slice(source) == b"mixer" &&
                                match import.name.slice(source) {
                                    b"checkpoint" => sig.count == 0 && sig.result.is_none(),
                                    b"abort" => {
                                        sig.count == 1 && m.params(*sig) == [Type::I32] &&
                                            sig.result.is_none()
                                    }
                                    _ => false,
                                });
                if !allowed {
                    return Err(r.error(meter, FailureKind::Unsupported,
                                "unapproved_import"));
                }
            }
            for f in m.functions.as_slice() {
                meter.work(1, r.cursor())?;
                if f.type_index as usize >= m.signatures.len() {
                    return Err(r.error(meter, FailureKind::Validation,
                                "function_type_index"));
                }
            }
            for export in m.exports.as_slice() {
                meter.work(1, r.cursor())?;
                let valid =
                    match export.kind {
                        0 =>
                            (export.index as usize) <
                                m.imports.len() + m.functions.len(),
                        1 => export.index == 0 && m.table.is_some(),
                        2 => export.index == 0 && m.memory.is_some(),
                        3 => (export.index as usize) < m.globals.len(),
                        _ => false,
                    };
                if !valid {
                    return Err(r.error(meter, FailureKind::Validation,
                                "export_index"));
                }
            }
            if m.data.len() != 0 && m.memory.is_none() {
                return Err(r.error(meter, FailureKind::Validation,
                            "data_without_memory"));
            }
            if m.elements.len() != 0 && m.table.is_none() {
                return Err(r.error(meter, FailureKind::Validation,
                            "elements_without_table"));
            }
            duplicate_exports(source, &m.exports, meter, r.cursor())?;
            Ok(m)
        }
        fn compare_names(a: u32, b: u32, source: &[u8],
            exports: &Buffer<Export>,
            meter: &mut Meter<'_, impl MeterControl>, cursor: Cursor)
            -> Result<Ordering, Failure> {
            let a = exports.get(a as usize).unwrap().name.slice(source);
            let b = exports.get(b as usize).unwrap().name.slice(source);
            for (a, b) in a.iter().zip(b) {
                meter.work(1, cursor)?;
                let order = a.cmp(b);
                if order != Ordering::Equal { return Ok(order); }
            }
            meter.work(1, cursor)?;
            Ok(a.len().cmp(&b.len()))
        }
        fn sift(indices: &mut Buffer<u32>, mut root: usize, end: usize,
            source: &[u8], exports: &Buffer<Export>,
            meter: &mut Meter<'_, impl MeterControl>, cursor: Cursor)
            -> Result<(), Failure> {
            loop {
                meter.work(1, cursor)?;
                let child =
                    root.checked_mul(2).and_then(|v|
                                    v.checked_add(1)).ok_or_else(||
                                meter.error(FailureKind::ResourceExhausted, "sort_index",
                                    cursor))?;
                if child >= end { return Ok(()); }
                let mut greater = child;
                if child + 1 < end &&
                        compare_names(*indices.get(child).unwrap(),
                                    *indices.get(child + 1).unwrap(), source, exports, meter,
                                    cursor)? == Ordering::Less {
                    greater += 1;
                }
                if compare_names(*indices.get(root).unwrap(),
                                *indices.get(greater).unwrap(), source, exports, meter,
                                cursor)? != Ordering::Less {
                    return Ok(());
                }
                indices.swap(root, greater);
                root = greater;
            }
        }
        fn duplicate_exports(source: &[u8], exports: &Buffer<Export>,
            meter: &mut Meter<'_, impl MeterControl>, cursor: Cursor)
            -> Result<(), Failure> {
            let count = exports.len();
            let mut indices = Buffer::new(Resource::Scratch);
            indices.reserve(count, meter, cursor)?;
            for i in 0..count { indices.push(i as u32, meter, cursor)?; }
            for i in (0..count / 2).rev() {
                sift(&mut indices, i, count, source, exports, meter, cursor)?;
            }
            for end in (1..count).rev() {
                meter.work(1, cursor)?;
                indices.swap(0, end);
                sift(&mut indices, 0, end, source, exports, meter, cursor)?;
            }
            for i in 1..count {
                if compare_names(*indices.get(i - 1).unwrap(),
                                *indices.get(i).unwrap(), source, exports, meter, cursor)?
                        == Ordering::Equal {
                    return Err(meter.error(FailureKind::Validation,
                                "duplicate_export", cursor));
                }
            }
            indices.dispose(meter);
            Ok(())
        }
    }
    pub(crate) mod policy {
        //! Closed borrowed policies. Frozen validation never materializes widened Limits.
        use crate::{Limits, Profile};
        pub(crate) enum Policy<'a> { Frozen(&'a Limits), }
        impl<'a> Policy<'a> {
            pub fn frozen(limits: &'a Limits) -> Self { Self::Frozen(limits) }
            pub fn legacy_imports(&self) -> bool {

                #[allow(non_exhaustive_omitted_patterns)]
                match self { Self::Frozen(_) => true, _ => false, }
            }
            pub fn floats(&self) -> bool {
                match self { Self::Frozen(l) => l.profile.floats(), }
            }
            pub fn tables(&self) -> bool {
                match self {
                    Self::Frozen(l) => l.profile == Profile::TableMemoryV3,
                }
            }
            pub fn module_bytes(&self) -> usize {
                match self { Self::Frozen(l) => l.module_bytes, }
            }
            pub fn functions(&self) -> usize {
                match self { Self::Frozen(l) => l.functions, }
            }
            pub fn types(&self) -> usize {
                match self { Self::Frozen(l) => l.types, }
            }
            pub fn type_parameters_total(&self) -> usize {
                match self { Self::Frozen(_) => usize::MAX, }
            }
            pub fn parameters_per_signature(&self) -> usize {
                match self { Self::Frozen(l) => l.locals, }
            }
            pub fn parameters_plus_locals(&self) -> usize {
                match self { Self::Frozen(l) => l.locals, }
            }
            pub fn local_groups(&self) -> usize {
                match self { Self::Frozen(l) => l.locals, }
            }
            pub fn instructions(&self) -> usize {
                match self { Self::Frozen(l) => l.instructions, }
            }
            pub fn operand_stack(&self) -> usize {
                match self { Self::Frozen(l) => l.operand_stack, }
            }
            pub fn control_depth(&self) -> usize {
                match self { Self::Frozen(l) => l.control_depth, }
            }
            pub fn globals(&self) -> usize {
                match self { Self::Frozen(_) => 1024, }
            }
            pub fn exports(&self) -> usize { 4096 }
            pub fn data_segments(&self) -> usize { 4096 }
            pub fn element_segments(&self) -> usize { 4096 }
            pub fn name_bytes(&self) -> usize { 4096 }
            pub fn table_elements(&self) -> usize {
                match self { Self::Frozen(l) => l.table_elements, }
            }
            pub fn memory_pages(&self) -> u32 {
                match self { Self::Frozen(l) => l.memory_pages, }
            }
        }
    }
    mod reader {
        use super::*;
        pub(super) struct Reader<'a> {
            pub bytes: &'a [u8],
            pub position: usize,
            pub base: usize,
            pub function: Option<u32>,
        }
        impl<'a> Reader<'a> {
            pub fn new(bytes: &'a [u8], base: usize) -> Self {
                Self { bytes, position: 0, base, function: None }
            }
            pub fn cursor(&self) -> Cursor {
                Cursor {
                    function: self.function,
                    offset: self.base + self.position,
                }
            }
            pub fn error(&self, meter: &Meter<'_, impl MeterControl>,
                kind: FailureKind, code: &'static str) -> Failure {
                meter.error(kind, code, self.cursor())
            }
            pub fn byte(&mut self, meter: &mut Meter<'_, impl MeterControl>)
                -> Result<u8, Failure> {
                meter.work(1, self.cursor())?;
                let b =
                    *self.bytes.get(self.position).ok_or_else(||
                                    self.error(meter, FailureKind::Malformed,
                                        "unexpected_end"))?;
                self.position += 1;
                Ok(b)
            }
            pub fn take(&mut self, n: usize,
                meter: &mut Meter<'_, impl MeterControl>)
                -> Result<&'a [u8], Failure> {
                meter.work(n as u64, self.cursor())?;
                let end =
                    self.position.checked_add(n).filter(|end|
                                    *end <=
                                        self.bytes.len()).ok_or_else(||
                                self.error(meter, FailureKind::Malformed,
                                    "declared_length"))?;
                let bytes = &self.bytes[self.position..end];
                self.position = end;
                Ok(bytes)
            }
            pub fn uint(&mut self, meter: &mut Meter<'_, impl MeterControl>)
                -> Result<u32, Failure> {
                let mut n = 0u32;
                for i in 0..5 {
                    let b = self.byte(meter)?;
                    if i == 4 && b & 0xf0 != 0 {
                        return Err(self.error(meter, FailureKind::Malformed,
                                    "u32_leb_overflow"));
                    }
                    n |= ((b & 127) as u32) << (i * 7);
                    if b & 128 == 0 { return Ok(n); }
                }
                Err(self.error(meter, FailureKind::Malformed,
                        "u32_leb_unterminated"))
            }
            pub fn signed(&mut self, bits: u32,
                meter: &mut Meter<'_, impl MeterControl>)
                -> Result<i64, Failure> {
                let max = bits.div_ceil(7);
                let mut value = 0u64;
                for i in 0..max {
                    let b = self.byte(meter)?;
                    let p = b & 127;
                    if i == max - 1 {
                        let used = bits - 7 * i;
                        let positive = (1u8 << (used - 1)) - 1;
                        let negative = 127 ^ positive;
                        if b & 128 != 0 || (p > positive && p < negative) {
                            return Err(self.error(meter, FailureKind::Malformed,
                                        "signed_leb_overflow"));
                        }
                    }
                    value |= (p as u64).wrapping_shl(7 * i);
                    if b & 128 == 0 {
                        let shift = 7 * (i + 1);
                        if shift < 64 && b & 64 != 0 { value |= u64::MAX << shift; }
                        return Ok(if bits == 32 {
                                    value as i32 as i64
                                } else { value as i64 });
                    }
                }
                Err(self.error(meter, FailureKind::Malformed,
                        "signed_leb_unterminated"))
            }
            pub fn count(&mut self, max: usize,
                meter: &mut Meter<'_, impl MeterControl>)
                -> Result<usize, Failure> {
                let n = self.uint(meter)? as usize;
                if n > max {
                    Err(self.error(meter, FailureKind::ResourceExhausted,
                                "profile_vector_limit").resource(Resource::Profile,
                            n as u64, max as u64))
                } else { Ok(n) }
            }
            pub fn ty(&mut self, floats: bool,
                meter: &mut Meter<'_, impl MeterControl>)
                -> Result<crate::Type, Failure> {
                match self.byte(meter)? {
                    0x7f => Ok(crate::Type::I32),
                    0x7e => Ok(crate::Type::I64),
                    0x7d if floats => Ok(crate::Type::F32),
                    0x7c if floats => Ok(crate::Type::F64),
                    _ =>
                        Err(self.error(meter, FailureKind::Unsupported,
                                "value_type")),
                }
            }
            pub fn end(&self, meter: &Meter<'_, impl MeterControl>)
                -> Result<(), Failure> {
                if self.position == self.bytes.len() {
                    Ok(())
                } else {
                    Err(self.error(meter, FailureKind::Malformed,
                            "trailing_bytes"))
                }
            }
        }
    }
    mod validate {
        use super::*;
        use crate::{BlockKind, Type};
        use metadata::{Metadata, Signature};
        use reader::Reader;
        struct Control {
            kind: BlockKind,
            height: usize,
            result: Option<Type>,
            unreachable: bool,
            has_else: bool,
        }
        #[automatically_derived]
        #[doc(hidden)]
        unsafe impl ::core::clone::TrivialClone for Control { }
        #[automatically_derived]
        impl ::core::clone::Clone for Control {
            #[inline]
            fn clone(&self) -> Control {
                let _: ::core::clone::AssertParamIsClone<BlockKind>;
                let _: ::core::clone::AssertParamIsClone<usize>;
                let _: ::core::clone::AssertParamIsClone<Option<Type>>;
                let _: ::core::clone::AssertParamIsClone<bool>;
                *self
            }
        }
        #[automatically_derived]
        impl ::core::marker::Copy for Control { }
        pub(super) struct BodyState {
            locals: Buffer<Type>,
            operands: Buffer<Option<Type>>,
            controls: Buffer<Control>,
            cursor: Cursor,
            max: usize,
        }
        impl BodyState {
            fn new(function: u32, offset: usize, max: usize) -> Self {
                Self {
                    locals: Buffer::new(Resource::Scratch),
                    operands: Buffer::new(Resource::Scratch),
                    controls: Buffer::new(Resource::Scratch),
                    cursor: Cursor { function: Some(function), offset },
                    max,
                }
            }
            fn error(&self, meter: &Meter<'_, impl MeterControl>,
                code: &'static str) -> Failure {
                meter.error(FailureKind::Validation, code, self.cursor)
            }
            fn pop_any(&mut self, meter: &mut Meter<'_, impl MeterControl>)
                -> Result<Option<Type>, Failure> {
                meter.work(1, self.cursor)?;
                let control =
                    self.controls.last().ok_or_else(||
                                self.error(meter, "after_function_end"))?;
                if self.operands.len() == control.height &&
                        control.unreachable {
                    return Ok(None);
                }
                if self.operands.len() <= control.height {
                    return Err(self.error(meter, "operand_underflow"));
                }
                Ok(self.operands.pop().unwrap())
            }
            fn pop(&mut self, expected: Type,
                meter: &mut Meter<'_, impl MeterControl>)
                -> Result<(), Failure> {
                if self.pop_any(meter)?.is_some_and(|actual|
                            actual != expected) {
                    return Err(self.error(meter, "operand_type"));
                }
                Ok(())
            }
            fn push(&mut self, ty: Option<Type>,
                meter: &mut Meter<'_, impl MeterControl>)
                -> Result<(), Failure> {
                if self.operands.len() >= self.max {
                    return Err(meter.error(FailureKind::ResourceExhausted,
                                    "profile_operand_limit",
                                    self.cursor).resource(Resource::Profile,
                                self.operands.len() as u64 + 1, self.max as u64));
                }
                self.operands.push(ty, meter, self.cursor)?;
                meter.control.operand(self.operands.len());
                Ok(())
            }
            fn result(&mut self, ty: Option<Type>,
                meter: &mut Meter<'_, impl MeterControl>)
                -> Result<(), Failure> {
                if let Some(ty) = ty { self.pop(ty, meter)?; }
                Ok(())
            }
            fn unreachable(&mut self,
                meter: &mut Meter<'_, impl MeterControl>)
                -> Result<(), Failure> {
                meter.work(1, self.cursor)?;
                let height =
                    self.controls.last().ok_or_else(||
                                    self.error(meter, "missing_control"))?.height;
                self.operands.truncate(height);
                self.controls.last_mut().unwrap().unreachable = true;
                Ok(())
            }
            fn label(&self, depth: u32,
                meter: &mut Meter<'_, impl MeterControl>)
                -> Result<Option<Type>, Failure> {
                meter.work(1, self.cursor)?;
                let index =
                    (depth as
                                            usize).checked_add(1).and_then(|n|
                                    self.controls.len().checked_sub(n)).ok_or_else(||
                                self.error(meter, "branch_depth"))?;
                let control = self.controls.get(index).unwrap();
                Ok(if control.kind == BlockKind::Loop {
                        None
                    } else { control.result })
            }
            fn call(&mut self, signature: Signature,
                m: &Metadata<impl metadata::Declaration>,
                meter: &mut Meter<'_, impl MeterControl>)
                -> Result<(), Failure> {
                for ty in m.params(signature).iter().rev() {
                    self.pop(*ty, meter)?;
                }
                if let Some(result) = signature.result {
                    self.push(Some(result), meter)?;
                }
                Ok(())
            }
            fn dispose(self, meter: &mut Meter<'_, impl MeterControl>) {
                self.locals.dispose(meter);
                self.operands.dispose(meter);
                self.controls.dispose(meter);
            }
        }
        pub(super) fn all(source: &[u8], limits: &policy::Policy<'_>,
            m: &mut Metadata<impl metadata::Declaration>,
            meter: &mut Meter<'_, impl MeterControl>) -> Result<(), Failure> {
            let mut total = 0usize;
            for defined in 0..m.functions.len() {
                let function =
                    u32::try_from(m.imports.len() +
                                    defined).map_err(|_|
                                {
                                    meter.error(FailureKind::ResourceExhausted,
                                        "function_index_overflow", Cursor::default())
                                })?;
                let f = *m.functions.get(defined).unwrap();
                let signature =
                    *m.signatures.get(f.type_index as usize).unwrap();
                let mut r =
                    Reader::new(f.body.slice(source), f.body.offset as usize);
                r.function = Some(function);
                let mut state =
                    BodyState::new(function, r.cursor().offset,
                        limits.operand_stack());
                for ty in m.params(signature) {
                    state.locals.push(*ty, meter, r.cursor())?;
                }
                for _ in 0..r.count(limits.local_groups(), meter)? {
                    let n =
                        r.count(limits.parameters_plus_locals().saturating_sub(state.locals.len()),
                                meter)?;
                    let ty = r.ty(limits.floats(), meter)?;
                    for _ in 0..n { state.locals.push(ty, meter, r.cursor())?; }
                }
                meter.control.locals(state.locals.len());
                state.controls.push(Control {
                            kind: BlockKind::Function,
                            height: 0,
                            result: signature.result,
                            unreachable: false,
                            has_else: false,
                        }, meter, r.cursor())?;
                meter.control.control(1);
                loop {
                    state.cursor = r.cursor();
                    if state.controls.len() == 0 {
                        return Err(state.error(meter, "after_function_end"));
                    }
                    let opcode = r.byte(meter)?;
                    total =
                        total.checked_add(1).ok_or_else(||
                                    {
                                        meter.error(FailureKind::ResourceExhausted,
                                            "instruction_count_overflow", state.cursor)
                                    })?;
                    if total > limits.instructions() {
                        return Err(meter.error(FailureKind::ResourceExhausted,
                                        "profile_instruction_limit",
                                        state.cursor).resource(Resource::Profile, total as u64,
                                    limits.instructions() as u64));
                    }
                    match opcode {
                        0 => state.unreachable(meter)?,
                        1 => {}
                        2..=4 => {
                            let result =
                                match r.byte(meter)? {
                                    0x40 => None,
                                    0x7f => Some(Type::I32),
                                    0x7e => Some(Type::I64),
                                    0x7d if limits.floats() => Some(Type::F32),
                                    0x7c if limits.floats() => Some(Type::F64),
                                    _ =>
                                        return Err(r.error(meter, FailureKind::Unsupported,
                                                    "block_type")),
                                };
                            if state.controls.len() >= limits.control_depth() {
                                return Err(meter.error(FailureKind::ResourceExhausted,
                                                "profile_control_limit",
                                                state.cursor).resource(Resource::Profile,
                                            state.controls.len() as u64 + 1,
                                            limits.control_depth() as u64));
                            }
                            let kind =
                                match opcode {
                                    2 => BlockKind::Block,
                                    3 => BlockKind::Loop,
                                    _ => BlockKind::If,
                                };
                            if kind == BlockKind::If { state.pop(Type::I32, meter)?; }
                            state.controls.push(Control {
                                        kind,
                                        height: state.operands.len(),
                                        result,
                                        unreachable: false,
                                        has_else: false,
                                    }, meter, state.cursor)?;
                            meter.control.control(state.controls.len());
                        }
                        5 => {
                            let control = *state.controls.last().unwrap();
                            if control.kind != BlockKind::If || control.has_else {
                                return Err(state.error(meter, "unmatched_else"));
                            }
                            state.result(control.result, meter)?;
                            if state.operands.len() != control.height {
                                return Err(state.error(meter, "if_arm_extra_values"));
                            }
                            let control = state.controls.last_mut().unwrap();
                            control.unreachable = false;
                            control.has_else = true;
                        }
                        0x0b => {
                            let control = *state.controls.last().unwrap();
                            if control.kind == BlockKind::If && control.result.is_some()
                                    && !control.has_else {
                                return Err(state.error(meter, "if_result_without_else"));
                            }
                            state.result(control.result, meter)?;
                            if state.operands.len() != control.height {
                                return Err(state.error(meter, "control_extra_values"));
                            }
                            state.controls.pop();
                            if let Some(ty) = control.result {
                                state.push(Some(ty), meter)?;
                            }
                            if state.controls.len() == 0 { r.end(meter)?; break; }
                        }
                        0x0c => {
                            let depth = r.uint(meter)?;
                            let ty = state.label(depth, meter)?;
                            state.result(ty, meter)?;
                            state.unreachable(meter)?;
                        }
                        0x0d => {
                            let depth = r.uint(meter)?;
                            state.pop(Type::I32, meter)?;
                            let ty = state.label(depth, meter)?;
                            state.result(ty, meter)?;
                            if let Some(ty) = ty { state.push(Some(ty), meter)?; }
                        }
                        0x0e => {
                            let count = r.count(limits.instructions(), meter)?;
                            state.pop(Type::I32, meter)?;
                            let mut expected = None;
                            for _ in 0..count {
                                let depth = r.uint(meter)?;
                                let ty = state.label(depth, meter)?;
                                if expected.is_some_and(|expected| expected != ty) {
                                    return Err(state.error(meter, "branch_table_types"));
                                }
                                expected = Some(ty);
                            }
                            let depth = r.uint(meter)?;
                            let default = state.label(depth, meter)?;
                            if expected.is_some_and(|expected| expected != default) {
                                return Err(state.error(meter, "branch_table_types"));
                            }
                            state.result(default, meter)?;
                            state.unreachable(meter)?;
                        }
                        0x0f => {
                            state.result(signature.result, meter)?;
                            state.unreachable(meter)?;
                        }
                        0x10 => {
                            let index = r.uint(meter)?;
                            let called =
                                m.signature(index).ok_or_else(||
                                            state.error(meter, "call_index"))?;
                            state.call(called, m, meter)?;
                        }
                        0x11 if limits.tables() => {
                            let ty = r.uint(meter)?;
                            if r.uint(meter)? != 0 {
                                return Err(state.error(meter, "indirect_table_index"));
                            }
                            if m.table.is_none() {
                                return Err(state.error(meter, "indirect_without_table"));
                            }
                            let signature =
                                m.signatures.get(ty as
                                                    usize).copied().ok_or_else(||
                                            state.error(meter, "indirect_type_index"))?;
                            state.pop(Type::I32, meter)?;
                            state.call(signature, m, meter)?;
                        }
                        0x1a => { state.pop_any(meter)?; }
                        0x1b => {
                            state.pop(Type::I32, meter)?;
                            let b = state.pop_any(meter)?;
                            let a = state.pop_any(meter)?;
                            if a.is_some() && b.is_some() && a != b {
                                return Err(state.error(meter, "select_types"));
                            }
                            state.push(a.or(b), meter)?;
                        }
                        0x20..=0x22 => {
                            let index = r.uint(meter)? as usize;
                            let ty =
                                *state.locals.get(index).ok_or_else(||
                                                state.error(meter, "local_index"))?;
                            if opcode != 0x20 { state.pop(ty, meter)?; }
                            if opcode != 0x21 { state.push(Some(ty), meter)?; }
                        }
                        0x23..=0x24 => {
                            let index = r.uint(meter)? as usize;
                            let global =
                                m.globals.get(index).ok_or_else(||
                                            state.error(meter, "global_index"))?;
                            if opcode == 0x24 {
                                if !global.mutable {
                                    return Err(state.error(meter, "immutable_global"));
                                }
                                state.pop(global.ty, meter)?;
                            } else { state.push(Some(global.ty), meter)?; }
                        }
                        0x28..=0x35 => {
                            if [0x2a, 0x2b].contains(&opcode) && !limits.floats() {
                                return Err(r.error(meter, FailureKind::Unsupported,
                                            "float_load"));
                            }
                            let alignment = r.uint(meter)?;
                            let natural =
                                match opcode {
                                    0x28 | 0x2a | 0x34 | 0x35 => 2,
                                    0x29 | 0x2b => 3,
                                    0x2e | 0x2f | 0x32 | 0x33 => 1,
                                    _ => 0,
                                };
                            if alignment > natural {
                                return Err(state.error(meter, "load_alignment"));
                            }
                            r.uint(meter)?;
                            if m.memory.is_none() {
                                return Err(state.error(meter, "load_without_memory"));
                            }
                            state.pop(Type::I32, meter)?;
                            let ty =
                                match opcode {
                                    0x2a => Type::F32,
                                    0x2b => Type::F64,
                                    0x29 | 0x30..=0x35 => Type::I64,
                                    _ => Type::I32,
                                };
                            state.push(Some(ty), meter)?;
                        }
                        0x36..=0x3e => {
                            if [0x38, 0x39].contains(&opcode) && !limits.floats() {
                                return Err(r.error(meter, FailureKind::Unsupported,
                                            "float_store"));
                            }
                            let alignment = r.uint(meter)?;
                            let natural =
                                match opcode {
                                    0x36 | 0x38 | 0x3e => 2,
                                    0x37 | 0x39 => 3,
                                    0x3b | 0x3d => 1,
                                    _ => 0,
                                };
                            if alignment > natural {
                                return Err(state.error(meter, "store_alignment"));
                            }
                            r.uint(meter)?;
                            if m.memory.is_none() {
                                return Err(state.error(meter, "store_without_memory"));
                            }
                            let ty =
                                match opcode {
                                    0x38 => Type::F32,
                                    0x39 => Type::F64,
                                    0x37 | 0x3c..=0x3e => Type::I64,
                                    _ => Type::I32,
                                };
                            state.pop(ty, meter)?;
                            state.pop(Type::I32, meter)?;
                        }
                        0x3f | 0x40 => {
                            if r.byte(meter)? != 0 {
                                return Err(r.error(meter, FailureKind::Unsupported,
                                            "memory_index"));
                            }
                            if m.memory.is_none() {
                                return Err(state.error(meter,
                                            "memory_instruction_without_memory"));
                            }
                            if opcode == 0x40 { state.pop(Type::I32, meter)?; }
                            state.push(Some(Type::I32), meter)?;
                        }
                        0x41 => {
                            r.signed(32, meter)?;
                            state.push(Some(Type::I32), meter)?;
                        }
                        0x42 => {
                            r.signed(64, meter)?;
                            state.push(Some(Type::I64), meter)?;
                        }
                        0x43 if limits.floats() => {
                            r.take(4, meter)?;
                            state.push(Some(Type::F32), meter)?;
                        }
                        0x44 if limits.floats() => {
                            r.take(8, meter)?;
                            state.push(Some(Type::F64), meter)?;
                        }
                        0x45..=0xc4 => {
                            let floating =
                                #[allow(non_exhaustive_omitted_patterns)] match opcode {
                                    0x5b..=0x66 | 0x8b..=0xa6 | 0xa8..=0xab | 0xae..=0xbf =>
                                        true,
                                    _ => false,
                                };
                            if floating && !limits.floats() {
                                return Err(r.error(meter, FailureKind::Unsupported,
                                            "float_numeric"));
                            }
                            let (input, count, output) =
                                crate::validate::numeric_type(opcode);
                            for _ in 0..count { state.pop(input, meter)?; }
                            state.push(Some(output), meter)?;
                        }
                        0xfc if limits.floats() => {
                            let sub = r.uint(meter)?;
                            match sub {
                                0..=7 => {
                                    let (input, output) =
                                        crate::float::saturating_shape(sub as u8);
                                    state.pop(input, meter)?;
                                    state.push(Some(output), meter)?;
                                }
                                10 | 11 if limits.tables() => {
                                    if r.uint(meter)? != 0 || (sub == 10 && r.uint(meter)? != 0)
                                        {
                                        return Err(state.error(meter, "bulk_memory_index"));
                                    }
                                    if m.memory.is_none() {
                                        return Err(state.error(meter, "bulk_without_memory"));
                                    }
                                    for _ in 0..3 { state.pop(Type::I32, meter)?; }
                                }
                                _ => {
                                    return Err(r.error(meter, FailureKind::Unsupported,
                                                "extended_opcode"))
                                }
                            }
                        }
                        _ =>
                            return Err(r.error(meter, FailureKind::Unsupported,
                                        "opcode")),
                    }
                }
                state.dispose(meter);
                meter.control.body();
            }
            m.instructions = total;
            Ok(())
        }
    }
    pub mod cache {
        //! Nondefault, fallible decoded-function cache. This module cannot execute guests.
        #![allow(clippy::result_large_err)]
        pub(crate) mod borrowed {
            //! Closed, ephemeral adapters. These borrows never replace a validated owner.
            use super::*;
            use crate::experimental::descriptors::{
                FunctionSpanView, SignatureView,
            };
            use crate::Limits;
            pub(crate) mod sealed {
                pub trait Snapshot {}
                pub trait Policy {}
                pub trait Mode {}
                pub trait Meter {}
            }
            pub(crate) trait SnapshotView: sealed::Snapshot {
                type Policy: ?Sized;
                fn policy(&self)
                -> &Self::Policy;
                fn source(&self)
                -> &[u8];
                fn defined_function_count(&self)
                -> usize;
                fn imported_function_count(&self)
                -> usize;
                fn function(&self, absolute: u32)
                -> Option<FunctionSpanView<'_>>;
                fn signature(&self, absolute: u32)
                -> Option<SignatureView<'_>>;
            }
            impl sealed::Snapshot for ValidatedSpans {}
            impl SnapshotView for ValidatedSpans {
                type Policy = Limits;
                fn policy(&self) -> &Limits { self.limits() }
                fn source(&self) -> &[u8] { self.source() }
                fn defined_function_count(&self) -> usize {
                    self.defined_function_count()
                }
                fn imported_function_count(&self) -> usize {
                    self.metadata.imports.len()
                }
                fn function(&self, absolute: u32)
                    -> Option<FunctionSpanView<'_>> {
                    let defined =
                        (absolute as
                                        usize).checked_sub(self.imported_function_count())?;
                    let function = self.metadata.functions.get(defined)?;
                    Some(FunctionSpanView {
                            absolute_index: absolute,
                            type_index: function.type_index,
                            body_offset: function.body.offset as usize,
                            body: function.body.slice(self.source()),
                        })
                }
                fn signature(&self, absolute: u32)
                    -> Option<SignatureView<'_>> {
                    let signature = self.metadata.signature(absolute)?;
                    Some(SignatureView {
                            params: self.metadata.params(signature),
                            result: signature.result,
                        })
                }
            }
            pub(crate) trait DecodePolicy: sealed::Policy {
                fn floats(&self)
                -> bool;
                fn tables(&self)
                -> bool;
                fn source_extent(&self)
                -> usize;
                fn parameters(&self)
                -> usize;
                fn parameters_limit(&self)
                -> usize;
                fn local_groups(&self)
                -> usize;
                fn total_locals(&self)
                -> usize;
                fn instructions(&self)
                -> usize;
                fn control_depth(&self)
                -> usize;
                fn counts_parameters(&self)
                -> bool;
            }
            pub(crate) struct FrozenPolicy<'a> {
                pub limits: &'a Limits,
                pub extent: usize,
            }
            impl sealed::Policy for FrozenPolicy<'_> {}
            impl DecodePolicy for FrozenPolicy<'_> {
                fn floats(&self) -> bool { self.limits.profile.floats() }
                fn tables(&self) -> bool {
                    self.limits.profile == Profile::TableMemoryV3
                }
