            0x8b..=0x98 => {
                let b = if op >= 0x92 { pop32(s) } else { 0 };
                let a = pop32(s);
                let x = f32::from_bits(a);
                let y = f32::from_bits(b);
                let bits =
                    match op {
                        0x8b => a & 0x7fff_ffff,
                        0x8c => a ^ 0x8000_0000,
                        0x8d => x.ceil().to_bits(),
                        0x8e => x.floor().to_bits(),
                        0x8f => x.trunc().to_bits(),
                        0x90 => x.round_ties_even().to_bits(),
                        0x91 => x.sqrt().to_bits(),
                        0x92 => (x + y).to_bits(),
                        0x93 => (x - y).to_bits(),
                        0x94 => (x * y).to_bits(),
                        0x95 => (x / y).to_bits(),
                        0x96 => {
                            if x.is_nan() || y.is_nan() {
                                f32::NAN.to_bits()
                            } else if x == 0.0 && y == 0.0 {
                                a | b
                            } else { if x < y { x } else { y }.to_bits() }
                        }
                        0x97 => {
                            if x.is_nan() || y.is_nan() {
                                f32::NAN.to_bits()
                            } else if x == 0.0 && y == 0.0 {
                                a & b
                            } else { if x > y { x } else { y }.to_bits() }
