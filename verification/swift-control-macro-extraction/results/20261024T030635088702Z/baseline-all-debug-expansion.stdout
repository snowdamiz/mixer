    }
    pub enum NativeTake {
        None,
        BufferTooSmall {
            required: usize,
        },
        Call {
            lease: DispatchLease,
            length: usize,
            remaining_milliseconds: u32,
        },
        Cancel {
            lease: DispatchLease,
        },
    }
    impl CapabilityPort {
        fn check(&self, lease: &DispatchLease) -> Result<(), mb::Error> {
            if Arc::ptr_eq(&self.shared, &lease.shared) {
                Ok(())
            } else { Err(mb::Error::StaleRequest) }
        }
        pub fn take(&self, output: &mut [u8])
            -> Result<NativeTake, mb::Error> {
            self.shared.live()?;
            Ok(match self.shared.mailbox.take(output)? {
                    mb::Take::None => NativeTake::None,
                    mb::Take::BufferTooSmall { required } =>
                        NativeTake::BufferTooSmall { required },
                    mb::Take::Call { lease, length, remaining_milliseconds } =>
                        NativeTake::Call {
                            lease: DispatchLease {
                                shared: Arc::clone(&self.shared),
                                lease,
                            },
                            length,
                            remaining_milliseconds,
                        },
                    mb::Take::Cancel { lease } =>
                        NativeTake::Cancel {
                            lease: DispatchLease {
                                shared: Arc::clone(&self.shared),
                                lease,
                            },
                        },
                })
        }
        /// Trusted opaque bytes. Caller must validate/bind the dynamic wire payload.
        pub fn post_trusted(&self, lease: &DispatchLease, completion: &[u8])
            -> Result<(), mb::Error> {
            self.shared.live()?;
            self.check(lease)?;
            self.shared.mailbox.post(&lease.lease, completion)
        }
        pub fn ack_exit(&self, lease: &DispatchLease)
            -> Result<(), mb::Error> {
            self.check(lease)?;
            self.shared.mailbox.ack_exit(&lease.lease)
        }
        pub fn limit_deadline(&self, lease: &DispatchLease,
            timeout_milliseconds: u32) -> Result<u32, mb::Error> {
            self.shared.live()?;
            self.check(lease)?;
            self.shared.mailbox.limit_deadline(&lease.lease,
                timeout_milliseconds)
