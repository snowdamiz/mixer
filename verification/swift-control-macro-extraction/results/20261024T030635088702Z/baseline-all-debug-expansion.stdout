            /// must check both sides and inside all bounded loops before publication.
            pub(crate) fn check(&mut self, cursor: Cursor)
                -> Result<(), SwiftRunFailure> {
                self.check_with_wasi(cursor, None)
            }
            /// Preserve the actual WASI observation when the first terminal condition
            /// originates at the shared control boundary. No duplicate counters live here.
            pub(crate) fn check_with_wasi(&mut self, cursor: Cursor,
                wasi: Option<WasiUsage>) -> Result<(), SwiftRunFailure> {
                if let Some(failure) = self.first_failure {
                    return Err(failure);
                }
                if self.cancellation.is_cancelled() {
                    return Err(self.fail(cursor,
                                Fault::new(SwiftRunFailureKind::Cancelled,
                                    "swift_run_cancelled"), wasi));
                }
                if Instant::now() >= self.deadline {
                    return Err(self.fail(cursor,
                                Fault::new(SwiftRunFailureKind::Deadline,
                                    "swift_run_deadline"), wasi));
                }
                Ok(())
            }
            pub(crate) fn fail(&mut self, cursor: Cursor, fault: Fault,
                wasi: Option<WasiUsage>) -> SwiftRunFailure {
                if let Some(failure) = self.first_failure { return failure; }
                let failure =
                    SwiftRunFailure {
                        stage: cursor.stage,
                        kind: fault.kind,
                        code: fault.code,
                        function: cursor.function,
                        offset: cursor.offset,
                        resource: fault.resource,
                        attempted: fault.attempted,
                        limit: fault.limit,
                        observed_capacity: fault.observed_capacity,
                        deadline_origin: self.deadline_origin,
                        wasi_failure: fault.wasi_failure,
                        guest_exit: fault.guest_exit,
                        at_failure: self.usage(wasi),
                        after_cleanup: None,
                    };
                self.first_failure = Some(failure);
                failure
            }
            fn category_limit(&self, category: SwiftReservationCategory)
                -> usize {
                match category {
                    SwiftReservationCategory::RetainedSource =>
                        self.budget.source_bytes,
                    SwiftReservationCategory::RetainedMetadata =>
                        self.budget.metadata_bytes,
                    SwiftReservationCategory::Cache => self.budget.cache_bytes,
                    SwiftReservationCategory::State => self.budget.state_bytes,
                    SwiftReservationCategory::Wasi |
                        SwiftReservationCategory::Shared |
                        SwiftReservationCategory::Construction =>
                        self.budget.combined_bytes,
                }
            }
            fn preflight_bytes(&mut self, category: SwiftReservationCategory,
                bytes: usize, cursor: Cursor, wasi: Option<WasiUsage>)
                -> Result<(usize, usize), SwiftRunFailure> {
