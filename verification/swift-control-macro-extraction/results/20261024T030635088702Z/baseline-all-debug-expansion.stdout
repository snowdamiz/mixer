                match &slot.state {
                    State::Live(owner) => owner,
                    State::Closing(owner) if mode == AccessMode::AckClosing =>
                        owner,
                    _ =>
                        return Err(Failure::api("closed or unavailable session handle")),
                };
            if !#[allow(non_exhaustive_omitted_patterns)] match owner.as_ref()
                        {
                        ManagedSession::Capability(_) => true,
                        _ => false,
                    } {
                return Err(Failure::api("wrong session family"));
            }
            Ok(CapabilityLease { handle, session: Some(Arc::clone(owner)) })
        }
        fn close(&self, handle: u64)
            -> Result<Self::Lease, crate::capability_ffi::error::Failure> {
            use crate::capability_ffi::error::Failure;
            let mut registry =
                registry_lock().map_err(capability_registry_error)?;
            let slot =
                registry.slot(handle).map_err(capability_registry_error)?;
