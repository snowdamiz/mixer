                    self.reservations.category(category).current.checked_add(bytes);
                let limit = self.category_limit(category);
                if category_next.is_none_or(|n| n > limit) {
                    let kind =
                        if #[allow(non_exhaustive_omitted_patterns)] match category
                                {
