    impl WasiContext {
        pub fn new(grants: WasiGrants, budget: WasiBudget,
            cancellation: Cancellation) -> Result<Self, WasiFailure> {
            budget.check()?;
            let deadline =
                Instant::now().checked_add(Duration::from_millis(budget.deadline_ms)).ok_or(WasiFailure::InvalidBudget)?;
            fn buffer(len: usize) -> Result<Vec<u8>, WasiFailure> {
                let mut bytes = Vec::new();
                bytes.try_reserve_exact(len).map_err(|_|
                            WasiFailure::Allocation)?;
                Ok(bytes)
            }
            let scratch = buffer(budget.one_transfer_bytes as usize)?;
            let rollback = buffer(budget.one_transfer_bytes as usize)?;
            let stdout = buffer(budget.log_bytes as usize)?;
            let stderr = buffer(budget.log_bytes as usize)?;
            let mut reservations =
                WasiReservations {
                    fixed_state_bytes: std::mem::size_of::<Self>() as u64,
                    staging_bytes: scratch.capacity() as u64,
                    rollback_bytes: rollback.capacity() as u64,
                    stdout_bytes: stdout.capacity() as u64,
                    stderr_bytes: stderr.capacity() as u64,
                    ..WasiReservations::default()
                };
            reservations.current_bytes =
                reservations.fixed_state_bytes.checked_add(reservations.staging_bytes).and_then(|n|
                                        n.checked_add(reservations.rollback_bytes)).and_then(|n|
                                    n.checked_add(reservations.stdout_bytes)).and_then(|n|
                                n.checked_add(reservations.stderr_bytes)).ok_or(WasiFailure::Invariant)?;
            reservations.peak_bytes = reservations.current_bytes;
            Ok(Self {
                    grants,
                    budget,
                    cancellation,
                    deadline,
                    terminal: None,
                    usage: WasiUsage { reservations, ..WasiUsage::default() },
                    scratch,
                    rollback,
                    stdout,
                    stderr,
                    stdout_len: 0,
                    stderr_len: 0,
                    stdout_open: grants.stdout,
                    stderr_open: grants.stderr,
                    iovec_scratch: [Span::default(); 64],
                })
        }
        pub fn usage(&self) -> WasiUsage { self.usage }
        pub fn stdout(&self) -> &[u8] { &self.stdout[..self.stdout_len] }
        pub fn stderr(&self) -> &[u8] { &self.stderr[..self.stderr_len] }
        pub fn terminal(&self) -> Option<WasiOutcome> { self.terminal }
        fn check(&self) -> Result<(), WasiFailure> {
            if self.cancellation.is_cancelled() {
                return Err(WasiFailure::Cancelled);
            }
            if Instant::now() >= self.deadline {
                return Err(WasiFailure::Deadline);
            }
            Ok(())
        }
        fn work(&mut self, amount: u64) -> CallResult {
            let next =
                self.usage.work.checked_add(amount).ok_or(WasiFailure::Invariant)?;
            if next > self.budget.work {
                return Err(WasiFailure::Budget(Resource::Work).into());
            }
            self.usage.work = next;
            Ok(())
        }
        fn transfer(&mut self, amount: usize) -> CallResult {
            if amount > self.budget.one_transfer_bytes as usize {
                return Err(WasiFailure::Budget(Resource::TransferSize).into());
            }
            let next =
                self.usage.transfer_bytes.checked_add(amount as
                                u64).ok_or(WasiFailure::Invariant)?;
            if next > self.budget.transfer_bytes {
                return Err(WasiFailure::Budget(Resource::Transfer).into());
            }
            self.work((amount as
                                        u64).checked_mul(8).ok_or(WasiFailure::Invariant)?)?;
            self.usage.transfer_bytes = next;
            while self.scratch.len() < amount || self.rollback.len() < amount
                {
                self.check()?;
                if self.scratch.len() < amount {
                    self.scratch.resize((self.scratch.len() +
                                    CHUNK).min(amount), 0);
                }
                if self.rollback.len() < amount {
                    self.rollback.resize((self.rollback.len() +
                                    CHUNK).min(amount), 0);
                }
            }
            Ok(())
        }
        fn span(&mut self, memory: &[u8], pointer: u32, length: u32)
            -> Result<Span, Fault> {
            self.work(1)?;
            let end =
                (pointer as
                                    u64).checked_add(length as u64).ok_or(Errno::Fault)?;
            if end > 1u64 << 32 || end > memory.len() as u64 {
                return Err(Errno::Fault.into());
            }
            Ok(Span { start: pointer as usize, end: end as usize })
        }
        fn fd(&self, fd: u32) -> Result<(), Fault> {
            if (fd == 1 && self.stdout_open) || (fd == 2 && self.stderr_open)
                {
                Ok(())
            } else { Err(Errno::Badf.into()) }
        }
        /// Copies staged bytes to up to two disjoint output spans. Backup occurs before
        /// mutation. Bounded commit checks can fail; rollback requires no remaining budget.
        fn commit(&mut self, memory: &mut [u8], outputs: &[Span])
            -> CallResult {
            let mut offset = 0;
            for span in outputs {
                for chunk in (0..span.len()).step_by(CHUNK) {
                    self.check()?;
                    let end = (chunk + CHUNK).min(span.len());
                    self.rollback[offset +
                                    chunk..offset +
                                    end].copy_from_slice(&memory[span.start +
                                        chunk..span.start + end]);
                }
                offset += span.len();
            }
            let mut failure = None;
            offset = 0;
            'write:
                for span in outputs {
                for chunk in (0..span.len()).step_by(CHUNK) {
                    if let Err(error) = self.check() {
                        failure = Some(error);
                        break 'write;
                    }
                    let end = (chunk + CHUNK).min(span.len());
                    memory[span.start +
                                    chunk..span.start +
                                    end].copy_from_slice(&self.scratch[offset +
                                        chunk..offset + end]);
                }
                offset += span.len();
            }
            if failure.is_none() { failure = self.check().err(); }
            if let Some(error) = failure {
                offset = 0;
                for span in outputs {
                    memory[span.start..span.end].copy_from_slice(&self.rollback[offset..offset
                                        + span.len()]);
                    offset += span.len();
                }
                return Err(error.into());
            }
            Ok(())
