            pub(crate) struct Reader<'a> {
                bytes: &'a [u8],
                position: usize,
                base: usize,
            }
            impl Reader<'_> {
                fn byte<F>(&mut self,
                    meter: &mut impl DecodeMeter<Failure = F>)
                    -> Result<u8, F> {
                    meter.set_offset(self.base + self.position);
                    meter.work(1)?;
                    let value =
                        *self.bytes.get(self.position).ok_or_else(||
                                        meter.error(CacheFailureKind::DecoderMismatch,
                                            "decode_end"))?;
                    self.position += 1;
                    Ok(value)
                }
                fn take<F>(&mut self, count: usize,
                    meter: &mut impl DecodeMeter<Failure = F>)
                    -> Result<&[u8], F> {
                    meter.set_offset(self.base + self.position);
                    meter.work(count as u64)?;
                    let end =
                        self.position.checked_add(count).filter(|end|
                                        *end <=
                                            self.bytes.len()).ok_or_else(||
                                    meter.error(CacheFailureKind::DecoderMismatch,
                                        "decode_length"))?;
                    let bytes = &self.bytes[self.position..end];
                    self.position = end;
                    Ok(bytes)
                }
                fn uint<F>(&mut self,
                    meter: &mut impl DecodeMeter<Failure = F>)
                    -> Result<u32, F> {
                    let mut value = 0u32;
                    for index in 0..5 {
                        let byte = self.byte(meter)?;
                        if index == 4 && byte & 0xf0 != 0 {
                            return Err(meter.error(CacheFailureKind::DecoderMismatch,
                                        "decode_u32"));
                        }
                        value |= ((byte & 127) as u32) << (7 * index);
                        if byte & 128 == 0 { return Ok(value); }
                    }
                    Err(meter.error(CacheFailureKind::DecoderMismatch,
                            "decode_u32"))
                }
                fn signed<F>(&mut self, bits: u32,
                    meter: &mut impl DecodeMeter<Failure = F>)
                    -> Result<i64, F> {
                    let maximum = bits.div_ceil(7);
                    let mut value = 0u64;
                    for index in 0..maximum {
                        let byte = self.byte(meter)?;
                        let part = byte & 127;
                        if index == maximum - 1 {
                            let used = bits - 7 * index;
                            let positive = (1u8 << (used - 1)) - 1;
                            let negative = 127 ^ positive;
                            if byte & 128 != 0 || (part > positive && part < negative) {
                                return Err(meter.error(CacheFailureKind::DecoderMismatch,
                                            "decode_signed"));
                            }
                        }
                        value |= (part as u64).wrapping_shl(7 * index);
                        if byte & 128 == 0 {
                            let shift = 7 * (index + 1);
                            if shift < 64 && byte & 64 != 0 {
                                value |= u64::MAX << shift;
                            }
                            return Ok(if bits == 32 {
                                        value as i32 as i64
                                    } else { value as i64 });
                        }
                    }
                    Err(meter.error(CacheFailureKind::DecoderMismatch,
                            "decode_signed"))
                }
                fn ty<F>(&mut self, floats: bool,
                    meter: &mut impl DecodeMeter<Failure = F>)
                    -> Result<Type, F> {
                    match self.byte(meter)? {
                        0x7f => Ok(Type::I32),
                        0x7e => Ok(Type::I64),
                        0x7d if floats => Ok(Type::F32),
                        0x7c if floats => Ok(Type::F64),
                        _ =>
                            Err(meter.error(CacheFailureKind::DecoderMismatch,
                                    "decode_type")),
                    }
                }
                fn zero<F>(&mut self,
                    meter: &mut impl DecodeMeter<Failure = F>)
                    -> Result<(), F> {
                    if self.uint(meter)? == 0 {
                        Ok(())
                    } else {
                        Err(meter.error(CacheFailureKind::DecoderMismatch,
                                "decode_zero"))
                    }
                }
            }
