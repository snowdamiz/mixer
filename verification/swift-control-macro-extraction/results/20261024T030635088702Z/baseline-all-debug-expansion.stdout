            impl SwiftReactorInstance {
                /// Real original-owner route, restricted to the implemented zero-frame slice.
                /// On any preflight/admission failure all owners stay exactly in this slot.
                pub(crate) fn prepare_value_operation(&mut self,
                    cursor: Cursor)
                    -> Result<ExecutionOperationPhase<'_>, SwiftRunFailure> {
                    let Self { control, cache, wasi, state, lifecycle } = self;
                    let control =
                        control.as_mut().expect("constructed control");
                    let wasi = wasi.as_mut().expect("constructed WASI");
                    wasi.checked_usage(control, cursor)?;
                    let cache = cache.as_mut().expect("constructed cache");
                    cache.check_owner(control, Some(wasi), cursor)?;
                    let state = state.as_mut().expect("constructed state");
                    let live = control.usage(Some(wasi.usage())).live;
                    if #[allow(non_exhaustive_omitted_patterns)] match lifecycle
                                                        {
                                                        Lifecycle::Terminal => true,
                                                        _ => false,
                                                    } || !state.frames.is_empty() || !state.controls.is_empty()
                                            || !state.values.is_empty() ||
                                        cache.usage().active_pins != 0 || live.values.current != 0
                                || live.controls.current != 0 || live.frames.current != 0 {
                        return Err(construction_failure(control, wasi, cursor,
                                    SwiftRunFailureKind::Invariant,
                                    "swift_execution_value_operation_nonempty"));
                    }
                    let header =
                        match state.execution_header.as_ref() {
                            Some(header) => header,
                            None => return Err(layout_failure(control, wasi, cursor)),
                        };
                    control.check_reservation_owner(header, cursor,
                            Some(wasi.usage()))?;
                    for ticket in &state.buffers {
                        let ticket =
                            match ticket.as_ref() {
                                Some(ticket) => ticket,
                                None => return Err(layout_failure(control, wasi, cursor)),
                            };
                        control.check_reservation_owner(ticket, cursor,
                                Some(wasi.usage()))?;
                    }
                    let previous_bound =
                        control.usage(Some(wasi.usage())).reservations.construction.current;
                    let bound =
                        match value_operation_bytes() {
                            Some(bytes) =>
                                match previous_bound.checked_add(bytes) {
                                    Some(bound) => bound,
                                    None => return Err(layout_failure(control, wasi, cursor)),
                                },
                            None => return Err(layout_failure(control, wasi, cursor)),
                        };
                    control.enlarge_construction_with_wasi(bound, cursor,
                            Some(wasi.usage()))?;
                    Ok(ExecutionOperationPhase {
                            parts: ExecutionParts {
                                cache,
                                memory: &mut state.memory,
                                table: &mut state.table,
                                globals: &mut state.globals,
                                values: &mut state.values,
                                controls: &mut state.controls,
                                frames: &mut state.frames,
                            },
                            operation: SwiftExecutionOperation {
                                control,
                                wasi,
                                cursor,
                            },
                            previous_bound,
                        })
                }
            }
            impl<'a> ExecutionOperationPhase<'a> {
                pub(crate) fn push_value(&mut self, value: Value)
                    -> Result<(), SwiftRunFailure> {
                    let operand_base =
                        match self.parts.frames.last() {
                            Some(frame) => frame.operands,
                            None => 0,
                        };
                    let operand_limit =
                        self.parts.cache.proof().decode_policy().operand_stack();
                    primitive_push(self.parts.values, operand_base,
                        operand_limit, &mut self.operation, value)
                }
                pub(crate) fn pop_value(&mut self)
                    -> Result<Value, SwiftRunFailure> {
                    let operand_base =
                        match self.parts.frames.last() {
                            Some(frame) => frame.operands,
                            None => 0,
                        };
                    primitive_pop(self.parts.values, operand_base,
                        &mut self.operation)
                }
                pub(crate) fn numeric_value(&mut self, opcode: u8,
                    saturating: bool) -> Result<(), SwiftRunFailure> {
                    let operand_base =
                        match self.parts.frames.last() {
                            Some(frame) => frame.operands,
                            None => 0,
                        };
                    primitive_numeric(self.parts.values, operand_base,
                        &mut self.operation, opcode, saturating)
                }
                /// Clear the actual zero-frame arena despite cancellation/terminal failure,
                /// then destroy both supplied return slots before restoring the exact bound.
                /// The caller retains its copied operation outcome in the permanent envelope.
                pub(crate) fn complete_values(self,
                    storage: ValueOperationStorage<'a>)
                    -> Result<(), SwiftRunFailure> {
                    let Self { parts, mut operation, previous_bound } = self;
                    let cleared = primitive_clear(parts.values, &mut operation);
                    let SwiftExecutionOperation { control, wasi, .. } =
                        operation;
                    let restored =
                        control.end_construction_phase_with_wasi((parts, storage),
                            previous_bound, Some(wasi.usage()));
                    cleared.and(restored)
                }
            }
            impl NumericMode for SwiftMode {
                type NumericState<'a> = Vec<Value>;
                fn values_mut<'short>(state:
                        &'short mut Self::NumericState<'_>)
                    -> &'short mut Vec<Value> {
                    state
                }
            }
            fn primitive_invariant(operation:
                    &mut SwiftExecutionOperation<'_>) -> SwiftRunFailure {
                operation.control.fail(operation.cursor,
                    Fault::new(SwiftRunFailureKind::Invariant,
                        "swift_execution_value_invariant"),
                    Some(operation.wasi.usage()))
            }
            fn primitive_values_match(values: &[Value],
                operation: &mut SwiftExecutionOperation<'_>)
                -> Result<(), SwiftRunFailure> {
                if operation.control.usage(Some(operation.wasi.usage())).live.values.current
                        != values.len() {
                    return Err(primitive_invariant(operation));
                }
                Ok(())
            }
            fn primitive_push(values: &mut Vec<Value>, operand_base: usize,
                operand_limit: usize,
                operation: &mut SwiftExecutionOperation<'_>, value: Value)
                -> Result<(), SwiftRunFailure> {
                operation.control.work_with_wasi(Work::Execution, 1,
                        operation.cursor, Some(operation.wasi.usage()))?;
                primitive_values_match(values, operation)?;
                let Some(operands) =
                    values.len().checked_sub(operand_base) else {
                        return Err(primitive_invariant(operation));
                    };
                if operands >= operand_limit {
                    let mut fault =
                        Fault::new(SwiftRunFailureKind::ValueLimit,
                            "swift_execution_operand_limit");
                    fault.resource = Some(SwiftRunResource::Values);
                    fault.attempted = operands.saturating_add(1) as u64;
                    fault.limit = operand_limit as u64;
                    return Err(operation.control.fail(operation.cursor, fault,
                                Some(operation.wasi.usage())));
                }
                if values.len() == values.capacity() {
                    let mut fault =
                        Fault::new(SwiftRunFailureKind::ValueLimit,
                            "swift_execution_value_capacity");
                    fault.resource = Some(SwiftRunResource::Values);
                    fault.attempted = values.len().saturating_add(1) as u64;
                    fault.limit = values.capacity() as u64;
                    return Err(operation.control.fail(operation.cursor, fault,
                                Some(operation.wasi.usage())));
                }
                operation.control.add_live_with_wasi(Live::Values, 1,
                        operation.cursor, Some(operation.wasi.usage()))?;
                values.push(value);
                Ok(())
            }
            fn primitive_pop(values: &mut Vec<Value>, operand_base: usize,
                operation: &mut SwiftExecutionOperation<'_>)
                -> Result<Value, SwiftRunFailure> {
                operation.control.work_with_wasi(Work::Execution, 1,
                        operation.cursor, Some(operation.wasi.usage()))?;
                primitive_values_match(values, operation)?;
                if values.len() <= operand_base {
                    return Err(primitive_invariant(operation));
                }
                let value = values.pop().expect("checked operand exists");
                operation.control.remove_live_with_wasi(Live::Values, 1,
                        Some(operation.wasi.usage()))?;
                Ok(value)
            }
            fn primitive_numeric(values: &mut Vec<Value>, operand_base: usize,
                operation: &mut SwiftExecutionOperation<'_>, opcode: u8,
                saturating: bool) -> Result<(), SwiftRunFailure> {
                if if saturating {
                        opcode > 7
                    } else { !(0x45..=0xc4).contains(&opcode) } {
                    return Err(operation.control.fail(operation.cursor,
                                Fault::new(SwiftRunFailureKind::UnsupportedEnvironment,
                                    "swift_execution_unsupported_numeric"),
                                Some(operation.wasi.usage())));
                }
                primitive_values_match(values, operation)?;
                let (ty, count, _) =
                    if saturating {
                        let (input, output) =
                            crate::float::saturating_shape(opcode);
                        (input, 1, output)
                    } else {
                        match crate::float::shape(opcode) {
                            Some(shape) => shape,
                            None => crate::validate::numeric_type(opcode),
                        }
                    };
                let before = values.len();
                let available =
                    match before.checked_sub(operand_base) {
                        Some(available) => available,
                        None => return Err(primitive_invariant(operation)),
                    };
                if available < count {
                    return Err(primitive_invariant(operation));
                }
                for value in &values[before - count..] {
                    if value.ty() != ty {
                        return Err(primitive_invariant(operation));
                    }
                }
                operation.control.work_with_wasi(Work::Execution,
                        (count + 1) as u64, operation.cursor,
                        Some(operation.wasi.usage()))?;
                let result =
                    crate::experimental::execution::borrowed::numeric::<SwiftMode>(values,
                        opcode, saturating);
                let Some(removed) =
                    before.checked_sub(values.len()) else {
                        return Err(primitive_invariant(operation));
                    };
                operation.control.remove_live_with_wasi(Live::Values, removed,
                        Some(operation.wasi.usage()))?;
                match result {
                    Ok(()) => Ok(()),
                    Err(code) =>
                        Err(operation.control.fail(operation.cursor,
                                Fault::new(SwiftRunFailureKind::GuestTrap, code),
                                Some(operation.wasi.usage()))),
                }
            }
            fn primitive_clear(values: &mut Vec<Value>,
                operation: &mut SwiftExecutionOperation<'_>)
                -> Result<(), SwiftRunFailure> {
                let mismatch = primitive_values_match(values, operation);
                let removed = values.len();
                values.clear();
                let removal =
                    operation.control.remove_live_with_wasi(Live::Values,
                        removed, Some(operation.wasi.usage()));
                mismatch.and(removal)
            }
        }
