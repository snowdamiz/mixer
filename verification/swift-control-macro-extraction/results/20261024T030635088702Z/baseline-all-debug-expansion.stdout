            slot.state = State::Closing(Arc::clone(&retained));
            Ok(CapabilityLease { handle, session: Some(retained) })
        }
    }
    /// Validate and instantiate a persistent session. Profile IDs are 1, 2 and 3.
    /// # Safety
    /// Pointers obey mixer_vm.h. out_handle is writable and does not alias any buffer.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_session_create_v1(profile: u32,
        data: *const u8, len: usize, limits: *const MixerVmLimits,
        out_handle: *mut u64, out: *mut MixerVmReport) -> u32 {
        unsafe {
            boundary(out,
                ||
                    {
                        if out_handle.is_null() {
                            return Err((arg("null output handle"), 3));
                        }
                        out_handle.write_unaligned(0);
                        let profile =
                            match profile {
                                1 => Profile::IntegerV1,
                                2 => Profile::NumericV2,
                                3 => Profile::TableMemoryV3,
                                _ => return Err((arg("unknown session profile"), 3)),
                            };
                        let mut limits = limits_from(limits).map_err(|e| (e, 3))?;
                        limits.profile = profile;
                        let input =
                            bytes(data, len, limits.module_bytes).map_err(|e| (e, 3))?;
                        let reservation = Reservation::new()?;
                        let module =
                            Module::decode(input, &limits).map_err(|e| (e, 1))?;
                        let instance =
                            Instance::new(module, limits.clone()).map_err(|e| (e, 2))?;
                        let cancellation = instance.cancellation();
                        let handle =
                            reservation.publish(Session {
                                        instance: Mutex::new(instance),
                                        limits,
                                        cancellation,
                                        terminal: AtomicBool::new(false),
                                    })?;
                        out_handle.write_unaligned(handle);
                        Ok(MixerVmReport::default())
                    })
        }
    }
    /// Invoke once on retained state. Any interpreter error permanently terminates it.
    /// # Safety
    /// Pointers obey mixer_vm.h; all buffers remain valid for this complete call.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_session_invoke_v1(handle: u64,
        export: *const u8, export_len: usize, args: *const MixerVmValue,
        args_len: usize, out: *mut MixerVmReport) -> u32 {
        unsafe {
            boundary(out,
                ||
                    {
                        let session = get(handle)?;
                        let name =
                            bytes(export, export_len, 4096).map_err(|e| (e, 3))?;
                        let name =
                            std::str::from_utf8(name).map_err(|_|
                                        (arg("export name is not UTF-8"), 3))?;
                        let values =
                            arguments(session.limits.profile, session.limits.locals,
                                        args, args_len).map_err(|e| (e, 3))?;
                        let mut instance = session.lock()?;
                        let mut result = instance.invoke(name, &values);
                        if session.cancellation.is_cancelled() {
                            result =
                                Err(Error::new("cancelled", "session execution cancelled",
                                        None, 0));
                        }
                        let mut report =
                            match result {
                                Ok(value) => {
                                    let mut report = MixerVmReport::default();
                                    if let Some(value) = value {
                                        (report.value_type, report.value) =
                                            match value {
                                                Value::I32(v) => (1, v as i64),
                                                Value::I64(v) => (2, v),
                                                Value::F32(v) => (3, v as i64),
                                                Value::F64(v) => (4, v as i64),
                                            };
                                    }
                                    report
                                }
                                Err(error) => { session.stop(); report_error(error, 2) }
                            };
                        report.fuel_used =
                            session.limits.fuel - instance.fuel_remaining;
                        report.host_calls_used = instance.host_calls_used;
                        Ok(report)
                    })
        }
    }
    /// Copy guest memory to a host-owned buffer; never exposes a guest-memory pointer.
    /// # Safety
    /// destination holds len writable bytes (null only for zero length), disjoint from out.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_session_read_v1(handle: u64,
        offset: u32, destination: *mut u8, len: usize,
        out: *mut MixerVmReport) -> u32 {
        unsafe {
            boundary(out,
                ||
                    {
                        if len > TRANSFER_CAP || (len > 0 && destination.is_null())
                            {
                            return Err((arg("invalid destination buffer or transfer length"),
                                        3));
                        }
                        let session = get(handle)?;
                        let instance = session.lock()?;
                        let start = offset as usize;
                        let end =
                            start.checked_add(len).filter(|n|
                                            *n <=
                                                instance.memory().len()).ok_or_else(||
                                        {
                                            failure("memory_out_of_bounds",
                                                "host transfer exceeds memory", 3)
                                        })?;
                        if len > 0 {
                            std::ptr::copy_nonoverlapping(instance.memory()[start..end].as_ptr(),
                                destination, len);
                        }
                        Ok(MixerVmReport::default())
                    })
        }
    }
    /// Copy host bytes into bounded guest memory, with whole-range validation before mutation.
    /// # Safety
    /// source holds len readable bytes (null only for zero length), disjoint from out.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_session_write_v1(handle: u64,
        offset: u32, source: *const u8, len: usize, out: *mut MixerVmReport)
        -> u32 {
        unsafe {
            boundary(out,
                ||
                    {
                        let input =
                            bytes(source, len, TRANSFER_CAP).map_err(|e| (e, 3))?;
                        let session = get(handle)?;
                        let mut instance = session.lock()?;
                        instance.write_memory(offset, input).map_err(|e| (e, 3))?;
                        Ok(MixerVmReport::default())
                    })
        }
    }
    /// Permanent cooperative cancellation; does not wait for an active invocation.
    /// # Safety
    /// out points to writable non-aliasing MixerVmReport storage.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_session_cancel_v1(handle: u64,
        out: *mut MixerVmReport) -> u32 {
        unsafe {
            boundary(out,
                || { get(handle)?.stop(); Ok(MixerVmReport::default()) })
        }
    }
    /// Invalidate a handle and cancel execution. Storage survives until in-flight calls return.
    /// # Safety
    /// out points to writable non-aliasing MixerVmReport storage.
    #[no_mangle]
    pub unsafe extern "C" fn mixer_vm_session_close_v1(handle: u64,
        out: *mut MixerVmReport) -> u32 {
        unsafe {
            boundary(out,
                ||
                    {
                        let session =
                            {
                                let mut registry = registry_lock()?;
                                let slot = registry.slot(handle)?;
                                let State::Live(session) =
                                    &slot.state else {
                                        ::core::panicking::panic("internal error: entered unreachable code")
                                    };
                                let legacy =
                                    match session.as_ref() {
                                        ManagedSession::Legacy(legacy) => legacy,
                                        ManagedSession::Capability(_) => {
                                            return Err(failure("invalid_session",
                                                        "wrong session family", 3))
                                        }
                                    };
                                legacy.stop();
                                let session = Arc::clone(session);
                                slot.state = State::Closing(Arc::clone(&session));
                                session
                            };
                        release_lease(handle, session);
                        Ok(MixerVmReport::default())
                    })
        }
    }
}
mod validate {
    use crate::*;
    struct Control {
        kind: BlockKind,
        height: usize,
        result: Option<Type>,
        unreachable: bool,
        has_else: bool,
    }
    struct Validator {
        stack: Vec<Option<Type>>,
        controls: Vec<Control>,
        function: u32,
        offset: usize,
        max: usize,
    }
    impl Validator {
        fn error(&self, m: impl Into<String>) -> Error {
            Error::new("validation", m, Some(self.function), self.offset)
        }
        fn pop_any(&mut self) -> Result<Option<Type>, Error> {
            let c =
                self.controls.last().ok_or_else(||
                            self.error("instruction follows function end"))?;
            if self.stack.len() == c.height && c.unreachable {
                return Ok(None);
            }
            if self.stack.len() <= c.height {
                return Err(self.error("operand stack underflow"));
            }
            Ok(self.stack.pop().unwrap())
        }
        fn pop(&mut self, t: Type) -> Result<(), Error> {
            if let Some(actual) = self.pop_any()? {
                if actual != t {
                    return Err(self.error(::alloc::__export::must_use({
                                        ::alloc::fmt::format(format_args!("expected {0}, found {1}",
                                                t.name(), actual.name()))
                                    })));
                }
            }
            Ok(())
        }
        fn push(&mut self, t: Option<Type>) -> Result<(), Error> {
            if self.stack.len() >= self.max {
                return Err(Error::new("limit",
                            "validated operand stack exceeds limit",
                            Some(self.function), self.offset));
            }
            self.stack.push(t);
            Ok(())
        }
        fn result(&mut self, t: Option<Type>) -> Result<(), Error> {
            if let Some(t) = t { self.pop(t)?; }
            Ok(())
        }
        fn unreachable(&mut self) {
            let c = self.controls.last_mut().unwrap();
            self.stack.truncate(c.height);
            c.unreachable = true;
        }
        fn label(&self, n: u32) -> Result<Option<Type>, Error> {
            let i =
                self.controls.len().checked_sub(n as usize +
                                1).ok_or_else(||
                            self.error("branch depth exceeds control stack"))?;
            let c = &self.controls[i];
            Ok(if c.kind == BlockKind::Loop { None } else { c.result })
        }
    }
    pub(crate) fn module(m: &Module, limits: &Limits) -> Result<(), Error> {
        module_with_admission(m, limits, ImportAdmission::Legacy)
    }
    pub(crate) fn module_with_admission(m: &Module, limits: &Limits,
        admission: ImportAdmission) -> Result<(), Error> {
        if m.profile != limits.profile {
            return Err(Error::new("invalid_limits",
                        "module and instance profiles differ", None, 0));
        }
        if m.types.iter().any(|s| s.params.len() > limits.locals) {
            return Err(Error::new("limit",
                        "signature parameters exceed local limit", None, 0));
        }
        for import in &m.imports {
            let sig =
                m.types.get(import.type_index as
                                usize).ok_or_else(||
                            Error::new("validation", "import type index out of bounds",
                                None, 0))?;
            let allowed =
                import.module == "mixer" &&
                    match import.name.as_str() {
                        "checkpoint" =>
                            sig.params.is_empty() && sig.result.is_none(),
                        "abort" =>
                            sig.params == [Type::I32] && sig.result.is_none(),
                        _ => false,
                    };
            let allowed =
                allowed ||
                    #[allow(non_exhaustive_omitted_patterns)] match admission {
                            ImportAdmission::ExperimentalCapabilityV1 => true,
                            _ => false,
                        } &&
                        crate::experimental_capability_guest::allowed_import(import,
                            sig);
            if !allowed {
                return Err(Error::new("unsupported",
                            ::alloc::__export::must_use({
                                    ::alloc::fmt::format(format_args!("unapproved import {0}.{1}",
                                            import.module, import.name))
                                }), None, 0));
            }
        }
        if #[allow(non_exhaustive_omitted_patterns)] match admission {
                    ImportAdmission::ExperimentalCapabilityV1 => true,
                    _ => false,
                } &&
                (limits.profile != Profile::TableMemoryV3 ||
                        m.memory.is_none()) {
            return Err(Error::new("unsupported",
                        "capability guest requires v3 instruction grammar and defined memory zero",
                        None, 0));
        }
        for (name, (kind, index)) in &m.exports {
            let valid =
                match kind {
                    0 => (*index as usize) < m.function_count(),
                    1 => *index == 0 && m.table.is_some(),
                    2 => *index == 0 && m.memory.is_some(),
                    3 => (*index as usize) < m.globals.len(),
                    _ => false,
                };
            if !valid {
                return Err(Error::new("validation",
                            ::alloc::__export::must_use({
                                    ::alloc::fmt::format(format_args!("invalid or unsupported export {0}",
                                            name))
                                }), None, 0));
            }
        }
        if !m.data.is_empty() && m.memory.is_none() {
            return Err(Error::new("validation", "data segment has no memory",
                        None, 0));
        }
        if let Some((min, max)) = m.table {
            if min > max || max as usize > limits.table_elements {
                return Err(Error::new("limit",
                            "instance table limit exceeded", None, 0));
            }
        }
        if !m.elements.is_empty() && m.table.is_none() {
            return Err(Error::new("validation",
                        "element segment has no table", None, 0));
        }
        if m.elements.iter().map(|(_, v)| v.len()).sum::<usize>() >
                limits.table_elements {
            return Err(Error::new("limit", "element entry limit exceeded",
                        None, 0));
        }
        for (_, functions) in &m.elements {
            for function in functions {
                if *function as usize >= m.function_count() {
                    return Err(Error::new("validation",
                                "element function index out of bounds", None, 0));
                }
            }
        }
        for (i, f) in m.functions.iter().enumerate() {
            let function = (m.imports.len() + i) as u32;
            let sig =
                m.types.get(f.type_index as
                                usize).ok_or_else(||
                            {
                                Error::new("validation",
                                    "function type index out of bounds", Some(function),
                                    f.offset)
                            })?;
            let mut locals = sig.params.clone();
            locals.extend_from_slice(&f.locals);
            if locals.len() > limits.locals {
                return Err(Error::new("limit",
                            "parameters plus locals exceed limit", Some(function),
                            f.offset));
            }
            let mut v =
                Validator {
                    stack: ::alloc::vec::Vec::new(),
                    controls: ::alloc::boxed::box_assume_init_into_vec_unsafe(::alloc::intrinsics::write_box_via_move(::alloc::boxed::Box::new_uninit(),
                            [Control {
                                        kind: BlockKind::Function,
                                        height: 0,
                                        result: sig.result,
                                        unreachable: false,
                                        has_else: false,
                                    }])),
                    function,
                    offset: f.offset,
                    max: limits.operand_stack,
                };
            for ins in &f.code {
                v.offset = ins.offset;
                if v.controls.is_empty() {
                    return Err(v.error("instruction follows function end"));
                }
                match &ins.op {
                    Op::Unreachable => v.unreachable(),
                    Op::Nop => {}
                    Op::Block { kind, result, .. } => {
                        if v.controls.len() >= limits.control_depth {
                            return Err(Error::new("limit",
                                        "control depth exceeds instance limit", Some(function),
                                        v.offset));
                        }
                        if *kind == BlockKind::If { v.pop(Type::I32)?; }
                        v.controls.push(Control {
                                kind: *kind,
                                height: v.stack.len(),
                                result: *result,
                                unreachable: false,
                                has_else: false,
                            });
                    }
                    Op::Else { .. } => {
                        let c = v.controls.last().unwrap();
                        let (height, result, kind) = (c.height, c.result, c.kind);
                        if kind != BlockKind::If {
                            return Err(v.error("else outside if"));
                        }
                        v.result(result)?;
                        if v.stack.len() != height {
                            return Err(v.error("extra values at end of if arm"));
                        }
                        let c = v.controls.last_mut().unwrap();
                        c.unreachable = false;
                        c.has_else = true;
                    }
                    Op::End => {
                        let c = v.controls.last().unwrap();
                        let (height, result, missing_else) =
                            (c.height, c.result,
                                c.kind == BlockKind::If && !c.has_else &&
                                    c.result.is_some());
                        if missing_else {
                            return Err(v.error("result-producing if requires else"));
                        }
                        v.result(result)?;
                        if v.stack.len() != height {
                            return Err(v.error("extra values at control end"));
                        }
                        v.controls.pop();
                        if let Some(t) = result { v.push(Some(t))?; }
                    }
                    Op::Br(n) => {
                        let t = v.label(*n)?;
                        v.result(t)?;
                        v.unreachable();
                    }
                    Op::BrIf(n) => {
                        v.pop(Type::I32)?;
                        let t = v.label(*n)?;
                        v.result(t)?;
                        if let Some(t) = t { v.push(Some(t))?; }
                    }
                    Op::BrTable(labels, default) => {
                        v.pop(Type::I32)?;
                        let t = v.label(*default)?;
                        for n in labels {
                            if v.label(*n)? != t {
                                return Err(v.error("br_table targets have different label types"));
                            }
                        }
                        v.result(t)?;
                        v.unreachable();
                    }
                    Op::Return => { v.result(sig.result)?; v.unreachable(); }
                    Op::Call(index) => {
                        let called =
                            m.signature(*index).ok_or_else(||
                                        v.error("call index out of bounds"))?;
                        for t in called.params.iter().rev() { v.pop(*t)?; }
                        if let Some(t) = called.result { v.push(Some(t))?; }
                    }
                    Op::CallIndirect(index) => {
                        if m.table.is_none() {
                            return Err(v.error("call_indirect has no table"));
                        }
                        let called =
                            m.types.get(*index as
                                            usize).ok_or_else(||
                                        v.error("call_indirect type index out of bounds"))?;
                        v.pop(Type::I32)?;
                        for ty in called.params.iter().rev() { v.pop(*ty)?; }
                        if let Some(ty) = called.result { v.push(Some(ty))?; }
                    }
                    Op::MemoryCopy | Op::MemoryFill => {
                        if m.memory.is_none() {
                            return Err(v.error("bulk operation has no memory"));
                        }
                        v.pop(Type::I32)?;
                        v.pop(Type::I32)?;
                        v.pop(Type::I32)?;
                    }
                    Op::Drop => { v.pop_any()?; }
                    Op::Select => {
                        v.pop(Type::I32)?;
                        let b = v.pop_any()?;
                        let a = v.pop_any()?;
                        if a.is_some() && b.is_some() && a != b {
                            return Err(v.error("select operands have different types"));
                        }
                        v.push(a.or(b))?;
                    }
                    Op::LocalGet(i) | Op::LocalSet(i) | Op::LocalTee(i) => {
                        let t =
                            *locals.get(*i as
                                                usize).ok_or_else(|| v.error("local index out of bounds"))?;
                        if !#[allow(non_exhaustive_omitted_patterns)] match ins.op {
                                    Op::LocalGet(_) => true,
                                    _ => false,
                                } {
                            v.pop(t)?;
                        }
                        if !#[allow(non_exhaustive_omitted_patterns)] match ins.op {
                                    Op::LocalSet(_) => true,
                                    _ => false,
                                } {
                            v.push(Some(t))?;
                        }
                    }
                    Op::GlobalGet(i) | Op::GlobalSet(i) => {
                        let g =
                            m.globals.get(*i as
                                            usize).ok_or_else(||
                                        v.error("global index out of bounds"))?;
                        if #[allow(non_exhaustive_omitted_patterns)] match ins.op {
                                Op::GlobalSet(_) => true,
                                _ => false,
                            } {
                            if !g.mutable {
                                return Err(v.error("global is immutable"));
                            }
                            v.pop(g.value.ty())?;
                        } else { v.push(Some(g.value.ty()))?; }
                    }
                    Op::Const(value) => v.push(Some(value.ty()))?,
                    Op::Load { opcode, .. } => {
                        if m.memory.is_none() {
                            return Err(v.error("load has no memory"));
                        }
                        v.pop(Type::I32)?;
                        v.push(Some(match opcode {
                                        0x2a => Type::F32,
                                        0x2b => Type::F64,
                                        0x29 | 0x30..=0x35 => Type::I64,
                                        _ => Type::I32,
                                    }))?;
                    }
                    Op::Store { opcode, .. } => {
                        if m.memory.is_none() {
                            return Err(v.error("store has no memory"));
                        }
                        v.pop(match opcode {
                                    0x38 => Type::F32,
                                    0x39 => Type::F64,
                                    0x37 | 0x3c..=0x3e => Type::I64,
                                    _ => Type::I32,
                                })?;
                        v.pop(Type::I32)?;
                    }
                    Op::MemorySize | Op::MemoryGrow => {
                        if m.memory.is_none() {
                            return Err(v.error("memory instruction has no memory"));
                        }
                        if #[allow(non_exhaustive_omitted_patterns)] match ins.op {
                                Op::MemoryGrow => true,
                                _ => false,
                            } {
                            v.pop(Type::I32)?;
                        }
                        v.push(Some(Type::I32))?;
                    }
                    Op::Saturating(sub) => {
                        let (input, output) = crate::float::saturating_shape(*sub);
                        v.pop(input)?;
                        v.push(Some(output))?;
                    }
                    Op::Numeric(o) => {
                        let (input, count, output) = numeric_type(*o);
                        for _ in 0..count { v.pop(input)?; }
                        v.push(Some(output))?;
                    }
                }
            }
            if !v.controls.is_empty() {
                return Err(v.error("unterminated control stack"));
            }
        }
        Ok(())
    }
    pub(crate) fn numeric_type(o: u8) -> (Type, usize, Type) {
        use Type::*;
        match o {
            0x45 => (I32, 1, I32),
            0x46..=0x4f => (I32, 2, I32),
            0x50 => (I64, 1, I32),
            0x51..=0x5a => (I64, 2, I32),
            0x67..=0x69 | 0xc0 | 0xc1 => (I32, 1, I32),
            0x6a..=0x78 => (I32, 2, I32),
            0x79..=0x7b | 0xc2..=0xc4 => (I64, 1, I64),
            0x7c..=0x8a => (I64, 2, I64),
            0xa7 => (I64, 1, I32),
            0xac | 0xad => (I32, 1, I64),
            _ =>
                crate::float::shape(o).expect("decoder admitted known numeric opcode"),
        }
    }
}
