        /// types are never instantiated; their layouts reserve requested object bytes,
        /// not physical stack or allocator overhead. Each repeated position accounts
        /// source/argument/return independently, without borrowing containing padding.
        struct ConstructionDescriptors {
            memory: Option<MemoryExecutionView>,
            table: Option<TableExecutionView>,
            global: Option<GlobalView<'static>>,
            segment: Option<SegmentExecutionView<'static>>,
            initializer_offset: Option<usize>,
            capacities: [usize; 6],
            requests: Option<[usize; 6]>,
            budget: SwiftRunBudget,
            target_type: Type,
            opcode: u8,
            byte: u8,
            bits: u64,
            shift: u32,
            width: u32,
            signed: i64,
            float32: [u8; 4],
            float64: [u8; 8],
        }
        struct ConstructionTransfers {
            pair: Option<(RuntimeControl, AdoptedProof)>,
            owned_slot: &'static mut Option<(RuntimeControl, AdoptedProof)>,
            grants: WasiGrants,
            wasi_budget: WasiBudget,
            started: Instant,
            state_phase: Result<ExecutionConstructionPhase<'static>,
            SwiftRunFailure>,
            cache_phase: Result<CacheConstructionPhase<'static>,
            SwiftRunFailure>,
            wasi_phase: Result<WasiConstructionPhase<'static>,
            SwiftRunFailure>,
            reserve: Result<ReservationTicket, SwiftRunFailure>,
            allocate: Result<Vec<Value>, SwiftRunFailure>,
            initialized: Result<(), SwiftRunFailure>,
            constant: Result<Value, SwiftRunFailure>,
            scalar: Result<u64, SwiftRunFailure>,
            end: Option<usize>,
        }
        /// Names only execution-owned call/borrow/scalar roles. The nested runtime
        /// control paths have their separately declared bootstrap dependency below.
        struct ConstructionBorrowChain {
            control: [&'static mut RuntimeControl; 6],
            state: [&'static mut SwiftExecutionState; 3],
            cache: [&'static SwiftFunctionCache; 4],
            wasi: [&'static AccountedWasi; 6],
            phase: [&'static mut ExecutionConstructionPhase<'static>; 3],
            reader: [&'static mut ScalarReader<'static>; 3],
            vector: [&'static mut Vec<Value>; 2],
            slice: [&'static [u8]; 4],
            mutable_slice: [&'static mut [u8]; 2],
            index: [usize; 12],
            cursor: [Cursor; 4],
            observation: [Option<WasiUsage>; 2],
            fault: [Fault; 2],
        }
        struct ConstructionIterationInventory {
            global_range: std::ops::Range<usize>,
            table_range: std::ops::Range<u32>,
            descriptor_range: std::ops::Range<usize>,
            element_range: std::ops::Range<usize>,
            leb_range: std::ops::Range<u32>,
            leb_steps: std::iter::StepBy<std::ops::Range<u32>>,
            float_iter: std::slice::IterMut<'static, u8>,
            float_item: Option<&'static mut u8>,
            descriptor_item: Option<usize>,
            table_item: Option<u32>,
            borrowed_segment: SegmentExecutionView<'static>,
            borrowed_global: GlobalView<'static>,
            typed_result: Result<Value, SwiftRunFailure>,
            signed_result: Result<i64, SwiftRunFailure>,
            unsigned_result: Result<u32, SwiftRunFailure>,
            byte_result: Result<u8, SwiftRunFailure>,
            error: Option<std::collections::TryReserveError>,
            error_callback: (&'static mut ExecutionConstructionPhase<'static>,
            &'static usize),
            descriptor_callback: &'static mut ExecutionConstructionPhase<'static>,
            reader_callback: (&'static ScalarReader<'static>,
            &'static mut RuntimeControl, &'static AccountedWasi,
            &'static Cursor),
        }
        struct CleanupPreflightInventory {
            owner_option: Option<&'static mut SwiftReactorInstance>,
            owner: &'static mut SwiftReactorInstance,
            control_option: Option<&'static mut RuntimeControl>,
            control: &'static mut RuntimeControl,
            wasi_option: Option<&'static AccountedWasi>,
            wasi: &'static AccountedWasi,
            cache_option: Option<&'static SwiftFunctionCache>,
            cache: &'static SwiftFunctionCache,
            state_option: Option<&'static SwiftExecutionState>,
            state: &'static SwiftExecutionState,
            header_option: Option<&'static ReservationTicket>,
            header: &'static ReservationTicket,
            buffer_iter: std::slice::Iter<'static, Option<ReservationTicket>>,
            buffer_item: Option<&'static Option<ReservationTicket>>,
            buffer: &'static Option<ReservationTicket>,
            buffer_ticket: Option<&'static ReservationTicket>,
            cache_usage: super::cache::SwiftCacheUsage,
            cursor_arguments: [Cursor; 2],
            header_error_callback: (&'static mut RuntimeControl,
            &'static AccountedWasi),
            buffer_error_callback: (&'static mut RuntimeControl,
            &'static AccountedWasi),
            nonempty: [bool; 4],
        }
        /// This group must be charged by the foundation before a caller enters either
        /// constructor/preparation. The later enlarged phase cannot retroactively cover
        /// its own inputs and provenance/admission call chain. Whole groups are a
        /// conservative maximum; diagnostic/fault transfers already named by foundation
        /// retain those classes and are not reused as smaller borrow slots here.
        pub(super) struct ConstructionBootstrapInventory {
            pair_slot: [&'static mut Option<(RuntimeControl,
            AdoptedProof)>; 2],
            control: [&'static mut RuntimeControl; 8],
            adopted: [&'static AdoptedProof; 3],
            cache: [&'static SwiftFunctionCache; 4],
            wasi: [&'static AccountedWasi; 4],
            cursor: [Cursor; 5],
            grants: [WasiGrants; 3],
            budget: [WasiBudget; 3],
            started: [Instant; 3],
            cache_control: CacheControl<'static>,
            header_option: [Option<&'static ReservationTicket>; 3],
            header: [&'static ReservationTicket; 5],
            observation: [Option<WasiUsage>; 3],
            snapshot_return: [SwiftRunUsage; 2],
            previous_bound: [usize; 4],
            checked_bound: [Option<usize>; 2],
            owner_verdict: [Option<(SwiftCleanupInvariant, &'static str)>; 2],
            ticket_option: Option<&'static ReservationTicket>,
            current: usize,
            requested: usize,
            difference: usize,
            category_next: usize,
            combined_next: usize,
            checked_category: Option<usize>,
            checked_combined: Option<usize>,
            category: SwiftReservationCategory,
            category_usage: &'static SwiftReservationUsage,
            category_mut: &'static mut SwiftReservationUsage,
            reservations: &'static mut SwiftReservations,
            construction_ticket: Option<&'static mut ReservationTicket>,
        }
        pub(super) const CONSTRUCTION_BOOTSTRAP_BYTES: usize =
            {
                let base = size_of::<ConstructionBootstrapInventory>();
                match base.checked_add(CONSTRUCTION_POSITIVE_PREFLIGHT_BYTES)
                    {
                    Some(value) =>
                        match value.checked_add(CONSTRUCTION_POSITIVE_FINAL_BYTES) {
                            Some(value) =>
                                match value.checked_add(CONSTRUCTION_POSITIVE_TEST_HOOK_BYTES)
                                    {
                                    Some(value) => value,
                                    None => usize::MAX,
                                },
                            None => usize::MAX,
                        },
                    None => usize::MAX,
                }
            };
        const BASE_CONSTRUCTION_BYTES: Option<usize> =
            match named_bytes("construction") {
                Some(base) =>
                    match base.checked_add(3 *
                                size_of::<ConstructionDescriptors>()) {
                        Some(n) =>
                            match n.checked_add(3 * size_of::<ConstructionTransfers>())
                                {
                                Some(n) =>
                                    match n.checked_add(size_of::<ConstructionBorrowChain>()) {
                                        Some(n) =>
                                            n.checked_add(3 *
                                                    size_of::<ConstructionIterationInventory>()),
                                        None => None,
                                    },
                                None => None,
                            },
                        None => None,
                    },
                None => None,
            };
        const CONSTRUCTION_BYTES: Option<usize> =
            match BASE_CONSTRUCTION_BYTES {
                Some(base) =>
                    match base.checked_add(CONSTRUCTION_POSITIVE_ACTIVE_BYTES) {
                        Some(value) => {
                            value.checked_add(crate::experimental::swift::CONSTRUCTION_POSITIVE_DESCRIPTOR_BYTES)
                        }
                        None => None,
                    },
                None => None,
            };
        pub(crate) fn construction_bytes() -> Option<usize> {
            CONSTRUCTION_BYTES
        }
        fn construction_failure(control: &mut RuntimeControl,
            wasi: &AccountedWasi, cursor: Cursor, kind: SwiftRunFailureKind,
            code: &'static str) -> SwiftRunFailure {
            control.fail(cursor, Fault::new(kind, code), Some(wasi.usage()))
        }
        fn layout_failure(control: &mut RuntimeControl, wasi: &AccountedWasi,
            cursor: Cursor) -> SwiftRunFailure {
            construction_failure(control, wasi, cursor,
                SwiftRunFailureKind::Invariant,
                "swift_execution_layout_overflow")
        }
        fn checked(control: &mut RuntimeControl, wasi: &AccountedWasi,
            cursor: Cursor) -> Result<(), SwiftRunFailure> {
            control.check_with_wasi(cursor, Some(wasi.usage()))
        }
        fn work(control: &mut RuntimeControl, wasi: &AccountedWasi,
            cursor: Cursor, credits: usize) -> Result<(), SwiftRunFailure> {
            checked(control, wasi, cursor)?;
            control.work_with_wasi(Work::Execution, credits as u64, cursor,
                Some(wasi.usage()))
        }
        impl SwiftExecutionState {
            pub(crate) fn prepare<'a>(control: &'a mut RuntimeControl,
                cache: &'a SwiftFunctionCache, wasi: &'a AccountedWasi,
                cursor: Cursor)
                -> Result<ExecutionConstructionPhase<'a>, SwiftRunFailure> {
                wasi.checked_usage(control, cursor)?;
                cache.check_owner(control, Some(wasi), cursor)?;
                checked(control, wasi, cursor)?;
                if cache.usage().active_pins != 0 {
                    return Err(construction_failure(control, wasi, cursor,
                                SwiftRunFailureKind::Invariant,
                                "swift_execution_preexisting_pins"));
                }
                let previous_bound =
                    control.usage(Some(wasi.usage())).reservations.construction.current;
                let bound =
                    construction_bytes().and_then(|n|
                                    previous_bound.checked_add(n)).ok_or_else(||
                                layout_failure(control, wasi, cursor))?;
                control.enlarge_construction_with_wasi(bound, cursor,
                        Some(wasi.usage()))?;
                Ok(ExecutionConstructionPhase {
                        control,
                        cache,
                        wasi,
                        cursor,
                        previous_bound,
                        constructed: false,
                    })
            }
            fn empty() -> Self {
                Self {
                    memory: Vec::new(),
                    table: Vec::new(),
                    globals: Vec::new(),
                    values: Vec::new(),
                    controls: Vec::new(),
                    frames: Vec::new(),
                    buffers: std::array::from_fn(|_| None),
                    execution_header: None,
                }
            }
            /// Only this constructor's unpublished State is accepted. Its last fallible
            /// action is the page debit, so every failure here has zero State live counts.
            fn cleanup_unpublished(mut self, control: &mut RuntimeControl,
                wasi: &AccountedWasi) {
                self.drop_arenas(control, wasi);
                if let Some(header) = self.execution_header.take() {
                    let _ =
                        control.drop_reserved_with_wasi(self, header,
                            Some(wasi.usage()));
                }
            }
            fn drop_arenas(&mut self, control: &mut RuntimeControl,
                wasi: &AccountedWasi) {
                macro_rules! release {
                    ($field:ident, $index:literal) =>
                    {{
                            if let Some(ticket) = self.buffers[$index].take()
                            {
                                let _ =
                                control.drop_reserved_with_wasi(take(&mut self.$field),
                                ticket, Some(wasi.usage()),);
                            } else { drop(take(&mut self.$field)); }
                        }};
                }
                {
                    if let Some(ticket) = self.buffers[0].take() {
                        let _ =
                            control.drop_reserved_with_wasi(take(&mut self.values),
                                ticket, Some(wasi.usage()));
                    } else { drop(take(&mut self.values)); }
                };
                {
                    if let Some(ticket) = self.buffers[1].take() {
                        let _ =
                            control.drop_reserved_with_wasi(take(&mut self.controls),
                                ticket, Some(wasi.usage()));
                    } else { drop(take(&mut self.controls)); }
                };
                {
                    if let Some(ticket) = self.buffers[2].take() {
                        let _ =
                            control.drop_reserved_with_wasi(take(&mut self.frames),
                                ticket, Some(wasi.usage()));
                    } else { drop(take(&mut self.frames)); }
                };
                {
                    if let Some(ticket) = self.buffers[3].take() {
                        let _ =
                            control.drop_reserved_with_wasi(take(&mut self.memory),
                                ticket, Some(wasi.usage()));
                    } else { drop(take(&mut self.memory)); }
                };
                {
                    if let Some(ticket) = self.buffers[4].take() {
                        let _ =
                            control.drop_reserved_with_wasi(take(&mut self.table),
                                ticket, Some(wasi.usage()));
                    } else { drop(take(&mut self.table)); }
                };
                {
                    if let Some(ticket) = self.buffers[5].take() {
                        let _ =
                            control.drop_reserved_with_wasi(take(&mut self.globals),
                                ticket, Some(wasi.usage()));
                    } else { drop(take(&mut self.globals)); }
                };
            }
        }
        impl ExecutionConstructionPhase<'_> {
            pub(crate) fn construct(&mut self)
                -> Result<SwiftExecutionState, SwiftRunFailure> {
                if std::mem::replace(&mut self.constructed, true) {
                    return Err(construction_failure(self.control, self.wasi,
                                self.cursor, SwiftRunFailureKind::Invariant,
                                "swift_execution_construct_once"));
                }
                let mut partial =
                    PartialState {
                        state: SwiftExecutionState::empty(),
                        next_arena: 0,
                    };
                match self.construct_partial(&mut partial) {
                    Ok(()) => Ok(partial.state),
                    Err(failure) => {
                        partial.state.cleanup_unpublished(self.control, self.wasi);
                        Err(failure)
                    }
                }
            }
            fn construct_partial(&mut self, partial: &mut PartialState)
                -> Result<(), SwiftRunFailure> {
                checked(self.control, self.wasi, self.cursor)?;
                let budget = self.control.budget();
                let memory =
                    self.cache.proof().execution_memory().ok_or_else(||
                                layout_failure(self.control, self.wasi, self.cursor))?;
                if memory.minimum > budget.memory_pages {
                    let mut fault =
                        Fault::new(SwiftRunFailureKind::ResourceExhausted,
                            "swift_execution_memory_minimum");
                    fault.resource = Some(SwiftRunResource::MemoryPages);
                    fault.attempted = memory.minimum as u64;
                    fault.limit = budget.memory_pages as u64;
                    return Err(self.control.fail(self.cursor, fault,
                                Some(self.wasi.usage())));
                }
                let table =
                    self.cache.proof().execution_table().ok_or_else(||
                                layout_failure(self.control, self.wasi, self.cursor))?;
                let globals = self.cache.proof().execution_global_count();
                let requests =
                    arena_bytes(budget.values, budget.controls, budget.frames,
                                memory.minimum as usize, table.minimum as usize,
                                globals).ok_or_else(||
                                layout_failure(self.control, self.wasi, self.cursor))?;
                let header =
                    execution_header_bytes().ok_or_else(||
                                layout_failure(self.control, self.wasi, self.cursor))?;
                partial.state.execution_header =
                    Some(self.control.admit_with_wasi(SwiftReservationCategory::State,
                                header, self.cursor, Some(self.wasi.usage()))?);
                macro_rules! arena {
                    ($field:ident, $index:literal, $capacity:expr) =>
                    {{
                            partial.state.buffers[$index] =
                            Some(self.control.admit_with_wasi(SwiftReservationCategory::State,
                            requests[$index], self.cursor, Some(self.wasi.usage()),)?);
                            self.reserve(&mut partial.state.$field, $capacity)?;
                            partial.next_arena += 1;
                        }};
                }
                {
                    partial.state.buffers[0] =
                        Some(self.control.admit_with_wasi(SwiftReservationCategory::State,
                                    requests[0], self.cursor, Some(self.wasi.usage()))?);
                    self.reserve(&mut partial.state.values, budget.values)?;
                    partial.next_arena += 1;
                };
                {
                    partial.state.buffers[1] =
                        Some(self.control.admit_with_wasi(SwiftReservationCategory::State,
                                    requests[1], self.cursor, Some(self.wasi.usage()))?);
                    self.reserve(&mut partial.state.controls, budget.controls)?;
                    partial.next_arena += 1;
                };
                {
                    partial.state.buffers[2] =
                        Some(self.control.admit_with_wasi(SwiftReservationCategory::State,
                                    requests[2], self.cursor, Some(self.wasi.usage()))?);
                    self.reserve(&mut partial.state.frames, budget.frames)?;
                    partial.next_arena += 1;
                };
                {
                    partial.state.buffers[3] =
                        Some(self.control.admit_with_wasi(SwiftReservationCategory::State,
                                    requests[3], self.cursor, Some(self.wasi.usage()))?);
                    self.reserve(&mut partial.state.memory, requests[3])?;
                    partial.next_arena += 1;
                };
                {
                    partial.state.buffers[4] =
                        Some(self.control.admit_with_wasi(SwiftReservationCategory::State,
                                    requests[4], self.cursor, Some(self.wasi.usage()))?);
                    self.reserve(&mut partial.state.table,
                            table.minimum as usize)?;
                    partial.next_arena += 1;
                };
                {
                    partial.state.buffers[5] =
                        Some(self.control.admit_with_wasi(SwiftReservationCategory::State,
                                    requests[5], self.cursor, Some(self.wasi.usage()))?);
                    self.reserve(&mut partial.state.globals, globals)?;
                    partial.next_arena += 1;
                };
                let credits =
                    requests[3].checked_add(table.minimum as
                                        usize).and_then(|n|
                                    n.checked_add(globals)).ok_or_else(||
                                layout_failure(self.control, self.wasi, self.cursor))?;
                work(self.control, self.wasi, self.cursor, credits)?;
                while partial.state.memory.len() < requests[3] {
                    checked(self.control, self.wasi, self.cursor)?;
                    let end =
                        (partial.state.memory.len() + CHUNK).min(requests[3]);
                    partial.state.memory.resize(end, 0);
                }
                for _ in 0..table.minimum {
                    checked(self.control, self.wasi, self.cursor)?;
                    partial.state.table.push(None);
                }
                for index in 0..globals {
                    work(self.control, self.wasi, self.cursor, 16)?;
                    let global =
                        self.cache.proof().execution_global(index).ok_or_else(||
                                    layout_failure(self.control, self.wasi, self.cursor))?;
                    let offset =
                        self.cache.proof().execution_global_initializer_offset(index).ok_or_else(||
                                    layout_failure(self.control, self.wasi, self.cursor))?;
                    let mut reader =
                        ScalarReader {
                            bytes: global.initializer,
                            at: 0,
                            absolute_offset: offset,
                        };
                    let value =
                        reader.constant(global.ty, self.control, self.wasi,
                                self.cursor)?;
                    partial.state.globals.push(value);
                }
                self.initialize_segments(&mut partial.state)?;
                self.control.add_live_with_wasi(Live::MemoryPages,
                    memory.minimum as usize, self.cursor,
                    Some(self.wasi.usage()))
            }
            fn reserve<T>(&mut self, values: &mut Vec<T>, requested: usize)
                -> Result<(), SwiftRunFailure> {
                checked(self.control, self.wasi, self.cursor)?;
                values.try_reserve_exact(requested).map_err(|_|
                            {
                                let mut fault =
                                    Fault::new(SwiftRunFailureKind::Allocation,
                                        "swift_execution_allocation");
                                fault.attempted = requested as u64;
                                self.control.fail(self.cursor, fault,
                                    Some(self.wasi.usage()))
                            })?;
                let observed = values.capacity();
                self.control.exact_capacity_with_wasi(requested, observed,
                        self.cursor, Some(self.wasi.usage()))?;
                checked(self.control, self.wasi, self.cursor)
            }
            fn initialize_segments(&mut self, state: &mut SwiftExecutionState)
                -> Result<(), SwiftRunFailure> {
                for index in 0..self.cache.proof().execution_data_count() {
                    work(self.control, self.wasi, self.cursor, 1)?;
                    let segment =
                        self.cache.proof().execution_data(index).ok_or_else(||
                                    layout_failure(self.control, self.wasi, self.cursor))?;
                    self.range(segment, state.memory.len(),
                            "swift_execution_data_bounds")?;
                    if segment.count as usize != segment.encoded_payload.len() {
                        return Err(self.segment_failure(segment,
                                    "swift_execution_data_count"));
                    }
                }
                for index in 0..self.cache.proof().execution_element_count() {
                    work(self.control, self.wasi, self.cursor, 1)?;
                    let segment =
                        self.cache.proof().execution_element(index).ok_or_else(||
                                    layout_failure(self.control, self.wasi, self.cursor))?;
                    self.range(segment, state.table.len(),
                            "swift_execution_element_bounds")?;
                }
                for index in 0..self.cache.proof().execution_data_count() {
                    let segment =
                        self.cache.proof().execution_data(index).ok_or_else(||
                                    layout_failure(self.control, self.wasi, self.cursor))?;
                    work(self.control, self.wasi, self.cursor,
                            segment.encoded_payload.len())?;
                    let mut copied = 0;
                    while copied < segment.encoded_payload.len() {
                        let cursor =
                            Cursor {
                                offset: Some(segment.payload_offset + copied),
                                ..self.cursor
                            };
                        checked(self.control, self.wasi, cursor)?;
                        let end =
                            (copied + CHUNK).min(segment.encoded_payload.len());
                        let destination = segment.destination as usize + copied;
                        state.memory[destination..destination + end -
                                        copied].copy_from_slice(&segment.encoded_payload[copied..end]);
                        copied = end;
                    }
                    checked(self.control, self.wasi,
                            Cursor {
                                offset: Some(segment.payload_offset + copied),
                                ..self.cursor
                            })?;
                }
                for index in 0..self.cache.proof().execution_element_count() {
                    let segment =
                        self.cache.proof().execution_element(index).ok_or_else(||
                                    layout_failure(self.control, self.wasi, self.cursor))?;
                    work(self.control, self.wasi, self.cursor,
                            segment.encoded_payload.len())?;
                    let mut reader =
                        ScalarReader {
                            bytes: segment.encoded_payload,
                            at: 0,
                            absolute_offset: segment.payload_offset,
                        };
                    for slot in 0..segment.count as usize {
                        let function =
                            reader.unsigned(self.control, self.wasi, self.cursor)?;
                        if self.cache.proof().execution_signature(function).is_none()
                            {
                            return Err(reader.failure(self.control, self.wasi,
                                        self.cursor, "swift_execution_element_function"));
                        }
                        state.table[segment.destination as usize + slot] =
                            Some(function);
                    }
                    reader.end(self.control, self.wasi, self.cursor)?;
                }
                checked(self.control, self.wasi, self.cursor)
            }
            fn range(&mut self, segment: SegmentExecutionView<'_>,
                length: usize, code: &'static str)
                -> Result<(), SwiftRunFailure> {
                if (segment.destination as
                                    usize).checked_add(segment.count as
                                usize).is_none_or(|end| end > length) {
                    return Err(self.segment_failure(segment, code));
                }
                Ok(())
            }
            fn segment_failure(&mut self, segment: SegmentExecutionView<'_>,
                code: &'static str) -> SwiftRunFailure {
                construction_failure(self.control, self.wasi,
                    Cursor {
                        offset: Some(segment.payload_offset),
                        ..self.cursor
                    }, SwiftRunFailureKind::GuestTrap, code)
            }
            pub(crate) fn complete<T>(self, returned_phase_storage: T)
                -> Result<(), SwiftRunFailure> {
                let Self { control, wasi, previous_bound, .. } = self;
                control.end_construction_phase_with_wasi(returned_phase_storage,
                    previous_bound, Some(wasi.usage()))
            }
        }
        impl ScalarReader<'_> {
            fn failure(&self, control: &mut RuntimeControl,
                wasi: &AccountedWasi, cursor: Cursor, code: &'static str)
                -> SwiftRunFailure {
                construction_failure(control, wasi,
                    Cursor {
                        offset: Some(self.absolute_offset + self.at),
                        ..cursor
                    }, SwiftRunFailureKind::Invariant, code)
            }
            fn byte(&mut self, control: &mut RuntimeControl,
                wasi: &AccountedWasi, cursor: Cursor)
                -> Result<u8, SwiftRunFailure> {
                checked(control, wasi,
                        Cursor {
                            offset: Some(self.absolute_offset + self.at),
                            ..cursor
                        })?;
                let byte =
                    self.bytes.get(self.at).copied().ok_or_else(||
                                self.failure(control, wasi, cursor,
                                    "swift_execution_scalar_eof"))?;
                self.at += 1;
                Ok(byte)
            }
            fn unsigned(&mut self, control: &mut RuntimeControl,
                wasi: &AccountedWasi, cursor: Cursor)
                -> Result<u32, SwiftRunFailure> {
                let mut bits = 0u32;
                for shift in (0..35).step_by(7) {
                    let byte = self.byte(control, wasi, cursor)?;
                    if shift == 28 && byte & 0xf0 != 0 {
                        self.at -= 1;
                        return Err(self.failure(control, wasi, cursor,
                                    "swift_execution_scalar_u32"));
                    }
                    bits |= ((byte & 0x7f) as u32) << shift;
                    if byte & 0x80 == 0 { return Ok(bits); }
                }
                Err(self.failure(control, wasi, cursor,
                        "swift_execution_scalar_u32"))
            }
            fn signed(&mut self, width: u32, control: &mut RuntimeControl,
                wasi: &AccountedWasi, cursor: Cursor)
                -> Result<i64, SwiftRunFailure> {
                let mut bits = 0u64;
                let mut shift = 0;
                loop {
                    let byte = self.byte(control, wasi, cursor)?;
                    let remaining = width - shift;
                    if remaining < 7 {
                        let mask = (0x7f_u8 << remaining) & 0x7f;
                        let sign = byte & (1 << (remaining - 1)) != 0;
                        if byte & 0x80 != 0 ||
                                byte & mask != if sign { mask } else { 0 } {
                            self.at -= 1;
                            return Err(self.failure(control, wasi, cursor,
                                        "swift_execution_scalar_signed"));
                        }
                    }
                    bits |= ((byte & 0x7f) as u64) << shift;
                    shift += 7;
                    if byte & 0x80 == 0 {
