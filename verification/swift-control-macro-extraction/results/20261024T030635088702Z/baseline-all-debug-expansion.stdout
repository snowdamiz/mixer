        pub fn expire(&self) -> Result<(), mb::Error> {
            self.shared.live()?;
            self.shared.mailbox.expire()
        }
        pub fn usage(&self) -> Result<mb::Usage, mb::Error> {
            self.shared.mailbox.usage()
        }
        pub fn close(&self) -> Result<mb::CloseReport, mb::Error> {
            self.shared.close()
        }
    }
    /// Non-Clone private engine owner; never exposes its privileged Module/Instance.
    pub struct CapabilityGuest {
        instance: Instance,
        shared: Arc<Shared>,
        startup_index: u32,
        wake_index: u32,
        startup_complete: bool,
        limits: GuestLimits,
    }
    fn error(code: &'static str, message: &'static str) -> Error {
        Error::new(code, message, None, 0)
    }
    fn exported(module: &Module, name: &str, void: bool)
        -> Result<u32, Error> {
        let (kind, index) =
            module.exports.get(name).copied().ok_or_else(||
                        {
                            error("capability_export",
                                "required capability guest export is missing")
                        })?;
        let signature =
            module.signature(index).ok_or_else(||
                        error("capability_export",
                            "required export signature is missing"))?;
        if kind != 0 || (index as usize) < module.imports.len() ||
                    !signature.params.is_empty() ||
                (void && signature.result.is_some()) {
            return Err(error("capability_export",
                        "required export must be a defined no-argument function with the exact result"));
        }
        Ok(index)
    }
    impl CapabilityGuest {
        pub fn new(wasm: &[u8], vm: Limits, mailbox: mb::Limits,
            guest: GuestLimits, installed_startup_export: &str)
            -> Result<Self, Error> {
            let (module, startup_index, wake_index) =
                Self::validated(wasm, &vm, &mailbox, guest,
                        installed_startup_export)?;
            let instance = Instance::new_capability(module, vm)?;
            let shared =
                Arc::new(Shared {
                        mailbox: mb::Mailbox::new(mailbox).map_err(|e|
                                    {
                                        if e == mb::Error::InvalidLimits {
                                            error("invalid_limits", "invalid capability mailbox limits")
                                        } else { mailbox_trap(e, None, 0) }
                                    })?,
                        cancellation: instance.cancellation(),
                        closed: AtomicBool::new(false),
                    });
            Ok(Self {
                    instance,
                    shared,
                    startup_index,
                    wake_index,
                    startup_complete: false,
                    limits: guest,
                })
        }
        fn validated(wasm: &[u8], vm: &Limits, mailbox: &mb::Limits,
            guest: GuestLimits, installed_startup_export: &str)
            -> Result<(Module, u32, u32), Error> {
            if vm.profile != Profile::TableMemoryV3 ||
                        guest.turn_milliseconds == 0 || guest.turn_milliseconds > 50
                {
                return Err(error("invalid_limits",
                            "capability guest requires v3 grammar and a1..50ms turn ceiling"));
            }
            if mailbox.maximum_requests == 0 ||
                                    mailbox.maximum_requests > mb::MAX_REQUESTS ||
                                mailbox.reservation_bytes == 0 ||
                            mailbox.reservation_bytes > mb::MAX_RESERVATION_BYTES ||
                        mailbox.timeout_milliseconds == 0 ||
                    mailbox.timeout_milliseconds > mb::MAX_TIMEOUT_MILLISECONDS
                {
                return Err(error("invalid_limits",
                            "invalid capability mailbox limits"));
            }
            if installed_startup_export.is_empty() ||
                    installed_startup_export.len() > 4096 {
                return Err(error("capability_export",
                            "invalid installed startup export"));
            }
            let module = Module::decode_capability(wasm, vm)?;
            let startup_index =
                exported(&module, installed_startup_export, false)?;
            let wake_index = exported(&module, WAKE_EXPORT, true)?;
            Ok((module, startup_index, wake_index))
        }
        /// Exact constructor validation, with no instance linear memory/owner/startup.
        pub(crate) fn validate_only(wasm: &[u8], vm: &Limits,
            mailbox: &mb::Limits, guest: GuestLimits, startup: &str)
            -> Result<(), Error> {
            Self::validated(wasm, vm, mailbox, guest, startup).map(|_| ())
        }
        /// Complete capability validation followed by the fixed guest-UI signatures.
        /// The returned validated module is inspected directly, never instantiated or
        /// decoded a second time. This path has no mailbox or registry interaction.
        pub(crate) fn validate_guest_ui_only(wasm: &[u8], vm: &Limits,
            mailbox: &mb::Limits, guest: GuestLimits) -> Result<(), Error> {
            const START: &str = "mixer_guest_ui_start_v1";
            const EVENT: &str = "mixer_guest_ui_event_v1";
            let (module, _, _) =
                Self::validated(wasm, vm, mailbox, guest, START)?;
            for (name, params, result) in
                [(START, &[][..], Some(Type::I32)),
                        (EVENT, &[Type::I32][..], Some(Type::I32)),
                        (WAKE_EXPORT, &[][..], None)] {
                let valid =
                    module.exports.get(name).is_some_and(|&(kind, index)|
                            {
                                kind == 0 && index as usize >= module.imports.len() &&
                                    module.signature(index).is_some_and(|signature|
                                            {
                                                signature.params == params && signature.result == result
                                            })
                            });
                if !valid {
                    return Err(error("capability_export",
                                "required guest UI export must be a defined function with the exact signature"));
                }
            }
            Ok(())
        }
        pub(crate) fn write_memory(&mut self, offset: u32, source: &[u8])
            -> Result<(), Error> {
            self.live()?;
            self.instance.write_memory(offset, source)
        }
        pub fn native_port(&self) -> CapabilityPort {
            CapabilityPort { shared: Arc::clone(&self.shared) }
        }
        pub fn cancellation(&self) -> Cancellation {
            self.instance.cancellation()
        }
        pub fn memory(&self) -> &[u8] { self.instance.memory() }
        pub fn fuel_remaining(&self) -> u64 { self.instance.fuel_remaining }
        pub fn host_calls_used(&self) -> u64 { self.instance.host_calls_used }
        fn live(&self) -> Result<(), Error> {
            if self.shared.closed.load(Ordering::Acquire) ||
                    self.shared.cancellation.is_cancelled() {
                self.shared.close_without_unwind();
                return Err(error("capability_closed",
                            "capability guest is permanently closed"));
            }
            Ok(())
        }
        pub fn startup(&mut self) -> Result<Option<Value>, Error> {
            self.live()?;
            if self.startup_complete {
                return Err(error("capability_state",
                            "startup already completed"));
            }
            let result = self.run(Some(self.startup_index), None, &[])?;
            self.startup_complete = true;
            Ok(result)
        }
        pub fn enable_effects(&mut self) -> Result<(), Error> {
            self.live()?;
            if !self.startup_complete {
                return Err(error("capability_state",
                            "startup must finish before enabling effects"));
            }
            if let Err(e) = self.shared.mailbox.enable() {
                self.shared.close_without_unwind();
                return Err(mailbox_trap(e, None, 0));
            }
            Ok(())
        }
        pub fn invoke(&mut self, export: &str, args: &[Value])
            -> Result<Option<Value>, Error> {
            self.live()?;
            if !self.startup_complete {
                return Err(error("capability_state",
                            "startup must finish before ordinary turns"));
            }
            self.run(None, Some(export), args)
        }
        pub fn wake_once(&mut self) -> Result<bool, Error> {
            self.live()?;
            if !self.startup_complete {
                return Err(error("capability_state",
                            "startup must finish before wake"));
            }
            match self.shared.mailbox.guest_ready() {
                Ok(false) => Ok(false),
                Ok(true) => {
                    self.run(Some(self.wake_index), None, &[])?;
                    Ok(true)
                }
                Err(e) => {
                    self.shared.close_without_unwind();
                    Err(mailbox_trap(e, None, 0))
                }
            }
        }
        pub fn close(&mut self) -> Result<mb::CloseReport, Error> {
            self.shared.close().map_err(|e| mailbox_trap(e, None, 0))
        }
        fn run(&mut self, index: Option<u32>, export: Option<&str>,
            args: &[Value]) -> Result<Option<Value>, Error> {
            let shared = Arc::clone(&self.shared);
            let turn =
                match shared.mailbox.begin_turn() {
                    Ok(turn) => turn,
                    Err(e) => {
                        shared.close_without_unwind();
                        return Err(mailbox_trap(e, None, 0));
                    }
                };
            let mut guard = TurnGuard { shared: &shared, finished: false };
            let deadline =
                Instant::now().checked_add(Duration::from_millis(self.limits.turn_milliseconds
                                    as
                                    u64)).ok_or_else(||
                            error("invalid_limits", "turn deadline overflow"))?;
            let imports = GuestImports { shared: &shared, turn, deadline };
            let result =
                match index {
                    Some(index) =>
                        self.instance.invoke_capability(index, args, &imports),
                    None =>
                        self.instance.invoke_capability_export(export.expect("private entry selection"),
                            args, &imports),
                };
            let result =
                result.and_then(|value|
                        {
                            imports.check_boundary(None, 0)?;
                            shared.mailbox.finish_turn(turn,
                                        mb::TurnOutcome::Success).map_err(|e|
                                        mailbox_trap(e, None, 0))?;
                            Ok(value)
                        });
            if result.is_ok() { guard.finished = true; }
            result
        }
    }
    impl Drop for CapabilityGuest {
        fn drop(&mut self) { self.shared.close_without_unwind(); }
    }
    struct TurnGuard<'a> {
        shared: &'a Shared,
        finished: bool,
    }
    impl Drop for TurnGuard<'_> {
        fn drop(&mut self) {
            if !self.finished { self.shared.close_without_unwind(); }
        }
    }
    pub(crate) fn allowed_import(import: &Import, sig: &Signature) -> bool {
        if import.module != IMPORT_MODULE || sig.result != Some(Type::I32) {
            return false;
        }
        match import.name.as_str() {
            "http_request" | "storage_get" | "storage_put" | "storage_delete"
                => {
                sig.params == [Type::I32, Type::I32, Type::I32]
            }
            "cancel" => sig.params == [Type::I64],
            "poll" =>
                sig.params == [Type::I64, Type::I32, Type::I32, Type::I32],
            _ => false,
        }
    }
    pub(crate) fn fixed_terminal(operation: mb::Operation,
        failure: mb::FailureCode) -> &'static [u8] {
        fixed::terminal(operation, failure)
    }
    fn mailbox_trap(e: mb::Error, function: Option<u32>, offset: usize)
        -> Error {
        let (code, message) =
            match e {
                mb::Error::AllocationFailure =>
                    ("capability_allocation",
                        "capability payload allocation failed"),
                mb::Error::IdentifierExhausted =>
                    ("capability_identifier_exhausted",
                        "capability identity exhausted"),
                mb::Error::Poisoned =>
                    ("capability_poisoned", "capability mailbox is poisoned"),
                _ =>
                    ("capability_protocol",
                        "capability mailbox transition failed"),
            };
        Error::new(code, message, function, offset)
    }
    pub(crate) struct GuestImports<'a> {
        shared: &'a Shared,
        turn: mb::TurnId,
        deadline: Instant,
    }
    impl GuestImports<'_> {
        pub(crate) fn check(&self, function: u32, offset: usize)
            -> Result<(), Error> {
            self.check_boundary(Some(function), offset)
        }
        fn check_boundary(&self, function: Option<u32>, offset: usize)
            -> Result<(), Error> {
            if self.shared.closed.load(Ordering::Acquire) ||
                    self.shared.cancellation.is_cancelled() {
                return Err(Error::new("cancelled",
                            "capability guest execution cancelled", function, offset));
            }
            if Instant::now() >= self.deadline {
                return Err(Error::new("capability_turn_timeout",
                            "cooperative capability guest turn deadline exceeded",
                            function, offset));
            }
            Ok(())
        }
        pub(crate) fn import(&self, name: &str, args: &[Value],
            memory: &mut [u8], fuel: &mut u64, caller: u32, offset: usize)
            -> Result<Option<Value>, Error> {
            let mut budget =
                GuestBudget { fuel, imports: self, caller, offset };
            let status =
                match name {
                    "http_request" | "storage_get" | "storage_put" |
                        "storage_delete" => {
                        let start = i32arg(args, 0);
                        let len = i32arg(args, 1) as usize;
                        let token = i32arg(args, 2);
                        let Some(input) =
                            range(start, len,
                                    memory.len()).filter(|_|
                                    (1..=mb::MAX_PAYLOAD_BYTES).contains(&len)) else {
                                return Ok(Some(Value::I32(3)));
                            };
                        let Some(output) =
                            range(token, 8,
                                memory.len()) else { return Ok(Some(Value::I32(3))); };
                        if overlap(&input, &output) {
                            return Ok(Some(Value::I32(3)));
                        }
                        let operation =
                            match name {
                                "http_request" => mb::Operation::HttpRequest,
                                "storage_get" => mb::Operation::Get,
                                "storage_put" => mb::Operation::Put,
                                _ => mb::Operation::Delete,
                            };
                        let (arguments, token_output) =
                            if input.end <= output.start {
                                let (a, b) = memory.split_at_mut(output.start);
                                (&a[input], &mut b[..8])
                            } else {
                                let (a, b) = memory.split_at_mut(input.start);
                                (&b[..len], &mut a[output])
                            };
                        self.shared.mailbox.guest_enqueue(self.turn, operation,
                                arguments, token_output, &mut budget)?
                    }
                    "cancel" =>
                        match self.shared.mailbox.guest_cancel(i64arg(args, 0)) {
                            Ok(()) => 0,
                            Err(e) => budget.status(e)?,
                        },
                    "poll" => {
                        let capacity = i32arg(args, 2) as usize;
                        let Some(output) =
                            range(i32arg(args, 1), capacity,
                                    memory.len()).filter(|_|
                                    capacity <=
                                        mb::MAX_PAYLOAD_BYTES) else {
                                return Ok(Some(Value::I32(3)));
                            };
                        let Some(length) =
                            range(i32arg(args, 3), 4,
                                memory.len()) else { return Ok(Some(Value::I32(3))); };
                        if overlap(&output, &length) {
                            return Ok(Some(Value::I32(3)));
                        }
                        self.shared.mailbox.guest_poll(i64arg(args, 0), memory,
                                output, length, &mut budget)?
                    }
                    _ => {
                        return Err(Error::new("unsupported",
                                    "unknown capability import", Some(caller), offset))
                    }
                };
            Ok(Some(Value::I32(status as i32)))
        }
    }
    fn i32arg(args: &[Value], index: usize) -> u32 {
        match args[index] {
            Value::I32(n) => n as u32,
            _ => {
                ::core::panicking::panic_fmt(format_args!("internal error: entered unreachable code: {0}",
                        format_args!("validated capability i32")));
            }
        }
    }
    fn i64arg(args: &[Value], index: usize) -> u64 {
        match args[index] {
            Value::I64(n) => n as u64,
            _ => {
                ::core::panicking::panic_fmt(format_args!("internal error: entered unreachable code: {0}",
                        format_args!("validated capability i64")));
            }
        }
    }
    fn range(start: u32, len: usize, total: usize)
        -> Option<std::ops::Range<usize>> {
        let start = start as usize;
        let end = start.checked_add(len).filter(|n| *n <= total)?;
        Some(start..end)
    }
    fn overlap(a: &std::ops::Range<usize>, b: &std::ops::Range<usize>)
        -> bool {
        !a.is_empty() && !b.is_empty() && a.start < b.end && b.start < a.end
    }
    pub(crate) struct GuestBudget<'a> {
        fuel: &'a mut u64,
        imports: &'a GuestImports<'a>,
        caller: u32,
        offset: usize,
    }
    impl GuestBudget<'_> {
        pub(crate) fn charge(&mut self, bytes: usize) -> Result<(), Error> {
            self.imports.check(self.caller, self.offset)?;
            let extra = bytes.div_ceil(64) as u64;
            if *self.fuel < extra {
                *self.fuel = 0;
                return Err(Error::new("fuel_exhausted",
                            "capability byte fuel exhausted before mutation",
                            Some(self.caller), self.offset));
            }
            *self.fuel -= extra;
            Ok(())
        }
        pub(crate) fn trap(&self, e: mb::Error) -> Error {
            mailbox_trap(e, Some(self.caller), self.offset)
        }
        pub(crate) fn status(&self, e: mb::Error) -> Result<u32, Error> {
            Ok(match e {
                    mb::Error::InvalidArguments => 3,
                    mb::Error::StaleRequest => 4,
                    mb::Error::QuotaExceeded => 5,
                    mb::Error::SessionClosed => 6,
                    mb::Error::AlreadyTerminal => 7,
                    _ => return Err(self.trap(e)),
                })
        }
    }
}
