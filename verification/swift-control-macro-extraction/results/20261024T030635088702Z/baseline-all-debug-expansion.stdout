                Some(SignatureView {
                        params: self.metadata.params(signature),
                        result: signature.result,
                    })
            }
            pub(super) fn execution_type(&self, index: u32)
                -> Option<SignatureView<'_>> {
                let signature =
                    *self.metadata.signatures.get(index as usize)?;
                Some(SignatureView {
                        params: self.metadata.params(signature),
                        result: signature.result,
                    })
            }
            pub(super) fn execution_import(&self, function: u32)
                -> Option<ImportView<'_>> {
                let import = self.metadata.imports.get(function as usize)?;
                Some(ImportView {
                        module: import.module.slice(&self.source),
                        name: import.name.slice(&self.source),
                    })
            }
            /// The execution owner charges bounded scan work before calling this lookup.
            pub(super) fn execution_export(&self, name: &str)
                -> Option<(u8, u32)> {
                self.metadata.exports.as_slice().iter().find(|export|
                            export.name.slice(&self.source) ==
                                name.as_bytes()).map(|export| (export.kind, export.index))
