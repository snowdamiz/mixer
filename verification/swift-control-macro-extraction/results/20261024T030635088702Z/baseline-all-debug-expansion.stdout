            for patch in patches {
                meter.work(1)?;
                *patch = decode::EMPTY_PATCH;
            }
            Ok(())
        }
        impl CacheMode for SwiftMode {
            type Snapshot = ValidatedSwiftReactor;
            type Slot = SwiftSlot;
            type Resident = SwiftResident;
            type Pin = SwiftFunctionPin;
            type Usage = SwiftCacheUsage;
            type Failure = SwiftRunFailure;
            type Operation<'a> = CacheControl<'a>;
            type Meter<'a, 'op> = SwiftMeter<'a, 'op> where 'op: 'a;
            type Scratch<'a> = &'a mut [decode::Patch];
            fn meter<'a,
                'op>(usage: &'a mut SwiftCacheUsage,
                operation: &'a mut CacheControl<'op>, function: u32)
                -> SwiftMeter<'a, 'op> where 'op: 'a {
                operation.cursor =
                    Cursor {
                        stage: SwiftRunStage::Cache,
                        function: Some(function),
                        offset: Some(0),
                    };
                SwiftMeter { operation, usage }
            }
            fn scan(snapshot: &ValidatedSwiftReactor,
                body: FunctionSpanView<'_>,
                scratch: &mut &mut [decode::Patch],
                meter: &mut SwiftMeter<'_, '_>)
                -> Result<decode::Counts, SwiftRunFailure> {
                let policy = policy(snapshot, body, meter)?;
                meter.step(CacheStep::ScanReset);
                reset(scratch, meter)?;
                meter.step(CacheStep::Scan);
                let mut depth = 0;
                let mut counts = decode::Counts::default();
                decode::scan_borrowed(body.body, body.body_offset, &policy,
                    meter,
                    decode::PassParts {
                        controls: scratch,
                        depth: &mut depth,
                        counts: &mut counts,
                    }, None)
            }
            fn build(snapshot: &ValidatedSwiftReactor,
                body: FunctionSpanView<'_>, counts: decode::Counts,
                scratch: &mut &mut [decode::Patch],
                meter: &mut SwiftMeter<'_, '_>)
                -> Result<SwiftResident, SwiftRunFailure> {
                let bytes = counts.bytes(meter)?;
                checkpoint(meter.operation.control, meter.operation.cursor);
                let ticket =
                    meter.operation.control.admit_cache_entry_with_wasi(bytes,
                            meter.operation.cursor, meter.operation.observation())?;
                checkpoint(meter.operation.control, meter.operation.cursor);
                if let Err(error) =
                        meter.operation.control.add_live_with_wasi(Live::CacheEntries,
                            1, meter.operation.cursor, meter.operation.observation()) {
                    let _ = meter.operation.drop_reserved((), ticket);
                    return Err(error);
                }
                let result =
                    Self::build_payload(snapshot, body, counts, scratch, meter);
                match result {
                    Ok(decoded) => Ok(SwiftResident { decoded, ticket }),
                    Err(error) => {
                        let _ = meter.operation.drop_reserved((), ticket);
                        let _ = meter.operation.remove_live(Live::CacheEntries);
                        Err(error)
                    }
                }
            }
            fn drop_entry(entry: SwiftResident,
                meter: &mut SwiftMeter<'_, '_>)
                -> Result<(), SwiftRunFailure> {
                let dropped =
                    meter.operation.drop_reserved(entry.decoded, entry.ticket);
                let removed = meter.operation.remove_live(Live::CacheEntries);
                dropped.and(removed)
            }
        }
