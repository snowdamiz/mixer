            fn build_payload(snapshot: &ValidatedSwiftReactor,
                body: FunctionSpanView<'_>, counts: decode::Counts,
                scratch: &mut &mut [decode::Patch],
                meter: &mut SwiftMeter<'_, '_>)
                -> Result<DecodedFunction, SwiftRunFailure> {
                let policy = policy(snapshot, body, meter)?;
                meter.step(CacheStep::BuildReset);
                reset(scratch, meter)?;
                meter.step(CacheStep::Build);
                let mut depth = 0;
                let mut actual = decode::Counts::default();
                decode::build_borrowed(body.body, body.body_offset,
                    body.type_index, body.absolute_index, &policy, counts,
                    meter,
                    decode::PassParts {
                        controls: scratch,
                        depth: &mut depth,
                        counts: &mut actual,
                    })
            }
        }
