  "findingCount": 1,
  "findings": [
    {
      "id": "R2240-F2",
      "priority": "P2",
      "title": "Preserve the accepted state when reselecting the same created build",
      "sourcePath": "console/src/state/build-selection-controller.ts",
      "line": 344,
      "relatedLines": [
        265,
        268,
        280,
        281
      ],
      "frozenAfterimage": "verification/local/console-build-submit-r2212/afterimages/console/src/state/build-selection-controller.ts",
      "trigger": "Create a build, accept exact detail Failed revision4 while its actual catalog row remains Queued revision1, click that same row, then receive an otherwise valid Succeeded revision4 detail for identical eight-field identity and unchanged session.",
      "observed": "Selected panel changes from Compilation failed to Succeeded / This platform build completed successfully.",
      "cause": "selectBuild retains previous.revision for the same selection but omits previous.committedState from loadDetail. loadDetail overwrites selected without it; its equal-revision coherence guard is conditional on row.committedState being present.",
      "impact": "A contradictory same-revision response can replace an accepted terminal failure with false success without any selection/session reset. This bypasses the new creation-receipt/detail coherence safeguard.",
      "reproduction": "One focused invocation of src/r2240-adversarial.test.mjs, test R2240-F2; fails its expected no-false-success assertion.",
      "suggestedFix": "Carry the accepted committedState with the revision when the immutable selection is unchanged; permit a new floor only at a genuine selection/workspace/session reset. Add this observed component case to producer tests.",
      "producerEdited": false
    }
  ],
