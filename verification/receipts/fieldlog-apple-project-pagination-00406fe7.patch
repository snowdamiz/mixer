+
+private struct ProjectListPagination {
+  typealias Page = (projects: ArraySlice<Project>, count: Int, index: Int, lastIndex: Int)
+
+  private static let pageSize = 20
+  var index = 0
+  var search = "" {
+    didSet {
+      if search != oldValue { index = 0 }
+    }
+  }
+
+  mutating func clamp(to lastIndex: Int) {
+    index = min(index, lastIndex)
+  }
+
+  func page(in workspace: Workspace) -> Page {
+    let matches = workspace.matchingProjects(search)
+    let lastIndex = max(0, matches.count - 1) / Self.pageSize
+    let index = min(self.index, lastIndex)
+    let start = index * Self.pageSize
+    return (matches[start..<min(start + Self.pageSize, matches.count)], matches.count, index, lastIndex)
   }
 }
