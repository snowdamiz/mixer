  "reproduction": {
    "prepare": "python3 \"$MIXER/tests/integration/fieldlog-pair25-android/rust-runtime-notices/prepare-successor.py\" --mixer \"$MIXER\" \"$SCRATCH/work\"",
    "inputs": "Set MIXER to the supplied read-only object source, PUBLIC_REV to mixerPublicRevision and SCRATCH to a newly owned directory. Ensure the prepare script and its sibling fieldlog-packaging.patch are the pinned Git blobs. For each orderedBasePatches item, use git -C \"$MIXER\" show \"$PUBLIC_REV:$path\" to materialize it and git -C \"$SCRATCH/work/fieldlog\" apply --index --unidiff-zero --whitespace=error \"$patch\". Confirm write-tree equals each afterTree in order. Apply the delivery patch with the same flags and confirm afterTree.",
    "host": "With TMPDIR in owned scratch, run bash \"$SCRATCH/work/fieldlog/ios/FieldLogTests/run-settings-host.sh\" --jobs 6 as an ordinary macOS user.",
    "iphoneOSPreparation": "Copy the stock work/mixer/sdk/Package.resolved into the private FieldLog Xcode workspace SwiftPM lock. Present the two exact pinned dependency commits via local bare mirrors tagged with their pinned versions and process-local Git insteadOf rules. Set GIT_ALLOW_PROTOCOL=file for the build. Keep TMPDIR, CFFIXED_USER_HOME, XDG_CACHE_HOME and CLANG_MODULE_CACHE_PATH inside owned scratch.",
    "iphoneOSScript": [
      "#!/bin/bash",
      "set -euo pipefail",
      "work=\"$(cd \"$(dirname \"$0\")\" && pwd)/work\"",
      "mkdir -p \"$work\"/{tmp,home,clang,vm-ios,mirrors}",
      "export TMPDIR=\"$work/tmp\"",
      "export CFFIXED_USER_HOME=\"$work/home\"",
      "export XDG_CACHE_HOME=\"$work/home/xdg\"",
      "export CLANG_MODULE_CACHE_PATH=\"$work/clang\"",
      "export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null",
      "export GIT_TERMINAL_PROMPT=0 GIT_ALLOW_PROTOCOL=file",
      "export PATH=\"$HOME/.rustup/toolchains/1.99.0-aarch64-apple-darwin/bin:$PATH\"",
      "",
      "for package in swift-crypto swift-asn1; do",
      "  case \"$package\" in",
      "    swift-crypto) revision=c2cbadd7263439d8015189668f96ff5b5be565ce; version=5.0.3; slot=0; cached=swift-crypto-7e0614ea;;",
      "    swift-asn1) revision=3b6410f7dee09eb33cdd26260c5fd47fda19b0e2; version=1.7.3; slot=1; cached=swift-asn1-7065ad2c;;",
      "  esac",
      "  cache=\"$HOME/Library/Caches/org.swift.swiftpm/repositories/$cached\"",
      "  mirror=\"$work/mirrors/$package.git\"",
      "  git init --quiet --bare \"$mirror\"",
      "  git --git-dir=\"$mirror\" fetch --quiet --no-tags --depth=1 \"file://$cache\" \"$revision\"",
      "  test \"$(git --git-dir=\"$mirror\" rev-parse FETCH_HEAD)\" = \"$revision\"",
      "  git --git-dir=\"$mirror\" update-ref \"refs/heads/pinned\" \"$revision\"",
      "  git --git-dir=\"$mirror\" update-ref \"refs/tags/$version\" \"$revision\"",
      "  git --git-dir=\"$mirror\" symbolic-ref HEAD refs/heads/pinned",
      "  export \"GIT_CONFIG_KEY_$slot=url.file://$mirror.insteadOf\"",
      "  export \"GIT_CONFIG_VALUE_$slot=https://github.com/apple/$package.git\"",
      "done",
      "export GIT_CONFIG_COUNT=2",
      "",
      "cargo build --manifest-path \"$work/mixer/vm/Cargo.toml\" --offline --locked --release \\",
      "  --features experimental-capability-native --lib --target aarch64-apple-ios \\",
      "  --target-dir \"$work/cargo\" --jobs 6",
      "cp \"$work/cargo/aarch64-apple-ios/release/libmixer_vm.a\" \"$work/vm-ios/libmixer_vm_capability_experimental.a\"",
      "",
      "xcodebuild -project \"$work/fieldlog/ios/FieldLog.xcodeproj\" -scheme FieldLog -configuration Debug \\",
      "  -sdk iphoneos -destination 'generic/platform=iOS' -derivedDataPath \"$work/derived\" \\",
      "  -clonedSourcePackagesDirPath \"$work/packages\" -packageCachePath \"$work/package-cache\" \\",
      "  -resultBundlePath \"$work/iphoneos-final.xcresult\" -scmProvider system -disablePackageRepositoryCache \\",
      "  -skipPackageUpdates -disableAutomaticPackageResolution -onlyUsePackageVersionsFromResolvedFile \\",
      "  -jobs 6 CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO ARCHS=arm64 ONLY_ACTIVE_ARCH=NO \\",
      "  COMPILER_INDEX_STORE_ENABLE=NO ENABLE_DEBUG_DYLIB=NO LD_GENERATE_MAP_FILE=YES \\",
      "  \"LIBRARY_SEARCH_PATHS=\\$(inherited) $work/vm-ios\" \\",
      "  \"HEADER_SEARCH_PATHS=\\$(inherited) $work/mixer/vm/include\" \\",
      "  \"OTHER_SWIFT_FLAGS=\\$(inherited) -Xcc -I$work/mixer/vm/include\" build"
    ],
    "installedAcceptance": "From a saved project/entry, use Settings to select Dark, French (France) and Larger. Return to On device and the saved entry, reopen the editor and verify the scheme, date display and text. Verify a higher OS text setting wins. Relaunch, confirm persisted choices, reset to System and confirm saved data, navigation and queue survive. Confirm the diagnostics section contains only the five labeled values."
