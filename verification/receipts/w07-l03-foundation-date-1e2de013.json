  "proposedMatrixRows": [
    {
      "feature": "Foundation.Date.init(timeIntervalSince1970:)",
      "label": "native supported",
      "scope": "On arm64 macOS with Swift 6.3.3, native readback to the Foundation reference date matches four fixed Unix timestamps covering a pre-epoch fraction, Unix zero, Foundation reference-date zero, and a later fraction. Embedded Swift 6.3.3 for wasm32-unknown-none-wasm refuses Foundation import at Epoch.swift:1:8 before object emission.",
      "positive": [
        "epoch-ordered",
        "epoch-reordered"
      ],
      "negativeOrEdge": [
        "epoch-embedded",
        "foundation-free-embedded"
      ]
    },
    {
      "feature": "Foundation.Date.FormatStyle.format(_:) — abbreviated month and day",
      "label": "native supported",
      "scope": "The date style in ordinary FieldLog e39a5ea3, ios/FieldLog/ProjectDetail.swift:128, produced Jan 1, 1 janv., Dec 31, and Mar 5 with explicit Gregorian calendar, en_US or fr_FR, and UTC or UTC−08:00 on arm64 macOS. Embedded Swift 6.3.3 for wasm32-unknown-none-wasm refuses Foundation import at Presentation.swift:1:8 before object emission.",
      "positive": [
        "presentation-ordered",
        "presentation-reordered"
      ],
      "negativeOrEdge": [
        "presentation-embedded",
        "foundation-free-embedded"
      ]
    }
  ]
}
