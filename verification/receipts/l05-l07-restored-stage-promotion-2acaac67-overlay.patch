+  @tag capture_log: true
+  test "commits a new paired promotion on the restored ordinary database" do
+    phase = System.fetch_env!("MIXER_RESTORED_WRITE_PHASE")
+    bundle = System.fetch_env!("MIXER_RESTORED_WRITE_BUNDLE")
+    c = prepare_release_fixture!("restored-write")
+
+    if phase == "source" do
+      provision!()
+      provision_delivery!()
+      provision_cli!()
+      provision_actions!()
+      provision_halt_audit!()
+      provision_details!()
+    end
+
+    {source, destination, successor_source, successor} =
+      if phase == "source" do
+        v = vector()
+
+        source = %{
+          ios: variant(v, "ios", "development", "internal", 7),
+          android: variant(v, "android", "development", "internal", 9)
+        }
+
+        destination = %{
+          ios: variant(v, "ios", "staging", "candidate", 3),
+          android: variant(v, "android", "staging", "candidate", 12)
+        }
+
+        next = fn variants ->
+          Map.new(variants, fn {platform, value} ->
+            release =
+              value
+              |> update_in([:manifest, "release_id"], fn _ -> "fixture-restored-successor" end)
+              |> update_in([:manifest, "source_commit"], fn _ -> String.duplicate("b", 40) end)
+              |> update_in([:assignment, "sequence"], &(&1 + 1))
+              |> MixerHosted.Test.StagePromotionSigningFixture.with_payload(
+                value.payload <> "-successor"
+              )
+
+            {platform, release}
+          end)
+        end
+
+        values = {source, destination, next.(source), next.(destination)}
+        File.write!(bundle, :erlang.term_to_binary(values), [:exclusive])
+        values
+      else
+        assert phase == "target"
+        :erlang.binary_to_term(File.read!(bundle))
+      end
+
+    direction = %Direction{
+      source: Map.new(source, fn {platform, value} -> {platform, value.enrollment} end),
+      destination: Map.new(destination, fn {platform, value} -> {platform, value.enrollment} end)
+    }
+
+    if phase == "source" do
+      seed_target!(source.ios.enrollment.target)
+      provision_release_jobs!()
+      provision_stage_promotion!()
+      provision_stage_promotion_read!()
+
+      for value <- [source.android, destination.ios, destination.android],
+          do: seed_head!(value.enrollment.target)
+      seed_stage_direction!(direction)
+    end
+
+    c = put_in(c.hosted.local_release_jobs, true)
+
+    env = %{
+      "MIXER_LOCAL_RELEASE_CONFIG" => Jason.encode!(release_provisioning(source.ios.enrollment)),
+      "MIXER_LOCAL_RELEASE_TARGET_REGISTRY" =>
+        Jason.encode!(
+          Enum.map([source.android, destination.ios, destination.android], fn value ->
+            release_provisioning(value.enrollment)
+          end)
+        ),
+      "MIXER_LOCAL_RELEASE_DELIVERY_PASSWORD" => "fixture-stage-delivery",
+      "MIXER_LOCAL_RELEASE_WRITER_ENABLED" => "true",
+      "MIXER_LOCAL_STAGE_PROMOTION_DIRECTIONS" =>
+        Jason.encode!([
+          %{
+            direction_id: @promotion_direction,
+            source:
+              Map.new(direction.source, fn {platform, entry} ->
+                {platform, Target.wire(entry.target)}
+              end),
+            destination:
+              Map.new(direction.destination, fn {platform, entry} ->
+                {platform, Target.wire(entry.target)}
+              end)
+          }
+        ])
+    }
+
+    {default, _delivery} = provisioning = RuntimeProvisioning.load!(env, c.hosted)
+    writer = RuntimeProvisioning.writer_options!(env, c.hosted, provisioning)
+    directions = RuntimeProvisioning.stage_promotion_directions!(env, provisioning, writer)
+    assert directions == %{@promotion_direction => direction}
+
+    replace_config!(WriterRepo, writer)
+    replace_config!(:local_release_target, default)
+    replace_config!(:local_stage_promotion_directions, directions)
+    c = start!(c)
+    assert %{phase: :storage_ready} = RuntimeOwner.status()
+
+    assert "browser_ordinary_installation_r1422" == Keyword.fetch!(writer, :database)
+    assert "browser_ordinary" == Keyword.fetch!(writer, :username)
+
+    assert [["browser_ordinary", "browser_ordinary", false, false]] =
+             Ecto.Adapters.SQL.query!(WriterRepo, """
+             SELECT current_user::text, session_user::text, rolsuper, rolbypassrls
+             FROM pg_roles WHERE rolname=current_user
+             """, []).rows
+
+    owner = login(c)
+    token = access_token!(c, owner)
+    key = if phase == "source", do: "restore-baseline-pair", else: "restore-successor-pair"
+
+    if phase == "source" do
+      uploader = upload_identity!(c, login(c, :artifact_uploader))
+
+      for {label, group} <- [
+            {"old-development", source}, {"old-staging", destination},
+            {"new-development", successor_source}, {"new-staging", successor}
+          ], {platform, value} <- group do
+        signed = publication(value)
+
+        envelope = Jason.encode!(%{
+          signed_manifest: Jason.Fragment.new(signed.evidence.signed_manifest_bytes),
+          payload: Base.encode64(signed.evidence.payload)
+        })
+
+        assert {:ok, %{status: 201}} =
+                 upload!(c, uploader, Map.from_struct(value.enrollment), signed.artifact_sha256,
+                   envelope, "#{label}-#{platform}")
+      end
+
+      for {platform, value} <- source do
+        signed = publication(value)
+        config = Map.from_struct(value.enrollment)
+        Application.put_env(:mixer_hosted, :local_release_target, config)
+
+        assert {:ok, %{sequence: sequence}} =
+                 RuntimeOwner.publish_release(owner, config.target,
+                   signed.evidence.signed_assignment_bytes, "baseline-#{platform}", @reason)
+
+        assert sequence == signed.sequence
+      end
+
+      Application.put_env(:mixer_hosted, :local_release_target, default)
+    end
+
+    {from, to} = if phase == "source", do: {source, destination}, else: {successor_source, successor}
+    body = Jason.encode!(%{
+      source_ios_sequence: publication(from.ios).sequence,
+      source_android_sequence: publication(from.android).sequence,
+      ios_signed_assignment: Jason.Fragment.new(spaced_assignment(to.ios)),
+      android_signed_assignment: Jason.Fragment.new(spaced_assignment(to.android))
+    })
+
+    before = restore_write_state()
+    if phase == "target" do
+      assert length(before["binding"]) == 1
+      assert length(before["history"]) == 6
+      assert length(before["jobs"]) == 6
+      assert length(before["artifact_audit"]) == 8
+    end
+
+    request = fn -> promotion_post(c, token, @promotion_path, body, [{"x-mixer-reason", @reason}], key) end
+    response = request.()
+    assert response.status == 200
+    expected = %{
+      "delivery" => "local_only",
+      "ios" => promotion_receipt(to.ios),
+      "android" => promotion_receipt(to.android)
+    }
+    assert Jason.decode!(response.body) == expected
+    assert response_header(response, "cache-control") == ["no-store"]
+
+    committed = restore_write_state()
+    added = fn bucket ->
+      assert before[bucket] -- committed[bucket] == []
+      committed[bucket] -- before[bucket]
+    end
+
+    assert [binding] = added.("binding")
+    assert binding["direction_id"] == @promotion_direction
+    assert binding["idempotency_key"] == key
+    assert binding["principal_id"] == "person-1"
+    assert binding["writer_role"] == "browser_ordinary"
+    assert binding["reason"] == @reason
+    for {field, expected} <- [
+          {"organization_id", "org-a"}, {"project_id", "project-a"}, {"application_id", "fieldlog"},
+          {"source_environment_id", "development"}, {"destination_environment_id", "staging"}
+        ], do: assert(binding[field] == expected)
+
+    assert length(added.("history")) == 2
+    assert length(added.("jobs")) == 2
+    assert added.("artifact_audit") == []
+    assert added.("artifacts") == []
+
+    for platform <- [:android, :ios] do
+      platform_name = Atom.to_string(platform)
+      value = to[platform]
+      signed = publication(value)
+      previous = if phase == "source", do: nil, else: publication(destination[platform]).sequence
+      source_signed = publication(from[platform])
+      target = value.enrollment.target
+      filter = Map.new(Target.filter(target), fn {field, item} -> {Atom.to_string(field), item} end)
+      assert [row] = Enum.filter(added.("history"), &(&1["platform"] == platform_name))
+      assert Map.take(row, Map.keys(filter)) == filter
+      assert row["sequence"] == signed.sequence
+      assert row["previous_sequence"] == previous
+      assert row["artifact_sha256"] == signed.artifact_sha256
+      assert row["action"] == "stage_promote"
+      assert row["principal_id"] == "person-1"
+      assert row["reason"] == @reason
+      assert row["idempotency_key"] == key
+      assert binding["source_#{platform}_sequence"] == source_signed.sequence
+      assert binding["source_#{platform}_artifact_sha256"] == source_signed.artifact_sha256
+      assert binding["destination_#{platform}_sequence"] == signed.sequence
+      assert binding["destination_#{platform}_artifact_sha256"] == signed.artifact_sha256
+      assert [job] = Enum.filter(added.("jobs"), &(&1["args"]["platform"] == platform_name))
+      assert job["args"] == Map.merge(filter, %{"version" => 1, "sequence" => Integer.to_string(signed.sequence)})
+      assert [job["queue"], job["worker"], job["state"], job["attempt"]] ==
+               ["releases", "MixerHosted.Releases.ReleaseJobs.Materialize", "available", 0]
+
+      assert %{"kind" => "published", "release" => release, "target" => wire} =
+               read!(c, owner, target, :details_v2)
+      assert wire == string_keys(Target.wire(target))
+      assert release["sequence"] == Integer.to_string(signed.sequence)
+      assert release["releaseId"] == value.manifest["release_id"]
+      assert release["manifestSha256"] == signed.artifact_sha256
+      assert release["details"]["action"] == "stage_promote"
+      assert release["details"]["sourceCommit"] == value.manifest["source_commit"]
+    end
+
+    group = %{
+      "kind" => "committed",
+      "ios" => browser_promotion_receipt(to.ios),
+      "android" => browser_promotion_receipt(to.android)
+    }
+    for value <- Map.values(to),
+      do: assert(read!(c, owner, value.enrollment.target, promotion_view(value)) == group)
+
+    retry = request.()
+    assert retry.status == 200
+    assert retry.body == response.body
+    assert restore_write_state() == committed
+
+    if phase == "source" do
