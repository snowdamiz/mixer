+
+      other = login(c, :other_tenant)
+      for value <- Map.values(to),
+        do: assert_status(c, other, value.enrollment.target, 404, promotion_view(value))
+    end
+
+    evidence = %{
+      phase: phase, status: response.status, receipt: expected, exact_retry_body: true,
+      retry_state_equal: true, binding: binding, publications: added.("history"),
+      jobs: added.("jobs"), group: group, previous_rows_preserved: true,
+      previous_group_read: phase == "target", other_tenant_status: if(phase == "target", do: 404),
+      writer: "browser_ordinary",
+      request_body_sha256: MixerHosted.Test.StagePromotionSigningFixture.digest(body)
+    }
+    File.write!(System.fetch_env!("MIXER_RESTORED_WRITE_RESULT"), Jason.encode!(evidence), [:exclusive])
+  end
