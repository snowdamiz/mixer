+private struct SavedTaskEditor {
+    enum Phase {
+        case editing(failure: String?)
+        case submitted
+        case saving
+    }
+
+    var edit: TaskEdit
+    let workspaceRevision: UInt64
+    var phase: Phase = .editing(failure: nil)
+
+    func document(revision: UInt64) -> UIDocument {
+        let saving: Bool
+        let status: String
+        switch phase {
+        case .editing(let failure):
+            saving = false
+            status = failure ?? ""
+        case .submitted:
+            saving = false
+            status = ""
+        case .saving:
+            saving = true
+            status = "Saving on device…"
+        }
+        return MixerUI.Navigation("task.edit.screen", title: "Edit task") {
+            MixerUI.List("task.edit.form") {
+                MixerUI.Section("task.edit.fields") {
+                    MixerUI.TextField("task.edit.title", "Task", value: edit.text.title,
+                        action: "task.edit.title.change", axis: .vertical)
+                        .accessibilityIdentifier("task-edit-title").disabled(saving)
+                    MixerUI.TextField("task.edit.responsible", "Responsible person (optional)", value: edit.text.responsible,
+                        action: "task.edit.responsible.change")
+                        .accessibilityIdentifier("task-edit-responsible").disabled(saving)
+                    MixerUI.Button("task.edit.save", "Save", action: "task.edit.save")
+                        .accessibilityIdentifier("task-edit-save")
+                        .disabled(saving || edit.text.title.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty)
+                    MixerUI.Button("task.edit.cancel", "Cancel", action: "task.edit.cancel")
+                        .accessibilityIdentifier("task-edit-cancel").disabled(saving)
+                    MixerUI.Text("task.edit.status", status)
