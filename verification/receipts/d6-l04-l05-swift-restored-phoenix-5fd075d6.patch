@@ -0,0 +1,268 @@
+import errno
+import hashlib
+import json
+import os
+from pathlib import Path
+import secrets
+import signal
+import socket
+import time
+
+from supervise import ROOT, TREE, PG, Owned, port, record, run
+
+DB = "browser_ordinary_installation_r1422"
+ADMIN = "swift_restore_bootstrap"
+ROLES = (
+    ADMIN, "browser_admin", "browser_lifecycle", "browser_ordinary",
+    "mixer_release_delivery", "mixer_release_processor", "release_fixture_uploader",
+)
+HOSTED = TREE / "hosted"
+TEST = Path("test/mixer_hosted/releases/browser_publication_test.exs")
+FIXTURE = ROOT / "fixture"
+ENV = {"MIXER_SWIFT_RESTORE_ROOT": str(FIXTURE)}
+REASON = "Restore the signed Swift iOS baseline"
+SQLSTATE = """
+SELECT target.platform, target.runtime_sha256, target.sequence
+FROM public.mixer_release_heads target ORDER BY 1,2;
+SELECT sequence, action, artifact_sha256, encode(signed_assignment_bytes,'hex')
+FROM public.mixer_release_publications ORDER BY sequence;
+SELECT manifest_sha256, payload_sha256, encode(envelope_bytes,'hex'), encode(payload,'hex')
+FROM public.mixer_customer_artifacts ORDER BY manifest_sha256;
+SELECT args->>'sequence', state, attempt
+FROM mixer_release_jobs.oban_jobs ORDER BY 1;
+"""
+
+
+def require(condition, reason):
+    if not condition:
+        raise RuntimeError(reason)
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def listeners_closed(phase, entries):
+    for name, number in entries:
+        with socket.socket() as probe:
+            probe.settimeout(1)
+            require(probe.connect_ex(("127.0.0.1", number)) == errno.ECONNREFUSED,
+                    f"{phase} {name} {number} still accepts TCP")
+        with socket.socket() as listener:
+            listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+            listener.bind(("127.0.0.1", number))
+            listener.listen(1)
+        record("rebinds.jsonl", {"phase": phase, "service": name, "port": number, "refused": True, "rebound": True})
+
+
+class Cluster:
+    def __init__(self, phase):
+        self.phase = phase
+        self.directory = ROOT / phase
+        self.directory.mkdir()
+        self.data = self.directory / "data"
+        self.port = port()
+        self.child = None
+        self.passwords = {role: secrets.token_hex(24) for role in ROLES}
+        self.pgpass = self.directory / "pgpass"
+        self.pgpass.write_text("".join(f"127.0.0.1:{self.port}:*:{r}:{p}\n" for r, p in self.passwords.items()))
+        self.env = {"PGPASSFILE": str(self.pgpass), "PGCONNECT_TIMEOUT": "4"}
+        self.conn = ["-h", "127.0.0.1", "-p", str(self.port), "-U", ADMIN, "-w"]
+
+    def run(self, name, *args, **options):
+        return run(self.phase + "-" + name, *args, env=self.env, **options)
+
+    def sql(self, name, data=None, *, database=DB, path=None):
+        args = [PG / "psql", *self.conn, "-XqAt", "-v", "ON_ERROR_STOP=1", "-d", database]
+        if path is not None:
+            args.extend(["-f", path])
+        else:
+            data = data.encode()
+        return self.run(name, *args, data=data).strip().decode()
+
+    def start(self):
+        secret = self.directory / "init-password"
+        secret.write_text(self.passwords[ADMIN] + "\n")
+        try:
+            self.run("init", PG / "initdb", "-D", self.data, "-U", ADMIN,
+                     "--auth-local=reject", "--auth-host=scram-sha-256", "--pwfile", secret,
+                     "--locale=C", "--encoding=UTF8", "--no-sync")
+        finally:
+            secret.unlink()
+        (self.data / "pg_hba.conf").write_text(
+            "local all all reject\nhost all all 127.0.0.1/32 scram-sha-256\n"
+            "host all all 0.0.0.0/0 reject\nhost all all ::/0 reject\n"
+        )
+        self.child = Owned(self.phase + "-postgres", [
+            PG / "postgres", "-D", self.data, "-h", "127.0.0.1", "-p", self.port, "-k", "",
+            "-c", "password_encryption=scram-sha-256", "-c", "max_connections=32",
+            "-c", "log_min_error_statement=panic", "-c", "timezone=UTC",
+        ], env=self.env)
+        deadline = time.monotonic() + 12
+        while time.monotonic() < deadline and self.child.process.poll() is None:
+            try:
+                state = (self.data / "postmaster.pid").read_text().splitlines()
+                if len(state) >= 8 and (state[0], state[3], state[7].strip()) == (
+                        str(self.child.pid), str(self.port), "ready"):
+                    break
+            except FileNotFoundError:
+                pass
+            time.sleep(.05)
+        else:
+            raise RuntimeError(f"{self.phase} postgres readiness expired")
+        system = self.sql("identity", "SELECT system_identifier FROM pg_control_system()", database="postgres")
+        rules = self.sql("auth-rules", "SELECT type,coalesce(address,'-'),auth_method FROM pg_hba_file_rules", database="postgres")
+        require(rules.splitlines() == ["local|-|reject", "host|127.0.0.1|scram-sha-256",
+                                       "host|0.0.0.0|reject", "host|::|reject"], f"Unexpected HBA {rules}")
+        run(self.phase + "-wrong-password", PG / "psql", *self.conn, "-XqAt", "-d", "postgres",
+            "-c", "SELECT 1", env=self.env | {"PGPASSWORD": secrets.token_hex(24)}, expected=2)
+        require("password authentication failed" in (ROOT / "logs" / (self.phase + "-wrong-password.stderr")).read_text(),
+                "Unexpected wrong-password control")
+        return {"systemIdentifier": system, "wrongPasswordRefused": True, "authRules": rules.splitlines()}
+
+    def set_passwords(self, roles):
+        self.sql("set-role-passwords", "".join(f"ALTER ROLE {r} PASSWORD '{self.passwords[r]}';\n" for r in roles),
+                 database="postgres")
+
+    def verify_scram(self):
+        rows = self.sql("scram-verifiers", """
+          SELECT rolname FROM pg_authid WHERE rolpassword LIKE 'SCRAM-SHA-256$%' ORDER BY rolname
+          """, database="postgres").splitlines()
+        require(rows == sorted(set(ROLES) - {"release_fixture_uploader"}), f"Unexpected SCRAM role set {rows}")
+        return rows
+
+    def fixture(self, fragment, handshakes):
+        lines = (HOSTED / TEST).read_text().splitlines()
+        line = next(i for i, source in enumerate(lines, 1) if f'test "{fragment}' in source)
+        catalog = self.directory / "catalog"
+        catalog.mkdir()
+        listener_file = self.directory / "listeners"
+        child = Owned(self.phase + "-phoenix", [
+            "mix", "test", "--warnings-as-errors", "--trace", "--no-color", "--seed", "0",
+            f"{TEST}:{line}",
+        ], cwd=HOSTED, env=self.env | ENV | {
+            "MIX_ENV": "test", "HEX_OFFLINE": "1", "MIXER_BROWSER_STORAGE_PORT": str(self.port),
+            "MIXER_BROWSER_CATALOG_FIXTURE_ROOT": str(catalog),
+            "MIXER_ROLLBACK_PHASE": self.phase, "MIXER_ROLLBACK_LISTENERS": str(listener_file),
+        } | {"MIXER_ROLLBACK_PASSWORD_" + role: key for role, key in self.passwords.items()})
+        try:
+            for name in handshakes:
+                ready = FIXTURE / (name + ".ready")
+                deadline = time.monotonic() + 35
+                while not ready.exists():
+                    require(child.process.poll() is None and time.monotonic() < deadline,
+                            f"{self.phase} Phoenix failed before rendezvous {name}")
+                    time.sleep(.025)
+                data = json.loads(ready.read_bytes())
+                ready.unlink()
+                if name == "stock-rollback":
+                    self.rollback(data)
+                else:
+                    sequence = name.split("-")[1]
+                    receipt = swift(name, "testOnline", PORT=str(data["port"]), SEQUENCE=sequence)
+                    record("client.jsonl", {"phase": name, "observed": receipt, "delivery": data})
+                (FIXTURE / (name + ".done")).touch(exist_ok=False)
+        finally:
+            try:
+                output = child.finish(26)
+                require("Result: 1 passed" in output.decode(), f"missing ExUnit receipt for {self.phase}")
+            finally:
+                if listener_file.exists() and not (ROOT / "HOLD.jsonl").exists():
+                    pairs = [line.split() for line in listener_file.read_text().splitlines()]
+                    listeners_closed(self.phase, [(name, int(number)) for name, number in pairs])
+
+    def rollback(self, data):
+        packet = json.loads((FIXTURE / "packet.json").read_bytes())
+        release = packet["releases"][2]
+        file = FIXTURE / "rollback.json"
+        file.write_text(release["assignment"])
+        cli = ROOT / "cli/debug/mixer"
+        output = run("stock-rollback", cli, "update", "rollback", release["digest"],
+                     "--reason", REASON, "--channel", "beta", "--organization", "org-a",
+                     "--project", "project-a", "--assignment", file, seconds=15,
+                     env={"MIXER_RELEASE_ORIGIN": f"http://127.0.0.1:{data['port']}",
+                          "MIXER_RELEASE_TOKEN": data["token"]})
+        facts = json.loads(output)
+        require(facts == {"status": "ok", "action": "rollback", "artifact_sha256": release["digest"],
+                          "sequence": 3, "rollout_basis_points": 10000, "delivery": "local_only"},
+                f"Unexpected stock CLI rollback output {facts}")
+        record("client.jsonl", {"phase": "stock-rollback", "cli": facts, "stdoutSha256": sha(output)})
+
+    def close(self):
+        if self.child is None:
+            return
+        self.child.finish(15, stop=signal.SIGINT)
+        require(not (self.data / "postmaster.pid").exists(), f"{self.phase} pidfile remains")
+        listeners_closed(self.phase, [("postgres", self.port)])
+
+
+def swift(name, method, **values):
+    output = run("swift-" + name, XCTEST, "-XCTest", f"MixerCapabilityActivationTests.RestoredPhoenixReleaseTests/{method}",
+                 BUNDLE, seconds=14, env=ENV | {"MIXER_SWIFT_RESTORE_" + key: value for key, value in values.items()})
+    log = (ROOT / "logs" / ("swift-" + name + ".stderr")).read_text()
+    lines = (output.decode() + "\n" + log).splitlines()
+    require(any("Executed 1 test, with 0 failures" in line and "skipped" not in line for line in lines),
+            f"Expected one executed Swift test for {method}")
+    return [line for line in lines if line.startswith("RESTORE ")]
+
+
+def exercise():
+    FIXTURE.mkdir(exist_ok=True)
+    swift("prepare", "testPrepare")
+    dump = ROOT / "source.dump"
+    source = Cluster("source")
+    try:
+        source_facts = source.start()
+        source.sql("bootstrap", """
+            CREATE ROLE browser_admin LOGIN SUPERUSER;
+            CREATE ROLE browser_schema_owner NOLOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT;
+            CREATE ROLE browser_writer NOLOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT;
+            CREATE ROLE browser_lifecycle LOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT;
+            CREATE ROLE browser_ordinary LOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT;
+            CREATE ROLE mixer_customer_build_catalog_definer_v1 NOLOGIN NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE NOREPLICATION NOINHERIT;
+            CREATE DATABASE browser_storage OWNER browser_schema_owner;
+        """, database="postgres")
+        source.set_passwords(["browser_admin", "browser_lifecycle", "browser_ordinary"])
+        source.fixture("publishes the Swift baseline", ["online-1", "online-2"])
+        source_facts["scramRoles"] = source.verify_scram()
+        frozen = source.sql("frozen-state", SQLSTATE)
+        require(source.sql("idle", "SELECT count(*) FROM pg_stat_activity WHERE datname=current_database() AND pid <> pg_backend_pid()") == "0",
+                "source cluster retained fixture sessions")
+        roles = source.run("dump-roles", PG / "pg_dumpall", *source.conn, "--roles-only", "--no-role-passwords")
+        source.run("dump", PG / "pg_dump", *source.conn, "--format=custom", "--create", "--file", dump, DB)
+    finally:
+        source.close()
+
+    restored = Cluster("restore")
+    try:
+        restored_facts = restored.start()
+        require(source_facts["systemIdentifier"] != restored_facts["systemIdentifier"], "duplicate PostgreSQL cluster")
+        creation = f"CREATE ROLE {ADMIN};\n"
+        require(roles.decode().count(creation) == 1, "Missing unique bootstrap role creation")
+        restored.sql("roles", roles.decode().replace(creation, ""), database="postgres")
+        restored.set_passwords(r for r in ROLES if r not in [ADMIN, "release_fixture_uploader"])
+        restored_facts["scramRoles"] = restored.verify_scram()
+        restored.run("load", PG / "pg_restore", *restored.conn, "--exit-on-error", "--create",
+                     "--dbname", "postgres", dump)
+        for name, path in [
+            ("repair-authz", "scripts/restore-local-authz-expiry.sql"),
+            ("repair-artifact-key", "tests/integration/phoenix-release-restore/restore-artifact-key.sql"),
+        ]:
+            restored.sql(name, path=TREE / path)
+        require(restored.sql("restored-state", SQLSTATE) == frozen, "Restore changed committed state")
+        record("postgres.jsonl", {"source": source_facts, "restore": restored_facts,
+            "dumpSha256": sha(dump.read_bytes()), "frozenAndRestoredStateSha256": sha(frozen.encode()),
+            "sourceSessionsAfterShutdown": 0})
+        restored.fixture("commits one stock rollback", ["stock-rollback", "online-3"])
+    finally:
+        restored.close()
+
+    observed = swift("offline", "testOffline")
+    record("client.jsonl", {"phase": "offline", "observed": observed})
+
+
+if __name__ == "__main__":
+    os.umask(0o077)
+    XCTEST = run("xctest-path", "/usr/bin/xcrun", "--find", "xctest").decode().strip()
+    BUNDLE, = (ROOT / "activation/out/Products/Debug").glob("MixerCapabilityActivationTests.xctest")
+    exercise()
