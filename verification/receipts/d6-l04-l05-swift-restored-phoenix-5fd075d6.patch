--- /dev/null
+++ b/capability-activation/Tests/MixerCapabilityActivationTests/RestoredPhoenixReleaseTests.swift
@@ -0,0 +1,237 @@
+import Foundation
+import MixerUpdates
+import XCTest
+@testable import MixerCapabilityActivation
+
+final class RestoredPhoenixReleaseTests: XCTestCase, @unchecked Sendable {
+    private let scope = UpdateScope(organization: "org-a", project: "project-a",
+                                    app: "fieldlog", environment: "development", platform: "ios")
+    private let installation = "swift-restore-ios"
+
+    private func environment(_ name: String) throws -> String {
+        try XCTUnwrap(ProcessInfo.processInfo.environment["MIXER_SWIFT_RESTORE_" + name])
+    }
+
+    private func fixture() throws -> ColdStartFixture {
+        guard let root = ProcessInfo.processInfo.environment["MIXER_SWIFT_RESTORE_ROOT"] else {
+            throw XCTSkip("Requires the owned restored-Phoenix fixture")
+        }
+        return try ColdStartFixture(root: URL(fileURLWithPath: root), scope: scope)
+    }
+
+    func testPrepare() throws {
+        let fixture = try fixture()
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys, .withoutEscapingSlashes]
+        let host = fixture.execution.installed.identity.installedRuntime
+        let stamp = UInt64(Date().timeIntervalSince1970)
+        var setups: [[String: Any]] = []
+        var originalManifest = ""
+        for sequence in UInt64(1)...3 {
+            let payload = ColdStartFixture.wasm(successor: sequence == 2)
+            let documents = try fixture.documents(payload, sequence: sequence, createdAt: stamp)
+            // Release API stores the JSON value bytes, excluding surrounding whitespace.
+            let signedManifest = String(decoding: documents.0, as: UTF8.self).trimmingCharacters(in: .whitespacesAndNewlines)
+            if sequence == 1 { originalManifest = signedManifest }
+            let manifest = sequence == 3 ? originalManifest : signedManifest
+            let assignment = String(decoding: documents.1, as: UTF8.self).trimmingCharacters(in: .whitespacesAndNewlines)
+            let envelope = "{\"signed_manifest\":\(manifest),\"payload\":\"\(payload.base64EncodedString())\"}"
+            let digest = try XCTUnwrap(StrictJSON.decode(CanonicalValue.self, from: Data(assignment.utf8))
+                .object?["assignment"]?.object?["artifact_sha256"]?.text)
+            setups.append(["sequence": sequence, "manifest": manifest, "assignment": assignment,
+                           "envelope": envelope, "payload": payload.base64EncodedString(), "digest": digest])
+        }
+        XCTAssertEqual(setups[0]["envelope"] as? String, setups[2]["envelope"] as? String)
+        XCTAssertNotEqual(setups[0]["digest"] as? String, setups[1]["digest"] as? String)
+        let packet: [String: Any] = [
+            "installation": installation, "releases": setups,
+            "config": ["host": try JSONSerialization.jsonObject(with: encoder.encode(host)),
+                       "roots": try JSONSerialization.jsonObject(with: fixture.roots), "channel": "beta"],
+        ]
+        try JSONSerialization.data(withJSONObject: packet, options: [.sortedKeys, .withoutEscapingSlashes])
+            .write(to: fixture.root.appendingPathComponent("packet.json"), options: .withoutOverwriting)
+    }
+
+    private struct Document: Decodable {
+        let sequence: UInt64
+        let manifest: String
+        let assignment: String
+        let envelope: String
+        let payload: Data
+        let digest: String
+    }
+
+    private struct Packet: Decodable { let releases: [Document] }
+
+    private func documents(_ fixture: ColdStartFixture) throws -> [Document] {
+        try JSONDecoder().decode(Packet.self, from: Data(contentsOf: fixture.root.appendingPathComponent("packet.json"))).releases
+    }
+
+    private func configure(_ fixture: ColdStartFixture) -> CapabilityColdStartConfiguration {
+        .init(directory: fixture.configuration.directory, channel: "beta", installation: installation,
+              observationSeconds: 1, requiredMilestones: ["feature_started"])
+    }
+
+    private struct Reply: Decodable {
+        let artifact_url: String
+    }
+
+    private func fetch(_ expected: Document, fixture: ColdStartFixture, port: UInt16) async throws -> (Data, Data, Data) {
+        let host = fixture.execution.installed.identity.installedRuntime
+        let origin = "http://127.0.0.1:\(port)"
+        let config = URLSessionConfiguration.ephemeral
+        config.timeoutIntervalForRequest = 3
+        config.timeoutIntervalForResource = 4
+        config.connectionProxyDictionary = [:]
+        let session = URLSession(configuration: config)
+        defer { session.invalidateAndCancel() }
+
+        func get(_ route: String) async throws -> Data {
+            let url = try XCTUnwrap(URL(string: origin + route))
+            let request = URLRequest(url: url, cachePolicy: .reloadIgnoringLocalCacheData)
+            let (data, response) = try await session.data(for: request)
+            let http = try XCTUnwrap(response as? HTTPURLResponse)
+            guard response.url == url, http.statusCode == 200, data.count <= 65_536,
+                  http.value(forHTTPHeaderField: "Cache-Control") == "no-store" else {
+                throw UpdateError("fixture.http", "Unexpected response for \(route), status \(http.statusCode)")
+            }
+            return data
+        }
+
+        let query = "organization=\(scope.organization)&project=\(scope.project)&app=\(scope.app)" +
+            "&environment=\(scope.environment)&platform=\(scope.platform)&runtime=\(host.runtime)&channel=beta"
+        let offer = try await get("/v3/updates?\(query)&installation=\(installation)")
+        let route = try JSONDecoder().decode(Reply.self, from: offer).artifact_url
+        let url = try XCTUnwrap(URLComponents(string: route))
+        let expectedQuery = [URLQueryItem(name: "organization", value: scope.organization),
+                             URLQueryItem(name: "project", value: scope.project)]
+        guard url.scheme == nil, url.host == nil, url.fragment == nil, url.queryItems == expectedQuery,
+              url.path == "/v3/artifacts/\(expected.digest)" else {
+            throw UpdateError("fixture.scope", "Unexpected scoped artifact URL \(route)")
+        }
+        let encodedRoute = try XCTUnwrap(String(data: JSONEncoder().encode(route), encoding: .utf8))
+            .replacingOccurrences(of: "\\/", with: "/")
+        let prefix = Data("{\"signed_assignment\":".utf8)
+        let suffix = Data(",\"artifact_url\":\(encodedRoute)}".utf8)
+        XCTAssertEqual(offer, prefix + Data(expected.assignment.utf8) + suffix)
+        let assignment = Data(offer.dropFirst(prefix.count).dropLast(suffix.count))
+        let artifact = try await get(route)
+        XCTAssertEqual(artifact, Data(expected.envelope.utf8))
+        let fields = try XCTUnwrap(StrictJSON.decode(CanonicalValue.self, from: artifact).object)
+        let payload = try XCTUnwrap(Data(base64Encoded: try XCTUnwrap(fields["payload"]?.text)))
+        let manifest = Data(artifact.dropFirst("{\"signed_manifest\":".utf8.count)
+            .dropLast(",\"payload\":\"\(expected.payload.base64EncodedString())\"}".utf8.count))
+        XCTAssertEqual(manifest, Data(expected.manifest.utf8))
+        XCTAssertEqual(payload, expected.payload)
+        return (manifest, assignment, payload)
+    }
+
+    private func state(_ fixture: ColdStartFixture) throws -> CapabilityRecoveryState {
+        try StrictJSON.decode(CapabilityRecoveryState.self,
+                              from: Data(contentsOf: fixture.configuration.directory.appendingPathComponent("state.json")))
+    }
+
+    private func inventory(_ fixture: ColdStartFixture) throws -> [String: String] {
+        let dir = fixture.configuration.directory
+        return try Dictionary(uniqueKeysWithValues: FileManager.default.contentsOfDirectory(atPath: dir.path).map { name in
+            let path = dir.appendingPathComponent(name)
+            let attrs = try FileManager.default.attributesOfItem(atPath: path.path)
+            let hash = ReleaseVerifier.sha256(try Data(contentsOf: path))
+            return (name, "\(hash):\(attrs[.systemFileNumber]!):\(attrs[.modificationDate]!)")
+        })
+    }
+
+    private func validate(_ fixture: ColdStartFixture, _ expected: Document) throws -> CapabilityRecoveryCandidate {
+        let state = try state(fixture)
+        let healthy = try XCTUnwrap(state.healthy)
+        let selected = try XCTUnwrap(state.candidates[healthy.candidateID])
+        XCTAssertEqual(state.acceptedSequence, expected.sequence)
+        XCTAssertEqual(state.candidates.values.filter { $0.sequence == expected.sequence }.count, 1)
+        XCTAssertEqual(selected.artifactSHA256, expected.digest)
+        XCTAssertEqual(selected.sequence, expected.sequence)
+        XCTAssertEqual(selected.signedAssignment, Data(expected.assignment.utf8))
+        XCTAssertEqual(selected.signedManifest, Data(expected.manifest.utf8))
+        let bytes = try Data(contentsOf: fixture.configuration.directory.appendingPathComponent(selected.payloadSHA256 + ".payload"))
+        XCTAssertEqual(bytes, expected.payload)
+        XCTAssertNil(state.pending)
+        return selected
+    }
+
+    private func activate(_ owner: CapabilityColdStartRuntime, candidate: String) async throws {
+        let result = try await owner.start()
+        XCTAssertEqual(result.candidateID, candidate)
+        XCTAssertEqual(result.phase, .provisionalGuest)
+        XCTAssertTrue(result.effectsMayHaveOpened)
+        XCTAssertNil(result.firstBridgeFailure)
+        let deadline = ContinuousClock.now + .seconds(5)
+        while true {
+            do { try await owner.reportMilestone("feature_started"); break }
+            catch let error as UpdateError where error.code == "capability.runtime.busy" {
+                guard ContinuousClock.now < deadline else { throw error }
+                try await Task.sleep(for: .milliseconds(10))
+            }
+        }
+        while await owner.recoverySnapshot().activation.phase != .healthyGuest {
+            guard ContinuousClock.now < deadline else { throw UpdateError("fixture.health", "Headless health did not commit") }
+            try await Task.sleep(for: .milliseconds(20))
+        }
+    }
+
+    private func withOwner(_ fixture: ColdStartFixture, _ body: (CapabilityColdStartRuntime) async throws -> Void) async throws {
+        let slots = CapabilityAttemptReservation.occupiedSlots
+        let owner = try await CapabilityColdStartRuntime.open(configuration: configure(fixture), execution: fixture.execution)
+        let result: Result<Void, Error>
+        do { try await body(owner); result = .success(()) }
+        catch { result = .failure(error) }
+        await owner.close()
+        let deadline = ContinuousClock.now + .seconds(5)
+        while CapabilityAttemptReservation.occupiedSlots != slots {
+            guard ContinuousClock.now < deadline else { throw UpdateError("fixture.retirement", "Owner retained capacity") }
+            try await Task.sleep(for: .milliseconds(20))
+        }
+        try result.get()
+    }
+
+    func testOnline() async throws {
+        let fixture = try fixture()
+        let sequence = try XCTUnwrap(Int(environment("SEQUENCE")))
+        let port = try XCTUnwrap(UInt16(environment("PORT")))
+        let expected = try documents(fixture)[sequence - 1]
+        try await withOwner(fixture) { owner in
+            let before = await owner.recoverySnapshot()
+            XCTAssertEqual(before.acceptedSequence, expected.sequence - 1)
+            let (manifest, assignment, payload) = try await fetch(expected, fixture: fixture, port: port)
+            try await owner.beginDownload(signedManifest: manifest, signedAssignment: assignment)
+            try await owner.appendDownload(payload, atOffset: 0)
+            try await owner.finishDownload()
+            let staged = await owner.recoverySnapshot()
+            let candidate = try XCTUnwrap(staged.staged)
+            let files = try inventory(fixture)
+            let repeated = try await fetch(expected, fixture: fixture, port: port)
+            do {
+                try await owner.beginDownload(signedManifest: repeated.0, signedAssignment: repeated.1)
+                XCTFail("An already accepted sequence reserved a download again")
+            } catch let error as UpdateError {
+                XCTAssertEqual(error.code, "v3.assignment.replay")
+            }
+            XCTAssertEqual(try inventory(fixture), files)
+            try await activate(owner, candidate: candidate)
+        }
+        let selected = try validate(fixture, expected)
+        print("RESTORE online sequence=\(sequence) artifact=\(selected.artifactSHA256) candidate=\(selected.candidateID) payload=\(selected.payloadSHA256) assignment=\(ReleaseVerifier.sha256(selected.signedAssignment)) manifest=\(ReleaseVerifier.sha256(selected.signedManifest)) replayWrites=0 vm=healthyGuest")
+    }
+
+    func testOffline() async throws {
+        let fixture = try fixture()
+        let expected = try documents(fixture)[2]
+        let candidate = try validate(fixture, expected)
+        try await withOwner(fixture) { owner in
+            let snapshot = await owner.recoverySnapshot()
+            XCTAssertEqual(snapshot.acceptedSequence, 3)
+            XCTAssertEqual(snapshot.healthy, candidate.candidateID)
+            try await activate(owner, candidate: candidate.candidateID)
+        }
+        _ = try validate(fixture, expected)
+        print("RESTORE offline sequence=3 candidate=\(candidate.candidateID) artifact=\(candidate.artifactSHA256) vm=healthyGuest")
+    }
+}
