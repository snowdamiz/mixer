+++ b/tests/integration/swift-restored-phoenix/supervise.py
@@ -0,0 +1,99 @@
+import json
+import os
+from pathlib import Path
+import signal
+import socket
+import subprocess
+import time
+
+ROOT = Path(__file__).resolve().parent
+TREE = ROOT / "tree"
+HOME = Path.home()
+PG = Path("/opt/homebrew/opt/postgresql@17/bin")
+ENV = {
+    "PATH": f"{PG}:{HOME}/.rustup/toolchains/stable-aarch64-apple-darwin/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin",
+    "HOME": str(ROOT / "home"), "TMPDIR": str(ROOT / "tmp"), "LANG": "en_US.UTF-8",
+    "MIX_HOME": str(ROOT / "mix"), "HEX_HOME": str(ROOT / "hex"),
+    "CARGO_HOME": str(ROOT / "cargo"), "CARGO_TARGET_DIR": str(ROOT / "vm"),
+    "CLANG_MODULE_CACHE_PATH": str(ROOT / "clang-cache"),
+    "SWIFTPM_MODULECACHE_OVERRIDE": str(ROOT / "swift-module"),
+    "ERL_FLAGS": "+S 4:4 +SDcpu 2 +SDio 2",
+}
+(ROOT / "home").mkdir(exist_ok=True)
+
+
+def record(file, entry):
+    fd = os.open(ROOT / file, os.O_CREAT | os.O_WRONLY | os.O_APPEND, 0o600)
+    with os.fdopen(fd, "a") as output:
+        output.write(json.dumps(entry) + "\n")
+        output.flush()
+        os.fsync(output.fileno())
+
+
+def absent(pgid):
+    try:
+        os.killpg(pgid, 0)
+    except ProcessLookupError:
+        return True
+    return False
+
+
+class Owned:
+    def __init__(self, name, argv, *, cwd=TREE, env=None, data=None):
+        self.name = name
+        self.argv = list(map(str, argv))
+        self.out = ROOT / "logs" / (name + ".stdout")
+        self.err = ROOT / "logs" / (name + ".stderr")
+        self.started = time.monotonic()
+        with self.out.open("xb") as stdout, self.err.open("xb") as stderr:
+            self.process = subprocess.Popen(self.argv, cwd=cwd, env=ENV | (env or {}),
+                stdin=subprocess.PIPE, stdout=stdout, stderr=stderr, start_new_session=True)
+        self.pid = self.process.pid
+        self.receipt = {"name": name, "argv": self.argv, "pidPgid": self.pid}
+        record("launch.jsonl", self.receipt)
+        if data is not None:
+            self.process.stdin.write(data)
+        self.process.stdin.close()
+
+    def finish(self, seconds, *, stop=None, expected=0):
+        try:
+            if stop is not None and self.process.poll() is None:
+                self.process.send_signal(stop)
+            try:
+                code = self.process.wait(timeout=seconds)
+            except subprocess.TimeoutExpired:
+                os.killpg(self.pid, signal.SIGTERM)
+                try:
+                    self.process.wait(timeout=5)
+                except subprocess.TimeoutExpired:
+                    os.killpg(self.pid, signal.SIGKILL)
+                    self.process.wait(timeout=5)
+                raise
+        finally:
+            try:
+                deadline = time.monotonic() + 3
+                while self.process.returncode is not None and not absent(self.pid):
+                    if time.monotonic() >= deadline:
+                        raise RuntimeError("owned process group still present")
+                    time.sleep(.025)
+                if self.process.returncode is None:
+                    raise RuntimeError("direct child unreaped")
+            except BaseException as error:
+                record("HOLD.jsonl", self.receipt | {"reason": repr(error)})
+                raise
+            else:
+                record("terminal.jsonl", self.receipt | {"exit": self.process.returncode,
+                    "groupAbsent": True, "seconds": round(time.monotonic() - self.started, 3)})
+        if code != expected:
+            raise RuntimeError(f"{self.name} exit {code}; read {self.err} and {self.out}")
+        return self.out.read_bytes()
+
+
+def run(name, *argv, seconds=30, expected=0, **kwargs):
+    return Owned(name, argv, **kwargs).finish(seconds, expected=expected)
+
+
+def port(number=0):
+    with socket.socket() as listener:
+        listener.bind(("127.0.0.1", number))
+        return listener.getsockname()[1]
