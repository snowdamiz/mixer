+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from supervise import ROOT, TREE, run
+import os
+
+os.umask(0o077)
+swift = ["--cache-path", ROOT / "swift-cache", "--config-path", ROOT / "swift-config",
+    "--security-path", ROOT / "swift-security", "--manifest-cache", "local", "--force-resolved-versions",
+    "--jobs", "6"]
+
+def cli():
+    run("cli-build", "swift", "build", "--package-path", "cli", "--product", "mixer",
+        "--scratch-path", ROOT / "cli", *swift, seconds=240)
+
+def hosted():
+    env = {"MIX_ENV": "test", "HEX_OFFLINE": "1"}
+    run("hex-deps", "mix", "deps.get", "--check-locked", cwd=TREE / "hosted", env=env, seconds=100)
+    run("hosted-compile", "mix", "compile", "--warnings-as-errors", cwd=TREE / "hosted", env=env, seconds=160)
+
+def vm():
+    run("vm-build", "cargo", "build", "-j", "6", "--offline", "--locked", "--manifest-path", "vm/Cargo.toml",
+        "--release", "--features", "experimental-capability-native", "--lib", seconds=240)
+    (ROOT / "lib/libmixer_vm_capability_experimental.a").symlink_to(ROOT / "vm/release/libmixer_vm.a")
+
+with ThreadPoolExecutor(max_workers=3) as pool:
+    jobs = [pool.submit(step) for step in (cli, hosted, vm)]
+    for job in jobs:
+        try:
+            job.result()
+        except Exception as error:
+            print(error, flush=True)
+    if any(job.exception() for job in jobs):
+        raise SystemExit(1)
