+import Foundation
+import XCTest
+import FieldLogStorage
+import MixerUI
+import MixerAndroid
+@testable import FieldLogAndroid
+
+final class ProjectPickerRegressionTests: XCTestCase {
+    @MainActor func testSearchBatchIsAtomicAndUsesLastValue() async throws {
+        let directory = try fixtureDirectory("search-batch")
+        let repository = try WorkspaceRepository(directory: directory.appendingPathComponent("FieldLog"))
+        let workspace = try await repository.transact { value in
+            try value.createProject(title: "South", site: "Yard")
+            try value.createProject(title: "North", site: "Dock")
+        }
+        await repository.close()
+        let surface = R109Surface()
+        let app = try await open(directory, surface)
+        let owner = try XCTUnwrap(surface.owner)
+        let before = try Data(contentsOf: file(directory))
+        let foreign = try event(app, "task.title", .textChange, .string("Other editor"))
+        try send(app, "workspace-projects")
+        let first = try event(app, "projects-search", .textChange, .string("Yard"))
+        let last = try event(app, "projects-search", .textChange, .string("Dock"))
+        let back = try event(app, "projects-back")
+        let frameCount = surface.frames.count
+        let revision = app.presentation.snapshot.document.revision
+        let retargeted = UIEventEnvelope(revision: revision, identity: foreign.identity,
+                                         event: .textChange, value: .string("Dock"))
+        let malformed = UIEventEnvelope(revision: revision, identity: last.identity,
+                                         event: .textChange, value: .bool(false))
+        let stale = UIEventEnvelope(revision: revision - 1, identity: last.identity,
+                                     event: .textChange, value: .string("Dock"))
+        let oversized = UIEventEnvelope(revision: revision, identity: last.identity,
+                                         event: .textChange, value: .string(String(repeating: "x", count: UIValidationLimits.standard.maximumStringBytes + 1)))
+
+        func sendBatch(_ events: [UIEventEnvelope], from sender: UUID = owner) throws {
+            try app.sendBatch(owner: sender, originalEnvelopes: JSONEncoder().encode(events))
+        }
+        for invalid in [back, retargeted, malformed, stale, oversized] {
+            XCTAssertThrowsError(try sendBatch([first, invalid]))
+        }
+        XCTAssertThrowsError(try sendBatch([back, first]))
+        XCTAssertThrowsError(try sendBatch([first, last], from: UUID()))
+        XCTAssertEqual(surface.frames.count, frameCount)
+        XCTAssertEqual(app.presentation.snapshot.document.revision, revision)
+        XCTAssertEqual(try Data(contentsOf: file(directory)), before)
+
+        try sendBatch([first, last])
+        let document = try XCTUnwrap(surface.document)
+        XCTAssertEqual(surface.frames.count, frameCount + 1)
+        XCTAssertEqual(document.revision, revision + 1)
+        XCTAssertEqual(fieldLogNode("projects-search", in: document.root)?.properties["value"], .string("Dock"))
+        let south = try "project." + XCTUnwrap(workspace.projects.first { $0.title == "South" }).id.uuidString.lowercased()
+        let north = try "project." + XCTUnwrap(workspace.projects.first { $0.title == "North" }).id.uuidString.lowercased()
+        XCTAssertNil(fieldLogNode(south, in: document.root))
+        XCTAssertNotNil(fieldLogNode(north, in: document.root))
+        XCTAssertEqual(try Data(contentsOf: file(directory)), before)
+        await app.close()
+    }
+
+    @MainActor func testEntriesProjectPickerFollowsReportHandoff() async throws {
+        let directory = try fixtureDirectory("entries-report")
+        let surface = R109Surface()
+        let app = try await open(directory, surface)
+        let before = try Data(contentsOf: file(directory))
+        try send(app, "workspace-report")
+        let preparing = try XCTUnwrap(surface.document)
+        XCTAssertEqual(fieldLogNode("workspace-projects", in: preparing.root)?.properties["disabled"], .bool(true))
+        XCTAssertThrowsError(try send(app, "workspace-entries"))
+        try await app.settle()
+        let request = try XCTUnwrap(app.presentation.takeReportRequest())
+        try send(app, "workspace-entries")
+        let pending = try XCTUnwrap(surface.document)
+        XCTAssertEqual(pending.root.id, "entry.screen")
+        XCTAssertEqual(fieldLogNode("workspace-projects", in: pending.root)?.properties["disabled"], .bool(true))
+        let frameCount = surface.frames.count
+        XCTAssertThrowsError(try send(app, "workspace-projects"))
+        XCTAssertEqual(surface.frames.count, frameCount)
+
+        XCTAssertTrue(app.presentation.completeReport(requestID: request.id, result: .opened))
+        try await app.settle()
+        let opened = try XCTUnwrap(surface.document)
+        XCTAssertEqual(fieldLogNode("workspace-projects", in: opened.root)?.properties["disabled"], .bool(true))
+        XCTAssertTrue(app.presentation.completeReport(requestID: request.id, result: .closed))
+        try await app.settle()
+        let finished = try XCTUnwrap(surface.document)
+        XCTAssertEqual(finished.root.id, "entry.screen")
+        XCTAssertEqual(fieldLogNode("workspace-projects", in: finished.root)?.properties["disabled"], .bool(false))
+        XCTAssertFalse(app.presentation.reportSharePending)
+        try send(app, "workspace-projects")
+        XCTAssertEqual(surface.document?.root.id, "projects.screen")
+        XCTAssertEqual(try Data(contentsOf: file(directory)), before)
+        await app.close()
+    }
+
+    private func fixtureDirectory(_ name: String) throws -> URL {
+        let path = try XCTUnwrap(ProcessInfo.processInfo.environment["FIELDLOG_WORKSPACE"])
+        return URL(fileURLWithPath: path).appendingPathComponent(name + "-" + UUID().uuidString)
+    }
+}
