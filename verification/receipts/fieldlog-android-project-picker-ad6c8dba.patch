+            try showProjectPicker(nil)
+        case "projects.previous", "projects.next":
+            let count = workspace.matchingProjects(picker.query).count
+            let current = Self.page(picker.page, count: count)
+            let destination = current + (action.nodeID == "projects.previous" ? -1 : 1)
