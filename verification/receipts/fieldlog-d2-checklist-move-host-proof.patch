@@ -0,0 +1,68 @@
+import FieldLogModels
+import FieldLogStorage
+import Foundation
+import MixerUI
+import XCTest
+@testable import FieldLogAndroid
+
+final class AndroidChecklistRevisionTests: XCTestCase {
+  @MainActor func testChecklistRevisionAndDisk() async throws {
+    let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+    defer { try? FileManager.default.removeItem(at: directory) }
+    let repository = try WorkspaceRepository(directory: directory.appendingPathComponent("FieldLog"))
+    let baseline = try await seedChecklist(repository)
+    await repository.close()
+
+    let surface = R109Surface()
+    let app = try await open(directory, surface)
+    let owner = try XCTUnwrap(surface.owner)
+    let project = baseline.projects[0].id
+    var order = baseline.tasks(for: project).map(\.id)
+    let target = order[19]
+    let key = "task." + target.uuidString.lowercased()
+    let outdated = try event(app, key + ".down")
+
+    try send(app, key + ".down")
+    try await app.settle()
+    order.swapAt(19, 20)
+    func rendered(_ id: String) -> UINode? { fieldLogNode(id, in: app.presentation.snapshot.document.root) }
+    XCTAssertEqual(rendered("tasks.position")?.properties["text"]?.string, "Page 2 of 2 · Tasks 21–22 of 22")
+    XCTAssertEqual(rendered(key + ".complete")?.properties["accessibilityIdentifier"]?.string, key + ".complete")
+    let current = try event(app, key + ".complete")
+    let beforeCompletion = try Data(contentsOf: file(directory))
+    let frames = surface.frames.count
+    XCTAssertThrowsError(try app.send(owner: owner, originalEnvelope: JSONEncoder().encode(outdated)))
+    XCTAssertThrowsError(try app.send(owner: UUID(), originalEnvelope: JSONEncoder().encode(current)))
+    try send(app, "tasks.previous")
+    let firstKey = "task." + order[0].uuidString.lowercased()
+    XCTAssertThrowsError(try send(app, firstKey + ".up"))
+    try await app.settle()
+    XCTAssertEqual(surface.frames.count, frames + 1)
+    XCTAssertEqual(try Data(contentsOf: file(directory)), beforeCompletion)
+    try send(app, "tasks.next")
+    try send(app, key + ".complete")
+    try await app.settle()
+
+    let committed = try disk(directory)
+    XCTAssertEqual(app.presentation.workspace, committed)
+    try assertChecklistChange(baseline, committed, order: order, target: target,
+                              kinds: [.taskOrderChanged, .taskSaved])
+    let currentUI = try event(app, key + ".complete")
+    let newer = try await app.presentation.repository.transact { $0.restoration.selectedProjectID = project }
+    let newerBytes = try Data(contentsOf: file(directory))
+    // The current UI generation and owner still admit the event. Only the durable revision is stale.
+    try app.send(owner: owner, originalEnvelope: JSONEncoder().encode(currentUI))
+    try await app.settle()
+    XCTAssertTrue(try text(app).contains(FieldLogError.staleRevision.localizedDescription))
+    XCTAssertEqual(try Data(contentsOf: file(directory)), newerBytes)
+    XCTAssertEqual(try disk(directory), newer)
+    XCTAssertEqual(app.presentation.workspace, committed)
+    await app.close()
+    XCTAssertNil(surface.owner)
+    let cold = try await open(directory)
+    XCTAssertEqual(cold.presentation.workspace, newer)
+    XCTAssertEqual(try Data(contentsOf: file(directory)), newerBytes)
+    await cold.close()
+    print("CHECKLIST_ANDROID_PASS: page crossing and accessibility, one completion, wrong owner, stale UI and repository revisions, invalid move, exact outbox and cold reopen")
+  }
+}
diff --git a/AppleChecklistReplay.swift b/AppleChecklistReplay.swift
new file mode 100644
index 0000000000000000000000000000000000000000..25bf1527527db8000c2f059b49f7958c693e29b0
--- /dev/null
+++ b/AppleChecklistReplay.swift
@@ -0,0 +1,58 @@
+import FieldLogModels
+import FieldLogStorage
+import Foundation
+
+@main struct AppleChecklistReplay {
+  @MainActor static func main() async throws {
+    let directory = URL(fileURLWithPath: CommandLine.arguments[1], isDirectory: true)
+    let path = directory.appendingPathComponent("workspace.json")
+    let repository = try WorkspaceRepository(directory: directory)
+    let baseline = try await seedChecklist(repository)
+    let model = WorkspaceModel(repository: repository)
+    await model.open()
+    let project = baseline.projects[0].id
+    var order = baseline.tasks(for: project).map(\.id)
+    let target = order[18]
+    order.swapAt(18, 19)
+    model.reorder(projectID: project, ids: order)
+    model.moveTask(target, offset: 1)
+    model.toggleTask(target)
+    try requireChecklist(model.pendingSaves == 3 && model.workspace == baseline, "all actions queued before first commit")
+    order.swapAt(19, 20)
+    await model.flush()
+    let committed = try await repository.readCommittedSnapshot()
+    try requireChecklist(model.pendingSaves == 0 && model.saveError == nil && model.workspace == committed,
+                         "published committed snapshot after queue drains")
+    try assertChecklistChange(baseline, committed, order: order, target: target,
+                              kinds: [.taskOrderChanged, .taskOrderChanged, .taskSaved])
+
+    let bytes = try Data(contentsOf: path)
+    model.moveTask(order[0], offset: -1)
+    await model.flush()
+    try requireChecklist(model.saveError == "This task cannot move farther." && Data(contentsOf: path) == bytes,
+                         "invalid move produced no write")
+    model.reorder(projectID: project, ids: Array(order.dropLast()) + [baseline.tasks(for: baseline.projects[1].id)[0].id])
+    await model.flush()
+    try requireChecklist(model.saveError == "Task order must include each task exactly once." &&
+                         Data(contentsOf: path) == bytes, "invalid drag order produced no write")
+
+    // Emulate external replacement at the repository's durable-snapshot boundary.
+    var external = committed
+    external.revision += 1
+    external.restoration.selectedProjectID = project
+    let externalBytes = try JSONEncoder().encode(external)
+    try externalBytes.write(to: path, options: .atomic)
+    model.toggleTask(target)
+    await model.flush()
+    try requireChecklist(model.saveError == FieldLogError.staleRevision.localizedDescription &&
+                         Data(contentsOf: path) == externalBytes && model.workspace == committed,
+                         "stale disk replacement rejected without a write or publication")
+    await repository.close()
+    let reopened = try WorkspaceRepository(directory: directory)
+    let cold = try await reopened.readCommittedSnapshot()
+    try requireChecklist(cold == external && Data(contentsOf: path) == externalBytes,
+                         "cold reopen and exact durable bytes")
+    await reopened.close()
+    print("CHECKLIST_APPLE_PASS: queued drag, execution-time move across rows 20/21, one completion, invalid moves, stale disk, exact outbox and cold reopen")
+  }
+}
