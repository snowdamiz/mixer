diff --git a/ChecklistDiskFixture.swift b/ChecklistDiskFixture.swift
new file mode 100644
index 0000000000000000000000000000000000000000..47416ae89785ac9e60c99ac746155b1d27822ef8
--- /dev/null
+++ b/ChecklistDiskFixture.swift
@@ -0,0 +1,71 @@
+import FieldLogModels
+import FieldLogStorage
+import Foundation
+
+let fixtureDate = Date(timeIntervalSince1970: 1_700_000_000)
+
+private func fixtureID(_ value: Int) -> UUID {
+  UUID(uuidString: String(format: "13572468-1234-1234-1234-%012d", value))!
+}
+
+func seedChecklist(_ repository: WorkspaceRepository) async throws -> Workspace {
+  try await repository.transact { workspace in
+    let project = try workspace.createProject(id: fixtureID(1), title: "Checklist", site: "", now: fixtureDate)
+    let other = try workspace.createProject(id: fixtureID(2), title: "Other project", site: "", now: fixtureDate)
+    workspace.tasks = (0..<22).map { index in
+      WorkTask(id: fixtureID(10 + index), projectID: project, title: "Inspect \(index + 1)",
+               responsible: " Jo 日本語 ", position: index, updatedAt: fixtureDate)
+    }
+    workspace.tasks.append(WorkTask(id: fixtureID(3), projectID: other, title: "Other task",
+                                    completed: true, updatedAt: fixtureDate))
+    let followUpValues: [Bool?] = [nil, false, true]
+    for (index, value) in followUpValues.enumerated() {
+      var draft = EntryDraft(id: fixtureID(40 + index), projectID: index == 0 ? project : other,
+                             title: "Open note \(index)", occurredAt: fixtureDate, updatedAt: fixtureDate)
+      draft.followUpRequired = value
+      workspace.drafts.append(draft)
+    }
+    workspace.restoration.openDraftID = workspace.drafts[1].id
+  }
+}
+
+struct ChecklistProofFailure: Error { let label: String }
+
+func requireChecklist(_ ok: @autoclosure () throws -> Bool, _ label: String) throws {
+  if try !ok() { throw ChecklistProofFailure(label: label) }
+}
+
+func assertChecklistChange(_ before: Workspace, _ after: Workspace, order: [UUID],
+                           target: UUID, kinds: [PendingChange.Kind]) throws {
+  let project = before.projects[0].id
+  let changes = Array(after.outbox.dropFirst(before.outbox.count))
+  let expectedIDs = kinds.map { $0 == .taskSaved ? target : project }
+  try requireChecklist(after.outbox.starts(with: before.outbox), "unchanged outbox prefix")
+  try requireChecklist(changes.map(\.kind) == kinds && changes.map(\.recordID) == expectedIDs,
+                       "exact outbox kinds and record IDs")
+  try requireChecklist(changes.count == kinds.count && Set(after.outbox.map(\.id)).count == after.outbox.count,
+                       "exact outbox count and unique IDs")
+  try requireChecklist(changes.map(\.revision) == kinds.indices.map { before.revision + 1 + UInt64($0) },
+                       "one revision per mutation")
+  try requireChecklist(after.revision == before.revision + UInt64(kinds.count), "exact workspace revision")
+  let updated = after.tasks(for: project)
+  try requireChecklist(updated.map(\.id) == order && updated.map(\.position) == Array(order.indices),
+                       "exact persisted task order and positions")
+  try requireChecklist(updated.filter(\.completed).map(\.id) == [target], "exactly one completion")
+  let originalTasks = Dictionary(uniqueKeysWithValues: before.tasks(for: project).map { ($0.id, $0) })
+  for task in updated {
+    var expected = originalTasks[task.id]!
+    expected.position = order.firstIndex(of: task.id)!
+    expected.completed = task.id == target
+    let lastEdit = changes.last { $0.kind == .taskOrderChanged || $0.recordID == task.id }
+    expected.updatedAt = lastEdit!.createdAt
+    try requireChecklist(task == expected, "only intended task fields changed, with matching outbox timestamp")
+  }
+  try requireChecklist(after.tasks(for: before.projects[1].id) == before.tasks(for: before.projects[1].id),
+                       "unrelated project checklist preserved")
+  try requireChecklist(after.projects == before.projects && after.drafts == before.drafts &&
+                       after.restoration == before.restoration && after.entries == before.entries &&
+                       after.attachments == before.attachments && after.id == before.id &&
+                       after.createdAt == before.createdAt && after.schema == before.schema,
+                       "optional draft values, restoration, and non-checklist data preserved")
+}
