+#!/bin/bash
+set -euo pipefail
+test "$#" = 2
+work="$(cd "$1" && pwd -P)"
+route="$2"
+case "$route" in
+  baseline|candidate-host) ;;
+  *) exit 64 ;;
+esac
+replay="$(cd "$(dirname "$0")" && pwd -P)"
+product="$work/$route"
+runner="$work/$route-apple/runner"
+mkdir -p "$runner/Sources/ChecklistHost"
+sed "s#path: \"../fieldlog\"#path: \"../../$route\"#" "$replay/ApplePackage.swift" > "$runner/Package.swift"
+cp "$replay"/{AppleChecklistReplay,ChecklistDiskFixture}.swift "$runner/Sources/ChecklistHost/"
+cp "$product"/ios/FieldLog/{WorkspaceModel,SelectedDraftGuestBinding}.swift "$runner/Sources/ChecklistHost/"
+cp "$product"/Integrations/InstalledGuest/FieldLogDraftStorage.swift "$runner/Sources/ChecklistHost/"
+cp "$replay"/{AndroidChecklistRevisionTests,ChecklistDiskFixture}.swift "$product/Integrations/GeneratedReport/Tests/FieldLogAndroidTests/"
