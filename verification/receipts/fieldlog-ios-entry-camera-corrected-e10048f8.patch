+  private func openEditor(in directory: URL, fault: PhotoFault) async throws
+    -> (WorkspaceRepository, WorkspaceModel, DraftEditorSelection)
+  {
+    let repository = try WorkspaceRepository(directory: directory, fault: fault.call)
+    let model = WorkspaceModel(repository: repository)
+    await model.open()
+    let project = try #require(await model.createProject(title: "Owner", site: "Test site"))
+    let draft = try #require(await model.newDraft(projectID: project))
+    model.selectDraftEditor(draft)
