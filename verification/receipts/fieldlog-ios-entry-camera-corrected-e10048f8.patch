index 0000000000000000000000000000000000000000..ee0665d8cbaccd508eee277d753654fcd12310be
--- /dev/null
+++ b/ios/FieldLog/EntryPhotoContent.swift
@@ -0,0 +1,99 @@
+import CoreGraphics
+import FieldLogModels
+import Foundation
+import ImageIO
+import UniformTypeIdentifiers
+
+enum EntryPhotoContent {
+  private static let maximumDimension = 1600
+  private static let maximumJPEGBytes = 6 * 1024 * 1024
+  private static let resizeFailure = FieldLogError.validation(
+    "This image couldn't be resized within the supported photo limit.")
+
+  static func validateFileSize(_ file: URL) throws {
+    let attributes = try FileManager.default.attributesOfItem(atPath: file.path)
+    guard let bytes = (attributes[.size] as? NSNumber)?.int64Value,
+      (1...(32 * 1024 * 1024)).contains(bytes)
+    else { throw FieldLogError.validation("Choose an image up to 32 MiB.") }
+  }
+
+  @concurrent static func resizedJPEG(file: URL) async throws -> Data {
+    try Task.checkCancellation()
+    try validateFileSize(file)
+    guard let source = CGImageSourceCreateWithURL(file as CFURL, nil),
+      let image = CGImageSourceCreateThumbnailAtIndex(
+        source, 0,
+        [
+          kCGImageSourceCreateThumbnailFromImageAlways: true,
+          kCGImageSourceCreateThumbnailWithTransform: true,
+          kCGImageSourceThumbnailMaxPixelSize: maximumDimension,
+        ] as CFDictionary)
+    else { throw resizeFailure }
+    return try encodeJPEG(image)
+  }
+
+  @concurrent static func resizedJPEG(
+    capture: CGImage, orientation: CGImagePropertyOrientation
+  ) async throws -> Data {
+    try Task.checkCancellation()
+    let scale = min(1, Double(maximumDimension) / Double(max(capture.width, capture.height)))
+    let width = max(1, Int((Double(capture.width) * scale).rounded()))
+    let height = max(1, Int((Double(capture.height) * scale).rounded()))
+    let w = CGFloat(width)
+    let h = CGFloat(height)
+    let transform: CGAffineTransform
+    let swapsAxes: Bool
+    switch orientation {
+    case .up:
+      transform = .identity
+      swapsAxes = false
+    case .upMirrored:
+      transform = CGAffineTransform(a: -1, b: 0, c: 0, d: 1, tx: w, ty: 0)
+      swapsAxes = false
+    case .down:
+      transform = CGAffineTransform(a: -1, b: 0, c: 0, d: -1, tx: w, ty: h)
+      swapsAxes = false
+    case .downMirrored:
+      transform = CGAffineTransform(a: 1, b: 0, c: 0, d: -1, tx: 0, ty: h)
+      swapsAxes = false
+    case .leftMirrored:
+      transform = CGAffineTransform(a: 0, b: -1, c: -1, d: 0, tx: h, ty: w)
+      swapsAxes = true
+    case .right:
+      transform = CGAffineTransform(a: 0, b: -1, c: 1, d: 0, tx: 0, ty: w)
+      swapsAxes = true
+    case .rightMirrored:
+      transform = CGAffineTransform(a: 0, b: 1, c: 1, d: 0, tx: 0, ty: 0)
+      swapsAxes = true
+    case .left:
+      transform = CGAffineTransform(a: 0, b: 1, c: -1, d: 0, tx: h, ty: 0)
+      swapsAxes = true
+    @unknown default:
+      throw resizeFailure
+    }
+    guard let context = CGContext(
+      data: nil, width: swapsAxes ? height : width, height: swapsAxes ? width : height,
+      bitsPerComponent: 8, bytesPerRow: 0, space: CGColorSpaceCreateDeviceRGB(),
+      bitmapInfo: CGImageAlphaInfo.noneSkipLast.rawValue)
+    else { throw resizeFailure }
+    context.interpolationQuality = .high
+    context.concatenate(transform)
+    context.draw(capture, in: CGRect(x: 0, y: 0, width: w, height: h))
+    guard let resized = context.makeImage() else { throw resizeFailure }
+    return try encodeJPEG(resized)
+  }
+
+  private static func encodeJPEG(_ image: CGImage) throws -> Data {
+    try Task.checkCancellation()
+    let output = NSMutableData()
+    guard let destination = CGImageDestinationCreateWithData(
+      output, UTType.jpeg.identifier as CFString, 1, nil)
+    else { throw resizeFailure }
+    CGImageDestinationAddImage(
+      destination, image, [kCGImageDestinationLossyCompressionQuality: 0.82] as CFDictionary)
+    guard CGImageDestinationFinalize(destination), output.length <= maximumJPEGBytes else {
+      throw resizeFailure
+    }
+    return output as Data
+  }
+}
