+
+  private final class PhotoFault: Sendable {
+    struct Refusal: LocalizedError {
+      var errorDescription: String? { "Injected storage refusal." }
+    }
+
+    private struct Trigger: Sendable {
+      let phase: String
+      var skip: Int
+      let action: @Sendable () throws -> Void
+    }
+
+    private let trigger = OSAllocatedUnfairLock<Trigger?>(initialState: nil)
+
+    func fail(_ phase: String, after skip: Int = 0) {
+      trigger.withLock { $0 = Trigger(phase: phase, skip: skip) { throw Refusal() } }
+    }
+
+    func onNextRename(_ action: @escaping @Sendable () throws -> Void) {
+      trigger.withLock { $0 = Trigger(phase: "before_rename", skip: 0, action: action) }
+    }
+
+    func call(_ phase: String) throws {
+      let action = trigger.withLock { armed -> (@Sendable () throws -> Void)? in
+        guard var current = armed, current.phase == phase else { return nil }
+        guard current.skip == 0 else {
+          current.skip -= 1
+          armed = current
+          return nil
+        }
+        armed = nil
+        return current.action
+      }
+      try action?()
+    }
+  }
+
+  private func makeDirectory() throws -> URL {
+    let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+    try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false)
+    return directory
+  }
+
+  private func imagePixels() throws -> CGImage {
+    let context = try #require(CGContext(
+      data: nil, width: 2000, height: 1000, bitsPerComponent: 8, bytesPerRow: 0,
+      space: CGColorSpaceCreateDeviceRGB(), bitmapInfo: CGImageAlphaInfo.noneSkipLast.rawValue))
+    context.setFillColor(red: 1, green: 0, blue: 0, alpha: 1)
+    context.fill(CGRect(x: 0, y: 0, width: 1000, height: 500))
+    context.setFillColor(red: 0, green: 1, blue: 0, alpha: 1)
+    context.fill(CGRect(x: 1000, y: 0, width: 1000, height: 500))
+    context.setFillColor(red: 0, green: 0, blue: 1, alpha: 1)
+    context.fill(CGRect(x: 0, y: 500, width: 1000, height: 500))
+    context.setFillColor(red: 1, green: 1, blue: 0, alpha: 1)
+    context.fill(CGRect(x: 1000, y: 500, width: 1000, height: 500))
+    return try #require(context.makeImage())
+  }
+
+  private func imageData(_ image: CGImage, orientation: CGImagePropertyOrientation) throws -> Data {
+    let output = NSMutableData()
+    let destination = try #require(
+      CGImageDestinationCreateWithData(output, UTType.jpeg.identifier as CFString, 1, nil))
+    CGImageDestinationAddImage(destination, image, [kCGImagePropertyOrientation: orientation.rawValue] as CFDictionary)
