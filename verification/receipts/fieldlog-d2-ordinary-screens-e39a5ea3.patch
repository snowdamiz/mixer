-    return tasks.enumerated().map { index, task in
-      Self(
+    Array(ProjectChecklist(in: workspace, projectID: projectID).rows)
+  }
+}
+
+public struct ProjectChecklist {
+  private let tasks: [WorkTask]
+
+  public init(in workspace: Workspace, projectID: UUID) {
+    tasks = workspace.tasks(for: projectID)
+  }
+
+  public var progress: ChecklistProgress { ChecklistProgress(tasks) }
+
+  public var rows: some RandomAccessCollection<ChecklistRow> {
+    tasks.indices.lazy.map { index in
+      let task = tasks[index]
+      return ChecklistRow(
         id: task.id, title: task.title, responsible: task.responsible, completed: task.completed,
         number: index + 1, canMoveUp: index > 0, canMoveDown: index + 1 < tasks.count)
     }
