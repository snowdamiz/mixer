--- /dev/null
+++ b/Integrations/GeneratedReport/Sources/FieldLogFeatures/DevicePendingChanges.swift
@@ -0,0 +1,26 @@
+import FieldLogModels
+
+public struct DevicePendingChanges {
+  private let workspace: Workspace
+
+  public init(in workspace: Workspace) {
+    self.workspace = workspace
+  }
+
+  // A view of the complete device outbox. Callers can slice before formatting.
+  public var newestFirst: ReversedCollection<[PendingChange]> { workspace.outbox.reversed() }
+
+  public static func label(for kind: PendingChange.Kind) -> String {
+    switch kind {
+    case .projectCreated: "Project created"
+    case .taskSaved: "Task updated"
+    case .taskOrderChanged: "Checklist reordered"
+    case .entrySaved: "Entry saved"
+    }
+  }
+
+  public func taskTitle(for item: PendingChange) -> String? {
+    guard item.kind == .taskSaved else { return nil }
+    return workspace.tasks.first { $0.id == item.recordID }?.title
+  }
+}
