--- /dev/null
+++ b/Integrations/GeneratedReport/Sources/FieldLogFeatures/ChecklistEdit.swift
@@ -0,0 +1,21 @@
+import FieldLogModels
+import Foundation
+
+public enum ChecklistEdit: Sendable {
+  case toggle(UUID)
+  case order(projectID: UUID, ids: [UUID])
+
+  public static func moving(_ id: UUID, by offset: Int, in workspace: Workspace) throws -> Self {
+    let order = try workspace.taskOrder(moving: id, by: offset)
+    return .order(projectID: order.projectID, ids: order.ids)
+  }
+
+  public func apply(to workspace: inout Workspace) throws {
+    switch self {
+    case .toggle(let id):
+      try workspace.toggleTask(id)
+    case .order(let projectID, let ids):
+      try workspace.reorderTasks(projectID: projectID, ids: ids)
+    }
+  }
+}
