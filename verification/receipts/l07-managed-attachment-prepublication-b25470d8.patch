+  defp interrupt_upload!(port, selection, signed, token, pre_cut) do
+    tag = make_ref()
+    owner = self()
+    {path, target} = attachment_target(selection)
+
+    :ok =
+      :telemetry.attach(
+        tag,
+        [:bandit, :request, :stop],
+        fn _, _, metadata, _ ->
+          case metadata do
+            %{conn: %{method: "POST", request_path: ^path}, error: error} ->
+              send(owner, {tag, error})
+
+            _ ->
+              :ok
+          end
+        end,
+        nil
+      )
+
+    try do
+      {:ok, socket} =
+        :gen_tcp.connect({127, 0, 0, 1}, port, [:binary, active: false, packet: :line], 1_000)
+
+      try do
+        :ok =
+          :gen_tcp.send(socket, [
+            "POST ",
+            target,
+            " HTTP/1.1\r\n",
+            "host: 127.0.0.1:",
+            Integer.to_string(port),
+            "\r\n",
+            "authorization: Bearer ",
+            token,
+            "\r\n",
+            "content-type: application/json\r\n",
+            "content-length: ",
+            Integer.to_string(byte_size(signed)),
+            "\r\n",
+            "expect: 100-continue\r\nconnection: close\r\n\r\n"
+          ])
+
+        assert {:ok, "HTTP/1.1 100 Continue\r\n"} = :gen_tcp.recv(socket, 0, 750)
+        pre_cut.()
+        assert :ok = :gen_tcp.send(socket, binary_part(signed, 0, div(byte_size(signed), 2)))
+        assert :ok = :gen_tcp.shutdown(socket, :write)
+        assert_receive {^tag, "Unrecoverable error: closed"}, 1_500
+      after
+        :gen_tcp.close(socket)
+      end
+    after
+      :telemetry.detach(tag)
+    end
+  end
