+  @tag :ordinary_http
+  test "interrupted authenticated v3 attachment leaves release state intact and retry settles once",
+       c do
+    port = http_port!()
+    origin = "http://127.0.0.1:#{port}"
+    {jwt, tls} = start_bearer_fixture!(c.identity)
+    token = bearer(jwt, c.identity, "mixer.build.attest")
+    b = completed!(c.selection, retry: true)
+    retain!(c.root, b.operation, b.products)
+    signed = envelope(c, b, origin: origin)
+
+    sql("INSERT INTO public.mixer_authz_environments VALUES ('org-a','project','app','dev',true)")
+
+    sql("""
+    INSERT INTO public.mixer_release_heads
+      (organization_id,project_id,application_id,environment_id,platform,runtime_sha256,channel,writer_role)
+    VALUES ('org-a','project','app','dev','ios',repeat('5',64),'test','attestation_fixture_owner')
+    """)
+
+    start_http_api!(c, port, c.spki)
+    assert_login!(AttestationRepo, @writer)
+    assert writer_count() == 1
+
+    baseline = attachment_state(b)
+
+    head = [
+      "org-a",
+      "project",
+      "app",
+      "dev",
+      "ios",
+      String.duplicate("5", 64),
+      "test",
+      "attestation_fixture_owner",
+      nil
+    ]
+
+    assert baseline == {[], [[5, b.journal]], {[head], [[0, 0, 0]]}}
+
+    interrupt_upload!(port, c.selection, signed, token, fn ->
+      assert baseline == attachment_state(b)
+    end)
+
+    assert baseline == attachment_state(b)
+
+    assert_http(201, "attached", post(port, c.selection, signed, token))
+
+    {[], journal, release} = baseline
+    settled = {[[5, 2, b.operation, @binding, sha(c.spki), origin, signed]], journal, release}
+    assert attachment_state(b) == settled
+    assert_http(200, "duplicate", post(port, c.selection, signed, token))
+    assert attachment_state(b) == settled
+
+    stop_http_api!(port)
+    :ok = stop_supervised(KeyOwnerSupervisor)
+    stop_supervised!(TLSFixture)
+
+    for closed_port <- [port, tls.port] do
+      assert {:ok, reservation} =
+               :gen_tcp.listen(closed_port, ip: {127, 0, 0, 1}, reuseaddr: true)
+
+      assert :ok = :gen_tcp.close(reservation)
+    end
+
+    IO.puts(
+      "L07_ATTACHMENT_CUT " <>
+        Jason.encode!(%{
+          http_port: port,
+          tls_port: tls.port,
+          pre_cut_http: 100,
+          cut: "closed while reading partial body",
+          cut_prefix_bytes: div(byte_size(signed), 2),
+          attachment_rows_before_and_after_cut: [0, 0],
+          retry_http: 201,
+          replay_http: 200,
+          attachment_rows_after_retry_and_replay: [1, 1],
+          signed_sha256: sha(signed),
+          signed_bytes: byte_size(signed),
+          build_journal_revision: 5,
+          build_journal_unchanged: true,
+          release_head_unassigned_and_unchanged: true,
+          release_publications_artifacts_audit_rows: [0, 0, 0],
+          listeners_rebound: true
+        })
+    )
+  end
+
