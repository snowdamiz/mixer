+#!/bin/bash
+set -euo pipefail
+
+tests="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+repo="$(cd "$tests/../.." && pwd)"
+scratch="$(mktemp -d "${TMPDIR:-/tmp}/fieldlog-settings-host.XXXXXXXX")"
+trap 'rm -rf -- "$scratch"' EXIT
+
+mkdir -p "$scratch"/{app,tests,config,security,cache}
+ln -s "$repo/Sources/FieldLogModels" "$scratch/models"
+ln -s "$repo/Sources/FieldLogStorage" "$scratch/storage"
+ln -s "$repo/ios/FieldLog/"{FieldLogPreferences,SettingsView}.swift "$scratch/app/"
+ln -s "$tests/SettingsTests.swift" "$repo/Tests/FieldLogTests/FieldLogTests.swift" "$scratch/tests/"
+cat > "$scratch/Package.swift" <<'SWIFT'
+// swift-tools-version: 6.0
+import PackageDescription
+
+let package = Package(
+  name: "FieldLogSettingsHost",
+  platforms: [.macOS(.v14)],
+  targets: [
+    .target(name: "FieldLogModels", path: "models"),
+    .target(name: "FieldLogStorage", dependencies: ["FieldLogModels"], path: "storage"),
+    .target(name: "FieldLogSettingsHost", path: "app"),
+    .testTarget(
+      name: "FieldLogSettingsTests",
+      dependencies: ["FieldLogSettingsHost", "FieldLogModels", "FieldLogStorage"],
+      path: "tests")
+  ]
+)
+SWIFT
+
+swift test --package-path "$scratch" --scratch-path "$scratch/build" --cache-path "$scratch/cache" \
+  --config-path "$scratch/config" --security-path "$scratch/security" --manifest-cache local \
+  --disable-dependency-cache --disable-index-store "$@"
