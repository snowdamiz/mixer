diff --git a/ios/FieldLog/SettingsView.swift b/ios/FieldLog/SettingsView.swift
new file mode 100644
index 0000000000000000000000000000000000000000..cc11d7d05a462a9f3cf561472a7d9fe32ad2ff62
--- /dev/null
+++ b/ios/FieldLog/SettingsView.swift
@@ -0,0 +1,138 @@
+import SwiftUI
+
+struct SettingsView: View {
+  @EnvironmentObject private var settings: FieldLogSettings
+  @State private var confirmingReset = false
+
+  var body: some View {
+    Form {
+      Section("Appearance and text") {
+        Picker("Appearance", selection: selection(\.appearance)) {
+          Text("System").tag(FieldLogPreferences.Appearance.system)
+          Text("Light").tag(FieldLogPreferences.Appearance.light)
+          Text("Dark").tag(FieldLogPreferences.Appearance.dark)
+        }
+        .accessibilityIdentifier("settings-appearance")
+        Picker("Text size", selection: selection(\.largerText)) {
+          Text("System").tag(false)
+          Text("Larger").tag(true)
+        }
+        .accessibilityIdentifier("settings-text-size")
+      }
+      .disabled(!settings.loadStatus.allowsEditing)
+
+      Section("Dates") {
+        Picker("Regional formats", selection: selection(\.regionalFormats)) {
+          Text("System").tag(FieldLogPreferences.RegionalFormats.system)
+          Text("English (United States)").tag(FieldLogPreferences.RegionalFormats.enUS)
+          Text("French (France)").tag(FieldLogPreferences.RegionalFormats.frFR)
+        }
+        .accessibilityIdentifier("settings-regional-formats")
+        .disabled(!settings.loadStatus.allowsEditing)
+        LabeledContent {
+          FieldLogDate(value: .now, format: .dateTime.year().month(.abbreviated).day())
+        } label: {
+          Text("Date example")
+        }
+      }
+
+      Section {
+        switch settings.loadStatus {
+        case .ready:
+          EmptyView()
+        case .invalidValues:
+          Text("Some settings couldn’t be read. Unavailable values use system defaults.")
+        case .invalidRecord:
+          Text("Saved settings couldn’t be read. Reset to edit them here.")
+        case .unsupportedVersion:
+          Text("These settings were saved by a different app version. Reset to edit them here.")
+        case .unavailable:
+          Text("Saved settings are unavailable. System defaults are in use.")
+        }
+        if settings.saveFailed {
+          Label("Settings couldn’t be saved. Try again.", systemImage: "exclamationmark.circle")
+            .accessibilityIdentifier("settings-save-failed")
+        }
+        Button("Reset settings", role: .destructive) { confirmingReset = true }
+          .accessibilityIdentifier("settings-reset")
+      }
+
+      Section("Offline help") {
+        Text("Projects, drafts, photos and queued changes are stored on this device. The On device tab shows drafts and changes waiting locally. Cloud sync is unavailable.")
+        Text("In an entry, choose a library photo or take one when a camera is available. The site map can show a saved pin offline and request your position when you choose Show my location.")
+        Text("Use Share report from a project to export a copy before removing the app.")
+      }
+      .font(.footnote)
+
+      Section("Support diagnostics") {
+        let diagnostics = FieldLogSupportDiagnostics()
+        LabeledContent("Schema version", value: diagnostics.schemaVersion.formatted())
+        LabeledContent("Platform", value: diagnostics.platform.rawValue)
+        LabeledContent("OS major version", value: diagnostics.osMajorVersion.formatted())
+        LabeledContent("App version", value: diagnostics.appVersion ?? "Unavailable")
+        LabeledContent("Build number", value: diagnostics.buildNumber ?? "Unavailable")
+      }
+    }
+    .navigationTitle("Settings")
+    .confirmationDialog("Reset settings?", isPresented: $confirmingReset, titleVisibility: .visible) {
+      Button("Reset settings", role: .destructive) { settings.reset() }
+    } message: {
+      Text("Restore system appearance, regional formats and text size.")
+    }
+  }
+
+  private func selection<Value>(
+    _ keyPath: WritableKeyPath<FieldLogPreferences, Value>
+  ) -> Binding<Value> {
+    Binding {
+      settings.preferences[keyPath: keyPath]
+    } set: { newValue in
+      var value = settings.preferences
+      value[keyPath: keyPath] = newValue
+      settings.update(value)
+    }
+  }
+}
+
+extension EnvironmentValues {
+  @Entry var fieldLogRegionalFormats: FieldLogPreferences.RegionalFormats = .system
+}
+
+struct FieldLogDate: View {
+  @Environment(\.fieldLogRegionalFormats) private var regionalFormats
+  @Environment(\.locale) private var systemLocale
+  let value: Date
+  let format: Date.FormatStyle
+
+  var body: some View {
+    Text(verbatim: regionalFormats.date(value, format: format, systemLocale: systemLocale))
+  }
+}
+
+struct FieldLogAppearance: ViewModifier {
+  @Environment(\.dynamicTypeSize) private var systemTextSize
+  let preferences: FieldLogPreferences
+
+  func body(content: Content) -> some View {
+    content
+      .preferredColorScheme(preferences.appearance.colorScheme)
+      .dynamicTypeSize(preferences.textSize(following: systemTextSize))
+      .environment(\.fieldLogRegionalFormats, preferences.regionalFormats)
+  }
+}
+
+extension FieldLogPreferences {
+  func textSize(following systemSize: DynamicTypeSize) -> DynamicTypeSize {
+    largerText ? max(systemSize, .xxxLarge) : systemSize
+  }
+}
+
+extension FieldLogPreferences.Appearance {
+  var colorScheme: ColorScheme? {
+    switch self {
+    case .system: nil
+    case .light: .light
+    case .dark: .dark
+    }
+  }
+}
