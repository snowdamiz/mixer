diff --git a/ios/FieldLog/FieldLogPreferences.swift b/ios/FieldLog/FieldLogPreferences.swift
new file mode 100644
index 0000000000000000000000000000000000000000..2096f5eae5a59f6a4a2e94a6855eb423d103cbf5
--- /dev/null
+++ b/ios/FieldLog/FieldLogPreferences.swift
@@ -0,0 +1,163 @@
+import Combine
+import Foundation
+
+struct FieldLogPreferences: Equatable {
+  enum Appearance: String, Codable {
+    case system, light, dark
+  }
+
+  enum RegionalFormats: String, Codable {
+    case system
+    case enUS = "en-US"
+    case frFR = "fr-FR"
+
+    func date(
+      _ value: Date, format: Date.FormatStyle, systemLocale: Locale
+    ) -> String {
+      let locale = self == .system ? systemLocale : Locale(identifier: rawValue)
+      return value.formatted(format.locale(locale))
+    }
+  }
+
+  var appearance: Appearance = .system
+  var regionalFormats: RegionalFormats = .system
+  var largerText = false
+}
+
+@MainActor
+final class FieldLogSettings: ObservableObject {
+  enum LoadStatus: Equatable {
+    case ready, invalidValues, invalidRecord, unsupportedVersion, unavailable
+
+    var allowsEditing: Bool { self == .ready || self == .invalidValues }
+  }
+
+  @Published private(set) var preferences = FieldLogPreferences()
+  @Published private(set) var loadStatus = LoadStatus.ready
+  @Published private(set) var saveFailed = false
+
+  private static let maximumRecordBytes = 1024
+  private let fileURL: URL
+
+  init(fileURL: URL = URL.applicationSupportDirectory.appending(path: "FieldLog-Preferences.json")) {
+    self.fileURL = fileURL
+    load()
+  }
+
+  func update(_ value: FieldLogPreferences) {
+    guard loadStatus.allowsEditing, value != preferences else { return }
+    commit(value)
+  }
+
+  func reset() {
+    commit(FieldLogPreferences())
+  }
+
+  private func load() {
+    let data: Data
+    do {
+      let file = try FileHandle(forReadingFrom: fileURL)
+      defer { try? file.close() }
+      data = try file.read(upToCount: Self.maximumRecordBytes + 1) ?? Data()
+      guard data.count <= Self.maximumRecordBytes else {
+        loadStatus = .invalidRecord
+        return
+      }
+    } catch let error as NSError where error.domain == NSCocoaErrorDomain
+      && error.code == CocoaError.Code.fileNoSuchFile.rawValue {
+      return
+    } catch {
+      loadStatus = .unavailable
+      return
+    }
+
+    do {
+      let record = try JSONDecoder().decode(StoredPreferences.Readback.self, from: data)
+      preferences = record.preferences
+      loadStatus = record.status
+    } catch {
+      loadStatus = .invalidRecord
+    }
+  }
+
+  private func commit(_ value: FieldLogPreferences) {
+    do {
+      let data = try JSONEncoder().encode(StoredPreferences(value))
+      try FileManager.default.createDirectory(
+        at: fileURL.deletingLastPathComponent(), withIntermediateDirectories: true)
+      try data.write(to: fileURL, options: .atomic)
+    } catch {
+      saveFailed = true
+      return
+    }
+    preferences = value
+    loadStatus = .ready
+    saveFailed = false
+  }
+}
+
+private struct StoredPreferences: Encodable {
+  private static let currentVersion = 1
+  let version = currentVersion
+  let appearance: FieldLogPreferences.Appearance
+  let regionalFormats: FieldLogPreferences.RegionalFormats
+  let largerText: Bool
+
+  init(_ preferences: FieldLogPreferences) {
+    appearance = preferences.appearance
+    regionalFormats = preferences.regionalFormats
+    largerText = preferences.largerText
+  }
+
+  private enum CodingKeys: String, CodingKey {
+    case version, appearance, regionalFormats, largerText
+  }
+
+  struct Readback: Decodable {
+    let preferences: FieldLogPreferences
+    let status: FieldLogSettings.LoadStatus
+
+    init(from decoder: Decoder) throws {
+      let fields = try decoder.container(keyedBy: CodingKeys.self)
+      var value = FieldLogPreferences()
+      guard try fields.decode(Int.self, forKey: .version) == StoredPreferences.currentVersion else {
+        preferences = value
+        status = .unsupportedVersion
+        return
+      }
+
+      var invalid = false
+      func read<Value: Decodable>(_ key: CodingKeys, default defaultValue: Value) -> Value {
+        guard fields.contains(key) else { return defaultValue }
+        do {
+          return try fields.decode(Value.self, forKey: key)
+        } catch {
+          invalid = true
+          return defaultValue
+        }
+      }
+
+      value.appearance = read(.appearance, default: value.appearance)
+      value.regionalFormats = read(.regionalFormats, default: value.regionalFormats)
+      value.largerText = read(.largerText, default: value.largerText)
+      preferences = value
+      status = invalid ? .invalidValues : .ready
+    }
+  }
+}
+
+struct FieldLogSupportDiagnostics {
+  enum Platform: String { case iOS }
+
+  let schemaVersion = 1
+  let platform = Platform.iOS
+  let osMajorVersion: Int
+  let appVersion: String?
+  let buildNumber: String?
+
+  init(bundle: Bundle = .main, process: ProcessInfo = .processInfo) {
+    osMajorVersion = process.operatingSystemVersion.majorVersion
+    appVersion = bundle.object(forInfoDictionaryKey: "CFBundleShortVersionString") as? String
+    buildNumber = bundle.object(forInfoDictionaryKey: "CFBundleVersion") as? String
+  }
+}
