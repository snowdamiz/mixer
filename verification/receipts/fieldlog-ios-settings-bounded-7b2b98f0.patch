diff --git a/ios/FieldLogTests/SettingsTests.swift b/ios/FieldLogTests/SettingsTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..c2e38ed168355ad8e16cd41eda6e7114547f3704
--- /dev/null
+++ b/ios/FieldLogTests/SettingsTests.swift
@@ -0,0 +1,244 @@
+import FieldLogModels
+import FieldLogStorage
+import Foundation
+import SwiftUI
+import Testing
+@testable import FieldLogSettingsHost
+
+@MainActor
+struct SettingsTests {
+  @Test func missingRecordUsesDefaultsAndFirstSaveSurvivesColdLoad() throws {
+    let directory = try makeDirectory()
+    defer { try? FileManager.default.removeItem(at: directory) }
+    let record = directory.appending(path: "preferences.json")
+    let settings = FieldLogSettings(fileURL: record)
+    #expect(settings.preferences == FieldLogPreferences())
+    #expect(settings.loadStatus == .ready)
+    #expect(!FileManager.default.fileExists(atPath: record.path))
+
+    settings.update(custom)
+    #expect(!settings.saveFailed)
+    #expect(settings.preferences == custom)
+    #expect(FieldLogSettings(fileURL: record).preferences == custom)
+    let saved = try #require(JSONSerialization.jsonObject(with: Data(contentsOf: record)) as? NSDictionary)
+    #expect(saved == ["version": 1, "appearance": "dark", "regionalFormats": "fr-FR", "largerText": true])
+    #expect(try FileManager.default.contentsOfDirectory(atPath: directory.path) == ["preferences.json"])
+
+    settings.reset()
+    #expect(!settings.saveFailed)
+    #expect(settings.loadStatus == .ready)
+    #expect(settings.preferences == FieldLogPreferences())
+    #expect(FieldLogSettings(fileURL: record).preferences == FieldLogPreferences())
+  }
+
+  @Test(arguments: [
+    #"{"version":1,"regionalFormats":"fr-FR","appearance":"sepia","largerText":1}"#,
+    #"{"version":1,"regionalFormats":"fr-FR","appearance":null,"largerText":"true"}"#,
+  ])
+  func invalidValuesUseTheirDefaultsAndKeepValidValues(json: String) throws {
+    let directory = try makeDirectory()
+    defer { try? FileManager.default.removeItem(at: directory) }
+    let record = directory.appending(path: "preferences.json")
+    let bytes = Data(json.utf8)
+    try bytes.write(to: record)
+    let settings = FieldLogSettings(fileURL: record)
+    #expect(settings.loadStatus == .invalidValues)
+    #expect(settings.preferences == FieldLogPreferences(regionalFormats: .frFR))
+    #expect(try Data(contentsOf: record) == bytes)
+
+    settings.update(custom)
+    #expect(FieldLogSettings(fileURL: record).loadStatus == .ready)
+    #expect(FieldLogSettings(fileURL: record).preferences == custom)
+  }
+
+  @Test func missingFieldsAreDefaultsAndInvalidRegionIsReported() throws {
+    let directory = try makeDirectory()
+    defer { try? FileManager.default.removeItem(at: directory) }
+    let record = directory.appending(path: "preferences.json")
+    try Data(#"{"version":1,"appearance":"light"}"#.utf8).write(to: record)
+    let partial = FieldLogSettings(fileURL: record)
+    #expect(partial.loadStatus == .ready)
+    #expect(partial.preferences == FieldLogPreferences(appearance: .light))
+    try Data(#"{"version":1,"regionalFormats":"en-XX"}"#.utf8).write(to: record)
+    let invalidRegion = FieldLogSettings(fileURL: record)
+    #expect(invalidRegion.loadStatus == .invalidValues)
+    #expect(invalidRegion.preferences == FieldLogPreferences())
+  }
+
+  @Test(arguments: [
+    #"{"version":2,"appearance":"dark","regionalFormats":"fr-FR","largerText":true,"future":[1,2]}"#,
+    #"{"version":999999999999999999999999999,"future":"keep"}"#,
+    #"{"appearance":"light"}"#,
+    "invalid JSON",
+  ])
+  func unrecognizedRecordSurvivesUntilReset(json: String) throws {
+    let directory = try makeDirectory()
+    defer { try? FileManager.default.removeItem(at: directory) }
+    let record = directory.appending(path: "preferences.json")
+    let bytes = Data(json.utf8)
+    try bytes.write(to: record)
+    let settings = FieldLogSettings(fileURL: record)
+    let expected: FieldLogSettings.LoadStatus =
+      json.contains(#""version":2"#) ? .unsupportedVersion : .invalidRecord
+    #expect(settings.loadStatus == expected)
+    #expect(settings.preferences == FieldLogPreferences())
+    settings.update(custom)
+    #expect(settings.preferences == FieldLogPreferences())
+    #expect(try Data(contentsOf: record) == bytes)
+
+    settings.reset()
+    let cold = FieldLogSettings(fileURL: record)
+    #expect(cold.loadStatus == .ready)
+    #expect(cold.preferences == FieldLogPreferences())
+    #expect(try Data(contentsOf: record) != bytes)
+  }
+
+  @Test func oversizedRecordKeepsDefaultsAndIsPreservedUntilReset() throws {
+    let directory = try makeDirectory()
+    defer { try? FileManager.default.removeItem(at: directory) }
+    let record = directory.appending(path: "preferences.json")
+    let bytes = Data(#"{"version":1,"appearance":"dark"}"#.utf8)
+      + Data(repeating: 0x20, count: 1024)
+    try bytes.write(to: record)
+    let settings = FieldLogSettings(fileURL: record)
+    #expect(settings.loadStatus == .invalidRecord)
+    #expect(settings.preferences == FieldLogPreferences())
+
+    settings.update(custom)
+    #expect(try Data(contentsOf: record) == bytes)
+    settings.reset()
+    #expect(FieldLogSettings(fileURL: record).loadStatus == .ready)
+  }
+
+  @Test func writeFailureKeepsLastConfirmedPreferencesAndAllowsRetry() throws {
+    let directory = try makeDirectory()
+    defer { try? FileManager.default.removeItem(at: directory) }
+    let record = directory.appending(path: "preferences.json")
+    let settings = FieldLogSettings(fileURL: record)
+    settings.update(custom)
+    let bytes = try Data(contentsOf: record)
+    let replacement = FieldLogPreferences(appearance: .light, regionalFormats: .enUS)
+
+    let permissions = FileManager.default
+    try permissions.setAttributes([.posixPermissions: 0o500], ofItemAtPath: directory.path)
+    defer { try? permissions.setAttributes([.posixPermissions: 0o700], ofItemAtPath: directory.path) }
+    settings.update(replacement)
+    #expect(settings.saveFailed)
+    #expect(settings.preferences == custom)
+    #expect(try Data(contentsOf: record) == bytes)
+    settings.reset()
+    #expect(settings.saveFailed)
+    #expect(settings.preferences == custom)
+    #expect(try Data(contentsOf: record) == bytes)
+    #expect(FieldLogSettings(fileURL: record).preferences == custom)
+
+    try permissions.setAttributes([.posixPermissions: 0o700], ofItemAtPath: directory.path)
+    settings.update(replacement)
+    #expect(!settings.saveFailed)
+    #expect(settings.preferences == replacement)
+    #expect(FieldLogSettings(fileURL: record).preferences == replacement)
+  }
+
+  @Test func nativeAppearanceAndTextSizeUseSystemAndPreserveHigherSizes() {
+    #expect(FieldLogPreferences.Appearance.system.colorScheme == nil)
+    #expect(FieldLogPreferences.Appearance.light.colorScheme == .light)
+    #expect(FieldLogPreferences.Appearance.dark.colorScheme == .dark)
+    for size in DynamicTypeSize.allCases {
+      #expect(FieldLogPreferences().textSize(following: size) == size)
+      #expect(custom.textSize(following: size) == (size < .xxxLarge ? .xxxLarge : size))
+    }
+  }
+
+  @Test func diagnosticsReadExactlyTheAllowedInstalledMetadata() throws {
+    let directory = try makeDirectory()
+    defer { try? FileManager.default.removeItem(at: directory) }
+    let bundleURL = directory.appending(path: "Fixture.app")
+    let contents = bundleURL.appending(path: "Contents")
+    try FileManager.default.createDirectory(at: contents, withIntermediateDirectories: true)
+    let metadata = [
+      "CFBundleIdentifier": "test.fieldlog.fixture", "CFBundleShortVersionString": "2.4.0",
+      "CFBundleVersion": "518", "PrivateWorkspace": "must never appear in diagnostics",
+    ]
+    try PropertyListSerialization.data(fromPropertyList: metadata, format: .xml, options: 0)
+      .write(to: contents.appending(path: "Info.plist"))
+    let bundle = try #require(Bundle(url: bundleURL))
+    let diagnostics = FieldLogSupportDiagnostics(bundle: bundle)
+    #expect(Set(Mirror(reflecting: diagnostics).children.compactMap(\.label)) == [
+      "schemaVersion", "platform", "osMajorVersion", "appVersion", "buildNumber",
+    ])
+    #expect(diagnostics.schemaVersion == 1)
+    #expect(diagnostics.platform.rawValue == "iOS")
+    #expect(diagnostics.osMajorVersion == ProcessInfo.processInfo.operatingSystemVersion.majorVersion)
+    #expect(diagnostics.appVersion == "2.4.0")
+    #expect(diagnostics.buildNumber == "518")
+  }
+
+  @Test func regionalDisplayAndResetLeaveCommittedWorkspaceAndAttachmentUntouched() async throws {
+    let directory = try makeDirectory()
+    defer { try? FileManager.default.removeItem(at: directory) }
+    let workspaceDirectory = directory.appending(path: "FieldLog")
+    let store = try WorkspaceRepository(directory: workspaceDirectory)
+    let instant = try #require(ISO8601DateFormatter().date(from: "2026-11-23T12:00:00Z"))
+    let project = try await store.transact {
+      try $0.createProject(title: "Site", site: "", now: instant)
+    }
+    let projectID = try #require(project.projects.first?.id)
+    let draft = EntryDraft(projectID: projectID, title: "Entry", note: "Note\n",
+                           occurredAt: instant, updatedAt: instant)
+    _ = try await store.transact { try $0.saveDraft(draft) }
+    let jpeg = Data([0xff, 0xd8, 0xff, 0xd9])
+    _ = try await store.addPhoto(jpeg: jpeg, to: draft.id, now: instant)
+    let remainingDraft = EntryDraft(projectID: projectID, note: "Unsaved note")
+    let before = try await store.transact {
+      try $0.commitDraft(draft.id, now: instant)
+      try $0.saveDraft(remainingDraft)
+      $0.restoration.openDraftID = remainingDraft.id
+    }
+    let entry = try #require(before.entries.first)
+    let change = try #require(before.outbox.last)
+    let attachment = try #require(before.attachments.first)
+    let workspaceFile = workspaceDirectory.appending(path: "workspace.json")
+    let photoFile = workspaceDirectory.appending(path: "photos").appending(path: attachment.filename)
+    let workspaceBytes = try Data(contentsOf: workspaceFile)
+    let photoBytes = try Data(contentsOf: photoFile)
+    #expect(photoBytes == jpeg)
+
+    let settings = FieldLogSettings(fileURL: directory.appending(path: "FieldLog-Preferences.json"))
+    let displayFormat = Date.FormatStyle(
+      timeZone: try #require(TimeZone(secondsFromGMT: 0))
+    ).year().month(.abbreviated).day()
+    let systemLocale = Locale(identifier: "en-GB")
+    func dates() -> [String] {
+      [entry.occurredAt, change.createdAt].map {
+        settings.preferences.regionalFormats.date($0, format: displayFormat, systemLocale: systemLocale)
+      }
+    }
+
+    #expect(dates() == ["23 Nov 2026", "23 Nov 2026"])
+    settings.update(custom)
+    #expect(dates() == ["23 nov. 2026", "23 nov. 2026"])
+    settings.update(FieldLogPreferences(regionalFormats: .enUS))
+    #expect(dates() == ["Nov 23, 2026", "Nov 23, 2026"])
+    settings.reset()
+    #expect(dates() == ["23 Nov 2026", "23 Nov 2026"])
+
+    #expect(try await store.readCommittedSnapshot() == before)
+    #expect(try Data(contentsOf: workspaceFile) == workspaceBytes)
+    #expect(try Data(contentsOf: photoFile) == photoBytes)
+    await store.close()
+    let reopened = try WorkspaceRepository(directory: workspaceDirectory)
+    #expect(try await reopened.readCommittedSnapshot() == before)
+    await reopened.close()
+  }
+
+  private var custom: FieldLogPreferences {
+    FieldLogPreferences(appearance: .dark, regionalFormats: .frFR, largerText: true)
+  }
+
+  private func makeDirectory() throws -> URL {
+    let directory = FileManager.default.temporaryDirectory.appending(path: "settings-\(UUID())")
+    try FileManager.default.createDirectory(
+      at: directory, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+    return directory
+  }
+}
