+      config = Application.fetch_env!(:mixer_hosted, :local_release_target)
+      assert config.target.platform == platform
+      owner = login(api)
+      old = read!(api, owner, config.target, :details_v2)["release"]
+      assert old["sequence"] == to_string(before_data["current_sequence"])
+      assert old["manifestSha256"] == before_data["current_digest"]
+      assert before_data["original_digest"] != old["manifestSha256"]
+      token = access_token!(api, owner)
+      validate = Jason.encode!(%{artifact_sha256: before_data["original_digest"]})
+      assert %{status: 200} =
+        cli_post(api, token, @rollback_cli_base <> "/releases/validate", "restored-good-#{platform}", validate)
+      input = Path.join(System.fetch_env!("MIXER_ROLLBACK_ROOT"), "rollback-#{platform}.json")
+      signed = before_data["signed_rollback"]
+      File.write!(input, signed)
+      cli = System.fetch_env!("MIXER_ROLLBACK_CLI")
+      command = ["update", "rollback", before_data["original_digest"], "--reason", @rollback_reason,
+                 "--channel", config.target.channel, "--organization", "org-a",
+                 "--project", "project-a", "--assignment", input]
+      env = [{"MIXER_RELEASE_ORIGIN", "http://127.0.0.1:#{api.http_port}"},
