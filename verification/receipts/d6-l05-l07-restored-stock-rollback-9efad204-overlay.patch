+import hashlib
+import json
+import os
+from pathlib import Path
+import signal
+import socket
+import subprocess
+import time
+
+WORK = Path(__file__).resolve().parent
+TREE = WORK / "source-tree"
+PG = Path("/opt/homebrew/opt/postgresql@17/bin")
+ENV = {
+    "PATH": f"{PG}:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin",
+    "HOME": str(WORK), "TMPDIR": str(WORK / "tmp"),
+    "LC_ALL": "C", "MIX_ENV": "test", "HEX_OFFLINE": "1", "ERL_FLAGS": "+S 4:4",
+    "GIT_TERMINAL_PROMPT": "0", "GIT_ALLOW_PROTOCOL": "file",
+    "CLANG_MODULE_CACHE_PATH": str(WORK / "clang-cache"),
+}
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+def append(file, data):
+    with (WORK / file).open("a") as stream:
+        stream.write(json.dumps(data, sort_keys=True) + "\n")
+
+def group_absent(pid):
+    deadline = time.monotonic() + 4
+    while True:
+        try:
+            os.killpg(pid, 0)
+        except ProcessLookupError:
+            return True
+        except PermissionError:
+            return False
+        if time.monotonic() >= deadline:
+            return False
+        time.sleep(.05)
+
+def run(name, *command, cwd=WORK, env=None, data=b"", seconds=30, expected=0):
+    args = list(map(str, command))
+    with (WORK / (name + ".stdout")).open("wb") as out, (WORK / (name + ".stderr")).open("wb") as err:
+        child = subprocess.Popen(args, cwd=cwd, env=ENV | (env or {}), stdin=subprocess.PIPE,
+                                 stdout=out, stderr=err, start_new_session=True)
+        append("ownership.jsonl", {"name": name, "pidPgid": child.pid})
+        timeout = False
+        try:
+            child.communicate(input=data, timeout=seconds)
+        except subprocess.TimeoutExpired:
+            timeout = True
+            # No assumption about descendants on a timeout. Preserve and stop.
+    closed = not timeout and group_absent(child.pid)
+    fact = {"name": name, "argv": args, "pidPgid": child.pid, "exit": child.returncode,
+            "groupAbsent": closed, "timeout": timeout}
+    if not closed:
+        append("HOLD.jsonl", fact)
+        raise RuntimeError(f"{name} custody unconfirmed")
+    out = (WORK / (name + ".stdout")).read_bytes()
+    err = (WORK / (name + ".stderr")).read_bytes()
+    append("commands.jsonl", fact | {"stdoutSha256": digest(out), "stderrSha256": digest(err)})
+    if child.returncode != expected:
+        raise RuntimeError(f"{name} exit {child.returncode}; see owned logs")
+    return out
+
+def listener(port=0):
+    with socket.socket() as sock:
+        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+        sock.bind(("127.0.0.1", port))
+        return sock.getsockname()[1]
+
+if __name__ == "__main__":
+    os.umask(0o077)
+    run("swift-version", "swift", "--version")
+    run("cli-build", "swift", "build", "--product", "mixer", "--jobs", "8",
+        "--cache-path", WORK / "swift-cache", "--manifest-cache", "local",
+        "--disable-index-store", "--skip-update", "--only-use-versions-from-resolved-file",
+        cwd=TREE / "cli", seconds=360)
