+        require("host|127.0.0.1|scram-sha-256" in auth, "unexpected DB authentication")
+        run(f"{self.phase}-wrong-password", PG / "psql", *self.conn, "-XqAt", "-d", "postgres",
+            "-c", "SELECT 1", env=self.env | {"PGPASSWORD": secrets.token_hex(24)}, expected=2)
+        wrong = (WORK / f"{self.phase}-wrong-password.stderr").read_text()
+        require("password authentication failed" in wrong, "wrong password control failed")
+        return {"systemIdentifier": identifier, "authentication": auth.splitlines(),
+                "wrongPasswordRefused": True, "port": self.port}
+
+    @property
+    def conn(self):
+        return ["-h", HOST, "-p", str(self.port), "-U", BOOT, "-w"]
+
+    def sql(self, name, statement, database=DB):
+        return run(f"{self.phase}-{name}", PG / "psql", *self.conn, "-XqAt", "-v",
+                   "ON_ERROR_STOP=1", "-d", database, data=statement.encode(), env=self.env).decode().strip()
+
+    def passwords(self, roles):
+        self.sql("passwords", "".join(
+            f"ALTER ROLE {r} PASSWORD '{PASSWORDS[r]}';\n" for r in roles), "postgres")
+
+    def fixture(self, line, name):
+        catalog = self.dir / "catalog"
+        catalog.mkdir()
+        ports = self.dir / "listeners"
+        out = run(f"{self.phase}-{name}", "mix", "test", "--warnings-as-errors", "--trace",
+                  "--no-color", "--seed", "0", "--timeout", "90000", f"{TEST}:{line}",
+                  cwd=TREE / "hosted", seconds=115, env=self.env | {
+                      "MIXER_BROWSER_STORAGE_PORT": str(self.port),
+                      "MIXER_BROWSER_CATALOG_FIXTURE_ROOT": str(catalog),
+                      "MIXER_ROLLBACK_PHASE": self.phase,
+                      "MIXER_ROLLBACK_LISTENERS": str(ports),
+                      "MIXER_ROLLBACK_ROOT": str(ROOT),
+                      "MIXER_ROLLBACK_CLI": str((TREE / "cli/.build/debug/mixer").resolve()),
+                  } | {"MIXER_ROLLBACK_PASSWORD_" + role: p for role, p in PASSWORDS.items()})
+        require("Result: 1 passed" in out.decode(), "fixture did not report one passing test")
+        return [tuple(line.split()) for line in ports.read_text().splitlines()]
+
+    def close(self):
+        if self.child is None:
+            return
+        try:
+            if self.child.poll() is None:
+                self.child.send_signal(signal.SIGINT)
+            self.child.wait(timeout=15)
+            self.child.stdin.close()
+            require(group_absent(self.child.pid), "PostgreSQL group did not close")
+            require(not (self.pgdata / "postmaster.pid").exists(), "PostgreSQL pidfile remains")
+        except BaseException:
+            append("HOLD.jsonl", {"name": f"{self.phase}-postgres", "pidPgid": self.child.pid})
+            raise
+        append("commands.jsonl", {"name": f"{self.phase}-postgres", "pidPgid": self.child.pid,
+                                  "exit": self.child.returncode, "groupAbsent": True})
+        owned_ports = [("postgres", str(self.port))]
+        if (self.dir / "listeners").exists() and not (WORK / "HOLD.jsonl").exists():
+            owned_ports += [tuple(row.split()) for row in (self.dir / "listeners").read_text().splitlines()]
+        for name, port in owned_ports:
+            listener(int(port))
+            append("rebinds.jsonl", {"phase": self.phase, "service": name, "port": int(port),
+                                    "rebound": True})
+        require(self.child.returncode == 0, "PostgreSQL did not exit cleanly")
+
+def exercise():
+    os.umask(0o077)
+    ROOT.mkdir()
+    ver = {}
+    for tool in ["postgres", "pg_dump", "pg_dumpall", "pg_restore", "psql", "mix"]:
+        ver[tool] = run(tool + "-version", tool, "--version").decode().strip()
+    require(all("17." in ver[t] for t in ("postgres", "pg_dump", "pg_dumpall", "pg_restore", "psql")),
+            "PostgreSQL tool major mismatch")
+    text = (TREE / "hosted" / TEST).read_text().splitlines()
+    def line(fragment):
+        return next(i for i, s in enumerate(text, 1) if f'test "{fragment}' in s)
+    source = Cluster("source")
+    try:
+        source_facts = source.start()
+        source.sql("bootstrap", BOOTSTRAP, "postgres")
+        source.passwords(["browser_admin", "browser_lifecycle", "browser_ordinary"])
+        source.fixture(line("freezes a two-platform"), "freeze")
+        acls = source.sql("effective-table-acls", ACL)
+        roles = source.sql("role-snapshot", ROLE_STATE)
+        active = source.sql("frozen", "SELECT count(*) FROM pg_stat_activity WHERE datname=current_database() AND pid <> pg_backend_pid();")
+        require(active == "0", "source database has remaining client sessions")
+        roles_sql = run("source-dump-roles", PG / "pg_dumpall", *source.conn, "--roles-only",
+                        "--no-role-passwords", env=source.env)
+        require(roles_sql.count(b"CREATE ROLE mixer_fixture;\n") == 1, "unexpected fixture bootstrap DDL")
+        dump = WORK / "frozen.dump"
+        run("source-pg-dump", PG / "pg_dump", *source.conn, "--format=custom",
+            "--create", "--file", dump, DB, env=source.env, seconds=30)
+    finally:
+        source.close()
+    target = Cluster("restore")
+    try:
+        target_facts = target.start()
+        require(target_facts["systemIdentifier"] != source_facts["systemIdentifier"], "system identifiers match")
+        run("restore-roles", PG / "psql", *target.conn, "-XqAt", "-v", "ON_ERROR_STOP=1",
+            "-d", "postgres", env=target.env,
+            data=roles_sql.replace(b"CREATE ROLE mixer_fixture;\n", b""))
+        target.passwords(["browser_admin", "browser_lifecycle", "browser_ordinary",
+                          "mixer_release_delivery", "mixer_release_processor"])
+        run("restore-pg-restore", PG / "pg_restore", *target.conn, "--exit-on-error", "--create",
+            "--dbname", "postgres", dump, env=target.env, seconds=30)
+        for label, item in [("authz-repair", REPAIR), ("artifact-key-repair", KEY)]:
+            run("restore-" + label, PG / "psql", *target.conn, "-XqAt", "-v", "ON_ERROR_STOP=1",
+                "-d", DB, "-f", TREE / item, env=target.env)
+        require(target.sql("effective-table-acls", ACL) == acls, "effective table ACLs differ")
+        require(target.sql("role-snapshot", ROLE_STATE) == roles, "restored role properties differ")
+        require(target.sql("credential-mechanism", """
+            SELECT count(*) FROM pg_authid WHERE rolname IN ('mixer_release_processor',
+            'mixer_release_delivery','browser_ordinary','browser_lifecycle','browser_admin')
+            AND rolpassword LIKE 'SCRAM-SHA-256$%';
+        """, "postgres") == "5", "runtime credentials are not SCRAM")
+        target.fixture(line("runs stock rollback twice"), "rollback")
+    finally:
+        target.close()
+    details = {
+        "postgres": {"source": source_facts, "restore": target_facts,
+                     "effectiveTableAclRows": len(acls.splitlines()),
+                     "rolesAndMembershipsMatch": True, "fiveRestoredScramCredentials": True,
+                     "sourceFrozenClientConnections": 0, "dumpSha256": digest(dump.read_bytes()),
+                     "dumpBytes": dump.stat().st_size},
+        "tools": ver,
+        "countsOrder": ["heads", "publications", "promotionBindings", "cliRequests",
+                        "artifacts", "jobs", "projections"],
