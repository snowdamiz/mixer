+                permissionCode = activity.requestSiteMapPermission(this, new String[]{FINE, COARSE});
+                locationStatus.setText("Waiting for location permission…");
+            } catch (RuntimeException unavailable) {
+                permissionCode = 0;
+                locationStatus.setText("Location permission unavailable.");
+            }
+            updateControls();
+        }
+    }
+
+    boolean permissionResult(int code) {
+        if (permissionCode == 0 || permissionCode != code || retired) return false;
+        permissionCode = 0;
+        permittedResult = has(COARSE) || has(FINE);
+        if (!permittedResult) locationStatus.setText("Location permission denied.");
+        foregroundChanged();
+        updateControls();
+        return true;
+    }
+
+    void foregroundChanged() {
+        if (permittedResult && activity.siteMapForeground(this)) {
+            permittedResult = false;
+            startSampling();
+        }
+    }
+
+    private boolean has(String permission) {
+        return activity.checkSelfPermission(permission) == PackageManager.PERMISSION_GRANTED;
+    }
+
+    private void startSampling() {
+        LocationManager manager = activity.getSystemService(LocationManager.class);
+        if (manager == null) {
+            locationStatus.setText("Current position unavailable.");
+            updateControls();
+            return;
+        }
+        CancellationSignal request = new CancellationSignal();
+        try {
+            String provider = LocationManager.GPS_PROVIDER;
+            if (!manager.isLocationEnabled() || !manager.isProviderEnabled(provider)) {
+                locationStatus.setText("Device location is off or GPS is unavailable.");
+                updateControls();
+                return;
+            }
+            sampling = request;
+            locationStatus.setText("Finding current position…");
+            updateControls();
+            var settings = new LocationRequest.Builder(0).setDurationMillis(FIX_WINDOW_MS).build();
+            manager.getCurrentLocation(provider, settings, request, activity.getMainExecutor(),
+                location -> acceptFix(request, location));
+            if (!handler.postDelayed(deadline, FIX_WINDOW_MS + 1_000)) acceptFix(request, null);
+        } catch (SecurityException denied) {
+            acceptFixOrFailure(request, "Location permission unavailable.");
+        } catch (IllegalArgumentException | IllegalStateException unavailable) {
+            acceptFixOrFailure(request, "Current position unavailable.");
+        }
+    }
+
+    private final Runnable deadline = () -> acceptFix(sampling, null);
+
+    private void acceptFixOrFailure(CancellationSignal request, String message) {
+        if (sampling == request) cancelSampling();
+        locationStatus.setText(message);
+        updateControls();
+    }
+
+    private void acceptFix(CancellationSignal request, Location location) {
+        if (request == null || sampling != request) return;
+        cancelSampling();
+        if (!activity.siteMapForeground(this)) {
+            locationStatus.setText("");
+            updateControls();
+            return;
+        }
+        deliveringFix = true;
+        try {
+            double accuracy = location != null && location.hasAccuracy() ? location.getAccuracy() : -1;
+            int result = location == null ? PublicBridge.MAP_REFUSED
+                : send(FIX, EMPTY, location.getLatitude(), location.getLongitude(), accuracy);
+            if (result == PublicBridge.MAP_OK && map.scene != null) {
+                locationStatus.setText(locationSummary(map.scene, location.getLatitude(), location.getLongitude(), accuracy));
+            } else {
+                locationStatus.setText("No current position available.");
+            }
+        } finally {
+            deliveringFix = false;
+            updateControls();
+        }
+    }
+
+    static String locationSummary(Scene scene, double latitude, double longitude, double accuracy) {
+        StringBuilder summary = new StringBuilder(scene.fix
+            ? "Current position shown in blue." : "Current position is outside this map.");
+        if (scene.site) {
+            double pinLat = Math.toRadians(scene.latitude / 10_000_000.0);
+            double fixLat = Math.toRadians(latitude);
+            double deltaLon = Math.toRadians(Math.IEEEremainder(longitude - scene.longitude / 10_000_000.0, 360));
+            double east = Math.sin(deltaLon) * Math.cos(fixLat);
+            double north = Math.cos(pinLat) * Math.sin(fixLat)
+                - Math.sin(pinLat) * Math.cos(fixLat) * Math.cos(deltaLon);
+            if (Math.hypot(east, north) < 1e-9) {
+                double dot = Math.sin(pinLat) * Math.sin(fixLat)
+                    + Math.cos(pinLat) * Math.cos(fixLat) * Math.cos(deltaLon);
+                summary.append(dot > 0 ? " At the saved pin." : " Direction from the saved pin is unavailable.");
+            } else {
+                String[] directions = {"North", "Northeast", "East", "Southeast", "South", "Southwest", "West", "Northwest"};
+                int sector = (int) Math.round(Math.atan2(east, north) / (Math.PI / 4));
+                summary.append(' ').append(directions[Math.floorMod(sector, directions.length)])
+                    .append(" of the saved pin.");
+            }
+        }
+        if (accuracy >= 0) {
+            summary.append(String.format(Locale.ROOT, " Accuracy ±%.1f meters.", accuracy));
+        }
+        return summary.toString();
+    }
+
+    private void cancelSampling() {
+        handler.removeCallbacks(deadline);
+        CancellationSignal previous = sampling;
+        sampling = null;
+        if (previous != null) previous.cancel();
+    }
+
+    private void setPin() {
+        try {
+            double lat = parseCoordinate(latitude), lon = parseCoordinate(longitude);
+            if (!(lat >= -90 && lat <= 90 && lon >= -180 && lon <= 180)) throw new NumberFormatException();
+            editPin(SET, lat, lon);
+        } catch (NumberFormatException invalid) {
+            pinStatus.setText("Enter latitude from −90 to 90 and longitude from −180 to 180.");
+        }
+    }
+
+    private static double parseCoordinate(EditText field) {
+        String value = field.getText().toString().trim().replace(',', '.').replace('−', '-');
+        if (value.length() > 24 || !value.matches("[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)")) {
+            throw new NumberFormatException();
+        }
+        return Double.parseDouble(value);
+    }
+
+    private void editPin(int operation, double lat, double lon) {
+        if (base == null || !activity.siteMapForeground(this)) return;
+        cancelSampling();
+        permissionCode = 0;
+        permittedResult = false;
+        display(base);
+        locationStatus.setText("");
+        hideKeyboard();
+        int result = send(operation, EMPTY, lat, lon, 0);
+        if (result == PublicBridge.MAP_OK) {
+            pinStatus.setText(operation == SET ? "Site pin saved on this device." : "Site pin cleared.");
+        } else if (result == PublicBridge.MAP_REFUSED) {
+            pinStatus.setText("The site pin change was refused.");
+        }
+        updateControls();
+    }
+
+    void pause() {
+        cancelSampling();
+        if (base != null && !recoveryRequired) display(base);
+        if (permissionCode == 0 && !permittedResult) locationStatus.setText("");
+        updateControls();
+    }
+
+    void stop() {
+        permissionCode = 0;
+        permittedResult = false;
+        pause();
+    }
+
+    void retire() {
+        retired = true;
+        stop();
+        base = null;
+        map.show(null);
+    }
+
+    void close() {
+        if (retired || recoveryRequired || closing || !activity.siteMapForeground(this)) return;
+        closing = true;
+        try {
+            hideKeyboard();
+            int result = send(CLOSE, EMPTY, 0, 0, 0);
+            if (result == PublicBridge.MAP_OK && activity.closeSiteMap(this)) return;
+            if (result == PublicBridge.MAP_REFUSED) {
+                pinStatus.setText("The project could not reopen. Try Back to project again.");
+            } else if (result == PublicBridge.MAP_OK) {
+                requireRecovery(CLOSE);
+            }
+        } finally {
+            closing = false;
+        }
+    }
+
+    boolean closing() { return closing; }
+    boolean recoveryRequired() { return recoveryRequired; }
+
+    private void restart() {
+        if (!recoveryRequired || !activity.siteMapForeground(this)) return;
+        int result = activity.restartSiteMap(this);
+        if (result == PublicBridge.MAP_UNCERTAIN) {
+            pinStatus.setText("The previous workspace is still open. Tap Restart FieldLog again or use app settings.");
+            appSettings.setVisibility(VISIBLE);
+        } else if (result == PublicBridge.MAP_REFUSED) {
+            pinStatus.setText("Open app settings, tap Force stop, then launch FieldLog and open Site map to check the saved pin.");
+            restart.setEnabled(false);
+            appSettings.setVisibility(VISIBLE);
+        }
+    }
+
+    private void openAppSettings() {
+        if (!recoveryRequired || !activity.siteMapForeground(this)) return;
+        pinStatus.setText("In app settings, tap Force stop, then launch FieldLog and open Site map to check the saved pin.");
+        activity.startActivity(new Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS,
+            Uri.fromParts("package", activity.getPackageName(), null)));
+    }
+
+    private void hideKeyboard() {
+        InputMethodManager keyboard = activity.getSystemService(InputMethodManager.class);
+        if (keyboard != null) keyboard.hideSoftInputFromWindow(getWindowToken(), 0);
+        latitude.clearFocus();
+        longitude.clearFocus();
+    }
+
+    private int send(int operation, byte[] bytes, double lat, double lon, double accuracy) {
+        if (recoveryRequired) return PublicBridge.MAP_UNCERTAIN;
+        int result = PublicBridge.siteMap(context, token, operation, bytes, lat, lon, accuracy);
+        if (result == PublicBridge.MAP_UNCERTAIN) requireRecovery(operation);
+        return result;
+    }
+
+    private void requireRecovery(int operation) {
+        recoveryRequired = true;
+        cancelSampling();
+        permissionCode = 0;
+        permittedResult = false;
+        map.show(null);
+        mapStatus.setText("The saved map is unavailable until FieldLog restarts.");
+        pinStatus.setText(operation == SET || operation == CLEAR
+            ? "The site pin save outcome is unknown. Restart FieldLog, then open Site map to check the saved pin."
+            : "Restart FieldLog to reopen the project.");
+        updateControls();
+    }
+
+    private void updateControls() {
+        boolean pending = sampling != null || permissionCode != 0 || permittedResult;
+        boolean available = base != null && !retired && !recoveryRequired;
+        back.setEnabled(!recoveryRequired);
+        restart.setVisibility(recoveryRequired ? VISIBLE : GONE);
+        locate.setEnabled(available);
+        locate.setText(pending ? "Cancel location request" : "Show current position");
+        latitude.setEnabled(available);
+        longitude.setEnabled(available);
+        setPin.setEnabled(available);
+        clearPin.setEnabled(available && base.site);
+    }
+
+    private static String decimal(int e7) { return String.format(Locale.ROOT, "%.7f", e7 / 10_000_000.0); }
+    private int dp(int value) { return Math.round(value * getResources().getDisplayMetrics().density); }
+
+    private TextView text(LinearLayout parent, String text) {
+        TextView view = new TextView(activity);
+        view.setText(text);
+        view.setTextColor(INK);
+        parent.addView(view);
+        return view;
+    }
+
+    private Button button(LinearLayout parent, String label, Runnable action) {
+        Button view = new Button(activity);
+        view.setAllCaps(false);
+        view.setText(label);
+        view.setOnClickListener(ignored -> action.run());
+        parent.addView(view);
+        return view;
+    }
+
+    private EditText coordinate(LinearLayout parent, String label, String hint) {
+        EditText view = new EditText(activity);
+        view.setId(View.generateViewId());
+        text(parent, label).setLabelFor(view.getId());
+        view.setHint(hint);
+        view.setSingleLine();
+        view.setInputType(InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_FLAG_SIGNED
+            | InputType.TYPE_NUMBER_FLAG_DECIMAL);
+        view.setFilters(new android.text.InputFilter[]{new android.text.InputFilter.LengthFilter(24)});
+        parent.addView(view, new LinearLayout.LayoutParams(-1, -2));
+        return view;
+    }
+
+    static final class Scene {
+        private static final int HEADER = 40, SEGMENT = 17;
+        final boolean site, centered, fix, accuracy;
+        final int latitude, longitude, scale;
+        final float scaleFraction, x, y, radius;
+        final byte[] layers;
+        final float[] lines;
+
+        private Scene(ByteBuffer data) {
+            if (data.remaining() < HEADER || data.getInt() != 0x314d4c46) throw invalid();
+            int flags = data.getInt();
+            site = (flags & 1) != 0;
+            centered = (flags & 2) != 0;
+            fix = (flags & 4) != 0;
+            accuracy = (flags & 8) != 0;
+            latitude = data.getInt();
+            longitude = data.getInt();
+            scale = data.getInt();
+            scaleFraction = unit(data.getFloat());
+            x = unit(data.getFloat());
+            y = unit(data.getFloat());
+            radius = data.getFloat();
+            int count = data.getInt();
+            if ((flags & ~15) != 0 || ((fix || site) && !centered) || (accuracy && !fix)
+                    || !(radius >= 0 && radius <= 1003) || (!accuracy && radius != 0)
+                    || (!fix && (x != 0 || y != 0)) || (!site && (latitude != 0 || longitude != 0))
+                    || latitude < -900_000_000 || latitude > 900_000_000
+                    || longitude < -1_800_000_000 || longitude >= 1_800_000_000
+                    || (centered ? scale <= 0 || scaleFraction <= 0 : scale != 0 || scaleFraction != 0 || count != 0)
+                    || count < 0 || count > 24_000 || data.remaining() != count * SEGMENT) throw invalid();
+            layers = new byte[count];
+            lines = new float[count * 4];
+            for (int index = 0; index < count; index++) {
+                byte layer = data.get();
+                if (layer < 1 || layer > 3) throw invalid();
+                layers[index] = layer;
+                for (int word = 0; word < 4; word++) lines[index * 4 + word] = unit(data.getFloat());
+            }
+        }
+
+        static Scene decode(byte[] packet) { return new Scene(ByteBuffer.wrap(packet).order(ByteOrder.LITTLE_ENDIAN)); }
+        private static IllegalArgumentException invalid() { return new IllegalArgumentException("Invalid site map scene"); }
+        private static float unit(float value) {
+            if (!(value >= 0 && value <= 1)) throw invalid();
+            return value;
+        }
+    }
+
+    private final class MapCanvas extends View {
+        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Path[] paths = {new Path(), new Path(), new Path()};
+        private Scene scene;
+
+        MapCanvas(Context context) {
+            super(context);
+            setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_YES);
+            show(null);
+        }
+
+        @Override protected void onMeasure(int widthSpec, int heightSpec) {
+            int width = MeasureSpec.getSize(widthSpec);
+            setMeasuredDimension(width, resolveSize(Math.min(width, dp(360)), heightSpec));
+        }
+
+        void show(Scene value) {
+            scene = value;
+            if (value != null && value.centered) {
+                String markers = (value.site ? "Saved site pin" : "No saved site pin")
+                    + (value.fix ? ", current position" : "");
+                setContentDescription("Offline site map. " + markers + ". Scale " + value.scale / 1000 + " kilometers.");
+            } else {
+                setContentDescription("Offline site map. No position shown.");
+            }
+            invalidate();
+        }
+
+        @Override protected void onDraw(Canvas canvas) {
+            super.onDraw(canvas);
+            float size = Math.min(getWidth(), getHeight());
+            float left = (getWidth() - size) / 2;
+            canvas.save();
+            canvas.translate(left, 0);
+            canvas.clipRect(0, 0, size, size);
+            canvas.drawColor(LAND);
+            Scene value = scene;
+            if (value != null && value.centered) drawScene(canvas, value, size);
+            canvas.restore();
+        }
+
+        private void drawScene(Canvas canvas, Scene value, float size) {
+            for (Path path : paths) path.rewind();
+            for (int index = 0; index < value.layers.length; index++) {
+                Path path = paths[value.layers[index] - 1];
+                int offset = index * 4;
+                path.moveTo(value.lines[offset] * size, value.lines[offset + 1] * size);
+                path.lineTo(value.lines[offset + 2] * size, value.lines[offset + 3] * size);
+            }
+            paint.setStyle(Paint.Style.STROKE);
+            paint.setStrokeWidth(dp(1));
+            paint.setColor(0xff426454);
+            canvas.drawPath(paths[0], paint);
+            paint.setColor(0xff227491);
+            canvas.drawPath(paths[1], paint);
+            canvas.drawPath(paths[2], paint);
+            paint.setStyle(Paint.Style.FILL);
+            if (value.accuracy) {
+                paint.setColor(0x29145bc0);
+                canvas.drawCircle(value.x * size, value.y * size, value.radius * size, paint);
+            }
+            if (value.site) marker(canvas, PIN, size / 2, size / 2, dp(9));
+            if (value.fix) marker(canvas, FIX_DOT, value.x * size, value.y * size, dp(5));
+            paint.setColor(INK);
+            paint.setStrokeWidth(dp(2));
+            paint.setTextSize(dp(12));
+            int pad = dp(12);
+            float bar = size - pad;
+            canvas.drawText(value.scale / 1000 + " km", pad, bar - dp(5), paint);
+            canvas.drawLine(pad, bar, pad + value.scaleFraction * size, bar, paint);
+            canvas.drawText("N", size - 2 * pad, 2 * pad, paint);
+        }
+
+        private void marker(Canvas canvas, int color, float x, float y, int radius) {
+            paint.setColor(Color.WHITE);
+            canvas.drawCircle(x, y, radius + dp(2), paint);
+            paint.setColor(color);
+            canvas.drawCircle(x, y, radius, paint);
+        }
+    }
+}
