+    SiteMapPanel(PublicActivity activity, long context, byte[] token) {
+        super(activity);
+        this.activity = activity;
+        this.context = context;
+        this.token = token.clone();
+        setFillViewport(true);
+        setBackgroundColor(0xfff8faf6);
+        setAccessibilityPaneTitle("Site map");
+        setSaveFromParentEnabled(false);
