+@MainActor final class AndroidSiteMapRoute {
+    let id = UUID()
+    let projectID: UUID
+    let frameRevision: UInt64
+    var workspaceRevision: UInt64
+    var pin: SiteCoordinate?
+    var geography: SiteMapGeography?
+
+    init(project: Project, frameRevision: UInt64, workspaceRevision: UInt64) {
+        projectID = project.id
+        self.frameRevision = frameRevision
+        self.workspaceRevision = workspaceRevision
+        pin = project.siteCoordinate
+    }
+
+    /// Little-endian FLM1. Only the saved pin is serialized as a coordinate;
+    /// foreground location is represented by normalized drawing primitives.
+    func packet(site: SiteCoordinate?, fix: SiteMapFix? = nil) throws -> Data {
+        guard let geography else { throw PublicHostError.action }
+        let scene = try SiteMapScene.project(site: site, fix: fix, geography: geography)
+        var data = Data("FLM1".utf8)
+        func word(_ value: UInt32) {
+            var encoded = value.littleEndian
+            withUnsafeBytes(of: &encoded) { data.append(contentsOf: $0) }
+        }
+        func number(_ value: Double) { word(Float(value).bitPattern) }
+        let marker = scene?.fix
+        word((site == nil ? 0 : 1) | (scene == nil ? 0 : 2) | (marker == nil ? 0 : 4)
+            | (marker?.accuracyRadius == nil ? 0 : 8))
+        word(UInt32(bitPattern: site?.latitudeE7 ?? 0))
+        word(UInt32(bitPattern: site?.longitudeE7 ?? 0))
+        word(UInt32(scene?.scale.meters ?? 0))
+        number(scene?.scale.fractionOfWidth ?? 0)
+        number(marker?.point.x ?? 0)
+        number(marker?.point.y ?? 0)
+        number(marker?.accuracyRadius ?? 0)
+        word(UInt32(scene?.segments.count ?? 0))
+        for segment in scene?.segments ?? [] {
+            data.append(segment.layer.rawValue)
+            number(segment.from.x)
+            number(segment.from.y)
+            number(segment.to.x)
+            number(segment.to.y)
+        }
+        return data
+    }
+}
+
+enum AndroidSiteMapCommand {
+    case load(Data)
+    case showFix(SiteMapFix)
+    case setPin(SiteCoordinate)
+    case clearPin
+    case close
+}
