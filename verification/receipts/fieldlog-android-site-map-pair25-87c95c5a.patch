+        raise ValueError("Expected an immutable SiteMap asset directory")
+    pins = {
+        "natural-earth-50m.flg": (860_633, "1c4a6e6add0fa4d3b7628a59d9bc2cde8782dad9fe4d135985fa153e12514379"),
+        "README.md": (4_416, "7d72b9362b1d357635a6af735d452e1d01bf4aec2d5d9e3142958ce4b35fc1b9"),
+    }
+    if {child.name for child in directory.iterdir()} != pins.keys():
+        raise ValueError("Unexpected SiteMap assets")
+    result = {}
+    for name, (size, digest) in pins.items():
+        data = read_bounded(directory / name, size)
+        if len(data) != size or hashlib.sha256(data).hexdigest() != digest:
+            raise ValueError("SiteMap asset differs from its pinned source")
+        result["assets/SiteMap/" + name] = data
+    return result
+
