+package dev.fieldlog.generatedr90.androidhost;
+
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import java.util.ArrayList;
+
+/** In-window modal layer. The V4 root keeps its attachment, visibility and layout. */
+final class SiteMapOverlay extends FrameLayout {
+    private record Background(View view, int accessibility, int focusable, int descendantFocusability) {
+        Background(View view) {
+            this(view, view.getImportantForAccessibility(), view.getFocusable(),
+                view instanceof ViewGroup group ? group.getDescendantFocusability() : 0);
+        }
+
+        void block() {
+            view.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS);
+            if (view instanceof ViewGroup group) group.setDescendantFocusability(FOCUS_BLOCK_DESCENDANTS);
+            view.setFocusable(View.NOT_FOCUSABLE);
+        }
+
+        void restore() {
+            view.setFocusable(focusable);
+            if (view instanceof ViewGroup group) group.setDescendantFocusability(descendantFocusability);
+            view.setImportantForAccessibility(accessibility);
+        }
+    }
+
+    private final FrameLayout host;
+    private final View previousFocus;
+    private final ArrayList<Background> background = new ArrayList<>();
+
+    SiteMapOverlay(FrameLayout host, View panel) {
+        super(host.getContext());
+        this.host = host;
+        previousFocus = host.findFocus();
+        for (int index = 0; index < host.getChildCount(); index++) {
+            background.add(new Background(host.getChildAt(index)));
+        }
+        // The full-screen panel is opaque. Its container catches unhandled pointer events.
+        addView(panel, new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT));
+        host.addView(this, new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT));
+        for (Background child : background) child.block();
+        if (previousFocus != null && previousFocus.isFocused()) previousFocus.clearFocus();
+        panel.requestFocus();
+    }
+
+    void dismiss(boolean restoreFocus) {
+        host.removeView(this);
+        for (Background child : background) child.restore();
+        if (restoreFocus && previousFocus != null && previousFocus.isAttachedToWindow()
+                && previousFocus.isShown()) previousFocus.requestFocus();
+    }
+
+    @Override public boolean onTouchEvent(MotionEvent event) { return true; }
+    @Override public boolean onHoverEvent(MotionEvent event) { return true; }
+    @Override public boolean onGenericMotionEvent(MotionEvent event) { return true; }
+}
