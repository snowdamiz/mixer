  "finding": {
    "priority": "P1",
    "id": "fixture-final-stop-interception",
    "path": "verification/local/cache-fixture-contract-r3826/afterimages/verification/cache-descendant-custody-contract-v1/test_original.py",
    "lines": [
      118,
      127
    ],
    "summary": "The final real stop call is outside kernel interception and after the no-operations snapshot assertion.",
    "evidence": "At lines118-125 the fixture snapshots and checks operation counts. The ExitStack restoring kernel mocks exits before line127. Line127 only asserts RuntimeError from c.stop. A stop implementation that polls the synthetic process and then raises at the existing UNKNOWN guard satisfies this final assertion, because no later count comparison exists. A regression that bypasses those guards can reach restored real os.killpg with PID987654.",
    "requiredChange": "Keep before-effect kernel/exit/constructor interceptors active through the real stop call, assert the complete operation snapshot after that call, and include the resource-accounting snapshot. Preserve the changed sticky-UNKNOWN contract and all production guards.",
    "basis": "Independent source evidence; single attempted pure discriminator failed during harness construction before any scenario or mutation ran. No runtime reproduction claimed."
  },
