index 0000000000000000000000000000000000000000..ff887141df5f80ad1f4aeea3a851f36d2e10e0d8
--- /dev/null
+++ b/Tests/FieldLogTests/ChecklistRowTests.swift
@@ -0,0 +1,37 @@
+import FieldLogFeatures
+import FieldLogModels
+import Foundation
+import Testing
+
+@Test func checklistRowsPreserveProjectOrderAndExposeGlobalMoveEligibility() throws {
+  let project = Project(title: "Checklist")
+  let other = Project(title: "Another checklist")
+  let firstID = try #require(UUID(uuidString: "00000000-0000-0000-0000-000000000001"))
+  let secondID = try #require(UUID(uuidString: "00000000-0000-0000-0000-000000000002"))
+  let first = WorkTask(
+    id: firstID, projectID: project.id, title: "Same title", responsible: "  日本語  ",
+    completed: true, position: 3)
+  let second = WorkTask(id: secondID, projectID: project.id, title: "Same title", position: 3)
+  let last = WorkTask(projectID: project.id, title: "Later", position: 9)
+  let foreign = WorkTask(projectID: other.id, title: "Other", completed: true)
+  var workspace = Workspace()
+  workspace.projects = [project, other]
+  workspace.tasks = [last, second, foreign, first]
+  try workspace.validate()
+
+  let rows = ChecklistRow.rows(in: workspace, projectID: project.id)
+  #expect(rows.map(\.id) == [first.id, second.id, last.id])
+  #expect(rows.map(\.title) == ["Same title", "Same title", "Later"])
+  #expect(rows.map(\.responsible) == ["  日本語  ", "", ""])
+  #expect(rows.map(\.completed) == [true, false, false])
+  #expect(rows.map(\.number) == [1, 2, 3])
+  #expect(rows.map(\.canMoveUp) == [false, true, true])
+  #expect(rows.map(\.canMoveDown) == [true, true, false])
+
+  let otherRows = ChecklistRow.rows(in: workspace, projectID: other.id)
+  #expect(otherRows.count == 1)
+  let lone = try #require(otherRows.first)
+  #expect(lone.id == foreign.id)
+  #expect(lone.number == 1 && lone.completed && !lone.canMoveUp && !lone.canMoveDown)
+  #expect(ChecklistRow.rows(in: workspace, projectID: UUID()).isEmpty)
+}
