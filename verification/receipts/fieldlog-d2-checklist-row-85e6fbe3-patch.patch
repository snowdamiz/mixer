diff --git a/Integrations/GeneratedReport/Sources/FieldLogFeatures/ChecklistRow.swift b/Integrations/GeneratedReport/Sources/FieldLogFeatures/ChecklistRow.swift
new file mode 100644
index 0000000000000000000000000000000000000000..77ae01e3ed3cd129af7e7090e28afa41355649a6
--- /dev/null
+++ b/Integrations/GeneratedReport/Sources/FieldLogFeatures/ChecklistRow.swift
@@ -0,0 +1,21 @@
+import FieldLogModels
+import Foundation
+
+public struct ChecklistRow: Identifiable, Equatable, Sendable {
+  public let id: UUID
+  public let title: String
+  public let responsible: String
+  public let completed: Bool
+  public let number: Int
+  public let canMoveUp: Bool
+  public let canMoveDown: Bool
+
+  public static func rows(in workspace: Workspace, projectID: UUID) -> [Self] {
+    let tasks = workspace.tasks(for: projectID)
+    return tasks.enumerated().map { index, task in
+      Self(
+        id: task.id, title: task.title, responsible: task.responsible, completed: task.completed,
+        number: index + 1, canMoveUp: index > 0, canMoveDown: index + 1 < tasks.count)
+    }
+  }
+}
diff --git a/Integrations/GeneratedReport/Tests/FieldLogAndroidTests/ChecklistRowRoutingTests.swift b/Integrations/GeneratedReport/Tests/FieldLogAndroidTests/ChecklistRowRoutingTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..9b357e2ba92da46a8e1f20aea490e279421facbf
--- /dev/null
+++ b/Integrations/GeneratedReport/Tests/FieldLogAndroidTests/ChecklistRowRoutingTests.swift
@@ -0,0 +1,129 @@
+import Foundation
+import XCTest
+import FieldLogAndroid
+import FieldLogModels
+import FieldLogStorage
+import MixerUI
+
+final class ChecklistRowRoutingTests: XCTestCase {
+    @MainActor func testChecklistRowsThroughPublicHost() async throws {
+        for count in [1, 3, 22] {
+            try await exerciseChecklist(count: count)
+        }
+    }
+
+    @MainActor private func exerciseChecklist(count: Int) async throws {
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let repository = try WorkspaceRepository(directory: directory.appendingPathComponent("FieldLog"))
+        let baseline = try await repository.transact { workspace in
+            let project = try workspace.createProject(title: "Checklist", site: "")
+            let foreign = try workspace.createProject(title: "Other project", site: "")
+            for number in 1...count {
+                try workspace.saveTask(projectID: project, title: "Inspect \(number)", responsible: "  Jo 日本語  ")
+            }
+            try workspace.saveTask(projectID: foreign, title: "Other task", responsible: "")
+        }
+        await repository.close()
+        let project = try XCTUnwrap(baseline.projects.first?.id)
+        let tasks = baseline.tasks(for: project)
+        let surface = R109Surface()
+        let app = try await open(directory, surface)
+        let owner = try XCTUnwrap(surface.owner)
+        let movingIndex = count > 20 ? 19 : 0
+        let moving = tasks[movingIndex]
+
+        func key(_ task: WorkTask) -> String { "task." + task.id.uuidString.lowercased() }
+
+        func node(_ id: String) throws -> UINode? {
+            let frame = try XCTUnwrap(surface.frames.last)
+            let packet = try XCTUnwrap(JSONSerialization.jsonObject(with: frame.packet) as? [String: Any])
+            let document = try UIDocument.decode(
+                JSONSerialization.data(withJSONObject: XCTUnwrap(packet["document"])),
+                validator: UIValidator(supportedTextFieldAxes: surface.profile.capabilities.textFieldAxes,
+                                       textValuePolicy: surface.profile.textValuePolicy))
+            return fieldLogNode(id, in: document.root)
+        }
+
+        func disabled(_ id: String, equals expected: Bool) throws {
+            let button = try XCTUnwrap(node(id))
+            XCTAssertEqual(button.properties["disabled"]?.bool, expected)
+            XCTAssertEqual(button.properties["accessibilityIdentifier"]?.string, id)
+            XCTAssertEqual(button.actions, [UIActionBinding(id: id, event: .activate)])
+        }
+
+        func refusedWithoutWrite(_ deliver: () throws -> Void) async throws {
+            let before = try Data(contentsOf: file(directory))
+            let frames = surface.frames.count
+            XCTAssertThrowsError(try deliver())
+            try await app.settle()
+            XCTAssertEqual(try Data(contentsOf: file(directory)), before)
+            XCTAssertEqual(surface.frames.count, frames)
+        }
+
+        let movingKey = key(moving)
+        let initialTitle = "\(movingIndex + 1). \(moving.title) · Not completed"
+        XCTAssertEqual(try node(movingKey + ".title")?.properties["text"]?.string, initialTitle)
+        XCTAssertEqual(try node(movingKey + ".responsible")?.properties["text"]?.string, moving.responsible)
+        try disabled(movingKey + ".complete", equals: false)
+        let stale = try event(app, movingKey + ".complete")
+        try send(app, movingKey + ".complete")
+        try await app.settle()
+        XCTAssertEqual(app.presentation.workspace.tasks(for: project).filter(\.completed).map(\.id), [moving.id])
+        XCTAssertEqual(try node(movingKey + ".complete")?.properties["label"]?.string, "Reopen: " + moving.title)
+        try await refusedWithoutWrite {
+            try app.send(owner: owner, originalEnvelope: JSONEncoder().encode(stale))
+        }
+
+        if count == 1 {
+            XCTAssertNil(try node(movingKey + ".up"))
+            XCTAssertNil(try node(movingKey + ".down"))
+        } else {
+            let first = key(tasks[0]), last = key(tasks[count - 1])
+            try disabled(first + ".up", equals: true)
+            try await refusedWithoutWrite { try send(app, first + ".up") }
+            try disabled(movingKey + ".down", equals: false)
+            try send(app, movingKey + ".down")
+            try await app.settle()
+            var swapped = tasks.map(\.id)
+            swapped.swapAt(movingIndex, movingIndex + 1)
+            XCTAssertEqual(app.presentation.workspace.tasks(for: project).map(\.id), swapped)
+            XCTAssertEqual(try node(movingKey + ".title")?.properties["text"]?.string,
+                           "\(movingIndex + 2). \(moving.title) · Completed")
+            if count > 20 {
+                XCTAssertEqual(try node("tasks.position")?.properties["text"]?.string, "Page 2 of 2 · Tasks 21–22 of 22")
+            }
+            try disabled(last + ".down", equals: true)
+            try await refusedWithoutWrite { try send(app, last + ".down") }
+            try disabled(movingKey + ".up", equals: false)
+            try send(app, movingKey + ".up")
+            try await app.settle()
+            XCTAssertEqual(app.presentation.workspace.tasks(for: project).map(\.id), tasks.map(\.id))
+            if count > 20 {
+                XCTAssertEqual(try node("tasks.position")?.properties["text"]?.string, "Page 1 of 2 · Tasks 1–20 of 22")
+                let beforePageTurn = try Data(contentsOf: file(directory))
+                try send(app, "tasks.next")
+                try disabled(key(tasks[20]) + ".up", equals: false)
+                try send(app, "tasks.previous")
+                XCTAssertEqual(try Data(contentsOf: file(directory)), beforePageTurn)
+            }
+        }
+
+        let committed = app.presentation.workspace
+        let changes = Array(committed.outbox.dropFirst(baseline.outbox.count))
+        let kinds: [PendingChange.Kind] = count == 1 ? [.taskSaved] : [.taskSaved, .taskOrderChanged, .taskOrderChanged]
+        XCTAssertEqual(changes.map(\.kind), kinds)
+        XCTAssertEqual(changes.map(\.recordID), count == 1 ? [moving.id] : [moving.id, project, project])
+        XCTAssertEqual(committed.revision, baseline.revision + UInt64(kinds.count))
+        XCTAssertEqual(committed.tasks.filter { $0.projectID != project }, baseline.tasks.filter { $0.projectID != project })
+        let bytes = try Data(contentsOf: file(directory))
+        XCTAssertEqual(try disk(directory), committed)
+        await app.close()
+        XCTAssertNil(surface.owner)
+        let reopened = try await open(directory)
+        XCTAssertEqual(reopened.presentation.workspace, committed)
+        XCTAssertEqual(try Data(contentsOf: file(directory)), bytes)
+        await reopened.close()
+        print("Checklist host PASS with \(count) tasks. Cold full snapshot and bytes match.")
+    }
+}
