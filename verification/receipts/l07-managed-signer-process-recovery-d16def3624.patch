+"""Bring up the stock native worker with one synthetic closed operation."""
+import hashlib
+import hmac
+import json
+import os
+from pathlib import Path
+import secrets
+import socket
+import sqlite3
+import subprocess
+import sys
+import time
+
+control, retained = map(Path, sys.argv[1:])
+source = Path.cwd() / "priv" / "development"
+sys.path.insert(0, str(source))
+from native_artifact_worker import NativeWorker, mac
+
+data = json.loads((control/"worker-input.json").read_bytes())
+request = data["request"]
+operation = request["operation_id"]
+descriptors = data["artifacts"]
+manifest = retained/operation/"native"/"native-build.json"
+manifest.write_bytes(b'{"fixture":"closed native products"}\n')
+manifest.chmod(0o444)
+
+with socket.socket() as reserve:
+    reserve.bind(("127.0.0.1", 0))
+    port = reserve.getsockname()[1]
+
+cfg = {"port": port, "token": secrets.token_hex(24), "worker_id": "l07-fixture",
+       "tenant": request["spec"]["organization_id"],
+       "registration": {"spec": {key: value for key, value in request["spec"].items()
+                                 if key != "build_id"}}}
+config = control/"worker-config.json"
+config.write_text(json.dumps(cfg))
+os.chmod(config, 0o600)
+worker = NativeWorker(cfg, retained)
+worker.save(operation, {
+    "binding": {key: request[key] for key in ("ref", "spec", "deadline_ms")},
+    "guard": request["guard"], "order": [request["guard"]["epoch"], request["guard"]["revision"]],
+    "status": "native_ready", "starts": 1, "closure": {"started": True, "closed": True, "exit": 0},
+    "artifacts": descriptors, "manifest_sha256": hashlib.sha256(manifest.read_bytes()).hexdigest(),
+})
+worker.close()
+
+def exchange(action):
+    body = json.dumps({"worker_id": cfg["worker_id"], "action": action, "request": request})
+    nonce = secrets.token_hex(16)
+    packet = json.dumps({"body": body, "nonce": nonce,
+                         "mac": mac(cfg["token"], "request", nonce, body)}) + "\n"
+    with socket.create_connection(("127.0.0.1", port), timeout=0.8) as client:
+        client.sendall(packet.encode())
+        with client.makefile("rb") as stream:
+            reply = json.loads(stream.readline(262_145))
+    if not hmac.compare_digest(reply["mac"], mac(cfg["token"], "response", nonce, reply["body"])):
+        raise RuntimeError("Worker response authentication failed")
+    return json.loads(reply["body"])
+
+def operation_digest():
+    with sqlite3.connect((retained/"operations.sqlite").as_uri()+"?mode=ro", uri=True) as conn:
+        row, = conn.execute("SELECT value FROM operations WHERE id=?", (operation,)).fetchone()
+        assert conn.execute("SELECT count(*) FROM operations").fetchone() == (1,)
+    return hashlib.sha256(row.encode()).hexdigest()
+
+with (control/"worker.log").open("wb") as log:
+    child = subprocess.Popen([sys.executable, "-B", str(source/"native_artifact_worker.py"),
+                              str(config), hashlib.sha256(config.read_bytes()).hexdigest(), str(retained)],
+                             stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
+                             start_new_session=True)
+    (control/"worker-pid").write_text(str(child.pid))
+    try:
+        for _ in range(25):
+            try:
+                first = exchange("artifacts")
+                break
+            except ConnectionRefusedError:
+                if child.poll() is not None:
+                    raise RuntimeError("Owned worker failed to start")
+                time.sleep(.05)
+        else:
+            raise RuntimeError("Owned worker did not listen")
+        assert first == {"status": "native_ready", "artifacts": descriptors}, first
+        before = operation_digest()
+        (control/"worker-ready").write_text(str(port))
+
+        deadline = time.monotonic() + 17
+        while not (control/"worker-finish").exists():
+            if child.poll() is not None or time.monotonic() >= deadline:
+                raise RuntimeError("Worker lost or test did not settle on time")
+            time.sleep(.04)
+        assert exchange("artifacts") == first
+        assert operation_digest() == before
+        assert exchange("shutdown") == {"status": "closed"}
+        assert child.wait(timeout=3) == 0
+    finally:
+        if child.poll() is None:
+            child.terminate()
+            child.wait(timeout=3)
+        try:
+            os.killpg(child.pid, 0)
+        except ProcessLookupError:
+            absent = True
+        else:
+            absent = False
+        (control/"worker-process.json").write_text(json.dumps({
+            "pid": child.pid, "pgid": child.pid, "exit": child.returncode, "groupAbsent": absent,
+            "directChildReaped": True, "port": port,
+        }))
+        assert absent
+
+with socket.socket() as rebound:
+    rebound.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+    # The stock prior socket may retain TCP TIME_WAIT without SO_REUSEADDR.
+    # A refused connection establishes the original service no longer listens.
+    assert rebound.connect_ex(("127.0.0.1", port)) != 0
+print(json.dumps({"operation": operation, "closedWorkerCheckpointDigest": before,
+                  "twoAuthenticatedReadyObservations": True}))
