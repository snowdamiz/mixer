+import hashlib, json, os, pathlib, signal, subprocess, sys, time
+
+root = pathlib.Path(sys.argv[1])
+env = {k:v for k,v in os.environ.items() if k in ('PATH','HOME','LANG','USER','LOGNAME')}
+pgbin = pathlib.Path('/opt/homebrew/opt/postgresql@17/bin')
+env.update(TMPDIR=str(root/'tmp'), MIX_HOME=str(root/'mix'), HEX_HOME=str(root/'hex'),
+           HEX_OFFLINE='1', MIX_ENV='test', ERL_FLAGS='+S 4:4',
+           MIXER_ATTESTATION_TEST_SOCKET=str(root/'socket'),
+           MIXER_ATTESTATION_TEST_GO_SIGNER=str(root/'signer'),
+           L07_SIGNER_SCRATCH=str(root))
+commands = root/'commands.jsonl'
+def record(**data):
+    with commands.open('a') as f:
+        print(json.dumps(data), file=f, flush=True)
+
+def start(name, args, cwd=root):
+    args = [str(x) for x in args]
+    with (root/(name+'.log')).open('wb') as f:
+        proc = subprocess.Popen(args, cwd=cwd, env=env, stdin=subprocess.DEVNULL,
+                                stdout=f, stderr=subprocess.STDOUT, start_new_session=True)
+    record(event='launch', name=name, argv=args, cwd=str(cwd), pid=proc.pid, pgid=proc.pid)
+    return proc
+
+def finish(name, proc, timeout):
+    try:
+        status = proc.wait(timeout=timeout)
+    except subprocess.TimeoutExpired:
+        record(event='hold',name=name,pid=proc.pid,reason='wait timeout')
+        raise
+    limit = time.monotonic()+2
+    while True:
+        try:
+            os.killpg(proc.pid, 0)
+        except ProcessLookupError:
+            absent=True
+            break
+        except PermissionError:
+            absent=False
+            break
+        if time.monotonic() >= limit:
+            absent=False
+            break
+        time.sleep(.04)
+    log = (root/(name+'.log')).read_bytes() if absent else b''
+    record(event='terminal' if absent else 'hold',name=name,pid=proc.pid,exit=status,
+           groupAbsent=absent,logSHA256=hashlib.sha256(log).hexdigest(),logBytes=len(log))
+    if not absent:
+        raise RuntimeError('Uncertain custody: '+name)
+    return status
+
+def run(name, args, timeout, cwd=root):
+    return finish(name, start(name,args,cwd), timeout)
+
+phase = sys.argv[2]
+env['L07_SIGNER_TRIAL'] = phase
+pgdir = root/('pg-'+phase)
+if phase != 'init':
+    assert run('initdb-'+phase,[pgbin/'initdb','-D',pgdir,'-U','mixer_attestation_fixture_admin',
+                         '--no-locale','--encoding=UTF8','--auth=trust','--no-sync'],20) == 0
+
+pg = start('postgres-'+phase,[pgbin/'postgres','-D',pgdir,'-h','','-k',root/'socket',
+                             '-p','5432','-c','unix_socket_permissions=0700'])
+try:
+    for i in range(10):
+        if run(f'pg-ready-{phase}-{i}',[pgbin/'pg_isready','-q','-h',root/'socket','-p','5432'],4) == 0:
+            break
+        time.sleep(.08)
+    else:
+        raise RuntimeError('owned PostgreSQL not ready')
+    assert run('createdb-'+phase,[pgbin/'createdb','-h',root/'socket','-U',
+                                 'mixer_attestation_fixture_admin','mixer_native_attestation_fixture'],8) == 0
+    result = run('exunit-'+phase,['mix','test','--only','l07_signer_process','--seed','0','--trace',
+                 'test/mixer_hosted/builds/native_attestation_attachment_test.exs'],95,root/'source/hosted')
+finally:
+    if pg.poll() is None:
+        pg.send_signal(signal.SIGINT)
+    if finish('postgres-'+phase,pg,12) != 0:
+        raise RuntimeError('owned PostgreSQL shutdown failed')
+sys.exit(result)
