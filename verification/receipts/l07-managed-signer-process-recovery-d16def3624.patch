new file mode 100644
--- /dev/null
+++ b/tests/integration/l07-native-attestation/signer_trial.py
@@ -0,0 +1,43 @@
+"""Own one invocation of the stock signer and optionally cut its exact PID."""
+import json
+import os
+import pathlib
+import subprocess
+import sys
+import time
+
+root, phase, token = sys.argv[1:4]
+root = pathlib.Path(root)
+with open(token, "rb") as stdin:
+    signer = subprocess.Popen(sys.argv[4:], stdin=stdin, stdout=subprocess.PIPE,
+                              stderr=subprocess.STDOUT, start_new_session=True)
+try:
+    if phase == "cut":
+        deadline = time.monotonic() + 12
+        while not (root / "cut-now").exists():
+            if signer.poll() is not None:
+                raise RuntimeError("Signer exited before the admitted cut")
+            if time.monotonic() >= deadline:
+                raise RuntimeError("No admitted artifact-read barrier")
+            time.sleep(.025)
+        if signer.poll() is not None or os.getpgid(signer.pid) != signer.pid:
+            raise RuntimeError("Owned signer was not live in its exact launch group")
+        signer.kill()
+    output, _ = signer.communicate(timeout=12)
+finally:
+    if signer.poll() is None:
+        signer.kill()
+        signer.wait(timeout=3)
+    absent = False
+    try:
+        os.killpg(signer.pid, 0)
+    except ProcessLookupError:
+        absent = True
+    (root / f"{phase}-process.json").write_text(json.dumps({
+        "pid": signer.pid, "pgid": signer.pid, "exit": signer.returncode,
+        "directChildReaped": True, "groupAbsent": absent,
+    }))
+    if not absent:
+        raise RuntimeError("Uncertain signer group custody")
+print(output.decode(), end="")
+sys.exit(0 if phase == "cut" and signer.returncode == -9 else signer.returncode)
