+                    Self.choice("settings.text.larger", "Larger", selected: draft.largerText, enabled: editable)
+                    MixerUI.Text("settings.text.help", "Larger sets a minimum text size and respects a larger Android setting.")
+                }
+                MixerUI.Section("settings.save") {
+                    if let message = environment.status.message {
+                        MixerUI.Text("settings.loadStatus", message).accessibilityIdentifier("settings-load-status")
+                    }
+                    if reportHandoffHeld {
+                        MixerUI.Text("settings.reportHold", "Apply and Reset are temporarily paused while Android finishes the report handoff.")
+                            .accessibilityIdentifier("settings-report-hold")
+                    }
+                    MixerUI.Button("settings.apply", "Apply and reopen", action: "settings.apply")
+                        .accessibilityIdentifier("settings-apply")
+                        .disabled(!writable || !editable || draft == environment.preferences)
+                    MixerUI.Button("settings.reset", "Reset and reopen", action: "settings.reset")
+                        .accessibilityIdentifier("settings-reset").disabled(!writable)
+                    MixerUI.Text("settings.reopen.help", "Apply or reset reopens FieldLog. Settings apply only to this installation.")
+                }
+                MixerUI.Section("settings.help", title: "Offline help") {
+                    MixerUI.Text("settings.help.entries", "Save drafts and commit entries on this device. To attach a photo, use Select photo or Capture photo in Entries.")
+                    MixerUI.Text("settings.help.queue", "Check On device for pending changes. For projects with sending enabled, eligible entries can be sent when the configured service is reachable.")
+                    MixerUI.Text("settings.help.map", "Site map can show the site and a saved pin offline. Showing your position requires location permission.")
+                    MixerUI.Text("settings.help.report", "Share project report exports a text report of saved local records. It counts attached photos and leaves the image files on the device.")
+                }
+                MixerUI.Section("settings.diagnostics", title: "Support diagnostics") {
+                    MixerUI.Text("settings.diagnostics.schemaVersion", "Schema version: 1")
+                    MixerUI.Text("settings.diagnostics.platform", "Platform: Android")
+                    MixerUI.Text("settings.diagnostics.osMajorVersion", "OS major version: " + (diagnostics.osMajorVersion.map(String.init) ?? "Unavailable"))
+                    MixerUI.Text("settings.diagnostics.appVersion", "App version: " + (diagnostics.appVersion ?? "Unavailable"))
+                    MixerUI.Text("settings.diagnostics.buildNumber", "Build number: " + (diagnostics.buildNumber.map(String.init) ?? "Unavailable"))
+                }
+            }
+        }.document(revision: revision)
+    }
+
+    private static func choice(_ id: String, _ label: String, selected: Bool, enabled: Bool) -> some MixerView {
+        MixerUI.Button(id, selected ? label + " (selected)" : label, action: id)
+            .accessibilityIdentifier(id).disabled(!enabled)
+    }
+}
+
+struct AndroidSettingsWrite {
+    let id = UUID()
+    let preferences: AndroidPreferences
+    let reset: Bool
+    let revision: UInt64
+
+    var packet: Data {
+        Data("\(id.uuidString)\n\(reset ? "reset" : "apply")\n\(preferences.record)".utf8)
+    }
+}
