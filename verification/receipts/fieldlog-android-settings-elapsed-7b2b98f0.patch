+    var preferences = AndroidPreferences()
+    var status: LoadStatus = .ready
+    var deviceLocale = Locale.current.identifier
+    var timeZone = TimeZone.current.identifier
+    var diagnostics = Diagnostics()
+
+    func dateFormatter(for formats: AndroidPreferences.RegionalFormats) -> DateFormatter {
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: formats == .system ? deviceLocale : formats.rawValue)
+        formatter.timeZone = TimeZone(identifier: timeZone) ?? .current
+        formatter.dateStyle = .medium
+        formatter.timeStyle = .none
+        return formatter
+    }
+}
+
+struct AndroidSettingsScreen {
+    enum Phase {
+        case editing, saving(AndroidSettingsWrite), refused
+    }
+
+    var draft: AndroidPreferences
+    var phase = Phase.editing
+
+    var pending: AndroidSettingsWrite? {
+        if case .saving(let write) = phase { return write }
+        return nil
+    }
+
+    func document(environment: AndroidSettingsEnvironment, reportHandoffHeld: Bool, revision: UInt64) -> UIDocument {
+        let busy = pending != nil
