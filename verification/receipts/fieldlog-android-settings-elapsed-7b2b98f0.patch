+
+struct AndroidSettingsEnvironment: Decodable, Sendable {
+    enum LoadStatus: String, Decodable {
+        case ready, malformed, newer, unavailable
+
+        var message: String? {
+            switch self {
+            case .ready: nil
+            case .malformed: "Settings could not be read. Reset to replace them."
+            case .newer: "These settings use a different version. Reset to replace them."
+            case .unavailable: "Settings storage is unavailable. FieldLog is using defaults."
+            }
+        }
+    }
+
+    struct Diagnostics: Decodable, Sendable {
+        var osMajorVersion: Int?
+        var appVersion: String?
+        var buildNumber: UInt64?
+    }
