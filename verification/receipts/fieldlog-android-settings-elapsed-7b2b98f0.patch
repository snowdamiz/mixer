@@ -0,0 +1,99 @@
+package dev.fieldlog.generatedr90.androidhost;
+
+import java.nio.charset.StandardCharsets;
+import java.nio.channels.ClosedByInterruptException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+
+final class SettingsChecks {
+    private static final String TICKET = "87EF930D-6FF1-4292-87F3-03AE7B012132";
+
+    private static void check(boolean condition, String label) {
+        if (!condition) throw new AssertionError(label);
+    }
+
+    private static FieldLogSettings.Write request(String action, FieldLogSettings value) {
+        return FieldLogSettings.request((TICKET + "\n" + action + "\n" + value.encode()).getBytes(StandardCharsets.UTF_8));
+    }
+
+    public static void main(String[] args) throws Exception {
+        var defaults = FieldLogSettings.DEFAULT;
+        var selected = new FieldLogSettings("dark", "fr-FR", true);
+        check(FieldLogSettings.read(null).value().equals(defaults), "missing defaults");
+        check(FieldLogSettings.read(false).status() == FieldLogSettings.Status.malformed, "wrong stored type");
+        var corrupt = FieldLogSettings.read("1\nappearance=invalid\nregionalFormats=en-US\nlargerText=invalid");
+        check(corrupt.status() == FieldLogSettings.Status.malformed, "malformed status");
+        check(corrupt.value().equals(new FieldLogSettings("system", "en-US", false)), "per-value safe defaults");
+        check(FieldLogSettings.read(selected.encode()).value().equals(selected), "record round-trip");
+        check(defaults.fontScaleOverride(2) == 0 && selected.fontScaleOverride(1) == 1.3f
+            && selected.fontScaleOverride(2) == 2, "font scale floor preserves larger system text");
+        check(request("reset", selected) == null && request("unexpected", defaults) == null, "invalid commands");
+
+        Path directory = Path.of(args[0]);
+        Path file = directory.resolve(FieldLogSettings.FILE);
+        Path staging = file.resolveSibling(file.getFileName() + ".new");
+        var store = new FieldLogSettings.Store(file);
+        check(store.current().value().equals(defaults) && !Files.exists(file), "absent record uses defaults");
+        check(store.save(request("apply", selected)) == FieldLogSettings.Outcome.committed
+            && Files.readString(file).equals(selected.encode()), "first save publishes one record");
+        check(!Files.exists(staging) && new FieldLogSettings.Store(file).current().value().equals(selected),
+            "cold read sees the complete first save");
+
+        for (String raw : new String[] { "37\nunrecognized payload", "1\nappearance=invalid\nregionalFormats=en-US\nlargerText=false" }) {
+            Files.writeString(file, raw);
+            store = new FieldLogSettings.Store(file);
+            check(store.current().status() != FieldLogSettings.Status.ready, "fixture requires explicit Reset");
+            check(store.save(request("apply", selected)) == FieldLogSettings.Outcome.refused
+                && Files.readString(file).equals(raw), "stored bytes survive Apply until explicit Reset");
+            check(store.save(request("reset", defaults)) == FieldLogSettings.Outcome.committed
+                && Files.readString(file).equals(defaults.encode()), "Reset replaces the record");
+        }
+
+        Files.createDirectory(staging);
+        Path obstruction = Files.createFile(staging.resolve("obstruction"));
+        check(store.save(request("apply", selected)) == FieldLogSettings.Outcome.refused
+            && Files.readString(file).equals(defaults.encode()) && store.current().value().equals(defaults),
+            "definite staging failure preserves previous settings on disk and in use");
+        Files.delete(obstruction);
+        Files.delete(staging);
+
+        Thread.currentThread().interrupt();
+        try {
+            check(store.save(request("apply", selected)) == FieldLogSettings.Outcome.refused
+                && Thread.currentThread().isInterrupted() && Files.readString(file).equals(defaults.encode()),
+                "interrupt before replacement settles as refusal without a queued write");
+        } finally {
+            Thread.interrupted();
+        }
+        check(store.save(request("apply", selected)) == FieldLogSettings.Outcome.committed
+            && Files.readString(file).equals(selected.encode()), "definite failure permits retry");
+
+        var syncs = new AtomicInteger();
+        var uncertain = new FieldLogSettings.Store(file, directoryChannel -> {
+            syncs.incrementAndGet();
+            check(Files.readString(file).equals(defaults.encode()), "atomic replacement precedes directory sync");
+            Thread.currentThread().interrupt();
+            throw new ClosedByInterruptException();
+        });
+        var outcome = new AtomicReference<FieldLogSettings.Outcome>();
+        Thread worker = new Thread(() -> outcome.set(uncertain.save(request("reset", defaults))));
+        worker.start();
+        worker.join();
+        check(outcome.get() == FieldLogSettings.Outcome.uncertain
+            && uncertain.current().value().equals(selected), "post-publication interruption retains last confirmed value");
+        check(uncertain.save(request("apply", selected)) == FieldLogSettings.Outcome.uncertain
+            && syncs.get() == 1 && Files.readString(file).equals(defaults.encode()) && !Files.exists(staging),
+            "unknown outcome fences all retries and leaves exactly one complete record");
+        check(new FieldLogSettings.Store(file).current().value().equals(defaults),
+            "cold directory sync settles the visible record");
+
+        Path unreadable = Files.createDirectory(directory.resolve("unreadable"));
+        var unavailable = new FieldLogSettings.Store(unreadable);
+        check(unavailable.current().status() == FieldLogSettings.Status.unavailable
+            && unavailable.save(request("reset", defaults)) == FieldLogSettings.Outcome.refused,
+            "unavailable storage fails closed");
+        System.out.println("PASS absent and first save, explicit reset, atomic refusal, interruption, uncertainty fence, cold settlement, and text floor");
+    }
+}
