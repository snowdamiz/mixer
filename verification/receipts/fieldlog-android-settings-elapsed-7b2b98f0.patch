+package dev.fieldlog.generatedr90.androidhost;
+
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.channels.FileChannel;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.NoSuchFileException;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.nio.file.StandardOpenOption;
+import java.util.UUID;
+
+/** The install-local record and its checked persistence boundary. */
+record FieldLogSettings(String appearance, String regionalFormats, boolean largerText) {
+    static final String FILE = "fieldlog-settings.record";
+    static final FieldLogSettings DEFAULT = new FieldLogSettings("system", "system", false);
+    static final float LARGER_SCALE = 1.3f;
+
+    enum Status { ready, malformed, newer, unavailable }
+    record Read(FieldLogSettings value, Status status) {}
+    record Write(String ticket, FieldLogSettings value, boolean reset) {}
+
+    String encode() {
+        return "1\nappearance=" + appearance + "\nregionalFormats=" + regionalFormats + "\nlargerText=" + largerText;
+    }
+
+    float fontScaleOverride(float systemScale) {
+        return largerText ? Math.max(systemScale, LARGER_SCALE) : 0;
+    }
+
+    static Read read(Object raw) {
+        if (raw == null) return new Read(DEFAULT, Status.ready);
+        if (!(raw instanceof String text)) return new Read(DEFAULT, Status.malformed);
+        int newline = text.indexOf('\n');
+        String version = newline < 0 ? text : text.substring(0, newline);
+        if (!version.equals("1") && version.matches("[0-9]+"))
+            return new Read(DEFAULT, Status.newer);
+        if (text.length() > 128) return new Read(DEFAULT, Status.malformed);
+        String[] parts = text.split("\n", -1);
+        if (parts.length != 4 || !version.equals("1") || !parts[1].startsWith("appearance=")
+                || !parts[2].startsWith("regionalFormats=") || !parts[3].startsWith("largerText="))
+            return new Read(DEFAULT, Status.malformed);
+        String appearance = parts[1].substring("appearance=".length());
+        String regional = parts[2].substring("regionalFormats=".length());
+        String larger = parts[3].substring("largerText=".length());
+        return new Read(new FieldLogSettings(
+            switch (appearance) { case "light", "dark" -> appearance; default -> "system"; },
+            switch (regional) { case "en-US", "fr-FR" -> regional; default -> "system"; },
+            larger.equals("true")
+        ), valid(appearance, regional, larger) ? Status.ready : Status.malformed);
+    }
+
+    private static boolean valid(String appearance, String regional, String larger) {
+        return (appearance.equals("light") || appearance.equals("dark") || appearance.equals("system"))
+            && (regional.equals("en-US") || regional.equals("fr-FR") || regional.equals("system"))
+            && (larger.equals("true") || larger.equals("false"));
+    }
+
+    static Write request(byte[] bytes) {
+        if (bytes == null || bytes.length <= 42 || bytes.length > 192) return null;
+        String[] parts = new String(bytes, StandardCharsets.UTF_8).split("\n", 3);
+        if (parts.length != 3 || parts[0].length() != 36) return null;
+        try {
+            if (!UUID.fromString(parts[0]).toString().toUpperCase(java.util.Locale.ROOT).equals(parts[0])) return null;
+        } catch (IllegalArgumentException malformed) {
+            return null;
+        }
+        boolean reset = parts[1].equals("reset");
+        if (!reset && !parts[1].equals("apply")) return null;
+        Read read = read(parts[2]);
+        if (read.status() != Status.ready || (reset && !read.value().equals(DEFAULT))) return null;
+        return new Write(parts[0], read.value(), reset);
+    }
+
+    enum Outcome { committed, refused, uncertain }
+
+    @FunctionalInterface
+    interface DirectorySync {
+        void force(FileChannel directory) throws IOException;
+    }
+
+    static final class Store {
+        private final Path file;
+        private final DirectorySync sync;
+        private volatile Read confirmed;
+        private boolean unsettled;
+
+        Store(Path file) {
+            this(file, directory -> directory.force(true));
+        }
+
+        Store(Path file, DirectorySync sync) {
+            this.file = file;
+            this.sync = sync;
+            try (var input = Files.newInputStream(file);
+                 var directory = FileChannel.open(file.getParent(), StandardOpenOption.READ)) {
+                // Resolve the visible name after any interrupted prior process before using it.
+                directory.force(true);
+                byte[] bytes = new byte[129];
+                int count = 0;
+                while (count < bytes.length) {
+                    int n = input.read(bytes, count, bytes.length - count);
+                    if (n < 0) break;
+                    count += n;
+                }
+                confirmed = FieldLogSettings.read(new String(bytes, 0, count, StandardCharsets.UTF_8));
+            } catch (NoSuchFileException missing) {
+                confirmed = new Read(DEFAULT, Status.ready);
+            } catch (IOException | RuntimeException error) {
+                confirmed = new Read(DEFAULT, Status.unavailable);
+            }
+        }
+
+        Read current() { return confirmed; }
+
+        synchronized Outcome save(Write write) {
+            if (unsettled) return Outcome.uncertain;
+            Status status = confirmed.status();
+            if (status == Status.unavailable || (status != Status.ready && !write.reset())
+                    || (write.reset() && !write.value().equals(DEFAULT))
+                    || Thread.currentThread().isInterrupted()) return Outcome.refused;
+            Path staging = file.resolveSibling(file.getFileName() + ".new");
+            boolean published = false;
+            try (var directory = FileChannel.open(file.getParent(), StandardOpenOption.READ)) {
+                try (var output = new FileOutputStream(staging.toFile())) {
+                    output.write(write.value().encode().getBytes(StandardCharsets.UTF_8));
+                    output.getFD().sync();
+                }
+                if (Thread.currentThread().isInterrupted()) return Outcome.refused;
+                Files.move(staging, file, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+                published = true;
+                sync.force(directory);
+            } catch (IOException | RuntimeException error) {
+                if (!published) return Outcome.refused;
+                unsettled = true;
+                return Outcome.uncertain;
+            } finally {
+                if (!published) {
+                    try { Files.deleteIfExists(staging); }
+                    catch (IOException | RuntimeException ignored) { }
+                }
+            }
+            confirmed = new Read(write.value(), Status.ready);
+            return Outcome.committed;
+        }
+    }
+}
