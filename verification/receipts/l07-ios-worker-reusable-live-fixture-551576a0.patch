index 0000000000..d8fd89512d
--- /dev/null
+++ b/tests/integration/l07-ios-active-custody/test_reusable.py
@@ -0,0 +1,80 @@
+"""Inert checks for the scoped evidence reader and reusable fixture admission."""
+
+import copy
+import json
+import unittest
+from unittest.mock import Mock
+
+from reusable import checked_entry, scoped_snapshot, sql_for_record
+from reusable_fixture import PG_ROLES, seed_roles, sha
+
+
+class ReusableFixtureTests(unittest.TestCase):
+    def setUp(self):
+        self.operation = "a" * 64
+        self.authority = "b" * 64
+        self.record = "ed63c507-caf9-4b0e-9f0b-7c40d088b5a3"
+        self.guard = {"revision": 1, "owner_id": "oban:17:original", "epoch": 1}
+        self.binding = {"spec": {"build_id": "separate"}, "ref": {"attempt": 1}, "deadline_ms": 300}
+        self.plan = json.dumps({"operation_id": self.operation, "binding": self.binding, "recipe": {},
+                                "configuration": self.authority, "guard": self.guard})
+        self.plan_digest = sha(self.plan.encode())
+        self.entry = {
+            "authority": [self.authority],
+            "sizes": {"operations": 2, "claims": 2, "plans": 2},
+            "plan": self.plan,
+            "claim": (123, '{"pid":124,"pgid":124,"sid":124}', None, 0,
+                      self.plan_digest, json.dumps(self.guard)),
+            "row": {"binding": self.binding, "starts": 1, "ios_custody":
+                    {"version": 2, "configuration": self.authority, "plan_sha256": self.plan_digest}},
+        }
+
+    def check(self, entry):
+        return checked_entry(entry, self.authority, self.operation, self.binding, 123, 17, 2)
+
+    def test_accept_original_durable_claim_but_distinguish_absent_terminal_proof(self):
+        _, launch, terminal, issued = self.check(self.entry)
+        self.assertEqual(launch, {"pid": 124, "sid": 124, "pgid": 124})
+        self.assertIsNone(terminal)
+        self.assertEqual(issued, self.guard)
+
+    def test_refuse_uncertain_claim_even_when_terminal_column_is_present(self):
+        original = self.entry["claim"]
+        self.entry["claim"] = (*original[:2], '{"outcome":"succeeded"}', 1, *original[4:])
+        with self.assertRaisesRegex(RuntimeError, "claim"):
+            self.check(self.entry)
+
+    def test_refuse_authority_changed_plan_or_an_extra_operation(self):
+        for field, replacement in {
+            "authority": ["c" * 64],
+            "plan": self.plan.replace("separate", "other"),
+            "sizes": {"operations": 3, "claims": 2, "plans": 2},
+        }.items():
+            with self.subTest(field=field):
+                changed = copy.deepcopy(self.entry)
+                changed[field] = replacement
+                with self.assertRaises(RuntimeError):
+                    self.check(changed)
+
+    def test_readbacks_are_scoped_to_exact_record(self):
+        sql = Mock(return_value="{}")
+        scoped_snapshot(sql, self.record)
+        self.assertEqual(sql.call_args.args[0].count(self.record), 5)
+        sql_for_record(sql, self.record)("SELECT json_agg(journal->'events') FROM mixer_builds")
+        self.assertTrue(sql.call_args.args[0].endswith("WHERE id='" + self.record + "'"))
+        sql.reset_mock()
+        with self.assertRaises(RuntimeError):
+            scoped_snapshot(sql, "untrusted")
+        with self.assertRaises(RuntimeError):
+            sql_for_record(sql, self.record)("SELECT 1")
+        sql.assert_not_called()
+
+    def test_fixtures_refuse_a_shared_or_malformed_role_password(self):
+        with self.assertRaisesRegex(RuntimeError, "distinct private hex"):
+            seed_roles(None, dict.fromkeys(PG_ROLES, "a" * 64))
+        with self.assertRaisesRegex(RuntimeError, "distinct private hex"):
+            seed_roles(None, {role: str(index) for index, role in enumerate(PG_ROLES)})
+
+
+if __name__ == "__main__":
+    unittest.main()
