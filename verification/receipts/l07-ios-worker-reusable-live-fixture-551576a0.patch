+"""Compose and verify the disposable fixture without building application sources."""
+
+import hashlib
+import os
+import re
+import runpy
+import shutil
+import stat
+from pathlib import Path
+
+from v74 import replace
+
+BASE = "551576a03a4ef4f4b081e6191ce0a02c5947c679"
+BASE_TREE = "17349941b5ca190c9597dbdd9bec259b93b0e918"
+HOSTED_TREE = "209558d5a8bb80ee695d9a26b5652a00dc19e0cd"
+PRODUCT_SHA256 = "d2c7e8c94adc37343c21324173b96e9b3675a9c7f1a5b0ffda08db1293081bef"
+PAIR = "tests/integration/l05-pair25-http"
+HERE = Path(__file__).resolve().parent
+API = "test/mixer_hosted/browser_auth/local_starter_http_sql_spec.exs"
+REGISTRATION = "tests/integration/free-project-starter/registration-runner.py"
+PREPARE = "tests/integration/free-project-starter/prepare-starter.py"
+SOURCE_PATHS = ("hosted", PAIR, REGISTRATION, PREPARE)
+BROWSER_ROLES = ("browser_admin", "browser_lifecycle", "browser_ordinary", "mixer_build_create")
+PG_ROLES = ("fixture_admin", *BROWSER_ROLES, "mixer_build_processor")
+
+
+def require(condition, detail):
+    if not condition:
+        raise RuntimeError(detail)
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def product_preimages(patch, root):
+    raw = patch.read_bytes()
+    require(sha(raw) == PRODUCT_SHA256, "supplied product patch digest differs")
+    files = []
+    for block in raw.split(b"diff --git ")[1:]:
+        match = re.match(rb"a/(hosted/[^\n ]+) b/\1\nindex ([0-9a-f]{40})\.\.([0-9a-f]{40}) ", block)
+        require(match is not None, "unexpected product patch file")
+        path, before, after = (part.decode() for part in match.groups())
+        require(git_blob(root / path) == before, f"product preimage differs: {path}")
+        files.append((path, after))
+    require(len(files) == len({path for path, _ in files}) == 5, "product patch roster differs")
+    return files
+
+
+def git_blob(path):
+    data = path.read_bytes()
+    return hashlib.sha1(f"blob {len(data)}\0".encode() + data).hexdigest()
+
+
+def compose(root):
+    pair = root / PAIR
+    kit_path = pair / "run.py"
+    replace(kit_path,
+            "empty_post=False, burst=None):",
+            'empty_post=False, burst=None, idempotency_key="pair25-one-build"):')
+    replace(kit_path, '"Idempotency-Key": "pair25-one-build"', '"Idempotency-Key": idempotency_key')
+    kit = runpy.run_path(str(kit_path))
+
+    api_case = pair / "api-case.exs"
+    source = api_case.read_text()
+    helper = source[source.index("defp pair25_publish!("):]
+    require(helper.count("defp pair25_processor!(") == 1, "scoped processor fixture differs")
+    api_case.write_text((HERE / "reusable-api.exs").read_text() + "\n" + helper)
+    replace(api_case, "WHERE platform='android'", "WHERE platform='ios'")
+    replace(api_case, "  for sql <- ProcessorProfile.operation_intent_statements",
+            r"""  password = System.fetch_env!("L07_PG_mixer_build_processor")
+  assert password =~ ~r/\A[0-9a-f]{64}\z/
+  DB.q!(Admin, "ALTER ROLE mixer_build_processor PASSWORD '#{password}'")
+
+  for sql <- ProcessorProfile.operation_intent_statements""")
+    replace(api_case, '  |> then(fn c ->\n    if System.get_env("PAIR25_CANCEL")',
+            """  |> put_in([:hosted, Access.key(:endpoint)],
+    Keyword.put(c.hosted.endpoint, :http, ip: {127, 0, 0, 1},
+      port: String.to_integer(System.fetch_env!("L07_API_PORT")), http_2_options: [enabled: false]))
+  |> then(fn c ->
+    if System.get_env("PAIR25_CANCEL")""")
+    # Evaluate the reused helper against just the modified fixture test case.
+    kit["fixtures"](root / "hosted")
+    api = root / "hosted" / API
+    replace(api, 'Keyword.put(c.hosted.repo, :username, "mixer_build_create")',
+            'Keyword.merge(c.hosted.repo, username: "mixer_build_create",\n'
+            '        password: System.fetch_env!("L07_PG_mixer_build_create"))')
+
+    support = root / "hosted/test/support"
+    startup = support / "ordinary_browser_startup_fixture.ex"
+    replace(startup, '      pool_size: 2,\n      log: false',
+            '      pool_size: 2,\n      password: System.fetch_env!("L07_PG_browser_admin"),\n      log: false')
+    replace(startup, '      |> Keyword.put(:username, "browser_ordinary")',
+            '      |> Keyword.put(:username, "browser_ordinary")\n'
+            '      |> Keyword.put(:password, System.fetch_env!("L07_PG_browser_ordinary"))')
+    replace(startup, 'password: "synthetic",', 'password: System.fetch_env!("L07_PG_browser_lifecycle"),')
+    replace(startup, """        Postgrex.query!(
+          conn,
+          "DROP DATABASE browser_ordinary_installation_r1422 WITH (FORCE)",
+          [],
+          timeout: 20_000
+        )""", """        # The isolated process runner owns this cluster's cleanup.
+        :ok""")
+    for path in (startup, support / "browser_storage_fixture.ex"):
+        replace(path, '        username: role,',
+                '        username: role,\n        password: System.fetch_env!("L07_PG_" <> role),')
+
+    processor = pair / "processor.exs"
+    replace(processor, '%{"platform" => "android"}', '%{"platform" => "ios"}')
+    replace(processor, '%{platform: :android}', '%{platform: :ios}')
+    replace(processor, "try do\n  :ok =", "pause = fn ready ->\n  :ok =")
+    replace(processor, '  publish.("processor.ready", %{role: settings.repo[:username], paused: true})',
+            '  publish.(ready, %{role: settings.repo[:username], paused: true})\nend\n\ntry do\n  pause.("processor.ready")')
+    replace(processor, '  if command.("build.selection") == :go do\n    scope = path.("build.selection")',
+            '  for suffix <- ["", ".b"], command.("build.selection" <> suffix) == :go do\n'
+            '    scope = path.("build.selection" <> suffix)')
+    replace(processor, '''    %{rows: [["created", "completed", 1], ["start", "available", 0]]} =
+      Repo.query!("SELECT args->>'kind', state::text, attempt FROM oban_jobs ORDER BY id")''',
+            '''    %{rows: [["created", "completed", 1], ["start", "available", 0]]} =
+      Repo.query!("SELECT args->>'kind', state::text, attempt FROM oban_jobs
+        WHERE args->>'build_record_id'=$1 ORDER BY id", [record])''')
+    replace(processor, 'publish.("build.binding",', 'publish.("build.binding" <> suffix,')
+    replace(processor, '''    if command.("processor.run") == :go do
+      :ok = Oban.resume_queue(queue: :builds, local_only: true)
+      :done = command.("processor.done")
+    end''',
+            '''    if command.("processor.run" <> suffix) == :go do
+      :ok = Oban.resume_queue(queue: :builds, local_only: true)
+      if suffix == "" do
+        if command.("processor.pause-b") == :go, do: pause.("processor.b-paused")
+      else
+        :done = command.("processor.done")
+      end
+    end''')
+    return kit
+
+
+def seed_roles(root, passwords):
+    require(set(passwords) == set(PG_ROLES)
+            and len(set(passwords.values())) == len(PG_ROLES)
+            and all(re.fullmatch(r"[0-9a-f]{64}", item) for item in passwords.values()),
+            "fixture requires a distinct private hex credential for each login role")
+    roles = runpy.run_path(str(root / REGISTRATION))["ROLES"]
+    for role in BROWSER_ROLES:
+        roles += f"ALTER ROLE {role} PASSWORD '{passwords[role]}';\n"
+    return roles
+
+
+def stage_hex(root, cache, archives):
+    lock = (root / "hosted/mix.lock").read_bytes()
+    entries = re.findall(rb'\{:hex, :(\w+), "([^"]+)"', lock)
+    require(len(entries) == 21, "unexpected pinned Hex dependency roster")
+    hex_home = root / "hex"
+    tars = hex_home / "packages/hexpm"
+    tars.mkdir(parents=True)
+    shutil.copyfile(cache / "cache.ets", hex_home / "cache.ets")
+    for name, version in entries:
+        filename = f"{name.decode()}-{version.decode()}.tar"
+        shutil.copyfile(cache / "packages/hexpm" / filename, tars / filename)
+    shutil.copytree(archives / "hex-2.5.1", root / "mix/archives/hex-2.5.1")
+    return sha(lock)
+
+
+def check_private_ancestors(path):
+    for directory in (path, *path.parents):
+        info = directory.lstat()
+        require(stat.S_ISDIR(info.st_mode) and info.st_uid in (0, os.getuid())
+                and not info.st_mode & 0o022, f"untrusted scratch ancestor: {directory}")
