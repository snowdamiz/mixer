+# Included in the disposable copy of the stock signed-in HTTP test.
+@tag :l07_reusable
+@tag timeout: 1_270_000
+test "serve two authenticated requests under one iOS registration", c do
+  owner = login(c)
+  org = create(c, owner, "/console-api/v1/orgs", %{display_name: "L07 custody"})
+  scope = register_app(c, owner, org, "L07 custody")
+  pins = pair25_path("inputs.json") |> File.read!() |> Jason.decode!()
+  source = pins["source_tree_sha256"]
+  input = "l07-reusable-" <> source
+
+  assert %{num_rows: 1} =
+    DB.q!(Migration, """
+    INSERT INTO public.mixer_customer_build_inputs
+      (organization_id,project_id,application_id,platform,input_id,source_kind,
+       source_reference,source_sha256,toolchain_lock_sha256,build_definition_sha256,
+       max_attempts,timeout_ms,retry_backoff_ms)
+    VALUES ($1,$2,$3,'ios',$4,'revision',$5,$6,$7,$8,1,600000,0)
+    """, [scope.organization_id, scope.project_id, scope.application_id, input,
+          "starter-" <> source, source, pins["linux_lock_sha256"], pins["recipe_sha256"]])
+
+  build = Map.merge(scope, %{
+    platform: "ios", source_input_id: input, source_sha256: source,
+    toolchain_lock_sha256: pins["linux_lock_sha256"],
+    build_definition_sha256: pins["recipe_sha256"]
+  })
+
+  assert RuntimeOwner.status().phase == :storage_ready
+  assert c.hosted.oban[:queues] == false
+  for {repo, role} <- [
+    {MixerHosted.Repo, "browser_ordinary"},
+    {CreateRepo, "mixer_build_create"}
+  ] do
+    assert %{rows: [[^role, false, false]]} =
+      DB.q!(repo, "SELECT session_user::text, rolsuper, rolbypassrls FROM pg_roles WHERE rolname=session_user")
+  end
+
+  {cookie, csrf} = login(c)
+  pair25_publish!("api.ready", %{
+    port: c.http_port, issuer: c.provider_port, jwks: GenServer.call(c.fixture, :authority).port,
+    origin: c.config.public_origin, build: build, cookie: cookie, csrf: csrf,
+    restricted_roles: ["browser_ordinary", "mixer_build_create"]
+  })
+
+  reusable_wait!(c, ["a-readback", "b-create", "b-readback", "a-after-b"],
+    System.monotonic_time(:millisecond) + 1_245_000)
+end
+
+defp reusable_wait!(c, refreshes, deadline) do
+  assert System.monotonic_time(:millisecond) < deadline
+
+  cond do
+    File.regular?(pair25_path("api.done")) ->
+      :ok
+
+    refreshes != [] and File.regular?(pair25_path("api.refresh." <> hd(refreshes))) ->
+      [label | rest] = refreshes
+      {cookie, csrf} = login(c)
+      pair25_publish!("api.session." <> label, %{cookie: cookie, csrf: csrf})
+      reusable_wait!(c, rest, deadline)
+
+    true ->
+      Process.sleep(50)
+      reusable_wait!(c, refreshes, deadline)
+  end
+end
diff --git a/tests/integration/l07-ios-active-custody/test_reusable.py b/tests/integration/l07-ios-active-custody/test_reusable.py
