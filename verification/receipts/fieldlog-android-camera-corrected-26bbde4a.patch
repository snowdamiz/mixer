+                    catch (OutOfMemoryError error) { throw new ErrnoException("camera write", OsConstants.ENOMEM); }
+                    catch (IOException error) { throw new ErrnoException("camera write", OsConstants.EBADF); }
+                }
+                @Override public void onFsync() throws ErrnoException { onGetSize(); }
+                @Override public void onRelease() {}
+            }, proxyHandler());
+        } catch (IOException | RuntimeException error) {
+            Log.w("FieldLogPhoto", "Camera proxy open failed: " + error.getClass().getSimpleName());
+            throw new FileNotFoundException("Camera writer unavailable");
+        }
+    }
