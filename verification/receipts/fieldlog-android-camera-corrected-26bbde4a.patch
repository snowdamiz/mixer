+            if (count == 0) return 0;
+            int end = (int) offset + count;
+            if (end > bytes.length) {
+                int growth = Math.min(MAX_BYTES, Math.max(16_384, bytes.length * 2));
+                bytes = Arrays.copyOf(bytes, Math.max(end, growth));
+            }
