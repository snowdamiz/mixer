+        if (active != null) throw new IllegalStateException("Camera output already active");
+        active = new Capture();
+        return active;
+    }
+
+    static synchronized byte[] retire(Capture capture, boolean accepted) throws IOException {
+        if (active != capture) throw new IOException("Stale camera output");
+        active = null;
+        return capture.output.finish(accepted);
+    }
+
+    private static synchronized Output claim(Uri uri, String mode) throws FileNotFoundException {
+        if (active == null || !active.uri.equals(uri) || !("w".equals(mode) || "wt".equals(mode))
+                || !active.output.claimWriter()) throw new FileNotFoundException("Camera output unavailable");
+        return active.output;
+    }
+
+    // The Android proxy can seek and rewrite existing bytes. Gaps and writes
+    // beyond the common source limit are rejected before allocating memory.
+    static final class Output {
+        private byte[] bytes = new byte[0];
+        private int size;
+        private boolean open = true, claimed, tooLarge;
+
+        synchronized boolean claimWriter() {
+            if (!open || claimed) return false;
+            claimed = true;
+            return true;
+        }
+
+        synchronized int size() throws IOException {
+            if (!open || !claimed) throw new IOException("Camera writer unavailable");
+            return size;
+        }
+
+        synchronized int write(long offset, int count, byte[] source) throws IOException {
+            size();
+            if (offset < 0 || count < 0 || count > source.length) throw new IOException("Invalid camera write");
