diff --git a/Integrations/GeneratedReport/Tests/CameraOutputJava/CameraOutputChecks.java b/Integrations/GeneratedReport/Tests/CameraOutputJava/CameraOutputChecks.java
new file mode 100644
index 0000000000000000000000000000000000000000..029b4aea49ee79995f31d767be870dedef889914
--- /dev/null
+++ b/Integrations/GeneratedReport/Tests/CameraOutputJava/CameraOutputChecks.java
@@ -0,0 +1,56 @@
+package dev.fieldlog.generatedr90.androidhost;
+
+import java.io.IOException;
+import java.util.Arrays;
+
+public final class CameraOutputChecks {
+    interface Action { void run() throws IOException; }
+
+    private static void check(boolean condition, String description) {
+        if (!condition) throw new AssertionError(description);
+    }
+
+    private static void rejects(Class<? extends Exception> error, Action action) throws IOException {
+        try { action.run(); }
+        catch (Exception actual) {
+            if (error.isInstance(actual)) return;
+            throw new AssertionError(actual);
+        }
+        throw new AssertionError("Expected " + error.getSimpleName());
+    }
+
+    public static void main(String[] args) throws IOException {
+        var success = new CapturePhotoProvider.Output();
+        check(success.claimWriter() && !success.claimWriter(), "one writer per capture");
+        check(success.write(0, 3, new byte[] {1, 2, 3}) == 3, "initial write");
+        check(success.write(1, 2, new byte[] {4, 5}) == 2, "seekable rewrite");
+        rejects(IOException.class, () -> success.write(4, 1, new byte[] {6}));
+        check(Arrays.equals(success.finish(true), new byte[] {1, 4, 5}), "freeze exact bytes");
+        rejects(IOException.class, () -> success.write(0, 1, new byte[] {9}));
+        rejects(IOException.class, () -> success.finish(true));
+        check(!success.claimWriter(), "successful capture cannot reopen");
+
+        var cancelled = new CapturePhotoProvider.Output();
+        check(cancelled.claimWriter(), "admit cancelled writer");
+        cancelled.write(0, 1, new byte[] {7});
+        check(cancelled.finish(false) == null, "discard on cancellation or dismissal");
+        rejects(IOException.class, () -> cancelled.write(0, 1, new byte[] {8}));
+        rejects(IOException.class, () -> cancelled.finish(true));
+
+        var empty = new CapturePhotoProvider.Output();
+        rejects(IOException.class, () -> empty.finish(true));
+        check(!empty.claimWriter(), "empty result revoked");
+
+        var oversized = new CapturePhotoProvider.Output();
+        check(oversized.claimWriter(), "admit bounded writer");
+        byte[] exact = new byte[CapturePhotoProvider.MAX_BYTES];
+        check(oversized.write(0, exact.length, exact) == exact.length, "maximum write succeeds");
+        rejects(IllegalArgumentException.class, () -> oversized.write(exact.length, 1, new byte[] {1}));
+        rejects(IllegalArgumentException.class, () -> oversized.finish(true));
+        check(!oversized.claimWriter(), "oversized result revoked");
+        var successor = new CapturePhotoProvider.Output();
+        check(successor.claimWriter() && successor.size() == 0, "fresh output has no predecessor bytes");
+        check(successor.finish(false) == null, "successor cleaned up");
+        System.out.println("PASS camera writer uniqueness, bounded seek, exact bytes, cancel/dismiss revoke, empty output, overflow, and fresh successor");
+    }
+}
