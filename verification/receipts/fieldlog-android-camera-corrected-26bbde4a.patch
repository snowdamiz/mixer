@@ -34,0 +35,90 @@ final class PhotoSelectionTests: XCTestCase {
+    @MainActor func testCameraAndDocumentsShareOneRequestAndEightDurableSlots() async throws {
+        let dir = photoDir("camera-eight"), app = try await open(dir)
+        try send(app, "workspace.entries")
+        try send(app, "entry-title", .textChange, .string("Camera and documents"))
+        let draftID = try XCTUnwrap(app.presentation.entryState?.draft.id)
+        let cap = "entry.photo.capture", select = "entry.photo.select"
+        let initial = try Data(contentsOf: file(dir))
+        let both = [try event(app, cap), try event(app, select)]
+        try rejects("mixed sources in one batch") {
+            try app.sendBatch(owner: app.host.owner!, originalEnvelopes: JSONEncoder().encode(both))
+        }
+        XCTAssertNil(app.presentation.takePhotoRequest())
+        XCTAssertEqual(try Data(contentsOf: file(dir)), initial)
+
+        var photos: [Data] = []
+        for index in 0..<8 {
+            let camera = index.isMultiple(of: 2)
+            try send(app, camera ? cap : select)
+            let request = try XCTUnwrap(app.presentation.takePhotoRequest())
+            XCTAssertEqual(request.source, camera ? .camera : .documents)
+            XCTAssertEqual(request.draftID, draftID)
+            XCTAssertNil(app.presentation.takePhotoRequest())
+            try rejects("second source during one pending request") { try send(app, camera ? select : cap) }
+            let bytes = Data([0xff, 0xd8, 0xff, 0xe0, 0, 3, UInt8(index), 0xff, 0xd9])
+            let accepted = await app.presentation.completePhoto(requestID: request.id, result: .jpeg(bytes))
+            XCTAssertTrue(accepted)
+            photos.append(bytes)
+        }
+        let full = try Data(contentsOf: file(dir))
+        try rejects("ninth capture") { try send(app, cap) }
+        try rejects("ninth DocumentsUI selection") { try send(app, select) }
+        XCTAssertNil(app.presentation.takePhotoRequest())
+        XCTAssertEqual(try Data(contentsOf: file(dir)), full)
+        let stored = try XCTUnwrap(app.presentation.workspace.drafts.first)
+        XCTAssertEqual(stored.attachmentIDs.count, 8)
+        XCTAssertEqual(Set(stored.attachmentIDs).count, 8)
+        await app.close()
+
+        let reopened = try await open(dir)
+        XCTAssertEqual(reopened.presentation.entryState?.draft, stored)
+        for (id, expected) in zip(stored.attachmentIDs, photos) {
+            let attachment = try XCTUnwrap(reopened.presentation.workspace.attachments.first { $0.id == id })
+            let bytes = try Data(contentsOf: dir.appendingPathComponent("FieldLog/photos/" + attachment.filename))
+            XCTAssertEqual(bytes, expected)
+        }
+        let names = try FileManager.default.contentsOfDirectory(atPath: dir.appendingPathComponent("FieldLog/photos").path)
+        XCTAssertEqual(names.count, 8)
+        await reopened.close()
+    }
+
+    @MainActor func testCameraFailureAndEditorDismissalLeaveWorkspaceAndPhotosUntouched() async throws {
+        let dir = photoDir("camera-refusals"), app = try await open(dir)
+        try send(app, "workspace.entries")
+        try send(app, "entry-title", .textChange, .string("Retain the title"))
+        let before = try Data(contentsOf: file(dir))
+        try send(app, "entry-date", .textChange, .string("2024-02-"))
+        try rejects("capture with invalid draft date") { try send(app, "entry.photo.capture") }
+        XCTAssertNil(app.presentation.takePhotoRequest())
+        try send(app, "entry-date", .textChange, .string("2024-02-29T00:00:00Z"))
+        let draft = app.presentation.entryState?.draft
+
+        for failure: PhotoSelectionResult in [.cancelled, .failed(.unavailable), .failed(.denied), .failed(.invalid), .failed(.tooLarge)] {
+            try send(app, "entry.photo.capture")
+            let request = try XCTUnwrap(app.presentation.takePhotoRequest())
+            let accepted = await app.presentation.completePhoto(requestID: request.id, result: failure)
+            XCTAssertTrue(accepted)
+            XCTAssertFalse(app.presentation.photoSelectionPending)
+            XCTAssertEqual(app.presentation.entryState?.draft, draft)
+            if case .failed(.unavailable) = failure {
+                let status = fieldLogNode("entry.photo.status", in: app.presentation.snapshot.document.root)
+                XCTAssertEqual(status?.properties["text"]?.string, "Camera capture is unavailable. Your entry is unchanged.")
+            }
+            let late = await app.presentation.completePhoto(requestID: request.id, result: .jpeg(photoJPEG))
+            XCTAssertFalse(late)
+        }
+        for dismiss in ["entry.photo.cancel", "workspace.tasks", "workspace.queue", "entry.new"] {
+            try send(app, "entry.photo.capture")
+            let request = try XCTUnwrap(app.presentation.takePhotoRequest())
+            try send(app, dismiss)
+            XCTAssertFalse(app.presentation.photoSelectionPending)
+            let late = await app.presentation.completePhoto(requestID: request.id, result: .jpeg(photoJPEG))
+            XCTAssertFalse(late)
+            if dismiss == "workspace.queue" { try send(app, "workspace.back") }
+            if dismiss == "workspace.tasks" || dismiss == "workspace.queue" { try send(app, "workspace.entries") }
+        }
+        XCTAssertEqual(try Data(contentsOf: file(dir)), before)
+        XCTAssertFalse(FileManager.default.fileExists(atPath: dir.appendingPathComponent("FieldLog/photos").path))
+        await app.close()
+    }
+
