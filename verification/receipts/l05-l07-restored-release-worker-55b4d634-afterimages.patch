+#!/usr/bin/env python3
+"""Run the paired-release restore test in an already prepared private projection."""
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import signal
+import socket
+import subprocess
+import sys
+import time
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def group_absent(pid):
+    try:
+        os.killpg(pid, 0)
+    except ProcessLookupError:
+        return True
+    except PermissionError:
+        return False
+    return False
+
+
+def main(root):
+    hosted = root / "hosted"
+    artifact_repair = root / "tests/integration/phoenix-release-restore/restore-artifact-key.sql"
+    database = "browser_ordinary_installation_r1422"
+    revisions = hosted / "test/mixer_hosted/releases/browser_publication_test.exs"
+    test_line = next(number for number, line in enumerate(revisions.read_text().splitlines(), 1)
+                     if 'test "commits a new paired promotion on the restored ordinary database"' in line)
+    roles_sql = """
+CREATE ROLE browser_admin LOGIN SUPERUSER;
+CREATE ROLE browser_schema_owner NOLOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT;
+CREATE ROLE browser_writer NOLOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT;
+CREATE ROLE browser_lifecycle LOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT;
+CREATE ROLE browser_ordinary LOGIN NOSUPERUSER NOBYPASSRLS NOINHERIT;
+CREATE ROLE mixer_customer_build_catalog_definer_v1 NOLOGIN NOSUPERUSER NOBYPASSRLS
+  NOCREATEDB NOCREATEROLE NOREPLICATION NOINHERIT;
+CREATE DATABASE browser_storage OWNER browser_schema_owner;
+"""
+    report = {"status": "failed", "commands": [], "clusters": {}, "rebinds": []}
+    active = {}
+    env = {key: value for key, value in os.environ.items() if not key.startswith("PG")}
+    env.update(MIX_ENV="test", HEX_OFFLINE="1", ERL_FLAGS="+S 6:6", TMPDIR=str(root))
+    deadline = time.monotonic() + 615
+    started = time.monotonic()
+
+    def check(condition, message):
+        if not condition:
+            raise RuntimeError(message)
+
+    def step(name, argv, *, timeout=20, data=None, extra=None, cwd=root):
+        log_path = root / (name + ".log")
+        error_path = root / (name + ".stderr")
+        evidence = {"name": name, "argv": [str(a).replace(str(root), "<scratch>") for a in argv]}
+        report["commands"].append(evidence)
+        with log_path.open("xb") as log, error_path.open("xb") as error:
+            stdin = root / (name + ".stdin")
+            stdin.write_bytes(data or b"")
+            with stdin.open("rb") as source:
+                evidence["groupAbsent"] = False
+                child = subprocess.Popen(argv, cwd=cwd, env=env | (extra or {}), start_new_session=True,
+                                         stdin=source, stdout=log, stderr=error)
+                evidence["pidPgid"] = child.pid
+                evidence["exit"] = child.wait(timeout=max(0.1, min(timeout, deadline - time.monotonic())))
+                evidence["groupAbsent"] = group_absent(child.pid)
+
+        check(evidence["groupAbsent"], f"{name}: command group absence unconfirmed")
+        raw = log_path.read_bytes()
+        error = error_path.read_bytes()
+        evidence.update(stdoutSha256=digest(raw), stderrSha256=digest(error))
+        if evidence["exit"] != 0:
+            evidence["failureTail"] = (raw + b"\n" + error).decode(errors="replace").splitlines()[-38:]
+            raise RuntimeError(f"{name}: exit {evidence['exit']}")
+        return raw
+
+    def psql(phase, name, database, *, sql=None, file=None):
+        sock = root / phase / "socket"
+        argv = ["psql", "-X", "-qAt", "-w", "-h", str(sock), "-p", "5432",
+                "-U", "mixer_fixture", "-d", database, "-v", "ON_ERROR_STOP=1"]
+        if file is not None:
+            argv += ["-f", str(file)]
+        return step(f"{phase}-{name}", argv, data=sql.encode() if sql else None)
+
+    def verify_rebind(phase, kind, target):
+        family = socket.AF_UNIX if kind == "postgres" else socket.AF_INET
+        record = {"phase": phase, "listener": kind,
+                  "address": str(target).replace(str(root), "<scratch>"), "rebound": False}
+        report["rebinds"].append(record)
+        with socket.socket(family) as server:
+            if family == socket.AF_INET:
+                server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+            server.bind(target)
+            server.listen(1)
+            record["rebound"] = True
+        if family == socket.AF_UNIX:
+            Path(target).unlink()
+
+    def cluster(phase):
+        directory = root / phase
+        directory.mkdir(mode=0o700)
+        sock = directory / "socket"
+        sock.mkdir(mode=0o700)
+        pgdata = directory / "pgdata"
+        step(phase + "-initdb", ["initdb", "-D", str(pgdata), "-U", "mixer_fixture",
+                                "--auth-local=trust", "--auth-host=scram-sha-256",
+                                "--no-locale", "-E", "UTF8"])
+        # Only the private directory is reachable. Retain explicit host rejection in pg_hba as well.
+        (pgdata / "pg_hba.conf").write_text("local all all trust\nhost all all all reject\n")
+        argv = ["postgres", "-D", str(pgdata), "-h", "", "-p", "5432", "-k", str(sock),
+                "-c", "unix_socket_permissions=0700", "-c", "timezone=UTC", "-c", "max_connections=32"]
+        entry = {"argv": [a.replace(str(root), "<scratch>") for a in argv],
+                 "groupAbsent": False, "socketDirectoryMode": oct(sock.stat().st_mode & 0o777)}
+        report["clusters"][phase] = entry
+        with (directory / "postgres.log").open("xb") as log:
+            server = subprocess.Popen(argv, env=env, start_new_session=True,
+                                      stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT)
+        entry["pidPgid"] = server.pid
+        active[phase] = server
+        socket_path = sock / ".s.PGSQL.5432"
+        ready = time.monotonic() + 10
+        while not socket_path.exists() and server.poll() is None and time.monotonic() < ready:
+            time.sleep(0.025)
+        check(socket_path.exists(), phase + " PostgreSQL socket failed to appear")
+        output = psql(phase, "identity", "postgres", sql="""
+SELECT system_identifier FROM pg_control_system();
+SELECT inet_server_addr() IS NULL AND current_setting('listen_addresses') = '';
+""").decode().splitlines()
+        check(len(output) == 2 and output[1] == "t", "unexpected PostgreSQL listener")
+        entry.update(systemId=output[0], unixSocketOnly=True)
+
+    def stop(phase):
+        server = active[phase]
+        entry = report["clusters"][phase]
+        if server.poll() is None:
+            server.send_signal(signal.SIGINT)  # PostgreSQL fast shutdown requests backend exit.
+        entry["exit"] = server.wait(timeout=15)
+        entry["groupAbsent"] = group_absent(server.pid)
+        check(entry["groupAbsent"], f"{phase} PostgreSQL group absence unconfirmed")
+        del active[phase]
+        if entry.get("unixSocketOnly"):
+            verify_rebind(phase, "postgres", str(root / phase / "socket" / ".s.PGSQL.5432"))
+        check(entry["exit"] == 0, f"{phase} PostgreSQL exited {entry['exit']}")
+
+    def fixture(phase):
+        directory = root / phase
+        catalog = directory / "catalog"
+        catalog.mkdir()
+        ports = directory / "ports"
+        extra = {
+            "MIXER_BROWSER_STORAGE_PORT": "5432",
+            "MIXER_BROWSER_CATALOG_FIXTURE_ROOT": str(catalog),
+            "MIXER_RESTORED_WRITE_SOCKET": str(directory / "socket"),
+            "MIXER_RESTORED_WRITE_PHASE": phase,
+            "MIXER_RESTORED_WRITE_BUNDLE": str(root / "signer-bundle"),
+            "MIXER_RESTORED_WRITE_PORTS": str(ports),
+            **{f"MIXER_RESTORED_WRITE_{name.upper()}": str(directory / (name + ".json"))
+               for name in ("result", "processor", "delivery")},
+        }
+        try:
+            raw = step(f"{phase}-http-test",
+                       ["mix", "test", "--warnings-as-errors", "--trace", "--no-color", "--seed", "0",
+                        "--timeout", "90000", f"{revisions.relative_to(hosted)}:{test_line}"],
+                       timeout=130, extra=extra, cwd=hosted)
+            report[phase + "ExUnit"] = raw.decode().splitlines()[-6:]
+        finally:
+            if report["commands"][-1].get("groupAbsent") and ports.exists():
+                for line in ports.read_text().splitlines():
+                    kind, port = line.split()
+                    verify_rebind(phase, kind, ("127.0.0.1", int(port)))
+            for key in ("result", "processor", "delivery"):
+                path = directory / (key + ".json")
+                if path.exists():
+                    report[phase + "_" + key] = json.loads(path.read_text())
+
+    def snapshot(phase):
+        relations = (
+            "public.schema_migrations", "public.mixer_release_heads",
+            "public.mixer_release_publications", "public.mixer_stage_promotion_bindings",
+            "public.mixer_stage_promotion_directions", "public.mixer_release_delivery_enrollments",
+            "public.mixer_customer_artifacts", "mixer_release_jobs.oban_jobs",
+            "mixer_release_jobs.offer_materializations",
+        )
+        # Hash each row independently, then compare the stable set of row hashes per table.
+        return psql(phase, "snapshot", database, sql="\n".join(
+            f"SELECT '{table}', count(*), md5(coalesce(string_agg(d,'|' ORDER BY d), '')) "
+            f"FROM (SELECT md5(to_jsonb(t)::text) AS d FROM {table} t) s;"
+            for table in relations))
+
+    try:
+        report["tools"] = {
+            "host": f"{platform.system()} {platform.machine()}",
+            "python": platform.python_version(),
+            **{command: step(command + "-version", [command, "--version"]).decode().strip()
+               for command in ("mix", "postgres", "pg_dump", "pg_restore")}
+        }
+        step("compile", ["mix", "compile", "--warnings-as-errors"], timeout=140, cwd=hosted)
+        cluster("source")
+        psql("source", "bootstrap-roles", "postgres", sql=roles_sql)
+        fixture("source")
+        psql("source", "freeze", "postgres",
+             sql="ALTER SYSTEM SET default_transaction_read_only=on;\nSELECT pg_reload_conf();\n")
+        source_socket = str(root / "source" / "socket")
+        read_only = psql("source", "read-only", database, sql="SHOW default_transaction_read_only;").strip()
+        check(read_only == b"on", "source database did not freeze")
+        source_snapshot = snapshot("source")
+        dump = root / "release.dump"
+        roles = root / "roles.sql"
+        login = ["-h", source_socket, "-p", "5432", "-U", "mixer_fixture", "-w"]
+        step("source-dump", ["pg_dump", *login, "-Fc", "-f", str(dump), database])
+        step("source-dump-roles", ["pg_dumpall", *login, "--roles-only", "--no-role-passwords",
+                                    "--no-comments", "-f", str(roles)])
+        report["backup"] = {"dumpSha256": digest(dump.read_bytes()),
+                            "passwordFreeRolesSha256": digest(roles.read_bytes()),
+                            "sourceSnapshotSha256": digest(source_snapshot)}
+        stop("source")
+
+        cluster("target")
+        check(report["clusters"]["source"]["systemId"] != report["clusters"]["target"]["systemId"],
+              "restore did not create a distinct PostgreSQL cluster")
+        absent_sql = f"SELECT NOT EXISTS (SELECT FROM pg_database WHERE datname='{database}');"
+        check(psql("target", "db-absent", "postgres", sql=absent_sql).strip() == b"t",
+              "destination database already present")
+        psql("target", "restore-roles", "postgres", file=roles)
+        dest_socket = str(root / "target" / "socket")
+        step("target-restore", ["pg_restore", "-h", dest_socket, "-p", "5432", "-U",
+                                "mixer_fixture", "-w", "--exit-on-error", "--create", "-d", "postgres",
+                                str(dump)])
+        psql("target", "repair-authz-checks", database, file=root / "scripts/restore-local-authz-expiry.sql")
+        psql("target", "repair-artifact-check", database, file=artifact_repair)
+        dest_snapshot = snapshot("target")
+        report["backup"]["targetSnapshotSha256"] = digest(dest_snapshot)
+        report["backup"]["snapshotsEqual"] = source_snapshot == dest_snapshot
+        report["backup"]["counts"] = {
+            row.split("|")[0]: int(row.split("|")[1]) for row in dest_snapshot.decode().splitlines()
+        }
+        check(source_snapshot == dest_snapshot, "restored pre-promotion ledger differs from backup")
+        fixture("target")
+
+        processor = report["target_processor"]
+        for item in report["target_delivery"]["platforms"].values():
+            jobs = [row for row in processor["rows"] if row["args"]["platform"] == item["target"]["platform"]
+                    and row["args"]["environment_id"] == item["target"]["environment"]
+                    and row["args"]["sequence"] == str(item["sequence"])]
+            check(len(jobs) == 1 and jobs[0]["assignment_wire_sha256"] == item["signed_assignment_sha256"]
+                  and jobs[0]["artifact_sha256"] == item["canonical_manifest_sha256"],
+                  "served assignment/artifact differs from projection")
+            item["jobId"] = jobs[0]["job_id"]
+        report["status"] = "pass"
+    except (Exception, KeyboardInterrupt) as error:
+        report["failure"] = f"{type(error).__name__}: {error}"
+    finally:
+        unknown = any(not command.get("groupAbsent") for command in report["commands"])
+        if not unknown:
+            for phase in tuple(active):
+                try:
+                    stop(phase)
+                except (Exception, KeyboardInterrupt) as error:
+                    report["cleanupFailure"] = f"{type(error).__name__}: {error}"
+                    break
+        report["scratchRemovable"] = (
+            not unknown and not active and "cleanupFailure" not in report
+            and all(listener["rebound"] for listener in report["rebinds"])
+        )
+        report["durationSeconds"] = round(time.monotonic() - started, 2)
+        (root / "campaign.json").write_text(json.dumps(report, indent=2) + "\n")
+        print(json.dumps({key: report[key] for key in ("status", "failure", "cleanupFailure",
+                                                       "scratchRemovable", "durationSeconds")
+                          if key in report}))
+    return 0 if report["status"] == "pass" and report["scratchRemovable"] else 1
+
+
+if __name__ == "__main__":
+    os.umask(0o077)
+    sys.exit(main(Path(sys.argv[1]).resolve(strict=True)))
