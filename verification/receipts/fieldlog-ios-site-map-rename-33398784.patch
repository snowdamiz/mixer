diff --git a/ios/FieldLog/CoreSiteLocation.swift b/ios/FieldLog/CoreSiteLocation.swift
new file mode 100644
index 0000000000000000000000000000000000000000..da006e79de3b6f52c92256a2419b2c9f93eff14f
--- /dev/null
+++ b/ios/FieldLog/CoreSiteLocation.swift
@@ -0,0 +1,51 @@
+import CoreLocation
+import FieldLogModels
+import Foundation
+
+@MainActor
+final class CoreSiteLocation: NSObject, SiteLocationDriver, @preconcurrency CLLocationManagerDelegate {
+  private let manager = CLLocationManager()
+  var onEvent: ((SiteMapLocation.Event) -> Void)?
+
+  override init() {
+    super.init()
+    manager.desiredAccuracy = kCLLocationAccuracyHundredMeters
+    manager.delegate = self
+  }
+
+  var authorization: SiteMapLocation.Authorization {
+    switch manager.authorizationStatus {
+    case .notDetermined: .undetermined
+    case .authorizedWhenInUse, .authorizedAlways: .allowed
+    case .denied: .denied
+    case .restricted: .restricted
+    @unknown default: .restricted
+    }
+  }
+
+  func requestPermission() { manager.requestWhenInUseAuthorization() }
+  func requestLocation() { manager.requestLocation() }
+  func stop() {
+    manager.delegate = nil
+    manager.stopUpdatingLocation()
+  }
+
+  func locationManagerDidChangeAuthorization(_ manager: CLLocationManager) {
+    onEvent?(.authorizationChanged)
+  }
+
+  func locationManager(_ manager: CLLocationManager, didUpdateLocations locations: [CLLocation]) {
+    let fix = locations.last.flatMap { location -> SiteMapFix? in
+      guard abs(location.timestamp.timeIntervalSinceNow) <= 15,
+        let coordinate = SiteCoordinate(
+          latitude: location.coordinate.latitude, longitude: location.coordinate.longitude)
+      else { return nil }
+      return SiteMapFix(coordinate: coordinate, accuracyMeters: location.horizontalAccuracy)
+    }
+    onEvent?(.result(fix))
+  }
+
+  func locationManager(_ manager: CLLocationManager, didFailWithError error: any Error) {
+    onEvent?(.result(nil))
+  }
+}
