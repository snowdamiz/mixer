+    location.retire()
+
+    let pin = try #require(SiteCoordinate(latitude: 40.7, longitude: -74))
+    #expect(await model.saveSitePin(edit, to: pin))
+    let withPin = try await repository.readCommittedSnapshot()
+    #expect(withPin.revision == before.revision + 1)
+    #expect(withPin.projects.first(where: { $0.id == first })?.siteCoordinate == pin)
+    #expect(withPin.projects.first(where: { $0.id == second })?.siteCoordinate == nil)
