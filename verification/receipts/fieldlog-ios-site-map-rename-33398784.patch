+  @Test func explicitPermissionWaitsForActiveSceneAndAcquiresOneFix() throws {
+    let owner = SiteMapLocation()
+    let driver = Driver(.undetermined)
+    owner.request(ownsRoute: { true }, isForeground: { true }, makeDriver: { driver })
+    #expect(driver.permissionRequests == 0)
+    owner.updateActivity(.active)
+    #expect(driver.permissionRequests == 0)
+    owner.request(ownsRoute: { true }, isForeground: { true }, makeDriver: { driver })
+    owner.request(ownsRoute: { true }, isForeground: { true }, makeDriver: { driver })
+    #expect(driver.permissionRequests == 1)
+    #expect(driver.locationRequests == 0)
+    owner.updateActivity(.inactive)
+    driver.authorization = .allowed
+    driver.emit(.authorizationChanged)
+    #expect(owner.status == .askingPermission)
+    #expect(driver.locationRequests == 0)
+    owner.updateActivity(.active)
+    driver.emit(.authorizationChanged)
+    #expect(driver.locationRequests == 1)
+    let callback = try #require(driver.onEvent)
+    let fix = try makeFix()
+    callback(.result(fix))
+    #expect(owner.status == .located(fix))
+    #expect(driver.stops == 1)
+    callback(.result(nil))
+    #expect(owner.status == .located(fix))
+    owner.updateActivity(.inactive)
+    #expect(owner.status == .idle)
+    owner.updateActivity(.active)
+    #expect(driver.locationRequests == 1)
+  }
+
+  @Test func oldCallbacksCannotReachReopenedProject() throws {
+    let owner = SiteMapLocation()
+    owner.updateActivity(.active)
+    let old = Driver(.allowed)
+    owner.request(ownsRoute: { true }, isForeground: { true }, makeDriver: { old })
+    let late = try #require(old.onEvent)
+    owner.retire()
+    #expect(old.stops == 1)
+
+    let new = Driver(.allowed)
+    owner.request(ownsRoute: { true }, isForeground: { true }, makeDriver: { new })
+    let fix = try makeFix()
+    late(.result(fix))
+    #expect(owner.status == .locating)
+    new.emit(.result(nil))
+    #expect(owner.status == .unavailable)
+    #expect(new.stops == 1)
+  }
+
+  @Test func authorityLossRejectsFixAndBackgroundDropsPendingPermission() throws {
+    let owner = SiteMapLocation()
+    owner.updateActivity(.active)
+    let route = Authority()
+    let fix = try makeFix()
+    for authorityLoss in [\Authority.ownsProject, \Authority.foreground] {
+      route[keyPath: authorityLoss] = true
+      let driver = Driver(.allowed)
+      owner.request(ownsRoute: { route.ownsProject }, isForeground: { route.foreground }, makeDriver: { driver })
+      #expect(driver.locationRequests == 1)
+      route[keyPath: authorityLoss] = false
+      driver.emit(.result(fix))
+      #expect(owner.status == .idle)
+      #expect(driver.stops == 1)
+      route[keyPath: authorityLoss] = true
+    }
+
+    let pending = Driver(.undetermined)
+    owner.request(ownsRoute: { true }, isForeground: { true }, makeDriver: { pending })
+    let late = try #require(pending.onEvent)
+    owner.updateActivity(.background)
+    pending.authorization = .allowed
+    late(.authorizationChanged)
+    owner.updateActivity(.active)
+    #expect(owner.status == .idle)
+    #expect(pending.locationRequests == 0)
+    #expect(pending.stops == 1)
+  }
+
+  @Test func deniedRestrictedAndRevokedPermissionNeverDeliverLocation() throws {
+    let owner = SiteMapLocation()
+    owner.updateActivity(.active)
+    let denied = Driver(.denied)
+    owner.request(ownsRoute: { true }, isForeground: { true }, makeDriver: { denied })
+    #expect(owner.status == .denied)
+    #expect(denied.permissionRequests == 0 && denied.locationRequests == 0)
+    let restricted = Driver(.restricted)
+    owner.request(ownsRoute: { true }, isForeground: { true }, makeDriver: { restricted })
+    #expect(owner.status == .restricted)
+    #expect(restricted.permissionRequests == 0 && restricted.locationRequests == 0)
+
+    let revoked = Driver(.allowed)
+    owner.request(ownsRoute: { true }, isForeground: { true }, makeDriver: { revoked })
+    revoked.authorization = .denied
+    revoked.emit(.result(try makeFix()))
+    #expect(owner.status == .denied)
+    #expect(revoked.stops == 1)
+  }
+
+  private func makeFix() throws -> SiteMapFix {
+    let coordinate = try #require(SiteCoordinate(latitude: 37.77, longitude: -122.42))
+    return try #require(SiteMapFix(coordinate: coordinate, accuracyMeters: 80))
+  }
+
+  private final class Authority {
+    var ownsProject = true
+    var foreground = true
+  }
+
+  private final class Driver: SiteLocationDriver {
+    var authorization: SiteMapLocation.Authorization
+    var onEvent: ((SiteMapLocation.Event) -> Void)?
+    var permissionRequests = 0
+    var locationRequests = 0
+    var stops = 0
+
+    init(_ authorization: SiteMapLocation.Authorization) { self.authorization = authorization }
+    func requestPermission() { permissionRequests += 1 }
+    func requestLocation() { locationRequests += 1 }
+    func stop() { stops += 1 }
+    func emit(_ event: SiteMapLocation.Event) { onEvent?(event) }
+  }
+}
