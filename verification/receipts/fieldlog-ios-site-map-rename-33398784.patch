+
+  @Test func queuedPinCannotWriteAfterSameMapReopens() async throws {
+    struct ReadOnly: Error {}
+    let (directory, repository, model, first, _) = try await openWorkspace()
+    defer { try? FileManager.default.removeItem(at: directory) }
+    model.showSiteMap(for: first)
+    let old = try #require(model.sitePinEdit(projectID: first))
+    let before = try await repository.readCommittedSnapshot()
+    let file = directory.appendingPathComponent("workspace.json")
+    let bytes = try Data(contentsOf: file)
+    let coordinate = try makeFix().coordinate
+    let (blocked, reached) = AsyncStream<Void>.makeStream()
+    let release = DispatchSemaphore(value: 0)
+    let blocker = Task {
+      do {
+        try await repository.transact { _ in
+          reached.yield()
+          _ = release.wait(timeout: .now() + 5)
+          throw ReadOnly()
+        }
+      } catch is ReadOnly {}
+    }
+    var barrier = blocked.makeAsyncIterator()
+    _ = await barrier.next()
+    let (started, entered) = AsyncStream<Void>.makeStream()
+    let pending = Task {
+      entered.yield()
+      return await model.saveSitePin(old, to: coordinate)
+    }
+    var launch = started.makeAsyncIterator()
+    _ = await launch.next()
+    #expect(model.pendingSaves == 1)
+    model.showSiteMap(for: nil)
+    model.showSiteMap(for: first)
+    release.signal()
+
+    try await blocker.value
+    #expect(!(await pending.value))
+    #expect(try await repository.readCommittedSnapshot() == before)
+    #expect(try Data(contentsOf: file) == bytes)
+    await repository.close()
+  }
+
+  @Test(arguments: ["before_rename", "after_rename"])
+  func backOrdersAgainstSitePinRename(phase: String) async throws {
+    struct HookTimedOut: Error {}
+    let armed = OSAllocatedUnfairLock(initialState: false)
+    let (blocked, reached) = AsyncStream<Void>.makeStream()
+    let release = DispatchSemaphore(value: 0)
+    let (directory, repository, model, first, _) = try await openWorkspace { point in
+      guard point == phase, armed.withLock({ armed in
+        defer { armed = false }
+        return armed
+      }) else { return }
+      reached.yield()
+      guard release.wait(timeout: .now() + 10) == .success else { throw HookTimedOut() }
+    }
+    defer { try? FileManager.default.removeItem(at: directory) }
+    let file = directory.appendingPathComponent("workspace.json")
+    let originalBytes = try Data(contentsOf: file)
+    let original = try await repository.readCommittedSnapshot()
+    let coordinate = try makeFix().coordinate
+    var withPin = original
+    try withPin.setSiteCoordinate(projectID: first, expected: nil, to: coordinate)
+    withPin.revision += 1
+    model.showSiteMap(for: first)
+    let edit = try #require(model.sitePinEdit(projectID: first))
+
+    armed.withLock { $0 = true }
+    let pending = Task { await model.saveSitePin(edit, to: coordinate) }
+    let deadline = Task {
+      try? await Task.sleep(for: .seconds(5))
+      reached.finish()
+    }
+    var barrier = blocked.makeAsyncIterator()
+    let hit: Void? = await barrier.next()
+    deadline.cancel()
+    #expect(hit != nil)
+    let publicationWon = phase == "after_rename"
+    model.restoreProject(nil)
+    #expect(!model.stillShowsSiteMap(for: edit))
+    #expect(model.pendingSaves == 2)
+    if publicationWon {
+      let published = try? JSONDecoder().decode(Workspace.self, from: Data(contentsOf: file))
+      #expect(published == withPin)
+    } else {
+      #expect((try? Data(contentsOf: file)) == originalBytes)
+    }
+    release.signal()
+
+    #expect(await pending.value == publicationWon)
+    await model.flush()
+    var expected = publicationWon ? withPin : original
+    expected.restoration.selectedProjectID = nil
+    expected.revision += 1
+    #expect(model.saveError == nil)
+    #expect(try await repository.readCommittedSnapshot() == expected)
+    await repository.close()
+    let reopened = try WorkspaceRepository(directory: directory)
+    #expect(try await reopened.readCommittedSnapshot() == expected)
+    await reopened.close()
+  }
