+    model.restoreProject(second)
+    #expect(!(await model.saveSitePin(current, to: nil)))
+    await model.flush()
+    let switched = try await repository.readCommittedSnapshot()
+    #expect(switched.revision == withPin.revision + 1)
+    #expect(switched.projects == withPin.projects)
