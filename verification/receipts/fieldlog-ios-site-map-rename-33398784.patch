diff --git a/ios/FieldLog/ProjectSiteMap.swift b/ios/FieldLog/ProjectSiteMap.swift
new file mode 100644
index 0000000000000000000000000000000000000000..bdefb5a4df1e7836b9c5c1dcf087da36c82d8fa5
--- /dev/null
+++ b/ios/FieldLog/ProjectSiteMap.swift
@@ -0,0 +1,308 @@
+import FieldLogModels
+import SwiftUI
+
+struct ProjectSiteMap: View {
+  @EnvironmentObject private var model: WorkspaceModel
+  let projectID: UUID
+
+  var body: some View {
+    Group {
+      if let selection = model.sitePinEdit(projectID: projectID) {
+        ActiveProjectSiteMap(selection: selection)
+          .id(selection.session.id)
+      } else {
+        ContentUnavailableView("Site map unavailable", systemImage: "map",
+          description: Text("Open the project to view its site map."))
+      }
+    }
+    .navigationTitle("Site map")
+    .navigationBarTitleDisplayMode(.inline)
+  }
+}
+
+private struct ActiveProjectSiteMap: View {
+  @EnvironmentObject private var model: WorkspaceModel
+  @Environment(\.scenePhase) private var scenePhase
+  @Environment(\.locale) private var locale
+  @StateObject private var location = SiteMapLocation()
+  @State private var edit: SitePinEdit?
+  @State private var clearing: SitePinEdit?
+  @State private var latitude = ""
+  @State private var longitude = ""
+  @State private var saving = false
+  @State private var showSaveFailure = false
+  let selection: SitePinEdit
+
+  var body: some View {
+    Form {
+      Section {
+        OfflineSiteMap(site: selection.before, fix: location.status.fix, locale: locale).equatable()
+      }
+      Section("Site pin") {
+        if let edit {
+          TextField("Latitude", text: $latitude)
+            .keyboardType(.numbersAndPunctuation).autocorrectionDisabled()
+          TextField("Longitude", text: $longitude)
+            .keyboardType(.numbersAndPunctuation).autocorrectionDisabled()
+          Text("Enter latitude from −90 to 90 and longitude from −180 to 180 in decimal degrees.")
+            .font(.footnote).foregroundStyle(.secondary)
+          let coordinate = enteredCoordinate
+          Button("Save site pin") {
+            if let coordinate { save(edit, to: coordinate) }
+          }
+          .disabled(saving || coordinate == nil || coordinate == edit.before || scenePhase != .active)
+          Button("Cancel editing", role: .cancel) { cancelEdit() }.disabled(saving)
+        } else {
+          if let pin = selection.before {
+            LabeledContent("Latitude", value: coordinateText(pin.latitude, locale: locale))
+            LabeledContent("Longitude", value: coordinateText(pin.longitude, locale: locale))
+          }
+          Button(selection.before == nil ? "Set site pin" : "Edit site pin", systemImage: "mappin") {
+            beginEdit(selection)
+          }
+          .disabled(saving)
+          if selection.before != nil {
+            Button("Clear site pin", role: .destructive) { clearing = selection }
+              .disabled(saving || scenePhase != .active)
+          }
+        }
+      }
+      Section {
+        switch location.status {
+        case .askingPermission:
+          Text("Waiting for location permission…")
+        case .locating:
+          ProgressView("Finding your location…")
+        case .denied:
+          Text("Location permission is off. You can change it in Settings.")
+        case .restricted:
+          Text("Location access is restricted on this device.")
+        case .unavailable:
+          Text("A recent location is unavailable. Try again.")
+        case .located:
+          Button("Hide current location") { location.retire() }
+        case .idle:
+          EmptyView()
+        }
+        if location.status.inProgress {
+          Button("Cancel location request", role: .cancel) { location.retire() }
+        } else if location.status.fix == nil {
+          Button("Show my location", systemImage: "location", action: requestLocation)
+            .disabled(scenePhase != .active)
+        }
+      } header: {
+        Text("Current location")
+      } footer: {
+        Text("Your location appears temporarily on this map and is never saved.")
+      }
+    }
+    .onAppear { setActivity(scenePhase) }
+    .onDisappear { location.retire() }
+    .onChange(of: scenePhase) { _, phase in setActivity(phase) }
+    .onReceive(model.$siteMapSession) { session in
+      if session != selection.session { location.retire() }
+    }
+    .onReceive(model.$workspace) { workspace in
+      if SitePinEdit(workspace: workspace, session: selection.session) == nil { location.retire() }
+    }
+    .confirmationDialog("Clear the site pin?", isPresented: Binding(
+      get: { clearing != nil }, set: { if !$0 { clearing = nil } }
+    ), titleVisibility: .visible, presenting: clearing) { edit in
+      Button("Clear site pin", role: .destructive) { save(edit, to: nil) }
+    }
+    .alert("Site pin couldn't be saved", isPresented: $showSaveFailure) {
+      Button("OK", role: .cancel) {}
+    } message: {
+      Text("Reopen the editor to use the latest project state.")
+    }
+  }
+
+  private func setActivity(_ phase: ScenePhase) {
+    switch phase {
+    case .active: location.updateActivity(.active)
+    case .inactive: location.updateActivity(.inactive)
+    case .background: location.updateActivity(.background)
+    @unknown default: location.updateActivity(.background)
+    }
+  }
+
+  private func requestLocation() {
+    let selection = selection
+    location.request(
+      ownsRoute: { [weak model] in model?.stillShowsSiteMap(for: selection) == true },
+      isForeground: { UIApplication.shared.applicationState == .active },
+      makeDriver: { CoreSiteLocation() }
+    )
+  }
+
+  private func beginEdit(_ selection: SitePinEdit) {
+    edit = selection
+    let inputLocale = Locale(identifier: "en_US_POSIX")
+    latitude = selection.before.map { coordinateText($0.latitude, locale: inputLocale) } ?? ""
+    longitude = selection.before.map { coordinateText($0.longitude, locale: inputLocale) } ?? ""
+  }
+
+  private func cancelEdit() {
+    edit = nil
+    latitude = ""
+    longitude = ""
+  }
+
+  private func coordinateText(_ value: Double, locale: Locale) -> String {
+    value.formatted(.number.locale(locale).grouping(.never).precision(.fractionLength(0...7)))
+  }
+
+  private var enteredCoordinate: SiteCoordinate? {
+    func number(_ text: String) -> Double? {
+      let normalized = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        .replacingOccurrences(of: locale.decimalSeparator ?? ".", with: ".")
+        .replacingOccurrences(of: "−", with: "-")
+      var decimal = ""
+      for character in normalized {
+        if "+-.".contains(character) {
+          decimal.append(character)
+        } else if character.unicodeScalars.first?.properties.numericType == .decimal,
+          let digit = character.wholeNumberValue
+        {
+          decimal.append(String(digit))
+        } else {
+          return nil
+        }
+      }
+      return Double(decimal)
+    }
+    guard let latitude = number(latitude), let longitude = number(longitude) else { return nil }
+    return SiteCoordinate(latitude: latitude, longitude: longitude)
+  }
+
+  private func save(_ edit: SitePinEdit, to coordinate: SiteCoordinate?) {
+    guard !saving, scenePhase == .active else { return }
+    saving = true
+    Task {
+      let saved = await model.saveSitePin(edit, to: coordinate)
+      saving = false
+      cancelEdit()
+      showSaveFailure = !saved
+    }
+  }
+}
+
+private struct OfflineSiteMap: View, Equatable {
+  let site: SiteCoordinate?
+  let fix: SiteMapFix?
+  let locale: Locale
+
+  private static let geography: SiteMapGeography? = {
+    guard let url = Bundle.main.url(forResource: "natural-earth-50m", withExtension: "flg"),
+      let file = try? FileHandle(forReadingFrom: url)
+    else { return nil }
+    defer { try? file.close() }
+    guard let data = try? file.read(upToCount: SiteMapGeography.maximumBytes + 1) else { return nil }
+    return try? SiteMapGeography(data: data)
+  }()
+
+  var body: some View {
+    if site == nil && fix == nil {
+      ContentUnavailableView("No site pin", systemImage: "mappin.slash",
+        description: Text("Set a site pin or show your current location to center the map."))
+    } else if let geography = Self.geography,
+      let scene = try? SiteMapScene.project(site: site, fix: fix, geography: geography)
+    {
+      VStack(alignment: .leading, spacing: 10) {
+        SiteMapCanvas(scene: scene)
+          .aspectRatio(1, contentMode: .fit)
+          .frame(maxWidth: 400)
+          .frame(maxWidth: .infinity)
+          .clipShape(.rect(cornerRadius: 12))
+          .accessibilityHidden(true)
+        if scene.site != nil {
+          Label("Saved site pin", systemImage: "diamond.fill").foregroundStyle(FieldStyle.green)
+        }
+        if let position = SiteMapLocation.position(in: scene, locale: locale) {
+          Label {
+            Text(position)
+              .fixedSize(horizontal: false, vertical: true)
+          } icon: {
+            Image(systemName: "circle.fill").foregroundStyle(.blue)
+          }
+          .font(.body)
+          .accessibilityIdentifier("site-map-current-location-position")
+        } else if fix != nil {
+          Text("Your current location is outside this map area.")
+        }
+        let distance = Measurement(value: Double(scene.scale.meters), unit: UnitLength.meters)
+        Text("Scale: \(distance.formatted(.measurement(width: .abbreviated, usage: .road)))")
+        Text("Made with Natural Earth").foregroundStyle(.secondary)
+      }
+      .font(.footnote)
+    } else {
+      ContentUnavailableView("Offline map unavailable", systemImage: "map")
+    }
+  }
+}
+
+private struct SiteMapCanvas: View {
+  let scene: SiteMapScene
+
+  var body: some View {
+    Canvas { context, size in
+      func point(_ point: SiteMapScene.Point) -> CGPoint {
+        CGPoint(x: point.x * size.width, y: point.y * size.height)
+      }
+      func circle(at point: CGPoint, radius: CGFloat) -> Path {
+        Path(ellipseIn: CGRect(x: point.x - radius, y: point.y - radius,
+          width: radius * 2, height: radius * 2))
+      }
+      var coastlines = Path()
+      var lakes = Path()
+      var rivers = Path()
+      for segment in scene.segments {
+        let a = point(segment.from)
+        let b = point(segment.to)
+        switch segment.layer {
+        case .coastline:
+          coastlines.move(to: a)
+          coastlines.addLine(to: b)
+        case .lake:
+          lakes.move(to: a)
+          lakes.addLine(to: b)
+        case .river:
+          rivers.move(to: a)
+          rivers.addLine(to: b)
+        }
+      }
+      context.stroke(coastlines, with: .color(.secondary), lineWidth: 1)
+      context.stroke(lakes, with: .color(.teal), lineWidth: 1)
+      context.stroke(rivers, with: .color(.teal), lineWidth: 1)
+      if let fix = scene.fix, let radius = fix.accuracyRadius {
+        let area = circle(at: point(fix.point), radius: radius * size.width)
+        context.fill(area, with: .color(.blue.opacity(0.14)))
+        context.stroke(area, with: .color(.blue.opacity(0.55)), lineWidth: 1)
+      }
+      if let site = scene.site {
+        let center = point(site)
+        let marker = Path { path in
+          path.move(to: CGPoint(x: center.x, y: center.y - 11))
+          path.addLine(to: CGPoint(x: center.x + 11, y: center.y))
+          path.addLine(to: CGPoint(x: center.x, y: center.y + 11))
+          path.addLine(to: CGPoint(x: center.x - 11, y: center.y))
+          path.closeSubpath()
+        }
+        context.fill(marker, with: .color(FieldStyle.green))
+        context.stroke(marker, with: .color(Color(uiColor: .systemBackground)), lineWidth: 2)
+      }
+      if let fix = scene.fix {
+        let marker = circle(at: point(fix.point), radius: 5)
+        context.fill(marker, with: .color(.blue))
+        context.stroke(marker, with: .color(Color(uiColor: .systemBackground)), lineWidth: 2)
+      }
+      let bar = Path { path in
+        path.move(to: CGPoint(x: 14, y: size.height - 14))
+        path.addLine(to: CGPoint(x: 14 + scene.scale.fractionOfWidth * size.width, y: size.height - 14))
+      }
+      context.stroke(bar, with: .color(Color(uiColor: .systemBackground)), lineWidth: 5)
+      context.stroke(bar, with: .color(.primary), lineWidth: 2)
+    }
+    .background(Color(uiColor: .tertiarySystemGroupedBackground))
+  }
+}
