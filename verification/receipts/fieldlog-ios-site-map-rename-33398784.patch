new file mode 100644
index 0000000000000000000000000000000000000000..0e5f3969af547e8b69ecf5593e87bee7f55c66f6
--- /dev/null
+++ b/ios/FieldLog/SiteMapLocation.swift
@@ -0,0 +1,162 @@
+import Combine
+import FieldLogModels
+import Foundation
+
+@MainActor
+protocol SiteLocationDriver: AnyObject {
+  var authorization: SiteMapLocation.Authorization { get }
+  var onEvent: ((SiteMapLocation.Event) -> Void)? { get set }
+  func requestPermission()
+  func requestLocation()
+  func stop()
+}
+
+@MainActor
+final class SiteMapLocation: ObservableObject {
+  enum Authorization: Equatable {
+    case undetermined, allowed, denied, restricted
+  }
+
+  enum Event {
+    case authorizationChanged
+    case result(SiteMapFix?)
+  }
+
+  enum Status: Equatable {
+    case idle, askingPermission, locating, denied, restricted, unavailable
+    case located(SiteMapFix)
+
+    var fix: SiteMapFix? {
+      guard case let .located(fix) = self else { return nil }
+      return fix
+    }
+
+    var inProgress: Bool { self == .askingPermission || self == .locating }
+  }
+
+  enum Activity {
+    case active, inactive, background
+  }
+
+  @Published private(set) var status = Status.idle
+  private var activity = Activity.inactive
+  private var requestID: UUID?
+  private var driver: (any SiteLocationDriver)?
+  private var ownsRoute: (() -> Bool)?
+  private var isForeground: (() -> Bool)?
+
+  static func position(in scene: SiteMapScene, locale: Locale) -> String? {
+    guard let fix = scene.fix?.point else { return nil }
+    guard let pin = scene.site else {
+      return String(localized: "Current location is at the center of the map.")
+    }
+    let east = fix.x - pin.x
+    let north = pin.y - fix.y
+    let meters = hypot(east, north) * Double(scene.scale.meters) / scene.scale.fractionOfWidth
+    guard meters >= 1 else { return String(localized: "Current location is near the saved site pin.") }
+
+    let directions = [
+      String(localized: "north"), String(localized: "northeast"),
+      String(localized: "east"), String(localized: "southeast"),
+      String(localized: "south"), String(localized: "southwest"),
+      String(localized: "west"), String(localized: "northwest"),
+    ]
+    let sector = Int((atan2(east, north) / (.pi / 4)).rounded())
+    let direction = directions[(sector + directions.count) % directions.count]
+    let distance = Measurement(value: meters, unit: UnitLength.meters)
+      .formatted(.measurement(width: .wide, usage: .road).locale(locale))
+    return String(localized: "Current location is about \(distance) \(direction) of the saved site pin.")
+  }
+
+  func updateActivity(_ activity: Activity) {
+    self.activity = activity
+    switch activity {
+    case .active:
+      if status == .askingPermission { advance() }
+    case .inactive:
+      // The system permission alert can temporarily make the scene inactive.
+      if status != .askingPermission { retire() }
+    case .background:
+      retire()
+    }
+  }
+
+  func request(
+    ownsRoute: @escaping () -> Bool,
+    isForeground: @escaping () -> Bool,
+    makeDriver: () -> any SiteLocationDriver
+  ) {
+    guard !status.inProgress, activity == .active, ownsRoute(), isForeground() else { return }
+    let requestID = UUID()
+    let driver = makeDriver()
+    self.requestID = requestID
+    self.driver = driver
+    self.ownsRoute = ownsRoute
+    self.isForeground = isForeground
+    status = .askingPermission
+    driver.onEvent = { [weak self] event in self?.receive(event, requestID: requestID) }
+    if driver.authorization == .undetermined {
+      driver.requestPermission()
+    } else {
+      advance()
+    }
+  }
+
+  func retire() {
+    finish(with: .idle)
+  }
+
+  private func advance() {
+    guard let driver else { return }
+    guard ownsRoute?() == true else {
+      retire()
+      return
+    }
+    switch driver.authorization {
+    case .undetermined:
+      if status == .locating { finish(with: .unavailable) }
+    case .allowed:
+      guard status == .askingPermission, activity == .active, isForeground?() == true else { return }
+      status = .locating
+      driver.requestLocation()
+    case .denied:
+      finish(with: .denied)
+    case .restricted:
+      finish(with: .restricted)
+    }
+  }
+
+  private func receive(_ event: Event, requestID: UUID) {
+    guard self.requestID == requestID, let driver else { return }
+    guard ownsRoute?() == true else {
+      retire()
+      return
+    }
+    switch event {
+    case .authorizationChanged:
+      advance()
+    case .result(let fix):
+      guard status == .locating else { return }
+      guard activity == .active, isForeground?() == true else {
+        retire()
+        return
+      }
+      guard driver.authorization == .allowed else {
+        advance()
+        return
+      }
+      finish(with: fix.map(Status.located) ?? .unavailable)
+    }
+  }
+
+  private func finish(with status: Status) {
+    let previous = driver
+    requestID = nil
+    driver = nil
+    ownsRoute = nil
+    isForeground = nil
+    previous?.onEvent = nil
+    previous?.stop()
+    if self.status != status { self.status = status }
+  }
+}
