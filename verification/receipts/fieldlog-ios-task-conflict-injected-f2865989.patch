@@ -0,0 +1,104 @@
+import Foundation
+
+public enum TaskTextField: String, CaseIterable, Sendable {
+  case title
+  case responsible
+
+  public var label: String {
+    switch self {
+    case .title: "Title"
+    case .responsible: "Responsible person"
+    }
+  }
+
+  fileprivate var keyPath: WritableKeyPath<TaskText, String> {
+    switch self {
+    case .title: \.title
+    case .responsible: \.responsible
+    }
+  }
+}
+
+public struct TaskText: Codable, Equatable, Sendable {
+  public var title: String
+  public var responsible: String
+
+  init(_ task: WorkTask) {
+    title = task.title
+    responsible = task.responsible
+  }
+
+  func validate() throws {
+    try Workspace.text(title, label: "Task", maximum: 240, required: true)
+    try Workspace.text(responsible, label: "Responsible person", maximum: 160)
+  }
+}
+
+public struct TaskEdit: Codable, Equatable, Identifiable, Sendable {
+  public let id: UUID
+  public let workspaceID: UUID
+  public let taskID: UUID
+  public let projectID: UUID
+  let openedAtRevision: UInt64
+  public let base: TaskText
+  public var text: TaskText
+
+  public init(workspaceID: UUID, revision: UInt64, task: WorkTask) {
+    id = UUID()
+    self.workspaceID = workspaceID
+    taskID = task.id
+    projectID = task.projectID
+    openedAtRevision = revision
+    base = TaskText(task)
+    text = base
+  }
+
+  func conflicts(against task: WorkTask) -> [TaskFieldConflict] {
+    let current = TaskText(task)
+    return TaskTextField.allCases.compactMap { field in
+      let key = field.keyPath
+      let original = base[keyPath: key]
+      let local = text[keyPath: key]
+      let incoming = current[keyPath: key]
+      guard local != original, incoming != original, local != incoming else { return nil }
+      return TaskFieldConflict(field: field, local: local, incoming: incoming)
+    }
+  }
+
+  func merged(against task: WorkTask, choosing choices: [TaskTextField: TaskConflictChoice])
+    -> TaskText
+  {
+    var result = TaskText(task)
+    for field in TaskTextField.allCases {
+      let key = field.keyPath
