@@ -0,0 +1,145 @@
+import FieldLogModels
+import FieldLogStorage
+import Foundation
+
+private struct Assertion: Error {
+  let message: String
+}
+
+private func expect(_ condition: Bool, _ message: String) throws {
+  guard condition else { throw Assertion(message: message) }
+}
+
+private struct Receipt: Encodable {
+  let eventID: UUID
+  let head: TaskSyncHead
+}
+
+private actor Responses {
+  typealias Reply = @Sendable (TaskSyncUpload?) throws -> (Int, Data)
+
+  private var replies: [Reply]
+  private var requests: [TaskSyncUpload?] = []
+
+  init(_ replies: [Reply]) { self.replies = replies }
+
+  func respond(_ body: Data?) throws -> (Int, Data) {
+    guard !replies.isEmpty else { throw Assertion(message: "Unexpected transaction") }
+    let upload = try body.map { try JSONDecoder().decode(TaskSyncUpload.self, from: $0) }
+    requests.append(upload)
+    return try replies.removeFirst()(upload)
+  }
+
+  func observed() -> [TaskSyncUpload?] { requests }
+}
+
+@main
+private struct TaskSyncTransportTest {
+  static func main() async throws {
+    let directory = URL(filePath: CommandLine.arguments[1], directoryHint: .isDirectory)
+    let repository = try WorkspaceRepository(directory: directory)
+    let seed = try await repository.transact { workspace in
+      let project = try workspace.createProject(title: "Inspection", site: "Yard")
+      try workspace.saveTask(projectID: project, title: "Initial", responsible: "A")
+    }
+    guard let task = seed.tasks.first else { throw Assertion(message: "Missing seed task") }
+    let scope = TaskSyncScope(workspaceID: seed.id, projectID: task.projectID, taskID: task.id)
+    let edit = TaskEdit(workspaceID: seed.id, revision: seed.revision, task: task)
+    let first = TaskSyncHead(scope: scope, version: 1, text: edit.text)
+    let wrongScope = TaskSyncScope(workspaceID: UUID(), projectID: task.projectID, taskID: task.id)
+    let wrong = TaskSyncHead(scope: wrongScope, version: 1, text: edit.text)
+    let firstBody = try JSONEncoder().encode(first)
+    let padded = firstBody + Data(repeating: 32, count: 8192 - firstBody.count)
+    let script = Responses([
+      { _ in (307, Data()) },
+      { _ in (200, try JSONEncoder().encode(wrong)) },
+      { _ in (200, padded + Data([32])) },
+      { _ in (200, padded) },
+      { _ in (409, Data()) },
+      { upload in try receipt(upload, eventID: UUID()) },
+      { upload in
+        let reply = try receipt(upload)
+        withUnsafeCurrentTask { $0?.cancel() }
+        return reply
+      },
+      { upload in try receipt(upload) },
+      { _ in (409, Data(#"{"error":"stale_task_version"}"#.utf8)) },
+      { _ in
+        var remote = first.text
+        remote.title = "Updated locally"
+        remote.responsible = "B"
+        let head = TaskSyncHead(scope: scope, version: 3, text: remote)
+        return (200, try JSONEncoder().encode(head))
+      }
+    ])
+    let token = String(repeating: "a", count: 32)
+    let path = "/v1/workspaces/\(seed.id.uuidString.lowercased())/projects/\(task.projectID.uuidString.lowercased())/tasks/\(task.id.uuidString.lowercased())"
+    let client = try TaskSyncClient(
+      port: 4321, workspaceID: seed.id, projectID: task.projectID, token: token
+    ) { port, actualPath, bearer, upload in
+      try expect(port == 4321 && actualPath == path && bearer == token, "Injected scope")
+      return try await script.respond(upload)
+    }
+
+    func sync() async throws -> Workspace {
+      try await client.synchronize(taskID: task.id, in: repository)
+    }
+
+    func expectFailure(_ expected: TaskSyncClient.Failure) async throws {
+      do {
+        _ = try await sync()
+        throw Assertion(message: "Expected typed failure")
+      } catch let failure as TaskSyncClient.Failure {
+        try expect(failure == expected, "Unexpected typed failure")
+      }
+    }
+
+    try await expectFailure(.rejected(307))
+    try await expectFailure(.invalidReceipt)
+    try await expectFailure(.invalidReceipt)
+    try expect(try await repository.readCommittedSnapshot() == seed, "Invalid fetch published state")
+    let linked = try await sync()
+    try expect(linked.revision == seed.revision + 1, "8192-byte response failed to link")
+    _ = try await repository.transact { workspace in
+      var local = TaskEdit(workspaceID: seed.id, revision: linked.revision, task: task)
+      local.text.title = "Updated locally"
+      try workspace.saveTaskEdit(local)
+    }
+
+    try await expectFailure(.rejected(409))
+    let flight = try await repository.readCommittedSnapshot()
+    let pending = try flight.taskSyncUpload(scope)
+    try expect(pending != nil, "Missing durable retry proposal")
+    try await expectFailure(.invalidReceipt)
+    try expect(try await repository.readCommittedSnapshot() == flight, "Invalid acknowledgement published state")
+    do {
+      _ = try await Task { try await sync() }.value
+      throw Assertion(message: "Expected cancellation after transport returned")
+    } catch is CancellationError {}
+    try expect(try await repository.readCommittedSnapshot() == flight, "Cancelled acknowledgement published state")
+    let settled = try await sync()
+    try expect(try settled.taskSyncUpload(scope) == nil, "Valid acknowledgement did not clear flight")
+
+    _ = try await repository.transact { workspace in
+      guard let saved = workspace.tasks.first else { throw Assertion(message: "Missing saved task") }
+      var local = TaskEdit(workspaceID: seed.id, revision: settled.revision, task: saved)
+      local.text.title = "Updated again"
+      try workspace.saveTaskEdit(local)
+    }
+    let merged = try await sync()
+    try expect(merged.tasks.first?.title == "Updated again" && merged.tasks.first?.responsible == "B",
+               "Stale proposal did not merge remote text")
+    let requests = await script.observed()
+    try expect(requests.count == 10 && requests.prefix(4).allSatisfy { $0 == nil } &&
+               requests[4..<8].allSatisfy { $0 == pending } && requests[8] != nil && requests[9] == nil,
+               "Wrong GET/POST sequence or retry proposal")
+    await repository.close()
+    print("PASS injected scope, typed rejections, 8192/8193 bytes, cancellation, exact retry, GET after stale POST, merge")
+  }
+
+  static func receipt(_ upload: TaskSyncUpload?, eventID: UUID? = nil) throws -> (Int, Data) {
+    guard let upload else { throw Assertion(message: "Missing POST upload") }
+    let head = TaskSyncHead(scope: upload.base.scope, version: upload.base.version + 1, text: upload.text)
+    return (201, try JSONEncoder().encode(Receipt(eventID: eventID ?? upload.eventID, head: head)))
+  }
+}
diff --git a/verification/host/replay-paired-task-conflict.py b/verification/host/replay-paired-task-conflict.py
new file mode 100644
index 0000000000000000000000000000000000000000..d804d1e9e190fae46c5641866a86ebd5de00c0cd
--- /dev/null
+++ b/verification/host/replay-paired-task-conflict.py
@@ -0,0 +1,146 @@
+"""Run the compiled ordinary FieldLog editor replay with a disposable SQLite backend."""
+import contextlib
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import secrets
+import socket
+import sqlite3
+import subprocess
+import sys
+import threading
+
+source = Path(__file__).resolve().parents[2]
+spec = importlib.util.spec_from_file_location("fieldlog", source / "Backend/local_entry_sync.py")
+backend = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(backend)
+
+exe, root = (Path(value).resolve() for value in sys.argv[1:])
+root.mkdir(mode=0o700)
+db = root / "task.sqlite3"
+trace = []
+uploads = []
+children = []
+ports = []
+lost = False
+
+def check(condition, message):
+    if not condition:
+        raise RuntimeError(message)
+
+class Trace(backend.EntrySyncHandler):
+    def _send_json(self, status, body):
+        trace.append([self.command, int(status)])
+        super()._send_json(status, body)
+
+    def send_receipt(self, status, receipt):
+        global lost
+        if not lost and int(status) == 201 and receipt["head"]["version"] == 3:
+            lost = True
+            trace.append([self.command, int(status)])
+            data = json.dumps(receipt).encode()
+            self.send_response(status)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(data)))
+            self.end_headers()
+            self.wfile.write(data[:12])
+            self.close_connection = True
+        else:
+            super().send_receipt(status, receipt)
+
+    def _read_body(self, maximum=backend.MAX_REQUEST_BYTES):
+        payload = super()._read_body(maximum)
+        if self.command == "POST":
+            uploads.append(json.loads(payload))
+        return payload
+
+def phase(name, port=None, token=None):
+    env = {key: value for key, value in os.environ.items() if not key.startswith("FIELDLOG_TASK_SYNC_")}
+    if port is not None:
+        env.update(
+            FIELDLOG_TASK_SYNC_PORT=str(port), FIELDLOG_TASK_SYNC_TOKEN=token,
+            **{"FIELDLOG_TASK_SYNC_" + key.upper(): value for key, value in ids.items() if key != "photo"},
+        )
+    with subprocess.Popen([exe, name, root], env=env, start_new_session=True) as child:
+        try:
+            status = child.wait(timeout=12)
+        except subprocess.TimeoutExpired:
+            os.killpg(child.pid, 15)
+            status = child.wait(timeout=3)
+        try:
+            os.killpg(child.pid, 0)
+        except ProcessLookupError:
+            children.append({"phase": name, "pid": child.pid, "exit": status, "groupAbsent": True})
+            print(json.dumps(children[-1]), flush=True)
+        else:
+            raise RuntimeError(f"Process group disposition unverified: {child.pid}")
+        check(status == 0, f"{name} exited {status}")
+
+@contextlib.contextmanager
+def listener():
+    with backend.make_server(db, accounts, handler_class=Trace) as server:
+        thread = threading.Thread(target=server.serve_forever, kwargs={"poll_interval": 0.05})
+        thread.start()
+        try:
+            yield server.server_port
+        finally:
+            server.shutdown()
+            thread.join(timeout=3)
+            check(not thread.is_alive(), "Listener still running")
+    with socket.socket() as reuse:
+        reuse.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+        reuse.bind(("127.0.0.1", server.server_port))
+    ports.append(server.server_port)
+    print(json.dumps({"closedAndRebound": server.server_port}), flush=True)
+
+def readback():
+    with contextlib.closing(sqlite3.connect(db)) as sql:
+        head = sql.execute("SELECT task_id, version, text_json FROM task_heads").fetchone()
+        events = sql.execute(
+            """SELECT event_id, proposal_json, receipt_json FROM task_events
+               ORDER BY json_extract(receipt_json, '$.head.version')"""
+        ).fetchall()
+        check(sql.execute("PRAGMA foreign_key_check").fetchall() == [], "foreign keys")
+        check(sql.execute("SELECT COUNT(*) FROM entry_events").fetchone() == (0,), "unrelated transport")
+        return head, events
+
+phase("seed")
+ids = {key: value.lower() for key, value in json.loads((root / "fixture.json").read_text()).items()}
+account = "synthetic-fieldlog"
+local, peer, denied = (secrets.token_urlsafe(32) for _ in range(3))
+accounts = {token: (account, {(ids["workspace"], ids["project"])}) for token in (local, peer)}
+with listener() as port:
+    backend.provision_task(db, account, ids["workspace"], ids["project"], ids["task"],
+                           {"title": "Inspect valve", "responsible": "Crew"})
+    phase("local-denied", port, denied)
+    phase("local-link", port, local)
+    phase("peer-link", port, peer)
+trace_before = list(trace)
+phase("local-edit")
+phase("peer-edit")
+check(trace == trace_before and readback()[1] == [], "offline edits contacted backend")
+with listener() as port:
+    phase("peer-send", port, peer)
+    phase("conflict", port, local)
+    phase("resolve")
+    phase("lose", port, local)
+    before_retry = readback()
+    phase("retry", port, local)
+    check(readback() == before_retry, "retry created another SQLite event")
+phase("readback")
+head, events = readback()
+expected = {"title": "Inspect valve today", "responsible": "Morgan"}
+check(head[:2] == (ids["task"], 3) and json.loads(head[2]) == expected and len(events) == 2, "SQLite head")
+check(trace == [["GET", 401], ["GET", 200], ["GET", 200], ["POST", 201],
+                ["POST", 409], ["GET", 200], ["POST", 201], ["POST", 200]], trace)
+flight = json.loads((root / "flight.json").read_bytes())
+check(lost and uploads[-2] == uploads[-1] == flight, "exact retry proposal")
+check(events[-1][0] == flight["eventID"].lower(), "SQLite retry identity")
+print(json.dumps({"http": trace, "headVersion": 3, "committedEvents": len(events),
+    "task": ids["task"], "combinedText": expected, "retryEvent": events[-1][0],
+    "proposalSHA256": hashlib.sha256(json.dumps(flight, sort_keys=True).encode()).hexdigest(),
+    "baselineOutboxRows": len(json.loads((root / "baseline.json").read_text())["outbox"]),
+    "jpegSHA256": hashlib.sha256((root / "baseline.jpg").read_bytes()).hexdigest(),
+    "children": children, "reboundPorts": ports}, sort_keys=True))
