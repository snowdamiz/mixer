diff --git a/verification/host/PairedTaskConflict.swift b/verification/host/PairedTaskConflict.swift
new file mode 100644
index 0000000000000000000000000000000000000000..150b1c8c11417c41540cea02512dccbf8c85c26a
--- /dev/null
+++ b/verification/host/PairedTaskConflict.swift
@@ -0,0 +1,144 @@
+import CoreGraphics
+import FieldLogModels
+import FieldLogStorage
+import Foundation
+import ImageIO
+import UniformTypeIdentifiers
+
+private struct Failed: Error {
+  let message: String
+  init(_ message: String) { self.message = message }
+}
+
+private func require<T>(_ value: T?, _ description: String) throws -> T {
+  guard let value else { throw Failed(description) }
+  return value
+}
+
+private func check(_ condition: Bool, _ description: String) throws {
+  guard condition else { throw Failed(description) }
+}
+
+private struct Fixture: Codable {
+  let workspace: UUID
+  let project: UUID
+  let task: UUID
+  let photo: UUID
+}
+
+@main @MainActor
+struct PairedTaskConflict {
+  static func main() async throws {
+    let args = CommandLine.arguments
+    let root = URL(filePath: args[2], directoryHint: .isDirectory)
+    let local = root.appending(path: "local")
+    let peer = root.appending(path: "peer")
+    let phase = args[1]
+    let repository = try WorkspaceRepository(directory: phase.hasPrefix("peer-") ? peer : local)
+    let model = WorkspaceModel(repository: repository)
+    await model.open()
+    let fixtureFile = root.appending(path: "fixture.json")
+
+    if phase == "seed" {
+      let project = try require(await model.createProject(title: "Inspection", site: "North yard"), "project")
+      try check(await model.addTask(projectID: project, title: "Inspect valve", responsible: "Crew"), "task")
+      model.restoreProject(project)
+      await model.flush()
+      model.showSiteMap(for: project)
+      let map = try require(model.sitePinEdit(projectID: project), "map selection")
+      let coordinate = try require(SiteCoordinate(latitude: 40, longitude: -73), "coordinate")
+      try check(await model.saveSitePin(map, to: coordinate), "site pin")
+      var draft = try require(await model.newDraft(projectID: project), "draft")
+      draft.title = "Leave this draft open"
+      try check(await model.keepDraft(draft), "settled draft")
+      model.selectDraftEditor(draft)
+      let selection = try require(model.draftEditor, "draft photo owner")
+      let jpeg = try makeJPEG()
+      let ids = try await model.addPhoto(jpeg, to: selection)
+      let photo = try require(ids.first, "photo")
+      let baseline = try await repository.readCommittedSnapshot()
+      let task = try require(baseline.tasks.first, "seed task")
+      try check(baseline.schema == 1 && baseline.projects.first?.siteCoordinate == coordinate, "old schema and site pin")
+      let workspace = local.appending(path: "workspace.json")
+      try FileManager.default.createDirectory(at: peer, withIntermediateDirectories: true)
+      try FileManager.default.copyItem(at: workspace, to: peer.appending(path: "workspace.json"))
+      try Data(contentsOf: workspace).write(to: root.appending(path: "baseline.json"))
+      try jpeg.write(to: root.appending(path: "baseline.jpg"))
+      try JSONEncoder().encode(Fixture(workspace: baseline.id, project: project, task: task.id,
+                                       photo: photo)).write(to: fixtureFile)
+      await repository.close()
+      return
+    }
+
+    let fixture = try JSONDecoder().decode(Fixture.self, from: Data(contentsOf: fixtureFile))
+    switch phase {
+    case "local-link", "peer-link", "peer-send", "retry":
+      try check(await model.syncSavedTask(fixture.task), model.saveError ?? phase)
+    case "local-denied":
+      let before = try await repository.readCommittedSnapshot()
+      try check(!(await model.syncSavedTask(fixture.task)), "unauthenticated link")
+      try check(model.saveError?.contains("401") == true, "401")
+      try check(try await repository.readCommittedSnapshot() == before, "unauthenticated state changed")
+    case "local-edit", "peer-edit":
+      try check(!model.canSyncSavedTask(fixture.task), "expected offline environment")
+      let edit = try require(model.savedTaskEdit(fixture.task, in: fixture.project), "ordinary edit")
+      let owner = SavedTaskEditorOwner(edit: edit)
+      owner.edit.text.title = phase == "local-edit" ? "Inspect valve today" : "Inspect valve after shutdown"
+      if phase == "peer-edit" { owner.edit.text.responsible = "Morgan" }
+      try check(await owner.submit(to: model, review: nil, choices: [:]), owner.error ?? "settled editor")
+      let saved = try await repository.readCommittedSnapshot()
+      try check(saved.tasks.first?.title == owner.edit.text.title && model.pendingSaves == 0, "offline settlement")
+    case "conflict":
+      try check(await model.syncSavedTask(fixture.task), model.saveError ?? phase)
+      let review = try require(model.workspace?.taskConflict(for: fixture.task), "409 review")
+      try check(review.conflicts.map(\.field) == [.title], "only overlapping title requires a choice")
+      try check(review.conflicts.first?.local == "Inspect valve today" &&
+                review.conflicts.first?.incoming == "Inspect valve after shutdown", "conflict values")
+    case "resolve":
+      let edit = try require(model.savedTaskEdit(fixture.task, in: fixture.project), "reopen task editor")
+      let owner = SavedTaskEditorOwner(edit: edit)
+      let review = try require(model.workspace?.taskConflict(for: fixture.task), "cold conflict review")
+      try check(await owner.submit(to: model, review: review, choices: [.title: .local]), owner.error ?? phase)
+      let saved = try await repository.readCommittedSnapshot()
+      try check(await model.resolveTaskConflict(review, choosing: [.title: .local]), "duplicate choice")
+      try check(try await repository.readCommittedSnapshot() == saved, "duplicate choice rewrote workspace")
+    case "lose":
+      try check(!(await model.syncSavedTask(fixture.task)), "truncated receipt must fail")
+      let state = try await repository.readCommittedSnapshot()
+      let scope = TaskSyncScope(workspaceID: fixture.workspace, projectID: fixture.project, taskID: fixture.task)
+      let upload = try require(try state.taskSyncUpload(scope), "durable retry identity")
+      try check(state == model.workspace, "model didn't publish durable flight")
+      try JSONEncoder().encode(upload).write(to: root.appending(path: "flight.json"))
+    case "readback":
+      let state = try await repository.readCommittedSnapshot()
+      let baseline = try JSONDecoder().decode(Workspace.self, from: Data(contentsOf: root.appending(path: "baseline.json")))
+      let task = try require(state.tasks.first, "cold task")
+      try check(task.title == "Inspect valve today" && task.responsible == "Morgan", "combined text")
+      try check(state.taskConflict(for: fixture.task) == nil && state.outbox == baseline.outbox, "review and original queue")
+      try check(state.projects == baseline.projects && state.drafts == baseline.drafts &&
+                state.restoration == baseline.restoration && state.attachments == baseline.attachments &&
+                state.entries == baseline.entries, "draft/photo/map/entry state")
+      let photo = try await repository.photoURL(fixture.photo)
+      try check(try Data(contentsOf: photo) == Data(contentsOf: root.appending(path: "baseline.jpg")), "photo bytes")
+      let report = try await model.exportReport(projectID: fixture.project)
+      try check(FileManager.default.fileExists(atPath: report.path), "report export")
+      print("PASS cold task, original queue, draft, exact JPEG, site pin and report")
+    default: throw Failed("Unexpected phase")
+    }
+    await repository.close()
+  }
+
+  private static func makeJPEG() throws -> Data {
+    let context = try require(CGContext(data: nil, width: 4, height: 4, bitsPerComponent: 8,
+      bytesPerRow: 0, space: CGColorSpaceCreateDeviceRGB(),
+      bitmapInfo: CGImageAlphaInfo.noneSkipLast.rawValue), "raster")
+    context.setFillColor(red: 0.1, green: 0.2, blue: 0.4, alpha: 1)
+    context.fill(CGRect(x: 0, y: 0, width: 4, height: 4))
+    let image = try require(context.makeImage(), "image")
+    let data = NSMutableData()
+    let output = try require(CGImageDestinationCreateWithData(data, UTType.jpeg.identifier as CFString, 1, nil), "JPEG")
+    CGImageDestinationAddImage(output, image, nil)
+    try check(CGImageDestinationFinalize(output), "encode photo")
+    return data as Data
+  }
+}
