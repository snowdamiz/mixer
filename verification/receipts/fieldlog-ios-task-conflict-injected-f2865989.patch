+swiftmod MixerCapabilityActivation -lMixerRuntimeIdentity -lMixerUpdates -lMixerExperimentalCapabilityRuntime -lMixerGuest -lMixerCapabilities -lMixerUI -lMixerApple "$b/MixerCapabilityDurableIO.o" "$sdk/capability-activation/Sources/MixerCapabilityActivation/"*.swift
+swiftmod FieldLogModels "$app/Sources/FieldLogModels/"*.swift
+swiftmod FieldLogStorage -lFieldLogModels "$app/Sources/FieldLogStorage/"*.swift
