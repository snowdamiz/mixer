index 0000000000000000000000000000000000000000..d6119af3714fa16e15f1cd4ed5c3f403daff4613
--- /dev/null
+++ b/Backend/local_entry_sync.py
@@ -0,0 +1,490 @@
+"""Private FieldLog entry sync for a provisioned localhost test account.
+
+Launch with ``with make_server(database, accounts) as server:`` and call
+``server.serve_forever()``. The origin is ``http://127.0.0.1:{server.server_port}``.
+Account IDs and bearer tokens are strings. Scope UUIDs in ``accounts`` are lowercase.
+
+SQLite readback joins these tables on (account_id, workspace_id, project_id, event_id):
+    entry_events(account_id, workspace_id, project_id, event_id, entry_id,
+                 event_json, entry_json)
+    entry_photos(account_id, workspace_id, project_id, event_id, photo_id, jpeg)
+All dedicated ID columns use lowercase UUIDs, except account_id (as provisioned).
+The JSON columns contain the Swift objects with uppercase UUIDs and numeric Dates.
+The jpeg column contains the decoded BLOB. There is one photo per accepted event.
+"""
+
+from __future__ import annotations
+
+import base64
+from collections.abc import Mapping
+from contextlib import closing
+import hashlib
+from http import HTTPStatus
+from http.server import BaseHTTPRequestHandler, HTTPServer
+import json
+import math
+from pathlib import Path
+import re
+import sqlite3
+
+
+MAX_REQUEST_BYTES = 9 * 1024 * 1024
+MAX_JPEG_BYTES = 6 * 1024 * 1024
+UUID_PATTERN = r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
+ROUTE = re.compile(
+    rf"/v1/workspaces/({UUID_PATTERN})/projects/({UUID_PATTERN})/entries/({UUID_PATTERN})"
+)
+TASK_ROUTE = re.compile(
+    rf"/v1/workspaces/({UUID_PATTERN})/projects/({UUID_PATTERN})/tasks/({UUID_PATTERN})"
+)
+UUID_TEXT = re.compile(UUID_PATTERN)
+MAX_TASK_REQUEST_BYTES = 8192
+MAX_TASK_VERSION = 2**63 - 1
+TOKEN_PATTERN = r"[A-Za-z0-9._~+/-]+=*"
+BEARER = re.compile(rf"Bearer +({TOKEN_PATTERN})", re.IGNORECASE | re.ASCII)
+TOKEN = re.compile(TOKEN_PATTERN)
+# Match Foundation CharacterSet.whitespacesAndNewlines used by FieldLog titles.
+TITLE_WHITESPACE = (
+    "\u0009\u000a\u000b\u000c\u000d\u0020\u0085\u00a0\u1680"
+    + "".join(chr(code) for code in range(0x2000, 0x200C))
+    + "\u2028\u2029\u202f\u205f\u3000"
+)
+
+Scope = tuple[str, str]
+Accounts = Mapping[str, tuple[str, set[Scope]]]
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS entry_events (
+    account_id TEXT NOT NULL,
+    workspace_id TEXT NOT NULL,
+    project_id TEXT NOT NULL,
+    event_id TEXT NOT NULL,
+    entry_id TEXT NOT NULL,
+    event_json TEXT NOT NULL,
+    entry_json TEXT NOT NULL,
+    PRIMARY KEY (account_id, workspace_id, project_id, event_id)
+) WITHOUT ROWID;
+CREATE TABLE IF NOT EXISTS entry_photos (
+    account_id TEXT NOT NULL,
+    workspace_id TEXT NOT NULL,
+    project_id TEXT NOT NULL,
+    event_id TEXT NOT NULL,
+    photo_id TEXT NOT NULL,
+    jpeg BLOB NOT NULL,
+    PRIMARY KEY (account_id, workspace_id, project_id, event_id),
+    FOREIGN KEY (account_id, workspace_id, project_id, event_id)
+        REFERENCES entry_events (account_id, workspace_id, project_id, event_id)
+) WITHOUT ROWID;
+CREATE TABLE IF NOT EXISTS task_heads (
+    account_id TEXT NOT NULL,
+    workspace_id TEXT NOT NULL,
+    project_id TEXT NOT NULL,
+    task_id TEXT NOT NULL,
+    version INTEGER NOT NULL CHECK (version > 0),
+    text_json TEXT NOT NULL,
+    PRIMARY KEY (account_id, workspace_id, project_id, task_id)
+) WITHOUT ROWID;
+CREATE TABLE IF NOT EXISTS task_events (
+    account_id TEXT NOT NULL,
+    workspace_id TEXT NOT NULL,
+    project_id TEXT NOT NULL,
+    task_id TEXT NOT NULL,
+    event_id TEXT NOT NULL,
+    proposal_json TEXT NOT NULL,
+    receipt_json TEXT NOT NULL,
+    PRIMARY KEY (account_id, workspace_id, project_id, task_id, event_id),
+    FOREIGN KEY (account_id, workspace_id, project_id, task_id)
+        REFERENCES task_heads (account_id, workspace_id, project_id, task_id)
+) WITHOUT ROWID;
+"""
+
+
+class RequestError(Exception):
+    def __init__(self, status: HTTPStatus, code: str):
+        super().__init__(code)
+        self.status = status
+
+
+def _object_pairs(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("duplicate JSON key")
+        result[key] = value
+    return result
+
+
+def _object(value, *keys):
+    if not isinstance(value, dict) or value.keys() != set(keys):
+        raise ValueError("unexpected JSON object fields")
+    return value
+
+
+def _body_uuid(value) -> str:
+    if not isinstance(value, str) or value != value.upper():
+        raise ValueError("invalid Swift UUID")
+    lowercase = value.lower()
+    if not UUID_TEXT.fullmatch(lowercase):
+        raise ValueError("invalid Swift UUID")
+    return lowercase
+
+
+def _date(value) -> float:
+    if type(value) not in (int, float) or not math.isfinite(value):
+        raise ValueError("invalid Swift Date")
+    return float(value)
+
+
+def _validate_text(value, maximum: int, *, required: bool = False):
+    if not isinstance(value, str) or len(value.encode("utf-8")) > maximum or "\0" in value:
+        raise ValueError("invalid entry text")
+    if required and not value.strip(TITLE_WHITESPACE):
+        raise ValueError("missing entry title")
+
+
+def _validate_payload(raw: bytes, workspace_id: str, project_id: str, event_id: str):
+    payload = json.loads(raw.decode("utf-8"), object_pairs_hook=_object_pairs)
+    _object(payload, "event", "entry", "photo")
+    event = _object(payload["event"], "id", "kind", "recordID", "revision", "createdAt")
+    entry = _object(
+        payload["entry"], "id", "projectID", "title", "note", "category", "occurredAt",
+        "attachmentIDs", "savedAt",
+    )
+    photo = _object(payload["photo"], "id", "jpeg")
+    entry_id = _body_uuid(entry["id"])
+    photo_id = _body_uuid(photo["id"])
+    attachments = entry["attachmentIDs"]
+    if (
+        _body_uuid(event["id"]) != event_id
+        or _body_uuid(event["recordID"]) != entry_id
+        or _body_uuid(entry["projectID"]) != project_id
+        or not isinstance(attachments, list)
+        or len(attachments) != 1
+        or _body_uuid(attachments[0]) != photo_id
+    ):
+        raise ValueError("entry, event, route or photo UUID mismatch")
+    if event["kind"] != "entrySaved":
+        raise ValueError("unsupported event kind")
+    revision = event["revision"]
+    if type(revision) is not int or not 1 <= revision <= 2**64 - 1:
+        raise ValueError("invalid workspace revision")
+    if entry["category"] not in ("observation", "progress", "issue", "delivery"):
+        raise ValueError("invalid entry category")
+    _validate_text(entry["title"], 160, required=True)
+    _validate_text(entry["note"], 100_000)
+    event["createdAt"] = _date(event["createdAt"])
+    entry["occurredAt"] = _date(entry["occurredAt"])
+    entry["savedAt"] = _date(entry["savedAt"])
+
+    encoded = photo["jpeg"]
+    if not isinstance(encoded, str):
+        raise ValueError("invalid photo data")
+    if len(encoded) > 4 * ((MAX_JPEG_BYTES + 2) // 3):
+        raise RequestError(HTTPStatus.REQUEST_ENTITY_TOO_LARGE, "photo_too_large")
+    jpeg = base64.b64decode(encoded, validate=True)
+    if len(jpeg) > MAX_JPEG_BYTES:
+        raise RequestError(HTTPStatus.REQUEST_ENTITY_TOO_LARGE, "photo_too_large")
+    if not jpeg.startswith(b"\xff\xd8\xff"):
+        raise ValueError("invalid JPEG prefix")
+
+    receipt = {
+        "eventID": event_id,
+        "workspaceID": workspace_id,
+        "projectID": project_id,
+        "entryID": entry_id,
+        "photoID": photo_id,
+    }
+    return receipt, event, entry, jpeg
+
+
+def _json_bytes(value) -> bytes:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
+
+
+def _connect(database: Path) -> sqlite3.Connection:
+    connection = sqlite3.connect(database, timeout=5)
+    try:
+        connection.execute("PRAGMA foreign_keys = ON")
+        connection.execute("PRAGMA synchronous = FULL")
+        connection.execute("PRAGMA fullfsync = ON")
+    except sqlite3.Error:
+        connection.close()
+        raise
+    return connection
+
+
+def _commit_event(database: Path, account_id: str, receipt, event, entry, jpeg) -> HTTPStatus:
+    key = (account_id, receipt["workspaceID"], receipt["projectID"], receipt["eventID"])
+    event_row = (receipt["entryID"], _json_bytes(event).decode(), _json_bytes(entry).decode())
+    photo_row = (receipt["photoID"], jpeg)
+    with closing(_connect(database)) as connection, connection:
+        connection.execute("BEGIN IMMEDIATE")
+        existing = connection.execute(
+            """SELECT entry_id, event_json, entry_json, photo_id, jpeg
+               FROM entry_events JOIN entry_photos
+               USING (account_id, workspace_id, project_id, event_id)
+               WHERE account_id = ? AND workspace_id = ? AND project_id = ? AND event_id = ?""",
+            key,
+        ).fetchone()
+        if existing is not None:
+            if existing != event_row + photo_row:
+                raise RequestError(HTTPStatus.CONFLICT, "event_payload_conflict")
+            return HTTPStatus.OK
+
+        connection.execute(
+            """INSERT INTO entry_events
+               (account_id, workspace_id, project_id, event_id, entry_id, event_json, entry_json)
+               VALUES (?, ?, ?, ?, ?, ?, ?)""",
+            key + event_row,
+        )
+        connection.execute(
+            """INSERT INTO entry_photos (account_id, workspace_id, project_id, event_id, photo_id, jpeg)
+               VALUES (?, ?, ?, ?, ?, ?)""",
+            key + photo_row,
+        )
+    return HTTPStatus.CREATED
+
+
+def _task_text(text):
+    _object(text, "title", "responsible")
+    _validate_text(text["title"], 240, required=True)
+    _validate_text(text["responsible"], 160)
+    return text
+
+
+def _task_scope(key):
+    return dict(zip(("workspaceID", "projectID", "taskID"), key[1:], strict=True))
+
+
+def _task_head(connection, key):
+    row = connection.execute(
+        """SELECT version, text_json FROM task_heads
+           WHERE account_id = ? AND workspace_id = ? AND project_id = ? AND task_id = ?""",
+        key,
+    ).fetchone()
+    if row is None:
+        raise RequestError(HTTPStatus.NOT_FOUND, "task_not_found")
+    version, text_json = row
+    return {"scope": _task_scope(key), "version": version, "text": json.loads(text_json)}
+
+
+def provision_task(database, account_id, workspace_id, project_id, task_id, text):
+    """Provision a saved common ancestor for a dedicated local fixture."""
+    key = (account_id, workspace_id, project_id, task_id)
+    if not account_id or not all(UUID_TEXT.fullmatch(value) for value in key[1:]):
+        raise ValueError("invalid task provisioning scope")
+    text_json = _json_bytes(_task_text(text)).decode()
+    with closing(_connect(database)) as connection, connection:
+        connection.execute(
+            """INSERT INTO task_heads
+               (account_id, workspace_id, project_id, task_id, version, text_json)
+               VALUES (?, ?, ?, ?, 1, ?)""",
+            key + (text_json,),
+        )
+
+
+def _task_proposal(raw, key):
+    proposal = _object(
+        json.loads(raw.decode("utf-8"), object_pairs_hook=_object_pairs), "eventID", "base", "text"
+    )
+    event_id = _body_uuid(proposal["eventID"])
+    base = _object(proposal["base"], "scope", "version", "text")
+    scope = _object(base["scope"], "workspaceID", "projectID", "taskID")
+    base["scope"] = {name: _body_uuid(value) for name, value in scope.items()}
+    if base["scope"] != _task_scope(key):
+        raise ValueError("task payload scope differs from route")
+    if type(base["version"]) is not int or not 1 <= base["version"] <= MAX_TASK_VERSION:
+        raise ValueError("invalid task version")
+    _task_text(base["text"])
+    _task_text(proposal["text"])
+    return event_id, proposal
+
+
+def _commit_task(database, key, event_id, proposal):
+    event_key = key + (event_id,)
+    proposal_json = _json_bytes(proposal).decode()
+    with closing(_connect(database)) as connection, connection:
+        connection.execute("BEGIN IMMEDIATE")
+        existing = connection.execute(
+            """SELECT proposal_json, receipt_json FROM task_events
+               WHERE account_id = ? AND workspace_id = ? AND project_id = ? AND task_id = ?
+                 AND event_id = ?""",
+            event_key,
+        ).fetchone()
+        if existing is not None:
+            if existing[0] != proposal_json:
+                raise RequestError(HTTPStatus.CONFLICT, "event_payload_conflict")
+            return HTTPStatus.OK, json.loads(existing[1])
+
+        current = _task_head(connection, key)
+        if current != proposal["base"]:
+            raise RequestError(HTTPStatus.CONFLICT, "stale_task_version")
+        if current["version"] == MAX_TASK_VERSION:
+            raise RequestError(HTTPStatus.CONFLICT, "task_version_limit")
+        head = dict(current, version=current["version"] + 1, text=proposal["text"])
+        receipt = {"eventID": event_id, "head": head}
+        connection.execute(
+            """UPDATE task_heads SET version = ?, text_json = ?
+               WHERE account_id = ? AND workspace_id = ? AND project_id = ? AND task_id = ?""",
+            (head["version"], _json_bytes(head["text"]).decode()) + key,
+        )
+        connection.execute(
+            """INSERT INTO task_events
+               (account_id, workspace_id, project_id, task_id, event_id, proposal_json, receipt_json)
+               VALUES (?, ?, ?, ?, ?, ?, ?)""",
+            event_key + (proposal_json, _json_bytes(receipt).decode()),
+        )
+    return HTTPStatus.CREATED, receipt
+
+
+class EntrySyncHandler(BaseHTTPRequestHandler):
+    timeout = 10
+    server: _EntrySyncServer
+
+    def log_message(self, format, *args):
+        pass
+
+    def _authorize(self, scope: Scope) -> str:
+        headers = self.headers.get_all("Authorization", [])
+        match = BEARER.fullmatch(headers[0]) if len(headers) == 1 else None
+        if match is None:
+            raise RequestError(HTTPStatus.UNAUTHORIZED, "invalid_bearer_token")
+        digest = hashlib.sha256(match[1].encode("ascii")).digest()
+        account = self.server.accounts.get(digest)
+        if account is None:
+            raise RequestError(HTTPStatus.UNAUTHORIZED, "invalid_bearer_token")
+        account_id, scopes = account
+        if scope not in scopes:
+            raise RequestError(HTTPStatus.NOT_FOUND, "scope_not_found")
+        return account_id
+
+    def _read_body(self, maximum=MAX_REQUEST_BYTES) -> bytes:
+        if self.headers.get_all("Transfer-Encoding"):
+            raise RequestError(HTTPStatus.BAD_REQUEST, "unsupported_transfer_encoding")
+        content_types = self.headers.get_all("Content-Type", [])
+        if len(content_types) != 1 or self.headers.get_content_type() != "application/json":
+            raise RequestError(HTTPStatus.UNSUPPORTED_MEDIA_TYPE, "expected_application_json")
+        lengths = self.headers.get_all("Content-Length", [])
+        if not lengths:
+            raise RequestError(HTTPStatus.LENGTH_REQUIRED, "content_length_required")
+        if len(lengths) != 1 or not re.fullmatch(r"[0-9]+", lengths[0]):
+            raise RequestError(HTTPStatus.BAD_REQUEST, "invalid_content_length")
+        digits = lengths[0].lstrip("0") or "0"
+        if len(digits) > len(str(maximum)) or int(digits) > maximum:
+            raise RequestError(HTTPStatus.REQUEST_ENTITY_TOO_LARGE, "request_too_large")
+        size = int(digits)
+        try:
+            raw = self.rfile.read(size)
+        except TimeoutError as error:
+            raise RequestError(HTTPStatus.REQUEST_TIMEOUT, "request_body_timeout") from error
+        if len(raw) != size:
+            raise RequestError(HTTPStatus.BAD_REQUEST, "incomplete_request")
+        return raw
+
+    def _send_json(self, status: int, body):
+        data = _json_bytes(body)
+        self.send_response(status)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(data)))
+        self.send_header("Cache-Control", "no-store")
+        if status == HTTPStatus.UNAUTHORIZED:
+            self.send_header("WWW-Authenticate", "Bearer")
+        self.end_headers()
+        self.wfile.write(data)
+
+    def send_receipt(self, status: int, receipt):
+        """Send the success receipt after the SQLite transaction has committed."""
+        self._send_json(status, receipt)
+
+    def do_GET(self):
+        try:
+            self._handle_task(TASK_ROUTE.fullmatch(self.path))
+        except (BrokenPipeError, ConnectionResetError, TimeoutError):
+            self.close_connection = True
+
+    def do_POST(self):
+        try:
+            if route := TASK_ROUTE.fullmatch(self.path):
+                self._handle_task(route)
+            else:
+                self._handle_entry()
+        except (BrokenPipeError, ConnectionResetError, TimeoutError):
+            self.close_connection = True
+
+    def _handle_task(self, route):
+        try:
+            if route is None:
+                raise RequestError(HTTPStatus.NOT_FOUND, "route_not_found")
+            workspace_id, project_id, task_id = route.groups()
+            account_id = self._authorize((workspace_id, project_id))
+            key = (account_id, workspace_id, project_id, task_id)
+            if self.command == "GET":
+                with closing(_connect(self.server.database)) as connection:
+                    head = _task_head(connection, key)
+                self._send_json(HTTPStatus.OK, head)
+                return
+
+            event_id, proposal = _task_proposal(self._read_body(MAX_TASK_REQUEST_BYTES), key)
+            status, receipt = _commit_task(self.server.database, key, event_id, proposal)
+        except RequestError as error:
+            self._send_json(error.status, {"error": str(error)})
+        except (ValueError, OverflowError, RecursionError):
+            self._send_json(HTTPStatus.BAD_REQUEST, {"error": "invalid_task_payload"})
+        except sqlite3.Error:
+            self._send_json(HTTPStatus.SERVICE_UNAVAILABLE, {"error": "storage_unavailable"})
+        else:
+            self.send_receipt(status, receipt)
+
+    def _handle_entry(self):
+        try:
+            route = ROUTE.fullmatch(self.path)
+            if route is None:
+                raise RequestError(HTTPStatus.NOT_FOUND, "route_not_found")
+            workspace_id, project_id, event_id = route.groups()
+            account_id = self._authorize((workspace_id, project_id))
+            raw = self._read_body()
+            receipt, event, entry, jpeg = _validate_payload(raw, workspace_id, project_id, event_id)
+            status = _commit_event(self.server.database, account_id, receipt, event, entry, jpeg)
+        except RequestError as error:
+            self._send_json(error.status, {"error": str(error)})
+            return
+        except (ValueError, OverflowError, RecursionError):
+            self._send_json(HTTPStatus.BAD_REQUEST, {"error": "invalid_entry_payload"})
+            return
+        except sqlite3.Error:
+            self._send_json(HTTPStatus.SERVICE_UNAVAILABLE, {"error": "storage_unavailable"})
+            return
+        self.send_receipt(status, receipt)
+
+
+class _EntrySyncServer(HTTPServer):
+    def __init__(self, database, accounts, port, handler_class):
+        self.database = database
+        self.accounts = accounts
+        super().__init__(("127.0.0.1", port), handler_class)
+
+
+def make_server(
+    database: Path,
+    accounts: Accounts,
+    port: int = 0,
+    handler_class: type[EntrySyncHandler] = EntrySyncHandler,
+) -> HTTPServer:
+    """Open a dedicated SQLite file and bind a provisioned server to IPv4 loopback."""
+    owner_by_scope: dict[Scope, str] = {}
+    provisioned: dict[bytes, tuple[str, frozenset[Scope]]] = {}
+    for token, (account_id, scopes) in accounts.items():
+        if not TOKEN.fullmatch(token) or not isinstance(account_id, str) or not account_id:
+            raise ValueError("invalid FieldLog account provisioning")
+        for workspace_id, project_id in scopes:
+            if not UUID_TEXT.fullmatch(workspace_id) or not UUID_TEXT.fullmatch(project_id):
+                raise ValueError("FieldLog provisioned scope must use lowercase UUIDs")
+            scope = (workspace_id, project_id)
+            if owner_by_scope.setdefault(scope, account_id) != account_id:
+                raise ValueError("FieldLog scope has multiple account owners")
+        provisioned[hashlib.sha256(token.encode("ascii")).digest()] = (account_id, frozenset(scopes))
+
+    database = Path(database).resolve()
+    with closing(_connect(database)) as connection:
+        connection.executescript("BEGIN IMMEDIATE;\n" + SCHEMA + "\nCOMMIT;")
+    return _EntrySyncServer(database, provisioned, port, handler_class)
