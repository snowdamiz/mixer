+opts=(-target "$target" -swift-version 6 -package-name mixer -module-cache-path "$b/cache" -I "$b" -Xcc -I -Xcc "$sdk/vm/include" -L "$b" -j 5)
+cmod() {
+  local name=$1 root=$2
+  shift 2
+  mkdir "$b/$name"
+  printf 'module %s { umbrella "%s/include" export * }\n' "$name" "$root" > "$b/$name/module.modulemap"
+  xcrun clang -target "$target" -I "$root/include" -I "$sdk/vm/include" -c "$root/$1" -o "$b/$name.o"
+}
+swiftmod() {
+  local name=$1
+  shift
+  echo "module $name"
+  swiftc "${opts[@]}" -emit-module -emit-library -module-name "$name" -o "$b/lib$name.dylib" "$@"
+}
+cmod MixerCapabilityIO "$sdk/sdk/Sources/MixerCapabilities/NativeIO" lock.c
