+    .accessibilityAddTraits(selected ? .isSelected : [])
+  }
+
+  static func whitespaceDescription(_ value: String) -> String? {
+    guard !value.isEmpty, value.allSatisfy(\.isWhitespace) else { return nil }
+    return value.unicodeScalars.map { scalar in
+      switch scalar {
+      case " ": "Space"
+      case "\t": "Tab"
+      case "\n": "Line feed"
+      case "\r": "Carriage return"
+      default: scalar.properties.name ?? "U+\(String(scalar.value, radix: 16, uppercase: true))"
+      }
+    }.joined(separator: ", ")
+  }
+
+  private func submit(_ review: TaskConflictReview?) {
+    let decisions = choices
+    Task {
+      if await owner.submit(to: model, review: review, choices: decisions) { dismiss() }
+    }
+  }
+}
