+swiftmod MixerExperimentalCapabilityRuntime -Xlinker -undefined -Xlinker dynamic_lookup -lMixerGuest -lMixerCapabilities "$b/CMixerVMCapability.o" "$sdk/experimental-capability-runtime/Sources/MixerExperimentalCapabilityRuntime/"*.swift
+swiftmod MixerUpdates -lCrypto "$b/MixerDurableIO.o" "$sdk/updates/Sources/MixerUpdates/"*.swift
