+#!/bin/bash
+set -eu
+if [[ $# != 3 ]]; then
+  echo "Usage: $0 PAIR25_SOURCE PINNED_SWIFT_CRYPTO NEW_OUTPUT_DIRECTORY" >&2
+  exit 2
+fi
