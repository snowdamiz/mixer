diff --git a/Sources/FieldLogStorage/TaskSyncClient.swift b/Sources/FieldLogStorage/TaskSyncClient.swift
new file mode 100644
index 0000000000000000000000000000000000000000..f6477834fdf8993369f287bb10b6a3b6d4fe09c3
--- /dev/null
+++ b/Sources/FieldLogStorage/TaskSyncClient.swift
@@ -0,0 +1,281 @@
+import FieldLogModels
+import Foundation
+
+#if !os(Android) && canImport(FoundationNetworking)
+  import FoundationNetworking
+#endif
+
+/// Exchanges saved task text with a provisioned localhost FieldLog backend.
+public struct TaskSyncClient: Sendable {
+  public enum Failure: Error, LocalizedError, Equatable {
+    case invalidConfiguration
+    case rejected(Int)
+    case invalidReceipt
+
+    public var errorDescription: String? {
+      switch self {
+      case .invalidConfiguration: "A local backend port and session token are required."
+      case .rejected(let status): "The local task backend refused the request (HTTP \(status))."
+      case .invalidReceipt: "The local task backend did not confirm this task."
+      }
+    }
+  }
+
+  private struct Receipt: Decodable {
+    let eventID: UUID
+    let head: TaskSyncHead
+  }
+
+  /// Performs one GET when upload is nil, or one POST otherwise, against 127.0.0.1.
+  /// Return a redirect's original status with an empty body. Reject declared lengths
+  /// over 8192 before reading the body and probe at most one byte past the limit.
+  /// Stop I/O on task cancellation or at an absolute monotonic five-second deadline.
+  public typealias Transport = @Sendable (
+    _ port: UInt16, _ path: String, _ bearerToken: String, _ upload: Data?
+  ) async throws -> (status: Int, body: Data)
+
+  fileprivate static let responseLimit = 8192
+  private let port: UInt16
+  private let projectID: UUID
+  private let workspaceID: UUID
+  private let token: String
+  private let transport: Transport
+
+  #if !os(Android)
+    public init(port: UInt16, workspaceID: UUID, projectID: UUID, token: String) throws {
+      try self.init(
+        port: port, workspaceID: workspaceID, projectID: projectID, token: token,
+        transport: Self.exchangeUsingURLSession)
+    }
+  #endif
+
+  public init(
+    port: UInt16, workspaceID: UUID, projectID: UUID, token: String, transport: @escaping Transport
+  ) throws {
+    guard port > 0, (32...128).contains(token.utf8.count),
+      token.utf8.allSatisfy({
+        (48...57).contains($0) || (65...90).contains($0) || (97...122).contains($0)
+          || $0 == 45 || $0 == 95
+      })
+    else { throw Failure.invalidConfiguration }
+    self.port = port
+    self.workspaceID = workspaceID
+    self.projectID = projectID
+    self.token = token
+    self.transport = transport
+  }
+
+  /// Each call performs one upload or fetch. A stale upload fetches the current
+  /// version and stores a merged edit or a review for the ordinary task editor.
+  public func synchronize(taskID: UUID, in repository: WorkspaceRepository) async throws -> Workspace {
+    try Task.checkCancellation()
+    let scope = TaskSyncScope(workspaceID: workspaceID, projectID: projectID, taskID: taskID)
+    let local = try await repository.prepareTaskSync(scope)
+    let path = "/v1/workspaces/\(workspaceID.uuidString.lowercased())/projects/\(projectID.uuidString.lowercased())/tasks/\(taskID.uuidString.lowercased())"
+    if let upload = try local.taskSyncUpload(scope) {
+      let (status, body) = try await exchange(path: path, body: JSONEncoder().encode(upload))
+      if status == 200 || status == 201 {
+        guard let receipt = try? JSONDecoder().decode(Receipt.self, from: body),
+          receipt.eventID == upload.eventID, receipt.head.scope == scope
+        else { throw Failure.invalidReceipt }
+        try Task.checkCancellation()
+        return try await repository.acknowledgeTaskSync(
+          upload, head: receipt.head, expectedRevision: local.revision)
+      }
+      guard status == 409,
+        (try? JSONDecoder().decode([String: String].self, from: body)) == ["error": "stale_task_version"]
+      else { throw Failure.rejected(status) }
+    }
+
+    let (status, body) = try await exchange(path: path)
+    guard status == 200 else { throw Failure.rejected(status) }
+    guard let head = try? JSONDecoder().decode(TaskSyncHead.self, from: body), head.scope == scope
+    else { throw Failure.invalidReceipt }
+    try Task.checkCancellation()
+    return try await repository.receiveTaskSync(head, expectedRevision: local.revision)
+  }
+
+  private func exchange(path: String, body: Data? = nil) async throws -> (Int, Data) {
+    try Task.checkCancellation()
+    do {
+      let response = try await transport(port, path, token, body)
+      try Task.checkCancellation()
+      guard response.body.count <= Self.responseLimit else { throw Failure.invalidReceipt }
+      return response
+    } catch {
+      try Task.checkCancellation()
+      throw error
+    }
+  }
+}
+
+#if !os(Android)
+extension TaskSyncClient {
+  private static func exchangeUsingURLSession(
+    port: UInt16, path: String, token: String, body: Data?
+  ) async throws -> (status: Int, body: Data) {
+    guard let origin = URL(string: "http://127.0.0.1:\(port)") else {
+      throw Failure.invalidConfiguration
+    }
+    let url = origin.appending(path: path)
+    let configuration = URLSessionConfiguration.ephemeral
+    configuration.urlCredentialStorage = nil
+    configuration.httpCookieStorage = nil
+    configuration.httpShouldSetCookies = false
+    configuration.urlCache = nil
+    configuration.connectionProxyDictionary = [
+      "HTTPEnable": false, "HTTPSEnable": false, "ProxyAutoConfigEnable": false,
+      "ProxyAutoDiscoveryEnable": false, "SOCKSEnable": false,
+    ]
+    configuration.timeoutIntervalForRequest = 3
+    configuration.timeoutIntervalForResource = 5
+    var request = URLRequest(url: url)
+    request.setValue("Bearer \(token)", forHTTPHeaderField: "Authorization")
+    request.setValue("identity", forHTTPHeaderField: "Accept-Encoding")
+    if let body {
+      request.httpMethod = "POST"
+      request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+      request.httpBody = body
+    }
+    let delegate = LoopbackTaskSyncDelegate()
+    let session = URLSession(configuration: configuration, delegate: delegate, delegateQueue: nil)
+    defer { session.invalidateAndCancel() }
+    return try await withTaskCancellationHandler {
+      try await withCheckedThrowingContinuation { continuation in
+        delegate.start(request, in: session, returningTo: continuation)
+      }
+    } onCancel: {
+      delegate.cancel()
+    }
+  }
+}
+
+private final class LoopbackTaskSyncDelegate: NSObject, URLSessionDataDelegate, @unchecked Sendable {
+  private let lock = NSLock()
+  private var task: URLSessionDataTask?
+  private var continuation: CheckedContinuation<(Int, Data), Error>?
+  private var cancelled = false
+
+  // Only the session's serial delegate queue touches the response.
+  private var response: HTTPURLResponse?
+  private var body = Data()
+  private var invalidReceipt = false
+
+  func start(
+    _ request: URLRequest, in session: URLSession,
+    returningTo continuation: CheckedContinuation<(Int, Data), Error>
+  ) {
+    let started = lock.withLock {
+      guard !cancelled else { return false }
+      let task = session.dataTask(with: request)
+      self.task = task
+      self.continuation = continuation
+      task.resume()
+      return true
+    }
+    if !started { continuation.resume(throwing: CancellationError()) }
+  }
+
+  func cancel() {
+    let task = lock.withLock {
+      cancelled = true
+      return self.task
+    }
+    task?.cancel()
+  }
+
+  func urlSession(
+    _ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse,
+    newRequest request: URLRequest, completionHandler: @escaping @Sendable (URLRequest?) -> Void
+  ) {
+    completionHandler(nil)
+  }
+
+  func urlSession(
+    _ session: URLSession, dataTask: URLSessionDataTask, didReceive response: URLResponse,
+    completionHandler: @escaping @Sendable (URLSession.ResponseDisposition) -> Void
+  ) {
+    guard let http = response as? HTTPURLResponse, http.expectedContentLength <= TaskSyncClient.responseLimit else {
+      invalidReceipt = true
+      completionHandler(.cancel)
+      return
+    }
+    self.response = http
+    completionHandler(.allow)
+  }
+
+  func urlSession(_ session: URLSession, dataTask: URLSessionDataTask, didReceive data: Data) {
+    guard !invalidReceipt else { return }
+    guard data.count <= TaskSyncClient.responseLimit - body.count else {
+      invalidReceipt = true
+      dataTask.cancel()
+      return
+    }
+    body.append(data)
+  }
+
+  func urlSession(
+    _ session: URLSession, task: URLSessionTask, didCompleteWithError error: (any Error)?
+  ) {
+    let continuation = lock.withLock {
+      self.task = nil
+      let continuation = self.continuation
+      self.continuation = nil
+      return continuation
+    }
+    if invalidReceipt {
+      continuation?.resume(throwing: TaskSyncClient.Failure.invalidReceipt)
+    } else if let error {
+      continuation?.resume(throwing: error)
+    } else if let response,
+      response.expectedContentLength < 0 || response.expectedContentLength == Int64(body.count)
+    {
+      continuation?.resume(returning: (response.statusCode, body))
+    } else {
+      continuation?.resume(throwing: TaskSyncClient.Failure.invalidReceipt)
+    }
+  }
+}
+
+#endif
+
+extension WorkspaceRepository {
+  private struct UnchangedTaskState: Error {}
+
+  public func transactTask(
+    expectedRevision: UInt64? = nil, _ mutation: @Sendable (inout Workspace) throws -> Void
+  ) throws -> Workspace {
+    do {
+      return try transact(expectedRevision: expectedRevision) { workspace in
+        let before = workspace
+        try mutation(&workspace)
+        guard workspace != before else { throw UnchangedTaskState() }
+      }
+    } catch is UnchangedTaskState {
+      return try readCommittedSnapshot()
+    }
+  }
+
+  func prepareTaskSync(_ scope: TaskSyncScope) throws -> Workspace {
+    try transactTask {
+      try Task.checkCancellation()
+      try $0.prepareTaskSync(scope)
+    }
+  }
+
+  func receiveTaskSync(_ head: TaskSyncHead, expectedRevision: UInt64) throws -> Workspace {
+    try transactTask(expectedRevision: expectedRevision) {
+      try Task.checkCancellation()
+      try $0.receiveTaskSync(head)
+    }
+  }
+
+  func acknowledgeTaskSync(
+    _ upload: TaskSyncUpload, head: TaskSyncHead, expectedRevision: UInt64
+  ) throws -> Workspace {
+    try transact(expectedRevision: expectedRevision) {
+      try Task.checkCancellation()
+      try $0.acknowledgeTaskSync(upload, head: head)
+    }
+  }
+}
