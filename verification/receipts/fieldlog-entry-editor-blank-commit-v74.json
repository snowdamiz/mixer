      "import Foundation",
      "import FieldLogFeatures",
      "import FieldLogModels",
      "import MixerCore",
      "",
      "@main",
      "struct Replay {",
      "    @MainActor",
      "    static func main() throws {",
      "        let timestamp = Date(timeIntervalSince1970: 1_792_600_000.125)",
      "        var workspace = Workspace(createdAt: timestamp)",
      "        let project = try workspace.createProject(title: \"Blank\", site: \"\", now: timestamp)",
      "        let note = String(repeating: \"\u754c\", count: 33_333) + \"a\"",
      "        let draft = EntryDraft(projectID: project, title: \"\", note: note, occurredAt: timestamp)",
      "        try workspace.saveDraft(draft)",
      "        let editor = try EntryEditor(projectID: project, draft: workspace.drafts[0]) { _ in",
      "            fatalError(\"A blank commit reached persistence\")",
      "        }",
      "        try editor.commitDraft()",
      "        let state = editor.state",
      "        precondition(state.draft == draft && state.draft.note.utf8.elementsEqual(note.utf8))",
      "        precondition(!state.saving && state.savedDraft == nil && state.committed == nil)",
      "        precondition(state.failure == \"Entry title can't be empty.\")",
      "        try editor.close()",
      "        precondition(editor.state.closed)",
      "        do {",
      "            try editor.commitDraft()",
      "            fatalError(\"A closed editor accepted another commit\")",
      "        } catch LifecycleError.featureNotRunning {}",
      "        print(\"draftBytes=\\(state.draft.note.utf8.count) titleBytes=\\(state.draft.title.utf8.count) entries=\\(workspace.entries.count) failure=\\(state.failure!) closed=\\(editor.state.closed)\")",
      "    }",
      "}"
