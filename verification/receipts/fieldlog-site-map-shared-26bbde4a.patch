+#!/usr/bin/env bash
+set -euo pipefail
+
+tests="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+repo="$(cd "$tests/../.." && pwd)"
+android="$repo/Integrations/GeneratedReport"
+asset="$repo/Assets/SiteMap/natural-earth-50m.flg"
+fixture="$tests/workspace-before-site-map.json"
+scratch="$(mktemp -d "${TMPDIR:-/tmp}/fieldlog-site-map-host.XXXXXXXX")"
+trap 'rm -rf -- "$scratch"' EXIT
+
+for apple_source in "$repo"/Sources/FieldLogModels/*.swift; do
+  cmp "$apple_source" "$android/Sources/FieldLogModels/${apple_source##*/}"
+done
+for android_source in "$android"/Sources/FieldLogModels/*.swift; do
+  test -f "$repo/Sources/FieldLogModels/${android_source##*/}"
+done
+test "$(shasum -a 256 "$asset" | cut -d ' ' -f 1)" = 1c4a6e6add0fa4d3b7628a59d9bc2cde8782dad9fe4d135985fa153e12514379
+test "$(shasum -a 256 "$fixture" | cut -d ' ' -f 1)" = bd27930c3ae49175e0776434a0934da2a0d135df64e832c41f35de3881d9ea7a
+
+compiler="${SWIFTC:-swiftc}"
+"$compiler" --version
+flags=(-swift-version 6 -warnings-as-errors -module-cache-path "$scratch/modules")
+for target in apple android; do
+  source_root="$repo"
+  storage_flags=()
+  if [[ "$target" == android ]]; then
+    source_root="$android"
+    storage_flags=(-DFIELDLOG_MERGED_DRAFT_PHOTOS)
+  fi
+  build="$scratch/$target"
+  mkdir "$build"
+  "$compiler" "${flags[@]}" -emit-module -emit-library -module-name FieldLogModels \
+    "$source_root"/Sources/FieldLogModels/*.swift -o "$build/libFieldLogModels.dylib"
+  "$compiler" "${flags[@]}" ${storage_flags[@]+"${storage_flags[@]}"} -emit-module -emit-library -module-name FieldLogStorage \
+    -I "$build" -L "$build" -lFieldLogModels \
+    "$source_root/Sources/FieldLogStorage/WorkspaceRepository.swift" -o "$build/libFieldLogStorage.dylib"
+  "$compiler" "${flags[@]}" -parse-as-library -I "$build" -L "$build" -lFieldLogModels -lFieldLogStorage \
+    "$tests/SiteMapChecks.swift" -o "$build/site-map-checks"
+  DYLD_LIBRARY_PATH="$build" "$build/site-map-checks" "$asset" "$fixture" "$build/workspace" \
+    > "$build/readback.json"
+done
+cmp "$scratch/apple/readback.json" "$scratch/android/readback.json"
+cat "$scratch/apple/readback.json"
+rm -rf -- "$scratch"
+test ! -e "$scratch"
+trap - EXIT
+printf '%s\n' 'Both FieldLog model copies and behavior readbacks match. Host scratch removed.'
