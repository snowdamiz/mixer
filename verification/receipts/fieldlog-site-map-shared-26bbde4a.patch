+  public static func project(
+    site: SiteCoordinate?, fix: SiteMapFix? = nil, widthMeters: Int = 200_000,
+    geography: SiteMapGeography
+  ) throws -> SiteMapScene? {
+    guard supportedWidthsMeters.contains(widthMeters) else { throw ProjectionError.unsupportedWidth }
+    guard let center = site ?? fix?.coordinate else { return nil }
+    let width = Double(widthMeters)
+    let projection = Projection(center: center, width: width)
+    var segments: [Segment] = []
+    for path in geography.paths {
+      var previous = projection.point(path.coordinates[0], latitudeAllowance: projection.geometryLatitudeAllowance)
+      for coordinate in path.coordinates.dropFirst() {
+        let next = projection.point(coordinate, latitudeAllowance: projection.geometryLatitudeAllowance)
