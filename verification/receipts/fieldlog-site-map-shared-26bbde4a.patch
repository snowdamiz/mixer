diff --git a/Integrations/GeneratedReport/Sources/FieldLogModels/SiteCoordinate.swift b/Integrations/GeneratedReport/Sources/FieldLogModels/SiteCoordinate.swift
new file mode 100644
index 0000000000000000000000000000000000000000..0605ef0bbda594bc732733cb3aab9f2851135941
--- /dev/null
+++ b/Integrations/GeneratedReport/Sources/FieldLogModels/SiteCoordinate.swift
@@ -0,0 +1,40 @@
+import Foundation
+
+/// WGS84 coordinates in signed degrees × 10⁷. The antimeridian is stored as −180°.
+public struct SiteCoordinate: Codable, Hashable, Sendable {
+  public let latitudeE7: Int32
+  public let longitudeE7: Int32
+
+  public init?(latitudeE7: Int32, longitudeE7: Int32) {
+    guard (-900_000_000...900_000_000).contains(latitudeE7),
+      (-1_800_000_000...1_800_000_000).contains(longitudeE7)
+    else { return nil }
+    self.latitudeE7 = latitudeE7
+    self.longitudeE7 = longitudeE7 == 1_800_000_000 ? -1_800_000_000 : longitudeE7
+  }
+
+  public init?(latitude: Double, longitude: Double) {
+    guard (-90...90).contains(latitude), (-180...180).contains(longitude) else { return nil }
+    self.init(
+      latitudeE7: Int32((latitude * 10_000_000).rounded()),
+      longitudeE7: Int32((longitude * 10_000_000).rounded()))
+  }
+
+  public var latitude: Double { Double(latitudeE7) / 10_000_000 }
+  public var longitude: Double { Double(longitudeE7) / 10_000_000 }
+
+  private enum CodingKeys: String, CodingKey {
+    case latitudeE7, longitudeE7
+  }
+
+  public init(from decoder: any Decoder) throws {
+    let values = try decoder.container(keyedBy: CodingKeys.self)
+    let latitude = try values.decode(Int32.self, forKey: .latitudeE7)
+    let longitude = try values.decode(Int32.self, forKey: .longitudeE7)
+    guard let coordinate = Self(latitudeE7: latitude, longitudeE7: longitude) else {
+      throw DecodingError.dataCorrupted(
+        .init(codingPath: decoder.codingPath, debugDescription: "Site coordinate is outside WGS84 bounds."))
+    }
+    self = coordinate
+  }
+}
