index 0000000000000000000000000000000000000000..80b32a5ee9212b7b6c5d84aa1f95332a43eadaf2
--- /dev/null
+++ b/Assets/SiteMap/encode-natural-earth.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""Encode the pinned Natural Earth GeoJSON inputs into FieldLog regional linework."""
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+
+LAYERS = (
+    (1, "ne_50m_coastline.geojson",
+     "271f1c4c1908312bac6b29d158ea1356544beafc129f260005300913aa5ea283"),
+    (2, "ne_50m_lakes.geojson",
+     "d350b75978b26fe839b797c2c529b2fb8f47fb3983c03f4964e36d5df9378a52"),
+    (3, "ne_50m_rivers_lake_centerlines.geojson",
+     "f286e0ce978fde999ca2d7a78c764be08542e19b63cded52b05c12d5173ccc51"),
+)
+ASSET_SHA256 = "1c4a6e6add0fa4d3b7628a59d9bc2cde8782dad9fe4d135985fa153e12514379"
+
+
+def paths(geometry):
+    kind, coordinates = geometry["type"], geometry["coordinates"]
+    if kind == "LineString":
+        return [coordinates]
+    if kind in {"MultiLineString", "Polygon"}:
+        return coordinates
+    if kind == "MultiPolygon":
+        return [ring for polygon in coordinates for ring in polygon]
+    raise ValueError(f"Unsupported Natural Earth geometry: {kind}")
+
+
+def encode(source_directory):
+    features = []
+    for layer, name, expected_sha in LAYERS:
+        source = (source_directory / name).read_bytes()
+        if hashlib.sha256(source).hexdigest() != expected_sha:
+            raise ValueError(f"Unexpected Natural Earth input: {name}")
+        for feature in json.loads(source)["features"]:
+            features.extend((layer, path) for path in paths(feature["geometry"]))
+
+    output = bytearray(struct.pack("<4sI", b"FLG1", len(features)))
+    for layer, path in features:
+        output.extend(struct.pack("<BI", layer, len(path)))
+        for longitude, latitude in path:
+            lat_e5 = round(latitude * 100_000)
+            lon_e5 = round(longitude * 100_000)
+            if lon_e5 == 18_000_000:
+                lon_e5 = -18_000_000
+            output.extend(struct.pack("<ii", lat_e5, lon_e5))
+    return output
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("source_directory", type=Path, help="Directory of pinned Natural Earth inputs")
+    parser.add_argument("output", type=Path, help="New asset file to write")
+    args = parser.parse_args()
+    encoded = encode(args.source_directory)
+    if hashlib.sha256(encoded).hexdigest() != ASSET_SHA256:
+        raise ValueError("Unexpected geography output")
+    with args.output.open("xb") as destination:
+        destination.write(encoded)
