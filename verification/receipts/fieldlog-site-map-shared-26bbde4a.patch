+        guard let previous, let next, let clipped = clip(previous, next) else { continue }
+        guard segments.count < maximumSegments else { throw ProjectionError.tooManySegments }
+        segments.append(Segment(layer: path.layer, from: clipped.0, to: clipped.1))
+      }
+    }
