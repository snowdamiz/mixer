+
+private struct Failure: Error, CustomStringConvertible {
+  let description: String
+  init(_ description: String) { self.description = description }
+}
+
+private func check(_ condition: @autoclosure () throws -> Bool, _ message: String) throws {
+  guard try condition() else { throw Failure(message) }
+}
+
+private func reject<E: Error & Equatable>(_ expected: E, _ body: () throws -> Void) throws {
+  do { try body() }
+  catch let error as E where error == expected { return }
+  throw Failure("Expected \(expected)")
+}
+
+private func reject<E: Error & Equatable>(
+  _ expected: E, _ body: () async throws -> Void
+) async throws {
+  do { try await body() }
+  catch let error as E where error == expected { return }
+  throw Failure("Expected \(expected)")
+}
+
+private func require<T>(_ value: T?, _ message: String) throws -> T {
+  guard let value else { throw Failure(message) }
+  return value
+}
+
+private func coordinate(_ latitude: Double, _ longitude: Double) throws -> SiteCoordinate {
+  try require(SiteCoordinate(latitude: latitude, longitude: longitude), "Invalid test coordinate")
+}
+
+private func snapshotData(_ workspace: Workspace) throws -> Data {
+  let encoder = JSONEncoder()
+  encoder.outputFormatting = [.sortedKeys, .withoutEscapingSlashes]
+  return try encoder.encode(workspace)
+}
+
+private func persistence(fixture: Data, directory: URL, geography: SiteMapGeography) async throws {
+  try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false)
+  let file = directory.appendingPathComponent("workspace.json")
+  try fixture.write(to: file)
+  let repository = try WorkspaceRepository(directory: directory)
+  let old = try await repository.readCommittedSnapshot()
+  let first = old.projects[0]
+  let second = old.projects[1]
+  try check(first.siteCoordinate == nil && second.siteCoordinate == nil, "Legacy pin must be absent")
+  try check(try snapshotData(old) == fixture, "Legacy wire format changed")
+  let pin = try coordinate(37.81, -122.48)
+  let fix = try require(SiteMapFix(coordinate: pin, accuracyMeters: 14), "Fixture fix unavailable")
+  let scene = try SiteMapScene.project(site: first.siteCoordinate, fix: fix, geography: geography)
+  try check(scene?.site == nil && scene?.fix != nil, "Foreground-only scene acquired a saved pin")
+  try check(try Data(contentsOf: file) == fixture, "Read-only map changed workspace bytes")
+
+  try await reject(FieldLogError.staleRevision) {
+    try await repository.transact {
+      try $0.setSiteCoordinate(projectID: second.id, expected: nil, to: pin)
+    }
+  }
+  try await reject(FieldLogError.missingRecord) {
+    try await repository.transact {
+      let absent = UUID(uuidString: "FFFFFFFF-FFFF-4FFF-BFFF-FFFFFFFFFFFF")!
+      try $0.setSiteCoordinate(projectID: absent, expected: nil, to: pin)
+    }
+  }
+  try check(try Data(contentsOf: file) == fixture, "Stale/missing project changed disk")
+
+  let saved = try await repository.transact(expectedRevision: old.revision) {
+    try $0.setSiteCoordinate(projectID: first.id, expected: nil, to: pin)
+  }
+  var expected = old
+  expected.revision += 1
+  expected.projects[0] = Project(
+    id: first.id, title: first.title, site: first.site, createdAt: first.createdAt, siteCoordinate: pin)
+  try check(saved == expected, "Pin save changed other workspace fields")
+  let savedBytes = try Data(contentsOf: file)
+  try check(savedBytes == snapshotData(expected), "Pin save wire readback differs")
+  try await reject(FieldLogError.staleRevision) {
+    try await repository.transact(expectedRevision: saved.revision) {
+      try $0.setSiteCoordinate(projectID: first.id, expected: nil, to: nil)
+    }
+  }
+  try await reject(FieldLogError.staleRevision) {
+    try await repository.transact(expectedRevision: old.revision) {
+      try $0.setSiteCoordinate(projectID: first.id, expected: pin, to: nil)
+    }
+  }
+  try check(try Data(contentsOf: file) == savedBytes, "Stale revision/prior pin changed disk")
+  await repository.close()
+
+  let reopened = try WorkspaceRepository(directory: directory)
+  let cold = try await reopened.readCommittedSnapshot()
+  try check(cold == saved, "Cold reopen lost saved pin")
+  let cleared = try await reopened.transact(expectedRevision: cold.revision) {
+    try $0.setSiteCoordinate(projectID: first.id, expected: pin, to: nil)
+  }
+  expected = old
+  expected.revision += 2
+  try check(cleared == expected, "Clearing pin changed other workspace fields")
+  try check(try Data(contentsOf: file) == snapshotData(expected), "Clear left a persisted pin")
+  await reopened.close()
+  let clearReopen = try WorkspaceRepository(directory: directory)
+  let coldCleared = try await clearReopen.readCommittedSnapshot()
+  try check(coldCleared == expected, "Cold reopen of clear changed data")
+  let switched = try await clearReopen.transact {
+    $0.restoration.selectedProjectID = second.id
+  }
+  let switchedBytes = try Data(contentsOf: file)
+  try await reject(FieldLogError.staleRevision) {
+    try await clearReopen.transact {
+      try $0.setSiteCoordinate(projectID: first.id, expected: nil, to: pin)
+    }
+  }
+  try check(try Data(contentsOf: file) == switchedBytes, "A project switch admitted a delayed pin write")
+  let switchedReadback = try await clearReopen.readCommittedSnapshot()
+  try check(switchedReadback == switched, "Delayed pin changed the selected workspace")
+  await clearReopen.close()
+
+  var invalid = try require(String(data: fixture, encoding: .utf8), "Fixture is not UTF-8")
+  invalid = invalid.replacingOccurrences(
+    of: "\"site\":\"North ridge\"",
+    with: "\"site\":\"North ridge\",\"siteCoordinate\":{\"latitudeE7\":900000001,\"longitudeE7\":0}")
+  let invalidBytes = Data(invalid.utf8)
+  try invalidBytes.write(to: file)
+  try reject(FieldLogError.storage("Saved workspace could not be read. It has not been reset or overwritten.")) {
+    _ = try WorkspaceRepository(directory: directory)
+  }
+  try check(try Data(contentsOf: file) == invalidBytes, "Invalid saved coordinate was overwritten")
+}
+
+private func coordinateChecks() throws {
+  let antimeridian = try coordinate(90, 180)
+  try check(antimeridian == coordinate(90, -180), "Antimeridian has two values")
+  try check(antimeridian.latitudeE7 == 900_000_000, "Latitude edge was rounded incorrectly")
+  try check(try coordinate(-90, 0).latitudeE7 == -900_000_000, "South latitude edge was lost")
+  try check(try coordinate(-1.23456785, 179.99999999).longitudeE7 == -1_800_000_000, "Rounded seam was not canonical")
+  try check(SiteCoordinate(latitude: .nan, longitude: 0) == nil, "NaN latitude accepted")
+  try check(SiteCoordinate(latitude: 0, longitude: .infinity) == nil, "Infinite longitude accepted")
+  try check(SiteCoordinate(latitude: 90.00000001, longitude: 0) == nil, "Out-of-range latitude rounded in")
+  try check(SiteCoordinate(latitudeE7: 0, longitudeE7: .min) == nil, "Invalid signed longitude accepted")
+  let raw = Data(#"{"latitudeE7":900000000,"longitudeE7":1800000000}"#.utf8)
+  let decoded = try JSONDecoder().decode(SiteCoordinate.self, from: raw)
+  try check(decoded == antimeridian, "Valid raw antimeridian did not normalize")
+  let encoder = JSONEncoder()
+  encoder.outputFormatting = .sortedKeys
+  let canonical = Data(#"{"latitudeE7":900000000,"longitudeE7":-1800000000}"#.utf8)
+  try check(try encoder.encode(decoded) == canonical, "Wire antimeridian was not canonical")
+  for invalid in [
+    #"{"latitudeE7":-900000001,"longitudeE7":0}"#,
+    #"{"latitudeE7":0,"longitudeE7":1800000001}"#,
+    #"{"latitudeE7":0,"longitudeE7":2147483648}"#,
+    #"{"latitudeE7":0.5,"longitudeE7":0}"#,
+    #"{"latitudeE7":0}"#,
+  ] {
+    do { _ = try JSONDecoder().decode(SiteCoordinate.self, from: Data(invalid.utf8)) }
+    catch is DecodingError { continue }
+    throw Failure("Invalid coordinate accepted: \(invalid)")
+  }
+  for invalid: Double in [-1, .nan, .infinity, 20_050_001] {
+    try check(SiteMapFix(coordinate: antimeridian, accuracyMeters: invalid) == nil, "Invalid accuracy accepted")
+  }
+}
+
+private func geometryData(_ paths: [[(Int32, Int32)]]) -> Data {
+  var data = Data("FLG1".utf8)
+  func word(_ value: UInt32) {
+    var value = value.littleEndian
+    withUnsafeBytes(of: &value) { data.append(contentsOf: $0) }
+  }
+  word(UInt32(paths.count))
+  for path in paths {
+    data.append(1)
+    word(UInt32(path.count))
+    for (latitude, longitude) in path {
+      word(UInt32(bitPattern: latitude))
+      word(UInt32(bitPattern: longitude))
+    }
+  }
+  return data
+}
+
+private func malformedChecks() throws {
+  typealias AssetError = SiteMapGeography.InvalidAsset
+  let validData = geometryData([[(0, 0), (0, 100)]])
+  for length in 0..<validData.count {
+    try reject(AssetError.malformed) { _ = try SiteMapGeography(data: validData.prefix(length)) }
+  }
+  try reject(AssetError.malformed) { _ = try SiteMapGeography(data: validData + Data([0])) }
+  var badLayer = validData
+  badLayer[8] = 255
+  try reject(AssetError.malformed) { _ = try SiteMapGeography(data: badLayer) }
+  var hugePathCount = validData
+  hugePathCount[7] = 255
+  try reject(AssetError.limitExceeded) { _ = try SiteMapGeography(data: hugePathCount) }
+  var hugeVertexCount = validData
+  hugeVertexCount[12] = 255
+  try reject(AssetError.limitExceeded) { _ = try SiteMapGeography(data: hugeVertexCount) }
+  for bad in [
+    geometryData([[(9_000_001, 0), (9_000_001, 1)]]),
+    geometryData([[(0, Int32.min), (0, 0)]]),
+    geometryData([[(0, 0), (0, 18_000_000)]]),
+    geometryData([[(0, 0), (0, 17_999_000)]]),
+    geometryData([[(0, 0)]]),
+  ] {
+    try reject(AssetError.malformed) { _ = try SiteMapGeography(data: bad) }
+  }
+  try reject(AssetError.limitExceeded) {
+    _ = try SiteMapGeography(data: Data(count: SiteMapGeography.maximumBytes + 1))
+  }
+  let dense = (0..<12_002).map { (Int32(0), Int32($0 % 2)) }
+  let geography = try SiteMapGeography(data: geometryData([dense, dense]))
+  try reject(SiteMapScene.ProjectionError.tooManySegments) {
+    _ = try SiteMapScene.project(site: coordinate(0, 0), geography: geography)
+  }
+}
+
+private func layerCounts(_ scene: SiteMapScene) throws -> [String: Int] {
+  var counts = ["coastline": 0, "lake": 0, "river": 0]
+  for segment in scene.segments {
+    let key: String
+    switch segment.layer {
+    case .coastline: key = "coastline"
+    case .lake: key = "lake"
+    case .river: key = "river"
+    }
+    counts[key, default: 0] += 1
+    for point in [segment.from, segment.to] {
+      try check((0...1).contains(point.x) && (0...1).contains(point.y), "Segment escaped scene bounds")
+    }
+  }
+  return counts
+}
+
+private func scenes(_ geography: SiteMapGeography) throws -> [String: Any] {
+  func scene(_ lat: Double, _ lon: Double, _ width: Int = 200_000, _ fix: SiteMapFix? = nil) throws -> SiteMapScene {
+    try require(SiteMapScene.project(site: coordinate(lat, lon), fix: fix,
+      widthMeters: width, geography: geography), "Scene unexpectedly empty")
+  }
+  let sanFrancisco = try layerCounts(scene(37.81, -122.48))
+  let chicago = try layerCounts(scene(41.88, -87.63))
+  let stLouis = try layerCounts(scene(38.63, -90.19))
+  let fiji = try layerCounts(scene(-16.8, 180))
+  try check(sanFrancisco["coastline", default: 0] > 0, "San Francisco coast missing")
+  try check(chicago["lake", default: 0] > 0 && chicago["coastline"] == 0, "Lake Michigan linework missing")
+  try check(stLouis["river", default: 0] > 0 && stLouis["coastline"] == 0, "Mississippi linework missing")
+  try check(fiji["coastline", default: 0] > 0, "Fiji antimeridian coast missing")
+
+  let fix = try require(SiteMapFix(coordinate: coordinate(0, -179.99), accuracyMeters: 25), "Missing fix")
+  let seam = try scene(0, 179.99, 20_000, fix)
+  let marker = try require(seam.fix, "Nearby fix across antimeridian disappeared")
+  try check(abs(marker.point.x - 0.611195) < 0.000001, "Fix projected in wrong direction across seam")
+  try check(abs(marker.point.y - 0.5) < 0.000001, "Equatorial fix drifted vertically")
+  try check(marker.accuracyRadius == 0.00125, "Accuracy units incorrect")
+  let far = try scene(0, 0, 20_000, fix)
+  try check(far.fix == nil && far.site != nil, "Far fix displaced saved site")
+  try check(try SiteMapScene.project(site: nil, geography: geography) == nil, "Missing anchors got a false site")
+  let fixOnly = try require(SiteMapScene.project(site: nil, fix: fix, geography: geography), "Missing fix-only scene")
+  try check(fixOnly.center == fix.coordinate && fixOnly.site == nil && fixOnly.fix?.point.x == 0.5,
+    "Fix-only scene used an incorrect anchor")
+
+  let poleFix = try require(SiteMapFix(coordinate: coordinate(89.99, 180)), "Missing pole fix")
+  let pole = try scene(90, 0, 20_000, poleFix)
+  let atPole = try require(pole.fix, "High-latitude fix disappeared")
+  try check(atPole.point.y < 0.5 && abs(atPole.point.x - 0.5) < 0.000001, "North-pole projection reversed")
+  try check(try scene(-90, 0).site?.y == 0.5, "South pole did not center")
+  let scales = try [20_000, 40_000, 80_000, 200_000, 400_000, 1_000_000].map {
+    try scene(37.81, -122.48, $0).scale
+  }
+  try check(scales.map(\.meters) == [5_000, 10_000, 20_000, 50_000, 100_000, 200_000], "Scale labels are not 1–2–5 distances")
+  try check(scales.allSatisfy { (0.1...0.25).contains($0.fractionOfWidth) }, "Scale bar is unreadable")
+  for width in [Int.min, 19_999, 1_000_001, Int.max] {
+    try reject(SiteMapScene.ProjectionError.unsupportedWidth) { _ = try scene(0, 0, width) }
+  }
+
+  let crossing = try SiteMapGeography(data: geometryData([[(0, 17_970_000), (0, -17_970_000)]]))
+  let projected = try require(
+    SiteMapScene.project(site: coordinate(0, 180), widthMeters: 20_000, geography: crossing), "Missing seam scene")
+  let line = try require(projected.segments.first, "Both-outside seam crossing was lost")
+  try check(projected.segments.count == 1 && line.from.x == 0 && line.to.x == 1, "Crossing did not clip to both edges")
+  let opposite = try SiteMapScene.project(site: coordinate(0, 0), widthMeters: 20_000, geography: crossing)
+  try check(opposite?.segments.isEmpty == true, "Far seam became a false line across Greenwich")
+
+  return [
+    "knownLayerCounts": ["sanFrancisco": sanFrancisco, "chicago": chicago, "stLouis": stLouis, "fiji": fiji],
+    "seamFix": ["x": (marker.point.x * 1_000_000).rounded() / 1_000_000, "y": marker.point.y, "normalizedAccuracyRadius": 0.00125],
+    "scaleMeters": scales.map(\.meters),
+    "clip": [line.from.x, line.to.x],
+    "controls": ["legacy-bytes", "atomic-save-and-clear", "cold-reopen", "stale-project-and-pin-and-revision",
+      "invalid-coordinate", "malformed-and-bounded-geography", "poles", "antimeridian", "offscreen-and-absent-fix"],
+  ]
+}
+
+@main struct SiteMapChecks {
+  static func main() async {
+    do {
+      let args = CommandLine.arguments
+      let asset = try Data(contentsOf: URL(fileURLWithPath: args[1]))
+      let fixture = try Data(contentsOf: URL(fileURLWithPath: args[2]))
+      let directory = URL(fileURLWithPath: args[3], isDirectory: true)
+      let geography = try SiteMapGeography(data: asset)
+      try coordinateChecks()
+      try malformedChecks()
+      try await persistence(fixture: fixture, directory: directory, geography: geography)
+      let result = try scenes(geography)
+      let output = try JSONSerialization.data(withJSONObject: result, options: [.sortedKeys])
+      print(String(decoding: output, as: UTF8.self))
+    } catch {
+      FileHandle.standardError.write(Data("FieldLog site map check failed: \(error)\n".utf8))
+      exit(1)
+    }
+  }
+}
