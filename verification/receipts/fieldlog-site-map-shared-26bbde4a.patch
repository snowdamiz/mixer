+    let fixMarker = fix.flatMap { sample -> FixMarker? in
+      guard let point = projection.point(sample.coordinate, latitudeAllowance: 180),
+        (0...1).contains(point.x), (0...1).contains(point.y)
+      else { return nil }
+      return FixMarker(point: point, accuracyRadius: sample.accuracyMeters.map { $0 / width })
+    }
+    let scaleMeters = [200_000, 100_000, 50_000, 20_000, 10_000, 5_000]
+      .first { $0 <= widthMeters / 4 } ?? 5_000
+    return SiteMapScene(
+      center: center, site: site.map { _ in centerPoint }, fix: fixMarker,
+      scale: Scale(meters: scaleMeters, fractionOfWidth: Double(scaleMeters) / width),
+      segments: segments)
+  }
