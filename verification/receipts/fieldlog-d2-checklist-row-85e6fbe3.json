      "replayPackage": "// swift-tools-version: 6.2\nimport PackageDescription\nlet package = Package(\n  name: \"FieldLogChecklistHost\",\n  platforms: [.macOS(.v14)],\n  dependencies: [\n    .package(path: \"../fieldlog\"),\n    .package(path: \"../mixer/sdk\"),\n    .package(path: \"../mixer/capability-activation\"),\n  ],\n  targets: [\n    .executableTarget(name: \"Replay\", dependencies: [\n      .product(name: \"FieldLogModels\", package: \"fieldlog\"),\n      .product(name: \"FieldLogStorage\", package: \"fieldlog\"),\n      .product(name: \"FieldLogEntrySaving\", package: \"fieldlog\"),\n      .product(name: \"MixerCapabilities\", package: \"sdk\"),\n      .product(name: \"MixerCapabilityActivation\", package: \"capability-activation\"),\n    ])\n  ]\n)\n",
      "replaySource": "import FieldLogModels\nimport FieldLogStorage\nimport Foundation\n\n@main struct Replay {\n  @MainActor static func main() async throws {\n    let root = URL(fileURLWithPath: CommandLine.arguments[1], isDirectory: true)\n    for count in [3, 22] {\n      try await exercise(directory: root.appendingPathComponent(String(count)), count: count)\n    }\n  }\n\n  @MainActor static func exercise(directory: URL, count: Int) async throws {\n    let repo = try WorkspaceRepository(directory: directory)\n    let baseline = try await repo.transact { workspace in\n      let project = try workspace.createProject(title: \"Checklist\", site: \"\")\n      let other = try workspace.createProject(title: \"Other\", site: \"\")\n      for n in 1...count { try workspace.saveTask(projectID: project, title: \"Task \\(n)\", responsible: \"日本語\") }\n      try workspace.saveTask(projectID: other, title: \"Other task\", responsible: \"\")\n    }\n    let project = baseline.projects[0].id\n    let tasks = baseline.tasks(for: project)\n    let ids = tasks.map(\\.id)\n    let position = count == 22 ? 19 : 0\n    let activeID = ids[position]\n    let model = WorkspaceModel(repository: repo)\n    await model.open()\n    require(model.workspace == baseline, \"open initial workspace\")\n    model.toggleTask(activeID)\n    await model.flush()\n    require(model.workspace?.tasks(for: project).filter(\\.completed).map(\\.id) == [activeID], \"complete exact task\")\n\n    let file = directory.appendingPathComponent(\"workspace.json\")\n    let before = try Data(contentsOf: file)\n    model.moveTask(ids[0], offset: -1)\n    await model.flush()\n    require(model.saveError != nil, \"reject first move up\")\n    model.moveTask(ids[count - 1], offset: 1)\n    await model.flush()\n    require(model.saveError != nil, \"reject last move down\")\n    model.toggleTask(UUID())\n    await model.flush()\n    require(model.saveError != nil, \"reject stale task identity\")\n    model.reorder(projectID: project, ids: Array(ids.dropLast()))\n    await model.flush()\n    require(model.saveError != nil, \"reject stale order roster\")\n    require(try Data(contentsOf: file) == before, \"reject without changes to disk\")\n\n    model.moveTask(activeID, offset: 1)\n    await model.flush()\n    var moved = ids\n    moved.swapAt(position, position + 1)\n    require(model.workspace?.tasks(for: project).map(\\.id) == moved, \"move exact task\")\n    model.reorder(projectID: project, ids: ids)\n    await model.flush()\n    guard let committed = model.workspace else { fatalError(\"missing committed workspace\") }\n    require(committed.tasks(for: project).map(\\.id) == ids, \"restore full order through the drag reorder handler\")\n    require(committed.tasks(for: project).filter(\\.completed).map(\\.id) == [activeID], \"completion survives reorder\")\n    require(committed.tasks.filter { $0.projectID != project } == baseline.tasks.filter { $0.projectID != project }, \"other project\")\n    let changes = Array(committed.outbox.dropFirst(baseline.outbox.count))\n    require(changes.map(\\.kind) == [.taskSaved, .taskOrderChanged, .taskOrderChanged], \"exact durable changes\")\n    require(changes.map(\\.recordID) == [activeID, project, project], \"exact durable identities\")\n    require(committed.revision == baseline.revision + 3, \"exact durable revision\")\n    let bytes = try Data(contentsOf: file)\n    require(try await repo.readCommittedSnapshot() == committed, \"model matches disk before close\")\n    await repo.close()\n    let reopened = try WorkspaceRepository(directory: directory)\n    let consumer = WorkspaceModel(repository: reopened)\n    await consumer.open()\n    require(consumer.workspace == committed, \"cold model full snapshot\")\n    require(try Data(contentsOf: file) == bytes, \"cold full byte readback\")\n    await reopened.close()\n    print(\"WorkspaceModel PASS \\(count) tasks. Completion, order, rejections and cold bytes verified.\")\n  }\n\n  static func require(_ condition: Bool, _ detail: String) {\n    if !condition { fatalError(detail) }\n  }\n}\n"
    }
