diff --git a/Integrations/GeneratedReport/Sources/FieldLogStorage/EntrySyncClient.swift b/Integrations/GeneratedReport/Sources/FieldLogStorage/EntrySyncClient.swift
new file mode 100644
index 0000000000000000000000000000000000000000..4d0923a0b7c32d9e16aeefee772bf8c5c5e1427c
--- /dev/null
+++ b/Integrations/GeneratedReport/Sources/FieldLogStorage/EntrySyncClient.swift
@@ -0,0 +1,388 @@
+#if canImport(CryptoKit)
+  import CryptoKit
+#else
+  import Crypto
+#endif
+import FieldLogModels
+import Foundation
+
+#if canImport(FoundationNetworking)
+  import FoundationNetworking
+#endif
+
+/// Development transport for a provisioned loopback FieldLog backend. The caller
+/// owns the session token and explicitly selects the workspace, project and event.
+public struct EntrySyncClient: Sendable {
+  public enum Outcome: Equatable, Sendable {
+    case uploaded
+    case reconciled
+  }
+
+  /// Bytes acknowledged by the backend for this send's selected JPEG.
+  public struct PhotoProgress: Equatable, Sendable {
+    public let acceptedBytes: Int
+    public let totalBytes: Int
+  }
+
+  public enum Failure: Error, LocalizedError, Equatable {
+    case invalidConfiguration
+    case wrongScope
+    case requiresOnePhoto
+    case rejected(Int)
+    case invalidProgress
+    case invalidReceipt
+
+    public var errorDescription: String? {
+      switch self {
+      case .invalidConfiguration: "A local backend port and session token are required."
+      case .wrongScope: "This change belongs to a different workspace or project."
+      case .requiresOnePhoto: "This sync endpoint accepts entries with exactly one JPEG."
+      case .rejected(let status): "The server rejected the change (HTTP \(status))."
+      case .invalidProgress: "The backend did not confirm the saved photo prefix."
+      case .invalidReceipt: "The backend did not confirm this entry and photo."
+      }
+    }
+  }
+
+  private let port: UInt16
+  private let workspaceID: UUID
+  private let projectID: UUID
+  private let token: String
+  private static let chunkBytes = 32_768
+
+  public init(port: UInt16, workspaceID: UUID, projectID: UUID, token: String) throws {
+    guard port > 0, (32...128).contains(token.utf8.count),
+      token.utf8.allSatisfy({
+        (48...57).contains($0) || (65...90).contains($0) || (97...122).contains($0)
+          || $0 == 45 || $0 == 95
+      })
+    else { throw Failure.invalidConfiguration }
+
+    self.port = port
+    self.workspaceID = workspaceID
+    self.projectID = projectID
+    self.token = token
+  }
+
+  @discardableResult public func send(
+    eventID: UUID, from repository: WorkspaceRepository
+  ) async throws -> Outcome {
+    try await send(eventID: eventID, from: repository, onProgress: { _ in })
+  }
+
+  /// Cancelling before local acknowledgment stops the send and leaves the event pending.
+  /// A later send of the same event verifies the server's durable prefix and resumes.
+  @discardableResult public func send(
+    eventID: UUID, from repository: WorkspaceRepository,
+    onProgress: @Sendable (PhotoProgress) async -> Void
+  ) async throws -> Outcome {
+    try Task.checkCancellation()
+    let payload = try await repository.prepareEntryUpload(
+      workspaceID: workspaceID, projectID: projectID, eventID: eventID)
+    let workspace = workspaceID.uuidString.lowercased()
+    let project = projectID.uuidString.lowercased()
+    let url = URL(
+      string: "http://127.0.0.1:\(port)/v1/workspaces/\(workspace)/projects/\(project)/entries/\(payload.event.idempotencyKey)"
+    )!
+    let configuration = URLSessionConfiguration.ephemeral
+    configuration.urlCredentialStorage = nil
+    configuration.httpCookieStorage = nil
+    configuration.httpShouldSetCookies = false
+    configuration.urlCache = nil
+    configuration.connectionProxyDictionary = [
+      "HTTPEnable": false, "HTTPSEnable": false, "ProxyAutoConfigEnable": false,
+      "ProxyAutoDiscoveryEnable": false, "SOCKSEnable": false,
+    ]
+    configuration.timeoutIntervalForRequest = 5
+    configuration.timeoutIntervalForResource = 15
+    #if os(Android)
+      // FoundationNetworking uses libcurl. An inherited proxy can override the
+      // session dictionary, so fail closed before constructing a bearer request.
+      guard !ProcessInfo.processInfo.environment.keys.contains(where: {
+        ["http_proxy", "https_proxy", "all_proxy"].contains($0.lowercased())
+      }) else { throw Failure.invalidConfiguration }
+    #endif
+
+    let expected = EntryUploadReceipt(
+      eventID: eventID, workspaceID: workspaceID, projectID: projectID, entryID: payload.entry.id,
+      photoID: payload.photo.id)
+    let jpeg = payload.photo.jpeg
+    let chunkSHA256s = stride(from: 0, to: jpeg.count, by: Self.chunkBytes).map { start in
+      Self.hex(SHA256.hash(data: jpeg[start..<min(start + Self.chunkBytes, jpeg.count)]))
+    }
+    let manifest = EntryUploadManifest(
+      event: payload.event, entry: payload.entry,
+      photo: .init(
+        id: payload.photo.id, byteCount: jpeg.count, sha256: Self.hex(SHA256.hash(data: jpeg)),
+        chunkSHA256s: chunkSHA256s))
+    let photoURL = url.appendingPathComponent("photo")
+    let initial = try await post(manifest, to: photoURL, using: configuration, accepting: [200])
+    let initialProgress = try progress(in: initial.body, for: expected, photo: manifest.photo)
+    var offset = initialProgress.offset
+    guard offset == jpeg.count || offset.isMultiple(of: Self.chunkBytes) else {
+      throw Failure.invalidProgress
+    }
+    var prefix = SHA256()
+    prefix.update(data: jpeg.prefix(offset))
+    guard Self.hex(prefix.finalize()) == initialProgress.prefixSHA256 else {
+      throw Failure.invalidProgress
+    }
+    await onProgress(.init(acceptedBytes: offset, totalBytes: jpeg.count))
+
+    let chunksURL = photoURL.appendingPathComponent("chunks")
+    while offset < jpeg.count {
+      try Task.checkCancellation()
+      let nextOffset = min(offset + Self.chunkBytes, jpeg.count)
+      let bytes = jpeg[offset..<nextOffset]
+      let chunk = PhotoChunk(
+        photoID: manifest.photo.id, sha256: manifest.photo.sha256, offset: offset,
+        chunk: bytes, chunkSHA256: chunkSHA256s[offset / Self.chunkBytes])
+      let response = try await post(chunk, to: chunksURL, using: configuration, accepting: [200])
+      let accepted = try progress(in: response.body, for: expected, photo: manifest.photo)
+      prefix.update(data: bytes)
+      guard accepted.offset == nextOffset, accepted.prefixSHA256 == Self.hex(prefix.finalize()) else {
+        throw Failure.invalidProgress
+      }
+      offset = nextOffset
+      await onProgress(.init(acceptedBytes: offset, totalBytes: jpeg.count))
+    }
+
+    let final = try await post(
+      manifest, to: url, using: configuration, accepting: [200, 201], invalidResponse: .invalidReceipt)
+    guard (try? JSONDecoder().decode(EntryUploadReceipt.self, from: final.body)) == expected else {
+      throw Failure.invalidReceipt
+    }
+    try await repository.acknowledgeEntryUpload(payload, workspaceID: workspaceID)
+    return final.status == 201 ? .uploaded : .reconciled
+  }
+
+  private func post(
+    _ payload: some Encodable, to url: URL, using configuration: URLSessionConfiguration, accepting statuses: [Int],
+    invalidResponse: Failure = .invalidProgress
+  ) async throws -> (status: Int, body: Data) {
+    try Task.checkCancellation()
+    let encoder = JSONEncoder()
+    encoder.outputFormatting = [.sortedKeys, .withoutEscapingSlashes]
+    var request = URLRequest(url: url)
+    request.httpMethod = "POST"
+    request.setValue("Bearer \(token)", forHTTPHeaderField: "Authorization")
+    request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+    request.setValue("identity", forHTTPHeaderField: "Accept-Encoding")
+    request.httpBody = try encoder.encode(payload)
+
+    let delegate = LoopbackResponse(accepting: statuses, invalidResponse: invalidResponse)
+    let session = URLSession(configuration: configuration, delegate: delegate, delegateQueue: nil)
+    defer { session.finishTasksAndInvalidate() }
+    do {
+      let response = try await withTaskCancellationHandler {
+        try await withCheckedThrowingContinuation { continuation in
+          delegate.start(request, in: session, returningTo: continuation)
+        }
+      } onCancel: {
+        delegate.cancel()
+      }
+      try Task.checkCancellation()
+      return response
+    } catch {
+      try Task.checkCancellation()
+      throw error
+    }
+  }
+
+  private func progress(
+    in body: Data, for expected: EntryUploadReceipt, photo: EntryUploadManifest.Photo
+  ) throws -> PhotoUploadReceipt {
+    guard (try? JSONDecoder().decode(EntryUploadReceipt.self, from: body)) == expected,
+      let progress = try? JSONDecoder().decode(PhotoUploadReceipt.self, from: body),
+      progress.byteCount == photo.byteCount, progress.sha256 == photo.sha256,
+      (0...photo.byteCount).contains(progress.offset)
+    else { throw Failure.invalidProgress }
+    return progress
+  }
+
+  private static func hex(_ digest: SHA256.Digest) -> String {
+    digest.map { String(format: "%02x", $0) }.joined()
+  }
+}
+
+struct EntryUpload: Sendable {
+  struct Photo: Sendable {
+    let id: UUID
+    let jpeg: Data
+  }
+
+  let event: PendingChange
+  let entry: LogEntry
+  let photo: Photo
+}
+
+private struct EntryUploadManifest: Encodable {
+  struct Photo: Encodable {
+    let id: UUID
+    let byteCount: Int
+    let sha256: String
+    let chunkSHA256s: [String]
+  }
+
+  let event: PendingChange
+  let entry: LogEntry
+  let photo: Photo
+}
+
+private struct PhotoChunk: Encodable {
+  let photoID: UUID
+  let sha256: String
+  let offset: Int
+  let chunk: Data
+  let chunkSHA256: String
+}
+
+private struct PhotoUploadReceipt: Decodable {
+  let byteCount: Int
+  let sha256: String
+  let offset: Int
+  let prefixSHA256: String
+}
+
+private struct EntryUploadReceipt: Decodable, Equatable {
+  let eventID: UUID
+  let workspaceID: UUID
+  let projectID: UUID
+  let entryID: UUID
+  let photoID: UUID
+}
+
+// URLSession.bytes(for:) is unavailable in the Android Swift SDK. Keep the
+// same bounded response read using a serial URLSession delegate on both hosts.
+private final class LoopbackResponse: NSObject, URLSessionDataDelegate, @unchecked Sendable {
+  private static let limit = 2048
+  private let accepting: [Int]
+  private let invalidResponse: EntrySyncClient.Failure
+  private let lock = NSLock()
+  private var task: URLSessionDataTask?
+  private var continuation: CheckedContinuation<(Int, Data), Error>?
+  private var cancelled = false
+
+  // Only the session's serial delegate queue touches the response.
+  private var response: HTTPURLResponse?
+  private var body = Data()
+  private var failure: EntrySyncClient.Failure?
+
+  init(accepting: [Int], invalidResponse: EntrySyncClient.Failure) {
+    self.accepting = accepting
+    self.invalidResponse = invalidResponse
+  }
+
+  func start(_ request: URLRequest, in session: URLSession,
+    returningTo continuation: CheckedContinuation<(Int, Data), Error>) {
+    let started = lock.withLock {
+      guard !cancelled else { return false }
+      let task = session.dataTask(with: request)
+      self.task = task
+      self.continuation = continuation
+      task.resume()
+      return true
+    }
+    if !started { continuation.resume(throwing: CancellationError()) }
+  }
+
+  func cancel() {
+    let task = lock.withLock {
+      cancelled = true
+      return self.task
+    }
+    task?.cancel()
+  }
+
+  func urlSession(
+    _ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse,
+    newRequest request: URLRequest, completionHandler: @escaping @Sendable (URLRequest?) -> Void
+  ) {
+    completionHandler(nil)
+  }
+
+  func urlSession(
+    _ session: URLSession, dataTask: URLSessionDataTask, didReceive response: URLResponse,
+    completionHandler: @escaping @Sendable (URLSession.ResponseDisposition) -> Void
+  ) {
+    guard let http = response as? HTTPURLResponse, http.expectedContentLength <= Self.limit else {
+      failure = invalidResponse
+      completionHandler(.cancel)
+      return
+    }
+    guard accepting.contains(http.statusCode) else {
+      failure = .rejected(http.statusCode)
+      completionHandler(.cancel)
+      return
+    }
+    self.response = http
+    completionHandler(.allow)
+  }
+
+  func urlSession(_ session: URLSession, dataTask: URLSessionDataTask, didReceive data: Data) {
+    guard data.count <= Self.limit - body.count else {
+      failure = invalidResponse
+      dataTask.cancel()
+      return
+    }
+    body.append(data)
+  }
+
+  func urlSession(_ session: URLSession, task: URLSessionTask, didCompleteWithError error: (any Error)?) {
+    let continuation = lock.withLock {
+      self.task = nil
+      let continuation = self.continuation
+      self.continuation = nil
+      return continuation
+    }
+    if let failure {
+      continuation?.resume(throwing: failure)
+    } else if let error {
+      continuation?.resume(throwing: error)
+    } else if let response,
+      response.expectedContentLength < 0 || response.expectedContentLength == Int64(body.count) {
+      continuation?.resume(returning: (response.statusCode, body))
+    } else {
+      continuation?.resume(throwing: URLError(.networkConnectionLost))
+    }
+  }
+}
+
+extension WorkspaceRepository {
+  func prepareEntryUpload(workspaceID: UUID, projectID: UUID, eventID: UUID) throws -> EntryUpload {
+    let workspace = try readCommittedSnapshot()
+    guard workspace.id == workspaceID,
+      (workspace.restoration.selectedProjectID ?? workspace.projects.first?.id) == projectID
+    else { throw EntrySyncClient.Failure.wrongScope }
+    guard let event = workspace.outbox.first(where: { $0.id == eventID && $0.kind == .entrySaved }),
+      let entry = workspace.entries.first(where: { $0.id == event.recordID })
+    else { throw FieldLogError.missingRecord }
+    guard entry.projectID == projectID else { throw EntrySyncClient.Failure.wrongScope }
+    guard entry.attachmentIDs.count == 1, let photoID = entry.attachmentIDs.first else {
+      throw EntrySyncClient.Failure.requiresOnePhoto
+    }
+    guard let attachment = workspace.attachments.first(where: { $0.id == photoID }) else {
+      throw FieldLogError.missingRecord
+    }
+    let jpeg = try Data(contentsOf: photoURL(photoID))
+    guard jpeg.count == attachment.byteCount, jpeg.starts(with: [0xff, 0xd8, 0xff]) else {
+      throw FieldLogError.storage("This photo is damaged. Its record has been preserved.")
+    }
+    return EntryUpload(event: event, entry: entry, photo: .init(id: photoID, jpeg: jpeg))
+  }
+
+  func acknowledgeEntryUpload(_ upload: EntryUpload, workspaceID: UUID) throws {
+    try Task.checkCancellation()
+    let workspace = try readCommittedSnapshot()
+    guard workspace.id == workspaceID else { throw EntrySyncClient.Failure.wrongScope }
+    // A concurrent retry can already have retired this exact event.
+    guard let pending = workspace.outbox.first(where: { $0.id == upload.event.id }) else { return }
+    guard pending == upload.event, workspace.entries.contains(upload.entry) else {
+      throw FieldLogError.staleRevision
+    }
+    try transact(expectedRevision: workspace.revision) { next in
+      try Task.checkCancellation()
+      next.outbox.removeAll { $0.id == upload.event.id }
+    }
+  }
+}
