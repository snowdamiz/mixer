diff --git a/Integrations/GeneratedReport/scripts/pair25/manifest.py b/Integrations/GeneratedReport/scripts/pair25/manifest.py
new file mode 100644
index 0000000000000000000000000000000000000000..1209d4bbe192c94e58b324d917c911b56a9bc19d
--- /dev/null
+++ b/Integrations/GeneratedReport/scripts/pair25/manifest.py
@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+"""Apply the signed FieldLog fixture's loopback-only Android network policy."""
+from pathlib import Path
+import sys
+import xml.etree.ElementTree as ET
+
+ANDROID = "http://schemas.android.com/apk/res/android"
+ET.register_namespace("android", ANDROID)
+
+
+def transform(source, destination):
+    manifest = ET.parse(source)
+    root = manifest.getroot()
+    applications = root.findall("application")
+    policy = f"{{{ANDROID}}}networkSecurityConfig"
+    cleartext = f"{{{ANDROID}}}usesCleartextTraffic"
+    internet = {f"{{{ANDROID}}}name": "android.permission.INTERNET"}
+    permissions = [
+        child for child in root
+        if child.tag.rsplit("}", 1)[-1].startswith(("uses-permission", "permission"))
+    ]
+    if (root.tag != "manifest" or len(applications) != 1
+            or any(key in applications[0].attrib for key in (policy, cleartext))
+            or len(permissions) > 1
+            or any(node.tag != "uses-permission" or node.attrib != internet
+                   or list(node) or (node.text or "").strip() for node in permissions)):
+        raise ValueError("Unexpected ordinary Android manifest")
+
+    application = applications[0]
+    if not permissions:
+        root.insert(list(root).index(application), ET.Element("uses-permission", internet))
+    application.set(policy, "@xml/checklist_network")
+    application.set(f"{{{ANDROID}}}label", "FieldLog")
+    with destination.open("xb") as stream:
+        ET.indent(manifest, space="  ")
+        manifest.write(stream, encoding="utf-8", xml_declaration=True)
+
+
+if __name__ == "__main__":
+    try:
+        transform(*map(Path, sys.argv[1:]))
+    except ValueError as error:
+        sys.exit(str(error))
