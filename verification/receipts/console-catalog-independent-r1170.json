  "finding": {
    "id": "R1170-P2-1",
    "priority": "P2",
    "title": "Applications query reads inherited applicationId despite closed scope capture",
    "file": "console/src/api/cookie-build-catalog-client.ts",
    "line": 15,
    "afterimage_sha256": "b953bbc31b839e70e6023e7c4ecd488e50083d0478ae9ba0ece6d8083a38f51d",
    "precondition": "Object.prototype has a configurable applicationId data property; the caller still supplies a valid own-key project selection.",
    "reproduction": "The fresh payload defines Object.prototype.applicationId = Inherited-App, calls applications({organizationId:Org, projectId:Proj}, {}), captures the actual fixed-route fetch URL, then restores the prototype in finally.",
    "expected": "/console-api/v1/applications?organization_id=Org&project_id=Proj",
    "actual": "/console-api/v1/applications?organization_id=Org&project_id=Proj&application_id=Inherited-App",
    "cause": "The in operator searches Object.prototype on the newly frozen scope object. Freezing the scope does not remove its shared prototype.",
    "impact": "Inherited state changes an otherwise valid applications request by injecting an undeclared application_id query field, violating the exact-route and no-prototype-influence contract. Backend rejection or authorization impact was not tested.",
    "recommendation": "Choose the applications/builds query fields explicitly or use an own-property check rather than the in operator. Apply the same own-property discipline to the optional cursor read at line 16; that second path is source-only and was not exercised in this bounded payload.",
    "raw_stdout": "logs/00002-independent-adversarial-node.stdout",
    "raw_stderr": "logs/00002-independent-adversarial-node.stderr",
    "payload_line": 61
  },
