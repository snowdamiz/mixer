import Foundation
import MixerUI

public struct AndroidFileIdentity: Codable, Equatable, Sendable {
    public var path: String
    public var sha256: String
}
public struct AndroidToolchainIdentity: Codable, Equatable, Sendable {
    public var schema: Int
    public var sdk_id: String
    public var abi: String
    public var min_api: Int
    public var target_api: Int
    public var swift_version: String
    public var javac_version: String
    public var java_version: String
    public var python_version: String
    public var tools: [String: AndroidFileIdentity]
    public var metadata: [String: AndroidFileIdentity]
    public var distributions: [String: AndroidFileIdentity]
    public var sdk_search_path: String
}
public struct AndroidToolchainLock: Codable, Sendable {
    public var adapterDigest: String
    public var toolchain: AndroidToolchainIdentity
}

public enum AndroidProject {
    /// Export an explicit owned source closure. The checklist engine and its
    /// instrumentation never enter a created application's dependency graph.
    static func snapshot(adapter: URL, destination: URL) throws -> String {
        let adapter = adapter.resolvingSymlinksInPath().standardizedFileURL
        let expected = [
            "bridge/jni.c", "bridge/mixer_android.h", "bridge/mixer_android_v2.h", "contracts/android-profile-v1.json",
            "app/src/dev/mixer/android/Json.java", "app/src/dev/mixer/android/UiPacket.java",
            "app/src/dev/mixer/android/NativeRenderer.java", "app/src/dev/mixer/android/NativeBridge.java",
            "app/src/dev/mixer/android/MixerActivity.java",
            // Private coordinator source is available for compilation; the
            // public Activity continues to use the V1 exchange/bootstrap.
            "app/src/dev/mixer/android/NativeCoordinatorV2.java",
            // Compile dependencies of the internal renderer. Including them does
            // not opt generated applications into V2.
            "app/src/dev/mixer/android/AppearanceDescriptorV2.java",
            "app/src/dev/mixer/android/AppearanceGeometryV2.java",
            "app/src/dev/mixer/android/AppearanceResolverV2.java",
            "app/src/dev/mixer/android/AppearanceNativePathsV2.java",
            "app/src/dev/mixer/android/InstalledAppearanceV2.java",
            "app/src/dev/mixer/android/NativeEnvironmentV2.java",
            "app/src/dev/mixer/android/AuthoredToggleInputV2.java",
            "app/src/dev/mixer/android/NativeAppearanceViewsV2.java"
        ]
        let runtime = adapter.appendingPathComponent("engine/Sources/MixerAndroidRuntime")
        let runtimeFiles = try SourceDigest.files(in: runtime)
        guard !runtimeFiles.isEmpty, runtimeFiles.allSatisfy({ $0.pathExtension == "swift" }) else {
            throw MixerFailure("create.android-adapter", "Owned reusable Android runtime sources are missing or unsupported.")
        }
        var mapping = expected.map { ($0, $0) }
        mapping += runtimeFiles.map {
            let relative = String($0.path.dropFirst(runtime.path.count + 1))
            return ("engine/Sources/MixerAndroidRuntime/" + relative, "Sources/MixerAndroidRuntime/" + relative)
        }
        for (sourcePath, targetPath) in mapping {
            let source = adapter.appendingPathComponent(sourcePath)
            let info = try source.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey])
            guard info.isRegularFile == true, info.isSymbolicLink != true else { throw MixerFailure("create.android-adapter", "Android adapter inputs must be regular source files: \(sourcePath)") }
            let target = destination.appendingPathComponent(targetPath)
            try FileManager.default.createDirectory(at: target.deletingLastPathComponent(), withIntermediateDirectories: true)
            try Data(contentsOf: source).write(to: target)
        }
        try runtimePackage.write(to: destination.appendingPathComponent("Package.swift"), atomically: true, encoding: .utf8)
        let driver = try buildDriver()
        try Data(contentsOf: driver).write(to: destination.appendingPathComponent("android-build.py"))
        let appearance = try defaultAppearanceData()
        let descriptor = destination.appendingPathComponent("app/assets/MixerAppearanceV2/descriptor.json")
        try FileManager.default.createDirectory(at: descriptor.deletingLastPathComponent(), withIntermediateDirectories: true)
        try appearance.write(to: descriptor)
        return try SourceDigest.tree(destination)
    }

    /// CLI-linked default data only. The separately selected SDK's default/API/ABI
    /// compatibility is pending; this does not enable the public V2 Activity.
    static func defaultAppearanceData() throws -> Data {
        let value = try UIAppearanceDescriptorCodecV2.mixerDefaultV2()
        let bytes = try UIAppearanceDescriptorCodecV2.canonicalData(value)
        let checked = try UIAppearanceDescriptorCodecV2.decode(bytes)
        guard checked == value, checked.resources.isEmpty,
              case let .shared(theme) = checked.mode,
              theme.typography.font == .systemSans else {
            throw MixerFailure("create.android-appearance", "The CLI default must be a canonical shared appearance with no resources and system sans typography.")
        }
        return bytes
    }

    static func buildDriver() throws -> URL {
        guard let resource = Bundle.module.url(forResource: "android-build", withExtension: "py", subdirectory: "Resources") else { throw MixerFailure("android.driver", "Installed CLI is missing its owned Android build driver.") }
        return resource
    }
    static func inspectToolchain() throws -> AndroidToolchainIdentity {
        let result = try ProcessRunner.run(["python3", try buildDriver().path, "inspect"])
        guard result.succeeded, !result.outputTruncated else { throw MixerFailure("android.toolchain", result.output) }
        do { return try JSONDecoder().decode(AndroidToolchainIdentity.self, from: Data(result.output.utf8)) }
        catch { throw MixerFailure("android.toolchain", "Android tool inventory was not a complete structured identity: \(error)") }
    }
    static func generate(root: URL) throws {
        let config = try ApplicationConfiguration.load(root)
        let directory = root.appendingPathComponent("Platforms/Android")
        let files = ["Package.swift": package(config.name), "AndroidManifest.xml": manifest(config),
                     "Sources/AppAndroid/NativeEntry.swift": entry,
                     "Tests/AppAndroidTests/SessionTests.swift": sessionTests,
                     "README.md": readme]
        for (path, source) in files {
            let target = directory.appendingPathComponent(path)
            guard !FileManager.default.fileExists(atPath: target.path) else { throw MixerFailure("generate.modified", "Refusing to overwrite Android app-owned file: \(target.path)") }
            try FileManager.default.createDirectory(at: target.deletingLastPathComponent(), withIntermediateDirectories: true)
            try source.write(to: target, atomically: true, encoding: .utf8)
        }
    }
    public static func build(root: URL) throws -> CommandResult {
        let lock = try ProjectBuild.verifyLock(root: root)
        guard lock.android != nil else { throw MixerFailure("android.not-generated", "This project has no locked Android host. Create a new project with --platform android; existing sources are never overwritten.") }
        let config = try ApplicationConfiguration.load(root)
        guard config.targets.contains("android"), config.capabilities.isEmpty else { throw MixerFailure("android.unsupported-capability", "Android local consumer requires an android target and no declared native capabilities; capability hosts are not integrated in this slice.") }
        guard try SourceDigest.files(in: root.appendingPathComponent("Resources")).isEmpty else { throw MixerFailure("android.unsupported-resources", "Android resource packaging is not integrated. App resources cannot be silently omitted.") }
        return try ProcessRunner.run(["python3", root.appendingPathComponent("Generated/MixerAndroid/android-build.py").path, "build", root.path], at: root)
    }

    private static let runtimePackage = """
    // swift-tools-version: 6.0
    import PackageDescription
    let package = Package(name: "MixerAndroid", platforms: [.macOS(.v14)],
        products: [.library(name: "MixerAndroidRuntime", targets: ["MixerAndroidRuntime"])],
        dependencies: [.package(path: "../MixerSDK")],
        targets: [.target(name: "MixerAndroidRuntime", dependencies: [
            .product(name: "MixerCore", package: "MixerSDK"), .product(name: "MixerUI", package: "MixerSDK")])],
        swiftLanguageModes: [.v6])
    """ + "\n"

    private static func package(_ name: String) -> String {
        """
        // swift-tools-version: 6.0
        import PackageDescription
        let package = Package(name: "\(name)Android", platforms: [.macOS(.v14)],
            products: [.library(name: "AppAndroid", type: .dynamic, targets: ["AppAndroid"])],
            dependencies: [.package(name: "Application", path: "../.."), .package(path: "../../Generated/MixerAndroid"), .package(path: "../../Generated/MixerSDK")],
            targets: [
                .target(name: "AppAndroid", dependencies: [.product(name: "AppFeatures", package: "Application"), .product(name: "MixerAndroidRuntime", package: "MixerAndroid")]),
                .testTarget(name: "AppAndroidTests", dependencies: ["AppAndroid", .product(name: "MixerUI", package: "MixerSDK")])
            ], swiftLanguageModes: [.v6])
        """ + "\n"
    }
    private static func manifest(_ config: ApplicationConfiguration) -> String {
        """
        <manifest xmlns:android="http://schemas.android.com/apk/res/android" package="\(config.application)" android:versionCode="1" android:versionName="0.1.0">
          <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="37" />
          <application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="\(config.name)" android:debuggable="true" android:allowBackup="false" android:extractNativeLibs="true" android:supportsRtl="true">
            <activity android:name="dev.mixer.android.MixerActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
              <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            </activity>
          </application>
        </manifest>
        """ + "\n"
    }
    private static let entry = """
    import AppFeatures
    @_spi(MixerNativeAppearanceV2) import MixerAndroidRuntime
    // App-owned native entry point; state, document and reducer live in shared Swift.
    // State must remain a value type; callbacks are synchronous, non-reentrant and
    // free of I/O/async/shared mutable references. Sendable alone is insufficient.
    private let sessions = AndroidSessionRegistry {
        try AndroidDocumentSession(state: ProjectFeatureState(),
            document: { ProjectFeature.document(state: $0, revision: $1) },
            reduce: { try ProjectFeature.handle($1, state: &$0) })
    }
    @_cdecl("mixer_android_create")
    public func mixerAndroidCreate() -> UInt64 { sessions.create() }
    @_cdecl("mixer_android_destroy")
    public func mixerAndroidDestroy(_ handle: UInt64) -> Int32 { sessions.destroy(handle) }
    @_cdecl("mixer_android_exchange")
    public func mixerAndroidExchange(_ handle: UInt64, _ operation: UInt32,
        _ input: UnsafePointer<UInt8>?, _ inputLength: Int,
        _ output: UnsafeMutablePointer<UInt8>?, _ capacity: Int, _ written: UnsafeMutablePointer<Int>?
    ) -> Int32 { sessions.exchange(handle, operation, input, inputLength, output, capacity, written) }
    // Private ordinary-native staging. This does not opt the Activity into V2.
    @_spi(MixerNativeAppearanceV2)
    @_cdecl("mixer_android_prepare_v2")
    public func mixerAndroidPrepareV2(_ handle: UInt64, _ operation: UInt32,
        _ input: UnsafePointer<UInt8>?, _ inputLength: Int,
        _ output: UnsafeMutablePointer<UInt8>?, _ capacity: Int,
        _ written: UnsafeMutablePointer<Int>?, _ token: UnsafeMutablePointer<UInt64>?
    ) -> Int32 { sessions.prepareV2(handle, operation, input, inputLength, output, capacity, written, token) }
    @_spi(MixerNativeAppearanceV2)
    @_cdecl("mixer_android_commit_v2")
    public func mixerAndroidCommitV2(_ handle: UInt64, _ token: UInt64) -> Int32 { sessions.commitV2(handle, token) }
    @_spi(MixerNativeAppearanceV2)
    @_cdecl("mixer_android_abort_v2")
    public func mixerAndroidAbortV2(_ handle: UInt64, _ token: UInt64) -> Int32 { sessions.abortV2(handle, token) }
    """ + "\n"
    private static let readme = """
    # Android local development host

    `mixer build --platform android` compiles the original shared AppModels/AppFeatures
    package, app-owned Sources/AppAndroid entry, and locked owned runtime/Java/JNI.
    Output is `.mixer/android-build/*-unsigned.apk`, with a complete build receipt.
    The APK is unsigned and has not been installed or qualified on a device.
    `swift test --package-path Platforms/Android` exercises this exact app's exported
    session ABI on the host. Mac tests do not establish Android UI behavior.

    This host uses Android native widgets with the unchanged android-profile-v1
    subset. Shared ProjectFeatureState owns draft/add/toggle; the iOS starter uses
    the compatible read-only document(entries:) surface. State is process-local.
    There is no persistence, process restoration, navigation/back/sheets, native
    capabilities, lifecycle/effects, resource copying, production signing, store,
    accessibility or performance qualification. Unsupported UI/events fail closed.
    The generated JNI closure includes private staged prepare/commit/abort exports;
    the Activity still uses legacy exchange and does not opt into V2 rendering.
    Runtime state must preserve value semantics without shared mutable references.
    Callbacks run synchronously under a non-reentrant lock; they must not perform
    I/O, asynchronous work or external side effects. Sendable alone cannot ensure
    rollback for arbitrary reference state or effects.
    App-owned manifest/package/entry/Java files are compiled as edited; builds never
    regenerate them. Put optional Android Java extensions under Java/. Bundled
    Generated/MixerAndroid and Generated/MixerSDK inputs are immutable source locks.

    Supported installed tools: official Swift6.3.3 Android SDK arm64/API28, NDKr27d,
    Android platform37.0/build-tools37.0.0, JDK25 (Java bytecode17), Python3. Tool
    paths and complete distribution hashes are locked during creation. Configure
    MIXER_SWIFT, MIXER_SWIFT_SDKS_PATH, MIXER_ANDROID_ARTIFACT_PATH, MIXER_JDK and
    ANDROID_HOME before creation; builds require those exact distributions.
    No tools are downloaded. Published immutable SDK consumption is still pending.
    """ + "\n"
    private static let sessionTests = """
    import Foundation
    import Testing
    import MixerUI
    @_spi(MixerNativeAppearanceV2) @testable import AppAndroid
    @Suite(.serialized) struct ApplicationSessionTests {
        func exchange(_ handle: UInt64, _ input: Data? = nil, capacity: Int = 1_048_576) -> (Int32, Data) {
            var buffer = [UInt8](repeating: 0, count: capacity), written = 0
            let status = buffer.withUnsafeMutableBufferPointer { output in
                if let input { return input.withUnsafeBytes { bytes in
                    mixerAndroidExchange(handle, 1, bytes.bindMemory(to: UInt8.self).baseAddress, bytes.count, output.baseAddress, capacity, &written)
                } }
                return mixerAndroidExchange(handle, 0, nil, 0, output.baseAddress, capacity, &written)
            }
            return (status, Data(buffer.prefix(min(written, capacity))))
        }
        func event(_ packet: Data, id: String, kind: UIEventKind, value: UIValue) throws -> Data {
            let object = try #require(JSONSerialization.jsonObject(with: packet) as? [String: Any])
            let document = try UIDocument.decode(JSONSerialization.data(withJSONObject: object["document"]!))
            let identities = try JSONDecoder().decode([UINodeIdentity].self, from: JSONSerialization.data(withJSONObject: object["identities"]!))
            return try JSONEncoder().encode(UIEventEnvelope(revision: document.revision,
                identity: #require(identities.first { $0.id == id }), event: kind, value: value))
        }
        @Test func sharedDraftAddToggleAndRejectedTransactions() throws {
            let handle = mixerAndroidCreate(); #expect(handle != 0)
            defer { #expect(mixerAndroidDestroy(handle) == 0) }
            let initial = exchange(handle); #expect(initial.0 == 0)
            let edit = try event(initial.1, id: "draft", kind: .textChange, value: .string("Café 東京 🧪"))
            #expect(exchange(handle, edit, capacity: 1).0 == 3)
            #expect(exchange(handle).1 == initial.1)
            let draft = exchange(handle, edit); #expect(draft.0 == 0)
            #expect(exchange(handle, edit).0 == 4)
            let added = exchange(handle, try event(draft.1, id: "add", kind: .activate, value: .null))
            #expect(added.0 == 0)
            let object = try #require(JSONSerialization.jsonObject(with: added.1) as? [String: Any])
            let identities = try JSONDecoder().decode([UINodeIdentity].self, from: JSONSerialization.data(withJSONObject: object["identities"]!))
            let task = try #require(identities.first { $0.id.hasPrefix("entry.") })
            let toggled = exchange(handle, try event(added.1, id: task.id, kind: .valueChange, value: .bool(true)))
            #expect(toggled.0 == 0)
            #expect(String(decoding: toggled.1, as: UTF8.self).contains("1 of 1 completed"))
            for bad in [Data("{}".utf8), Data("{\\"event\\":null,\\"\\\\u0065vent\\":null}".utf8), Data(repeating: 32, count: 131_073)] {
                #expect(exchange(handle, bad).0 != 0)
                #expect(exchange(handle).1 == toggled.1)
            }
        }
        @Test func stagedDecisionsPreserveCommittedState() throws {
            let handle = mixerAndroidCreate(); #expect(handle != 0)
            defer { #expect(mixerAndroidDestroy(handle) == 0) }
            let initial = exchange(handle); #expect(initial.0 == 0)
            let edit = try event(initial.1, id: "draft", kind: .textChange, value: .string("Staged café 東京"))
            func prepare() -> (Int32, Data, UInt64) {
                var buffer = [UInt8](repeating: 0, count: 1_048_576), written = 0
                var token: UInt64 = 0
                let status = buffer.withUnsafeMutableBufferPointer { output in
                    edit.withUnsafeBytes { input in
                        mixerAndroidPrepareV2(handle, 1, input.bindMemory(to: UInt8.self).baseAddress,
                            input.count, output.baseAddress, output.count, &written, &token)
                    }
                }
                return (status, Data(buffer.prefix(min(written, buffer.count))), token)
            }
            let aborted = prepare(); #expect(aborted.0 == 0); #expect(aborted.2 != 0)
            #expect(exchange(handle).0 == 5)
            #expect(mixerAndroidAbortV2(handle, aborted.2) == 0)
            #expect(mixerAndroidAbortV2(handle, aborted.2) == 0)
            #expect(exchange(handle).1 == initial.1)
            let committed = prepare(); #expect(committed.0 == 0); #expect(committed.2 != aborted.2)
            #expect(mixerAndroidAbortV2(handle, aborted.2) == 0)
            #expect(exchange(handle).0 == 5)
            #expect(mixerAndroidCommitV2(handle, committed.2) == 0)
            #expect(mixerAndroidCommitV2(handle, committed.2) == 6)
            #expect(exchange(handle).1 == committed.1)
            #expect(String(decoding: committed.1, as: UTF8.self).contains("Staged café 東京"))
        }
        @Test func boundedHandlesAndDestruction() {
            let handles = (0..<16).map { _ in mixerAndroidCreate() }
            #expect(handles.allSatisfy { $0 != 0 }); #expect(Set(handles).count == 16)
            #expect(mixerAndroidCreate() == 0)
            for handle in handles { #expect(mixerAndroidDestroy(handle) == 0); #expect(mixerAndroidDestroy(handle) == 2) }
            #expect(exchange(handles[0]).0 == 2)
        }
    }
    """ + "\n"
}

2a05616a0b76a8d5f34035c496409456e351776b blob 7543
import Foundation
import CryptoKit
import MixerCore

public struct MixerFailure: Error, CustomStringConvertible, Sendable {
    public let code: String
    public let description: String
    public init(_ code: String, _ description: String) { self.code = code; self.description = description }
}

public struct ApplicationConfiguration: Codable, Equatable, Sendable {
    public var schema: Int = 1
    public var application: String
    public var name: String
    public var language: String = "swift"
    public var targets: [String] = ["ios", "android"]
    public var toolchainLock: String = "mixer.lock"
    public var capabilities: [String] = ["storage.files"]
    public var updates = UpdateConfiguration()
    public init(name: String, application: String) { self.name = name; self.application = application }
    public func validate() throws {
        guard schema == 1, language == "swift" else { throw MixerFailure("config.schema", "Only schema 1 and language swift are supported.") }
        guard name.range(of: "^[A-Za-z][A-Za-z0-9_]{0,63}$", options: .regularExpression) != nil else {
            throw MixerFailure("config.name", "Name must be a Swift identifier starting with a letter (maximum 64 characters).")
        }
        guard application.range(of: "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$", options: .regularExpression) != nil else {
            throw MixerFailure("config.application", "Application must be a reverse-DNS identifier, for example com.example.fieldlog.")
        }
        guard Set(targets).count == targets.count, !targets.isEmpty, Set(targets).isSubset(of: ["ios", "android"]) else { throw MixerFailure("config.targets", "Targets must be unique ios/android entries.") }
        guard toolchainLock == "mixer.lock" else { throw MixerFailure("config.lock", "The current schema requires mixer.lock beside mixer.yml.") }
        guard updates.activation == "cold-start", updates.compatibility == "exact-runtime-fingerprint", updates.requireArtifactSignature, updates.requireAssignmentSignature else { throw MixerFailure("config.updates", "Cold-start activation, exact runtime identity, and both signatures are required.") }
        guard Set(capabilities).count == capabilities.count, capabilities.allSatisfy({ $0.range(of: "^[a-z][a-z0-9.-]{1,95}$", options: .regularExpression) != nil }) else { throw MixerFailure("config.capabilities", "Capabilities must be unique bounded identifiers.") }
    }
    public static func load(_ root: URL) throws -> Self {
        let url = root.appendingPathComponent("mixer.yml")
        let data = try Data(contentsOf: url)
        guard data.count <= 1_048_576 else { throw MixerFailure("config.size", "mixer.yml exceeds 1 MiB.") }
        do {
            try JSONInputGuard.validate(data, limits: JSONInputLimits(maximumDepth: 32, maximumValues: 4096))
        } catch let error as JSONInputError {
            throw MixerFailure("config.encoding", "Invalid or ambiguous configuration JSON (\(error.reason.rawValue) at byte \(error.offset)). The current format is the JSON subset of YAML 1.2.")
        }
        let raw: Any
        do { raw = try JSONSerialization.jsonObject(with: data) }
        catch { throw MixerFailure("config.encoding", "This preview reads the JSON subset of YAML 1.2 in mixer.yml. Use the generated configuration; block-style YAML support is not yet implemented.") }
        guard let fields = raw as? [String: Any] else { throw MixerFailure("config.shape", "mixer.yml must be an object.") }
        let known: Set<String> = ["schema", "application", "name", "language", "targets", "toolchainLock", "capabilities", "updates"]
        let unknown = Set(fields.keys).subtracting(known)
        guard unknown.isEmpty else { throw MixerFailure("config.unknown", "Unknown configuration keys: \(unknown.sorted().joined(separator: ", ")).") }
        if let updateFields = fields["updates"] as? [String: Any] {
            let allowed: Set<String> = ["activation", "compatibility", "requireArtifactSignature", "requireAssignmentSignature"]
            guard Set(updateFields.keys).isSubset(of: allowed) else { throw MixerFailure("config.unknown", "Unknown update configuration key.") }
        }
        let config = try JSONDecoder().decode(Self.self, from: data)
        try config.validate()
        return config
    }
}

public struct UpdateConfiguration: Codable, Equatable, Sendable {
    public var activation = "cold-start"
    public var compatibility = "exact-runtime-fingerprint"
    public var requireArtifactSignature = true
    public var requireAssignmentSignature = true
    public init() {}
}

public struct ToolchainLock: Codable, Sendable {
    public var schema = 1
    public var sdkDigest: String
    public var sdkDistribution: String
    public var swiftVersion: String
    public var generatedBy = "mixer 0.1.0-dev"
    public var qualification = "local-development-only"
    public var android: AndroidToolchainLock?
    public init(sdkDigest: String, swiftVersion: String) {
        self.sdkDigest = sdkDigest; self.swiftVersion = swiftVersion; sdkDistribution = "bundled-source-snapshot"
    }
}

public enum JSONFile {
    public static func data<T: Encodable>(_ value: T) throws -> Data {
        let encoder = JSONEncoder(); encoder.outputFormatting = [.prettyPrinted, .sortedKeys, .withoutEscapingSlashes]
        return try encoder.encode(value) + Data([10])
    }
    public static func write<T: Encodable>(_ value: T, to url: URL) throws { try data(value).write(to: url, options: .atomic) }
}

public enum SourceDigest {
    public static func files(in root: URL) throws -> [URL] {
        let root = root.resolvingSymlinksInPath().standardizedFileURL
        let skipped: Set<String> = [".build", ".git", ".swiftpm", "node_modules", ".gradle", ".mixer", "target", ".DS_Store"]
        guard let enumerator = FileManager.default.enumerator(atPath: root.path) else { throw MixerFailure("files.read", "Cannot enumerate \(root.path)") }
        var result: [URL] = []
        for case let relative as String in enumerator {
            let url = root.appendingPathComponent(relative)
            if skipped.contains(url.lastPathComponent) { enumerator.skipDescendants(); continue }
            let name = url.lastPathComponent.lowercased()
            if (name == ".env" || (name.hasPrefix(".env.") && name != ".env.example")) || ["pem", "key", "p12", "pfx", "mobileprovision", "keystore", "jks"].contains(url.pathExtension.lowercased()) { continue }
            let info = try url.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey])
            if info.isSymbolicLink == true { throw MixerFailure("files.symlink", "Source snapshots reject symlinks: \(url.path)") }
            if info.isRegularFile == true { result.append(url) }
        }
        return result.sorted { $0.path < $1.path }
    }
    public static func sha256(_ data: Data) -> String { SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined() }
    public static func tree(_ root: URL) throws -> String {
        let root = root.resolvingSymlinksInPath().standardizedFileURL
        var hash = SHA256()
        for file in try files(in: root) {
            let relative = String(file.path.dropFirst(root.path.count + 1))
            hash.update(data: Data(relative.utf8)); hash.update(data: Data([0]))
            hash.update(data: Data(sha256(try Data(contentsOf: file)).utf8)); hash.update(data: Data([10]))
        }
        return hash.finalize().map { String(format: "%02x", $0) }.joined()
    }
}

54db5256e1da445edd1fd131c133445626650251 blob 17195
import Foundation

public struct GeneratedProject: Codable, Sendable {
    public var path: String
    public var application: String
    public var sdkDigest: String
    public var qualification = "local-development-only"
    public var nextSteps: [String]
}

public enum ProjectGenerator {
    public static func create(name: String, application: String, destination: URL, sdk: URL, platform: String = "ios", androidAdapter: URL? = nil) throws -> GeneratedProject {
        guard ["ios", "android"].contains(platform) else { throw MixerFailure("create.platform", "Create supports ios (default) or android (both native hosts).") }
        var config = ApplicationConfiguration(name: name, application: application)
        config.targets = platform == "android" ? ["ios", "android"] : ["ios"]
        // The starter requests no native capabilities. Adding one requires an
        // implemented native host and a new binary, never a successful stub.
        config.capabilities = []
        try config.validate()
        let fm = FileManager.default
        guard !fm.fileExists(atPath: destination.path) else { throw MixerFailure("create.exists", "Refusing to overwrite \(destination.path). Choose a new directory.") }
        guard fm.fileExists(atPath: sdk.appendingPathComponent("Package.swift").path) else { throw MixerFailure("create.sdk", "SDK package not found at \(sdk.path). Supply --sdk-path to an installed Mixer SDK source distribution.") }
        let parent = destination.deletingLastPathComponent()
        try fm.createDirectory(at: parent, withIntermediateDirectories: true)
        let staging = parent.appendingPathComponent(".mixer-create-\(UUID().uuidString)")
        try fm.createDirectory(at: staging, withIntermediateDirectories: true)
        defer { try? fm.removeItem(at: staging) }
        for path in ["Sources/AppModels", "Sources/AppFeatures", "Sources/NativeServices", "Tests/AppModelsTests", "Platforms/iOS", "Platforms/Android", "Resources", "Generated/MixerSDK"] {
            try fm.createDirectory(at: staging.appendingPathComponent(path), withIntermediateDirectories: true)
        }
        let sdk = sdk.resolvingSymlinksInPath().standardizedFileURL
        let sdkTarget = staging.appendingPathComponent("Generated/MixerSDK")
        for file in try SourceDigest.files(in: sdk) {
            let relative = String(file.path.dropFirst(sdk.path.count + 1))
            let target = sdkTarget.appendingPathComponent(relative)
            try fm.createDirectory(at: target.deletingLastPathComponent(), withIntermediateDirectories: true)
            try fm.copyItem(at: file, to: target)
        }
        let digest = try SourceDigest.tree(sdkTarget)
        let version = try ProcessRunner.run(["swift", "--version"])
        guard version.succeeded else { throw MixerFailure("create.swift", version.output) }
        try JSONFile.write(config, to: staging.appendingPathComponent("mixer.yml"))
        var lock = ToolchainLock(sdkDigest: digest, swiftVersion: version.output.trimmingCharacters(in: .whitespacesAndNewlines))
        if platform == "android" {
            guard let androidAdapter else { throw MixerFailure("create.android-adapter", "Supply the owned Mixer Android adapter source distribution.") }
            let adapterDigest = try AndroidProject.snapshot(adapter: androidAdapter, destination: staging.appendingPathComponent("Generated/MixerAndroid"))
            lock.android = AndroidToolchainLock(adapterDigest: adapterDigest, toolchain: try AndroidProject.inspectToolchain())
        }
        try JSONFile.write(lock, to: staging.appendingPathComponent("mixer.lock"))
        let files = [
            "Package.swift": package(name),
            "Sources/AppModels/Entry.swift": models,
            "Sources/AppFeatures/ProjectFeature.swift": features,
            "Sources/NativeServices/README.md": "Native integrations live here. A new native capability requires a new store binary.\n",
            "Tests/AppModelsTests/EntryTests.swift": modelTests,
            "Platforms/iOS/\(name)App.swift": appleApp(name),
            "README.md": readme(name),
            ".gitignore": ".build/\n.swiftpm/\n.mixer/\n.DS_Store\n"
        ]
        for (path, contents) in files { try contents.write(to: staging.appendingPathComponent(path), atomically: true, encoding: .utf8) }
        _ = try AppleProject.generate(root: staging)
        if platform == "android" { try AndroidProject.generate(root: staging) }
        else { try "No Android host was requested. Create a new project with --platform android for the unsigned local development host.\n".write(to: staging.appendingPathComponent("Platforms/Android/README.md"), atomically: true, encoding: .utf8) }
        // An entire project becomes visible only when construction succeeds.
        try fm.moveItem(at: staging, to: destination)
        return GeneratedProject(path: destination.path, application: application, sdkDigest: digest, nextSteps: ["cd \(destination.path)", "mixer test", "mixer doctor"])
    }

    private static func package(_ name: String) -> String {
        """
        // swift-tools-version: 6.0
        import PackageDescription
        let package = Package(
            name: "\(name)", platforms: [.iOS("26.0"), .macOS(.v14)],
            products: [.library(name: "AppFeatures", targets: ["AppFeatures"])],
            dependencies: [.package(path: "Generated/MixerSDK")],
            targets: [
                .target(name: "AppModels"),
                .target(name: "AppFeatures", dependencies: ["AppModels", .product(name: "MixerUI", package: "MixerSDK")]),
                .testTarget(name: "AppModelsTests", dependencies: ["AppModels", "AppFeatures"])
            ]
        )
        """ + "\n"
    }

    private static let models = """
    import Foundation
    public struct Entry: Codable, Equatable, Identifiable, Sendable {
        public let id: UUID
        public var title: String
        public var note: String
        public var completed: Bool
        public init(id: UUID = UUID(), title: String, note: String = "", completed: Bool = false) {
            self.id = id; self.title = title; self.note = note; self.completed = completed
        }
        public var isValid: Bool { !title.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty }
    }
    public enum ProjectProgress {
        public static func fraction(_ entries: [Entry]) -> Double {
            entries.isEmpty ? 0 : Double(entries.filter(\\.completed).count) / Double(entries.count)
        }
    }
    """ + "\n"

    private static let features = """
    import Foundation
    import AppModels
    import MixerUI
    public struct ProjectFeatureState: Equatable, Sendable {
        public var entries: [Entry]
        public var draft: String
        public init(entries: [Entry] = [], draft: String = "") { self.entries = entries; self.draft = draft }
    }
    public enum ProjectFeatureError: Error { case invalidAction, invalidDraft, entryLimit }
    public enum ProjectFeature {
        // Compatible read-only surface retained for the iOS starter.
        public static func document(entries: [Entry], revision: UInt64 = 0) -> UIDocument {
            UIDocument(schemaVersion: 1, revision: revision, root: UINode(
                id: "project", kind: .vStack,
                properties: [:], children: [
                    UINode(id: "title", kind: .text, properties: ["text": .string("Your project")]),
                    UINode(id: "progress", kind: .text, properties: ["text": .string("\\(entries.filter(\\.completed).count) of \\(entries.count) completed")])
                ]
            ))
        }
        public static func document(state: ProjectFeatureState, revision: UInt64 = 0) -> UIDocument {
            MixerUI.Navigation("project", title: "Your project") {
                MixerUI.List("entries") {
                    MixerUI.Section("editor", title: "Entries") {
                        MixerUI.Text("progress", "\\(state.entries.filter(\\.completed).count) of \\(state.entries.count) completed")
                        MixerUI.TextField("draft", "New entry", value: state.draft, action: "draft.change", onSubmit: "entry.add")
                        MixerUI.Button("add", "Add entry", action: "entry.add")
                            .disabled(state.draft.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty || state.entries.count >= 100)
                    }
                    MixerUI.Section("items", title: "Project entries") {
                        for entry in state.entries {
                            MixerUI.Toggle("entry.\\(entry.id.uuidString)", entry.title, value: entry.completed, action: "entry.toggle")
                        }
                    }
                }
            }.document(revision: revision)
        }
        public static func handle(_ action: RoutedUIAction, state: inout ProjectFeatureState) throws {
            switch (action.actionID, action.value) {
            case ("draft.change", .string(let value)):
                guard action.nodeID == "draft", value.utf8.count <= 16_384 else { throw ProjectFeatureError.invalidAction }
                state.draft = value
            case ("entry.add", .null):
                guard action.nodeID == "add" || action.nodeID == "draft" else { throw ProjectFeatureError.invalidAction }
                let title = state.draft.trimmingCharacters(in: .whitespacesAndNewlines)
                guard !title.isEmpty else { throw ProjectFeatureError.invalidDraft }
                guard state.entries.count < 100 else { throw ProjectFeatureError.entryLimit }
                state.entries.append(Entry(title: title)); state.draft = ""
            case ("entry.toggle", .bool(let completed)):
                guard let index = state.entries.firstIndex(where: { "entry.\\($0.id.uuidString)" == action.nodeID }) else { throw ProjectFeatureError.invalidAction }
                state.entries[index].completed = completed
            default: throw ProjectFeatureError.invalidAction
            }
        }
    }
    """ + "\n"

    private static let modelTests = """
    import Testing
    import Foundation
    @testable import AppModels
    @testable import AppFeatures
    import MixerUI
    @Test func progressPreservesFraction() {
        #expect(ProjectProgress.fraction([Entry(title: "A", completed: true), Entry(title: "B")]) == 0.5)
        #expect(ProjectProgress.fraction([]) == 0)
    }
    @Test func draftRoundTrip() throws {
        let entry = Entry(title: "Inspect site", note: "Offline draft")
        #expect(try JSONDecoder().decode(Entry.self, from: JSONEncoder().encode(entry)) == entry)
        #expect(!Entry(title: "  ").isValid)
    }
    @Test func featureBuilds() { #expect(ProjectFeature.document(entries: []).root.id == "project") }
    @Test func sharedDraftAddToggle() throws {
        var state = ProjectFeatureState()
        var reconciler = UIReconciler()
        func action(_ id: String, _ event: UIEventKind, _ value: UIValue) throws -> RoutedUIAction {
            let snapshot = try reconciler.currentSnapshot()
            return try snapshot.route(UIEventEnvelope(revision: snapshot.document.revision,
                identity: #require(snapshot.identity(for: id)), event: event, value: value))
        }
        try reconciler.apply(ProjectFeature.document(state: state, revision: 1))
        try ProjectFeature.handle(action("draft", .textChange, .string(" Café 東京 ")), state: &state)
        try reconciler.apply(ProjectFeature.document(state: state, revision: 2))
        try ProjectFeature.handle(action("add", .activate, .null), state: &state)
        #expect(state.entries.count == 1); #expect(state.entries[0].title == "Café 東京"); #expect(state.draft.isEmpty)
        try reconciler.apply(ProjectFeature.document(state: state, revision: 3))
        try ProjectFeature.handle(action("entry.\\(state.entries[0].id.uuidString)", .valueChange, .bool(true)), state: &state)
        #expect(state.entries[0].completed)
    }
    """ + "\n"

    private static func appleApp(_ name: String) -> String {
        """
        import SwiftUI
        import MixerApple
        import AppFeatures
        @main struct \(name)App: App {
            @State private var host: MixerUIHost?
            @State private var failure: String?
            var body: some Scene {
                WindowGroup {
                    Group {
                        if let host { MixerNativeView(host: host, onAction: { _ in }) }
                        else if let failure { Text(failure) }
                        else { ProgressView() }
                    }.task {
                        do { host = try MixerUIHost(document: ProjectFeature.document(entries: [])) }
                        catch { failure = String(describing: error) }
                    }
                }
            }
        }
        """ + "\n"
    }
    private static func readme(_ name: String) -> String {
        """
        # \(name)

        Created with the mixer development preview. Run `mixer test` or `swift test`.
        `mixer.yml` uses JSON, a valid YAML 1.2 subset. The bundled SDK source snapshot
        is hashed in mixer.lock and allows offline builds without a cloud account.
        Source edits to that snapshot invalidate the lock until explicitly regenerated.

        The iOS app entry point is in Platforms/iOS. An explicit `--platform android`
        creation also generates a locked native Android host; see Platforms/Android.
        Android is an unsigned local cross-build, pending device qualification.
        SDK installation, Android UI, and signed OTA delivery are still being qualified. A passing host
        test is not a mobile release. Do not publish this preview as a qualified SDK.
        """ + "\n"
    }
}

public enum ProjectBuild {
    public static func verifyLock(root: URL) throws -> ToolchainLock {
        _ = try ApplicationConfiguration.load(root)
        let lock = try JSONDecoder().decode(ToolchainLock.self, from: Data(contentsOf: root.appendingPathComponent("mixer.lock")))
        guard lock.schema == 1 else { throw MixerFailure("lock.schema", "Unsupported lock schema") }
        let actual = try SourceDigest.tree(root.appendingPathComponent("Generated/MixerSDK"))
        guard actual == lock.sdkDigest else { throw MixerFailure("lock.sdk-drift", "Bundled SDK source differs from mixer.lock. Restore the original SDK snapshot or explicitly install a new qualified SDK.") }
        if let android = lock.android {
            guard try SourceDigest.tree(root.appendingPathComponent("Generated/MixerAndroid")) == android.adapterDigest else { throw MixerFailure("lock.android-drift", "Bundled Android adapter source differs from mixer.lock. Restore the original locked adapter snapshot.") }
        }
        let version = try ProcessRunner.run(["swift", "--version"])
        guard version.succeeded, version.output.trimmingCharacters(in: .whitespacesAndNewlines) == lock.swiftVersion else { throw MixerFailure("lock.toolchain-drift", "Swift host compiler differs from mixer.lock. Select the pinned toolchain.") }
        return lock
    }
    public static func run(root: URL, test: Bool, platform: String) throws -> CommandResult {
        _ = try verifyLock(root: root)
        if platform == "ios", !test { return try AppleProject.build(root: root) }
        if platform == "android", !test { return try AndroidProject.build(root: root) }
        guard platform == "host" else { throw MixerFailure("build.unqualified-target", "\(platform) \(test ? "tests" : "build") requires pending native integration; no platform result is reported as passed. Available: host package build/test, unsigned iOS Simulator build.") }
        return try ProcessRunner.run(["swift", test ? "test" : "build", "--package-path", root.path], at: root)
    }
    public static func export(root: URL, destination: URL) throws -> String {
        _ = try verifyLock(root: root)
        let root = root.resolvingSymlinksInPath().standardizedFileURL; let destination = destination.resolvingSymlinksInPath().standardizedFileURL
        guard !destination.path.hasPrefix(root.path + "/"), destination != root else { throw MixerFailure("export.destination", "Export must be outside the source project.") }
        guard !FileManager.default.fileExists(atPath: destination.path) else { throw MixerFailure("export.exists", "Refusing to overwrite export destination.") }
        let files = try SourceDigest.files(in: root)
        try FileManager.default.createDirectory(at: destination, withIntermediateDirectories: true)
        do {
            for source in files {
                let relative = String(source.path.dropFirst(root.path.count + 1))
                let target = destination.appendingPathComponent(relative)
                try FileManager.default.createDirectory(at: target.deletingLastPathComponent(), withIntermediateDirectories: true)
                try FileManager.default.copyItem(at: source, to: target)
            }
            return try SourceDigest.tree(destination)
        } catch { try? FileManager.default.removeItem(at: destination); throw error }
    }
}

8ab15b12fca3cc857cfc88a3395c388c1f9d618b blob 22935
#!/usr/bin/env python3
"""Owned local Android consumer builder. Uses installed official tools; never signs or installs."""
import hashlib
import json
import os
import pathlib
import re
import shutil
import stat
import subprocess
import sys
import uuid
import zipfile

SDK_ID = 'aarch64-unknown-linux-android28'
ENV = os.environ.copy()
HOME_DIR = pathlib.Path.home()
SDK = pathlib.Path(ENV.get('ANDROID_HOME', ENV.get('ANDROID_SDK_ROOT', '/opt/homebrew/share/android-commandlinetools'))).resolve()
JDK = pathlib.Path(ENV.get('MIXER_JDK', '/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home')).resolve()
SWIFT = pathlib.Path(ENV.get('MIXER_SWIFT', str(HOME_DIR / 'Library/Developer/Toolchains/swift-6.3.3-RELEASE.xctoolchain/usr/bin/swift'))).absolute()
SWIFT_SDKS = pathlib.Path(ENV.get('MIXER_SWIFT_SDKS_PATH', str(HOME_DIR / '.swiftpm/swift-sdks'))).resolve()
ART = pathlib.Path(ENV.get('MIXER_ANDROID_ARTIFACT_PATH', str(SWIFT_SDKS / 'swift-6.3.3-RELEASE_android.artifactbundle/swift-android'))).resolve()
NDK = ART / 'android-ndk-r27d/toolchains/llvm/prebuilt/darwin-x86_64'
RUNTIME = ART / 'swift-resources/usr/lib/swift-aarch64/android'
BT = SDK / 'build-tools/37.0.0'
JAR = SDK / 'platforms/android-37.0/android.jar'
APPEARANCE_ASSET = 'assets/MixerAppearanceV2/descriptor.json'
ENV['JAVA_HOME'] = str(JDK)
ENV['PATH'] = str(JDK / 'bin') + os.pathsep + ENV.get('PATH', '')


def digest(path):
    h = hashlib.sha256()
    with path.open('rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            h.update(chunk)
    return h.hexdigest()


def tree(path):
    """Hash installed tool distributions, including symlink text and target file bytes."""
    path = path.resolve(strict=True)
    if not path.is_dir():
        raise RuntimeError('Missing installed tool distribution: ' + str(path))
    h = hashlib.sha256()
    for base, dirs, names in os.walk(path, followlinks=False):
        dirs.sort()
        for name in sorted(names + [d for d in dirs if (pathlib.Path(base) / d).is_symlink()]):
            item = pathlib.Path(base) / name
            relative = item.relative_to(path).as_posix()
            if item.is_symlink():
                resolved = item.resolve(strict=True)
                if item.is_dir() and not resolved.is_relative_to(path):
                    raise RuntimeError('Installed distribution directory symlink escapes hashed root: ' + str(item))
                value = 'symlink:' + os.readlink(item)
                if item.is_file():
                    value += ':' + digest(item)
            elif item.is_file():
                value = digest(item)
            else:
                raise RuntimeError('Unsupported installed tool file: ' + str(item))
            h.update((relative + '\0' + value + '\n').encode())
    return h.hexdigest()


def source_tree(path):
    h = hashlib.sha256()
    skip = {'.build', '.git', '.swiftpm', 'node_modules', '.gradle', '.mixer', 'target', '.DS_Store'}
    files = []
    for base, dirs, names in os.walk(path, followlinks=False):
        dirs[:] = sorted(d for d in dirs if d not in skip)
        for name in names:
            item = pathlib.Path(base) / name
            if name in skip or (name == '.env' or (name.startswith('.env.') and name != '.env.example')) or item.suffix.lower() in {'.pem', '.key', '.p12', '.pfx', '.mobileprovision', '.keystore', '.jks'}:
                continue
            if item.is_symlink():
                raise RuntimeError('Source snapshots reject symlinks: ' + str(item))
            files.append(item)
        for name in dirs:
            if (pathlib.Path(base) / name).is_symlink():
                raise RuntimeError('Source snapshots reject symlinks')
    for item in sorted(files):
        h.update((item.relative_to(path).as_posix() + '\0' + digest(item) + '\n').encode())
    return h.hexdigest()


def probe(args):
    return subprocess.check_output(list(map(str, args)), env=ENV, stderr=subprocess.STDOUT, text=True).strip()


def read_json(path):
    def unique(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise RuntimeError('Duplicate JSON key in local build input: ' + key)
            result[key] = value
        return result
    data = path.read_bytes()
    if len(data) > 1024 * 1024:
        raise RuntimeError('Local build JSON input exceeds 1MiB: ' + str(path))
    return json.loads(data, object_pairs_hook=unique)


def configuration(value):
    known = {'schema', 'name', 'application', 'language', 'targets', 'toolchainLock', 'capabilities', 'updates'}
    if not isinstance(value, dict) or set(value) != known or type(value.get('schema')) is not int or value['schema'] != 1 or value['language'] != 'swift' or value['toolchainLock'] != 'mixer.lock':
        raise RuntimeError('Unsupported Android local configuration schema/fields.')
    if not isinstance(value['name'], str) or re.fullmatch(r'[A-Za-z][A-Za-z0-9_]{0,63}', value['name']) is None:
        raise RuntimeError('Invalid Android application name; expected a bounded Swift identifier without path components.')
    if not isinstance(value['application'], str) or re.fullmatch(r'[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+', value['application']) is None:
        raise RuntimeError('Invalid Android application identifier; expected reverse-DNS components.')
    targets = value['targets']
    if not isinstance(targets, list) or not all(isinstance(t, str) for t in targets) or len(set(targets)) != len(targets) or not set(targets).issubset({'ios', 'android'}) or 'android' not in targets:
        raise RuntimeError('Android local targets must be unique ios/android entries including android.')
    if value['capabilities'] != []:
        raise RuntimeError('Android host supports an empty capability list only in this slice.')
    expected_updates = {'activation': 'cold-start', 'compatibility': 'exact-runtime-fingerprint', 'requireArtifactSignature': True, 'requireAssignmentSignature': True}
    if value['updates'] != expected_updates or type(value['updates'].get('requireArtifactSignature')) is not bool or type(value['updates'].get('requireAssignmentSignature')) is not bool:
        raise RuntimeError('Unsupported Android update policy configuration.')
    return value


def appearance_input(adapter):
    """Admit the complete closed asset layout before source_tree opens any asset.

    This checks local layout/type/size and bytes, not Swift/Java codec semantics.
    A recomputed unauthenticated lock is not default provenance or authority.
    """
    assets = adapter / 'app/assets'
    descriptor = adapter / 'app' / APPEARANCE_ASSET
    for path in (adapter.parent, adapter, adapter / 'app', assets, descriptor.parent):
        try:
            info = path.lstat()
        except FileNotFoundError as error:
            raise RuntimeError('Missing Android appearance asset directory: ' + str(path)) from error
        if not stat.S_ISDIR(info.st_mode):
            raise RuntimeError('Android appearance asset directories must be ordinary directories: ' + str(path))
    # Inspect every name, including hidden, excluded-extension and skipped names.
    if sorted(p.name for p in assets.iterdir()) != ['MixerAppearanceV2'] or sorted(p.name for p in descriptor.parent.iterdir()) != ['descriptor.json']:
        raise RuntimeError('Android appearance assets must contain only MixerAppearanceV2/descriptor.json.')
    info = descriptor.lstat()
    if not stat.S_ISREG(info.st_mode):
        raise RuntimeError('Android appearance descriptor must be a regular file without symlinks.')
    if not 1 <= info.st_size <= 65_536:
        raise RuntimeError('Android appearance descriptor must contain 1..65536 bytes.')
    with descriptor.open('rb') as stream:
        data = stream.read(65_537)
    if len(data) != info.st_size:
        raise RuntimeError('Android appearance descriptor changed during admission.')
    return data


def appearance_archive(archive, expected):
    """Require one exact final asset and reject all duplicate ZIP names."""
    names = archive.namelist()
    if len(names) != len(set(names)):
        raise RuntimeError('Duplicate ZIP entries in unsigned Android APK.')
    if sorted(n for n in names if n == 'assets' or n.startswith('assets/')) != [APPEARANCE_ASSET]:
        raise RuntimeError('APK must contain exactly the admitted Android appearance asset.')
    if archive.getinfo(APPEARANCE_ASSET).file_size != len(expected) or archive.read(APPEARANCE_ASSET) != expected:
        raise RuntimeError('APK Android appearance bytes differ from admitted locked input.')
    return {'asset': APPEARANCE_ASSET, 'bytes': len(expected), 'sha256': hashlib.sha256(expected).hexdigest(),
            'scope': 'Exact local locked-input packaging only; direct-driver layout/size admission does not establish codec semantics, copied-SDK compatibility, installed use or signed authority.'}


def checked_output(root, create=False):
    """Reject redirected local staging before cleanup or writes.

    SwiftPM creates internal directory links (for example release -> triple/release),
    which are allowed only when their existing target stays inside this output.
    This is a local preflight, not isolation from concurrent same-user writers or
    arbitrary code executed by a package's build tools.
    """
    root = root.resolve(strict=True)
    output = root / '.mixer/android-build'
    for path in (root / '.mixer', output):
        try:
            info = path.lstat()
        except FileNotFoundError:
            if create:
                path.mkdir()
            continue
        if not stat.S_ISDIR(info.st_mode):
            raise RuntimeError('Unsafe Android staging directory: ' + str(path))
    if not output.exists():
        return output
    for base, dirs, names in os.walk(output, followlinks=False):
        for name in sorted(dirs + names):
            path = pathlib.Path(base) / name
            info = path.lstat()
            if stat.S_ISLNK(info.st_mode):
                try:
                    target = path.resolve(strict=True)
                except (OSError, RuntimeError) as error:
                    raise RuntimeError('Unsafe Android staging link: ' + str(path)) from error
                if not target.is_relative_to(output):
                    raise RuntimeError('Unsafe Android staging link escapes output: ' + str(path))
                info = target.stat()
            if stat.S_ISREG(info.st_mode):
                if info.st_nlink != 1:
                    raise RuntimeError('Unsafe Android staging hard link: ' + str(path))
            elif not stat.S_ISDIR(info.st_mode):
                raise RuntimeError('Unsafe Android staging special file: ' + str(path))
    return output


def inspect():
    swift_version = probe([SWIFT, '--version'])
    if 'Swift version 6.3.3 ' not in swift_version:
        raise RuntimeError('Supported Android compiler is official Swift 6.3.3; set MIXER_SWIFT.')
    metadata = {
        'ndk': ART / 'android-ndk-r27d/source.properties',
        'platform': JAR.parent / 'source.properties',
        'build_tools': BT / 'source.properties',
        'jdk': JDK / 'release',
        'swift_sdk': ART / 'swift-sdk.json',
        'swift_toolset': ART / 'swift-toolset.json',
    }
    texts = {key: path.read_text() for key, path in metadata.items()}
    if '27.3.13750724' not in texts['ndk'] or 'Pkg.Revision=37.0.0' not in texts['build_tools'] or 'AndroidVersion.ApiLevel=37.0' not in texts['platform'] or 'JAVA_VERSION="25.' not in texts['jdk']:
        raise RuntimeError('Supported tools require NDK r27d, build-tools37.0.0, Android37.0 platform and JDK25.')
    tools = {
        'python': pathlib.Path(sys.executable).resolve(),
        'swift': SWIFT, 'clang': NDK / 'bin/aarch64-linux-android28-clang',
        'readelf': NDK / 'bin/llvm-readelf', 'nm': NDK / 'bin/llvm-nm',
        'java': JDK / 'bin/java', 'javac': JDK / 'bin/javac',
        'd8': BT / 'd8', 'aapt2': BT / 'aapt2', 'zipalign': BT / 'zipalign', 'dexdump': BT / 'dexdump',
    }
    for name, path in tools.items():
        if not path.is_file() or not os.access(path, os.X_OK):
            raise RuntimeError('Missing executable ' + name + ': ' + str(path))
    return {
        'schema': 1, 'sdk_id': SDK_ID, 'abi': 'arm64-v8a', 'min_api': 28, 'target_api': 37,
        'swift_version': swift_version, 'javac_version': probe([JDK / 'bin/javac', '--version']),
        'java_version': probe([JDK / 'bin/java', '--version']),
        'python_version': sys.version,
        'tools': {key: {'path': str(path), 'sha256': digest(path)} for key, path in tools.items()},
        'metadata': {key: {'path': str(path), 'sha256': digest(path)} for key, path in metadata.items()},
        'distributions': {
            'swift_toolchain': {'path': str(SWIFT.parent.parent.parent), 'sha256': tree(SWIFT.parent.parent.parent)},
            'swift_android_sdk': {'path': str(ART.parent), 'sha256': tree(ART.parent)},
            'android_platform': {'path': str(JAR.parent), 'sha256': tree(JAR.parent)},
            'android_build_tools': {'path': str(BT), 'sha256': tree(BT)},
            'jdk': {'path': str(JDK), 'sha256': tree(JDK)},
        },
        'sdk_search_path': str(SWIFT_SDKS),
    }


def build(root):
    lock = read_json(root / 'mixer.lock')
    if not isinstance(lock, dict) or type(lock.get('schema')) is not int or lock['schema'] != 1:
        raise RuntimeError('Unsupported local toolchain lock schema.')
    android = lock.get('android')
    if not android:
        raise RuntimeError('Android host is not generated. Create a new project with --platform android.')
    adapter = root / 'Generated/MixerAndroid'
    appearance = appearance_input(adapter)
    if source_tree(adapter) != android['adapterDigest'] or source_tree(root / 'Generated/MixerSDK') != lock['sdkDigest']:
        raise RuntimeError('Bundled SDK or Android adapter source differs from mixer.lock.')
    config = configuration(read_json(root / 'mixer.yml'))
    if any(p.is_file() for p in (root / 'Resources').rglob('*')):
        raise RuntimeError('Android resource packaging is not integrated; resources cannot be omitted.')
    output = checked_output(root, create=True)
    receipt_path = output / 'build-receipt.json'
    receipt_path.unlink(missing_ok=True)
    apk_path = output / (config['name'] + '-unsigned.apk')
    apk_path.unlink(missing_ok=True)
    source_before = source_tree(root)
    build_input = {'run_id': uuid.uuid4().hex, 'source_tree_sha256': source_before,
                   'scope': 'Local observed mutation detection; not an immutable build sandbox or attestation.'}
    temporary_input = output / 'build-input.json.tmp'
    temporary_input.write_text(json.dumps(build_input, indent=2) + '\n')
    temporary_input.replace(output / 'build-input.json')
    identity = inspect()
    if identity != android['toolchain']:
        raise RuntimeError('Android toolchain differs from mixer.lock. Restore the exact installed tool distributions.')
    commands = []
    def run(args):
        checked_output(root)
        args = list(map(str, args))
        p = subprocess.run(args, cwd=root, env=ENV, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        commands.append({'command': args, 'exit_code': p.returncode, 'output': p.stdout})
        print(p.stdout, end='', flush=True)
        if p.returncode:
            raise RuntimeError('Android build failed: ' + repr(args))
        return p.stdout
    package = root / 'Platforms/Android'
    swift_args = [SWIFT, 'build', '--package-path', package, '--scratch-path', output / 'swift', '--swift-sdks-path', SWIFT_SDKS, '--swift-sdk', SDK_ID, '-c', 'release', '--product', 'AppAndroid', '-Xlinker', '-z', '-Xlinker', 'max-page-size=16384']
    run(swift_args)
    bin_path = pathlib.Path(run(swift_args + ['--show-bin-path']).strip())
    engine = bin_path / 'libAppAndroid.so'
    if not engine.is_file():
        raise RuntimeError('Actual app Swift library missing: ' + str(engine))
    for path in [output / 'apk', output / 'classes', output / 'dex']:
        checked_output(root)
        if path.exists():
            shutil.rmtree(path)
        path.mkdir()
    libdir = output / 'apk/lib/arm64-v8a'
    libdir.mkdir(parents=True)
    run([NDK / 'bin/aarch64-linux-android28-clang', '-shared', '-fPIC', '-O2', '-Wall', '-Wextra', '-Werror', '-I', adapter / 'bridge', adapter / 'bridge/jni.c', '-L', bin_path, '-lAppAndroid', '-Wl,--no-undefined', '-Wl,-z,max-page-size=16384', '-o', libdir / 'libmixer_android_jni.so'])
    shutil.copy2(engine, libdir / engine.name)
    system = {'libc.so', 'libdl.so', 'libm.so', 'liblog.so', 'libandroid.so'}
    pending = list(libdir.glob('*.so'))
    dependencies = {}
    while pending:
        lib = pending.pop()
        header = run([NDK / 'bin/llvm-readelf', '-h', lib])
        if 'ELF64' not in header or 'AArch64' not in header:
            raise RuntimeError('Native APK library is not arm64 ELF64: ' + lib.name)
        dynamic = run([NDK / 'bin/llvm-readelf', '-d', lib])
        needed = re.findall(r'\(NEEDED\).*\[([^\]]+)\]', dynamic)
        dependencies[lib.name] = needed
        for name in needed:
            if name in system or (libdir / name).exists():
                continue
            candidates = [RUNTIME / name, NDK / 'sysroot/usr/lib/aarch64-linux-android' / name]
            found = next((p for p in candidates if p.is_file()), None)
            if found is None:
                raise RuntimeError('Unresolved native runtime dependency: ' + name)
            shutil.copy2(found, libdir / name)
            pending.append(libdir / name)
    classes, dex = output / 'classes', output / 'dex'
    sources = sorted((adapter / 'app/src').rglob('*.java')) + sorted((package / 'Java').rglob('*.java'))
    run([JDK / 'bin/javac', '--release', '17', '-Xlint:all', '-Werror', '-classpath', JAR, '-d', classes, *sources])
    run([BT / 'd8', '--min-api', '28', '--lib', JAR, '--output', dex, *sorted(classes.rglob('*.class'))])
    unsigned = output / 'unaligned.apk'
    if appearance_input(adapter) != appearance or source_tree(adapter) != android['adapterDigest']:
        raise RuntimeError('Android appearance/adapter input changed before packaging.')
    run([BT / 'aapt2', 'link', '-I', JAR, '--manifest', package / 'AndroidManifest.xml', '-A', adapter / 'app/assets', '--min-sdk-version', '28', '--target-sdk-version', '37', '-o', unsigned])
    checked_output(root)
    with zipfile.ZipFile(unsigned, 'a', compression=zipfile.ZIP_DEFLATED) as archive:
        for item in sorted((output / 'apk').rglob('*')):
            if item.is_file():
                archive.write(item, item.relative_to(output / 'apk'))
        for item in dex.glob('*.dex'):
            archive.write(item, item.name)
    run([BT / 'zipalign', '-f', '-P', '16', '4', unsigned, apk_path])
    run([BT / 'zipalign', '-c', '-P', '16', '4', apk_path])
    badging = run([BT / 'aapt2', 'dump', 'badging', apk_path])
    if "package: name='" + config['application'] + "'" not in badging or 'dev.mixer.android.MixerActivity' not in badging or "native-code: 'arm64-v8a'" not in badging:
        raise RuntimeError('APK identity, native activity or ABI does not match generated app.')
    dex_dump = run([BT / 'dexdump', '-f', dex / 'classes.dex'])
    for descriptor in ['Ldev/mixer/android/MixerActivity;', 'Ldev/mixer/android/NativeBridge;', 'Ldev/mixer/android/NativeRenderer;']:
        if descriptor not in dex_dump:
            raise RuntimeError('Required owned Android class absent from dex: ' + descriptor)
    symbols = run([NDK / 'bin/llvm-nm', '-D', '--defined-only', engine])
    for symbol in ['mixer_android_create', 'mixer_android_exchange', 'mixer_android_destroy', 'mixer_android_prepare_v2', 'mixer_android_commit_v2', 'mixer_android_abort_v2', 'AppFeatures', 'AppModels']:
        if symbol not in symbols:
            raise RuntimeError('App shared feature/model or ABI symbol missing: ' + symbol)
    with zipfile.ZipFile(apk_path) as archive:
        names = archive.namelist()
        appearance_identity = appearance_archive(archive, appearance)
        if any(n.startswith('META-INF/') for n in names) or any('ChecklistEngine' in n for n in names):
            raise RuntimeError('Unexpected signing/example content in unsigned consumer.')
        content = {n: hashlib.sha256(archive.read(n)).hexdigest() for n in sorted(names)}
    normalized = hashlib.sha256(json.dumps(content, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
    if appearance_input(adapter) != appearance:
        apk_path.unlink(missing_ok=True)
        raise RuntimeError('Android appearance input changed during the build.')
    source_after = source_tree(root)
    if source_before != source_after or source_tree(adapter) != android['adapterDigest'] or source_tree(root / 'Generated/MixerSDK') != lock['sdkDigest']:
        apk_path.unlink(missing_ok=True)
        raise RuntimeError('Application/SDK/adapter source changed during the Android build; result rejected. Restore stable inputs and rebuild.')
    receipt = {
        'schema_version': 1, 'qualification': 'local-unsigned-cross-build-only',
        'application': config['application'], 'apk': str(apk_path), 'apk_sha256': digest(apk_path), 'apk_bytes': apk_path.stat().st_size,
        'apk_content_sha256': normalized, 'apk_entries': content,
        'source_tree_sha256': source_before, 'source_tree_after_sha256': source_after,
        'source_observation_scope': 'Before/after local mutation detection only; inputs are not isolated or immutably captured.',
        'sdk_digest': lock['sdkDigest'], 'adapter_digest': android['adapterDigest'],
        'appearance_descriptor': appearance_identity,
        'toolchain': identity, 'native_dependencies': dependencies,
        'native_libraries': {p.name: digest(p) for p in sorted(libdir.glob('*.so'))}, 'commands': commands,
        'scope': 'Actual generated AppModels/AppFeatures Swift, owned JNI/native widgets, arm64 Android APK inspected. Unsigned; no install, device interaction, lifecycle, accessibility, performance, published SDK, store or FieldLog qualification.',
    }
    checked_output(root)
    receipt_path.write_text(json.dumps(receipt, indent=2) + '\n')
    print('UNSIGNED APK:', apk_path, 'SHA256:', receipt['apk_sha256'], flush=True)
    print('RECEIPT:', receipt_path, flush=True)


if __name__ == '__main__':
    try:
        if len(sys.argv) == 2 and sys.argv[1] == 'inspect':
            print(json.dumps(inspect(), sort_keys=True))
        elif len(sys.argv) == 3 and sys.argv[1] == 'build':
            build(pathlib.Path(sys.argv[2]).resolve())
        else:
            raise RuntimeError('Usage: android-build.py inspect | build PROJECT')
    except Exception as error:
        print('Android local build error: ' + str(error), file=sys.stderr)
        sys.exit(1)

