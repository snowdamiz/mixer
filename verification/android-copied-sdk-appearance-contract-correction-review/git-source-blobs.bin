public struct UINodeIdentity: Codable, Hashable, Sendable {
    public let id: String
    public let generation: UInt64

    public init(id: String, generation: UInt64) { self.id = id; self.generation = generation }
}

public struct UIEventEnvelope: Codable, Equatable, Sendable {
    public let revision: UInt64
    public let identity: UINodeIdentity
    public let event: UIEventKind
    public let value: UIValue

    public init(revision: UInt64, identity: UINodeIdentity, event: UIEventKind, value: UIValue = .null) {
        self.revision = revision; self.identity = identity; self.event = event; self.value = value
    }
}

public struct RoutedUIAction: Codable, Equatable, Sendable {
    public let revision: UInt64
    public let nodeID: String
    public let actionID: String
    public let event: UIEventKind
    public let value: UIValue
}

public enum UIRoutingError: Error, Equatable, Sendable {
    case staleRevision
    case staleIdentity
    case disabledNode
    case unboundEvent
    case invalidValue
}

public enum UIReconciliationError: Error, Equatable, Sendable {
    case noDocument
    case revisionNotIncreasing
    case identitySpaceExhausted
}

public struct UINodeMove: Equatable, Sendable {
    public let id: String
    public let fromParent: String?
    public let toParent: String?
    public let fromIndex: Int
    public let toIndex: Int
}

/// Property/action changes are separate from structural insert/remove/reorder changes.
/// An ID whose kind changes is replaced and receives a new native identity.
public struct UIChangeSet: Equatable, Sendable {
    public let inserted: [String]
    public let removed: [String]
    public let replaced: [String]
    public let updated: [String]
    public let moved: [UINodeMove]
}

struct ReconciledNode: Sendable {
    let node: UINode
    let identity: UINodeIdentity
    let parent: String?
    let index: Int
    let disabled: Bool
}

/// An immutable render receipt. Its constructor is internal so a renderer can only
/// receive a validated, fully indexed tree.
public struct UIRenderSnapshot: Sendable {
    public let document: UIDocument
    public var nodeCount: Int { nodes.count }
    let nodes: [String: ReconciledNode]
    let maximumStringBytes: Int

    public func identity(for nodeID: String) -> UINodeIdentity? { nodes[nodeID]?.identity }

    /// Bindings come from the current node, never from a caller-supplied action ID.
    public func route(_ envelope: UIEventEnvelope) throws -> RoutedUIAction {
        guard envelope.revision == document.revision else { throw UIRoutingError.staleRevision }
        guard let record = nodes[envelope.identity.id], record.identity == envelope.identity else {
            throw UIRoutingError.staleIdentity
        }
        guard !record.disabled else { throw UIRoutingError.disabledNode }
        guard let action = record.node.actions.first(where: { $0.event == envelope.event }) else {
            throw UIRoutingError.unboundEvent
        }
        switch (envelope.event, envelope.value) {
        case (.activate, .null), (.submit, .null), (.valueChange, .bool): break
        case let (.textChange, .string(text)):
            guard text.utf8.count <= maximumStringBytes else { throw UIRoutingError.invalidValue }
        default: throw UIRoutingError.invalidValue
        }
        return RoutedUIAction(revision: document.revision, nodeID: record.node.id,
                              actionID: action.id, event: action.event, value: envelope.value)
    }
}

/// Owns identity and reconciles a whole validated batch atomically. Failed validation,
/// replayed revisions and identity exhaustion leave the last snapshot intact.
public struct UIReconciler: Sendable {
    public let validator: UIValidator
    public private(set) var snapshot: UIRenderSnapshot?
    private var nextGeneration: UInt64 = 0

    public init(validator: UIValidator = UIValidator()) { self.validator = validator }

    public func currentSnapshot() throws -> UIRenderSnapshot {
        guard let snapshot else { throw UIReconciliationError.noDocument }
        return snapshot
    }

    @discardableResult
    public mutating func apply(_ document: UIDocument) throws -> UIChangeSet {
        _ = try validator.validate(document)
        if let snapshot, document.revision <= snapshot.document.revision {
            throw UIReconciliationError.revisionNotIncreasing
        }
        let previous = snapshot?.nodes ?? [:]
        var records: [String: ReconciledNode] = [:]
        var generation = nextGeneration
        var inserted: [String] = [], replaced: [String] = [], updated: [String] = []
        var moved: [UINodeMove] = []
        var pending: [(UINode, String?, Int, Bool)] = [(document.root, nil, 0, false)]
        while let (node, parent, index, ancestorDisabled) = pending.popLast() {
            let identity: UINodeIdentity
            if let old = previous[node.id], old.node.kind == node.kind {
                identity = old.identity
                if old.node.properties != node.properties || old.node.actions != node.actions {
                    updated.append(node.id)
                }
                if old.parent != parent || old.index != index {
                    moved.append(UINodeMove(id: node.id, fromParent: old.parent, toParent: parent,
                                            fromIndex: old.index, toIndex: index))
                }
            } else {
                guard generation < UInt64.max else { throw UIReconciliationError.identitySpaceExhausted }
                generation += 1
                identity = UINodeIdentity(id: node.id, generation: generation)
                if previous[node.id] == nil { inserted.append(node.id) } else { replaced.append(node.id) }
            }
            let disabled = ancestorDisabled || node.properties["disabled"]?.bool == true
            records[node.id] = ReconciledNode(node: node, identity: identity, parent: parent, index: index, disabled: disabled)
            for (childIndex, child) in node.children.enumerated().reversed() {
                pending.append((child, node.id, childIndex, disabled))
            }
        }
        let removed = previous.keys.filter { records[$0] == nil }.sorted()
        nextGeneration = generation
        snapshot = UIRenderSnapshot(document: document, nodes: records,
                                    maximumStringBytes: validator.limits.maximumStringBytes)
        return UIChangeSet(inserted: inserted, removed: removed, replaced: replaced, updated: updated, moved: moved)
    }
}

bb9082eafb84de174ca6cf3982fc706981906f53 blob 3644
/// The measured iOS size hierarchy used by the next shared appearance recipe.
/// These values are data only: they do not select a font, change a renderer,
/// install resources, or modify the existing appearance-v1 wire/default recipe.
public enum UISharedTextProfileV1: String, CaseIterable, Sendable {
    case xs, s, m, l, xl, xxl, xxxl, a1, a2, a3, a4, a5

    public func metrics(for role: UISharedTextRoleV1) -> UISharedTextMetricsV1 {
        let row: (body: UInt32, title: UInt32, caption: UInt32, expanded: UInt32)
        switch self {
        case .xs: row = (14, 25, 11, 31)
        case .s: row = (15, 26, 11, 32)
        case .m: row = (16, 27, 11, 33)
        case .l: row = (17, 28, 12, 34)
        case .xl: row = (19, 30, 14, 36)
        case .xxl: row = (21, 32, 16, 38)
        case .xxxl: row = (23, 34, 18, 40)
        case .a1: row = (28, 38, 22, 44)
        case .a2: row = (33, 43, 26, 48)
        case .a3: row = (40, 48, 32, 52)
        case .a4: row = (47, 53, 37, 56)
        case .a5: row = (53, 58, 43, 60)
        }
        switch role {
        case .body: return UISharedTextMetricsV1(size64: row.body * 64, weight: .w400)
        case .headline, .sectionHeader:
            return UISharedTextMetricsV1(size64: row.body * 64, weight: .w600)
        case .title: return UISharedTextMetricsV1(size64: row.title * 64, weight: .w400)
        case .caption: return UISharedTextMetricsV1(size64: row.caption * 64, weight: .w400)
        case .navigationExpanded:
            return UISharedTextMetricsV1(size64: row.expanded * 64, weight: .w700)
        }
    }
}

public enum UISharedTextRoleV1: String, CaseIterable, Sendable {
    case body, headline, title, caption, sectionHeader, navigationExpanded
}

public struct UISharedTextMetricsV1: Sendable, Equatable {
    /// Logical 1/64 point/dp size, already selected for the requested profile.
    /// Native consumers must not apply a second semantic/sp scale multiplier.
    public let size64: UInt32
    public let weight: UIFontWeightV1
    // Deliberately no fixed text height or clipping box. Native shaping, script
    // fallback, wrapping and accessibility may need a larger layout rectangle.
}

public enum UISharedTextProfileErrorV1: Error, Sendable, Equatable {
    case unsupportedBodySize
}

public enum UISharedTextProfileSelectionV1 {
    /// App policy for a previously converted native body-size preference, in
    /// logical 64ths. Select the nearest measured body anchor; ties select the
    /// larger profile. Outside the supported range is an explicit error, never
    /// a silent accessibility cap or extrapolation. Conversion from a native
    /// preference remains the adapter's responsibility and needs native evidence.
    public static func nearest(preferredBodySize64: UInt32) throws -> UISharedTextProfileV1 {
        let profiles = UISharedTextProfileV1.allCases
        guard preferredBodySize64 >= profiles[0].metrics(for: .body).size64,
              preferredBodySize64 <= profiles[profiles.count - 1].metrics(for: .body).size64 else {
            throw UISharedTextProfileErrorV1.unsupportedBodySize
        }
        for index in 1..<profiles.count {
            let lower = profiles[index - 1].metrics(for: .body).size64
            let upper = profiles[index].metrics(for: .body).size64
            // The checked domain is 896...3392. UInt64 makes the comparison
            // exact without division, floating point or midpoint truncation.
            if UInt64(preferredBodySize64) * 2 < UInt64(lower) + UInt64(upper) {
                return profiles[index - 1]
            }
        }
        return .a5
    }
}

2c0bbc4064b3103c0b8aba531fbd764998b70b6b blob 10674
public struct UIValidationLimits: Equatable, Sendable {
    public static let standard = UIValidationLimits()
    public let maximumMessageBytes: Int
    public let maximumNodes: Int
    public let maximumDepth: Int
    public let maximumChildrenPerNode: Int
    public let maximumStringBytes: Int

    public init(maximumMessageBytes: Int = 1_048_576, maximumNodes: Int = 4096,
                maximumDepth: Int = 64, maximumChildrenPerNode: Int = 1000,
                maximumStringBytes: Int = 16_384) {
        self.maximumMessageBytes = maximumMessageBytes
        self.maximumNodes = maximumNodes
        self.maximumDepth = maximumDepth
        self.maximumChildrenPerNode = maximumChildrenPerNode
        self.maximumStringBytes = maximumStringBytes
    }

    var isValid: Bool {
        (1...16_777_216).contains(maximumMessageBytes) && (1...65_536).contains(maximumNodes)
            && (1...128).contains(maximumDepth) && (1...10_000).contains(maximumChildrenPerNode)
            && (1...262_144).contains(maximumStringBytes)
    }
}

public enum UIValidationError: Error, Equatable, Sendable {
    case unguardedDecoder
    case invalidLimits
    case unsupportedSchema(Int)
    case limitExceeded(String)
    case invalidIdentifier(String)
    case duplicateIdentity(String)
    case unsupportedNode(NodeKind)
    case unsupportedField(String)
    case invalidProperty(node: String, key: String)
    case invalidChildren(String)
    case invalidAction(node: String, event: UIEventKind)
}

public struct ValidatedUIDocument: Sendable {
    public let document: UIDocument
    public let nodeCount: Int
    // Only a validator can establish this type's invariant.
    init(document: UIDocument, nodeCount: Int) { self.document = document; self.nodeCount = nodeCount }
}

public struct UIValidator: Sendable {
    public let limits: UIValidationLimits
    public let supportedKinds: Set<NodeKind>

    public init(limits: UIValidationLimits = .standard, supportedKinds: Set<NodeKind> = Set(NodeKind.allCases)) {
        self.limits = limits; self.supportedKinds = supportedKinds
    }

    public func validate(_ document: UIDocument) throws -> ValidatedUIDocument {
        guard limits.isValid else { throw UIValidationError.invalidLimits }
        guard document.schemaVersion == UIDocument.currentSchemaVersion else {
            throw UIValidationError.unsupportedSchema(document.schemaVersion)
        }
        var pending = [(document.root, 1)]
        var identities: Set<String> = []
        var bytes = 0
        while let (node, depth) = pending.popLast() {
            guard depth <= limits.maximumDepth else { throw UIValidationError.limitExceeded("depth") }
            guard identities.count < limits.maximumNodes else { throw UIValidationError.limitExceeded("nodes") }
            guard validIdentifier(node.id) else { throw UIValidationError.invalidIdentifier(node.id) }
            guard identities.insert(node.id).inserted else { throw UIValidationError.duplicateIdentity(node.id) }
            guard supportedKinds.contains(node.kind) else { throw UIValidationError.unsupportedNode(node.kind) }
            guard node.children.count <= limits.maximumChildrenPerNode else { throw UIValidationError.limitExceeded("children") }
            guard node.properties.count <= 16 else { throw UIValidationError.limitExceeded("properties") }
            guard node.actions.count <= 4 else { throw UIValidationError.limitExceeded("actions") }
            bytes += node.id.utf8.count + node.kind.rawValue.utf8.count
            for (key, value) in node.properties {
                bytes += key.utf8.count
                switch value {
                case let .string(string):
                    guard string.utf8.count <= limits.maximumStringBytes else { throw UIValidationError.limitExceeded("stringBytes") }
                    bytes += string.utf8.count
                case let .number(number):
                    guard number.isFinite else { throw UIValidationError.invalidProperty(node: node.id, key: key) }
                    bytes += 8
                case .bool: bytes += 1
                case .null: break
                }
            }
            try validateProperties(of: node)
            try validateStructure(of: node)
            var events: Set<UIEventKind> = []
            for action in node.actions {
                guard validIdentifier(action.id) else { throw UIValidationError.invalidIdentifier(action.id) }
                guard events.insert(action.event).inserted, permittedEvents(for: node.kind).contains(action.event) else {
                    throw UIValidationError.invalidAction(node: node.id, event: action.event)
                }
                bytes += action.id.utf8.count + action.event.rawValue.utf8.count
            }
            for required in requiredEvents(for: node.kind) where !events.contains(required) {
                throw UIValidationError.invalidAction(node: node.id, event: required)
            }
            // This aggregate bound also protects in-memory trees before encoding. The exact
            // serialized byte bound is checked by encode/decode on the wire.
            guard bytes <= limits.maximumMessageBytes else { throw UIValidationError.limitExceeded("contentBytes") }
            // Admit the entire next frontier before retaining any child. Counting
            // only visited identities lets a wide/deep tree grow pending storage
            // beyond the node limit before it reaches the eventual rejection.
            guard node.children.isEmpty || depth < limits.maximumDepth else {
                throw UIValidationError.limitExceeded("depth")
            }
            let availableNodes = limits.maximumNodes - identities.count - pending.count
            guard node.children.count <= availableNodes else {
                throw UIValidationError.limitExceeded("nodes")
            }
            for child in node.children.reversed() { pending.append((child, depth + 1)) }
        }
        return ValidatedUIDocument(document: document, nodeCount: identities.count)
    }

    private func validateProperties(of node: UINode) throws {
        let strings = ["accessibilityLabel", "accessibilityHint", "accessibilityValue", "accessibilityIdentifier"]
        var allowed = Set(strings + ["disabled"])
        for (key, value) in node.properties {
            if strings.contains(key), value.string == nil { throw UIValidationError.invalidProperty(node: node.id, key: key) }
            if key == "disabled", value.bool == nil { throw UIValidationError.invalidProperty(node: node.id, key: key) }
        }
        func requireString(_ key: String) throws {
            guard node.properties[key]?.string != nil else { throw UIValidationError.invalidProperty(node: node.id, key: key) }
        }
        func optionalString(_ key: String, values: Set<String>? = nil) throws {
            if let value = node.properties[key] {
                guard let string = value.string, values == nil || values!.contains(string) else {
                    throw UIValidationError.invalidProperty(node: node.id, key: key)
                }
            }
        }
        switch node.kind {
        case .text:
            allowed.formUnion(["text", "style", "selectable", "maxLines"])
            try requireString("text")
            try optionalString("style", values: ["body", "headline", "title", "caption"])
            if let value = node.properties["selectable"], value.bool == nil {
                throw UIValidationError.invalidProperty(node: node.id, key: "selectable")
            }
            if let value = node.properties["maxLines"] {
                guard let number = value.number, number.rounded() == number, (1...100).contains(number) else {
                    throw UIValidationError.invalidProperty(node: node.id, key: "maxLines")
                }
            }
        case .button:
            allowed.formUnion(["label", "role"])
            try requireString("label")
            try optionalString("role", values: ["normal", "destructive", "cancel"])
        case .textField:
            allowed.formUnion(["label", "value"])
            try requireString("label"); try requireString("value")
        case .toggle:
            allowed.formUnion(["label", "value"])
            try requireString("label")
            guard node.properties["value"]?.bool != nil else { throw UIValidationError.invalidProperty(node: node.id, key: "value") }
        case .vStack, .hStack, .zStack:
            allowed.formUnion(["spacing", "alignment"])
            if let value = node.properties["spacing"] {
                guard node.kind != .zStack, let number = value.number, (0...256).contains(number) else {
                    throw UIValidationError.invalidProperty(node: node.id, key: "spacing")
                }
            }
            let alignments: Set<String> = switch node.kind {
            case .vStack: ["leading", "center", "trailing"]
            case .hStack: ["top", "center", "bottom", "firstTextBaseline", "lastTextBaseline"]
            default: ["center", "leading", "trailing", "top", "bottom", "topLeading", "topTrailing", "bottomLeading", "bottomTrailing"]
            }
            try optionalString("alignment", values: alignments)
        case .section, .navigation:
            allowed.insert("title"); try optionalString("title")
        case .list: break
        }
        if let key = node.properties.keys.first(where: { !allowed.contains($0) }) {
            throw UIValidationError.invalidProperty(node: node.id, key: key)
        }
    }

    private func validateStructure(of node: UINode) throws {
        switch node.kind {
        case .text, .button, .textField, .toggle:
            guard node.children.isEmpty else { throw UIValidationError.invalidChildren(node.id) }
        case .navigation:
            guard node.children.count == 1 else { throw UIValidationError.invalidChildren(node.id) }
        default: break
        }
    }

    private func permittedEvents(for kind: NodeKind) -> Set<UIEventKind> {
        switch kind {
        case .button: [.activate]
        case .textField: [.textChange, .submit]
        case .toggle: [.valueChange]
        default: []
        }
    }

    private func requiredEvents(for kind: NodeKind) -> Set<UIEventKind> {
        switch kind {
        case .button: [.activate]
        case .textField: [.textChange]
        case .toggle: [.valueChange]
        default: []
        }
    }
}

func validIdentifier(_ value: String) -> Bool {
    !value.isEmpty && value.utf8.count <= 128
        && !value.unicodeScalars.contains { $0.value < 0x20 || $0.value == 0x7f }
}

