+        else { return }
+        let directory = support.appendingPathComponent("FieldLogUITest-" + id.uuidString.lowercased())
+        let clocks: [String: Any] = ["operation": operation, "handle": handle, "status": status,
+            "began": began, "ended": ended, "wallNS": ended - began, "threadCPUNS": endedCPU - cpu,
+            "fuel": report.fuel_used, "hostCalls": report.host_calls_used,
+            "function": report.function, "offset": report.offset, "pid": ProcessInfo.processInfo.processIdentifier]
+        if let data = try? JSONSerialization.data(withJSONObject: clocks, options: [.sortedKeys]) {
