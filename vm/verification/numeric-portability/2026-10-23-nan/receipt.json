  "scope": "macOS arm64 local unit/integration and Node development oracle verification; default and experimental debug/release",
  "root_cause": "Linux x86_64 host ceil returned a signaling NaN unchanged; previous implementation exposed the raw host result, contrary to Wasm arithmetic NaN result requirements",
  "policy": "Return positive canonical NaN for all NaN results from f32/f64 ceil, floor, trunc, nearest, sqrt, add, sub, mul, div, min, max, demote and promote. Keep abs, neg, copysign, reinterpret, constants, storage and transport bit-exact.",
  "official_spec": [
    {
      "url": "https://webassembly.github.io/spec/core/exec/numerics.html#nan-propagation",
      "accessed_utc": "2026-10-23",
      "rule": "Canonical NaNs are permitted for every arithmetic NaN result; when all NaN inputs are canonical (including no NaN input), results must be canonical."
    },
    {
      "url": "https://webassembly.github.io/spec/core/exec/numerics.html#op-promote",
      "accessed_utc": "2026-10-23"
    },
    {
      "url": "https://webassembly.github.io/spec/core/exec/numerics.html#op-demote",
      "accessed_utc": "2026-10-23"
    },
    {
      "url": "https://webassembly.github.io/spec/core/exec/numerics.html#op-reinterpret",
      "accessed_utc": "2026-10-23"
    }
  ],
  "explicit_regressions": [
    "f32 and f64 positive/negative signaling NaNs, minimal/maximal signaling payloads, canonical/quiet payloads, all unary arithmetic and binary arithmetic/min/max in both operand positions",
    "f32->f64 promote and f64->f32 demote return explicit canonical result bit encodings",
    "sqrt negative and invalid add/sub/mul/div without NaN inputs produce canonical result encodings",
    "abs/neg/copysign/reinterpret preserve literal signaling and quiet payload bits and signs for both widths",
    "NaN comparisons and all trapping/saturating integer-conversion variants keep required integer outcomes and invalid_conversion_to_integer traps"
  ],
  "limitations": [
    "Actual repaired Linux x86_64 debug/release execution remains pending root-controlled GitHub CI rerun",
    "Physical iOS/Android checks remain pending; phones disconnected and no attempts made",
    "No signing, package publication, FieldLog immutable package dogfood, OTA authorization, customer or GA qualification asserted",
    "Local Node oracle is a development reference; owned literal-bit tests assert the chosen NaN policy independently"
  ],
