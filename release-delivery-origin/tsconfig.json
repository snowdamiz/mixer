{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "typeRoots": ["../hosted-worker-controller/node_modules/@cloudflare"],
    "types": ["workers-types"],
    "outDir": "../verification/local/w11-delivery-dist",
    "rootDir": ".",
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "test/worker.ts", "test/cross-runtime-worker.ts"]
}
