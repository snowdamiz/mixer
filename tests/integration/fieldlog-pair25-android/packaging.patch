+#!/usr/bin/env python3
+"""Seal the local FieldLog entry Commit fixture from the Pair25 Android build products."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import runpy
+import subprocess
+import sys
+import tempfile
+import zipfile
+
+HERE = Path(__file__).resolve().parent
+PRODUCERS = runpy.run_path(str(HERE / "build-products.py"))
+ADMISSION = PRODUCERS["ADMISSION"]
+APP_ID = "dev.fieldlog.generatedr90"
+ASSETS = "assets/ChecklistRelease/"
+APPEARANCE = "assets/MixerAppearanceV2/descriptor.json"
+JNI = "libmixer_public_android_jni.so"
+PAYLOAD_BYTES = 7606
+PAYLOAD_SHA256 = "ec233c0a998e12543e306e9bc051fe7eb779bc78e592e443a5867645c540e4e4"
+REFERENCE_PINS = {
+    "Installed/bridge.json": "6f05eb3fa8780ee6102d181b0710765214e51168b1429c52dd10dfd1b96873e5",
+    "Installed/identity.json": "c50ed73f0cac8637072145126be747b85afa866f29702980a01600191209a1d4",
+    "Installed/port.txt": "7fca5d6fb48cc8ce3d27ffb4d179bef3cf6f24a59e1dabddfc1f7964e15ee5b3",
+    "Installed/storage-grant.json": "f630fb1bca6042918d6c29b88027dd8c8da28771599469aee06ff3cd5a3789be",
+    "Installed/storage.json": "a5946bce4d20c315896cac254404f5fd2910b39e7982ba53744592d5d6e84f67",
+    "baseline.manifest.json": "981c4b7dc99c9c8d292ca16b969090edfa1433a702a9a183f41cc7461edaf536",
+}
+
+
+def digest(path):
+    with path.open("rb") as stream:
+        return hashlib.file_digest(stream, "sha256").hexdigest()
+
+
+def hash_bytes(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def encoded(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def capture(*command, env=None):
+    return subprocess.check_output(command, env=env, text=True, stderr=subprocess.STDOUT, timeout=90).strip()
+
+
+def read_zip(path):
+    with zipfile.ZipFile(path) as archive:
+        names = archive.namelist()
+        require(len(set(names)) == len(names), f"Duplicate ZIP entry in {path.name}")
+        return {name: hash_bytes(archive.read(name)) for name in names}
+
+
+def write_json(path, value):
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
+
+
+def assemble(work, project, destination, stage):
+    receipts = PRODUCERS["verify_products"](work, project)
+    fieldlog = work / "fieldlog"
+    mixer = work / "mixer"
+    fieldlog_tree = PRODUCERS["git"](fieldlog, "write-tree")
+    origin = mixer / "tests/integration/fieldlog-saved-draft/android/reference"
+    for name, expected in REFERENCE_PINS.items():
+        require(digest(origin / name) == expected, f"Historical template checksum differs: {name}")
+
+    sdk = Path(os.environ.get("ANDROID_HOME", "/opt/homebrew/share/android-commandlinetools"))
+    jdk = Path(os.environ.get("MIXER_JDK", "/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home"))
+    swift_sdk_search = Path(os.environ.get("MIXER_SWIFT_SDKS_PATH", str(Path.home() / "Library/org.swift.swiftpm/swift-sdks")))
+    swift_sdk = swift_sdk_search / "swift-6.3.3-RELEASE_android.artifactbundle/swift-android"
+    compiler = Path(os.environ.get("MIXER_SWIFT", str(Path.home() /
+        "Library/Developer/Toolchains/swift-6.3.3-RELEASE.xctoolchain/usr/bin/swift"))).with_name("swift-frontend")
+    tools = sdk / "build-tools/36.0.0"
+    ndk = sdk / "ndk/27.1.12297006/toolchains/llvm/prebuilt/darwin-x86_64/bin"
+    env = os.environ | {"JAVA_HOME": str(jdk), "LC_ALL": "C"}
+    java, native = work / "java", work / "jni"
+    manifest, dex, jni = java / "manifest.apk", java / "dex/classes.dex", native / JNI
+    vm = work / "android-engine/lib/libmixer_vm_capability_experimental.a"
+    engine = json.loads((work / "android-engine/receipt.json").read_bytes())
+    revision = PRODUCERS["PAIR25"]["verify"](work, project)
+    require(engine["source_revision"] == revision and engine["target_selector"] == "android"
+            and engine["rust_target"] == "aarch64-linux-android" and engine["library"]["sha256"] == digest(vm),
+            "VM must be the Android archive from the exact Pair25 revision")
+
+    guest_path = "tests/integration/fieldlog-entry-save/apple-editor/build-guests.sh"
+    guest_output = stage / "guests"
+    tool_bin = Path(env.get("FIELDLOG_SWIFT_BIN", str(compiler.parent)))
+    capture("/bin/bash", mixer / guest_path, guest_output, env=env | {"FIELDLOG_SWIFT_BIN": str(tool_bin)})
+    guest = guest_output / "entry-commit.wasm"
+    second_guest_output = stage / "guest-replay" / "other"
+    second_guest_output.parent.mkdir()
+    capture("/bin/bash", mixer / guest_path, second_guest_output,
+            env=env | {"FIELDLOG_SWIFT_BIN": str(tool_bin)})
+    require((guest.stat().st_size, digest(guest)) == (PAYLOAD_BYTES, PAYLOAD_SHA256)
+            and guest.read_bytes() == (second_guest_output / guest.name).read_bytes(),
+            "Entry Commit differs from the published reproducible Wasm payload")
+    fingerprint = ADMISSION["PAIR25_RESEALED_FINGERPRINT"]
+    preimage = stage / "native-preimage.json"
+    log = json.loads(capture(sys.executable, "-B", mixer / "capabilities/tools/export-native-preimage.py",
+                             "--check", "--output", preimage))
+    require((log["sources"], log["nativeImplementationSHA256"], digest(preimage)) == (18, fingerprint, fingerprint),
+            "Native preimage differs from the published Pair25 checkout")
+    source_archive = work / "android-engine/source.tar"
+    require(digest(source_archive) == engine["source_archive_sha256"],
+            "VM source archive differs from the pinned producer receipt")
+    header = java / "jni/dev_fieldlog_generatedr90_androidhost_PublicActivity_ChecklistPanel.h"
+    declared = set(re.findall(r"JNICALL (Java_\w+)", header.read_text()))
+    symbols = {line.split()[-1] for line in capture(ndk / "llvm-nm", "--dynamic", "--defined-only", jni).splitlines()}
+    require(len(declared) == 5 and declared <= symbols and {"JNI_OnLoad", "mxis_guest_ui_witness"} <= symbols,
+            "Checklist JNI declarations or ordinary-load exports differ from the linked ELF")
+
+    descriptor = project / "Generated/MixerAndroid/app" / APPEARANCE
+    project_lock = project / "mixer.lock"
+    manifest_entries = read_zip(manifest)
+    app = HERE.parents[1]
+    recipe = mixer / "tests/integration/fieldlog-saved-draft/android/recipe"
+    settings = work / "android-package/Package.swift"
+    packager = app / "scripts/build-signed-checklist-android.py"
+    linked = {
+        "FieldLogTree": fieldlog_tree,
+        "MixerCommit": revision,
+        "MixerTree": ADMISSION["PAIR25_PINS"][revision],
+        "mixer.lock": digest(project_lock),
+        "nativeProducerReceiptsSHA256": receipts,
+        "descriptor.json": digest(descriptor),
+        "FieldLogSwiftPackage.swift": digest(settings),
+        "FieldLogSwiftPackage.resolved": digest(work / "android-package/Package.resolved"),
+        "bytecode/classes.dex": digest(dex),
+        "manifest.apk": digest(manifest),
+        "manifestEntries": manifest_entries,
+        "native/" + JNI: digest(jni),
+        "native/vm.a": digest(vm),
+        "native/vm-source.tar": digest(source_archive),
+        "native/capability-source-preimage": digest(preimage),
+        "guest/entry-commit.wasm": digest(guest),
+        "guest/build-guests.sh": digest(mixer / guest_path),
+        "guest/embedded-swiftc": digest((tool_bin / "swiftc").resolve(strict=True)),
+        "guest/wasm-ld": digest((tool_bin / "wasm-ld").resolve(strict=True)),
+        "recipe/build-java.zsh": digest(recipe / "build-java.zsh"),
+        "recipe/manifest.py": digest(recipe / "manifest.py"),
+        "recipe/packager": digest(packager),
+        "policy/compiledManifestSource.xml": digest(java / "AndroidManifest.xml"),
+        "policy/checklist_network.xml": digest(app / "Platforms/Android/res/xml/checklist_network.xml"),
+    }
+    for name in ("PublicBridge.o", "ChecklistBridge.o", "transport.o", "platform_android.o"):
+        linked["native/" + name] = digest(native / name)
+
+    require(fingerprint.encode() in jni.read_bytes(), "Linked JNI lacks the published native capability identity")
+    signing = runpy.run_path(str(packager))
+    key, env = signing["local_development_signer"](stage, jdk, env)
+    certificate = subprocess.check_output([
+        jdk / "bin/keytool", "-exportcert", "-keystore", key, "-alias", "fieldlog-local",
+        "-storepass:env", signing["SIGNER_PASSWORD"],
+    ], env=env, timeout=30)
+    linked["apkSignerCertificateSHA256"] = hash_bytes(certificate)
+    linked["nativeCapabilityFingerprint"] = fingerprint
+    entry = Path(guest_path).parent.parent
+    draft = entry.parent / "fieldlog-saved-draft/guest"
+    linked["guestSourceSHA256"] = {
+        path.as_posix(): digest(mixer / path)
+        for path in (entry / "Guest.swift", entry / "EntrySaveDecision.swift",
+                     draft / "CapabilityImports.c", draft / "TaskWire.swift")
+    }
+    linked["installedLeafSHA256"] = {
+        Path(name).name: checksum for name, checksum in REFERENCE_PINS.items()
+        if name.startswith("Installed/") and name != "Installed/identity.json"
+    }
+    linked["installedLeafSHA256"]["entry-commit-v1.txt"] = hash_bytes(b"fieldlog-entry-commit-v1\n")
+    linked["installedLeafSHA256"]["entry-commit.wasm"] = linked["guest/entry-commit.wasm"]
+    apk_signing_args = ["--development-keystore", key]
+
+    fallback = capture("git", "-C", fieldlog, "ls-tree", "-r", fieldlog_tree,
+                       "Integrations/GeneratedReport/Platforms/Android",
+                       "Integrations/GeneratedReport/Sources", "Integrations/InstalledGuest")
+    binding = {
+        "engine": {"version": revision, "source_sha256": engine["source_manifest_sha256"], "artifact_sha256": digest(vm)},
+        "build": {
+            "settings_sha256": digest(settings),
+            "link_inputs_sha256": hash_bytes(encoded(linked)),
+            "native_fallback_sha256": hash_bytes((fallback + "\n").encode()),
+            "permissions_sha256": manifest_entries["AndroidManifest.xml"],
+            "entitlements_sha256": hash_bytes(b"{}"),
+            "resource_policy_sha256": digest(origin / "Installed/bridge.json"),
+        },
+        "toolchain": {
+            "compiler_version": capture(compiler, "-version").splitlines()[0],
+            "compiler_sha256": digest(compiler), "sdk_version": "android28",
+            "sdk_sha256": digest(swift_sdk.parent / "info.json"),
+            "build_tools_sha256": digest(tools / "aapt2"),
+        },
+    }
+
+    sealer = work / "seal-work/build/out/Products/Debug/FieldLogEntryCommitSeal"
+    apk_name = "FieldLog-Pair25-entry-commit-development-arm64.apk"
+    installed = stage / "Installed"
+    installed.mkdir()
+    binding_path = stage / "binding.json"
+    write_json(binding_path, binding)
+    runtime = capture(sealer, "seal", origin, binding_path, guest, installed)
+    identity = json.loads((installed / "identity.json").read_bytes())
+    require(identity["application"]["bundle_id"] == APP_ID, "Identity and ordinary Android app ID differ")
+    for section, fields in binding.items():
+        require(all(identity[section][key] == expected for key, expected in fields.items()),
+                f"Sealed identity lost its {section} binding")
+    pins = {path.name: digest(path) for path in installed.iterdir()}
+    require(identity["capabilities"][0]["native_sha256"] == fingerprint
+            and identity["build"]["generated_bridge_sha256"] == fingerprint,
+            "Installed identity differs from the published native capability fingerprint")
+    require(all(pins.get(name) == checksum for name, checksum in linked["installedLeafSHA256"].items()),
+            "Installed leaf materials differ from the runtime binding")
+    pin_path = stage / "installed.sha256.json"
+    write_json(pin_path, pins)
+    apk = stage / apk_name
+    capture(sys.executable, "-B", packager, "--mixer-project", project, "--manifest-apk", manifest,
+            "--dex", dex, "--jni-library", jni, "--installed-checklist", installed, "--checklist-sha256", pin_path,
+            "--android-sdk", sdk, "--swift-android-sdk", swift_sdk, "--java-home", jdk, "--output", apk,
+            *apk_signing_args, env=env)
+    signatures = capture(tools / "apksigner", "verify", "--verbose", "--print-certs", "-Werr", apk, env=env)
+    certs = re.findall(r"^Signer #\d+ certificate SHA-256 digest: ([0-9a-f]{64})$", signatures, re.MULTILINE)
+    require(certs == [linked["apkSignerCertificateSHA256"]],
+            "Final APK signer certificate differs from the sealed runtime binding")
+    capture(tools / "zipalign", "-c", "-P", "16", "4", apk, env=env)
+    badging = capture(tools / "aapt2", "dump", "badging", apk, env=env)
+    members = read_zip(apk)
+    expected = manifest_entries | {"classes.dex": linked["bytecode/classes.dex"],
+                "lib/arm64-v8a/" + JNI: linked["native/" + JNI], APPEARANCE: linked["descriptor.json"]}
+    expected.update({ASSETS + name: checksum for name, checksum in pins.items()})
+    require(all(members.get(name) == checksum for name, checksum in expected.items()),
+            "Signed APK payload differs from the sealed build and installed material")
+    readback = stage / "readback"
+    readback.mkdir()
+    with zipfile.ZipFile(apk) as archive:
+        for name in pins:
+            (readback / name).write_bytes(archive.read(ASSETS + name))
+    require(capture(sealer, "verify", readback) == runtime, "Packaged release has a different runtime")
+    require(PRODUCERS["verify_products"](work, project) == receipts,
+            "Pair25 source or build outputs changed during sealing")
+    write_json(destination / "apk-evidence.json", {
+        "qualification": "development build evidence only; installed verification pending",
+        "payloadReproduction": {"bytes": PAYLOAD_BYTES, "sha256": PAYLOAD_SHA256, "distinctOutputDirectories": 2},
+        "mixerProfile": ADMISSION["PAIR25_PROFILE"], "linkInputs": linked, "identityBinding": binding,
+        "runtimeFingerprint": runtime, "nativeCapabilityFingerprint": identity["capabilities"][0]["native_sha256"],
+        "capabilityExecution": identity["capability_execution"], "installedAssetsSHA256": pins,
+        "apkMembersSHA256": members, "apkSHA256": digest(apk), "apkBytes": apk.stat().st_size,
+        "badging": badging.splitlines(), "signatures": signatures.splitlines(), "alignmentKiB": 16,
+        "checklistJNI": sorted(declared),
+    })
+    os.link(apk, destination / apk_name)
+    print(runtime)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    for name in ("work", "project", "output"):
+        parser.add_argument(name, type=Path)
+    args = parser.parse_args()
+    work, project, destination = (path.resolve() for path in (args.work, args.project, args.output))
+    os.umask(0o077)
+    PRODUCERS["PAIR25"]["verify_checkout"](work)
+    destination.mkdir()
+    with tempfile.TemporaryDirectory(prefix=".seal-", dir=destination) as stage:
+        assemble(work, project, destination, Path(stage))
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except subprocess.CalledProcessError as error:
+        sys.exit(f"{error}\n{error.stdout}")
+    except (OSError, ValueError, subprocess.TimeoutExpired, zipfile.BadZipFile) as error:
+        sys.exit(str(error))
