diff --git a/Integrations/GeneratedReport/scripts/pair25/SealEntryCommit.swift b/Integrations/GeneratedReport/scripts/pair25/SealEntryCommit.swift
new file mode 100644
index 0000000..4b1fc59
--- /dev/null
+++ b/Integrations/GeneratedReport/scripts/pair25/SealEntryCommit.swift
@@ -0,0 +1,152 @@
+import CryptoKit
+import Foundation
+import MixerCapabilities
+import MixerRuntimeIdentity
+import MixerUpdates
+
+@main
+struct SealEntryCommit {
+    static func main() throws {
+        let arguments = Array(CommandLine.arguments.dropFirst())
+        if arguments.count == 2, arguments[0] == "verify" {
+            try verify(URL(fileURLWithPath: arguments[1]))
+            return
+        }
+        guard arguments.count == 5, arguments[0] == "seal" else {
+            throw UpdateError("fieldlog.arguments", "Expected seal REFERENCE BINDING GUEST INSTALLED or verify INSTALLED")
+        }
+        let reference = URL(fileURLWithPath: arguments[1])
+        let binding = URL(fileURLWithPath: arguments[2])
+        let guest = URL(fileURLWithPath: arguments[3])
+        let installed = URL(fileURLWithPath: arguments[4])
+        try seal(reference: reference, binding: binding, guest: guest, installed: installed)
+        try verify(installed)
+    }
+
+    private static func seal(reference: URL, binding: URL, guest: URL, installed: URL) throws {
+        let template = reference.appendingPathComponent("Installed")
+        let prior = try CapabilityRuntimeIdentity(json: read(template, "identity.json"))
+        let scope = prior.installedRuntime.scope
+        let value = try object(Data(contentsOf: binding))
+        guard scope == UpdateScope(organization: "mixer-local", project: "fieldlog", app: "fieldlog",
+                                  environment: "development", platform: "android"),
+              var identity = prior.descriptor.object, var build = identity["build"]?.object,
+              var limits = identity["capability_execution"]?.object,
+              case let .array(dependencies)? = identity["dependencies"],
+              case let .array(capabilities)? = identity["capabilities"], capabilities.count == 1,
+              var storage = capabilities.first?.object, storage["id"] == .text("storage.keyValue.v1"),
+              let buildBinding = value["build"]?.object, let engineBinding = value["engine"]?.object,
+              var engine = identity["engine"]?.object,
+              let compiler = value["toolchain"]?.object,
+              let revision = engineBinding["version"]?.text,
+              var manifest = try object(read(reference, "baseline.manifest.json"))["manifest"]?.object,
+              case let .array(grants)? = manifest["capability_grants"]?.object?["entries"],
+              grants == [try StrictJSON.decode(CanonicalValue.self, from: read(template, "storage-grant.json"))]
+        else { throw UpdateError("fieldlog.binding", "Invalid Android entry Commit fixture inputs") }
+
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys, .withoutEscapingSlashes]
+        let secret = Curve25519.Signing.PrivateKey()
+        let keyID = "fieldlog-android-entry-commit-local"
+        let roots = [TrustRoot(keyID: keyID, publicKey: secret.publicKey.rawRepresentation,
+            scope: scope, artifact: true, assignment: true, notBeforeUnix: 1)]
+        let rootsBytes = try encoder.encode(roots)
+        build.merge(buildBinding) { _, new in new }
+        // Describe the exact linked SDK for this development packet.
+        let nativeIdentity = CanonicalValue.text(CapabilityNativeIdentity.sha256)
+        build["generated_bridge_sha256"] = nativeIdentity
+        storage["native_sha256"] = nativeIdentity
+        identity["capabilities"] = .array([.object(storage)])
+        build["trust_roots_sha256"] = .text(ReleaseVerifier.sha256(rootsBytes))
+        limits["maximum_requests"] = .uint(2)
+        limits["reservation_bytes"] = .uint(2_097_152)
+        identity["build"] = .object(build)
+        engine.merge(engineBinding) { _, new in new }
+        identity["engine"] = .object(engine)
+        identity["toolchain"] = .object(compiler)
+        identity["capability_execution"] = .object(limits)
+        identity["dependencies"] = .array(dependencies.filter {
+            $0.object?["id"]?.text != "mixer.guest-ui-deferred-startup-v1"
+        })
+        let identityBytes = try encoder.encode(CanonicalValue.object(identity))
+        let runtime = try CapabilityRuntimeIdentity(json: identityBytes).installedRuntime
+
+        let payload = try Data(contentsOf: guest)
+        guard !payload.isEmpty, payload.count <= 8192 else {
+            throw UpdateError("fieldlog.payload", "Expected the bounded single-put entry Commit guest")
+        }
+        let now = UInt64(Date().timeIntervalSince1970)
+        let release = "fieldlog-android-entry-commit"
+        let size = CanonicalValue.uint(UInt64(payload.count))
+        manifest["release_id"] = .text(release)
+        manifest["source_commit"] = .text(revision)
+        manifest["provenance_id"] = .text("fieldlog-android-local-" + String(runtime.runtime.prefix(24)))
+        manifest["runtime"] = .text(runtime.runtime)
+        manifest["capability_hashes"] = .object(runtime.capabilityHashes.mapValues(CanonicalValue.text))
+        manifest["payload_sha256"] = .text(ReleaseVerifier.sha256(payload))
+        manifest["compressed_bytes"] = size
+        manifest["expanded_bytes"] = size
+        manifest["key_id"] = .text(keyID)
+        manifest["created_at_unix"] = .uint(now)
+
+        func signed(_ body: CanonicalValue, field: String, domain: String) throws -> Data {
+            let signature = try secret.signature(for: Data("mixer.\(domain).v3\0".utf8) + body.canonicalCBOR())
+            return try encoder.encode(CanonicalValue.object([
+                field: body, "signature": .text(signature.base64EncodedString()),
+            ]))
+        }
+        let manifestValue = CanonicalValue.object(manifest)
+        let scopeValue = try StrictJSON.decode(CanonicalValue.self, from: encoder.encode(scope))
+        let assignment = CanonicalValue.object([
+            "schema": .uint(3), "scope": scopeValue, "channel": .text("beta"), "cohort": .text("sha256-v1"),
+            "rollout_basis_points": .uint(10_000), "sequence": .uint(1), "release_id": .text(release),
+            "artifact_sha256": .text(ReleaseVerifier.sha256(try manifestValue.canonicalCBOR())),
+            "runtime": .text(runtime.runtime), "key_id": .text(keyID), "created_at_unix": .uint(now),
+        ])
+        let files = try [
+            "identity.json": identityBytes, "roots.json": rootsBytes,
+            "bridge.json": read(template, "bridge.json"), "port.txt": read(template, "port.txt"),
+            "storage.json": read(template, "storage.json"), "storage-grant.json": read(template, "storage-grant.json"),
+            "entry-commit-v1.txt": Data("fieldlog-entry-commit-v1\n".utf8),
+            "entry-commit.wasm": payload,
+            "entry-commit.manifest.json": signed(manifestValue, field: "manifest", domain: "artifact"),
+            "entry-commit.assignment.json": signed(assignment, field: "assignment", domain: "assignment"),
+        ]
+        for (name, bytes) in files {
+            try bytes.write(to: installed.appendingPathComponent(name), options: .withoutOverwriting)
+        }
+    }
+
+    private static func verify(_ installed: URL) throws {
+        let identity = try CapabilityRuntimeIdentity(json: read(installed, "identity.json"))
+        let runtime = identity.installedRuntime
+        let rootsBytes = try read(installed, "roots.json")
+        guard identity.capabilityExecution.maximumRequests == 2,
+              identity.capabilityExecution.reservationBytes == 2_097_152,
+              identity.capabilities.count == 1,
+              identity.capabilities.first?.nativeSHA256 == CapabilityNativeIdentity.sha256,
+              identity.descriptor.object?["build"]?.object?["generated_bridge_sha256"] == .text(CapabilityNativeIdentity.sha256),
+              identity.descriptor.object?["build"]?.object?["trust_roots_sha256"] == .text(ReleaseVerifier.sha256(rootsBytes))
+        else { throw UpdateError("fieldlog.policy", "Unexpected capability limits or trust roots") }
+
+        let roots = try StrictJSON.decode([TrustRoot].self, from: rootsBytes)
+        let verifier = try ReleaseVerifierV3(host: runtime, roots: roots)
+        let now = UInt64(Date().timeIntervalSince1970)
+        let artifact = try verifier.verifyArtifact(signedManifest: read(installed, "entry-commit.manifest.json"),
+            payload: read(installed, "entry-commit.wasm"), now: now)
+        _ = try verifier.verifyAssignment(signedAssignment: read(installed, "entry-commit.assignment.json"),
+            artifact: artifact, channel: "beta", installation: "fieldlog-android-local", lastSequence: 0, now: now)
+        print(runtime.runtime)
+    }
+
+    private static func object(_ bytes: Data) throws -> [String: CanonicalValue] {
+        guard let result = try StrictJSON.decode(CanonicalValue.self, from: bytes).object else {
+            throw UpdateError("fieldlog.object", "Expected a JSON object")
+        }
+        return result
+    }
+
+    private static func read(_ directory: URL, _ name: String) throws -> Data {
+        try Data(contentsOf: directory.appendingPathComponent(name))
+    }
+}
