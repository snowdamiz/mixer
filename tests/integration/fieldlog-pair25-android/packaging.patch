index 0000000..e94e8ff
--- /dev/null
+++ b/Integrations/GeneratedReport/scripts/pair25/build-products.py
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+"""Build and identify the FieldLog Java or native Pair25 fixture products."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import runpy
+import subprocess
+
+HERE = Path(__file__).resolve().parent
+PAIR25 = runpy.run_path(str(HERE / "verify-pair25.py"))
+ADMISSION = PAIR25["admission"]
+RECIPE = "tests/integration/fieldlog-saved-draft/android/recipe"
+ANDROID_PACKAGE = "Integrations/GeneratedReport/Platforms/Android"
+ABI = "aarch64-unknown-linux-android28"
+VM_ARCHIVE = "android-engine/lib/libmixer_vm_capability_experimental.a"
+PRODUCTS = {
+    "java": (
+        "java/dex/classes.dex", "java/manifest.apk", "java/AndroidManifest.xml",
+        "java/jni/dev_fieldlog_generatedr90_androidhost_PublicActivity_ChecklistPanel.h",
+    ),
+    "jni": (
+        "jni/libmixer_public_android_jni.so", "jni/PublicBridge.o", "jni/ChecklistBridge.o",
+        "jni/transport.o", "jni/platform_android.o", "android-package/Package.swift", "android-package/Package.resolved",
+    ),
+}
+
+
+def digest(path):
+    if not path.is_file() or path.is_symlink():
+        raise ValueError(f"Expected a regular build input: {path}")
+    with path.open("rb") as stream:
+        return hashlib.file_digest(stream, "sha256").hexdigest()
+
+
+def git(root, *arguments):
+    return subprocess.check_output(
+        ["git", "--no-optional-locks", "-C", root, *arguments], text=True, timeout=15).strip()
+
+
+def generated_java(work, project):
+    path = "app/src/dev/mixer/android"
+    generated = project / "Generated/MixerAndroid" / path
+    pinned = work / "mixer/native/android" / path
+    exclusions = {"MixerActivity.java", "AdapterInstrumentation.java",
+                  "AppearanceDescriptorV1.java", "AppearanceResolutionV1.java"}
+    expected = {source.name: digest(source) for source in pinned.glob("*.java") if source.name not in exclusions}
+    actual = {source.name: digest(source) for source in generated.glob("*.java") if source.name != "MixerActivity.java"}
+    if actual != expected:
+        raise ValueError("Prepared public-host Java sources differ from the pinned Pair25 adapter")
+    return actual
+
+
+def build_inputs(kind, work, project):
+    revision = PAIR25["verify"](work, project)
+    fieldlog = work / "fieldlog"
+    if (HERE != fieldlog / "Integrations/GeneratedReport/scripts/pair25"
+            or git(fieldlog, "diff", "--name-only")
+            or git(fieldlog, "ls-files", "--others", "--exclude-standard")):
+        raise ValueError("Build from the staged FieldLog tree without working-copy changes")
+    inputs = {
+        "mixerRevision": revision, "mixerTree": ADMISSION["PAIR25_PINS"][revision],
+        "fieldLogTree": git(fieldlog, "write-tree"), "projectLockSHA256": digest(project / "mixer.lock"),
+    }
+    if revision == ADMISSION["PAIR25_RESEALED_REVISION"]:
+        inputs["capabilityFingerprint"] = ADMISSION["PAIR25_RESEALED_FINGERPRINT"]
+    if kind == "java":
+        inputs["generatedJavaSHA256"] = generated_java(work, project)
+        # The maintained recipe compiles every Java file in the app-owned host directory.
+        java = ANDROID_PACKAGE + "/Java/dev/fieldlog/generatedr90/androidhost"
+        tracked = git(fieldlog, "ls-files", "--", java).splitlines()
+        actual = sorted(path.relative_to(fieldlog).as_posix() for path in (fieldlog / java).glob("*.java"))
+        if actual != tracked:
+            raise ValueError("Unexpected FieldLog Java inputs")
+    else:
+        receipt = json.loads((work / "android-engine/receipt.json").read_bytes())
+        sha = digest(work / VM_ARCHIVE)
+        if (receipt["source_revision"] != inputs["mixerRevision"]
+                or receipt["rust_target"] != "aarch64-linux-android" or receipt["library"]["sha256"] != sha):
+            raise ValueError("Android VM archive differs from the pinned producer receipt")
+        inputs["vmArchiveSHA256"] = sha
+    return inputs
+
+
+def outputs(kind, work):
+    return {name: digest(work / name) for name in PRODUCTS[kind]}
+
+
+def receipt_path(kind, work):
+    return work / kind / "pair25-product.json"
+
+
+def verify_products(work, project):
+    result = {}
+    for kind in PRODUCTS:
+        receipt = json.loads(receipt_path(kind, work).read_bytes())
+        if receipt != {"inputs": build_inputs(kind, work, project), "outputs": outputs(kind, work)}:
+            raise ValueError(f"Pair25 {kind} products differ from their build receipt")
+        result[kind] = digest(receipt_path(kind, work))
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("kind", choices=PRODUCTS)
+    parser.add_argument("work", type=Path)
+    parser.add_argument("project", type=Path)
+    args = parser.parse_args()
+    kind, work, project = args.kind, args.work.resolve(strict=True), args.project.resolve(strict=True)
+    inputs = build_inputs(kind, work, project)
+    if (work / kind).exists() or (kind == "jni" and (work / "android-build").exists()):
+        raise ValueError("Pair25 requires a fresh producer output and build cache")
+    if kind == "java":
+        command = [work / "mixer" / RECIPE / "build-java.zsh", work / "fieldlog", project, work / "java"]
+    else:
+        command = [HERE / "build-payload.zsh", work, project]
+    subprocess.run(["/bin/zsh", "-f", *command], cwd=work, env=os.environ, check=True)
+    if build_inputs(kind, work, project) != inputs:
+        raise ValueError("Pair25 inputs changed during the build")
+    with receipt_path(kind, work).open("x") as stream:
+        json.dump({"inputs": inputs, "outputs": outputs(kind, work)}, stream, indent=2, sort_keys=True)
+        stream.write("\n")
+
+
+if __name__ == "__main__":
+    main()
