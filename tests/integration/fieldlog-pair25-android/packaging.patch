@@ -0,0 +1,27 @@
+"""Require the exact public Pair25 checkout and prepared FieldLog projection."""
+from pathlib import Path
+import runpy
+import subprocess
+import sys
+
+admission = runpy.run_path(str(Path(__file__).resolve().parents[1] / "build-android.py"))
+
+
+def verify_checkout(work):
+    sdk = work / "mixer"
+    revision = subprocess.check_output(
+        ["git", "--no-optional-locks", "-C", sdk, "rev-parse", "HEAD"],
+        text=True, timeout=15).strip()
+    if revision != admission["PAIR25_RESEALED_REVISION"]:
+        raise ValueError("Entry Commit packaging requires the exact published Pair25 revision")
+    return admission["admit_sdk"](sdk, sdk / "native/android")
+
+
+def verify(work, project):
+    revision = verify_checkout(work)
+    admission["verify_pair25_projection"](project, work / "mixer", revision)
+    return revision
+
+
+if __name__ == "__main__":
+    verify(*(Path(argument).resolve(strict=True) for argument in sys.argv[1:]))
