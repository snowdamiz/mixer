+def digest_vm_archive(path):
+    # Match the pinned VM producer's archive ceiling.
+    limit = 512 * 1024 * 1024
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    with os.fdopen(fd, "rb") as stream:
+        info = os.fstat(stream.fileno())
+        if not stat.S_ISREG(info.st_mode) or not 0 < info.st_size <= limit:
+            raise ValueError(f"Expected a bounded, regular VM archive: {path}")
+        sha = hashlib.sha256()
+        remaining = limit
+        while chunk := stream.read(min(1024 * 1024, remaining + 1)):
+            remaining -= len(chunk)
+            if remaining < 0:
+                raise ValueError(f"VM archive exceeds the producer limit: {path}")
+            sha.update(chunk)
+    return sha.hexdigest()
+
