+++ b/Integrations/GeneratedReport/Platforms/Android/Java/dev/fieldlog/generatedr90/androidhost/AssignmentNotifications.java
@@ -0,0 +1,55 @@
+package dev.fieldlog.generatedr90.androidhost;
+
+import android.app.PendingIntent;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+import java.nio.charset.StandardCharsets;
+import java.util.UUID;
+
+final class AssignmentNotifications {
+    static final String ACTION = "dev.fieldlog.generatedr90.OPEN_ASSIGNMENT";
+    private static final String ALIAS = "dev.fieldlog.generatedr90.androidhost.AssignmentTap";
+    private static final String URI_PREFIX = "fieldlog-assignment://task/";
+
+    private AssignmentNotifications() {}
+
+    record Route(UUID workspace, UUID project, UUID task) {
+        String encode() { return workspace + "/" + project + "/" + task; }
+        byte[] packet() { return encode().getBytes(StandardCharsets.US_ASCII); }
+
+        static Route decode(String value) {
+            if (value == null || value.length() != 110) return null;
+            String[] parts = value.split("/", -1);
+            if (parts.length != 3) return null;
+            try {
+                Route route = new Route(UUID.fromString(parts[0]), UUID.fromString(parts[1]), UUID.fromString(parts[2]));
+                return route.encode().equals(value) ? route : null;
+            } catch (IllegalArgumentException invalid) {
+                return null;
+            }
+        }
+    }
+
+    private static ComponentName tapComponent(Context context) {
+        return new ComponentName(context, ALIAS);
+    }
+
+    static Route fromTap(Context context, Intent intent) {
+        if (intent == null || !ACTION.equals(intent.getAction()) ||
+                !tapComponent(context).equals(intent.getComponent())) return null;
+        String uri = intent.getDataString();
+        return uri != null && uri.startsWith(URI_PREFIX) ? Route.decode(uri.substring(URI_PREFIX.length())) : null;
+    }
+
+    // Provider integration passes the three verified identities into the
+    // private notification entry point. This method does not post notifications.
+    static PendingIntent contentIntent(Context context, Route route) {
+        Intent tap = new Intent(ACTION).setComponent(tapComponent(context))
+            .setData(Uri.parse(URI_PREFIX + route.encode()))
+            .setIdentifier(UUID.randomUUID().toString())
+            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_SINGLE_TOP | Intent.FLAG_ACTIVITY_REORDER_TO_FRONT);
+        return PendingIntent.getActivity(context, 0, tap, PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_ONE_SHOT);
+    }
+}
