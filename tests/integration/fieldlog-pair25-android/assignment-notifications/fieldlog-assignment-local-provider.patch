+package dev.fieldlog.generatedr90.androidhost;
+
+import android.Manifest;
+import android.app.Activity;
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+
+/** Opt-in provider for an owned development install and a synthetic workspace. */
+public final class AssignmentNotificationFixture extends BroadcastReceiver {
+    private static final String ACTION = "dev.fieldlog.generatedr90.POST_ASSIGNMENT_FIXTURE";
+    private static final String CHANNEL = "fieldlog-assignment-fixture";
+
+    @Override public void onReceive(Context context, Intent intent) {
+        if (!isOrderedBroadcast()) return;
+        setResultCode(Activity.RESULT_CANCELED);
+        if (!ACTION.equals(intent.getAction()) ||
+                (context.getApplicationInfo().flags & ApplicationInfo.FLAG_DEBUGGABLE) == 0 ||
+                context.checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) return;
+        AssignmentNotifications.Route route = AssignmentNotifications.Route.decode(intent.getStringExtra("route"));
+        if (route == null) return;
+        NotificationManager notifications = context.getSystemService(NotificationManager.class);
+        if (notifications == null || !notifications.areNotificationsEnabled()) return;
+        notifications.createNotificationChannel(new NotificationChannel(CHANNEL, "Assignment test", NotificationManager.IMPORTANCE_DEFAULT));
+        notifications.notify(CHANNEL, 1, new Notification.Builder(context, CHANNEL)
+            .setSmallIcon(android.R.drawable.ic_dialog_info)
+            .setContentTitle("FieldLog assignment test")
+            .setContentText("Tap to open the assigned task.")
+            .setAutoCancel(true)
+            .setVisibility(Notification.VISIBILITY_PRIVATE)
+            .setContentIntent(AssignmentNotifications.contentIntent(context, route))
+            .build());
+        setResultCode(Activity.RESULT_OK);
+    }
+}
