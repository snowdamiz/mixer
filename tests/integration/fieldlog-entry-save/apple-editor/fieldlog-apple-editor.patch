@@ -0,0 +1,127 @@
+import XCTest
+
+@MainActor final class FieldLogSignedDraftTests: XCTestCase {
+  func testSignedOptionalFieldSurvivesRollbackAndOrdinarySave() {
+    continueAfterFailure = false
+    let app = XCUIApplication()
+    let workspace = UUID().uuidString
+    let attachment = XCTAttachment(string: workspace)
+    attachment.name = "fieldlog-test-workspace-id"
+    attachment.lifetime = .keepAlways
+    add(attachment)
+
+    launch(app, workspace: workspace, sequence: nil)
+    XCTAssertTrue(app.staticTexts["test-workspace-badge"].waitForExistence(timeout: 15))
+    app.buttons["create-first-project"].tap()
+    let projectName = app.textFields["project-name"]
+    XCTAssertTrue(projectName.waitForExistence(timeout: 10))
+    projectName.tap()
+    projectName.typeText("Signed draft inspection")
+    app.buttons["save-project"].tap()
+    XCTAssertTrue(app.navigationBars["Signed draft inspection"].waitForExistence(timeout: 10))
+    createDraft("Pump seal", app)
+    createDraft("Other draft", app)
+
+    let note = "Seal rechecked during rollback."
+    for sequence in 1...5 {
+      launch(app, workspace: workspace, sequence: sequence)
+      XCTAssertTrue(app.navigationBars["Signed draft inspection"].waitForExistence(timeout: 15))
+      openDraft("Pump seal", app)
+      XCTAssertEqual(title(in: app).value as? String, "Pump seal")
+      openGuest(app, sequence)
+      if sequence == 3 {
+        let mark = app.buttons["Mark follow-up required"]
+        XCTAssertTrue(app.staticTexts["Follow-up unset"].waitForExistence(timeout: 10))
+        XCTAssertTrue(mark.waitForExistence(timeout: 10))
+        mark.tap()
+        XCTAssertTrue(app.staticTexts["Follow-up required"].waitForExistence(timeout: 10))
+      } else if sequence == 5 {
+        XCTAssertTrue(app.staticTexts["Follow-up required"].waitForExistence(timeout: 10))
+      } else {
+        XCTAssertTrue(app.staticTexts["Saved draft loaded"].waitForExistence(timeout: 10))
+        let check = app.buttons["Check saved draft"]
+        XCTAssertTrue(check.waitForExistence(timeout: 10))
+        check.tap()
+        XCTAssertTrue(app.staticTexts["Ready to save entry"].waitForExistence(timeout: 10))
+        XCTAssertFalse(app.buttons["Mark follow-up required"].exists)
+        XCTAssertFalse(app.buttons["Clear follow-up requirement"].exists)
+      }
+      closeGuest(app)
+      if sequence == 4 {
+        let field = app.textViews["entry-note"]
+        reveal(field, app)
+        field.tap()
+        field.typeText(note)
+      }
+      app.buttons["Done"].tap()
+      XCTAssertTrue(app.navigationBars["Signed draft inspection"].waitForExistence(timeout: 10))
+    }
+
+    launch(app, workspace: workspace, sequence: nil)
+    XCTAssertTrue(app.navigationBars["Signed draft inspection"].waitForExistence(timeout: 15))
+    openDraft("Other draft", app)
+    openGuest(app, 5)
+    XCTAssertTrue(app.staticTexts["Follow-up unset"].waitForExistence(timeout: 10))
+    closeGuest(app)
+    app.buttons["Done"].tap()
+    openDraft("Pump seal", app)
+    XCTAssertEqual(app.textViews["entry-note"].value as? String, note)
+    openGuest(app, 5)
+    XCTAssertTrue(app.staticTexts["Follow-up required"].waitForExistence(timeout: 10))
+    closeGuest(app)
+    app.terminate()
+  }
+
+  private func launch(_ app: XCUIApplication, workspace: String, sequence: Int?) {
+    if app.state != .notRunning { app.terminate() }
+    app.launchArguments = ["--fieldlog-ui-workspace", workspace]
+    if let sequence { app.launchArguments += ["--fieldlog-draft-assignment", String(sequence)] }
+    app.launch()
+  }
+
+  private func openGuest(_ app: XCUIApplication, _ sequence: Int) {
+    let button = app.buttons["open-installed-draft"]
+    reveal(button, app)
+    button.tap()
+    let status = app.staticTexts["installed-draft-status"]
+    let ready = NSPredicate(format: "label == %@", "Installed draft ready · \(sequence)")
+    expectation(for: ready, evaluatedWith: status)
+    waitForExpectations(timeout: 20)
+  }
+
+  private func closeGuest(_ app: XCUIApplication) {
+    app.buttons["close-installed-draft"].tap()
+    XCTAssertTrue(app.navigationBars["Field note"].waitForExistence(timeout: 10))
+  }
+
+  private func createDraft(_ name: String, _ app: XCUIApplication) {
+    let add = app.buttons["add-entry"]
+    reveal(add, app)
+    add.tap()
+    let field = title(in: app)
+    XCTAssertTrue(field.waitForExistence(timeout: 10))
+    field.tap()
+    field.typeText(name)
+    app.buttons["Done"].tap()
+    XCTAssertTrue(app.navigationBars["Signed draft inspection"].waitForExistence(timeout: 10))
+  }
+
+  private func openDraft(_ name: String, _ app: XCUIApplication) {
+    let draft = app.buttons.matching(NSPredicate(format: "label CONTAINS %@", name)).firstMatch
+    reveal(draft, app)
+    draft.tap()
+    XCTAssertTrue(app.navigationBars["Field note"].waitForExistence(timeout: 10))
+  }
+
+  private func title(in app: XCUIApplication) -> XCUIElement {
+    app.textFields["entry-title"].exists ? app.textFields["entry-title"] : app.textViews["entry-title"]
+  }
+
+  private func reveal(_ element: XCUIElement, _ app: XCUIApplication) {
+    for _ in 0..<8 {
+      if element.isHittable { return }
+      app.swipeUp()
+    }
+    XCTAssertTrue(element.isHittable)
+  }
+}
