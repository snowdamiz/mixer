diff --git a/ios/FieldLog/InstalledDraftGuest.swift b/ios/FieldLog/InstalledDraftGuest.swift
new file mode 100644
index 0000000000000000000000000000000000000000..0777497216deb7c111ae8efa75e20d2fbab955fe
--- /dev/null
+++ b/ios/FieldLog/InstalledDraftGuest.swift
@@ -0,0 +1,241 @@
+import FieldLogModels
+import Foundation
+@_spi(InstalledApplicationStorage) import MixerCapabilities
+@_spi(InstalledApplicationStorage) import MixerCapabilityActivation
+import MixerRuntimeIdentity
+import SwiftUI
+
+enum InstalledDraftGuest {
+  enum Kind: String, Identifiable {
+    case draftTools = "InstalledDraft"
+    case entryCommit = "InstalledEntryCommit"
+
+    var id: String { rawValue }
+    var title: String { self == .entryCommit ? "Signed entry commit" : "Installed draft tools" }
+
+    var materials: URL? {
+      guard let directory = Bundle.main.resourceURL?.appendingPathComponent(rawValue),
+        FileManager.default.fileExists(atPath: directory.appendingPathComponent("identity.json").path)
+      else { return nil }
+      return directory
+    }
+  }
+
+  static let variants = ["baseline", "corrected", "optional", "corrected", "optional"]
+
+  static func sequence(isTestWorkspace: Bool) throws -> Int? {
+    #if DEBUG
+      let arguments = ProcessInfo.processInfo.arguments
+      if isTestWorkspace, let marker = arguments.firstIndex(of: "--fieldlog-draft-assignment") {
+        let index = marker + 1
+        guard arguments.indices.contains(index), let sequence = Int(arguments[index]),
+          (1...variants.count).contains(sequence)
+        else { throw FieldLogError.validation("Invalid local draft assignment.") }
+        return sequence
+      }
+    #endif
+    return nil
+  }
+
+  @MainActor static func open(
+    materials: URL, workspaceDirectory: URL, storage: SelectedDraftGuestAccess, bundleID: String?
+  ) async throws -> CapabilityGuestUIRuntime {
+    let identityBytes = try read("identity.json", in: materials)
+    let identity = try CapabilityRuntimeIdentity(json: identityBytes)
+    #if targetEnvironment(simulator) || os(macOS)
+      let environment = "simulator"
+    #else
+      let environment = "device"
+    #endif
+    guard identity.descriptor.object?["application"]?.object?["bundle_id"]?.text
+        == bundleID,
+      identity.descriptor.object?["platform"]?.object?["environment"]?.text == environment,
+      identity.installedRuntime.scope.platform == "ios"
+    else { throw CapabilityFailure.permissionDenied }
+
+    let commit = storage.commit
+    var roles: [(String, CapabilityMaterialFile.Role)] = [
+      ("bridge.json", .bridgePolicy),
+      ("storage.json", .configuration(capabilityID: CapabilitySchemas.storageID)),
+      ("storage-grant.json", .installedGrant(capabilityID: CapabilitySchemas.storageID)),
+    ]
+    if commit == nil {
+      roles += [
+        ("http.json", .configuration(capabilityID: CapabilitySchemas.httpID)),
+        ("http-grant.json", .installedGrant(capabilityID: CapabilitySchemas.httpID)),
+      ]
+    }
+    let execution = try InstalledCapabilityExecution(
+      identityJSON: identityBytes,
+      materials: roles.map { .init(role: $0.1, bytes: try read($0.0, in: materials)) },
+      trustRootsJSON: read("roots.json", in: materials), privateContainer: workspaceDirectory,
+      applicationStorage: .init(
+        runtimeFingerprint: identity.fingerprint, namespace: FieldLogDraftStorage.namespace,
+        service: storage, allowsDeferredGuestUIStartup: commit == nil,
+        guestUICommitFacts: commit?.continuation))
+    return try await CapabilityGuestUIRuntime.open(
+      configuration: .init(
+        directory: workspaceDirectory.appendingPathComponent(
+          commit == nil ? "installed-draft-recovery" : "installed-entry-commit-recovery"),
+        channel: "beta", installation: "fieldlog-ios-local", observationSeconds: 1),
+      execution: execution)
+  }
+
+  static func stage(
+    _ sequence: Int, kind: Kind = .draftTools, in materials: URL, on owner: CapabilityGuestUIRuntime
+  ) async throws {
+    guard (kind == .entryCommit ? sequence == 1 : (1...variants.count).contains(sequence)) else {
+      throw CapabilityFailure.permissionDenied
+    }
+    let expected = UInt64(sequence)
+    let snapshot = await owner.recoverySnapshot()
+    if snapshot.acceptedSequence == expected, snapshot.downloading == nil { return }
+    guard snapshot.acceptedSequence == expected || snapshot.acceptedSequence == expected - 1
+    else { throw FieldLogError.validation("Local draft assignment is out of order.") }
+    let variant = kind == .entryCommit ? "entry-commit" : variants[sequence - 1]
+    let assignment = kind == .entryCommit ? "entry-commit.assignment.json" : "sequence-\(sequence).assignment.json"
+    if snapshot.acceptedSequence < expected {
+      try await owner.beginDownload(
+        signedManifest: read("\(variant).manifest.json", in: materials),
+        signedAssignment: read(assignment, in: materials))
+    }
+    let payload = try read("\(variant).wasm", in: materials, maximum: 4_194_304)
+    let offset = try await owner.downloadOffset()
+    guard offset <= UInt64(payload.count) else { throw CapabilityFailure.invalidResponse }
+    var position = Int(offset)
+    while position < payload.count {
+      let end = min(payload.count, position + 1_048_576)
+      try await owner.appendDownload(Data(payload[position..<end]), atOffset: UInt64(position))
+      position = end
+    }
+    try await owner.finishDownload()
+  }
+
+  private static func read(_ name: String, in directory: URL, maximum: Int = 65_536) throws -> Data {
+    let file = try FileHandle(forReadingFrom: directory.appendingPathComponent(name))
+    defer { try? file.close() }
+    guard let bytes = try file.read(upToCount: maximum + 1), !bytes.isEmpty, bytes.count <= maximum
+    else { throw CapabilityFailure.invalidResponse }
+    return bytes
+  }
+}
+
+#if os(iOS)
+struct InstalledDraftGuestView: View {
+  @EnvironmentObject private var model: WorkspaceModel
+  @Environment(\.dismiss) private var dismiss
+  @State private var access: SelectedDraftGuestAccess?
+  @State private var owner: CapabilityGuestUIRuntime?
+  @State private var running: Task<Void, Never>?
+  @State private var closing = false
+  @State private var completion: WorkspaceModel.DraftGuestClose?
+  @State private var status = "Opening installed draft tools"
+  let draft: EntryDraft
+  let kind: InstalledDraftGuest.Kind
+  let materials: URL
+  let onCommit: () -> Void
+
+  var body: some View {
+    NavigationStack {
+      VStack(spacing: 12) {
+        Text(status).accessibilityIdentifier("installed-draft-status")
+        if let owner { MixerGuestScreen(presentation: owner.presentation) }
+      }
+      .padding()
+      .navigationTitle(kind.title)
+      .navigationBarTitleDisplayMode(.inline)
+      .toolbar {
+        ToolbarItem(placement: .cancellationAction) {
+          Button(closeTitle, action: requestClose)
+          .disabled(closing)
+          .accessibilityIdentifier(kind == .entryCommit ? "close-entry-commit" : "close-installed-draft")
+        }
+      }
+    }
+    .interactiveDismissDisabled()
+    .task {
+      let work = Task { await run() }
+      running = work
+      if closing { work.cancel() }
+      await withTaskCancellationHandler {
+        await work.value
+      } onCancel: { work.cancel() }
+    }
+    .onDisappear { access?.revoke() }
+  }
+
+  private var closeTitle: String {
+    if completion == .retirementPending { return "Retry closing" }
+    return kind == .entryCommit ? "Done" : "Close"
+  }
+
+  private func requestClose() {
+    closing = true
+    if completion == .retirementPending {
+      completion = nil
+      running = Task { await retire() }
+      return
+    }
+    access?.revoke()
+    running?.cancel()
+    finishIfRequested()
+  }
+
+  private func finishIfRequested() {
+    guard closing, let completion, completion != .retirementPending else { return }
+    if completion == .committed { onCommit() }
+    dismiss()
+  }
+
+  private func run() async {
+    do {
+      try Task.checkCancellation()
+      guard let directory = model.workspaceDirectory else { throw FieldLogError.missingRecord }
+      let attached = switch kind {
+        case .draftTools: try await model.attachDraftGuest(projectID: draft.projectID, draftID: draft.id)
+        case .entryCommit: try await model.attachDraftCommit(draft)
+      }
+      access = attached
+      try Task.checkCancellation()
+      let runtime = try await InstalledDraftGuest.open(
+        materials: materials, workspaceDirectory: directory, storage: attached,
+        bundleID: Bundle.main.bundleIdentifier)
+      owner = runtime
+      let sequence = kind == .entryCommit ? 1 : try InstalledDraftGuest.sequence(isTestWorkspace: model.isTestWorkspace)
+      if let sequence { try await InstalledDraftGuest.stage(sequence, kind: kind, in: materials, on: runtime) }
+      try Task.checkCancellation()
+      _ = try await runtime.start()
+      while !Task.isCancelled {
+        let snapshot = await runtime.recoverySnapshot()
+        if snapshot.activation.phase == .healthyGuest {
+          let ready = kind == .entryCommit ? "Signed entry commit ready" : "Installed draft ready · \(snapshot.acceptedSequence)"
+          if status != ready { status = ready }
+        } else if [.nativeFallback, .recoveryRequired, .closed].contains(snapshot.activation.phase) {
+          status = "Installed draft tools unavailable"
+          break
+        }
+        try await Task.sleep(for: .milliseconds(100))
+      }
+    } catch {
+      if !Task.isCancelled { status = "Installed draft tools unavailable" }
+    }
+    await retire()
+  }
+
+  private func retire() async {
+    if let access {
+      completion = await model.finishDraftGuest(access, owner: owner)
+    } else {
+      completion = .closed
+    }
+    if completion == .retirementPending {
+      closing = false
+      status = "Installed draft tools are still closing."
+      return
+    }
+    access = nil
+    owner = nil
+    finishIfRequested()
+  }
+}
+#endif
