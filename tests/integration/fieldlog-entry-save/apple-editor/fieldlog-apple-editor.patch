+import FieldLogEntrySaving
+import FieldLogModels
+import FieldLogStorage
+import Foundation
+import os
+@_spi(InstalledApplicationStorage) import MixerCapabilities
+
+@MainActor final class SelectedDraftGuestBinding {
+  private struct Selection: Equatable {
+    let projectID: UUID
+    let draftID: UUID
+    let generation = UUID()
+  }
+
+  private var selection: Selection?
+  private var access: SelectedDraftGuestAccess?
+
+  func select(_ draft: EntryDraft?) {
+    access?.revoke()
+    access = nil
+    selection = draft.map { Selection(projectID: $0.projectID, draftID: $0.id) }
+  }
+
+  func attach(
+    repository: WorkspaceRepository, projectID: UUID, draftID: UUID
+  ) async throws -> SelectedDraftGuestAccess {
+    guard let selection, selection.projectID == projectID, selection.draftID == draftID,
+      access == nil
+    else { throw CapabilityFailure.permissionDenied }
+    let storage = try await FieldLogDraftStorage(
+      repository: repository, projectID: projectID, draftID: draftID)
+    try Task.checkCancellation()
+    guard self.selection == selection, access == nil else { throw CapabilityFailure.permissionDenied }
+    let attached = SelectedDraftGuestAccess(storage: storage)
+    access = attached
+    return attached
+  }
+
+  func attachCommit(
+    repository: WorkspaceRepository, draft: EntryDraft, expectedRevision: UInt64
+  ) async throws -> SelectedDraftGuestAccess {
+    guard let selection, selection.projectID == draft.projectID, selection.draftID == draft.id,
+      access == nil
+    else { throw CapabilityFailure.permissionDenied }
+    let snapshot = try await repository.readCommittedSnapshot()
+    try Task.checkCancellation()
+    guard self.selection == selection, access == nil, snapshot.revision == expectedRevision,
+      snapshot.restoration.openDraftID == draft.id,
+      let saved = snapshot.drafts.first(where: { $0.id == draft.id && $0.projectID == draft.projectID }),
+      saved.title.utf8.elementsEqual(draft.title.utf8), saved.note.utf8.elementsEqual(draft.note.utf8),
+      saved.category == draft.category, saved.occurredAt == draft.occurredAt
+    else { throw CapabilityFailure.permissionDenied }
+    let attached = SelectedDraftGuestAccess(commit: .init(
+      repository: repository, sourceRevision: expectedRevision,
+      intent: .init(projectID: saved.projectID, draft: saved, kind: .commit)))
+    access = attached
+    return attached
+  }
+
+  @discardableResult func detach(_ attached: SelectedDraftGuestAccess) -> Bool {
+    attached.revoke()
+    guard access === attached else { return false }
+    access = nil
+    return true
+  }
+}
+
+@MainActor final class SelectedDraftGuestAccess: InstalledApplicationStorageServing {
+  private var storage: FieldLogDraftStorage?
+  let commit: SelectedDraftEntryCommit?
+  private var pending: [UUID: () -> Void] = [:]
+
+  init(storage: FieldLogDraftStorage) {
+    self.storage = storage
+    commit = nil
+  }
+
+  init(commit: SelectedDraftEntryCommit) { self.commit = commit }
+
+  func revoke() {
+    commit?.revoke()
+    storage = nil
+    for cancel in pending.values { cancel() }
+    pending.removeAll()
+  }
+
+  func get(_ arguments: KVGetArguments) async throws -> KVGetResponse {
+    try await perform { try await $0.get(arguments) }
+  }
+
+  func put(
+    _ arguments: KVPutArguments, maximumTotalBytes: Int, maximumEntries: Int
+  ) async throws -> KVMutationResponse {
+    try await perform {
+      try await $0.put(arguments, maximumTotalBytes: maximumTotalBytes, maximumEntries: maximumEntries)
+    }
+  }
+
+  func delete(_ arguments: KVDeleteArguments) async throws -> KVMutationResponse {
+    try await perform { try await $0.delete(arguments) }
+  }
+
+  private func perform<Result: Sendable>(
+    _ operation: @escaping @Sendable (FieldLogDraftStorage) async throws -> Result
+  ) async throws -> Result {
+    guard let storage else { throw CapabilityFailure.permissionDenied }
+    try Task.checkCancellation()
+    let id = UUID()
+    let work = Task { try await operation(storage) }
+    pending[id] = { work.cancel() }
+    defer { pending.removeValue(forKey: id) }
+    let result = try await withTaskCancellationHandler {
+      try await work.value
+    } onCancel: {
+      work.cancel()
+    }
+    try Task.checkCancellation()
+    guard self.storage != nil else { throw CapabilityFailure.permissionDenied }
+    return result
+  }
+}
+
+final class SelectedDraftEntryCommit: Sendable {
+  private let repository: WorkspaceRepository
+  private let sourceRevision: UInt64
+  private let intent: EntrySaveIntent
+  private let active = OSAllocatedUnfairLock(initialState: true)
+
+  init(repository: WorkspaceRepository, sourceRevision: UInt64, intent: EntrySaveIntent) {
+    self.repository = repository
+    self.sourceRevision = sourceRevision
+    self.intent = intent
+  }
+
+  func revoke() { active.withLock { $0 = false } }
+
+  var continuation: InstalledGuestUICommitFacts {
+    .init(
+      arguments: .init(namespace: FieldLogDraftStorage.namespace, key: "entry-save-decision-v1"),
+      nodeID: "toggle", actionID: "entry.commit",
+      commitArguments: .init(
+        namespace: FieldLogDraftStorage.namespace, key: "entry-commit-v1", valueBase64: "AQ==")
+    ) { [self] event in
+      let snapshot = try await repository.readCommittedSnapshot()
+      guard snapshot.revision == sourceRevision, isSelected(in: snapshot),
+        event.isLive, active.withLock({ $0 })
+      else { throw CapabilityFailure.permissionDenied }
+      let facts = intent.decisionFacts()
+      var bytes = withUnsafeBytes(of: facts.counts.bigEndian) { Data($0) }
+      bytes.append(facts.flags)
+      let response = KVGetResponse(found: true, valueBase64: bytes.base64EncodedString())
+      guard facts.decision == .eligible else { return .init(response: response) }
+      return .init(response: response) { permit in try await self.commit(permit) }
+    }
+  }
+
+  func committedEntry(in snapshot: Workspace) -> Bool {
+    if case .committed? = try? intent.result(in: snapshot) { return true }
+    return false
+  }
+
+  private func isSelected(in snapshot: Workspace) -> Bool {
+    snapshot.restoration.openDraftID == intent.draft.id &&
+      snapshot.drafts.contains { $0.id == intent.draft.id && $0.projectID == intent.projectID }
+  }
+
+  private func commit(_ permit: InstalledGuestUICommitPermit) async throws -> KVMutationResponse {
+    do {
+      let saved = try await repository.transact(expectedRevision: sourceRevision) { [self] next in
+        guard isSelected(in: next) else { throw CapabilityFailure.permissionDenied }
+        try active.withLock {
+          guard $0 else { throw CapabilityFailure.permissionDenied }
+          try permit.consume()
+          $0 = false
+        }
+        try intent.apply(to: &next)
+      }
+      guard committedEntry(in: saved) else { throw CapabilityFailure.invalidResponse }
+      return .init(committed: true)
+    } catch FieldLogError.staleRevision {
+      throw CapabilityFailure.permissionDenied
+    }
+  }
+}
