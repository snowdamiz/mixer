+  enum DraftGuestClose { case closed, committed, workspaceUnavailable, retirementPending }
+
+  func finishDraftGuest(
+    _ access: SelectedDraftGuestAccess, owner: CapabilityGuestUIRuntime?
+  ) async -> DraftGuestClose {
+    access.revoke()
+    if let owner {
+      // The presentation cancels its task on Done. Join concrete retirement
+      // independently of that cancellation before publishing the snapshot.
+      let retired = await Task {
+        await owner.close()
+        let deadline = ContinuousClock.now + .seconds(5)
+        while true {
+          let snapshot = await owner.recoverySnapshot()
+          if snapshot.closed, !snapshot.activation.cleanupPending { return true }
+          if ContinuousClock.now >= deadline { return false }
+          try? await Task.sleep(for: .milliseconds(10))
+        }
+      }.value
+      guard retired else { return .retirementPending }
+    }
+    guard draftGuestBinding.detach(access), let commit = access.commit, let repository else {
+      return .closed
+    }
+    do {
+      let saved = try await repository.readCommittedSnapshot()
+      workspace = saved
+      return commit.committedEntry(in: saved) ? .committed : .closed
+    } catch {
+      saveError = "Reopen FieldLog to check whether the entry was saved."
+      return .workspaceUnavailable
+    }
+  }
+
   func closeDraft() {
+    selectDraftEditor(nil)
     guard workspace?.restoration.openDraftID != nil else { return }
     enqueue { $0.restoration.openDraftID = nil }
   }
