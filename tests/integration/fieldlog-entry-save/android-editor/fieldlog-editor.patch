+            try intent.validate()
+            return .init(response: response) { permit in try await self.commit(permit) }
+        }
+    }
+
+    private func hasSelectedDraft(in workspace: Workspace) -> Bool {
+        workspace.drafts.contains { $0.id == intent.draft.id && $0.projectID == intent.projectID }
+    }
