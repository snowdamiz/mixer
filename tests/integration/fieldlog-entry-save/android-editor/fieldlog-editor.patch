@@ -0,0 +1,91 @@
+#if FIELDLOG_SIGNED_CHECKLIST && FIELDLOG_ENTRY_COMMIT_FIXTURE
+import FieldLogFeatures
+@_spi(FieldLogEntryCommitFixture) import FieldLogInstalledGuest
+import FieldLogModels
+import FieldLogStorage
+import Foundation
+@_spi(InstalledApplicationStorage) import MixerCapabilities
+
+extension ProjectPresentation {
+    func openSignedEntryCommit(material: URL, directory: URL, bundleID: String,
+                               installation: UUID) async throws -> FieldLogSignedTask {
+        let binding = try attachSignedEntryCommit()
+        return try await FieldLogSignedTask.openEntryCommit(storage: binding, material: material, directory: directory,
+            bundleID: bundleID, installation: installation, facts: binding.continuation)
+    }
+}
