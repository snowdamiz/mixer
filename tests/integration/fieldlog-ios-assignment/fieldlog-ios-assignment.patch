+@MainActor final class FieldLogAppDelegate: NSObject, UIApplicationDelegate, UNUserNotificationCenterDelegate {
+  let assignments = AssignmentNotificationRouter()
+
+  func application(
+    _ application: UIApplication,
+    didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]? = nil
+  ) -> Bool {
+    UNUserNotificationCenter.current().delegate = self
+    return true
+  }
+
+  nonisolated func userNotificationCenter(
+    _ center: UNUserNotificationCenter, didReceive response: UNNotificationResponse
+  ) async {
+    guard response.actionIdentifier == UNNotificationDefaultActionIdentifier,
+      let notification = AssignmentNotification(userInfo: response.notification.request.content.userInfo)
+    else { return }
+    await openAssignment(notification)
+  }
+
+  private func openAssignment(_ notification: AssignmentNotification) {
+    assignments.receive(notification)
+  }
+
+  nonisolated func userNotificationCenter(
+    _ center: UNUserNotificationCenter, willPresent notification: UNNotification
+  ) async -> UNNotificationPresentationOptions {
+    [.banner, .list]
+  }
+}
+
+#if DEBUG
+@MainActor enum LocalAssignmentNotification {
+  static func post(_ notification: AssignmentNotification) async throws {
+    let center = UNUserNotificationCenter.current()
+    guard try await center.requestAuthorization(options: [.alert]) else {
+      throw LocalAssignmentNotificationError.permissionDenied
+    }
+    let content = UNMutableNotificationContent()
+    content.title = "FieldLog assignment"
+    content.body = "Open the assigned task."
+    content.userInfo = notification.userInfo
+    try await center.add(UNNotificationRequest(
+      identifier: UUID().uuidString, content: content, trigger: nil))
+  }
+}
+
+private enum LocalAssignmentNotificationError: LocalizedError {
+  case permissionDenied
+
+  var errorDescription: String? { "Allow FieldLog notifications in Settings to post a test assignment." }
+}
+#endif
