+++ b/Sources/FieldLogFeatures/AssignmentNotification.swift
@@ -0,0 +1,60 @@
+import FieldLogModels
+import Foundation
+
+public struct AssignmentNotification: Sendable, Equatable {
+  public let workspaceID: UUID
+  public let projectID: UUID
+  public let taskID: UUID
+
+  public init(workspaceID: UUID, projectID: UUID, taskID: UUID) {
+    self.workspaceID = workspaceID
+    self.projectID = projectID
+    self.taskID = taskID
+  }
+
+  public init?(userInfo: [AnyHashable: Any]) {
+    guard userInfo["kind"] as? String == "fieldlog.task-assignment",
+      let workspace = userInfo["workspaceID"] as? String, let workspaceID = UUID(uuidString: workspace),
+      let project = userInfo["projectID"] as? String, let projectID = UUID(uuidString: project),
+      let task = userInfo["taskID"] as? String, let taskID = UUID(uuidString: task)
+    else { return nil }
+    self.init(workspaceID: workspaceID, projectID: projectID, taskID: taskID)
+  }
+
+  public var userInfo: [String: String] {
+    [
+      "kind": "fieldlog.task-assignment", "workspaceID": workspaceID.uuidString,
+      "projectID": projectID.uuidString, "taskID": taskID.uuidString,
+    ]
+  }
+}
+
+public enum AssignmentDestination: Equatable, Sendable {
+  case task(Project, WorkTask)
+  case unavailable
+}
+
+#if canImport(Combine)
+import Combine
+
+@MainActor public final class AssignmentNotificationRouter: ObservableObject {
+  @Published private var pending: AssignmentNotification?
+
+  public init() {}
+
+  public func receive(_ notification: AssignmentNotification) {
+    pending = notification
+  }
+
+  public func destination(in workspace: Workspace?, loading: Bool) -> AssignmentDestination? {
+    guard let pending, !loading else { return nil }
+    guard let workspace, workspace.id == pending.workspaceID,
+      let project = workspace.projects.first(where: { $0.id == pending.projectID }),
+      let task = workspace.tasks.first(where: { $0.id == pending.taskID && $0.projectID == project.id })
+    else { return .unavailable }
+    return .task(project, task)
+  }
+
+  public func close() { pending = nil }
+}
+#endif
diff --git a/Tests/FieldLogTests/AssignmentNotificationTests.swift b/Tests/FieldLogTests/AssignmentNotificationTests.swift
new file mode 100644
index 0000000..6c77952
--- /dev/null
+++ b/Tests/FieldLogTests/AssignmentNotificationTests.swift
@@ -0,0 +1,132 @@
+#if canImport(SwiftUI)
+import CryptoKit
+import FieldLogFeatures
+import FieldLogModels
+import FieldLogStorage
+import Foundation
+import MixerUI
+import Testing
+
+@Suite @MainActor struct AssignmentNotificationTests {
+  @Test func warmTapReturnsToUnsavedTaskEditor() async throws {
+    try await withWorkspace { _, repository, committed, route in
+      let editor = try TaskEditorAppleFieldsHost { _, _ in
+        Issue.record("Opening or closing an assignment must never save the editor.")
+        return .failed("Unexpected save")
+      }
+      defer { try? editor.close() }
+      let render = editor.snapshot.render
+      let title = "Unsaved title in the existing task editor"
+      editor.send(UIEventEnvelope(
+        revision: render.document.revision,
+        identity: try #require(render.identity(for: "task.title")),
+        event: .textChange, value: .string(title)))
+      #expect(editor.snapshot.state.title == title)
+      #expect(editor.eventFailure == nil)
+
+      let router = AssignmentNotificationRouter()
+      router.receive(try #require(AssignmentNotification(userInfo: route.userInfo)))
+      let workspace = await repository.snapshot()
+      #expect(router.destination(in: workspace, loading: false) ==
+        .task(try project(route, in: committed), try task(route, in: committed)))
+      router.close()
+      #expect(router.destination(in: workspace, loading: false) == nil)
+      #expect(editor.snapshot.state.title == title)
+      #expect(editor.snapshot.outcome == .editing)
+    }
+  }
+
+  @Test func coldTapWaitsForPersistedWorkspace() async throws {
+    try await withWorkspace { directory, repository, committed, route in
+      await repository.close()
+      let router = AssignmentNotificationRouter()
+      router.receive(try #require(AssignmentNotification(userInfo: route.userInfo)))
+      #expect(router.destination(in: nil, loading: true) == nil)
+
+      let reopened = try WorkspaceRepository(directory: directory)
+      let loaded = await reopened.snapshot()
+      #expect(loaded == committed)
+      #expect(router.destination(in: loaded, loading: false) ==
+        .task(try project(route, in: committed), try task(route, in: committed)))
+      router.close()
+      #expect(router.destination(in: loaded, loading: false) == nil)
+      await reopened.close()
+    }
+  }
+
+  @Test func unavailableTargetsPreserveWorkspaceAndOutboxBytes() async throws {
+    try await withWorkspace { _, repository, committed, route in
+      let otherProject = try #require(committed.projects.first { $0.id != route.projectID })
+      let invalidRoutes = [
+        AssignmentNotification(workspaceID: route.workspaceID, projectID: route.projectID, taskID: UUID()),
+        AssignmentNotification(workspaceID: UUID(), projectID: route.projectID, taskID: route.taskID),
+        AssignmentNotification(workspaceID: route.workspaceID, projectID: otherProject.id, taskID: route.taskID),
+        AssignmentNotification(workspaceID: route.workspaceID, projectID: UUID(), taskID: route.taskID),
+      ]
+      let router = AssignmentNotificationRouter()
+      for invalid in invalidRoutes {
+        router.receive(try #require(AssignmentNotification(userInfo: invalid.userInfo)))
+        let workspace = await repository.snapshot()
+        #expect(router.destination(in: workspace, loading: false) == .unavailable)
+        router.close()
+        #expect(router.destination(in: workspace, loading: false) == nil)
+      }
+      router.receive(route)
+      #expect(router.destination(in: nil, loading: false) == .unavailable)
+    }
+  }
+
+  @Test func unrelatedOrMalformedPayloadDoesNotCreateARoute() {
+    let payload = AssignmentNotification(workspaceID: UUID(), projectID: UUID(), taskID: UUID()).userInfo
+    #expect(AssignmentNotification(userInfo: payload) != nil)
+    for key in payload.keys {
+      var missing = payload
+      missing.removeValue(forKey: key)
+      #expect(AssignmentNotification(userInfo: missing) == nil)
+      var malformed = payload
+      malformed[key] = "unrelated"
+      #expect(AssignmentNotification(userInfo: malformed) == nil)
+    }
+  }
+
+  private func project(_ route: AssignmentNotification, in workspace: Workspace) throws -> Project {
+    try #require(workspace.projects.first { $0.id == route.projectID })
+  }
+
+  private func task(_ route: AssignmentNotification, in workspace: Workspace) throws -> WorkTask {
+    try #require(workspace.tasks.first { $0.id == route.taskID })
+  }
+
+  private func withWorkspace(
+    _ test: String = #function,
+    check: (URL, WorkspaceRepository, Workspace, AssignmentNotification) async throws -> Void
+  ) async throws {
+    let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+    defer { try? FileManager.default.removeItem(at: directory) }
+    let repository = try WorkspaceRepository(directory: directory)
+    let firstProject = UUID()
+    let assignedProject = UUID()
+    let committed = try await repository.transact {
+      try $0.createProject(id: firstProject, title: "First site", site: "")
+      try $0.createProject(id: assignedProject, title: "Assigned site", site: "")
+      try $0.saveTask(projectID: firstProject, title: "Inspect gate", responsible: "Other person")
+      try $0.saveTask(projectID: assignedProject, title: "Inspect gate", responsible: "Avery")
+      $0.restoration.selectedProjectID = firstProject
+    }
+    let assigned = try #require(committed.tasks.first { $0.projectID == assignedProject })
+    let route = AssignmentNotification(
+      workspaceID: committed.id, projectID: assignedProject, taskID: assigned.id)
+    let snapshot = directory.appendingPathComponent("workspace.json")
+    let before = try Data(contentsOf: snapshot)
+    #expect(committed.outbox.count == 4)
+
+    try await check(directory, repository, committed, route)
+
+    let after = try Data(contentsOf: snapshot)
+    #expect(after == before)
+    #expect(await repository.snapshot().outbox == committed.outbox)
+    print("\(test): workspace snapshot before \(SHA256.hash(data: before)), after \(SHA256.hash(data: after)), revision \(committed.revision), outbox \(committed.outbox.count)")
+    await repository.close()
+  }
+}
+#endif
