diff --git a/ios/FieldLog/AssignmentNotificationPresentation.swift b/ios/FieldLog/AssignmentNotificationPresentation.swift
new file mode 100644
index 0000000..5ca5b33
--- /dev/null
+++ b/ios/FieldLog/AssignmentNotificationPresentation.swift
@@ -0,0 +1,125 @@
+import FieldLogFeatures
+import SwiftUI
+
+struct AssignmentNotificationPresentation: View {
+  @ObservedObject var router: AssignmentNotificationRouter
+  @EnvironmentObject private var model: WorkspaceModel
+  @Environment(\.scenePhase) private var scenePhase
+
+  var body: some View {
+    AssignmentWindowPresenter(
+      destination: router.destination(in: model.workspace, loading: model.loading),
+      active: scenePhase == .active,
+      close: router.close
+    )
+  }
+}
+
+private struct AssignmentWindowPresenter: UIViewRepresentable {
+  let destination: AssignmentDestination?
+  let active: Bool
+  let close: () -> Void
+
+  func makeUIView(context: Context) -> Anchor {
+    let anchor = Anchor()
+    anchor.isUserInteractionEnabled = false
+    return anchor
+  }
+
+  func updateUIView(_ anchor: Anchor, context: Context) {
+    anchor.update(destination: destination, active: active, close: close)
+  }
+
+  static func dismantleUIView(_ anchor: Anchor, coordinator: ()) {
+    anchor.dismiss()
+  }
+
+  // The workspace window keeps its navigation stack, sheets and unsaved editor
+  // alive while the assignment is open.
+  final class Anchor: UIView {
+    private var assignmentWindow: UIWindow?
+    private var destination: AssignmentDestination?
+    private var shownDestination: AssignmentDestination?
+    private var active = false
+    private var close: (() -> Void)?
+
+    func update(destination: AssignmentDestination?, active: Bool, close: @escaping () -> Void) {
+      self.destination = destination
+      self.active = active
+      self.close = close
+      presentIfReady()
+    }
+
+    override func didMoveToWindow() {
+      super.didMoveToWindow()
+      if window == nil {
+        dismiss()
+      } else {
+        presentIfReady()
+      }
+    }
+
+    private func presentIfReady() {
+      guard let destination else {
+        dismiss()
+        return
+      }
+      guard active, let scene = window?.windowScene, let close else { return }
+      guard destination != shownDestination else { return }
+      let controller = UIHostingController(
+        rootView: AssignedTaskView(destination: destination, close: close).tint(FieldStyle.green))
+      controller.view.accessibilityViewIsModal = true
+      let overlay = assignmentWindow ?? UIWindow(windowScene: scene)
+      overlay.windowLevel = .normal + 1
+      overlay.rootViewController = controller
+      assignmentWindow = overlay
+      shownDestination = destination
+      overlay.makeKeyAndVisible()
+    }
+
+    func dismiss() {
+      guard let overlay = assignmentWindow else { return }
+      let wasKey = overlay.isKeyWindow
+      overlay.isHidden = true
+      overlay.rootViewController = nil
+      assignmentWindow = nil
+      shownDestination = nil
+      if wasKey { window?.makeKey() }
+    }
+  }
+}
+
+private struct AssignedTaskView: View {
+  let destination: AssignmentDestination
+  let close: () -> Void
+
+  var body: some View {
+    NavigationStack {
+      Group {
+        switch destination {
+        case .task(let project, let task):
+          List {
+            Section(project.title) {
+              Text(task.title).font(.headline)
+              if !task.responsible.isEmpty {
+                LabeledContent("Responsible", value: task.responsible)
+              }
+              LabeledContent("Status", value: task.completed ? "Complete" : "Open")
+            }
+          }
+        case .unavailable:
+          ContentUnavailableView(
+            "Assignment unavailable", systemImage: "checklist",
+            description: Text("This task could not be found in the current workspace."))
+        }
+      }
+      .navigationTitle("Assigned task")
+      .navigationBarTitleDisplayMode(.inline)
+      .toolbar {
+        ToolbarItem(placement: .topBarLeading) {
+          Button("Back", systemImage: "chevron.backward", action: close)
+        }
+      }
+    }
+  }
+}
