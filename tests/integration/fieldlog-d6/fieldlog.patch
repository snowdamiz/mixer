+        let stored = await opened.recovery()
+        guard isCurrent(operation) else { return }
+        guard stored.healthy == candidate, stored.staged == nil, !stored.requiresReopen,
+              !stored.incompleteAttempt else {
+          throw FieldLogError.validation("The saved checklist is unavailable.")
+        }
