+    guard !FileManager.default.fileExists(atPath: path.path) else { return }
+    let packet: [String: Any] = [
+      "schema": 1, "operation": operation.id.uuidString, "trigger": trigger,
+      "publishedPhase": String(describing: state.activation.phase), "acceptedSequence": state.acceptedSequence,
+      "healthyCandidate": state.healthy as Any? ?? NSNull(), "incompleteAttempt": state.incompleteAttempt,
+      "runtime": runtime,
+    ]
+    guard let encoded = try? JSONSerialization.data(withJSONObject: packet, options: [.sortedKeys]),
+          encoded.count <= 4096 else { return }
+    try? encoded.write(to: path, options: .atomic)
+  }
+
+  private struct RotationObservation: Encodable {
+    let installation: String
+    let process: Int32
+    let deliveryError: String?
+    let healthLaunch: String
+    let milestones: [String]
+    let artifact: String
+    let payload: String
+    let candidates: [String]
+    let previous: String?
+  }
+
+  private struct Observation: Encodable {
+    let workspaceID: UUID
+    let taskID: UUID
+    let projectID: UUID
+    let taskBytes: Data
+    let workspaceSHA256: String
+    let revision: UInt64
+    let outbox: Int
+    let lastChangeID: UUID?
+    let lastChangeRecord: UUID?
+    let candidate: String
+    let launch: String
+    let sequence: UInt64
+    let partialBytes: Int
+    let partialSHA256: String?
+    let partialArtifactSHA256: String?
+    let partialPrefixSHA256: String?
+    let launchedArtifactSHA256: String?
+    let replayedPrefixBytes: Int
+    let replayedPrefixSHA256: String?
+    let rotation: RotationObservation?
+  }
+
+  @MainActor private func observe(_ guest: FieldLogSignedTask) async throws -> String {
+    let health = await guest.recovery()
+    guard health.activation.phase == .healthyGuest,
+          let candidate = health.healthy, candidate == health.activation.candidateID,
+          let launch = health.activation.launchID else { return "" }
+    let workspace = try await repository.readCommittedSnapshot()
+    let savedURL = recoveryDirectory.deletingLastPathComponent().appendingPathComponent("workspace.json")
+    let savedBytes = try Data(contentsOf: savedURL)
+    guard try JSONDecoder().decode(Workspace.self, from: savedBytes) == workspace,
+          let saved = workspace.tasks.first(where: { $0.id == task.id && $0.projectID == task.projectID })
+    else { return "" }
+    let encoder = JSONEncoder()
+    encoder.outputFormatting = [.sortedKeys, .withoutEscapingSlashes]
+    let spool = try? Data(contentsOf: recoveryDirectory.appendingPathComponent("artifact.partial"))
+    let delivered = deliveryObservation.flatMap { $0.stagedCandidate == candidate ? $0 : nil }
+    var rotation: RotationObservation?
+    if useStoredRotationInstallation {
+      let url = recoveryDirectory.appendingPathComponent("recovery/state.json")
+      let bytes = try Data(contentsOf: url)
+      guard bytes.count <= 1_048_576,
+            let state = try JSONSerialization.jsonObject(with: bytes) as? [String: Any],
+            let stored = state["healthy"] as? [String: Any],
+            stored["candidateID"] as? String == candidate,
+            let healthLaunch = stored["launchID"] as? String, healthLaunch == launch,
+            let milestones = stored["completedMilestones"] as? [String],
+            let inventory = state["candidates"] as? [String: [String: Any]],
+            let record = inventory[candidate],
+            let artifact = record["artifactSHA256"] as? String,
+            let payload = record["payloadSHA256"] as? String,
+            state["installation"] as? String == guest.rotationInstallation,
+            installation.lowercased() == guest.rotationInstallation,
+            health.downloading == nil, health.staged == nil
+      else { return "" }
+      rotation = RotationObservation(installation: guest.rotationInstallation,
+        process: ProcessInfo.processInfo.processIdentifier,
+        deliveryError: deliveryObservation?.rotationDeliveryError, healthLaunch: healthLaunch,
+        milestones: milestones, artifact: artifact, payload: payload, candidates: inventory.keys.sorted(),
+        previous: (state["previousHealthy"] as? [String: Any])?["candidateID"] as? String)
+    }
+    let observation = Observation(workspaceID: workspace.id, taskID: saved.id, projectID: saved.projectID,
+      taskBytes: try encoder.encode(saved), workspaceSHA256: checksum(savedBytes), revision: workspace.revision,
+      outbox: workspace.outbox.count, lastChangeID: workspace.outbox.last?.id,
+      lastChangeRecord: workspace.outbox.last?.recordID, candidate: candidate, launch: launch,
+      sequence: health.acceptedSequence, partialBytes: spool?.count ?? 0, partialSHA256: spool.map(checksum),
+      partialArtifactSHA256: spool.map { String(decoding: $0.prefix(64), as: UTF8.self) },
+      partialPrefixSHA256: spool.map { checksum($0.dropFirst(64)) },
+      launchedArtifactSHA256: delivered?.artifactSHA256, replayedPrefixBytes: delivered?.replayedPrefixBytes ?? 0,
+      replayedPrefixSHA256: delivered?.replayedPrefixSHA256, rotation: rotation)
+    return String(decoding: try encoder.encode(observation), as: UTF8.self)
+  }
+
+  private func checksum(_ bytes: Data) -> String {
+    SHA256.hash(data: bytes).map { String(format: "%02x", $0) }.joined()
+  }
+  #endif
+
+  @MainActor private func retire(_ operation: SignedChecklistRecovery.Operation) async -> Bool {
+    guard isCurrent(operation) else { return false }
+    if let guest, !(await guest.task.close()) { return false }
+    guard isCurrent(operation) else { return false }
+    guest = nil
+    return true
+  }
+}
