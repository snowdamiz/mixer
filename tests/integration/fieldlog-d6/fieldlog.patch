+import MixerCapabilityActivation
+#endif
+import SwiftUI
+#if DEBUG
+import CryptoKit
+#endif
+
+struct SignedChecklist: View {
+  private struct MountedChecklist {
+    let operation: SignedChecklistRecovery.Operation
+    let task: FieldLogSignedTask
+    var canPresent: Bool
+  }
+
+  let task: WorkTask
+  let repository: WorkspaceRepository
+  let recoveryDirectory: URL
+  let isolatedTestWorkspace: Bool
+  @Environment(\.dismiss) private var dismiss
+  @AppStorage("fieldlog.releaseInstallation") private var installation = ""
+  @State private var guest: MountedChecklist?
+  @State private var recovery = SignedChecklistRecovery()
+  @State private var status = "Opening checklist"
+  #if DEBUG
+  @State private var evidence = ""
+  @State private var deliveryObservation: FieldLogSignedTask.Launch?
+  private var useStoredRotationInstallation: Bool {
+    testInstallation != nil && ProcessInfo.processInfo.arguments.contains("--fieldlog-rotation-replay")
+  }
+
+  private var testInstallation: UUID? {
+    guard isolatedTestWorkspace, ProcessInfo.processInfo.arguments.contains("--fieldlog-checklist-observation")
+    else { return nil }
+    let folder = recoveryDirectory.deletingLastPathComponent().lastPathComponent
+    return UUID(uuidString: String(folder.dropFirst("FieldLogUITest-".count)))
+  }
+  #endif
+
+  static var material: URL? { Bundle.main.url(forResource: "ChecklistRelease", withExtension: nil) }
+
+  var body: some View {
+    NavigationStack {
+      VStack(alignment: .leading, spacing: 12) {
+        Text(releaseStatus).accessibilityIdentifier("checklist-release-state")
+        recoveryControls
+        #if DEBUG
+        if testInstallation != nil {
+          Text("Checklist test evidence").font(.caption2)
+            .accessibilityIdentifier("checklist-evidence")
+            .accessibilityValue(evidence)
+            .task {
+              while !Task.isCancelled {
+                if let guest, recovery.phase == .active {
+                  let value = (try? await observe(guest.task)) ?? ""
+                  if isCurrent(guest.operation), recovery.phase == .active { evidence = value }
+                } else {
+                  evidence = ""
+                }
+                try? await Task.sleep(for: .milliseconds(100))
+              }
+            }
+        }
+        #endif
+        if recovery.showsGuest, let guest, guest.operation == recovery.operation, guest.canPresent {
+          MixerGuestScreen(presentation: guest.task.owner.presentation)
+            .id(guest.operation.id)
+            .allowsHitTesting(recovery.phase == .active)
+            .disabled(recovery.phase != .active)
+            .frame(maxWidth: .infinity, maxHeight: .infinity)
+        }
+      }
+      .padding().navigationTitle(task.title)
+      .toolbar {
+        ToolbarItem(placement: .cancellationAction) {
+          Button("Done") { recovery.begin(.done) }.disabled(!recovery.canFinish)
+        }
+        ToolbarItem(placement: .primaryAction) {
+          Button("Check for update") { recovery.begin(.checkForUpdate) }
+            .disabled(!recovery.canCheckForUpdate).accessibilityIdentifier("checklist-check-updates")
+        }
+      }
+      .task(id: recovery.operation.id) { [operation = recovery.operation] in
+        await run(operation)
+      }
+    }
+    .interactiveDismissDisabled()
+  }
+
+  private var releaseStatus: String {
+    switch recovery.phase {
+    case .opening: "Opening checklist"
+    case .retiring(let stop), .retirementPending(let stop), .stopped(let stop, _): stop.title
+    case .reopenFailed: "Could not reopen the saved checklist"
+    case .closing: "Closing checklist"
+    case .closePending: "Waiting for checklist retirement"
+    default: status
+    }
+  }
+
+  @ViewBuilder private var recoveryControls: some View {
+    switch recovery.phase {
+    case .retiring:
+      Text("Closing the previous checklist.").foregroundStyle(.secondary)
+    case .retirementPending(let stop):
+      Text("The previous checklist is still closing.").foregroundStyle(.secondary)
+      Button("Check again") { recovery.begin(.checkRetirement(stop)) }
+    case .stopped(_, let saved?):
