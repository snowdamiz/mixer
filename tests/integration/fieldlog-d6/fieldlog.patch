+  }
+
+  @MainActor private func observeActive(_ opened: FieldLogSignedTask,
+                                       operation: SignedChecklistRecovery.Operation) async {
+    while isCurrent(operation) {
+      let state = await opened.recovery()
+      guard isCurrent(operation) else { return }
+      if await recoverIfStopped(opened, state: state, operation: operation, wasActive: true) { return }
+      do { try await Task.sleep(for: .milliseconds(50)) }
+      catch { return }
+    }
+  }
+
+  private func isDeadline(_ activation: CapabilityGuestUIActivationSnapshot) -> Bool {
+    activation.terminalCause == .deadline ||
+      (activation.terminalCause == .bridge && activation.firstBridgeFailure?.kind == .deadlineExceeded)
+  }
+
+  @MainActor private func recoverIfStopped(_ owner: FieldLogSignedTask,
+    state: CapabilityGuestUIRecoverySnapshot, operation: SignedChecklistRecovery.Operation,
+    wasActive: Bool = false, retirement: Bool? = nil
+  ) async -> Bool {
+    let activation = state.activation
+    guard activation.terminalCause != nil || state.closed || state.requiresReopen ||
+            activation.phase == .recoveryRequired || activation.phase == .stopping ||
