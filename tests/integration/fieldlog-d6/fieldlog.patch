+                                               hasSavedRelease: hasSavedRelease) else { return false }
+    await finishRecovery(operation, owner: owner, retirement: retirement)
+    return true
+  }
+
+  @MainActor private func finishRecovery(_ operation: SignedChecklistRecovery.Operation,
+                                        owner: FieldLogSignedTask? = nil, retirement: Bool? = nil) async {
+    guard let stopped = owner ?? guest?.task, isCurrent(operation) else { return }
+    let retired: Bool
+    if let retirement { retired = retirement }
+    else { retired = await retire(operation) }
+    guard retired else {
+      if isCurrent(operation) { recovery.retirementFinished(operation, retired: false) }
+      return
+    }
+    let state = await stopped.recovery()
+    let saved = await SignedChecklistRecovery.Saved.read(healthy: state.healthy, staged: state.staged,
+      repository: repository, taskID: task.id, projectID: task.projectID)
+    guard isCurrent(operation) else { return }
+    recovery.retirementFinished(operation, retired: true, saved: saved,
+                                confirmedDeadline: isDeadline(state.activation))
+  }
+
+  #if DEBUG
+  @MainActor private func recordStartupFailure(_ owner: FieldLogSignedTask,
+    state: CapabilityGuestUIRecoverySnapshot, operation: SignedChecklistRecovery.Operation, trigger: String) {
+    guard testInstallation != nil, isCurrent(operation), recovery.phase == .opening,
+          guest?.operation == operation,
+          let launch = state.activation.launchID,
+          let data = owner.owner.startupDiagnostic(launchID: launch),
+          let runtime = try? JSONSerialization.jsonObject(with: data) else { return }
