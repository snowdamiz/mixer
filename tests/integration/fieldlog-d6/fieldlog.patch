+import FieldLogStorage
+import Foundation
+
+struct SignedChecklistRecovery {
+  enum Stop: Equatable {
+    case deadline, interrupted
+
+    var title: String {
+      switch self {
+      case .deadline: "Checklist timed out"
+      case .interrupted: "Checklist stopped"
+      }
+    }
+  }
+
+  struct Saved: Equatable {
+    let candidate: String
+    let completed: Bool
+
+    init?(healthy: String?, staged: String?, completed: Bool?) {
+      guard let healthy, staged == nil, let completed else { return nil }
+      self.candidate = healthy
+      self.completed = completed
+    }
+
+    static func contains(candidate: String?, healthy: String?, previousHealthy: String?) -> Bool {
+      guard let candidate else { return false }
+      return candidate == healthy || candidate == previousHealthy
+    }
+
+    static func read(healthy: String?, staged: String?, repository: WorkspaceRepository,
+                     taskID: UUID, projectID: UUID) async -> Self? {
+      let workspace = try? await repository.readCommittedSnapshot()
+      let task = workspace?.tasks.first { $0.id == taskID && $0.projectID == projectID }
+      return Self(healthy: healthy, staged: staged, completed: task?.completed)
+    }
+  }
+
+  enum Command: Equatable {
+    case checkForUpdate, reopenSaved(Saved), checkRetirement(Stop), done
+  }
+
+  struct Operation: Equatable {
+    let id = UUID()
+    let command: Command
+  }
+
+  enum Phase: Equatable {
+    case opening, active, unavailable
+    case closing(Saved?), closePending(Saved?)
+    case retiring(Stop), retirementPending(Stop), stopped(Stop, Saved?)
+    case reopenFailed(Saved, retirementPending: Bool)
+  }
+
+  private(set) var operation = Operation(command: .checkForUpdate)
+  private(set) var phase: Phase = .opening
+
+  var showsGuest: Bool { phase == .opening || phase == .active }
+
+  var canCheckForUpdate: Bool {
+    switch phase {
+    case .active, .unavailable: true
+    default: false
+    }
+  }
+
+  var canFinish: Bool {
+    switch phase {
+    case .active, .unavailable, .stopped, .retirementPending, .reopenFailed, .closePending: true
+    default: false
+    }
+  }
+
+  mutating func begin(_ command: Command) {
+    switch command {
+    case .checkForUpdate where canCheckForUpdate:
+      phase = .opening
+    case .done where canFinish:
+      switch phase {
+      case .stopped(_, let saved), .closePending(let saved): phase = .closing(saved)
+      case .reopenFailed(let saved, _): phase = .closing(saved)
+      default: phase = .closing(nil)
+      }
+    case .reopenSaved(let requested):
+      guard case .stopped(_, let saved?) = phase, saved == requested else { return }
+      phase = .opening
+    case .checkRetirement(let stop) where phase == .retirementPending(stop):
+      phase = .retiring(stop)
+    default:
+      return
+    }
+    operation = Operation(command: command)
+  }
+
+  mutating func opened(_ operation: Operation) -> Bool {
+    guard self.operation == operation, phase == .opening else { return false }
+    phase = .active
+    return true
+  }
+
+  mutating func openFailed(_ operation: Operation, retired: Bool) {
+    guard self.operation == operation, phase == .opening else { return }
+    if case .reopenSaved(let saved) = operation.command {
+      phase = .reopenFailed(saved, retirementPending: !retired)
+    } else {
+      phase = retired ? .unavailable : .closePending(nil)
+    }
+  }
+
+  mutating func closeDelayed(_ operation: Operation) {
+    guard self.operation == operation, case .closing(let saved) = phase else { return }
+    phase = .closePending(saved)
+  }
+
+  mutating func stopped(_ operation: Operation, reason: Stop, hasSavedRelease: Bool = false) -> Bool {
+    guard self.operation == operation else { return false }
+    if phase != .active {
+      guard phase == .opening, operation.command == .checkForUpdate, hasSavedRelease else { return false }
+    }
+    phase = .retiring(reason)
+    return true
+  }
+
+  mutating func retirementFinished(_ operation: Operation, retired: Bool, saved: Saved? = nil,
+                                   confirmedDeadline: Bool = false) {
+    guard self.operation == operation, case .retiring(let stop) = phase else { return }
+    let reason = confirmedDeadline ? .deadline : stop
+    phase = retired ? .stopped(reason, saved) : .retirementPending(reason)
+  }
+}
