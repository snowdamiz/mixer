+  }
+
+  private func savedTaskStatus(_ saved: SignedChecklistRecovery.Saved) -> some View {
+    Text(saved.completed ? "Saved task status: Completed" : "Saved task status: Open")
+      .foregroundStyle(.secondary)
+  }
+
+  @MainActor private func isCurrent(_ operation: SignedChecklistRecovery.Operation) -> Bool {
+    !Task.isCancelled && recovery.operation == operation
+  }
+
+  @MainActor private func run(_ operation: SignedChecklistRecovery.Operation) async {
+    guard isCurrent(operation) else { return }
