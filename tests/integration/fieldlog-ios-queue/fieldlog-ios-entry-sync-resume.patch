diff --git a/ios/FieldLog/DeviceQueue.swift b/ios/FieldLog/DeviceQueue.swift
new file mode 100644
index 0000000000000000000000000000000000000000..80f1c4c723752d0bffdb46fd4032a3ea388daa3b
--- /dev/null
+++ b/ios/FieldLog/DeviceQueue.swift
@@ -0,0 +1,170 @@
+import FieldLogModels
+import FieldLogStorage
+import SwiftUI
+
+struct DeviceQueue<EntryDestination: View>: View {
+  let workspace: Workspace
+  @ObservedObject var model: WorkspaceModel
+  let accent: Color
+  let onEdit: (EntryDraft) -> Void
+  @ViewBuilder let entryDetail: (LogEntry) -> EntryDestination
+  var body: some View {
+    List {
+      Section {
+        Label("Your records are saved locally", systemImage: "internaldrive.fill").font(.headline)
+          .foregroundStyle(accent)
+        Text(model.isLocalEntrySyncWorkspace
+          ? model.localEntrySyncMessage
+          : "Cloud sync isn't connected. Nothing in this queue has been sent to a server.")
+          .foregroundStyle(.secondary)
+      }
+      if let confirmation = model.lastEntrySync {
+        Section {
+          Label(confirmation.message, systemImage: "checkmark.circle")
+            .accessibilityIdentifier("entry-sync-confirmation")
+          entryLink(confirmation.entry)
+        }
+      }
+      if !workspace.drafts.isEmpty {
+        Section("DRAFTS") {
+          ForEach(workspace.drafts.sorted { $0.updatedAt > $1.updatedAt }) { draft in
+            Button {
+              onEdit(draft)
+            } label: {
+              VStack(alignment: .leading, spacing: 4) {
+                Text(draft.title.isEmpty ? "Untitled entry" : draft.title).foregroundStyle(.primary)
+                Text(workspace.projects.first { $0.id == draft.projectID }?.title ?? "Project")
+                  .font(.caption).foregroundStyle(.secondary)
+              }
+            }
+          }
+        }
+      }
+      Section("\(workspace.outbox.count) PENDING CHANGE\(workspace.outbox.count==1 ? "":"S")") {
+        if workspace.outbox.isEmpty {
+          Text("Changes you make will appear here.").foregroundStyle(.secondary)
+        }
+        ForEach(workspace.outbox.reversed()) { item in
+          VStack(alignment: .leading, spacing: 4) {
+            Text(label(item.kind))
+            if let entry = inspectableEntry(for: item) {
+              entryLink(entry)
+            } else {
+              Text(item.createdAt, style: .date).font(.caption).foregroundStyle(.secondary)
+            }
+            if let action = entrySyncAction(for: item.id) {
+              action
+            } else {
+              Label(pendingMessage(for: item.kind), systemImage: "clock").font(.caption)
+                .foregroundStyle(.secondary)
+                .accessibilityIdentifier("entry-sync-pending-" + item.id.uuidString.lowercased())
+            }
+          }
+        }
+      }
+    }.navigationTitle("On device")
+  }
+  func inspectableEntry(for change: PendingChange) -> LogEntry? {
+    guard model.isLocalEntrySyncWorkspace, change.kind == .entrySaved else { return nil }
+    return workspace.entries.first { $0.id == change.recordID }
+  }
+
+  func pendingMessage(for kind: PendingChange.Kind) -> String {
+    if model.isLocalEntrySyncWorkspace && kind == .entrySaved { return "Send not confirmed" }
+    return "Saved on device · not sent"
+  }
+
+  private func entryLink(_ entry: LogEntry) -> some View {
+    NavigationLink {
+      entryDetail(entry)
+    } label: {
+      VStack(alignment: .leading, spacing: 4) {
+        Label(entry.title, systemImage: "doc.text").font(.subheadline)
+        Text(entry.savedAt, format: .dateTime.month(.abbreviated).day().hour().minute().second())
+          .font(.caption).foregroundStyle(.secondary)
+      }
+    }.buttonStyle(.borderless)
+  }
+
+  func entrySyncAction(for id: UUID) -> EntrySyncAction? {
+    guard let state = model.entrySyncState(for: id) else { return nil }
+    return EntrySyncAction(
+      id: id, state: state, enabled: model.sendingEntryID == nil,
+      cancel: model.entrySyncCancellation(for: id)
+    ) {
+      await model.sendEntry(eventID: id)
+    }
+  }
+
+  private func label(_ kind: PendingChange.Kind) -> String {
+    switch kind {
+    case .projectCreated: "Project created"
+    case .taskSaved: "Task updated"
+    case .taskOrderChanged: "Checklist reordered"
+    case .entrySaved: "Entry saved"
+    }
+  }
+}
+
+struct EntrySyncAction: View {
+  let id: UUID
+  let state: EntrySyncRowState
+  let enabled: Bool
+  let cancel: (@MainActor () -> Void)?
+  let send: @MainActor () async -> Void
+
+  var confirmedBytesText: String? {
+    let progress: EntrySyncClient.PhotoProgress?
+    switch state {
+    case .sending(let value, _), .paused(let value): progress = value
+    case .ready, .failed: progress = nil
+    }
+    return progress.map { "\($0.acceptedBytes) of \($0.totalBytes) bytes confirmed" }
+  }
+
+  var body: some View {
+    switch state {
+    case .ready:
+      sendButton("Send to local backend")
+    case .sending(let progress, let cancelling):
+      if let progress {
+        ProgressView(value: Double(progress.acceptedBytes), total: Double(progress.totalBytes))
+          .accessibilityHidden(true)
+      } else {
+        ProgressView("Checking saved photo bytes…").font(.caption)
+      }
+      confirmedBytesLabel
+      if cancelling {
+        Text("Pausing send…").font(.caption)
+      }
+      if let cancel {
+        Button("Cancel send", action: cancel)
+          .buttonStyle(.borderless)
+          .accessibilityIdentifier("entry-sync-cancel-" + id.uuidString.lowercased())
+      }
+    case .paused:
+      Label("Send paused", systemImage: "pause.circle").font(.caption)
+        .accessibilityIdentifier("entry-sync-paused-" + id.uuidString.lowercased())
+      confirmedBytesLabel
+      sendButton("Resume send")
+    case .failed(let message):
+      Label(message, systemImage: "exclamationmark.triangle").font(.caption)
+        .accessibilityIdentifier("entry-sync-failure")
+      sendButton("Retry send")
+    }
+  }
+
+  @ViewBuilder private var confirmedBytesLabel: some View {
+    if let confirmedBytesText {
+      Text(verbatim: confirmedBytesText).font(.caption)
+        .accessibilityIdentifier("entry-sync-progress-" + id.uuidString.lowercased())
+    }
+  }
+
+  private func sendButton(_ title: String) -> some View {
+    Button(title) { Task { await send() } }
+      .buttonStyle(.borderless)
+      .disabled(!enabled)
+      .accessibilityIdentifier("entry-sync-" + id.uuidString.lowercased())
+  }
+}
