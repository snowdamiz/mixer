index 0000000000000000000000000000000000000000..f2200671e86b16c827d564c61706988b5c8fa831
--- /dev/null
+++ b/ios/FieldLogUITests/EntrySyncResumeUITests.swift
@@ -0,0 +1,115 @@
+#if FIELDLOG_LOCAL_ENTRY_SYNC
+import Foundation
+import XCTest
+
+@MainActor final class EntrySyncResumeUITests: XCTestCase {
+  func testCancelAndResumeSelectedJPEG() async throws {
+    continueAfterFailure = false
+    let environment = ProcessInfo.processInfo.environment
+    let eventID = try XCTUnwrap(
+      environment["FIELDLOG_ENTRY_SYNC_TEST_EVENT_ID"].flatMap(UUID.init(uuidString:)),
+      "The runner must provide the selected event UUID"
+    ).uuidString.lowercased()
+    let otherEventID = try XCTUnwrap(
+      environment["FIELDLOG_ENTRY_SYNC_TEST_OTHER_EVENT_ID"].flatMap(UUID.init(uuidString:)),
+      "The runner must provide the unrelated event UUID"
+    ).uuidString.lowercased()
+    let photoBytes = try XCTUnwrap(
+      environment["FIELDLOG_ENTRY_SYNC_TEST_PHOTO_BYTES"].flatMap(Int.init),
+      "The runner must provide the JPEG byte count"
+    )
+    XCTAssertNotEqual(eventID, otherEventID)
+    XCTAssertGreaterThan(photoBytes, 32_768)
+
+    let app = XCUIApplication()
+    app.launchArguments = ["--fieldlog-local-entry-sync"]
+    let launchKeys = [
+      "FIELDLOG_ENTRY_SYNC_PORT",
+      "FIELDLOG_ENTRY_SYNC_TOKEN",
+      "FIELDLOG_ENTRY_SYNC_WORKSPACE_ID",
+      "FIELDLOG_ENTRY_SYNC_PROJECT_ID",
+    ]
+    var launchEnvironment: [String: String] = [:]
+    for key in launchKeys {
+      let value = try XCTUnwrap(environment[key], "Missing runner environment variable \(key)")
+      XCTAssertFalse(value.isEmpty, "Empty runner environment variable \(key)")
+      launchEnvironment[key] = value
+    }
+    app.launchEnvironment = launchEnvironment
+    app.launch()
+    defer { app.terminate() }
+
+    XCTAssertTrue(app.navigationBars["Workshop"].waitForExistence(timeout: 15))
+    app.tabBars.buttons["On device"].tap()
+    XCTAssertTrue(app.navigationBars["On device"].waitForExistence(timeout: 5))
+
+    let elements = app.descendants(matching: .any)
+    let send = app.buttons["entry-sync-" + eventID]
+    let progress = elements.matching(identifier: "entry-sync-progress-" + eventID)
+      .matching(NSPredicate(format: "label == %@", "32768 of \(photoBytes) bytes confirmed"))
+      .firstMatch
+    let cancel = app.buttons["entry-sync-cancel-" + eventID]
+
+    reveal(send, in: app)
+    send.tap()
+    XCTAssertTrue(progress.waitForExistence(timeout: 10), "The first JPEG chunk was not shown as confirmed")
+    try await waitForSecondChunk(port: launchEnvironment["FIELDLOG_ENTRY_SYNC_PORT"],
+                                 token: launchEnvironment["FIELDLOG_ENTRY_SYNC_TOKEN"])
+    reveal(cancel, in: app)
+    cancel.tap()
+
+    let paused = elements.matching(identifier: "entry-sync-paused-" + eventID).firstMatch
+    XCTAssertTrue(paused.waitForExistence(timeout: 5))
+    XCTAssertEqual(paused.label, "Send paused")
+    XCTAssertTrue(progress.exists, "Pausing must keep the confirmed byte count visible")
+    XCTAssertTrue(send.waitForExistence(timeout: 5))
+    XCTAssertEqual(send.label, "Resume send")
+    send.tap()
+
+    let confirmation = elements.matching(identifier: "entry-sync-confirmation").firstMatch
+    let queueHeader = elements.matching(NSPredicate(format: "label == %@", "Your records are saved locally"))
+      .firstMatch
+    reveal(queueHeader, in: app, towardTop: true)
+    XCTAssertTrue(confirmation.waitForExistence(timeout: 20))
+    XCTAssertEqual(confirmation.label, "Sent to the local backend")
+
+    let otherPending = elements.matching(identifier: "entry-sync-pending-" + otherEventID).firstMatch
+    reveal(otherPending, in: app)
+    XCTAssertFalse(app.buttons["entry-sync-" + otherEventID].exists)
+    XCTAssertFalse(app.buttons["entry-sync-" + eventID].exists)
+  }
+
+  private func waitForSecondChunk(port: String?, token: String?) async throws {
+    let port = try XCTUnwrap(port.flatMap(UInt16.init))
+    let token = try XCTUnwrap(token)
+    var request = URLRequest(
+      url: try XCTUnwrap(URL(string: "http://127.0.0.1:\(port)/_fixture/second-chunk")),
+      timeoutInterval: 2
+    )
+    request.setValue("Bearer \(token)", forHTTPHeaderField: "Authorization")
+    let session = URLSession(configuration: .ephemeral)
+    defer { session.invalidateAndCancel() }
+    let deadline = ContinuousClock.now + .seconds(8)
+    while ContinuousClock.now < deadline {
+      let (_, response) = try await session.data(for: request)
+      let status = try XCTUnwrap(response as? HTTPURLResponse).statusCode
+      if status == 204 { return }
+      XCTAssertEqual(status, 425)
+      try await Task.sleep(for: .milliseconds(100))
+    }
+    XCTFail("The fixture did not reach the second JPEG chunk before Cancel")
+  }
+
+  private func reveal(_ element: XCUIElement, in app: XCUIApplication, towardTop: Bool = false) {
+    for _ in 0..<5 {
+      if element.isHittable { return }
+      if towardTop {
+        app.swipeDown()
+      } else {
+        app.swipeUp()
+      }
+    }
+    XCTAssertTrue(element.isHittable, "Could not reveal \(element)")
+  }
+}
+#endif
