diff --git a/verification/host/TaskConflictReplay.swift b/verification/host/TaskConflictReplay.swift
new file mode 100644
index 0000000..01e94f0
--- /dev/null
+++ b/verification/host/TaskConflictReplay.swift
@@ -0,0 +1,255 @@
+import Darwin
+import FieldLogModels
+import FieldLogStorage
+import Foundation
+
+private struct ReplayFailure: Error, CustomStringConvertible {
+  let description: String
+}
+
+private func check(_ condition: Bool, _ message: String) throws {
+  if !condition { throw ReplayFailure(description: message) }
+}
+
+private func required<T>(_ value: T?, _ message: String) throws -> T {
+  guard let value else { throw ReplayFailure(description: message) }
+  return value
+}
+
+@MainActor
+private func open(_ directory: URL) async throws -> WorkspaceModel {
+  let model = WorkspaceModel(workspaceDirectory: directory)
+  await model.open()
+  try check(model.workspace != nil, model.openError ?? "Workspace failed to open")
+  return model
+}
+
+private struct Fixture {
+  let localDirectory: URL
+  let peerDirectory: URL
+  let taskID: UUID
+  let otherTaskID: UUID
+  let projectID: UUID
+}
+
+@MainActor
+private func seed(_ root: URL) async throws -> Fixture {
+  let localDirectory = root.appendingPathComponent("local")
+  let peerDirectory = root.appendingPathComponent("peer")
+  let model = try await open(localDirectory)
+  let projectID = try required(
+    await model.createProject(title: "Site inspection", site: "North yard"), "Project creation")
+  try check(await model.addTask(projectID: projectID, title: "Check valve", responsible: "Crew"), "Task creation")
+  try check(await model.addTask(projectID: projectID, title: "Check gauge", responsible: "Other"), "Second task creation")
+  var draft = try required(await model.newDraft(projectID: projectID), "Draft creation")
+  draft.title = "Unrelated draft"
+  draft.note = "First line\n  second line "
+  try check(await model.keepDraft(draft), "Draft save")
+  let workspace = try required(model.workspace, "Seeded workspace")
+  try check(workspace.schema == 1, "Ordinary saves should retain the original schema")
+  let tasks = workspace.tasks(for: projectID)
+  try check(tasks.count == 2, "Expected both seed tasks")
+  try FileManager.default.createDirectory(at: peerDirectory, withIntermediateDirectories: true)
+  try FileManager.default.copyItem(
+    at: localDirectory.appendingPathComponent("workspace.json"),
+    to: peerDirectory.appendingPathComponent("workspace.json"))
+  return Fixture(
+    localDirectory: localDirectory, peerDirectory: peerDirectory,
+    taskID: tasks[0].id, otherTaskID: tasks[1].id, projectID: projectID)
+}
+
+private struct PendingReplay {
+  let edit: TaskEdit
+  let review: TaskConflictReview
+  let workspace: Workspace
+}
+
+@MainActor
+private func makeConflict(
+  _ fixture: Fixture, localResponsible: String?, peerResponsible: String?
+) async throws -> PendingReplay {
+  let local = try await open(fixture.localDirectory)
+  let peer = try await open(fixture.peerDirectory)
+  var localEdit = try required(local.editTask(fixture.taskID), "Open ordinary local editor")
+  var peerEdit = try required(peer.editTask(fixture.taskID), "Open ordinary peer editor")
+  try check(localEdit.base == peerEdit.base, "Editors should start from the same saved task text")
+  localEdit.text.title = "  Inspect valve today  "
+  if let localResponsible { localEdit.text.responsible = localResponsible }
+  peerEdit.text.title = "Inspect valve after shutdown"
+  if let peerResponsible { peerEdit.text.responsible = peerResponsible }
+  try check(await peer.saveTaskEdit(peerEdit), peer.saveError ?? "Peer editor save")
+  // Transfer only text observed after the peer's ordinary durable Save.
+  peerEdit.text = try required(peer.editTask(fixture.taskID), "Read the committed peer version").base
+
+  local.toggleTask(fixture.taskID)
+  local.moveTask(fixture.taskID, offset: 1)
+  await local.flush()
+  let beforeIncoming = try required(local.workspace, "Snapshot before incoming edit")
+  try check(await local.receiveTaskEdit(peerEdit), local.saveError ?? "Deliver peer text")
+  let afterIncoming = try required(local.workspace, "Snapshot after incoming edit")
+  try check(afterIncoming.outbox == beforeIncoming.outbox, "Incoming edit changed local outbox")
+  try check(afterIncoming.tasks.filter { $0.id != fixture.taskID }
+              == beforeIncoming.tasks.filter { $0.id != fixture.taskID }
+              && afterIncoming.projects == beforeIncoming.projects,
+            "Incoming edit changed another task or project")
+  try check(await local.receiveTaskEdit(peerEdit), "Repeated incoming delivery")
+  try check(local.workspace == afterIncoming, "Repeated delivery rewrote workspace")
+  let task = try required(afterIncoming.tasks.first { $0.id == fixture.taskID }, "Imported task")
+  try check(task.title == peerEdit.text.title && task.completed && task.position == 1,
+            "Incoming edit changed completion or position, or imported the wrong text")
+  try check(await local.saveTaskEdit(localEdit), local.saveError ?? "Save competing local edit")
+  let pending = try required(local.workspace, "Snapshot with pending conflict")
+  let review = try required(pending.taskConflict(for: fixture.taskID), "Find durable conflict")
+  try check(pending.schema == 2, "Conflict must upgrade the workspace schema")
+  try check(pending.tasks == afterIncoming.tasks && pending.outbox == afterIncoming.outbox,
+            "Queueing a conflict changed a task or the outbox")
+  try check(pending.drafts == beforeIncoming.drafts && pending.restoration == beforeIncoming.restoration,
+            "Peer delivery or conflict storage changed the entry draft")
+  let title = try required(review.conflicts.first { $0.field == .title }, "Missing title conflict")
+  try check(title.local == "Inspect valve today" && title.incoming == "Inspect valve after shutdown",
+            "Incorrect conflict values or title normalization")
+  return PendingReplay(edit: localEdit, review: review, workspace: pending)
+}
+
+@MainActor
+private func resolve(
+  _ fixture: Fixture, pending: PendingReplay, decisions: [TaskTextField: TaskConflictChoice],
+  expectedTitle: String, expectedResponsible: String, shouldEnqueue: Bool,
+  exerciseStaleReview: Bool = false
+) async throws -> Workspace {
+  let model = try await open(fixture.localDirectory)
+  try check(model.workspace == pending.workspace, "Cold reopen changed pending conflict state")
+  let review = try required(model.workspace?.taskConflict(for: fixture.taskID), "Cold reopen review")
+  try check(review == pending.review && model.editTask(fixture.taskID) != nil,
+            "Cold editor could not rediscover the persisted review")
+  try check(!(await model.resolveTaskConflict(review, choosing: [:])), "Incomplete choices resolved")
+  try check(model.workspace == pending.workspace, "Incomplete choices changed the workspace")
+  if exerciseStaleReview {
+    let peer = try await open(fixture.peerDirectory)
+    var newerEdit = try required(peer.editTask(fixture.taskID), "Reopen the peer's ordinary editor")
+    newerEdit.text.title = "Inspect valve next week"
+    try check(await peer.saveTaskEdit(newerEdit), "Second peer save")
+    newerEdit.text = try required(peer.editTask(fixture.taskID), "Second committed peer version").base
+    try check(await model.receiveTaskEdit(newerEdit), "Second peer delivery during review")
+    let afterDelivery = model.workspace
+    try check(afterDelivery?.outbox == pending.workspace.outbox, "New peer delivery changed the outbox")
+    try check(!(await model.resolveTaskConflict(review, choosing: decisions)), "Stale review resolved")
+    try check(model.workspace == afterDelivery, "Stale review changed the workspace")
+    let refreshed = model.workspace?.taskConflict(for: fixture.taskID)
+    try check(refreshed?.conflicts.first?.incoming == "Inspect valve next week",
+              "Review did not refresh to the latest incoming value")
+  }
+
+  let before = try required(model.workspace, "Snapshot before resolution")
+  let current = try required(before.taskConflict(for: fixture.taskID), "Refresh review")
+  try check(await model.resolveTaskConflict(current, choosing: decisions), model.saveError ?? "Resolve")
+  let resolved = try required(model.workspace, "Snapshot after resolution")
+  let task = try required(resolved.tasks.first { $0.id == fixture.taskID }, "Resolved task")
+  try check(task.title == expectedTitle && task.responsible == expectedResponsible,
+            "Resolution kept the wrong title or assignee")
+  try check(task.completed && task.position == 1 && task.projectID == fixture.projectID,
+            "Resolution changed completion, ordering or project ownership")
+  try check(resolved.taskConflict(for: fixture.taskID) == nil && resolved.revision == before.revision + 1,
+            "Resolution did not atomically consume the review")
+  try check(resolved.tasks.filter { $0.id != fixture.taskID } == before.tasks.filter { $0.id != fixture.taskID }
+              && resolved.tasks.contains { $0.id == fixture.otherTaskID },
+            "Resolution changed an unrelated task")
+  try check(resolved.drafts == before.drafts && resolved.restoration == before.restoration,
+            "Resolution changed the draft or workspace restoration")
+  if shouldEnqueue {
+    try check(resolved.outbox.count == before.outbox.count + 1
+                && Array(resolved.outbox.dropLast()) == before.outbox
+                && resolved.outbox.last?.recordID == fixture.taskID
+                && resolved.outbox.last?.kind == .taskSaved
+                && resolved.outbox.last?.revision == resolved.revision,
+              "Local text change did not append exactly one task save")
+  } else {
+    try check(resolved.outbox == before.outbox, "Accepting current text added an outbox item")
+  }
+  try check(await model.resolveTaskConflict(current, choosing: decisions), "Repeated resolution")
+  try check(model.workspace == resolved, "Repeated resolution rewrote workspace or outbox")
+  try check(await model.saveTaskEdit(pending.edit), "Repeated original save")
+  try check(model.workspace == resolved, "Repeated original save reopened a resolved conflict")
+  return resolved
+}
+
+@MainActor
+private func replayWhileNewConflictIsPending(
+  _ completed: TaskConflictReview, fixture: Fixture, model: WorkspaceModel
+) async throws {
+  let peer = try await open(fixture.peerDirectory)
+  var localEdit = try required(model.editTask(fixture.taskID), "Open a new local edit")
+  var peerEdit = try required(peer.editTask(fixture.taskID), "Open a new peer edit")
+  try check(localEdit.base == peerEdit.base, "Both replicas should hold the accepted peer version")
+  localEdit.text.title = "Inspect from the walkway"
+  peerEdit.text.title = "Inspect from the platform"
+  try check(await peer.saveTaskEdit(peerEdit), "Save another peer edit")
+  peerEdit.text = try required(peer.editTask(fixture.taskID), "Read the new committed peer text").base
+  try check(await model.receiveTaskEdit(peerEdit), "Deliver another peer edit")
+  try check(await model.saveTaskEdit(localEdit), "Save new local conflict")
+  let snapshot = try required(model.workspace, "Snapshot with a different pending conflict")
+  let pending = try required(snapshot.taskConflict(for: fixture.taskID), "Different pending review")
+  try check(pending.editID != completed.editID, "Expected a different conflict identity")
+  try check(await model.resolveTaskConflict(completed, choosing: [.title: .incoming]),
+            "Retry of completed review failed while another conflict was pending")
+  try check(model.workspace == snapshot, "Retry of completed review changed the new pending conflict")
+}
+
+@main
+struct TaskConflictReplay {
+  @MainActor static func main() async {
+    do {
+      let root = URL(fileURLWithPath: CommandLine.arguments[1], isDirectory: true)
+      for example in ["local", "incoming", "mixed", "incoming-only"] {
+        let fixture = try await seed(root.appendingPathComponent(example))
+        let localResponsible = switch example {
+        case "incoming", "mixed": ""
+        default: nil as String?
+        }
+        let peerResponsible = switch example {
+        case "local": "Peer crew"
+        case "mixed": "Unassigned"
+        default: nil as String?
+        }
+        let pending = try await makeConflict(fixture, localResponsible: localResponsible, peerResponsible: peerResponsible)
+        let decisions: [TaskTextField: TaskConflictChoice] = switch example {
+        case "local": [.title: .local]
+        case "mixed": [.title: .local, .responsible: .incoming]
+        default: [.title: .incoming]
+        }
+        try check(pending.review.conflicts.map(\.field) == (example == "mixed" ? [.title, .responsible] : [.title]),
+                  "Independent changes were classified as conflicts")
+        if example == "mixed" {
+          let assignee = pending.review.conflicts[1]
+          try check(assignee.local.isEmpty && assignee.incoming == "Unassigned",
+                    "Wrong responsible-person values in review")
+        }
+        let resolved = try await resolve(
+          fixture, pending: pending, decisions: decisions,
+          expectedTitle: ["local", "mixed"].contains(example) ? "Inspect valve today" : "Inspect valve after shutdown",
+          expectedResponsible: peerResponsible ?? localResponsible ?? "Crew",
+          shouldEnqueue: example != "incoming-only", exerciseStaleReview: example == "mixed")
+        let reopened = try await open(fixture.localDirectory)
+        try check(reopened.workspace == resolved, "Cold reopen changed resolved task or outbox")
+        try check(await reopened.resolveTaskConflict(pending.review, choosing: decisions), "Resolve replay after reopen")
+        try check(reopened.workspace == resolved, "Resolve replay after reopen rewrote data")
+        try check(await reopened.saveTaskEdit(pending.edit), "Save replay after reopen")
+        try check(reopened.workspace == resolved, "Save replay after reopen reopened a resolved conflict")
+        if example == "incoming-only" {
+          try await replayWhileNewConflictIsPending(pending.review, fixture: fixture, model: reopened)
+          print("PASS completed resolve replay while another conflict is pending")
+        }
+        print("PASS \(example): peer save, open-editor conflict, cold review, resolution, duplicate save/resolve, cold result")
+      }
+      try check(SavedTaskEditor.whitespaceDescription(" ") == "Space"
+                  && SavedTaskEditor.whitespaceDescription("  ") == "Space, Space"
+                  && SavedTaskEditor.whitespaceDescription("\t") == "Tab"
+                  && SavedTaskEditor.whitespaceDescription("Unassigned") == nil,
+                "Conflict value display did not distinguish invisible assignees")
+      print("PASS conflict value display distinguishes one space, two spaces, tab and literal text")
+    } catch {
+      FileHandle.standardError.write(Data("FAIL \(error)\n".utf8))
+      exit(1)
+    }
+  }
+}
diff --git a/verification/host/replay-task-conflict.py b/verification/host/replay-task-conflict.py
new file mode 100644
index 0000000..8732e02
--- /dev/null
+++ b/verification/host/replay-task-conflict.py
@@ -0,0 +1,82 @@
+"""Build and replay the ordinary saved-task editor on macOS, without SDK resolution."""
+
+import errno
+import os
+from pathlib import Path
+import shlex
+import signal
+import subprocess
+import sys
+
+
+def run(command, source, env):
+    print(f"\n$ {shlex.join(map(str, command))}", flush=True)
+    child = subprocess.Popen(
+        command, cwd=source, env=env, start_new_session=True,
+        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
+    )
+    print(f"started pid/pgid={child.pid}", flush=True)
+    timed_out = False
+    try:
+        output, _ = child.communicate(timeout=40)
+    except subprocess.TimeoutExpired:
+        timed_out = True
+        try:
+            os.killpg(child.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+        output, _ = child.communicate(timeout=5)
+    finally:
+        child.stdout.close()
+    print(output, end="", flush=True)
+    try:
+        os.killpg(child.pid, 0)
+    except OSError as error:
+        if error.errno != errno.ESRCH:
+            raise
+    else:
+        raise RuntimeError(f"Process group still present, pid/pgid={child.pid}")
+    print(f"exit={child.returncode} reaped=true group_absent=true output_eof=true", flush=True)
+    if timed_out:
+        raise SystemExit("Command exceeded its deadline.")
+    if child.returncode:
+        raise SystemExit(child.returncode)
+
+
+def main():
+    if sys.platform != "darwin" or len(sys.argv) != 2:
+        raise SystemExit("Usage on macOS: python3 verification/host/replay-task-conflict.py NEW_SCRATCH_PATH")
+    source = Path(__file__).resolve().parents[2]
+    scratch = Path(sys.argv[1]).resolve()
+    scratch.mkdir()
+    temporary = scratch / "tmp"
+    temporary.mkdir()
+    env = {**os.environ, "TMPDIR": str(temporary) + "/"}
+    swiftc = ["swiftc", "-swift-version", "6", "-module-cache-path", scratch / "module-cache"]
+
+    def library(name, *dependencies):
+        run([
+            *swiftc, "-emit-library", "-emit-module", "-module-name", name,
+            "-emit-module-path", scratch / f"{name}.swiftmodule",
+            "-I", scratch, "-L", scratch, *dependencies,
+            "-Xlinker", "-install_name", "-Xlinker", f"@rpath/lib{name}.dylib",
+            "-o", scratch / f"lib{name}.dylib", *sorted((source / "Sources" / name).glob("*.swift")),
+        ], source, env)
+
+    run(["swiftc", "--version"], source, env)
+    run(["plutil", "-lint", "ios/FieldLog.xcodeproj/project.pbxproj"], source, env)
+    run(["swiftc", "-frontend", "-parse", "ios/FieldLog/ProjectDetail.swift"], source, env)
+    library("FieldLogModels")
+    library("FieldLogStorage", "-lFieldLogModels")
+    executable = scratch / "TaskConflictReplay"
+    run([
+        *swiftc, "-I", scratch, "-L", scratch, "-lFieldLogModels", "-lFieldLogStorage",
+        "-Xlinker", "-rpath", "-Xlinker", scratch, "-o", executable,
+        "ios/FieldLog/WorkspaceModel.swift", "ios/FieldLog/SavedTaskEditor.swift",
+        "verification/host/TaskConflictReplay.swift",
+    ], source, env)
+    run([executable, scratch / "workspaces"], source, env)
+
+
+if __name__ == "__main__":
+    main()
