index 0000000..5ddfc70
--- /dev/null
+++ b/ios/FieldLog/SavedTaskEditor.swift
@@ -0,0 +1,119 @@
+import FieldLogModels
+import SwiftUI
+
+struct SavedTaskEditor: View {
+  @EnvironmentObject private var model: WorkspaceModel
+  @Environment(\.dismiss) private var dismiss
+  @State private var edit: TaskEdit
+  @State private var choices: [TaskTextField: TaskConflictChoice] = [:]
+  @State private var saving = false
+  @State private var error: String?
+
+  init(edit: TaskEdit) {
+    _edit = State(initialValue: edit)
+  }
+
+  var body: some View {
+    let review = model.workspace?.taskConflict(for: edit.taskID)
+    NavigationStack {
+      Form {
+        if let review {
+          Section {
+            Text("This task changed while you were editing. Choose which value to keep for each conflicting field. Other changes will be kept.")
+          }
+          ForEach(review.conflicts) { conflict in
+            Section(conflict.field.label) {
+              choice(.local, label: "Your edit", value: conflict.local, field: conflict.field)
+              choice(.incoming, label: "Incoming edit", value: conflict.incoming, field: conflict.field)
+            }
+          }
+        } else {
+          TextField("Task", text: $edit.text.title, axis: .vertical)
+          TextField("Responsible person", text: $edit.text.responsible)
+        }
+        if let error {
+          Section { Label(error, systemImage: "exclamationmark.triangle").foregroundStyle(.red) }
+        }
+      }
+      .disabled(saving)
+      .navigationTitle(review == nil ? "Edit task" : "Review task changes")
+      .toolbar {
+        ToolbarItem(placement: .cancellationAction) {
+          Button(review == nil ? "Cancel" : "Review later") { dismiss() }.disabled(saving)
+        }
+        ToolbarItem(placement: .confirmationAction) {
+          Button(review == nil ? "Save" : "Resolve") { submit(review) }
+            .disabled(saving || (review?.conflicts.contains { choices[$0.field] == nil } ?? false))
+        }
+      }
+    }
+    .interactiveDismissDisabled(saving)
+    .onChange(of: review) { _, _ in choices = [:] }
+  }
+
+  private func choice(
+    _ selection: TaskConflictChoice, label: String, value: String, field: TaskTextField
+  ) -> some View {
+    let selected = choices[field] == selection
+    return Button {
+      choices[field] = selection
+    } label: {
+      HStack {
+        VStack(alignment: .leading, spacing: 4) {
+          Text(label).font(.subheadline).foregroundStyle(.secondary)
+          if value.isEmpty {
+            Label("No assignee", systemImage: "person.slash")
+              .font(.body.italic())
+              .foregroundStyle(.primary)
+              .accessibilityLabel("Empty value, clear the assignment")
+          } else if let description = Self.whitespaceDescription(value) {
+            Text(description).font(.body.monospaced()).foregroundStyle(.primary)
+              .accessibilityLabel("Whitespace only: \(description)")
+          } else {
+            Text(verbatim: value).foregroundStyle(.primary)
+          }
+        }
+        Spacer()
+        Image(systemName: selected ? "largecircle.fill.circle" : "circle")
+          .accessibilityHidden(true)
+      }
+      .contentShape(Rectangle())
+    }
+    .buttonStyle(.plain)
+    .accessibilityAddTraits(selected ? .isSelected : [])
+  }
+
+  static func whitespaceDescription(_ value: String) -> String? {
+    guard !value.isEmpty, value.allSatisfy(\.isWhitespace) else { return nil }
+    return value.unicodeScalars.map { scalar in
+      switch scalar {
+      case " ": "Space"
+      case "\t": "Tab"
+      case "\n": "Line feed"
+      case "\r": "Carriage return"
+      default: scalar.properties.name ?? "U+\(String(scalar.value, radix: 16, uppercase: true))"
+      }
+    }.joined(separator: ", ")
+  }
+
+  private func submit(_ review: TaskConflictReview?) {
+    let input = edit
+    let decisions = choices
+    saving = true
+    error = nil
+    Task {
+      defer { saving = false }
+      let succeeded: Bool
+      if let review {
+        succeeded = await model.resolveTaskConflict(review, choosing: decisions)
+      } else {
+        succeeded = await model.saveTaskEdit(input)
+      }
+      if succeeded {
+        if model.workspace?.taskConflict(for: edit.taskID) == nil { dismiss() }
+      } else {
+        error = model.saveError ?? "Task could not be saved. Your changes have been kept."
+      }
+    }
+  }
+}
