+import Foundation
+
+public struct TaskSyncScope: Codable, Equatable, Sendable {
+  public let workspaceID: UUID
+  public let projectID: UUID
+  public let taskID: UUID
+
+  public init(workspaceID: UUID, projectID: UUID, taskID: UUID) {
+    self.workspaceID = workspaceID
+    self.projectID = projectID
+    self.taskID = taskID
+  }
+}
+
+public struct TaskSyncHead: Codable, Equatable, Sendable {
+  public let scope: TaskSyncScope
+  public let version: Int64
+  public let text: TaskText
+
+  public init(scope: TaskSyncScope, version: Int64, text: TaskText) {
+    self.scope = scope
+    self.version = version
+    self.text = text
+  }
+}
+
+public struct TaskSyncUpload: Codable, Equatable, Sendable {
+  public let eventID: UUID
+  public let base: TaskSyncHead
+  public let text: TaskText
+}
+
+struct TaskSyncFlight: Codable, Equatable, Sendable {
+  let upload: TaskSyncUpload
+  let eventCount: Int
+}
+
+struct TaskSyncCheckpoint: Codable, Equatable, Sendable {
+  var head: TaskSyncHead
+  var queued: [UUID] = []
+  var flight: TaskSyncFlight?
+}
