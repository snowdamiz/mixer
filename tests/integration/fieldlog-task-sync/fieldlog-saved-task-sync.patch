+extension Workspace {
+  private func syncTaskIndex(_ scope: TaskSyncScope) throws -> Int {
+    guard scope.workspaceID == id,
+      let index = tasks.firstIndex(where: { $0.id == scope.taskID && $0.projectID == scope.projectID })
+    else { throw FieldLogError.missingRecord }
+    return index
+  }
+
+  public mutating func prepareTaskSync(_ scope: TaskSyncScope) throws {
+    let index = try syncTaskIndex(scope)
+    guard taskConflict(for: scope.taskID) == nil else {
+      throw FieldLogError.validation("Resolve the saved task review before synchronizing again.")
+    }
+    guard var sync = tasks[index].textSync, sync.flight == nil,
+      let event = sync.queued.last
+    else { return }
+    sync.flight = TaskSyncFlight(
+      upload: TaskSyncUpload(eventID: event, base: sync.head, text: TaskText(tasks[index])),
+      eventCount: sync.queued.count)
+    tasks[index].textSync = sync
+  }
+
+  public func taskSyncUpload(_ scope: TaskSyncScope) throws -> TaskSyncUpload? {
+    tasks[try syncTaskIndex(scope)].textSync?.flight?.upload
+  }
+
+  public mutating func acknowledgeTaskSync(
+    _ upload: TaskSyncUpload, head: TaskSyncHead
+  ) throws {
+    let index = try syncTaskIndex(upload.base.scope)
+    guard var sync = tasks[index].textSync, let flight = sync.flight,
+      flight.upload == upload, head.scope == sync.head.scope,
+      sync.head.version < Int64.max, head.version == sync.head.version + 1,
+      head.text == upload.text
+    else { throw FieldLogError.staleRevision }
+
+    let acknowledged = Set(sync.queued.prefix(flight.eventCount))
+    outbox.removeAll { acknowledged.contains($0.id) }
+    sync.queued.removeFirst(flight.eventCount)
+    sync.head = head
+    sync.flight = nil
+    tasks[index].textSync = sync
+  }
+
+  public mutating func receiveTaskSync(_ remote: TaskSyncHead, now: Date = Date()) throws {
+    let index = try syncTaskIndex(remote.scope)
+    try remote.text.validate()
+    guard remote.version > 0, taskConflict(for: remote.scope.taskID) == nil else {
+      throw FieldLogError.staleRevision
+    }
+
+    let task = tasks[index]
+    guard let sync = task.textSync else {
+      guard TaskText(task) == remote.text else {
+        throw FieldLogError.validation("Link the task from a matching saved copy first.")
+      }
+      schema = 3
+      tasks[index].textSync = TaskSyncCheckpoint(head: remote)
+      return
+    }
+
+    if remote == sync.head && sync.flight == nil { return }
+    guard remote.version > sync.head.version else { throw FieldLogError.staleRevision }
+
