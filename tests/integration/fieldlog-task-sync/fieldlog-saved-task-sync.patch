+    try storeTaskText(remote.text, at: index, recordLocalChange: false, now: now)
+    if edit.conflicts(against: tasks[index]).isEmpty {
+      let merged = edit.merged(against: tasks[index], choosing: [:])
+      try storeTaskText(merged, at: index, recordLocalChange: true, now: now)
