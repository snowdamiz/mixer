diff --git a/verification/host/SavedTaskSyncReplay.swift b/verification/host/SavedTaskSyncReplay.swift
new file mode 100644
index 0000000000000000000000000000000000000000..2c47c1a193aff6a5f8e0c26f1d77cdadbdd713f2
--- /dev/null
+++ b/verification/host/SavedTaskSyncReplay.swift
@@ -0,0 +1,275 @@
+import FieldLogModels
+import FieldLogStorage
+import Foundation
+
+private struct ProofFailure: Error, CustomStringConvertible {
+  let description: String
+}
+
+private func check(_ condition: Bool, _ message: String) throws {
+  if !condition { throw ProofFailure(description: message) }
+}
+
+private func require<T>(_ value: T?, _ message: String) throws -> T {
+  guard let value else { throw ProofFailure(description: message) }
+  return value
+}
+
+private struct Fixture: Codable {
+  let workspace: UUID
+  let project: UUID
+  let task: UUID
+  let otherTask: UUID
+}
+
+@MainActor
+private struct Journey {
+  let root: URL
+
+  func open(_ name: String) async throws -> WorkspaceModel {
+    let model = WorkspaceModel(workspaceDirectory: root.appending(path: name))
+    await model.open()
+    try check(model.workspace != nil, model.openError ?? "Open saved replica")
+    return model
+  }
+
+  func snapshot(_ model: WorkspaceModel) throws -> Workspace {
+    try require(model.workspace, "Read model state")
+  }
+
+  func disk(_ name: String, file: String = "workspace.json") throws -> Workspace {
+    try JSONDecoder().decode(
+      Workspace.self, from: Data(contentsOf: root.appending(path: name).appending(path: file)))
+  }
+
+  func saveProof(_ name: String, as file: String) throws {
+    let directory = root.appending(path: name)
+    try FileManager.default.copyItem(
+      at: directory.appending(path: "workspace.json"), to: directory.appending(path: file))
+  }
+
+  func seed() async throws {
+    let local = try await open("local")
+    let project = try require(
+      await local.createProject(title: "Inspection round", site: "North yard"), "Save project")
+    try check(await local.addTask(projectID: project, title: "Inspect valve", responsible: "Crew"),
+              "Save common ancestor")
+    try check(await local.addTask(projectID: project, title: "Check gauge", responsible: "Pat"),
+              "Save other task")
+    let state = try snapshot(local)
+    try check(state.schema == 1, "Common ancestor should be a legacy snapshot")
+    let tasks = state.tasks(for: project)
+    let fixture = Fixture(workspace: state.id, project: project, task: tasks[0].id, otherTask: tasks[1].id)
+    let peer = root.appending(path: "peer")
+    try FileManager.default.createDirectory(at: peer, withIntermediateDirectories: true)
+    try FileManager.default.copyItem(
+      at: root.appending(path: "local/workspace.json"), to: peer.appending(path: "workspace.json"))
+    try JSONEncoder().encode(fixture).write(to: root.appending(path: "fixture.json"))
+  }
+
+  func client(_ role: String, fixture: Fixture) throws -> TaskSyncClient {
+    let environment = ProcessInfo.processInfo.environment
+    let port = try require(environment["FIELDLOG_PORT"].flatMap(UInt16.init), "Require local port")
+    let token = try require(environment["FIELDLOG_TOKEN_\(role)"], "Require synthetic token")
+    return try TaskSyncClient(
+      port: port, workspaceID: fixture.workspace, projectID: fixture.project, token: token)
+  }
+
+  func link(_ fixture: Fixture) async throws {
+    let local = try await open("local")
+    let peer = try await open("peer")
+    let original = try snapshot(local)
+    for role in ["INVALID", "OTHER"] {
+      let denied = try client(role, fixture: fixture)
+      try check(!(await local.syncTask(fixture.task, using: denied)), "Unauthenticated or foreign link")
+      try check(local.workspace == original, "Denied request mutated replica")
+    }
+    for (role, model) in [("LOCAL", local), ("PEER", peer)] {
+      let transport = try client(role, fixture: fixture)
+      try check(await model.syncTask(fixture.task, using: transport), model.saveError ?? "Link common ancestor")
+      try check(model.workspace?.schema == 3 && model.workspace?.outbox == original.outbox,
+                "Link mutated existing outbox")
+    }
+    print("linked both saved replicas with scoped bearer tokens")
+  }
+
+  func edit(
+    _ model: WorkspaceModel, task: UUID, title: String? = nil, responsible: String? = nil
+  ) async throws {
+    var editor = try require(model.editTask(task), "Open the saved-task editor")
+    if let title { editor.text.title = title }
+    if let responsible { editor.text.responsible = responsible }
+    try check(await model.saveTaskEdit(editor), model.saveError ?? "Save the task editor")
+  }
+
+  func offline(_ fixture: Fixture) async throws {
+    let local = try await open("local")
+    let peer = try await open("peer")
+    local.toggleTask(fixture.task)
+    local.moveTask(fixture.task, offset: 1)
+    await local.flush()
+    try await edit(local, task: fixture.otherTask, title: "Check gauge offline")
+
+    var entry = try require(await local.newDraft(projectID: fixture.project), "Create unrelated entry")
+    entry.title = "Saved offline entry"
+    try check(await local.commit(entry), "Save unrelated entry")
+    var draft = try require(await local.newDraft(projectID: fixture.project), "Create offline draft")
+    draft.title = "Unsubmitted offline draft"
+    draft.note = "Preserve the text and restoration state."
+    try check(await local.keepDraft(draft), "Save the offline draft")
+
+    for name in ["local", "peer"] { try saveProof(name, as: "before-text.json") }
+    try await edit(local, task: fixture.task, title: "Inspect valve today")
+    try await edit(peer, task: fixture.task, title: "Inspect valve after shutdown", responsible: "Morgan")
+    for (name, model) in [("local", local), ("peer", peer)] {
+      let before = try disk(name, file: "before-text.json")
+      let after = try snapshot(model)
+      try check(after.outbox.count == before.outbox.count + 1
+                && after.outbox.dropLast().elementsEqual(before.outbox)
+                && after.outbox.last?.recordID == fixture.task
+                && after.taskConflict(for: fixture.task) == nil
+                && after == disk(name), "Independent editor save did not reach disk")
+      try saveProof(name, as: "offline.json")
+    }
+    print("saved competing edits before either replica could reconnect")
+  }
+
+  func conflict(_ fixture: Fixture) async throws {
+    let local = try await open("local")
+    let peer = try await open("peer")
+    let localOffline = try disk("local", file: "offline.json")
+    let peerOffline = try disk("peer", file: "offline.json")
+    try check(local.workspace == localOffline && peer.workspace == peerOffline, "Offline state did not reopen")
+
+    let peerClient = try client("PEER", fixture: fixture)
+    try check(await peer.syncTask(fixture.task, using: peerClient), peer.saveError ?? "Upload peer save")
+    try check(try snapshot(peer).outbox == disk("peer", file: "before-text.json").outbox,
+              "Peer upload changed unrelated queue entries")
+
+    let transport = try client("LOCAL", fixture: fixture)
+    try check(await local.syncTask(fixture.task, using: transport), local.saveError ?? "Import peer save")
+    let pending = try snapshot(local)
+    let review = try require(pending.taskConflict(for: fixture.task), "Transport did not create a review")
+    try check(review.conflicts.count == 1 && review.conflicts.first?.field == .title
+              && review.conflicts.first?.local == "Inspect valve today"
+              && review.conflicts.first?.incoming == "Inspect valve after shutdown", "Wrong review")
+    try preservingOfflineState(local, fixture: fixture)
+    let task = try require(pending.tasks.first { $0.id == fixture.task }, "Review task")
+    try check(task.responsible == "Morgan" && pending == disk("local"), "Incoming assignment was lost")
+    try saveProof("local", as: "review.json")
+    print("received peer edit over HTTP and committed the saved-title review")
+  }
+
+  func preservingOfflineState(
+    _ local: WorkspaceModel, fixture: Fixture, taskEvents: Int = 0
+  ) throws {
+    let before = try disk("local", file: "before-text.json")
+    let after = try snapshot(local)
+    let task = try require(after.tasks.first { $0.id == fixture.task }, "Saved task")
+    let baselineIDs = Set(before.outbox.map(\.id))
+    try check(after.outbox.filter { baselineIDs.contains($0.id) } == before.outbox
+              && after.outbox.count == before.outbox.count + taskEvents
+              && after.outbox.filter { !baselineIDs.contains($0.id) }.allSatisfy({
+                $0.recordID == fixture.task && $0.kind == .taskSaved
+              }), "Unrelated outbox rows changed")
+    try check(task.completed && task.position == 1
+              && after.tasks.filter { $0.id != fixture.task } == before.tasks.filter { $0.id != fixture.task }
+              && after.projects == before.projects && after.entries == before.entries
+              && after.drafts == before.drafts && after.restoration == before.restoration,
+              "Unrelated offline data changed")
+  }
+
+  func resolve(_ fixture: Fixture) async throws {
+    let local = try await open("local")
+    try check(local.workspace == disk("local", file: "review.json"), "Cold reopen lost conflict")
+    let review = try require(local.workspace?.taskConflict(for: fixture.task), "Reopen the review")
+    try check(local.editTask(fixture.task) != nil, "Ordinary editor cannot open the review")
+    let pending = try snapshot(local)
+    try check(!(await local.resolveTaskConflict(review, choosing: [:])) && local.workspace == pending,
+              "An incomplete decision mutated the review")
+    try check(await local.resolveTaskConflict(review, choosing: [.title: .local]),
+              local.saveError ?? "Choose local title")
+    let resolved = try snapshot(local)
+    let text = try require(local.editTask(fixture.task)?.text, "Resolved editor text")
+    try check(text.title == "Inspect valve today" && text.responsible == "Morgan"
+              && resolved.taskConflict(for: fixture.task) == nil, "Choice erased independent peer edit")
+    try check(await local.resolveTaskConflict(review, choosing: [.title: .local])
+              && local.workspace == resolved, "Retrying Resolve created a second change")
+
+    let transport = try client("LOCAL", fixture: fixture)
+    try check(!(await local.syncTask(fixture.task, using: transport)), "Truncated receipt was accepted")
+    try preservingOfflineState(local, fixture: fixture, taskEvents: 1)
+    try saveProof("local", as: "interrupted.json")
+    print("applied the user choice and kept the resolved edit queued after a lost receipt")
+  }
+
+  func subsequentEdit(_ fixture: Fixture) async throws {
+    let local = try await open("local")
+    try check(local.workspace == disk("local", file: "interrupted.json"),
+              "Reopen after the lost receipt changed Flight or local state")
+    try await edit(local, task: fixture.task, responsible: "Later offline assignee")
+    try preservingOfflineState(local, fixture: fixture, taskEvents: 2)
+    try saveProof("local", as: "later-offline.json")
+    print("saved a newer same-task edit with the backend offline")
+  }
+
+  func retry(_ fixture: Fixture) async throws {
+    let local = try await open("local")
+    try check(local.workspace == disk("local", file: "later-offline.json"), "Newer offline edit did not reopen")
+    let transport = try client("LOCAL", fixture: fixture)
+    let before = try snapshot(local)
+    try check(await local.syncTask(fixture.task, using: transport), local.saveError ?? "Replay lost receipt")
+    let after = try snapshot(local)
+    try check(after.outbox.last == before.outbox.last
+              && local.editTask(fixture.task)?.text.responsible == "Later offline assignee",
+              "Retry retired or overwrote the newer edit")
+    try preservingOfflineState(local, fixture: fixture, taskEvents: 1)
+    try check(await local.syncTask(fixture.task, using: transport), local.saveError ?? "Send the later edit")
+    try preservingOfflineState(local, fixture: fixture)
+    try saveProof("local", as: "final.json")
+    print("retried the committed event exactly once, then synchronized the later offline edit")
+  }
+
+  func converge(_ fixture: Fixture) async throws {
+    let local = try await open("local")
+    let peer = try await open("peer")
+    try check(local.workspace == disk("local", file: "final.json"), "Final local state did not reopen")
+    let transport = try client("PEER", fixture: fixture)
+    try check(await peer.syncTask(fixture.task, using: transport), peer.saveError ?? "Peer fetch selected text")
+    let current = try snapshot(peer)
+    let text = try require(peer.editTask(fixture.task)?.text, "Peer converged editor text")
+    try check(text == local.editTask(fixture.task)?.text && text.title == "Inspect valve today"
+              && text.responsible == "Later offline assignee" && current.taskConflict(for: fixture.task) == nil
+              && current.outbox == disk("peer", file: "before-text.json").outbox && current == disk("peer"),
+              "Peer failed to converge or changed unrelated rows")
+    try check(await peer.syncTask(fixture.task, using: transport) && peer.workspace == current,
+              "Repeated fetch rewrote a converged replica")
+    print("both replicas reopened with the chosen title and later offline edit")
+  }
+}
+
+@main
+struct SavedTaskSyncReplay {
+  @MainActor static func main() async throws {
+    let arguments = CommandLine.arguments
+    try check(arguments.count == 3, "Usage: SavedTaskSyncReplay PHASE OWNED_DATA")
+    let journey = Journey(root: URL(fileURLWithPath: arguments[2], isDirectory: true))
+    let phase = arguments[1]
+    if phase == "seed" {
+      try await journey.seed()
+      return
+    }
+    let fixture = try JSONDecoder().decode(
+      Fixture.self, from: Data(contentsOf: journey.root.appending(path: "fixture.json")))
+    switch phase {
+    case "link": try await journey.link(fixture)
+    case "offline": try await journey.offline(fixture)
+    case "conflict": try await journey.conflict(fixture)
+    case "resolve": try await journey.resolve(fixture)
+    case "subsequent-edit": try await journey.subsequentEdit(fixture)
+    case "retry": try await journey.retry(fixture)
+    case "converge": try await journey.converge(fixture)
+    default: throw ProofFailure(description: "Unknown replay phase: \(phase)")
+    }
+  }
+}
diff --git a/verification/host/replay-saved-task-sync.py b/verification/host/replay-saved-task-sync.py
new file mode 100644
index 0000000000000000000000000000000000000000..08f9577adf0b5035027b545038f5b88a73fe6f13
--- /dev/null
+++ b/verification/host/replay-saved-task-sync.py
@@ -0,0 +1,210 @@
+"""Replay two saved FieldLog replicas through the provisioned SQLite loopback service."""
+
+from contextlib import closing, contextmanager
+import http.client
+import importlib.util
+import json
+import os
+from pathlib import Path
+import secrets
+import socket
+import sqlite3
+import sys
+from threading import Thread
+import uuid
+
+SOURCE = Path(__file__).resolve().parents[2]
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, SOURCE / path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def check(condition, message):
+    if not condition:
+        raise RuntimeError(message)
+
+
+@contextmanager
+def listener(backend, db, accounts, handler):
+    with backend.make_server(db, accounts, handler_class=handler) as server:
+        server_thread = Thread(target=server.serve_forever, kwargs={"poll_interval": 0.05})
+        server_thread.start()
+        try:
+            yield server.server_port
+        finally:
+            server.shutdown()
+            server_thread.join(timeout=3)
+            check(not server_thread.is_alive(), "Owned loopback service failed to close")
+    with socket.socket() as reuse:
+        reuse.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+        reuse.bind(("127.0.0.1", server.server_port))
+    print(f"listener closed and port {server.server_port} rebound", flush=True)
+
+
+def readback(db):
+    with closing(sqlite3.connect(db)) as connection:
+        task, version, text = connection.execute(
+            "SELECT task_id, version, text_json FROM task_heads"
+        ).fetchone()
+        rows = connection.execute(
+            """SELECT account_id, workspace_id, project_id, task_id, event_id,
+                      proposal_json, receipt_json
+               FROM task_events ORDER BY json_extract(receipt_json, '$.head.version')"""
+        ).fetchall()
+        check(connection.execute("PRAGMA foreign_key_check").fetchall() == [], "Invalid task link")
+        check(connection.execute("SELECT COUNT(*) FROM entry_events").fetchone() == (0,),
+              "Task sync unexpectedly transported another outbox kind")
+    return (task, version, json.loads(text)), [
+        (*row[:5], json.loads(row[5]), json.loads(row[6])) for row in rows
+    ]
+
+
+def exercise(run, executable, root, env):
+    backend = load("local_entry_sync", "Backend/local_entry_sync.py")
+    data, db = root / "replicas", root / "tasks.sqlite3"
+    data.mkdir()
+
+    def phase(name, port=None):
+        variables = env if port is None else dict(env, FIELDLOG_PORT=str(port))
+        run([executable, name, data], SOURCE, variables)
+
+    phase("seed")
+    fixture = {key: value.lower() for key, value in json.loads((data / "fixture.json").read_bytes()).items()}
+    workspace, project, task = (fixture[key] for key in ("workspace", "project", "task"))
+    scope = (workspace, project)
+    key = ("test-team", workspace, project, task)
+    tokens = {role: secrets.token_urlsafe(32) for role in ("LOCAL", "PEER", "OTHER", "INVALID")}
+    accounts = {
+        tokens["LOCAL"]: (key[0], {scope}),
+        tokens["PEER"]: (key[0], {scope}),
+        tokens["OTHER"]: ("other-team", {(str(uuid.uuid4()), str(uuid.uuid4()))}),
+    }
+    env = dict(env, **{f"FIELDLOG_TOKEN_{role}": token for role, token in tokens.items()})
+
+    def saved(replica, file):
+        return json.loads((data / replica / file).read_bytes())
+
+    def text(state):
+        record = next(row for row in state["tasks"] if row["id"].lower() == task)
+        return {field: record[field] for field in ("title", "responsible")}
+
+    def event_id(state, offset=-1):
+        return state["outbox"][offset]["id"].lower()
+
+    path = f"/v1/workspaces/{workspace}/projects/{project}/tasks/{task}"
+    responses = []
+    committed_before_lost_receipt = []
+
+    class Trace(backend.EntrySyncHandler):
+        def _send_json(self, status, body):
+            responses.append((self.command, int(status)))
+            super()._send_json(status, body)
+
+        def send_receipt(self, status, receipt):
+            if status == 201 and receipt["head"]["version"] == 3:
+                committed_before_lost_receipt.append(readback(db))
+                responses.append((self.command, int(status)))
+                encoded = json.dumps(receipt).encode()
+                self.send_response(status)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(encoded)))
+                self.end_headers()
+                self.wfile.write(encoded[:12])
+                self.close_connection = True
+            else:
+                super().send_receipt(status, receipt)
+
+    common = text(saved("local", "workspace.json"))
+    with listener(backend, db, accounts, Trace) as port:
+        backend.provision_task(db, *key, common)
+        phase("link", port)
+    check(responses == [("GET", 401), ("GET", 404), ("GET", 200), ("GET", 200)],
+          f"Unexpected link traffic {responses}")
+
+    phase("offline")
+    check(readback(db) == ((task, 1, common), []), "Offline editor saves reached SQLite")
+    local_offline = saved("local", "offline.json")
+    peer_offline = saved("peer", "offline.json")
+    with listener(backend, db, accounts, Trace) as port:
+        phase("conflict", port)
+        intermediate, events = readback(db)
+        check(intermediate == (task, 2, text(peer_offline))
+              and len(events) == 1 and events[0][:5] == key + (event_id(peer_offline),),
+              "SQLite did not receive the exact saved peer event")
+        check(event_id(local_offline) != event_id(peer_offline), "Replica event IDs collided")
+        phase("resolve", port)
+    interrupted = saved("local", "interrupted.json")
+    after_loss = readback(db)
+    check(committed_before_lost_receipt == [after_loss]
+          and after_loss[0] == (task, 3, text(interrupted))
+          and after_loss[1][1][:5] == key + (event_id(interrupted),),
+          "Resolved event was not durable before the interrupted response")
+
+    phase("subsequent-edit")
+    check(readback(db) == after_loss, "Second offline save reached SQLite")
+    later = saved("local", "later-offline.json")
+    with listener(backend, db, accounts, Trace) as port:
+        phase("retry", port)
+        phase("converge", port)
+        final_head, final_events = readback(db)
+        check(final_head == (task, 4, text(later)) and final_events[:2] == after_loss[1]
+              and len(final_events) == 3 and final_events[2][:5] == key + (event_id(later),),
+              "Retry duplicated an event or rewrote its payload")
+        old_event = final_events[1]
+        exact = dict(old_event[5], base=dict(old_event[5]["base"], scope={
+            name: value.upper() for name, value in old_event[5]["base"]["scope"].items()
+        }))
+        with closing(http.client.HTTPConnection("127.0.0.1", port, timeout=3)) as connection:
+            headers = {"Authorization": f"Bearer {tokens['LOCAL']}", "Content-Type": "application/json"}
+            connection.request("POST", path, json.dumps(exact), headers)
+            with connection.getresponse() as response:
+                check(response.status == 200 and json.load(response) == old_event[6],
+                      "Replay after a newer commit did not return the original receipt")
+            divergent = dict(exact, text=dict(exact["text"], title="Unexpected replay"))
+            connection.request("POST", path, json.dumps(divergent), headers)
+            with connection.getresponse() as response:
+                check(response.status == 409 and json.load(response) == {"error": "event_payload_conflict"},
+                      "Backend accepted a divergent event retry")
+        check(readback(db) == (final_head, final_events), "Historical replay changed SQLite")
+    check(responses[4:] == [
+        ("POST", 201), ("POST", 409), ("GET", 200), ("POST", 201),
+        ("POST", 200), ("POST", 201), ("GET", 200), ("GET", 200), ("POST", 200), ("POST", 409),
+    ], f"Unexpected sync traffic {responses}")
+    print(json.dumps({"http": responses, "taskVersion": final_head[1], "taskEvents": len(final_events),
+                      "finalText": final_head[2], "unrelatedOutbox": len(local_offline["outbox"]) - 1}))
