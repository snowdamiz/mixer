diff --git a/ios/FieldLog/WorkspaceModel.swift b/ios/FieldLog/WorkspaceModel.swift
index e7d2684..393a555 100644
--- a/ios/FieldLog/WorkspaceModel.swift
+++ b/ios/FieldLog/WorkspaceModel.swift
@@ -121,6 +121,31 @@ import SwiftUI
   func syncTask(_ id: UUID, using client: TaskSyncClient) async -> Bool {
     await enqueueSave { try await client.synchronize(taskID: id, in: $0) }.value
   }
+  func canSyncSavedTask(_ id: UUID) -> Bool {
+    savedTaskSyncClient(for: id) != nil
+  }
+  func syncSavedTask(_ id: UUID) async -> Bool {
+    guard pendingSaves == 0, let client = savedTaskSyncClient(for: id) else { return false }
+    return await syncTask(id, using: client)
+  }
+  private func savedTaskSyncClient(for id: UUID) -> TaskSyncClient? {
+    #if DEBUG
+      let environment = ProcessInfo.processInfo.environment
+      guard isTestWorkspace || workspaceDirectory != nil,
+        let workspace,
+        let task = workspace.tasks.first(where: { $0.id == id }),
+        workspace.taskConflict(for: id) == nil,
+        environment["FIELDLOG_TASK_SYNC_WORKSPACE"].flatMap(UUID.init(uuidString:)) == workspace.id,
+        environment["FIELDLOG_TASK_SYNC_PROJECT"].flatMap(UUID.init(uuidString:)) == task.projectID,
+        environment["FIELDLOG_TASK_SYNC_TASK"].flatMap(UUID.init(uuidString:)) == id,
+        let port = environment["FIELDLOG_TASK_SYNC_PORT"].flatMap(UInt16.init),
+        let token = environment["FIELDLOG_TASK_SYNC_TOKEN"]
+      else { return nil }
+      return try? TaskSyncClient(port: port, workspaceID: workspace.id, projectID: task.projectID, token: token)
+    #else
+      return nil
+    #endif
+  }
   func toggleTask(_ id: UUID) { enqueue { try $0.toggleTask(id) } }
   func reorder(projectID: UUID, ids: [UUID]) {
     enqueue { try $0.reorderTasks(projectID: projectID, ids: ids) }
diff --git a/ios/FieldLogUITests/FieldLogUITests.swift b/ios/FieldLogUITests/FieldLogUITests.swift
index b591f39..e9e82a9 100644
--- a/ios/FieldLogUITests/FieldLogUITests.swift
+++ b/ios/FieldLogUITests/FieldLogUITests.swift
@@ -118,3 +118,136 @@ import XCTest
     add(attachment)
   }
 }
+
+extension FieldLogUITests {
+  func testSavedTaskConflictSavesOffline() throws {
+    continueAfterFailure = false
+    let fixture = try savedTaskFixture()
+    let app = openSavedTaskProject(fixture.workspace)
+    defer { app.terminate() }
+
+    openSavedTaskMenu(fixture.task, in: app)
+    XCTAssertFalse(app.buttons["Sync task"].exists)
+    tapSavedTaskAction("Edit task", in: app)
+    let title = savedTitle(in: app)
+    XCTAssertEqual(title.value as? String, "Inspect valve")
+    title.coordinate(withNormalizedOffset: CGVector(dx: 0.9, dy: 0.5)).tap()
+    title.typeText(" today")
+    XCTAssertEqual(title.value as? String, "Inspect valve today")
+    app.navigationBars["Edit task"].buttons["Save"].tap()
+    XCTAssertTrue(app.buttons["Inspect valve today, completed"].waitForExistence(timeout: 10))
+    XCTAssertTrue(app.buttons["Check gauge offline, not completed"].exists)
+  }
+
+  func testSavedTaskConflictResolvesAndReopens() throws {
+    continueAfterFailure = false
+    let fixture = try savedTaskFixture()
+    let variables = ProcessInfo.processInfo.environment
+    var session: [String: String] = [:]
+    for field in ["WORKSPACE", "PROJECT", "TASK", "PORT", "TOKEN"] {
+      let key = "FIELDLOG_TASK_SYNC_\(field)"
+      session[key] = try XCTUnwrap(variables[key], "Missing fixture input \(key)")
+    }
+    let app = openSavedTaskProject(fixture.workspace, session: session)
+    defer { app.terminate() }
+
+    XCTAssertTrue(app.buttons["Inspect valve today, completed"].waitForExistence(timeout: 10))
+    openSavedTaskMenu(fixture.task, in: app)
+    tapSavedTaskAction("Sync task", in: app)
+    assertSavedTaskStatus("Changes to review", task: fixture.task, in: app)
+
+    openSavedTaskMenu(fixture.task, in: app)
+    tapSavedTaskAction("Review changes", in: app)
+    let review = app.navigationBars["Review task changes"]
+    XCTAssertTrue(review.waitForExistence(timeout: 10))
+    XCTAssertFalse(review.buttons["Resolve"].isEnabled)
+    review.buttons["Review later"].tap()
+
+    app.terminate()
+    app.launch()
+    XCTAssertTrue(app.navigationBars["Inspection round"].waitForExistence(timeout: 15))
+    assertSavedTaskStatus("Changes to review", task: fixture.task, in: app)
+    openSavedTaskMenu(fixture.task, in: app)
+    tapSavedTaskAction("Review changes", in: app)
+    XCTAssertTrue(review.waitForExistence(timeout: 10))
+    let local = app.buttons["conflict-title-local"]
+    let incoming = app.buttons["conflict-title-incoming"]
+    XCTAssertTrue(local.waitForExistence(timeout: 5))
+    XCTAssertTrue(incoming.exists)
+    XCTAssertTrue(local.label.contains("Inspect valve today"), local.label)
+    XCTAssertTrue(incoming.label.contains("Inspect valve after shutdown"), incoming.label)
+    XCTAssertFalse(app.buttons["conflict-responsible-local"].exists)
+    XCTAssertFalse(review.buttons["Resolve"].isEnabled)
+    local.tap()
+    XCTAssertTrue(review.buttons["Resolve"].isEnabled)
+    review.buttons["Resolve"].tap()
+    XCTAssertTrue(app.buttons["Inspect valve today, completed"].waitForExistence(timeout: 10))
+
+    openSavedTaskMenu(fixture.task, in: app)
+    tapSavedTaskAction("Sync task", in: app)
+    assertSavedTaskStatus("Task sync finished", task: fixture.task, in: app)
+    app.terminate()
+    app.launchEnvironment = [:]
+    app.launch()
+    XCTAssertTrue(app.navigationBars["Inspection round"].waitForExistence(timeout: 15))
+    XCTAssertTrue(app.buttons["Inspect valve today, completed"].waitForExistence(timeout: 10))
+    XCTAssertTrue(app.buttons["Check gauge offline, not completed"].exists)
+    openSavedTaskMenu(fixture.task, in: app)
+    XCTAssertFalse(app.buttons["Sync task"].exists)
+    tapSavedTaskAction("Edit task", in: app)
+    XCTAssertEqual(savedTitle(in: app).value as? String, "Inspect valve today")
+    XCTAssertEqual(app.textFields["saved-task-responsible"].value as? String, "Morgan")
+    app.navigationBars["Edit task"].buttons["Cancel"].tap()
+  }
+
+  private func savedTaskFixture() throws -> (workspace: String, task: String) {
+    let variables = ProcessInfo.processInfo.environment
+    try XCTSkipUnless(variables["FIELDLOG_UI_TASK_WORKSPACE"] != nil,
+                      "Run this test with the local saved-task replay fixture.")
+    let workspace = try XCTUnwrap(variables["FIELDLOG_UI_TASK_WORKSPACE"].flatMap(UUID.init(uuidString:)))
+    let task = try XCTUnwrap(variables["FIELDLOG_UI_TASK_ID"].flatMap(UUID.init(uuidString:)))
+    return (workspace.uuidString.lowercased(), task.uuidString.lowercased())
+  }
+
+  private func openSavedTaskProject(
+    _ workspace: String, session: [String: String] = [:]
+  ) -> XCUIApplication {
+    let app = XCUIApplication()
+    app.launchArguments = ["--fieldlog-ui-workspace", workspace]
+    app.launchEnvironment = session
+    app.launch()
+    XCTAssertTrue(app.navigationBars["Inspection round"].waitForExistence(timeout: 15))
+    return app
+  }
+
+  private func savedTitle(in app: XCUIApplication) -> XCUIElement {
+    let fields = app.textFields.matching(identifier: "saved-task-title")
+    let editors = app.textViews.matching(identifier: "saved-task-title")
+    let unique = XCTNSPredicateExpectation(predicate: NSPredicate { _, _ in
+      fields.count + editors.count == 1
+    }, object: nil)
+    XCTAssertEqual(XCTWaiter.wait(for: [unique], timeout: 5), .completed)
+    return fields.count == 1 ? fields.firstMatch : editors.firstMatch
+  }
+
+  private func openSavedTaskMenu(_ task: String, in app: XCUIApplication) {
+    let menu = app.buttons["task-options-\(task)"]
+    XCTAssertTrue(menu.waitForExistence(timeout: 10))
+    reveal(menu, in: app)
+    menu.tap()
+  }
+
+  private func tapSavedTaskAction(_ label: String, in app: XCUIApplication) {
+    let action = app.buttons[label]
+    XCTAssertTrue(action.waitForExistence(timeout: 5))
+    XCTAssertTrue(action.isEnabled)
+    action.tap()
+  }
+
+  private func assertSavedTaskStatus(_ status: String, task: String, in app: XCUIApplication) {
+    let menu = app.buttons["task-options-\(task)"]
+    XCTAssertTrue(menu.waitForExistence(timeout: 10))
+    let updated = XCTNSPredicateExpectation(predicate: NSPredicate(format: "value == %@", status), object: menu)
+    XCTAssertEqual(XCTWaiter.wait(for: [updated], timeout: 10), .completed, app.debugDescription)
+  }
+}
