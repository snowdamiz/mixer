--- /dev/null
+++ b/Integrations/InstalledGuest/FieldLogDraftStorage.swift
@@ -0,0 +1,68 @@
+import FieldLogModels
+import FieldLogStorage
+import Foundation
+import MixerCapabilities
+
+public struct FieldLogDraftStorage: InstalledApplicationStorageServing {
+    public static let namespace = "fieldlog-task-v1"
+    private static let key = "selected-draft"
+    private let repository: WorkspaceRepository
+    private let projectID: UUID
+    private let draftID: UUID
+
+    public init(repository: WorkspaceRepository, projectID: UUID, draftID: UUID) {
+        self.repository = repository
+        self.projectID = projectID
+        self.draftID = draftID
+    }
+
+    public func get(_ arguments: KVGetArguments) async throws -> KVGetResponse {
+        try authorize(arguments.namespace, arguments.key)
+        try Task.checkCancellation()
+        let (revision, saved) = try await repository.readSavedDraft(projectID: projectID, draftID: draftID)
+        guard let draft = saved else {
+            return .init(found: false, valueBase64: "")
+        }
+        // ABI: big-endian revision, then raw title presence, title validity, photo linkage, and follow-up.
+        var bytes = withUnsafeBytes(of: revision.bigEndian) { Data($0) }
+        var flags: UInt8 = 0
+        if !draft.title.isEmpty { flags |= 1 }
+        if (try? draft.validateTitleForCommit()) != nil { flags |= 2 }
+        if !draft.attachmentIDs.isEmpty { flags |= 4 }
+        if let followUp = draft.followUpRequired { flags |= followUp ? 8 : 16 }
+        bytes.append(flags)
+        return .init(found: true, valueBase64: bytes.base64EncodedString())
+    }
+
+    public func put(_ arguments: KVPutArguments, maximumTotalBytes: Int, maximumEntries: Int) async throws -> KVMutationResponse {
+        try authorize(arguments.namespace, arguments.key)
+        guard let bytes = Data(base64Encoded: arguments.valueBase64), bytes.count == 9,
+              let value = bytes.last, value == 1 || value == 2 else { throw CapabilityFailure.invalidResponse }
+        let revision = bytes.prefix(8).reduce(UInt64(0)) { ($0 << 8) | UInt64($1) }
+        do {
+            _ = try await repository.transact(expectedRevision: revision) { workspace in
+                try Task.checkCancellation()
+                guard let index = workspace.drafts.firstIndex(where: { $0.id == draftID && $0.projectID == projectID })
+                else { throw CapabilityFailure.permissionDenied }
+                guard workspace.drafts[index].followUpRequired != (value == 1) else { throw NoChange() }
+                guard maximumTotalBytes >= bytes.count, maximumEntries >= 1 else { throw CapabilityFailure.quotaExceeded }
+                workspace.drafts[index].followUpRequired = value == 1
+            }
+            return .init(committed: true)
+        } catch is NoChange {
+            return .init(committed: true)
+        } catch FieldLogError.staleRevision {
+            return .init(committed: false)
+        }
+    }
+
+    public func delete(_ arguments: KVDeleteArguments) async throws -> KVMutationResponse {
+        throw CapabilityFailure.permissionDenied
+    }
+
+    private func authorize(_ namespace: String, _ key: String) throws {
+        guard namespace == Self.namespace, key == Self.key else { throw CapabilityFailure.permissionDenied }
+    }
+
+    private struct NoChange: Error {}
+}
