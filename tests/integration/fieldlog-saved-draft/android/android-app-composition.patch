new file mode 100644
index 0000000000000000000000000000000000000000..e078d8caa56a950329ac215eee7e40144ad61ceb
--- /dev/null
+++ b/Integrations/GeneratedReport/scripts/build-signed-checklist-android.py
@@ -0,0 +1,217 @@
+#!/usr/bin/env python3
+"""Assemble and verify the FieldLog signed-checklist development APK."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import runpy
+import stat
+import subprocess
+import sys
+import tempfile
+import zipfile
+
+APPEARANCE = "MixerAppearanceV2/descriptor.json"
+APPEARANCE_BYTES = 9587
+APPEARANCE_SHA256 = "1aeab75c457c21e5c801ab8b446490971d510021c945d0841252360becd8ead3"
+CHECKLIST_LIMITS = {
+    "bridge.json": 65_536,
+    "identity.json": 131_072,
+    "port.txt": 32,
+    "roots.json": 65_536,
+    "storage-grant.json": 65_536,
+    "storage.json": 65_536,
+}
+MANIFEST_MEMBERS = {"AndroidManifest.xml", "res/xml/checklist_network.xml", "resources.arsc"}
+NATIVE_PREFIX = "lib/arm64-v8a/"
+
+
+def read_bounded(path, limit):
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    with os.fdopen(fd, "rb") as stream:
+        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
+            raise ValueError(f"Expected a regular file: {path}")
+        data = stream.read(limit + 1)
+    if not 0 < len(data) <= limit:
+        raise ValueError(f"Invalid input size: {path}")
+    return data
+
+
+def appearance_asset(project):
+    directory = project
+    for component in ("Generated", "MixerAndroid", "app", "assets", "MixerAppearanceV2"):
+        directory /= component
+        if directory.is_symlink() or not directory.is_dir():
+            raise ValueError(f"Missing or invalid Mixer appearance directory: {directory}")
+    descriptor = read_bounded(directory / "descriptor.json", APPEARANCE_BYTES)
+    if len(descriptor) != APPEARANCE_BYTES or hashlib.sha256(descriptor).hexdigest() != APPEARANCE_SHA256:
+        raise ValueError(f"Mixer appearance descriptor differs from the admitted default: {directory}")
+    return descriptor
+
+
+def checklist_assets(directory, lock):
+    if directory.is_symlink() or {path.name for path in directory.iterdir()} != CHECKLIST_LIMITS.keys():
+        raise ValueError("Expected exactly the six Installed checklist inputs")
+    pins = json.loads(read_bounded(lock, 4096))
+    if not isinstance(pins, dict) or pins.keys() != CHECKLIST_LIMITS.keys():
+        raise ValueError("Checklist SHA-256 JSON must pin exactly the six Installed files")
+    assets = {}
+    for name, limit in CHECKLIST_LIMITS.items():
+        data = read_bounded(directory / name, limit)
+        if hashlib.sha256(data).hexdigest() != pins[name]:
+            raise ValueError(f"Installed checklist input differs from its SHA-256 pin: {name}")
+        assets[f"assets/ChecklistRelease/{name}"] = data
+    return assets
+
+
+def run(env, *args):
+    return subprocess.check_output(args, env=env, text=True, stderr=subprocess.STDOUT, timeout=90)
+
+
+def native_libraries(engine, ndk, swift_sdk, env):
+    sys_libs = ndk / "sysroot/usr/lib/aarch64-linux-android"
+    platform_libs = {path.name for path in (sys_libs / "28").glob("*.so")}
+    if not platform_libs or engine.name != "libmixer_public_android_jni.so":
+        raise ValueError("Expected the Android 28 sysroot and the signed-checklist JNI library")
+    swift_libs = swift_sdk / "swift-resources/usr/lib/swift-aarch64/android"
+    libraries = {engine.name: engine}
+    pending = [engine]
+    while pending:
+        library = pending.pop()
+        dump = run(env, ndk / "bin/llvm-readelf", "-h", "-d", "-lW", library)
+        loads = [line.split() for line in dump.splitlines() if line.lstrip().startswith("LOAD ")]
+        if not re.search(r"^\s*Machine:\s*AArch64\s*$", dump, re.MULTILINE) or not loads:
+            raise ValueError(f"Expected an arm64 ELF with loadable segments: {library}")
+        if any(int(load[-1], 16) < 16_384 for load in loads):
+            raise ValueError(f"ELF load alignment is below 16 KiB: {library}")
+        for name in re.findall(r"\(NEEDED\)[^\n]*\[([^\]]+)\]", dump):
+            if not re.fullmatch(r"lib[A-Za-z0-9_+.-]+\.so", name):
+                raise ValueError(f"Invalid ELF dependency name: {name}")
+            if name in platform_libs or name in libraries:
+                continue
+            path = (sys_libs if name == "libc++_shared.so" else swift_libs) / name
+            libraries[name] = path
+            pending.append(path)
+    return libraries
+
+
+def runtime_notices(project, libraries, ndk, swift_sdk):
+    # Reuse the notice bound to the ICU payload by the generated Mixer builder.
+    swift_license = swift_sdk / "swift-resources/usr/share/swift/LICENSE.txt"
+    paths = {"Swift-SDK-LICENSE.txt": swift_license}
+    if "libc++_shared.so" in libraries:
+        paths.update({"Android-NDK-NOTICE.txt": ndk.parents[3] / "NOTICE",
+                      "Android-NDK-NOTICE.toolchain.txt": ndk.parents[3] / "NOTICE.toolchain"})
+    notices = {f"third-party-notices/{name}": read_bounded(path, 2 * 1024 * 1024)
+               for name, path in paths.items()}
+    if icu := libraries.get("lib_FoundationICU.so"):
+        mixer = runpy.run_path(str(project / "Generated/MixerAndroid/android-build.py"))
+        if hashlib.sha256(icu.read_bytes()).hexdigest() != "41171d3eed0f99b2057b9b528c14a4ad27d07f1e102d106facfcd0db8faf2a4a":
+            raise ValueError("Foundation ICU has no verified notice binding")
+        notices["third-party-notices/Apple-ICU-76.1-LICENSE.txt"] = mixer["APPLE_ICU_LICENSE"].encode("utf-8")
+    return notices
+
+
+def verify_image(path, assets, libraries, notices, signed=False):
+    with zipfile.ZipFile(path) as apk:
+        names = apk.namelist()
+        if len(set(names)) != len(names):
+            raise ValueError("Duplicate APK entry")
+        if {name for name in names if name.startswith("assets/")} != assets.keys():
+            raise ValueError("APK asset inventory differs from the appearance and checklist inputs")
+        for name, data in assets.items():
+            with apk.open(name) as stream:
+                if stream.read(len(data) + 1) != data:
+                    raise ValueError(f"APK asset differs from its admitted input: {name}")
+        for name, data in notices.items():
+            if apk.read(name) != data:
+                raise ValueError(f"APK runtime notice differs from its input: {name}")
+        native_names = {NATIVE_PREFIX + name for name in libraries}
+        payload_names = {name for name in names if not signed or not name.startswith("META-INF/")}
+        if payload_names != MANIFEST_MEMBERS | {"classes.dex"} | assets.keys() | native_names | notices.keys():
+            raise ValueError("Unexpected APK payload inventory")
+        if any(apk.getinfo(name).compress_type != zipfile.ZIP_STORED for name in native_names):
+            raise ValueError("APK native library must be stored")
+
+
+def build(args):
+    output = args.output
+    if output.exists() or output.is_symlink():
+        raise FileExistsError(output)
+    assets = {"assets/" + APPEARANCE: appearance_asset(args.mixer_project)}
+    assets.update(checklist_assets(args.installed_checklist, args.checklist_sha256))
+    env = os.environ | {"JAVA_HOME": str(args.java_home), "LC_ALL": "C"}
+    tools = args.android_sdk / "build-tools/36.0.0"
+    ndk = args.android_sdk / "ndk/27.1.12297006/toolchains/llvm/prebuilt/darwin-x86_64"
+    libraries = native_libraries(args.jni_library, ndk, args.swift_android_sdk, env)
+    notices = runtime_notices(args.mixer_project, libraries, ndk, args.swift_android_sdk)
+    with tempfile.TemporaryDirectory(prefix="fieldlog-apk-", dir=output.parent) as scratch:
+        work = Path(scratch)
+        unsigned, aligned, signed = (work / name for name in ("unsigned.apk", "aligned.apk", "signed.apk"))
+        with (zipfile.ZipFile(args.manifest_apk) as manifest,
+              zipfile.ZipFile(unsigned, "x", zipfile.ZIP_STORED) as apk):
+            if sorted(manifest.namelist()) != sorted(MANIFEST_MEMBERS):
+                raise ValueError("Expected the unsigned signed-checklist manifest and network policy")
+            for name in sorted(MANIFEST_MEMBERS):
+                apk.writestr(name, manifest.read(name))
+            apk.write(args.dex, "classes.dex")
+            for name, data in (assets | notices).items():
+                apk.writestr(name, data)
+            for name, path in sorted(libraries.items()):
+                apk.write(path, NATIVE_PREFIX + name)
+        verify_image(unsigned, assets, libraries, notices)
+        run(env, tools / "zipalign", "-P", "16", "-f", "4", unsigned, aligned)
+        key = work / "development.p12"
+        password = "FIELDLOG_LOCAL_APK_PASSWORD"
+        signing = env | {password: os.urandom(24).hex()}
+        run(signing, args.java_home / "bin/keytool", "-genkeypair", "-storetype", "PKCS12", "-keystore", key,
+            "-alias", "fieldlog-local", "-storepass:env", password, "-keypass:env", password,
+            "-keyalg", "EC", "-groupname", "secp256r1", "-validity", "30", "-dname", "CN=FieldLog Local Development")
+        run(signing, tools / "apksigner", "sign", "--ks", key, "--ks-pass", f"env:{password}",
+            "--v3-signing-enabled", "true", "--v4-signing-enabled", "false", "--out", signed, aligned)
+        signatures = run(env, tools / "apksigner", "verify", "--verbose", "--print-certs", "-Werr", signed)
+        if "Verified using v3 scheme (APK Signature Scheme v3): true" not in signatures:
+            raise ValueError("Expected a v3 development APK signature")
+        run(env, tools / "zipalign", "-c", "-P", "16", "4", signed)
+        badging = run(env, tools / "aapt2", "dump", "badging", signed)
+        lines = badging.splitlines()
+        for entry in ("minSdkVersion:'36'", "targetSdkVersion:'37'", "native-code: 'arm64-v8a'"):
+            if entry not in lines:
+                raise ValueError(f"Unexpected APK badging. Expected {entry}")
+        for prefix in ("package: name='dev.fieldlog.generatedr90' ",
+                       "launchable-activity: name='dev.fieldlog.generatedr90.androidhost.PublicActivity' "):
+            if not any(line.startswith(prefix) for line in lines):
+                raise ValueError(f"Unexpected APK badging. Expected {prefix.strip()}")
+        verify_image(signed, assets, libraries, notices, signed=True)
+        os.link(signed, output)
+    print(f"Development APK: {output}")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    paths = {
+        "mixer-project": "Project prepared by the pinned Mixer CLI with public-v4",
+        "manifest-apk": "Unsigned aapt2 link output for the signed checklist",
+        "dex": "Signed-checklist app classes.dex from d8",
+        "jni-library": "Strict-linked libmixer_public_android_jni.so",
+        "installed-checklist": "Installed directory from the signed checklist build",
+        "checklist-sha256": "Trusted JSON object mapping the six Installed names to their SHA-256 values",
+        "android-sdk": "Android SDK with build tools 36.0.0 and NDK 27.1.12297006",
+        "swift-android-sdk": "swift-android directory from the pinned Swift Android SDK",
+        "java-home": "JDK home containing bin/keytool",
+        "output": "Fresh APK path in an existing destination directory",
+    }
+    for name, help_text in paths.items():
+        parser.add_argument("--" + name, required=True, type=Path, help=help_text)
+    try:
+        build(parser.parse_args())
+    except subprocess.CalledProcessError as error:
+        sys.exit(f"{error}\n{error.stdout}")
+    except (OSError, ValueError, subprocess.TimeoutExpired, zipfile.BadZipFile) as error:
+        sys.exit(str(error))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/Integrations/InstalledGuest/Delivery.swift b/Integrations/InstalledGuest/Delivery.swift
new file mode 100644
index 0000000000000000000000000000000000000000..e5e2dbdb8ecdfb36d7a113313db19452a16c342b
--- /dev/null
+++ b/Integrations/InstalledGuest/Delivery.swift
@@ -0,0 +1,199 @@
+import Foundation
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+import MixerUpdates
+
+struct FieldLogDelivery {
+    struct Package {
+        let manifest: Data
+        let assignment: Data
+        let payload: Data
+    }
+
+    let port: UInt16
+    let host: InstalledRuntime
+    let installation: String
+    let partialFile: URL
+
+    func fetch(after sequence: UInt64) async throws -> Package? {
+        let scope = host.scope
+        let tenant = [("organization", scope.organization), ("project", scope.project)]
+        let offerURL = try url("/v3/updates", tenant + [
+            ("app", scope.app), ("environment", scope.environment), ("platform", scope.platform),
+            ("runtime", host.runtime), ("channel", "beta"), ("installation", installation),
+        ])
+        guard let offer = try await fetchObject(offerURL, permitsNoOffer: true) else { return nil }
+        guard Set(offer.keys) == ["signed_assignment", "artifact_url"],
+              let assignment = offer["signed_assignment"], let fields = assignment.object?["assignment"]?.object,
+              let offeredSequence = fields["sequence"]?.uint, let digest = fields["artifact_sha256"]?.text,
+              digest.utf8.count == 64, digest.utf8.allSatisfy({ (48...57).contains($0) || (97...102).contains($0) }) else {
+            throw invalidOffer
+        }
+        guard offeredSequence > sequence else { return nil }
+        let artifactURL = try url("/v3/artifacts/" + digest, tenant)
+        guard offer["artifact_url"]?.text == artifactURL.path + "?" + (artifactURL.query ?? ""),
+              let artifact = try await fetchObject(artifactURL, permitsNoOffer: false, partial: PartialArtifact(url: partialFile, digest: digest)),
+              Set(artifact.keys) == ["signed_manifest", "payload"],
+              let manifest = artifact["signed_manifest"], let encoded = artifact["payload"]?.text,
+              let payload = Data(base64Encoded: encoded), !payload.isEmpty,
+              payload.count <= 8192, payload.base64EncodedString() == encoded else { throw invalidOffer }
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys, .withoutEscapingSlashes]
+        return try Package(manifest: encoder.encode(manifest), assignment: encoder.encode(assignment), payload: payload)
+    }
+
+    private var invalidOffer: UpdateError { UpdateError("fieldlog.delivery", "Invalid checklist release response") }
+
+    private func url(_ path: String, _ query: [(String, String)]) throws -> URL {
+        var target = URLComponents()
+        target.scheme = "http"
+        target.host = "127.0.0.1"
+        target.port = Int(port)
+        target.path = path
+        target.queryItems = query.map { URLQueryItem(name: $0.0, value: $0.1) }
+        guard let url = target.url else { throw invalidOffer }
+        return url
+    }
+
+    private func fetchObject(_ url: URL, permitsNoOffer: Bool, partial: PartialArtifact? = nil) async throws -> [String: CanonicalValue]? {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.timeoutIntervalForRequest = 4
+        configuration.timeoutIntervalForResource = 7
+        configuration.urlCredentialStorage = nil
+        configuration.httpShouldSetCookies = false
+        configuration.connectionProxyDictionary = ["HTTPEnable": false, "HTTPSEnable": false, "SOCKSEnable": false]
+        let receiver = ResponseReceiver(url: url, permitsNoOffer: permitsNoOffer, partial: partial)
+        let queue = OperationQueue()
+        queue.maxConcurrentOperationCount = 1
+        let session = URLSession(configuration: configuration, delegate: receiver, delegateQueue: queue)
+        defer { session.invalidateAndCancel() }
+        var response = receiver.response(in: session).makeAsyncIterator()
+        guard let result = try await response.next(), let bytes = result else {
+            try Task.checkCancellation()
+            return nil
+        }
+        guard let fields = try StrictJSON.decode(CanonicalValue.self, from: bytes, maximumBytes: ResponseReceiver.limit).object else {
+            throw invalidOffer
+        }
+        return fields
+    }
+}
+
+/// The service returns a complete JSON envelope. On reconnect, compare the
+/// replayed prefix before appending new bytes. The spool carries no authority.
+private struct PartialArtifact {
+    let url: URL
+    let digest: String
+
+    func read(maximumBytes: Int) -> Data {
+        guard let input = try? FileHandle(forReadingFrom: url) else { return Data() }
+        defer { try? input.close() }
+        let key = Data(digest.utf8)
+        guard let bytes = try? input.read(upToCount: maximumBytes + key.count + 1),
+              bytes.count <= maximumBytes + key.count, bytes.starts(with: key) else { return Data() }
+        return Data(bytes.dropFirst(key.count))
+    }
+
+    func save(_ bytes: Data) throws {
+        try (Data(digest.utf8) + bytes).write(to: url, options: .atomic)
+    }
+
+    func remove() { try? FileManager.default.removeItem(at: url) }
+}
+
+private final class ResponseReceiver: NSObject, URLSessionDataDelegate, @unchecked Sendable {
+    static let limit = 65_536
+    private let url: URL
+    private let permitsNoOffer: Bool
+    private var body: Data?
+    private var declined = false
+    private let partial: PartialArtifact?
+    private let prefix: Data
+    private var received = 0
+    private let continuation: AsyncThrowingStream<Data?, any Error>.Continuation
+    private let stream: AsyncThrowingStream<Data?, any Error>
+
+    init(url: URL, permitsNoOffer: Bool, partial: PartialArtifact?) {
+        self.url = url
+        self.permitsNoOffer = permitsNoOffer
+        self.partial = partial
+        self.prefix = partial?.read(maximumBytes: Self.limit) ?? Data()
+        (stream, continuation) = AsyncThrowingStream.makeStream(bufferingPolicy: .bufferingNewest(1))
+    }
+
+    func response(in session: URLSession) -> AsyncThrowingStream<Data?, any Error> {
+        var request = URLRequest(url: url, cachePolicy: .reloadIgnoringLocalCacheData)
+        request.setValue("identity", forHTTPHeaderField: "Accept-Encoding")
+        let task = session.dataTask(with: request)
+        continuation.onTermination = { _ in task.cancel() }
+        task.resume()
+        return stream
+    }
+
+    func urlSession(_ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse,
+                    newRequest request: URLRequest, completionHandler: @escaping @Sendable (URLRequest?) -> Void) {
+        completionHandler(nil)
+    }
+
+    func urlSession(_ session: URLSession, dataTask: URLSessionDataTask, didReceive response: URLResponse,
+                    completionHandler: @escaping @Sendable (URLSession.ResponseDisposition) -> Void) {
+        if let http = response as? HTTPURLResponse, http.url == url {
+            if permitsNoOffer, http.statusCode == 204 || http.statusCode == 404 {
+                declined = true
+                continuation.yield(nil)
+                continuation.finish()
+                completionHandler(.cancel)
+                return
+            }
+            if http.statusCode == 200, http.mimeType == "application/json",
+               http.expectedContentLength <= Self.limit {
+                body = prefix
+                completionHandler(.allow)
+                return
+            }
+        }
+        refuse()
+        completionHandler(.cancel)
+    }
+
+    func urlSession(_ session: URLSession, dataTask: URLSessionDataTask, didReceive data: Data) {
+        guard body != nil, data.count <= Self.limit - received else {
+            refuse()
+            dataTask.cancel()
+            return
+        }
+        let repeated = min(data.count, max(0, prefix.count - received))
+        guard repeated == 0 || prefix[received..<received + repeated].elementsEqual(data.prefix(repeated)) else {
+            partial?.remove()
+            refuse()
+            dataTask.cancel()
+            return
+        }
+        received += data.count
+        if repeated < data.count, let body {
+            let next = body + data.dropFirst(repeated)
+            do {
+                try partial?.save(next)
+                self.body = next
+            } catch {
+                continuation.finish(throwing: error)
+                dataTask.cancel()
+            }
+        }
+    }
+
+    func urlSession(_ session: URLSession, task: URLSessionTask, didCompleteWithError error: (any Error)?) {
+        if declined { return }
+        if let error { continuation.finish(throwing: error) }
+        else if let body, received == body.count {
+            partial?.remove()
+            continuation.yield(body)
+            continuation.finish()
+        } else { refuse() }
+    }
+
+    private func refuse() {
+        continuation.finish(throwing: UpdateError("fieldlog.delivery", "Release service returned an invalid response"))
+    }
+}
