diff --git a/Integrations/GeneratedReport/Sources/FieldLogAndroid/SignedChecklist.swift b/Integrations/GeneratedReport/Sources/FieldLogAndroid/SignedChecklist.swift
new file mode 100644
index 0000000000000000000000000000000000000000..7f1a0dbfd6c6bac62e8f707a638f2c4298af7956
--- /dev/null
+++ b/Integrations/GeneratedReport/Sources/FieldLogAndroid/SignedChecklist.swift
@@ -0,0 +1,98 @@
+#if FIELDLOG_SIGNED_CHECKLIST
+import FieldLogInstalledGuest
+import Foundation
+
+private final class ChecklistReply: @unchecked Sendable {
+    private let lock = NSLock()
+    private var text = "Preparing checklist"
+    func begin(_ action: Int32) -> Bool {
+        lock.withLock {
+            guard text != "Opening checklist", action == 2 || text != "Checklist retirement pending" else { return false }
+            text = "Opening checklist"
+            return true
+        }
+    }
+    func set(_ value: String) { lock.withLock { text = value } }
+    func copy(to output: UnsafeMutablePointer<CChar>, capacity: Int) {
+        lock.withLock {
+            let bytes = text.utf8.prefix(capacity - 1)
+            for (index, byte) in bytes.enumerated() { output[index] = byte < 128 ? CChar(byte) : 63 }
+            output[bytes.count] = 0
+        }
+    }
+}
+private let checklistReply = ChecklistReply()
+
+@MainActor private enum Checklist {
+    static var guest: FieldLogSignedTask?
+    static var context: Int64?
+
+    static func perform(_ action: Int32, context id: Int64, root: URL, material: URL,
+                        installation: UUID, bundleID: String) async {
+        guard context == nil || context == id else {
+            checklistReply.set("Checklist retirement pending")
+            return
+        }
+        context = id
+        let presentation = checklistPresentation(id)
+        presentation?.detachSignedDraft()
+        if let guest, !(await guest.close()) {
+            checklistReply.set("Checklist retirement pending")
+            return
+        }
+        guest = nil
+        if action == 2 {
+            context = nil
+            // The ordinary activity reloads after retirement through its own native bridge.
+            checklistReply.set("Closed")
+            return
+        }
+        do {
+            guard let presentation else { throw PublicHostError.context }
+            let storage = try await presentation.attachSignedDraft()
+            let opened = try await FieldLogSignedTask.open(storage: storage,
+                material: material, directory: root.appendingPathComponent("signed-checklist"),
+                bundleID: bundleID, installation: installation)
+            guest = opened
+            let delivery = try await opened.start()
+            let deadline = ContinuousClock.now + .seconds(12)
+            while ContinuousClock.now < deadline {
+                let state = await opened.recovery()
+                if state.activation.phase == .healthyGuest, state.healthy == state.activation.candidateID {
+                    checklistReply.set("\(delivery) | Sequence \(state.acceptedSequence)")
+                    return
+                }
+                if state.activation.terminalCause != nil { break }
+                try await Task.sleep(for: .milliseconds(50))
+            }
+            checklistReply.set("The signed checklist could not be displayed")
+        } catch {
+            presentation?.detachSignedDraft()
+            checklistReply.set("Select a saved draft and publish a compatible release")
+        }
+    }
+}
+
+@_cdecl("fieldlog_checklist_submit")
+func checklistSubmit(_ action: Int32, _ context: Int64, _ root: UnsafePointer<CChar>,
+                     _ material: UnsafePointer<CChar>, _ id: UnsafePointer<CChar>,
+                     _ bundle: UnsafePointer<CChar>) -> Int32 {
+    guard (1...2).contains(action), context > 0,
+          let installation = UUID(uuidString: String(cString: id)), checklistReply.begin(action) else { return 0 }
+    let directory = URL(fileURLWithPath: String(cString: root), isDirectory: true)
+    let materials = URL(fileURLWithPath: String(cString: material), isDirectory: true)
+    let bundleID = String(cString: bundle)
+    Task { @MainActor in
+        await Checklist.perform(action, context: context, root: directory, material: materials,
+                                installation: installation, bundleID: bundleID)
+    }
+    return 1
+}
+
+@_cdecl("fieldlog_checklist_status")
+func checklistStatus(_ output: UnsafeMutablePointer<CChar>, _ capacity: Int) {
+    guard Thread.isMainThread, (2...512).contains(capacity) else { return }
+    _ = RunLoop.main.run(mode: .default, before: Date(timeIntervalSinceNow: 0.001))
+    checklistReply.copy(to: output, capacity: capacity)
+}
+#endif
