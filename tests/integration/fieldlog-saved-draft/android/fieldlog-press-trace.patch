+#ifndef FIELDLOG_DRAFT_PRESS_TRACE_H
+#define FIELDLOG_DRAFT_PRESS_TRACE_H
+
+#include <stdint.h>
+
+enum fieldlog_press_stage {
+    FIELDLOG_TRACE_OFFER = 1,
+    FIELDLOG_TRACE_GUEST,
+    FIELDLOG_TRACE_COMPLETION,
+    FIELDLOG_TRACE_POST,
+    FIELDLOG_TRACE_FRAME,
+    FIELDLOG_TRACE_INVOKE
+};
+
+__attribute__((visibility("hidden"))) uint64_t fieldlog_press_bind(uint64_t press);
+__attribute__((visibility("hidden"))) uint64_t fieldlog_press_current(void);
+__attribute__((visibility("hidden"))) uint64_t fieldlog_press_scope(const void *exchange, uint32_t create);
+__attribute__((visibility("hidden"))) void fieldlog_press_unset_scope(const void *exchange);
+__attribute__((visibility("hidden"))) void fieldlog_press_trace(uint32_t stage, uint64_t scope,
+    uint64_t press, uint64_t event, uint64_t revision, uint32_t code, uint64_t elapsed, uint64_t detail);
+
+#endif
