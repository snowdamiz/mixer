diff --git a/Integrations/GeneratedReport/Platforms/Android/Bridge/DraftPressTrace.c b/Integrations/GeneratedReport/Platforms/Android/Bridge/DraftPressTrace.c
new file mode 100644
index 0000000..1e2fea4
--- /dev/null
+++ b/Integrations/GeneratedReport/Platforms/Android/Bridge/DraftPressTrace.c
@@ -0,0 +1,69 @@
+#include "DraftPressTrace.h"
+#include <android/log.h>
+#include <inttypes.h>
+#include <pthread.h>
+#include <time.h>
+
+static _Thread_local uint64_t current_press;
+static pthread_mutex_t scopes_lock = PTHREAD_MUTEX_INITIALIZER;
+static uint64_t scope_serial;
+// Match the existing 16 guest owner permits. Keys are private, live
+// exchange identities. Only the independently issued ordinal is logged.
+static struct { const void *exchange; uint64_t serial; } scopes[16];
+
+uint64_t fieldlog_press_bind(uint64_t press) {
+    uint64_t previous = current_press;
+    current_press = press;
+    return previous;
+}
+
+uint64_t fieldlog_press_current(void) { return current_press; }
+
+uint64_t fieldlog_press_scope(const void *exchange, uint32_t create) {
+    if (!exchange) return 0;
+    uint64_t result = 0;
+    unsigned empty = 16;
+    pthread_mutex_lock(&scopes_lock);
+    for (unsigned i = 0; i < 16; ++i) {
+        if (scopes[i].exchange == exchange) { result = scopes[i].serial; break; }
+        if (!scopes[i].exchange && empty == 16) empty = i;
+    }
+    if (!result && create && empty < 16 && scope_serial < UINT64_MAX) {
+        result = ++scope_serial;
+        scopes[empty].exchange = exchange;
+        scopes[empty].serial = result;
+    }
+    pthread_mutex_unlock(&scopes_lock);
+    return result;
+}
+
+void fieldlog_press_unset_scope(const void *exchange) {
+    if (!exchange) return;
+    pthread_mutex_lock(&scopes_lock);
+    for (unsigned i = 0; i < 16; ++i) {
+        if (scopes[i].exchange == exchange) { scopes[i].exchange = NULL; break; }
+    }
+    pthread_mutex_unlock(&scopes_lock);
+}
+
+void fieldlog_press_trace(uint32_t stage, uint64_t scope, uint64_t press, uint64_t event,
+                          uint64_t revision, uint32_t code, uint64_t elapsed, uint64_t detail) {
+    const char *name;
+    switch (stage) {
+        case FIELDLOG_TRACE_OFFER: name = "offer"; break;
+        case FIELDLOG_TRACE_GUEST: name = "guest"; break;
+        case FIELDLOG_TRACE_COMPLETION: name = "completion"; break;
+        case FIELDLOG_TRACE_POST: name = "post"; break;
+        case FIELDLOG_TRACE_FRAME: name = "frame"; break;
+        case FIELDLOG_TRACE_INVOKE: name = "invoke"; break;
+        default: return;
+    }
+    if (scope == 0 && press == 0) return;
+    struct timespec now;
+    if (clock_gettime(CLOCK_BOOTTIME, &now) != 0) return;
+    uint64_t timestamp = (uint64_t)now.tv_sec * UINT64_C(1000000000) + (uint64_t)now.tv_nsec;
+    __android_log_print(ANDROID_LOG_INFO, "FieldLogDraftPress",
+        "t_ns=%" PRIu64 " stage=%s scope=%" PRIu64 " press=%" PRIu64 " event=%" PRIu64
+        " rev=%" PRIu64 " code=%" PRIu32 " elapsed_ns=%" PRIu64 " detail=%" PRIu64,
+        timestamp, name, scope, press, event, revision, code, elapsed, detail);
+}
