+    let jpeg = try Data(contentsOf: photoURL(photoID))
+    guard jpeg.count == attachment.byteCount, jpeg.starts(with: [0xff, 0xd8, 0xff]) else {
+      throw FieldLogError.storage("This photo is damaged. Its record has been preserved.")
+    }
+    return EntryUpload(event: event, entry: entry, photo: .init(id: photoID, jpeg: jpeg))
+  }
+  func acknowledgeEntryUpload(_ upload: EntryUpload, workspaceID: UUID) throws {
+    try Task.checkCancellation()
+    guard workspace.id == workspaceID else { throw EntrySyncClient.Failure.wrongScope }
