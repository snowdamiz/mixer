@@ -0,0 +1,24 @@
+package dev.fieldlog.generatedr90.androidhost;
+
+/** First checklist open only. Call sites and arming all belong to the Activity UI thread. */
+final class CalculationTrace {
+    enum Edge {
+        OPEN, POLL_ENTER, POLL_RETURN, FOCUS_ENTER, FOCUS_RETURN, DRAW_ENTER, DRAW_RETURN,
+        DRAW_QUEUED, DRAW_GATE, WITNESS_ENTER, WITNESS_RETURN
+    }
+
+    private static boolean armed;
+    private CalculationTrace() {}
+
+    static void arm() {
+        if (armed) return;
+        armed = true;
+        mark(Edge.OPEN, 0, 0, 0);
+    }
+
+    static void mark(Edge edge, long facade, long probe, int value) {
+        if (armed) record(edge.ordinal() + 1, facade, probe, value);
+    }
+
+    private static native void record(int edge, long facade, long probe, int value);
+}
