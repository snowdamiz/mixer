+#define FIELDLOG_CALCULATION_TRACE_H
+#include <stdint.h>
+
+typedef enum {
+    FL_CALC_OPEN = 1,
+    FL_CALC_POLL_ENTER,
+    FL_CALC_POLL_RETURN,
+    FL_CALC_FOCUS_ENTER,
+    FL_CALC_FOCUS_RETURN,
+    FL_CALC_DRAW_ENTER,
+    FL_CALC_DRAW_RETURN,
+    FL_CALC_DRAW_QUEUED,
+    FL_CALC_DRAW_GATE,
+    FL_CALC_WITNESS_ENTER,
+    FL_CALC_WITNESS_RETURN,
+    FL_CALC_PUMP_ENTER,
+    FL_CALC_COPY_ENTER,
+    FL_CALC_COPY_RETURN,
+    FL_CALC_INTENT_DURABLE,
+    FL_CALC_VM_ENABLE_ENTER,
+    FL_CALC_VM_ENABLE_RETURN,
+    FL_CALC_EFFECTS_CONFIRMED,
+    FL_CALC_APPLY_ENTER,
+    FL_CALC_APPLY_RETURN,
+    FL_CALC_DRAW_ACCEPTED,
+    FL_CALC_FIRST_SCREEN
+} FieldLogCalculationEdge;
+
+__attribute__((visibility("hidden")))
+void fieldlog_calculation_trace(FieldLogCalculationEdge edge, uint64_t generation,
+                               uint64_t facade, uint64_t probe, uint64_t frame, int32_t value);
+#endif
