+++ b/Integrations/GeneratedReport/Platforms/Android/Bridge/CalculationTrace/CalculationTrace.c
@@ -0,0 +1,42 @@
+#include "CalculationTrace.h"
+#include <android/log.h>
+#include <inttypes.h>
+#include <jni.h>
+#include <stdatomic.h>
+#include <time.h>
+
+enum { TRACE_SECONDS = 18, TRACE_RECORDS = 2048 };
+static const uint64_t nanos_per_second = 1000000000;
+static _Atomic(uint64_t) deadline;
+static _Atomic(uint32_t) count;
+
+void fieldlog_calculation_trace(FieldLogCalculationEdge edge, uint64_t generation,
+                               uint64_t facade, uint64_t probe, uint64_t frame, int32_t value) {
+    uint64_t until = atomic_load_explicit(&deadline, memory_order_relaxed);
+    if ((until == 0 && edge != FL_CALC_OPEN) ||
+        atomic_load_explicit(&count, memory_order_relaxed) >= TRACE_RECORDS) return;
+
+    struct timespec time;
+    if (clock_gettime(CLOCK_BOOTTIME, &time) != 0) return;
+    uint64_t now = (uint64_t)time.tv_sec * nanos_per_second + (uint64_t)time.tv_nsec;
+    if (edge == FL_CALC_OPEN) {
+        until = now + TRACE_SECONDS * nanos_per_second;
+        uint64_t unarmed = 0;
+        if (!atomic_compare_exchange_strong_explicit(&deadline, &unarmed, until,
+                memory_order_relaxed, memory_order_relaxed)) return;
+    }
+    if (now >= until) return;
+    uint32_t ordinal = atomic_fetch_add_explicit(&count, 1, memory_order_relaxed) + 1;
+    if (ordinal > TRACE_RECORDS) return;
+    __android_log_print(ANDROID_LOG_INFO, "FieldLogCalcTrace",
+        "edge=%u ordinal=%" PRIu32 " ns=%" PRIu64 " gen=%" PRIu64
+        " facade=%" PRIu64 " probe=%" PRIu64 " frame=%" PRIu64 " value=%" PRId32,
+        (unsigned)edge, ordinal, now, generation, facade, probe, frame, value);
+}
+
+JNIEXPORT void JNICALL Java_dev_fieldlog_generatedr90_androidhost_CalculationTrace_record(
+    JNIEnv *env, jclass cls, jint edge, jlong facade, jlong probe, jint value) {
+    (void)env; (void)cls;
+    if (edge >= FL_CALC_OPEN && edge <= FL_CALC_WITNESS_RETURN && facade >= 0 && probe >= 0)
+        fieldlog_calculation_trace((FieldLogCalculationEdge)edge, 0, (uint64_t)facade, (uint64_t)probe, 0, value);
+}
