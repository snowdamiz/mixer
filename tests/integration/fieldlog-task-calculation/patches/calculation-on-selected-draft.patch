+#if DEBUG && FIELDLOG_CALCULATION_FIXTURE
+import FieldLogModels
+import FieldLogStorage
+import Foundation
+import MixerCapabilities
+import MixerUpdates
+
+public enum CalculationFixture {
+    public static let bundleID = "dev.fieldlog.generatedr90.calculation"
+    public static let projectID = UUID(uuidString: "22F02008-0000-4000-8000-000000000001")!
+    public static let taskID = UUID(uuidString: "D8FD094D-6A4E-4B03-930E-1C4BEE0FB8A7")!
+    public static let projects = [
+        projectID,
+        UUID(uuidString: "22F02008-0000-4000-8000-000000000002")!,
+        UUID(uuidString: "22F02008-0000-4000-8000-000000000004")!,
+    ]
+
+    public static func readSeed(_ file: URL) throws -> Data {
+        let source = try FileHandle(forReadingFrom: file)
+        defer { try? source.close() }
+        let bytes = try source.read(upToCount: 3531) ?? Data()
+        guard bytes.count == 3530,
+              ReleaseVerifier.sha256(bytes) == "f202de8c0101f04e7d6624f90a7f521ce416eb36ae3994d7b1f0692380043260" else {
+            throw UpdateError("fieldlog.calculationSeed", "The calculation fixture requires the exact saved workspace")
+        }
+        return bytes
+    }
+
+    public static func storage(repository: WorkspaceRepository,
+                               task: WorkTask) throws -> any InstalledApplicationStorageServing {
+        guard task.projectID == projectID, task.id == taskID else {
+            throw UpdateError("fieldlog.calculationFixture", "Incorrect calculation project or task")
+        }
+        return CalculationFixtureStorage(repository: repository)
+    }
+
+    static func admits(_ payload: Data) -> Bool {
+        guard payload.count == 10_540 else { return false }
+        switch ReleaseVerifier.sha256(payload) {
+        case "35feea36a6c37cfb6d7c104143f8da041acd93551f42e23fe42f1b885e107610",
+             "904f5d414478dcacab2efdcf91f1969b3036ed9b5a763bb5943ad80843a5ea2f":
+            return true
+        default:
+            return false
+        }
+    }
+}
+
+struct CalculationFixtureStorage: InstalledApplicationStorageServing {
+    let repository: WorkspaceRepository
+
+    func get(_ arguments: KVGetArguments) async throws -> KVGetResponse {
+        guard arguments.namespace == FieldLogDraftStorage.namespace, arguments.key == "completion-rows" else {
+            throw CapabilityFailure.permissionDenied
+        }
+        let state = try await repository.readCommittedSnapshot()
+        let projects = CalculationFixture.projects.map { state.tasks(for: $0) }
+        let tasks = projects[0]
+        guard projects.map(\.count) == [3, 2, 0], tasks[1].id == CalculationFixture.taskID,
+              tasks.allSatisfy({
+                  (1...96).contains($0.title.utf8.count) && !$0.title.utf8.contains { $0 < 32 || $0 == 127 }
+              }) else { throw CapabilityFailure.unavailable }
+        let completion = projects.map { $0.map { $0.completed ? "1" : "0" }.joined() + "\n" }.joined()
+        let rows = tasks.map { "\($0.id.uuidString)\t\($0.title)\n" }.joined()
+        return .init(found: true, valueBase64: Data("\(state.revision)\n\(completion)\(rows)".utf8).base64EncodedString())
+    }
+
+    func put(_ arguments: KVPutArguments, maximumTotalBytes: Int,
+             maximumEntries: Int) async throws -> KVMutationResponse {
