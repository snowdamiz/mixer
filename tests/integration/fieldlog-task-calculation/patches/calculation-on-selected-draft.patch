+final class CalculationFixture {
+    private static final String PACKAGE = "dev.fieldlog.generatedr90.calculation";
+
+    private CalculationFixture() {}
+
+    static boolean enabled(Context context) {
+        return PACKAGE.equals(context.getPackageName())
+            && (context.getApplicationInfo().flags & ApplicationInfo.FLAG_DEBUGGABLE) != 0;
+    }
+
+    static void stageSeed(Context context) throws IOException {
+        try (InputStream seed = context.getAssets().open("ChecklistRelease/calculation-seed.json")) {
+            Files.copy(seed, new File(context.getFilesDir(), "calculation-seed.json").toPath(),
+                StandardCopyOption.REPLACE_EXISTING);
+        }
+    }
+
+    static void render(Context context, JSONObject frame, LinearLayout destination) throws JSONException {
+        JSONObject root = frame.getJSONObject("root");
+        require(frame.getInt("schemaVersion") == 1 && frame.getLong("revision") > 0);
+        emptyStack(root, "fieldlog-rows");
+        JSONArray children = root.getJSONArray("children");
+        require(children.length() == 7);
+        for (int index = 0; index < 3; index++) {
+            String value = text(children.getJSONObject(index), "completion-" + index, false);
+            require(value.matches("(0|[1-9][0-9]?|100)%"));
+            addText(context, destination, value, 20);
+        }
+
+        // The exact guest includes reorder actions. This fixture exposes only the read-only projection.
+        text(children.getJSONObject(3), "heading", false);
+        Set<String> seen = new HashSet<>();
+        for (int index = 0; index < 3; index++) {
+            JSONObject row = children.getJSONObject(index + 4);
+            String id = row.getString("id");
+            require(id.startsWith("row-") && id.length() == 40 && seen.add(id));
+            String task = id.substring(4);
+            try {
+                require(UUID.fromString(task).toString().equalsIgnoreCase(task));
+            } catch (IllegalArgumentException invalid) {
+                throw new JSONException("Invalid calculation row identifier");
+            }
+            emptyStack(row, id);
+            JSONArray cells = row.getJSONArray("children");
+            require(cells.length() == (index == 0 ? 1 : 2));
+            String title = text(cells.getJSONObject(0), "title-" + task, true);
+            if (index != 0) {
+                String move = "move-" + task;
+                JSONObject button = cells.getJSONObject(1);
+                JSONObject props = button.getJSONObject("properties");
+                JSONArray actions = button.getJSONArray("actions");
+                require(move.equals(button.getString("id")) && "button".equals(button.getString("kind"))
+                    && props.length() == 2 && move.equals(props.getString("accessibilityIdentifier"))
+                    && ("Move up: " + title).equals(props.getString("label"))
+                    && button.getJSONArray("children").length() == 0 && actions.length() == 1);
+                JSONObject action = actions.getJSONObject(0);
+                require(move.equals(action.getString("id")) && "activate".equals(action.getString("event")));
+            }
+            addText(context, destination, title, 18);
+        }
+    }
+
+    private static void emptyStack(JSONObject node, String id) throws JSONException {
+        require(id.equals(node.getString("id")) && "vStack".equals(node.getString("kind"))
+            && node.getJSONObject("properties").length() == 0 && node.getJSONArray("actions").length() == 0);
+    }
+
+    private static String text(JSONObject node, String id, boolean hasAccessibilityID) throws JSONException {
+        JSONObject props = node.getJSONObject("properties");
+        require(id.equals(node.getString("id")) && "text".equals(node.getString("kind"))
+            && node.getJSONArray("children").length() == 0 && node.getJSONArray("actions").length() == 0
+            && props.length() == (hasAccessibilityID ? 2 : 1)
+            && (!hasAccessibilityID || id.equals(props.getString("accessibilityIdentifier"))));
+        return props.getString("text");
+    }
+
+    private static void addText(Context context, LinearLayout destination, String value, int size) {
+        TextView text = new TextView(context);
+        text.setText(value);
+        text.setTextSize(size);
+        destination.addView(text);
+    }
+
+    private static void require(boolean condition) throws JSONException {
+        if (!condition) throw new JSONException("Unsupported FieldLog calculation frame");
+    }
+}
