+import FieldLogModels
+import FieldLogStorage
+import Foundation
+import MixerCapabilities
+
+/// A view of one host-selected task in the open FieldLog workspace.
+public struct FieldLogTaskStorage: InstalledApplicationStorageServing {
+    public static let namespace = "fieldlog-task-v1"
+    private let repository: WorkspaceRepository
+    private let projectID: UUID
+    private let taskID: UUID
+
+    public init(repository: WorkspaceRepository, projectID: UUID, taskID: UUID) {
+        self.repository = repository
+        self.projectID = projectID
+        self.taskID = taskID
+    }
+
+    public func get(_ arguments: KVGetArguments) async throws -> KVGetResponse {
+        try authorize(arguments.namespace, arguments.key)
+        try Task.checkCancellation()
+        let state: Workspace
+        do {
+            state = try await repository.readCommittedSnapshot()
+        } catch {
+            throw CapabilityFailure.ioFailure
+        }
+        try Task.checkCancellation()
+        guard let task = task(in: state) else {
+            return KVGetResponse(found: false, valueBase64: "")
+        }
+        // Versioned namespace, UInt64 big-endian revision and one completion byte.
+        var bytes = withUnsafeBytes(of: state.revision.bigEndian) { Data($0) }
+        bytes.append(task.completed ? 1 : 0)
+        return KVGetResponse(found: true, valueBase64: bytes.base64EncodedString())
+    }
+
+    public func put(_ arguments: KVPutArguments, maximumTotalBytes: Int, maximumEntries: Int) async throws -> KVMutationResponse {
+        try authorize(arguments.namespace, arguments.key)
+        guard let bytes = Data(base64Encoded: arguments.valueBase64), bytes.count == 9,
+              let bit = bytes.last, bit <= 1 else { throw CapabilityFailure.invalidResponse }
+        // The installed quota applies to one bounded value.
+        guard maximumEntries >= 1, maximumTotalBytes >= bytes.count else {
+            throw CapabilityFailure.quotaExceeded
+        }
+        let revision = bytes.prefix(8).reduce(UInt64(0)) { ($0 << 8) | UInt64($1) }
+        do {
+            _ = try await repository.transact(expectedRevision: revision) { state in
+                try Task.checkCancellation()
+                guard let task = task(in: state) else { throw CapabilityFailure.permissionDenied }
+                guard task.completed != (bit == 1) else { throw WriteUnchanged() }
+                try state.toggleTask(task.id)
+            }
+            return KVMutationResponse(committed: true)
+        } catch is WriteUnchanged {
+            return KVMutationResponse(committed: true)
+        } catch FieldLogError.staleRevision {
+            return KVMutationResponse(committed: false)
+        }
+    }
+
+    public func delete(_ arguments: KVDeleteArguments) async throws -> KVMutationResponse {
+        throw CapabilityFailure.permissionDenied
+    }
+
+    private func authorize(_ namespace: String, _ key: String) throws {
+        guard namespace == Self.namespace, key == "selected-task" else {
+            throw CapabilityFailure.permissionDenied
+        }
+    }
+
+    private func task(in state: Workspace) -> WorkTask? {
+        state.tasks.first { $0.id == taskID && $0.projectID == projectID }
+    }
+
+    private struct WriteUnchanged: Error {}
+}
