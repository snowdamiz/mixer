@@ -0,0 +1,125 @@
+import FieldLogModels
+import FieldLogStorage
+import Foundation
+import MixerCapabilities
+#if os(Android)
+@_spi(AndroidGuestUIV1) import MixerCapabilityActivation
+#else
+import MixerCapabilityActivation
+#endif
+import MixerRuntimeIdentity
+import MixerUpdates
+
+public struct FieldLogSignedTask: Sendable {
+    #if os(Android)
+    private typealias Owner = CapabilityGuestUIAndroidRuntime
+    #else
+    public typealias Owner = CapabilityGuestUIRuntime
+    #endif
+
+    #if os(Android)
+    private let owner: Owner
+    #else
+    public let owner: Owner
+    #endif
+    private let identity: CapabilityRuntimeIdentity
+    private let installation: String
+    private let port: UInt16
+    private let directory: URL
+
+    public static func open(task: WorkTask, repository: WorkspaceRepository, material: URL,
+                            directory: URL, bundleID: String, installation: UUID) async throws -> Self {
+        let identityBytes = try read(material, "identity.json", limit: 131_072)
+        let identity = try CapabilityRuntimeIdentity(json: identityBytes)
+        let scope = identity.installedRuntime.scope
+        guard scope.environment == "development",
+              identity.descriptor.object?["application"]?.object?["bundle_id"]?.text == bundleID,
+              let port = UInt16(try String(contentsOf: material.appendingPathComponent("port.txt"), encoding: .utf8)
+                .trimmingCharacters(in: .whitespacesAndNewlines)), port > 0 else {
+            throw UpdateError("fieldlog.identity", "Invalid installed FieldLog delivery identity")
+        }
+        let storageID = CapabilitySchemas.storageID
+        guard Set(identity.installedRuntime.capabilityHashes.keys) == [storageID] else {
+            throw UpdateError("fieldlog.capabilities", "The checklist guest requires only task storage")
+        }
+        let storage = FieldLogTaskStorage(repository: repository, projectID: task.projectID, taskID: task.id)
+        let materials: [CapabilityMaterialFile] = try [
+            .init(role: .bridgePolicy, bytes: read(material, "bridge.json")),
+            .init(role: .configuration(capabilityID: storageID), bytes: read(material, "storage.json")),
+            .init(role: .installedGrant(capabilityID: storageID), bytes: read(material, "storage-grant.json")),
+        ]
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        let execution = try InstalledCapabilityExecution(identityJSON: identityBytes, materials: materials,
+            trustRootsJSON: read(material, "roots.json"), privateContainer: directory,
+            applicationStorage: .init(runtimeFingerprint: identity.fingerprint, namespace: FieldLogTaskStorage.namespace,
+                service: storage, allowsDeferredGuestUIStartup: true))
+        let installation = installation.uuidString.lowercased()
+        let owner = try await Owner.open(configuration: .init(directory: directory.appendingPathComponent("recovery"),
+            channel: "beta", installation: installation, observationSeconds: 1), execution: execution)
+        return Self(owner: owner, identity: identity, installation: installation, port: port, directory: directory)
+    }
+
+    public func start() async throws -> String {
+        let previous = await recovery()
+        var deliveryError: (any Error)?
+        do {
+            let delivery = FieldLogDelivery(port: port, host: identity.installedRuntime, installation: installation,
+                partialFile: directory.appendingPathComponent("artifact.partial"))
+            if let package = try await delivery.fetch(after: previous.acceptedSequence) {
+                #if os(Android)
+                try await owner.stage(manifest: package.manifest, assignment: package.assignment, bytes: package.payload)
+                #else
+                try await owner.beginDownload(signedManifest: package.manifest, signedAssignment: package.assignment)
+                try await owner.appendDownload(package.payload, atOffset: 0)
+                try await owner.finishDownload()
+                #endif
+            }
+        } catch is CancellationError {
+            throw CancellationError()
+        } catch {
+            deliveryError = error
+        }
+        try Task.checkCancellation()
+        let activation = try await owner.start()
+        guard activation.candidateID != nil else {
+            if let deliveryError { throw deliveryError }
+            throw UpdateError("fieldlog.release", "No signed checklist release is available")
+        }
+        return deliveryError == nil ? "Signed checklist" : "Using saved checklist release"
+    }
+
+    public func recovery() async -> CapabilityGuestUIRecoverySnapshot {
+        #if os(Android)
+        owner.recoverySnapshot()
+        #else
+        await owner.recoverySnapshot()
+        #endif
+    }
+
+    public func close() async -> Bool {
+        #if os(Android)
+        await owner.close()
+        #else
+        await owner.close()
+        let deadline = ContinuousClock.now + .seconds(8)
+        repeat {
+            let state = await owner.recoverySnapshot()
+            guard state.closed, !state.incompleteAttempt else { return false }
+            if !state.activation.cleanupPending { return true }
+            do { try await Task.sleep(for: .milliseconds(20)) }
+            catch { return false }
+        } while ContinuousClock.now < deadline
+        return false
+        #endif
+    }
+
+    private static func read(_ directory: URL, _ name: String, limit: Int = 65_536) throws -> Data {
+        let handle = try FileHandle(forReadingFrom: directory.appendingPathComponent(name))
+        defer { try? handle.close() }
+        let bytes = try handle.read(upToCount: limit + 1) ?? Data()
+        guard !bytes.isEmpty, bytes.count <= limit else {
+            throw UpdateError("fieldlog.material", "Invalid installed checklist material")
+        }
+        return bytes
+    }
+}
