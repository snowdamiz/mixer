index 0000000..a4c6f2d
--- /dev/null
+++ b/Integrations/GeneratedReport/Platforms/Android/Bridge/ChecklistBridge.c
@@ -0,0 +1,234 @@
+#include "mixer_ui_binding.h"
+#include "mixer_android_host_bridge.h"
+#include <jni.h>
+#include <pthread.h>
+#include <string.h>
+
+extern int32_t mxfield_witness(uint64_t, uint64_t, uint64_t, uint32_t);
+extern int32_t fieldlog_checklist_submit(int32_t, int64_t, const char *, const char *, const char *, const char *);
+extern void fieldlog_checklist_status(char *, intptr_t);
+
+struct slot {
+    struct mxis_host_snapshot state;
+    jweak window;
+};
+
+// Only the final destructor uses this mutex off the installed UI thread.
+// No Java call runs while it is held.
+static pthread_mutex_t slots_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct slot slots[MXUIT_FACADE_CAPACITY];
+static uint64_t generations;
+static JavaVM *vm;
+// Registration and Java callbacks are main-Looper-owned. The Swift close
+// outcome and the destructor's slot release are separate retirement proofs.
+static jweak registered;
+static int close_requested;
+static jmethodID apply_method, enable_method, retire_method;
+
+static JNIEnv *env_for_ui(void) {
+    JNIEnv *env = NULL;
+    return vm && (*vm)->GetEnv(vm, (void **)&env, JNI_VERSION_1_6) == JNI_OK ? env : NULL;
+}
+static int32_t result(JNIEnv *env, jboolean accepted) {
+    if ((*env)->ExceptionCheck(env)) { (*env)->ExceptionClear(env); return MXUIT_IO; }
+    return accepted ? MXUIT_OK : MXUIT_IO;
+}
+static struct slot *lookup(uint64_t facade, uint64_t entry) {
+    if (mxuit_ui_validate(facade, entry) != MXUIT_OK) return NULL;
+    struct slot *found = NULL;
+    pthread_mutex_lock(&slots_lock);
+    for (unsigned i = 0; i < MXUIT_FACADE_CAPACITY; ++i)
+        if (slots[i].state.facade == facade) { found = &slots[i]; break; }
+    pthread_mutex_unlock(&slots_lock);
+    return found;
+}
+
+int32_t mxis_host_slot_acquire(uint64_t facade, uint64_t entry, uint64_t *generation) {
+    if (!generation || mxuit_ui_validate(facade, entry) != MXUIT_OK) return MXUIT_INVALID;
+    *generation = 0;
+    JNIEnv *env = env_for_ui();
+    if (!env || !registered) return MXUIT_UNAVAILABLE;
+    jobject window = (*env)->NewLocalRef(env, registered);
+    if (!window) return result(env, JNI_FALSE);
+    jweak weak = (*env)->NewWeakGlobalRef(env, window);
+    (*env)->DeleteLocalRef(env, window);
+    if (!weak) return result(env, JNI_FALSE);
+    pthread_mutex_lock(&slots_lock);
+    for (unsigned i = 0; i < MXUIT_FACADE_CAPACITY; ++i) {
+        if (!slots[i].state.facade && generations != UINT64_MAX) {
+            *generation = ++generations;
+            slots[i].state = (struct mxis_host_snapshot){.facade=facade, .generation=*generation, .published=1, .weak_owner_live=1};
+            slots[i].window = weak;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&slots_lock);
+    if (!*generation) (*env)->DeleteWeakGlobalRef(env, weak);
+    return *generation ? MXUIT_OK : MXUIT_CAPACITY;
+}
+
+int32_t mxis_host_inspect(uint64_t facade, uint64_t entry, struct mxis_host_snapshot *out) {
+    struct slot *slot = lookup(facade, entry);
+    JNIEnv *env = env_for_ui();
+    if (!slot || !env || !out) return MXUIT_STALE;
+    *out = slot->state;
+    if (slot->window) out->weak_owner_live = !(*env)->IsSameObject(env, slot->window, NULL);
+    return MXUIT_OK;
+}
+
+int32_t mxis_apply(uint64_t facade, uint64_t entry, uint64_t attachment, uint64_t input,
+                   uint64_t probe, const uint8_t *packet, uint32_t bytes) {
+    struct slot *slot = lookup(facade, entry);
+    JNIEnv *env = env_for_ui();
+    if (!env || !slot || !slot->window || !packet || !bytes || bytes > 65536) return MXUIT_INVALID;
+    jobject window = (*env)->NewLocalRef(env, slot->window);
+    jbyteArray copy = window ? (*env)->NewByteArray(env, (jsize)bytes) : NULL;
+    jboolean accepted = JNI_FALSE;
+    if (copy) {
+        (*env)->SetByteArrayRegion(env, copy, 0, (jsize)bytes, (const jbyte *)packet);
+        if (!(*env)->ExceptionCheck(env))
+            accepted = (*env)->CallBooleanMethod(env, window, apply_method, (jlong)facade, (jlong)attachment,
+                                                  (jlong)input, (jlong)probe, copy);
+        (*env)->DeleteLocalRef(env, copy);
+    }
+    if (window) (*env)->DeleteLocalRef(env, window);
+    int32_t status = result(env, accepted);
+    if (status == MXUIT_OK) {
+        slot->state.tree_live = slot->state.listener_live = 1;
+        slot->state.packet_bytes = bytes;
+    }
+    return status;
+}
+
+int32_t mxis_interaction(uint64_t facade, uint64_t entry, uint32_t enabled) {
+    struct slot *slot = lookup(facade, entry);
+    JNIEnv *env = env_for_ui();
+    if (!env || !slot || !slot->window || enabled > 1) return MXUIT_INVALID;
+    jobject window = (*env)->NewLocalRef(env, slot->window);
+    jboolean accepted = window ? (*env)->CallBooleanMethod(env, window, enable_method, (jlong)facade, (jboolean)enabled) : JNI_FALSE;
+    if (window) (*env)->DeleteLocalRef(env, window);
+    int32_t status = result(env, accepted);
+    if (status == MXUIT_OK) slot->state.interaction = enabled;
+    return status;
+}
+
+int32_t mxis_retire(uint64_t facade, uint64_t entry, uint32_t final) {
+    struct slot *slot = lookup(facade, entry);
+    JNIEnv *env = env_for_ui();
+    if (!env || !slot || !slot->window || final > 1) return MXUIT_INVALID;
+    jobject window = (*env)->NewLocalRef(env, slot->window);
+    jboolean accepted = window ? (*env)->CallBooleanMethod(env, window, retire_method, (jlong)facade) : JNI_FALSE;
+    if (window) (*env)->DeleteLocalRef(env, window);
+    int32_t status = result(env, accepted);
+    if (status != MXUIT_OK) return status;
+    slot->state.tree_live = slot->state.listener_live = slot->state.packet_bytes = slot->state.interaction = 0;
+    if (final) {
+        (*env)->DeleteWeakGlobalRef(env, slot->window);
+        slot->window = NULL;
+        slot->state.weak_owner_live = 0;
+        slot->state.cleared = 1;
+        slot->state.final_entry = entry;
+    }
+    return MXUIT_OK;
+}
+
+int32_t mxis_host_release_destroyed(uint64_t facade, uint64_t generation) {
+    if (mxuit_facade_begin_close(facade) != MXUIT_STALE) return MXUIT_BUSY;
+    int32_t status = MXUIT_STALE;
+    pthread_mutex_lock(&slots_lock);
+    for (unsigned i = 0; i < MXUIT_FACADE_CAPACITY; ++i) {
+        struct slot *slot = &slots[i];
+        if (slot->state.facade == facade && slot->state.generation == generation &&
+            slot->state.cleared && slot->state.final_entry && !slot->window) {
+            memset(slot, 0, sizeof(*slot));
+            status = MXUIT_OK;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&slots_lock);
+    return status;
+}
+
+static int main_looper(JNIEnv *env) {
+    jclass cls = (*env)->FindClass(env, "android/os/Looper");
+    if (!cls) return 0;
+    jmethodID my = (*env)->GetStaticMethodID(env, cls, "myLooper", "()Landroid/os/Looper;");
+    jmethodID main = my ? (*env)->GetStaticMethodID(env, cls, "getMainLooper", "()Landroid/os/Looper;") : NULL;
+    jobject current = main ? (*env)->CallStaticObjectMethod(env, cls, my) : NULL;
+    if ((*env)->ExceptionCheck(env) || !current) return 0;
+    jobject expected = (*env)->CallStaticObjectMethod(env, cls, main);
+    if ((*env)->ExceptionCheck(env) || !expected) return 0;
+    return (*env)->IsSameObject(env, current, expected);
+}
+
+static int owns_registration(JNIEnv *env, jobject self) {
+    return main_looper(env) && registered && (*env)->IsSameObject(env, self, registered);
+}
+
+static int slots_empty(void) {
+    int empty = 1;
+    pthread_mutex_lock(&slots_lock);
+    for (unsigned i = 0; i < MXUIT_FACADE_CAPACITY; ++i) {
+        if (slots[i].state.facade) {
+            empty = 0;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&slots_lock);
+    return empty;
+}
+
+#define JNI_NAME(name) Java_dev_fieldlog_generatedr90_androidhost_ChecklistPanel_##name
+JNIEXPORT jboolean JNICALL JNI_NAME(initialize)(JNIEnv *env, jobject self) {
+    if (!main_looper(env)) return JNI_FALSE;
+    if (registered) return (*env)->IsSameObject(env, self, registered);
+    if (!slots_empty()) return JNI_FALSE;
+    jclass cls = (*env)->GetObjectClass(env, self);
+    if (!cls) return JNI_FALSE;
+    apply_method = (*env)->GetMethodID(env, cls, "applyGuest", "(JJJJ[B)Z");
+    if (!apply_method) return JNI_FALSE;
+    enable_method = (*env)->GetMethodID(env, cls, "enableGuest", "(JZ)Z");
+    if (!enable_method) return JNI_FALSE;
+    retire_method = (*env)->GetMethodID(env, cls, "retireGuest", "(J)Z");
+    if (!retire_method || (*env)->GetJavaVM(env, &vm) != JNI_OK || mxuit_install() != MXUIT_OK) return JNI_FALSE;
+    registered = (*env)->NewWeakGlobalRef(env, self);
+    return registered != NULL;
+}
+
+JNIEXPORT jboolean JNICALL JNI_NAME(unregisterRetired)(JNIEnv *env, jobject self) {
+    if (!owns_registration(env, self) || !close_requested) return JNI_FALSE;
+    char text[512] = {0};
+    fieldlog_checklist_status(text, sizeof(text));
+    if (strncmp(text, "Closed", 6) != 0 || !slots_empty()) return JNI_FALSE;
+    (*env)->DeleteWeakGlobalRef(env, registered);
+    registered = NULL;
+    close_requested = 0;
+    return JNI_TRUE;
+}
+
+JNIEXPORT jint JNICALL JNI_NAME(witness)(JNIEnv *env, jobject self, jlong facade, jlong attachment, jlong token, jboolean display) {
+    if (!owns_registration(env, self) || facade <= 0 || attachment <= 0 || token <= 0)
+        return MXUIT_INVALID;
+    return mxfield_witness(facade, attachment, token, display);
+}
+JNIEXPORT jboolean JNICALL JNI_NAME(cycle)(JNIEnv *env, jobject self, jint action, jlong context,
+                                         jstring root, jstring assets, jstring installation, jstring bundle) {
+    if (!owns_registration(env, self) || !root || !assets || !installation || !bundle) return JNI_FALSE;
+    jstring args[] = {root, assets, installation, bundle};
+    const char *text[4] = {0};
+    for (int i = 0; i < 4; ++i) {
+        if ((*env)->GetStringUTFLength(env, args[i]) > 4096) break;
+        text[i] = (*env)->GetStringUTFChars(env, args[i], NULL);
+        if (!text[i]) break;
+    }
+    jboolean accepted = text[3] && fieldlog_checklist_submit(action, context, text[0], text[1], text[2], text[3]);
+    for (int i = 0; i < 4 && text[i]; ++i) (*env)->ReleaseStringUTFChars(env, args[i], text[i]);
+    if (accepted) close_requested = action == 2;
+    return accepted;
+}
+JNIEXPORT jstring JNICALL JNI_NAME(status)(JNIEnv *env, jobject self) {
+    if (!owns_registration(env, self)) return NULL;
+    char text[512] = {0};
+    fieldlog_checklist_status(text, sizeof(text));
+    return (*env)->NewStringUTF(env, text);
+}
diff --git a/Integrations/GeneratedReport/Platforms/Android/Java/dev/fieldlog/generatedr90/androidhost/ChecklistPanel.java b/Integrations/GeneratedReport/Platforms/Android/Java/dev/fieldlog/generatedr90/androidhost/ChecklistPanel.java
