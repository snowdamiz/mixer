+++ b/Integrations/GeneratedReport/Platforms/Android/Java/dev/fieldlog/generatedr90/androidhost/ChecklistPanel.java
@@ -0,0 +1,286 @@
+package dev.fieldlog.generatedr90.androidhost;
+
+import android.app.Dialog;
+import android.graphics.Canvas;
+import android.graphics.Rect;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.View;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.StandardCopyOption;
+import java.util.UUID;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/** Native surface for the signed checklist opened from FieldLog's public activity. */
+final class ChecklistPanel {
+    static { System.loadLibrary("mixer_public_android_jni"); }
+    private native boolean initialize();
+    private native boolean unregisterRetired();
+    private native boolean cycle(int action, long context, String directory, String assets, String installation, String bundle);
+    private native String status();
+    private native int witness(long facade, long attachment, long token, boolean display);
+
+    private final PublicActivity activity;
+    private final long context;
+    private final Dialog dialog;
+    private final Button update, done;
+    private final TextView result;
+    private final LinearLayout guest;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private GuestFrame current;
+    private boolean enabled, closing, closeAfterOperation;
+    private int remaining;
+    private Runnable afterClose = () -> {};
+
+    ChecklistPanel(PublicActivity activity, long context) {
+        this.activity = activity;
+        this.context = context;
+        dialog = new Dialog(activity);
+        dialog.setTitle("Signed checklist");
+        dialog.setCancelable(false);
+        LinearLayout contents = new LinearLayout(activity);
+        contents.setOrientation(LinearLayout.VERTICAL);
+        contents.setPadding(24, 24, 24, 24);
+        result = new TextView(activity);
+        update = new Button(activity);
+        done = new Button(activity);
+        guest = new LinearLayout(activity);
+        guest.setOrientation(LinearLayout.VERTICAL);
+        update.setText("Check for update");
+        done.setText("Done");
+        update.setAllCaps(false);
+        done.setAllCaps(false);
+        update.setOnClickListener(view -> start(1));
+        done.setOnClickListener(view -> close(() -> {}));
+        contents.addView(result);
+        contents.addView(guest);
+        contents.addView(update);
+        contents.addView(done);
+        dialog.setContentView(contents);
+    }
+
+    boolean open() {
+        if (!initialize()) return false;
+        dialog.show();
+        start(1);
+        return true;
+    }
+
+    void close(Runnable completion) {
+        afterClose = completion;
+        closeAfterOperation = true;
+        if (remaining == 0 && !closing) start(2);
+    }
+
+    private String installation() throws IOException {
+        android.content.SharedPreferences preferences = activity.getSharedPreferences("signed-checklist", 0);
+        String value = preferences.getString("installation", null);
+        if (value != null) return value;
+        value = UUID.randomUUID().toString();
+        if (!preferences.edit().putString("installation", value).commit()) throw new IOException("installation");
+        return value;
+    }
+
+    private File installedMaterial() throws IOException {
+        File directory = new File(activity.getFilesDir(), "checklist-installed");
+        if (!directory.exists() && !directory.mkdir()) throw new IOException("directory");
+        for (String name : new String[]{"identity.json", "roots.json", "storage.json", "storage-grant.json", "bridge.json", "port.txt"}) {
+            try (java.io.InputStream asset = activity.getAssets().open("ChecklistRelease/" + name)) {
+                Files.copy(asset, new File(directory, name).toPath(), StandardCopyOption.REPLACE_EXISTING);
+            }
+        }
+        return directory;
+    }
+
+    private void start(int action) {
+        if (remaining != 0) return;
+        closing = action == 2;
+        try {
+            File materials = action == 1 ? installedMaterial() : new File(activity.getFilesDir(), "checklist-installed");
+            if (!cycle(action, context, activity.getFilesDir().getCanonicalPath(), materials.getCanonicalPath(),
+                installation(), activity.getPackageName())) throw new IOException("checklist operation");
+            result.setText("Opening checklist");
+            update.setEnabled(false);
+            done.setEnabled(false);
+            if (current != null) current.action.setEnabled(false);
+            remaining = 500;
+            handler.post(this::poll);
+        } catch (IOException error) {
+            result.setText("Checklist materials could not be opened");
+            update.setEnabled(!closing);
+            done.setEnabled(!closing);
+        }
+    }
+
+    private void poll() {
+        String state = status();
+        if (state == null) return;
+        if (state.equals("Opening checklist") && --remaining > 0) {
+            handler.postDelayed(this::poll, 50);
+            return;
+        }
+        remaining = 0;
+        result.setText(state);
+        if (closing) {
+            if (state.startsWith("Closed") && unregisterRetired()) {
+                dialog.dismiss();
+                afterClose.run();
+                activity.checklistClosed(this);
+            }
+        } else if (closeAfterOperation && !state.equals("Opening checklist")) {
+            start(2);
+        } else if (!state.equals("Opening checklist")) {
+            update.setEnabled(true);
+            done.setEnabled(true);
+        } else {
+            result.setText("Checklist operation has not settled");
+        }
+    }
+
+    @SuppressWarnings("unused") // JNI transport callbacks
+    private boolean applyGuest(long facade, long attachment, long input, long probe, byte[] packet) {
+        try {
+            JSONObject frame = new JSONObject(new String(packet, StandardCharsets.UTF_8));
+            JSONObject root = frame.getJSONObject("root");
+            require(frame.getInt("schemaVersion") == 1 && frame.getLong("revision") > 0
+                && "fieldlog-task".equals(root.getString("id")) && "vStack".equals(root.getString("kind"))
+                && root.getJSONObject("properties").length() == 0 && root.getJSONArray("actions").length() == 0);
+            JSONArray nodes = root.getJSONArray("children");
+            require(nodes.length() == 3);
+            GuestFrame next = new GuestFrame(facade, attachment, input, probe);
+            for (int i = 0; i < 2; i++) {
+                JSONObject node = nodes.getJSONObject(i);
+                require((i == 0 ? "task" : "status").equals(node.getString("id"))
+                    && "text".equals(node.getString("kind")) && node.getJSONArray("children").length() == 0
+                    && node.getJSONArray("actions").length() == 0 && node.getJSONObject("properties").length() == 1);
+                TextView text = new TextView(activity);
+                text.setText(node.getJSONObject("properties").getString("text"));
+                text.setTextSize(i == 0 ? 24 : 18);
+                next.addView(text);
+            }
+            JSONObject node = nodes.getJSONObject(2);
+            JSONArray commands = node.getJSONArray("actions");
+            require("toggle".equals(node.getString("id")) && "button".equals(node.getString("kind"))
+                && node.getJSONArray("children").length() == 0 && node.getJSONObject("properties").length() == 1
+                && commands.length() == 1 && "task.toggle".equals(commands.getJSONObject(0).getString("id"))
+                && "activate".equals(commands.getJSONObject(0).getString("event")));
+            next.action.setText(node.getJSONObject("properties").getString("label"));
+            next.addView(next.action);
+            return replaceGuest(next);
+        } catch (JSONException failure) {
+            return false;
+        }
+    }
+
+    private static void require(boolean condition) throws JSONException {
+        if (!condition) throw new JSONException("Unsupported FieldLog presentation");
+    }
+
+    private boolean replaceGuest(GuestFrame next) {
+        // Keep the previous frame and its state until the new child is attached.
+        try {
+            guest.addView(next);
+        } catch (RuntimeException failure) {
+            // ViewGroup can throw after it has already inserted the child.
+            next.disarm();
+            guest.removeView(next);
+            if (current == null) result.setText("FAILED guest frame attachment");
+            return false;
+        }
+        detachCurrent();
+        current = next;
+        return true;
+    }
+
+    private void detachCurrent() {
+        if (current != null) {
+            // Remove posted animation callbacks while the View is still attached.
+            current.disarm();
+            guest.removeView(current);
+            current = null;
+        }
+        enabled = false;
+    }
+
+    @SuppressWarnings("unused")
+    private boolean enableGuest(long facade, boolean value) {
+        if (current == null) return !value;
+        if (current.facade != facade) return false;
+        enabled = value;
+        current.action.setEnabled(value && current.observed);
+        return true;
+    }
+
+    @SuppressWarnings("unused")
+    private boolean retireGuest(long facade) {
+        if (current != null && current.facade != facade) return false;
+        detachCurrent();
+        if (guest.getChildCount() != 0) return false;
+        if (result.getText().toString().startsWith("HEALTHY")) result.setText("Guest retired");
+        return true;
+    }
+
+    private final class GuestFrame extends LinearLayout {
+        final long facade, attachment, input, probe;
+        final Button action = new Button(activity);
+        boolean scheduled;
+        boolean observed;
+        private final Runnable afterDraw = this::queueObservation;
+        private final Runnable observe = this::observeFrame;
+
+        GuestFrame(long facade, long attachment, long input, long probe) {
+            super(activity);
+            this.facade = facade; this.attachment = attachment; this.input = input; this.probe = probe;
+            setOrientation(LinearLayout.VERTICAL);
+            action.setAllCaps(false);
+            action.setEnabled(false);
+            action.setOnClickListener(view -> {
+                if (current != this || !observed || !enabled || !visible()) return;
+                if (witness(facade, attachment, input, false) == 0) action.setEnabled(false);
+            });
+        }
+        void disarm() {
+            action.setOnClickListener(null);
+            action.setEnabled(false);
+            removeCallbacks(afterDraw);
+            removeCallbacks(observe);
+            scheduled = false;
+        }
+
+        private void queueObservation() {
+            if (visible()) postOnAnimation(observe);
+            else scheduled = false;
+        }
+
+        private void observeFrame() {
+            scheduled = false;
+            if (!visible()) return;
+            int status = witness(facade, attachment, probe, true);
+            observed = status == 0;
+            if (status != 0) android.util.Log.w("FieldLogChecklist", "Display witness refused: " + status);
+            action.setEnabled(observed && enabled);
+        }
+
+        private boolean visible() {
+            Rect bounds = new Rect();
+            return current == this && !closing && isAttachedToWindow() && isShown()
+                && hasWindowFocus() && getWindowVisibility() == View.VISIBLE && getGlobalVisibleRect(bounds)
+                && bounds.width() > 0 && bounds.height() > 0;
+        }
+        @Override protected void dispatchDraw(Canvas canvas) {
+            // Backgroundless ViewGroups can reach child drawing without entering draw().
+            super.dispatchDraw(canvas);
+            if (observed || scheduled || !visible()) return;
+            scheduled = true;
+            postOnAnimation(afterDraw);
+        }
+    }
+}
