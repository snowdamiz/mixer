+++ b/hosted/test/support/fieldlog_halt_replay.ex
@@ -0,0 +1,271 @@
+defmodule MixerHosted.Test.FieldLogHaltReplay do
+  @moduledoc false
+  import ExUnit.Assertions
+  import ExUnit.Callbacks
+  import MixerHosted.Test.OrdinaryBrowserStartupFixture, only: [http: 3]
+
+  alias MixerHosted.CustomerArtifacts
+  alias MixerHosted.CustomerArtifacts.UploadRepo
+  alias MixerHosted.Identity.{KeyOwner, KeyOwnerSupervisor, TLSFixture}
+  alias MixerHosted.Releases.Target
+  alias MixerHosted.Test.StockReleaseCLI
+
+  @control_active "00000000-0000-4000-8000-000000000001"
+  @control_pending "00000000-0000-4000-8000-000000000002"
+
+  def start_issuer! do
+    tls = start_supervised!({TLSFixture, ip: {127, 0, 0, 1}})
+    key = JOSE.JWK.generate_key({:rsa, 2048})
+    {_, public} = key |> JOSE.JWK.to_public() |> JOSE.JWK.to_map()
+    jwk = Map.merge(public, %{"kid" => "startup-key", "alg" => "RS256", "use" => "sig"})
+    TLSFixture.configure(tls, {:body, Jason.encode!(%{"keys" => [jwk]})})
+    {tls, key}
+  end
+
+  def connect_issuer!(tls) do
+    # Use the same loopback-only TLS transport seam as the v64 HTTP verifier.
+    # The ordinary router, JWT verifier, TLS peer check and SQL authorization stay in path.
+    assert {:ok, {%{identity_startup: %{owner_options: opts}}, :disabled}} =
+             MixerHosted.Application.startup()
+
+    parent = MixerHosted.Supervisor
+    assert :ok = Supervisor.terminate_child(parent, KeyOwnerSupervisor)
+    assert :ok = Supervisor.delete_child(parent, KeyOwnerSupervisor)
+    refute Process.whereis(KeyOwner)
+    fixture = Map.take(GenServer.call(tls, :authority), [:ip, :port])
+
+    assert {:ok, _} =
+             Supervisor.start_child(parent, %{
+               id: KeyOwnerSupervisor,
+               start:
+                 {KeyOwnerSupervisor, :start_fixture, [Keyword.put(opts, :fixture, fixture)]},
+               type: :supervisor
+             })
+  end
+
+  def run!(client, target, [_, staged] = phases, halt, token, verify_rows, control?) do
+    cli = System.fetch_env!("MIXER_RELEASE_HALT_CLI")
+    run = System.fetch_env!("MIXER_RELEASE_HALT_RUN")
+    scratch = System.fetch_env!("MIXER_RELEASE_FIXTURE_SCRATCH")
+    System.put_env("MIXER_TEST_RELEASE_CANDIDATE", scratch)
+
+    for phase <- phases do
+      artifact = %{
+        manifest_sha256: phase.digest,
+        signed_manifest_bytes: phase.manifest,
+        payload: phase.payload
+      }
+
+      for _ <- 1..2 do
+        StockReleaseCLI.publish!(
+          cli,
+          client.http_port,
+          token.(),
+          artifact,
+          phase.signed,
+          phase.assignment
+        )
+      end
+
+      verify_rows.(Enum.take(phases, phase.assignment["sequence"]))
+    end
+
+    scope = Target.signed_scope(target)
+    match = Map.merge(scope, %{"runtime" => target.runtime_sha256, "channel" => target.channel})
+    tenant = URI.encode_query(organization: scope["organization"], project: scope["project"])
+    artifact_path = "/v3/artifacts/#{staged.digest}?#{tenant}"
+    prefix = "/v3/orgs/#{scope["organization"]}/projects/#{scope["project"]}"
+    audit = prefix <> "/audit"
+    halt_audit = audit <> "?view=rollout_halt"
+    headers = [{"authorization", "Bearer " <> token.()}]
+
+    assert %{status: 200, body: legacy} = artifact_audit(client, audit, headers)
+    assert %{"events" => [_, _], "next" => 2} = Jason.decode!(legacy)
+    assert %{status: 200, body: empty} = http(client, halt_audit, headers)
+    assert %{"events" => [], "next" => 0} = Jason.decode!(empty)
+    assert %{status: 401} = http(client, halt_audit, [])
+    assert %{status: 200, body: envelope} = http(client, artifact_path, [])
+    assert envelope == staged.envelope
+
+    atomic_write!(run, "ready.json", %{
+      port: client.http_port,
+      scope: scope,
+      runtime: target.runtime_sha256,
+      channel: target.channel,
+      artifact: staged.digest,
+      sequence: staged.assignment["sequence"],
+      rollout: staged.assignment["rollout_basis_points"]
+    })
+
+    {active, pending, health, source} =
+      if control? do
+        {@control_active, @control_pending,
+         %{"sequence" => 2, "activated" => 1, "pending" => 1, "adverse_signals" => 1},
+         "synthetic host control"}
+      else
+        sample = await_file!(run, "halt-sample.json", 600_000)
+
+        %{"activeInstallation" => active, "pendingInstallation" => pending, "health" => health} =
+          Jason.decode!(sample)
+
+        {active, pending, health, sha(sample)}
+      end
+
+    assert canonical_uuid?(active) and canonical_uuid?(pending) and active != pending
+    assert health == %{"sequence" => 2, "activated" => 1, "pending" => 1, "adverse_signals" => 1}
+
+    offer_paths =
+      for installation <- [active, pending],
+          do: "/v3/updates?" <> URI.encode_query(Map.put(match, "installation", installation))
+
+    offer =
+      ~s({"signed_assignment":) <>
+        staged.signed <>
+        ~s(,"artifact_url":) <> Jason.encode!(artifact_path) <> "}"
+
+    for path <- offer_paths do
+      assert %{status: 200, body: ^offer} = http(client, path, [])
+    end
+
+    signed_path = Path.join(scratch, "halt.assignment.json")
+    health_path = Path.join(scratch, "halt-health.json")
+    File.write!(signed_path, halt.signed, [:exclusive])
+    File.write!(health_path, Jason.encode!(health), [:exclusive])
+
+    expected = %{
+      "status" => "ok",
+      "action" => "halt",
+      "artifact_sha256" => staged.digest,
+      "sequence" => 3,
+      "rollout_basis_points" => 0,
+      "delivery" => "local_only",
+      "health" => health
+    }
+
+    for _ <- 1..2 do
+      assert {output, 0} =
+               System.cmd(
+                 cli,
+                 [
+                   "update",
+                   "halt",
+                   staged.digest,
+                   "--channel",
+                   target.channel,
+                   "--organization",
+                   scope["organization"],
+                   "--project",
+                   scope["project"],
+                   "--assignment",
+                   signed_path,
+                   "--health",
+                   health_path
+                 ],
+                 env: [
+                   {"HOME", scratch},
+                   {"TMPDIR", scratch},
+                   {"MIXER_RELEASE_ORIGIN", "http://127.0.0.1:#{client.http_port}"},
+                   {"MIXER_RELEASE_TOKEN", token.()}
+                 ]
+               )
+
+      assert Jason.decode!(output) == expected
+    end
+
+    for path <- offer_paths do
+      assert %{status: 204, body: ""} = http(client, path, [])
+    end
+
+    headers = [{"authorization", "Bearer " <> token.()}]
+
+    assert %{status: 200, body: committed} = http(client, halt_audit, headers)
+
+    assert %{
+             "events" => [
+               %{
+                 "id" => 3,
+                 "action" => "POST " <> prefix <> "/channels/#{target.channel}/halt",
+                 "rollout_halt" => %{
+                   "scope" => scope,
+                   "runtime" => target.runtime_sha256,
+                   "channel" => target.channel,
+                   "artifact_sha256" => staged.digest,
+                   "halt_sequence" => 3,
+                   "health" => health
+                 }
+               }
+             ],
+             "next" => 3
+           } == Jason.decode!(committed)
+
+    assert %{status: 200, body: ^legacy} = artifact_audit(client, audit, headers)
+    assert %{status: 200, body: ^envelope} = http(client, artifact_path, [])
+
+    atomic_write!(run, "committed.json", %{
+      cli: expected,
+      exactRetry: true,
+      audit: Jason.decode!(committed),
+      sample: source,
+      legacyAuditSHA256: sha(legacy),
+      offerStatusesAfter: [204, 204],
+      historicalArtifactSHA256: sha(envelope),
+      committedUnixNs: System.os_time(:nanosecond)
+    })
+
+    unless control? do
+      assert "done\n" == await_file!(run, "done", 600_000)
+    end
+  end
+
+  defp artifact_audit(client, path, headers) do
+    # The existing reader receives the verified fixture's storage topology.
+    # The uploader profile requires this test-only config to be absent on writes.
+    %{host: host, roots: roots} = Application.fetch_env!(:mixer_hosted, :local_release_target)
+    assert Application.fetch_env(:mixer_hosted, CustomerArtifacts) == :error
+
+    Application.put_env(:mixer_hosted, CustomerArtifacts, %{
+      repo: UploadRepo,
+      host: host,
+      roots: roots
+    })
+
+    try do
+      http(client, path, headers)
+    after
+      Application.delete_env(:mixer_hosted, CustomerArtifacts)
+    end
+  end
+
+  defp atomic_write!(run, name, value) do
+    dest = Path.join(run, name)
+    File.write!(dest <> ".new", Jason.encode!(value) <> "\n", [:exclusive])
+    File.rename!(dest <> ".new", dest)
+  end
+
+  defp await_file!(run, name, milliseconds) do
+    read_until!(Path.join(run, name), System.monotonic_time(:millisecond) + milliseconds)
+  end
+
+  defp read_until!(path, deadline) do
+    case File.lstat(path) do
+      {:ok, %File.Stat{type: :regular, size: size}} when size in 1..4_096 ->
+        File.read!(path)
+
+      {:error, :enoent} ->
+        assert System.monotonic_time(:millisecond) < deadline, "Expected " <> Path.basename(path)
+        Process.sleep(100)
+        read_until!(path, deadline)
+
+      _ ->
+        flunk("Invalid handoff file " <> Path.basename(path))
+    end
+  end
+
+  defp canonical_uuid?(uuid) when is_binary(uuid) do
+    byte_size(uuid) == 36 and
+      Regex.match?(~r/\A[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z/, uuid)
+  end
+
+  defp canonical_uuid?(_), do: false
+  defp sha(bytes), do: :crypto.hash(:sha256, bytes) |> Base.encode16(case: :lower)
+end
