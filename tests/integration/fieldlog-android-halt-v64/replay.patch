index 0000000000..d794e04104
--- /dev/null
+++ b/tests/integration/fieldlog-android-halt/evidence.py
@@ -0,0 +1,290 @@
+#!/usr/bin/env python3
+"""Relay the configured FieldLog origin and verify the Android halt readbacks."""
+
+import argparse
+import base64
+import hashlib
+import http.client
+from http.server import BaseHTTPRequestHandler, HTTPServer
+import json
+import os
+from pathlib import Path
+import runpy
+import sys
+import time
+from types import SimpleNamespace
+from urllib.parse import parse_qsl, urlencode, urlsplit
+from uuid import UUID
+from xml.etree import ElementTree
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def read(path):
+    return json.loads(path.read_bytes())
+
+
+def write(path, value):
+    temporary = path.with_suffix(".new")
+    with temporary.open("x") as stream:
+        stream.write(json.dumps(value, sort_keys=True) + "\n")
+    temporary.rename(path)
+
+
+def canonical_id(value):
+    return str(UUID(value)) == value
+
+
+class Packet:
+    def __init__(self, directory, ready):
+        delivery = directory / "delivery-android"
+        signed = (delivery / "staged.assignment.json").read_bytes()
+        self.assignment = json.loads(signed)["assignment"]
+        assignment = self.assignment
+        self.scope = assignment["scope"]
+        self.runtime = assignment["runtime"]
+        self.channel = assignment["channel"]
+        self.sequence = assignment["sequence"]
+        digest = assignment["artifact_sha256"]
+        require(all(
+            ready[key] == value for key, value in {
+                "scope": self.scope, "runtime": self.runtime, "channel": self.channel,
+                "sequence": self.sequence, "artifact": digest, "rollout": 9000,
+            }.items()
+        ), "Packet and configured origin disagree")
+        tenant = {key: self.scope[key] for key in ("organization", "project")}
+        self.path = "/v3/artifacts/" + digest + "?" + urlencode(tenant)
+        self.match = self.scope | {"runtime": self.runtime, "channel": self.channel}
+        payload = (delivery / "reviewed.wasm").read_bytes()
+        manifest = (delivery / "reviewed.manifest.json").read_bytes()
+        self.payload_sha = sha(payload)
+        self.seed = sha((delivery / "Installed/calculation-seed.json").read_bytes())
+        self.offer = b'{"signed_assignment":' + signed + b',"artifact_url":' + json.dumps(self.path).encode() + b'}'
+        self.envelope = b'{"signed_manifest":' + manifest + b',"payload":"' + base64.b64encode(payload) + b'"}'
+
+
+def serve(run, packet, upstream, port):
+    arm = run / "fault-next"
+    events = run / "device-http.jsonl"
+    last = None
+
+    class Handler(BaseHTTPRequestHandler):
+        def setup(self):
+            self.request.settimeout(6)
+            super().setup()
+
+        def log_message(self, *_args):
+            pass
+
+        def do_GET(self):
+            nonlocal last
+            target = urlsplit(self.path)
+            pairs = parse_qsl(target.query, keep_blank_values=True)
+            query = dict(pairs)
+            installation = query.pop("installation", "")
+            if target.path == "/v3/updates":
+                last = None
+                try:
+                    valid = (len(pairs) == len(query) + 1 and canonical_id(installation)
+                             and query == packet.match and not target.fragment)
+                except ValueError:
+                    valid = False
+                if not valid:
+                    return self.send_error(404)
+                kind = "offer"
+            elif self.path == packet.path and last is not None:
+                installation = last
+                kind = "artifact"
+            else:
+                return self.send_error(404)
+
+            connection = http.client.HTTPConnection("127.0.0.1", upstream, timeout=4)
+            try:
+                connection.request("GET", self.path, headers={"Accept-Encoding": "identity"})
+                response = connection.getresponse()
+                body = response.read(65_537)
+                status = response.status
+                content_type = response.getheader("Content-Type")
+                expected = packet.offer if kind == "offer" else packet.envelope
+                require(len(body) <= 65_536 and (
+                    (status == 200 and body == expected and content_type is not None)
+                    or (status == 204 and kind == "offer" and not body)
+                ), "Unexpected configured origin response")
+            except (OSError, ValueError, http.client.HTTPException) as error:
+                print(f"Relay refused upstream: {error}", file=sys.stderr, flush=True)
+                return self.send_error(502)
+            finally:
+                connection.close()
+
+            truncated = kind == "artifact" and arm.is_file()
+            if truncated:
+                require(arm.read_bytes() == b"truncate-once\n", "Bad fault marker")
+                arm.unlink()
+            wire = body[:1024] if truncated else body
+            self.send_response(status)
+            self.send_header("Content-Length", str(len(body)))
+            if content_type:
+                self.send_header("Content-Type", content_type)
+            self.send_header("Connection", "close")
+            self.end_headers()
+            self.wfile.write(wire)
+            self.wfile.flush()
+            self.close_connection = True
+            if kind == "offer" and status == 200:
+                last = installation
+            row = {"unixNs": time.time_ns(), "installation": installation, "kind": kind,
+                   "status": status, "declaredBytes": len(body), "sentBytes": len(wire),
+                   "sha256": sha(wire), "truncated": truncated}
+            with events.open("a") as stream:
+                stream.write(json.dumps(row) + "\n")
+
+    with events.open("x"), HTTPServer(("127.0.0.1", port), Handler) as server:
+        print(server.server_port, flush=True)
+        try:
+            server.serve_forever()
+        except KeyboardInterrupt:
+            pass
+
+
+def validate_states(run, packet, *, offline=False):
+    check = runpy.run_path(str(Path(__file__).resolve().parents[1] /
+                              "fieldlog-task-calculation/android-readback.py"))
+    active, active_hash = check["read_state"](run / "active-live.json")
+    retired, retired_hash = check["read_state"](run / "active-retired.json")
+    pending, pending_hash = check["read_state"](run / "pending-before.json")
+    ids = active["installation"], pending["installation"]
+    require(all(map(canonical_id, ids)) and ids[0] != ids[1], "Two distinct installed IDs required")
+    expected = SimpleNamespace(runtime=packet.runtime, installation=ids[0], sequence=packet.sequence,
+                               artifact=packet.assignment["artifact_sha256"], payload=packet.payload_sha)
+    candidate, launch = check["check_live"](active, expected)
+    check["check_retired"](active, retired, candidate)
+    require(pending["fingerprint"] == packet.runtime and pending["host"]["runtime"] == packet.runtime
+            and pending["host"]["scope"] == packet.scope and pending["channel"] == packet.channel
+            and pending["acceptedSequence"] == 0 and not pending["candidates"]
+            and all(pending[key] is None for key in ("healthy", "pending", "staged", "attempt")),
+            "The separate installation accepted or staged data instead of remaining transport-pending")
+    require(active["host"]["scope"] == packet.scope, "Activated installation scope differs")
+    spool = (run / "pending-before.partial").read_bytes()
+    prefix = packet.envelope[:1024]
+    require(spool == expected.artifact.encode() + prefix, "Expected exact durable interrupted prefix")
+    require({"Signed checklist | Sequence 2", "33%", "100%", "0%"}
+            <= ui_text(run / "active-before.xml"), "Missing activated calculation presentation")
+    text = ui_text(run / "pending-before.xml")
+    require("The signed calculation could not be opened" in text, "Pending adverse UI was not observed")
+    for name in ("active-before.workspace", "pending-before.workspace"):
+        require(sha((run / name).read_bytes()) == packet.seed, f"Saved workspace differs: {name}")
+
+    rows = [json.loads(line) for line in (run / "device-http.jsonl").read_text().splitlines()]
+    if offline:
+        committed = read(run / "committed.json")
+        cutoff = committed["committedUnixNs"]
+    else:
+        cutoff = time.time_ns()
+    before = [row for row in rows if row["unixNs"] < cutoff]
+    for installation, artifact_bytes, truncated in zip(ids, (packet.envelope, prefix), (False, True)):
+        seen_offer = False
+        for row in before:
+            if row["installation"] != installation:
+                continue
+            if row["kind"] == "offer":
+                seen_offer = row["status"] == 200 and row["sha256"] == sha(packet.offer)
+            elif (seen_offer and row["status"] == 200 and row["truncated"] == truncated
+                  and row["sha256"] == sha(artifact_bytes) and row["sentBytes"] == len(artifact_bytes)
+                  and row["declaredBytes"] == len(packet.envelope)):
+                break
+        else:
+            raise ValueError("Missing matching staged offer and transfer for installed ID " + installation)
+
+    return {
+        "activeInstallation": ids[0], "pendingInstallation": ids[1],
+        "health": {"sequence": packet.sequence, "activated": 1, "pending": 1, "adverse_signals": 1},
+        "activeCandidate": candidate, "activeLaunch": launch, "activeStateSHA256": active_hash,
+        "retiredStateSHA256": retired_hash, "pendingStateSHA256": pending_hash,
+        "pendingSpoolSHA256": sha(spool), "workspaceSHA256": packet.seed,
+    }, expected, rows
+
+
+def ui_text(path):
+    return {node.attrib.get("text") for node in ElementTree.parse(path).iter("node")}
+
+
+def finish(run, packet):
+    sample, expected, rows = validate_states(run, packet, offline=True)
+    committed = read(run / "committed.json")
+    require(sample == read(run / "halt-sample.json")
+            and committed["sample"] == sha((run / "halt-sample.json").read_bytes())
+            and committed["cli"]["health"] == sample["health"], "Committed health sample differs")
+    seen = set()
+    for row in rows:
+        if row["unixNs"] >= committed["committedUnixNs"]:
+            require(row["kind"] == "offer" and row["status"] == 204 and row["sentBytes"] == 0,
+                    "Unexpected post-halt relay delivery")
+            seen.add(row["installation"])
+    require({sample["activeInstallation"], sample["pendingInstallation"]} <= seen,
+            "Need one actual post-commit check per installation")
+
+    for suffix in ("json", "partial"):
+        require((run / f"pending-after.{suffix}").read_bytes() == (run / f"pending-before.{suffix}").read_bytes(),
+                "Pending recovery or spool changed on post-halt check")
+    require("The signed calculation could not be opened" in ui_text(run / "pending-after.xml"),
+            "Pending result was not confirmed after the halt")
+
+    check = runpy.run_path(str(Path(__file__).resolve().parents[1] /
+                              "fieldlog-task-calculation/android-readback.py"))
+    live, live_hash = check["read_state"](run / "offline-live.json")
+    retired, retired_hash = check["read_state"](run / "offline-retired.json")
+    candidate, launch = check["check_live"](live, expected)
+    check["check_retired"](live, retired, candidate)
+    require(live["host"]["scope"] == packet.scope and candidate == sample["activeCandidate"]
+            and launch != sample["activeLaunch"], "Offline open did not earn a new launch for the old candidate")
+    require({"Using saved checklist release | Sequence 2", "33%", "100%", "0%"}
+            <= ui_text(run / "offline.xml"), "Missing offline calculation presentation")
+    for name in ("pending-after.workspace", "offline.workspace"):
+        require(sha((run / name).read_bytes()) == packet.seed, f"Saved workspace differs: {name}")
+    before = int((run / "active-before.pid").read_text())
+    after = int((run / "offline.pid").read_text())
+    require(before > 0 and after > 0 and before != after and not (run / "offline.reverse").read_text().strip()
+            and (run / "offline.airplane").read_text().strip() == "1"
+            and not (run / "offline.ipv4").read_text().strip()
+            and not (run / "offline.ipv6").read_text().strip(), "Missing cold process or offline isolation witness")
+    write(run / "android-halt-result.json", sample | {
+        "offerStatuses": [204, 204], "offlineCandidate": candidate, "offlineLaunch": launch,
+        "offlineLiveSHA256": live_hash, "offlineRetiredSHA256": retired_hash,
+        "processIDs": [before, after], "audit": committed["audit"],
+    })
+    with (run / "done.new").open("x") as stream:
+        stream.write("done\n")
+    (run / "done.new").rename(run / "done")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("action", choices=("relay", "sample", "finish"))
+    parser.add_argument("packet", type=Path)
+    parser.add_argument("run", type=Path)
+    parser.add_argument("--port", type=int, default=0)
+    args = parser.parse_args()
+    os.umask(0o077)
+    ready = read(args.run / "ready.json")
+    packet = Packet(args.packet, ready)
+    if args.action == "relay":
+        serve(args.run, packet, ready["port"], args.port)
+    elif args.action == "sample":
+        sample, _, _ = validate_states(args.run, packet)
+        write(args.run / "halt-sample.json", sample)
+    else:
+        finish(args.run, packet)
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except (ValueError, OSError, KeyError) as error:
+        sys.exit(f"Android halt evidence refused: {error}")
