@@ -0,0 +1,32 @@
+#if os(macOS) && MIXER_PRIVATE_FIELDLOG_EDITOR
+import MixerCapabilities
+@_spi(PrivateFieldLogEditor) import MixerUpdates
+
+struct FieldLogTaskRetryStorage: InstalledApplicationStorageServing {
+    let repository: any InstalledApplicationStorageServing
+
+    func get(_ request: KVGetArguments) async throws -> KVGetResponse {
+        try authorize(namespace: request.namespace, key: request.key)
+        let response = try await repository.get(request)
+        guard response.found, ["AA==", "AQ=="].contains(response.valueBase64) else {
+            throw CapabilityFailure.unavailable
+        }
+        return response
+    }
+
+    func put(_ request: KVPutArguments, maximumTotalBytes: Int, maximumEntries: Int) async throws -> KVMutationResponse {
+        try authorize(namespace: request.namespace, key: request.key)
+        return try await repository.put(request, maximumTotalBytes: maximumTotalBytes, maximumEntries: maximumEntries)
+    }
+
+    func delete(_ request: KVDeleteArguments) async throws -> KVMutationResponse {
+        throw CapabilityFailure.permissionDenied
+    }
+
+    private func authorize(namespace: String, key: String) throws {
+        guard namespace == FieldLogEditorDevelopment.taskRetryNamespace, key == FieldLogEditorDevelopment.taskRetryKey else {
+            throw CapabilityFailure.permissionDenied
+        }
+    }
+}
+#endif
