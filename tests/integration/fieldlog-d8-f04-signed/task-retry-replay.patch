diff --git a/sdk/Sources/MixerGuest/GuestUIFieldLogTaskRetry.swift b/sdk/Sources/MixerGuest/GuestUIFieldLogTaskRetry.swift
new file mode 100644
index 0000000000000000000000000000000000000000..6e22ebd4a1e1e32e3396ba045e90c3afbef08fcc
--- /dev/null
+++ b/sdk/Sources/MixerGuest/GuestUIFieldLogTaskRetry.swift
@@ -0,0 +1,83 @@
+#if os(macOS) && MIXER_PRIVATE_FIELDLOG_EDITOR
+import Foundation
+import MixerUI
+
+enum GuestUIFieldLogTaskRetry {
+    static let codec = GuestUIExchangeCodec(maximumBytes: 4096, decode: { bytes in
+        let validator = UIValidator(limits: .init(maximumMessageBytes: 4096, maximumNodes: 5,
+            maximumDepth: 2, maximumChildrenPerNode: 4, maximumStringBytes: 256),
+            supportedKinds: [.vStack, .text, .textField, .button])
+        let validated = try GuestUICodec(validator: validator).decode(bytes)
+        let root = validated.document.root
+        guard root.id == "task-editor", root.kind == .vStack, root.properties.isEmpty,
+              let status = root.children.last, status.id == "status", status.kind == .text,
+              Set(status.properties.keys) == ["text"], let text = status.properties["text"]?.string else {
+            throw GuestUIEditorErrorV2.routing
+        }
+        switch text {
+        case "Task saved", "Workspace unavailable":
+            guard root.children.count == 1 else { throw GuestUIEditorErrorV2.routing }
+        case "New task", "Saving", "Save refused before publication":
+            guard root.children.count == 4,
+                  validField(root.children[0], id: "title", label: "Task", disabled: text == "Saving"),
+                  validField(root.children[1], id: "responsible", label: "Responsible person", disabled: text == "Saving"),
+                  validSave(root.children[2], disabled: text == "Saving" || root.children[0].properties["value"] == .string("")) else {
+                throw GuestUIEditorErrorV2.routing
+            }
+        default:
+            throw GuestUIEditorErrorV2.routing
+        }
+        return validated
+    }, accepts: { action, _, _ in
+        guard action.nodeID == action.actionID else { return false }
+        switch (action.nodeID, action.event, action.value) {
+        case ("title", .textChange, .string(let value)), ("responsible", .textChange, .string(let value)):
+            return validValue(value)
+        case ("save", .activate, .null):
+            return true
+        default:
+            return false
+        }
+    }, encodeEvent: { sequence, action, _ in
+        let payload: GuestUIEventPayloadV2
+        switch (action.event, action.value) {
+        case (.textChange, .string(let value)): payload = .textChange(value)
+        case (.activate, .null): payload = .activate
+        default: throw GuestUIEditorErrorV2.routing
+        }
+        return try GuestUIEventCodecV2.encode(sequence: sequence, revision: action.revision,
+            nodeID: action.nodeID, actionID: action.actionID, payload: payload)
+    })
+
+    static func admitsFirstDocument(_ document: UIDocument) -> Bool {
+        guard document.revision == 1 else { return false }
+        let children = document.root.children
+        switch children.last?.properties["text"]?.string {
+        case "Task saved": return true
+        case "New task":
+            return children.count == 4 && children[0].properties["value"] == .string("")
+                && children[1].properties["value"] == .string("")
+        default: return false
+        }
+    }
+
+    private static func validField(_ node: UINode, id: String, label: String, disabled: Bool) -> Bool {
+        node.id == id && node.kind == .textField && node.actions == [.init(id: id, event: .textChange)]
+            && Set(node.properties.keys) == ["label", "value", "disabled"]
+            && node.properties["label"] == .string(label) && node.properties["disabled"] == .bool(disabled)
+            && node.properties["value"]?.string.map(validValue) == true
+    }
+
+    private static func validSave(_ node: UINode, disabled: Bool) -> Bool {
+        node.id == "save" && node.kind == .button && node.actions == [.init(id: "save", event: .activate)]
+            && node.properties == ["label": .string("Add"), "disabled": .bool(disabled)]
+    }
+
+    private static func validValue(_ text: String) -> Bool {
+        guard text.utf8.count <= 256, !text.utf8.contains(0), !text.utf8.contains(13) else { return false }
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.withoutEscapingSlashes]
+        return (try? encoder.encode(text).count).map { $0 <= 258 } == true
+    }
+}
+#endif
